<?xml version="1.0" encoding="UTF-8"?>
<!--
    The Define-XML conformance rule corpus, on its own. See dist.xml beside this file for why the
    two corpora ship as separate archives.
-->
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">

    <id>rules-define</id>
    <formats>
        <format>zip</format>
        <format>dir</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>corej-rules-define-${project.version}</baseDirectory>

    <fileSets>
        <!-- The Define-XML conformance corpus. Same module and same generated shape as the data
             corpus, different axis: (family, version) rather than (family, standard, version),
             because for Define-XML the standard is always Define-XML.

             ⚑ target/, NOT the source tree — see dist.xml. -->
        <fileSet>
            <directory>${project.basedir}/target/rules-define</directory>
            <outputDirectory>rules-define</outputDirectory>
            <includes>
                <include>packages.json</include>
                <include>rules-define-*.json</include>
            </includes>
        </fileSet>

        <fileSet>
            <directory>${project.basedir}/src/main/resources/dist</directory>
            <outputDirectory></outputDirectory>
            <includes>
                <include>README.md</include>
            </includes>
        </fileSet>
    </fileSets>

</assembly>
