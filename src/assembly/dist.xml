<?xml version="1.0" encoding="UTF-8"?>
<!--
    The DATA rule corpus, on its own.

    The two corpora are on different axes — this one is (family, standard, version), the
    Define-XML one is (family, version), because for Define-XML the standard is always
    Define-XML — and a consumer may legitimately want one without the other. See
    rules-define.xml beside this file.

    The release job's glob is `dist/*-dist/target/*.zip`, so both archives are picked up
    with no workflow change. Each execution sets its own finalName, or they would collide.
-->
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">

    <id>rules</id>
    <formats>
        <!-- zip: the downloadable release artifact, picked up by the release job's
             dist/*-dist/target/*.zip glob.
             dir: exploded, so a container build or a local run can COPY it without
             unzipping. -->
        <format>zip</format>
        <format>dir</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>cumba-oss-corej-rules-${project.version}</baseDirectory>

    <fileSets>
        <!-- Only the GENERATED packages ship: rules-src/ is authoring source, not a
             runtime artifact.

             ⚑ target/, NOT the source tree. The corpus is generated during
             cumba-oss-corej-rules' build and is not committed, so that module MUST have
             been built in this reactor (or earlier in the same workspace) before this
             assembly runs. The <dependency> in this module's pom orders it; the enforcer
             requireFilesExist rule there turns a missing corpus into a hard failure
             rather than an empty bundle. -->
        <fileSet>
            <!-- ⭐ rules-release/, NOT rules/. The generator writes two trees from the same
                 assembled nodes: rules/ carries every family and is what the test suite reads,
                 rules-release/ is the same packages minus the DRAFT family. Only the latter
                 ships — the archive-internal name stays `rules/`, so nothing downstream sees a
                 layout change, only the absence of the draft packages. Repointing this at
                 rules/ would release unpublished draft rules; ReleaseCorpusTest asserts the
                 exclusion holds, and the launcher re-asserts it on the staged copy. -->
            <directory>${project.build.directory}/rules-release</directory>
            <outputDirectory>rules</outputDirectory>
            <includes>
                <include>packages.json</include>
                <include>rules-*.json</include>
            </includes>
        </fileSet>

        <!-- What the constituent standard versions are, and why a release asset's tag is
             not a reproducibility guarantee: the tag answers "is this reproducible",
             packages.json answers "which SDTM rules am I running", and users ask the
             second question. -->
        <fileSet>
            <directory>${project.basedir}/src/assembly</directory>
            <outputDirectory></outputDirectory>
            <includes>
                <include>README.md</include>
            </includes>
        </fileSet>
    </fileSets>

</assembly>
