<!-- CT batch (P5 CT-gated rules) 2.0 violations fixture, evaluated as version "2.0":
     exercises the 2.0-only PMDA-DD0031 (a codelist CT knows BY NAME - StubCtProvider's
     codelistByName("Sex") - without an nci:ExtCodeID Alias) and a 2.0 evaluation of
     PMDA-DD0024 (non-member term Z in non-extensible C66731); every 2.1-only CT rule
     must report NOT_APPLICABLE_VERSION here. -->
<ODM xmlns="http://www.cdisc.org/ns/odm/v1.3"
     xmlns:def="http://www.cdisc.org/ns/def/v2.0"
     xmlns:xlink="http://www.w3.org/1999/xlink"
     FileOID="www.example.org/define/ct-violations-20"
     FileType="Snapshot"
     ODMVersion="1.3.2"
     CreationDateTime="2026-07-03T10:15:30"
     def:Context="Submission">
  <Study OID="ST.CT.VIOL20">
    <GlobalVariables>
      <StudyName>CT-VIOL20</StudyName>
      <StudyDescription>CT batch 2.0 violations fixture study</StudyDescription>
      <ProtocolName>CT-03</ProtocolName>
    </GlobalVariables>
    <MetaDataVersion OID="MDV.1" Name="CT 2.0 violations MDV" def:DefineVersion="2.0.0"
                     def:StandardName="SDTM-IG" def:StandardVersion="3.2">
      <!-- DD0031: "Sex" is a codelist CT knows by name, but no nci:ExtCodeID Alias. -->
      <CodeList OID="CL.SEX20" Name="Sex" DataType="text">
        <EnumeratedItem CodedValue="X"/>
      </CodeList>
      <!-- DD0024 on a 2.0 document: Z is not a term of non-extensible C66731.
           ("Sex Assignment" is unknown to codelistByName, and the alias is present
           anyway, so DD0031 stays quiet here.) -->
      <CodeList OID="CL.SEX20B" Name="Sex Assignment" DataType="text">
        <EnumeratedItem CodedValue="Z"/>
        <Alias Context="nci:ExtCodeID" Name="C66731"/>
      </CodeList>
    </MetaDataVersion>
  </Study>
</ODM>
