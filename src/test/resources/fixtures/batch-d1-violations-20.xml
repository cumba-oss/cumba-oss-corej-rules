     FileType="Snapshot"
     ODMVersion="1.3.2"
     CreationDateTime="2026-07-03T10:15:30">
  <Study OID="ST.BATCHD1V20">
    <GlobalVariables>
      <StudyName>BATCHD1V20-STUDY</StudyName>
      <StudyDescription>Batch D1 violations 2.0 fixture study</StudyDescription>
      <ProtocolName>BATCHD1V20-01</ProtocolName>
    </GlobalVariables>
    <MetaDataVersion OID="MDV.1" Name="Batch D1 violations 2.0 MDV"
                     def:DefineVersion="2.0.0">
      <ItemDef OID="IT.A" Name="VARA" DataType="text" Length="20">
        <def:Origin Type="CRF"/>
      </ItemDef>
      <ItemDef OID="IT.B" Name="VARB" DataType="text" Length="20">
        <def:Origin Type="Collected"/>
      </ItemDef>
    </MetaDataVersion>
