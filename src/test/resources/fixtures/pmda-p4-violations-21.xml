<?xml version="1.0" encoding="UTF-8"?>
<!-- PMDA batch P4 violations fixture (2.1): one dedicated violator per 2.1-applicable
     P4 rule, each isolated so every rule fires exactly once:
       ODM         - FileType=Transactional (DD0019)
       MDV.1       - def:DefineVersion=2.1 (DD0020B)
       Standards   - one bad Version per DD0022 leg (base/-B/-C/-D/-E) plus a
                     Status=Retired standard (DD0141)
       IG.DM       - SDTM + Purpose=Analysis (DD0053); ItemRef Mandatory=Y (OD0074)
       IG.AE       - SASDatasetName AE vs ea.xpt (DD0052); IG Alias Context=Other (DD0064)
       IG.BADDS    - SASDatasetName=1BAD (DD0048); Repeating=Y (OD0072)
       IG.REF      - IsReferenceData=Yes + Repeating=Yes (DD0135)
       IG.REFBAD   - IsReferenceData=Reference (OD0073)
       IG.NONSTD   - def:IsNonStandard=No (DD0130)
       IG.SEND/IG.ADSL/IG.ADAE - SEND CRF origin (DD0073-B), ADaM Tabulation
                     (DD0053-B), ADaM Collected origin (DD0073-C)
       ItemDefs    - AESEV Origin=Other in SDTM (DD0073), DOMAIN=Collected (DD0106),
                     RDOMAIN=Derived (DD0107), STUDYID=Assigned (DD0108), second
                     USUBJID/VISITNUM deviating (DD0109/DD0110), AEDECOD without a
                     MedDRA reference (DD0113), LBORRES DataType=string (OD0075),
                     AVAL float vs text codelist (OD0080), BASE Predecessor text
                     without a dot (DD0148)
       VL.QVAL     - value Origin Collected vs variable Derived (DD0074); value
                     Length 300 over variable 200 (DD0123)
       WC.1        - RangeCheck SoftHard=Medium (DD0044)
       CodeLists   - MEDDRA Version=26 (DD0025), MEDDRA2 without Version (DD0112-B),
                     integer term ABC (OD0077), float term 1.2.3 (OD0077-B),
                     DataType=boolean (OD0076), SASFormatName=9FMT (OD0019), text
                     codelist SASFormatName without $ (OD0078), ExtendedValue=No
                     (DD0030), codelist/item aliases with wrong Context
                     (DD0064-B/-C/-D), xml:lang=en_US decode (OD0021)
       MT.BAD      - MethodDef Type=Derivation (DD0104)
     DD0112 cannot fire here (a MedDRA codelist exists by design); its violator
     lives in pmda-p4-violations-20.xml. -->
<ODM xmlns="http://www.cdisc.org/ns/odm/v1.3"
