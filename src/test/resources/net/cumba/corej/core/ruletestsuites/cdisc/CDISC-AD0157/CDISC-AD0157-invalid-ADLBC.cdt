#!RuleTest
#test CDISC-AD0157 expect=violation domain=ADLBC
# Rule:Description: A variable with a prefix of CRIT and a suffix of a one-digit number (CRITy) is present and a variable with the same root with a suffix of FL (CRITyFL) is not present
#note "CRIT1 present but CRIT1FL absent -> violation"
#expectViolationCount 1
#expectViolationAt nameOnly=CRIT1
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col CRIT1 type=Char
---
CDISCPILOT01 | 01-701-1015 | ALB | 1
---
