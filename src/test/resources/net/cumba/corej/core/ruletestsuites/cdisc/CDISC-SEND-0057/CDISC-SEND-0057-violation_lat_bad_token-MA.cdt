#!RuleTest
#test CDISC-SEND-0057 expect=violation domain=MA
#note "R-5.25 split of SEND57.1 (top-level-or board wave 2, group J), the parent (--LAT half): row 2 combines a lawful (LAT) term with a token that is no (LAT) submission value -> fires, and the finding names MALAT and its own codelist instead of the three-variable disjunction. Row 1 is a lawful semicolon combination and row 3 a single lawful term - both silent."
#library standard=sendig version=3-1-1
#library codelist-terms LAT LEFT RIGHT BILATERAL
#expectViolationCount 1
#expectViolationAt row=2 MASEQ=2
dataset MA class=FINDINGS label="Macroscopic Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col MASEQ    type=Num  label="Sequence Number"
col MATESTCD type=Char label="Macroscopic Examination Short Name"
col MALAT type=Char label="Finding Qualifier"
---
S1 | MA | 001 | 1 | GMACROS | LEFT;RIGHT
S1 | MA | 001 | 2 | GMACROS | LEFT;SIDEWAYS
S1 | MA | 001 | 3 | GMACROS | LEFT
