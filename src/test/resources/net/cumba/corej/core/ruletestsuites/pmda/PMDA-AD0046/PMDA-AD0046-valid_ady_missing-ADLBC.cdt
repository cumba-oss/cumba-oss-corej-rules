#!RuleTest
#test PMDA-AD0046 expect=noViolation domain=ADLBC
#note "ADY is a genuine missing value (lone '.'), not equal to 0, so its cell does not fire; ASTDY=5 does not either. Pins the manual's missing-vs-zero distinction for a Num variable - the fixture that would flip if value()==0 ever started treating a missing numeric as zero."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ADY     type=Num
col ASTDY   type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | . | 5
