#!RuleTest
#test PMDA-AD0279 expect=noViolation domain=ADAE
#note "DISCRIMINATOR of the R-5.25 split: ASEVN is 0 on row 1 - the split sibling PMDA-AD0279-A's state - while AESEVN is in [1,2,3] throughout. The parent owns only the AESEVN half and must stay silent on the byte-identical dataset of the sibling's violation fixture."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADAE structure=OCCDS
col STUDYID type=Char
col USUBJID type=Char
col AEDECOD type=Char
col AESEVN  type=Num
col ASEVN   type=Num
---
CDISCPILOT01 | 01-701-1015 | HEADACHE | 1 | 0
CDISCPILOT01 | 01-701-1023 | NAUSEA | 2 | 2
