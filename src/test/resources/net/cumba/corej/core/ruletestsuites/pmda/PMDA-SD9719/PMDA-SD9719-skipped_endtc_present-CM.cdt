#!RuleTest
#test PMDA-SD9719 expect=skipped domain=CM
#note "The discriminator that keeps the pair from double-reporting: the CMENDTC column EXISTS (blank on both rows), so Requirements.Variables.None [--ENDTC, --ENRF, --ENRTPT, --DUR] skips this sister with a reason naming the column, and PMDA-SD0021 owns the case, reporting row 1 (CMOCCUR='Y', nothing populated) with its location."
#library standard=sdtmig version=3-4
dataset CM class=INTERVENTIONS label="Concomitant Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ   type=Num  label="Sequence Number"
col CMTRT   type=Char label="Reported Name of Drug, Med, or Therapy"
col CMOCCUR type=Char label="CM Occurrence"
col CMENDTC type=Char label="End Date/Time of Medication"
---
S1 | CM | 001 | 1 | ASPIRIN   | Y |
S1 | CM | 001 | 2 | IBUPROFEN | N |
