#!RuleTest
#test CDISC-SEND-0070-A expect=violation domain=LB
#note "The half this R-5.25 split sibling owns (top-level-or board wave 2, group J): LBSTDTC's interval halves are tier 10 ('2023-01-15') against tier 7 ('2023-01') on row 1 -> fires, reported against --STDTC. Before the split this finding was mis-attributed to --DTC - the parent's Output_Variables was ['--DTC'] alone (the board's group J witness). Row 2 has equal precision on both sides."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 LBSEQ=1
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Test Short Name"
col LBSTDTC  type=Char label="Start Date/Time of Specimen Collection"
---
S1 | LB | 001 | 1 | ALB | 2023-01-15/2023-01
S1 | LB | 001 | 2 | ALB | 2023-01-15/2023-01-20
