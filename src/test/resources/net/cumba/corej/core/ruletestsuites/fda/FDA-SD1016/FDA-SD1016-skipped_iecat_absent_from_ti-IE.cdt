#!RuleTest
#test FDA-SD1016 expect=skipped domain=IE
#note "PLAN-join-key-authoring-gate phase 3/4, sensitivity arm row 1 on a non-first key — IE carries IECAT, TI does not. The group [IECAT, TI.IECAT] is only partly present, so the rule SKIPS. Before the gate TI's missing IECAT contributed its type default and no IE row matched, so every IE row was reported although TI defines its criterion (a flood)."
#library standard=sdtmig version=3-4
dataset IE label="Inclusion/Exclusion Criteria Not Met"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IESEQ    type=Num  label="Sequence Number"
col IETESTCD type=Char label="Incl/Excl Criterion Short Name"
col IETEST   type=Char label="Inclusion/Exclusion Criterion"
col IECAT    type=Char label="Inclusion/Exclusion Category"
col IEORRES  type=Char label="I/E Criterion Original Result"
---
CDISCPILOT01 | IE | 01-701-1015 | 1 | INCL01 | Age 18 or older | INCLUSION | N
---

dataset TI label="Trial Inclusion/Exclusion Criteria"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col IETESTCD type=Char label="Incl/Excl Criterion Short Name"
col IETEST   type=Char label="Inclusion/Exclusion Criterion"
col TIRL     type=Char label="Inclusion/Exclusion Criterion Rule"
---
CDISCPILOT01 | TI | INCL01 | Age 18 or older | AGE >= 18
