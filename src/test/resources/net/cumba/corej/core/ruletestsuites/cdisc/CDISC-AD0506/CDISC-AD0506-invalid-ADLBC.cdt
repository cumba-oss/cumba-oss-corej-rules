#note "PADY label "Param Day" lacks "Relative Day" -> violation"
#expectViolationCount 1
#expectViolationAt variable_label="Param Day" variable_name=PADY
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col PADY type=Char label="Param Day"
