#!RuleTest
#test PMDA-AD0310 expect=violation domain=ADAE
#note "KEY=SMQ01SCN (2nd arg), DEPENDENT=SMQ01SC (1st arg): key 1 carries {BROAD,NARROW} -> rows 1,2 fire; key 2 is single-valued. Wildcard SMQ(\\d{2})SC/SMQ(\\d{2})SCN give exactly ONE tuple (zz=01) -> one expansion. Record granularity -> 2 violations. Add NO further SMQ<dd>SC/SMQ<dd>SCN column."
#library standard=adamig version=1-0
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015 SMQ01SC=BROAD SMQ01SCN=1
#expectViolationAt row=2 USUBJID=01-701-1023 SMQ01SC=NARROW SMQ01SCN=1
dataset ADAE structure=OCCDS subclass=AE
col STUDYID  type=Char
col USUBJID  type=Char
col AESEQ    type=Num
col AEDECOD  type=Char
col SMQ01SC  type=Char
col SMQ01SCN type=Num
---
CDISCPILOT01 | 01-701-1015 | 1 | HEADACHE | BROAD | 1
CDISCPILOT01 | 01-701-1023 | 1 | NAUSEA | NARROW | 1
CDISCPILOT01 | 01-701-1034 | 2 | RASH | BROAD | 2
