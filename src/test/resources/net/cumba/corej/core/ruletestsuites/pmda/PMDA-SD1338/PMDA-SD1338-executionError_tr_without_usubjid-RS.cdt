#!RuleTest
#test PMDA-SD1338 expect=executionError domain=RS
#expect-execution-error "group= over 'TR' has no usable key"
#note "PLAN-join-key-one-side-absent-drop QK16 (b) / QK18 (owner 2026-10-11): TR without USUBJID - the domain= call's only group= member is on the evaluated side only, so no key member is left on both sides and the rule ERRORs (never an aggregate over the whole of TR). Derived from PMDA-SD1338-invalid-RS.cdt with TR.USUBJID removed. A gate declaring TR.USUBJID would turn this into a SKIP."
#library standard=sdtmig version=3-4
dataset RS label="Disease Response"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RSSEQ    type=Num  label="Sequence Number"
col RSLNKGRP type=Char label="Link Group ID"
col RSTESTCD type=Char label="Response Assessment Short Name"
col RSORRES  type=Char label="Result or Finding in Original Units"
---
CDISCPILOT01 | RS | 001 | 1 | G01 | OVRLRESP | PR
CDISCPILOT01 | RS | 001 | 2 | G09 | OVRLRESP | SD
CDISCPILOT01 | RS | 002 | 1 | G01 | OVRLRESP | CR
CDISCPILOT01 | RS | 002 | 2 |  | LSTASS | PD
---

dataset TR label="Tumor Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TRSEQ    type=Num  label="Sequence Number"
col TRLNKGRP type=Char label="Link Group ID"
col TRTESTCD type=Char label="Tumor Assessment Short Name"
col TRORRES  type=Char label="Result or Finding in Original Units"
---
CDISCPILOT01 | TR | 1 | G01 | LDIAM | 20
CDISCPILOT01 | TR | 1 | G05 | LDIAM | 12
---
