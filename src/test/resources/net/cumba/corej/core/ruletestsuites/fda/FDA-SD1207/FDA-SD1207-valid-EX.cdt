#!RuleTest
#test FDA-SD1207 expect=noViolation domain=EX
#note "Row 1: EXENDTC equal to RFXENDTC -> boundary, strict greater-than does not fire. Row 2: EXENDTC before RFXENDTC -> ok. Row 3: EXENDTC empty -> ok. Row 4: subject with empty RFXENDTC -> no comparand, no fire."
#library standard=sdtmig version=3-4
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXENDTC type=Char label="End Date/Time of Treatment"
---
S1 | EX | 001 | 1 | DRUG A | 2020-03-31
S1 | EX | 001 | 2 | DRUG A | 2020-02-15
S1 | EX | 001 | 3 | DRUG A |
S1 | EX | 002 | 1 | DRUG A | 2020-06-01
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFXENDTC type=Char label="Date/Time of Last Study Treatment"
---
S1 | DM | 001 | 2020-03-31
S1 | DM | 002 |
---
