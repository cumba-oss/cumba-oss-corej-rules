#!RuleTest
#test PMDA-SD9717 expect=noViolation domain=LB
#note "LBTOX is absent and LBTOXGR exists, so the sister RUNS - but every grade is 0, which the regex /[1-9]/ deliberately does not match. R-4.11c containment: [0-9] would fire here where the parent (--TOXGR > 0) never does. Mirrors PMDA-SD1037-valid_grade_zero-LB, where grade 0 with no toxicity name is the legitimate 'no toxicity occurred' record."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBTOXGR  type=Char label="Toxicity Grade"
---
S1 | LB | 001 | 1 | ALT | 0
