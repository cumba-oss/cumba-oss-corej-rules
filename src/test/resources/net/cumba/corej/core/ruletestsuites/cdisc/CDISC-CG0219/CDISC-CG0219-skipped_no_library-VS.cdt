#!RuleTest
#test CDISC-CG0219 expect=skipped domain=VS
#note "NO #library line at all: get_model_filtered_variables needs the CDISC Library, so the rule SKIPs (never a PASS over an empty Timing set). The body is the invalid one (with a Library it fires). W4 (PLAN-list-functions phase 0, scenarios-first on the pre-port engine)."
dataset VS class=FINDINGS label="Vital Signs"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VSSEQ    type=Num  label="Sequence Number"
col VSTESTCD type=Char label="Vital Signs Test Short Name"
col VSORRES  type=Char label="Result or Finding in Original Units"
---
S1 | VS | 001 | 1 | SYSBP | 120
