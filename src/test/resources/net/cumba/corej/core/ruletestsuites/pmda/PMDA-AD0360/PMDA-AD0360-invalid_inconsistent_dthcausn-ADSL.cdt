#!RuleTest
#test PMDA-AD0360 expect=violation domain=ADSL
#note "Mirror of AD0359: key is DTHCAUS, target is DTHCAUSN. Group MYOCARDIALINFARCTION holds targets {1,1,2}, so the minority row 3 fires."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 DTHCAUS=MYOCARDIALINFARCTION DTHCAUSN=2
dataset ADSL
col STUDYID  type=Char
col USUBJID  type=Char
col DTHCAUS  type=Char
col DTHCAUSN type=Num
---
CDISCPILOT01 | 01-701-1015 | MYOCARDIALINFARCTION | 1
CDISCPILOT01 | 01-701-1023 | MYOCARDIALINFARCTION | 1
CDISCPILOT01 | 01-701-1034 | MYOCARDIALINFARCTION | 2
CDISCPILOT01 | 01-701-1047 | STROKE                | 3
