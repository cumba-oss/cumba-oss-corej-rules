#!RuleTest
#test CDISC-SEND-0106.1 expect=violation domain=DM
#note "DISCRIMINATOR for the sheet's 'and TSVAL ^= null for that record' half. A TSPARMCD=STRAIN record EXISTS but its TSVAL is EMPTY: evalTsParameterValue returns the first key-matching row's value and maps a blank cell to null, so `empty($ts_strain)` is TRUE and the study is not rescued. A reading that tested only for the record's existence would stay silent here."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SPECIES type=Char label="Species"
col STRAIN  type=Char label="Strain/Substrain"
---
S1 | DM | 001 | RAT |
---

dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL    type=Char label="Parameter Value"
---
S1 | TS | 1 | STRAIN   |
S1 | TS | 2 | SNDIGVER | SENDIG 3.1.1
---

dataset TX class="TRIAL DESIGN" label="Trial Sets"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col SETCD    type=Char label="Set Code"
col TXSEQ    type=Num  label="Sequence Number"
col TXPARMCD type=Char label="Trial Set Parameter Short Name"
col TXVAL    type=Char label="Parameter Value"
---
S1 | TX | G1 | 1 | TRTDOS | 100
---
