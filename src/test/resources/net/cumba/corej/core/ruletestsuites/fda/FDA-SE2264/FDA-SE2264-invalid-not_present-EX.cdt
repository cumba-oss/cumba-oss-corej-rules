#!RuleTest
#test FDA-SE2264 expect=violation domain=EX
#note "RPHASE is not present in the dataset at all while the actual Repro Phase start day EXRPSTDY (--RPSTDY) is populated on row 1 -> fires (absent RPHASE counts as not populated). Row 2 has no timing value and must not fire."
#library standard=sendig-dart version=1-1
#expectViolationCount 1
#expectViolationAt row=1
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col EXSEQ    type=Num  label="Sequence Number"
col EXTRT    type=Char label="Name of Actual Treatment"
col EXRPSTDY type=Num  label="Actual Repro Phase Day of First Exposure"
---
S1 | EX | 001 | 1 | TEST ARTICLE | 1
S1 | EX | 001 | 2 | TEST ARTICLE |
