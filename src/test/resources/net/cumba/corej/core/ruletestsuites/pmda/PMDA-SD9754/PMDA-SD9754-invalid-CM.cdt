#!RuleTest
#test PMDA-SD9754 expect=violation domain=CM
#note "Rule round 2026-10-12 (owner, batch D item 4a): CMENDY is populated on rows 1 and 2 and the dataset carries no CMENDTC -> ONE finding for the dataset, not one per record."
#library standard=sdtmig version=3-2
#expectViolationCount 1
dataset CM class=INTERVENTIONS label="Concomitant Medications"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col CMSEQ    type=Num  label="Sequence Number"
col CMTRT type=Char label="Reported Name of Drug, Med, or Therapy"
col CMENDY type=Num label="Study Day of End of Observation"
---
S1 | CM | 001 | 1 | ASPIRIN | 5
S1 | CM | 002 | 2 | ASPIRIN | 6
S1 | CM | 003 | 3 | ASPIRIN | 
