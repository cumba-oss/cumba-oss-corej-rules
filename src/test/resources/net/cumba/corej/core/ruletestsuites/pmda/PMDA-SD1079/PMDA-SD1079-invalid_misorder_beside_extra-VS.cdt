#!RuleTest
#test PMDA-SD1079 expect=violation domain=VS
#note "VSTEST is declared before VSTESTCD, contradicting the model order, and VSCUSTOM (not in the model list) sits between them. The unknown variable is ignored, the misorder among the known ones is still reported - once for the dataset."
#library standard=sdtmig version=3-4
#library model-column-order VS STUDYID DOMAIN USUBJID VSSEQ VSGRPID VSTESTCD VSTEST VSCAT VSPOS VSORRES VSORRESU
#expectViolationCount 1
dataset VS class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col VSSEQ    type=Num
col VSTEST   type=Char
col VSCUSTOM type=Char
col VSTESTCD type=Char
col VSORRES  type=Char
---
S1 | VS | 001 | 1 | Test | X | X1 | 1
---
