#!RuleTest
#test CDISC-CG0545 expect=violation domain=SM
# Rule:Description: Raise an error when the Disease Milestone Type (MIDSTYPE) is not unique within a subject for a disease milestone that can occur only once (the matching Trial Disease Milestones (TM) record has TMRPT equal to 'N').
#note "MIDSTYPE=HYPOGLYCEMIC EVENT repeats within the subject while TM.TMRPT=N"
#expectViolationCount 2
#expectViolationAt row=1 SMSEQ=1 USUBJID=01-701-1015
#expectViolationAt row=2 SMSEQ=2 USUBJID=01-701-1015
dataset SM label="Subject Disease Milestones"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SMSEQ type=Num label="Sequence Number"
col MIDSTYPE type=Char label="Milestone Type"
---
CDISCPILOT01 | SM | 01-701-1015 | 1 | HYPOGLYCEMIC EVENT
CDISCPILOT01 | SM | 01-701-1015 | 2 | HYPOGLYCEMIC EVENT
---

dataset TM label="Trial Disease Milestones"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col MIDSTYPE type=Char label="Milestone Type"
col TMRPT type=Char label="Planned Milestone Repeated"
---
CDISCPILOT01 | TM | HYPOGLYCEMIC EVENT | N
---
