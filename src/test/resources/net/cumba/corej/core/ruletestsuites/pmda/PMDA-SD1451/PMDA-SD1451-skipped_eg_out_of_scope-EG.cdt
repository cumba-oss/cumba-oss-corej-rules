#!RuleTest
#test PMDA-SD1451 expect=skipped domain=EG
#note "Domains.Include [PP] rejects everything else. Load-bearing twin discriminator: EG IS in FDA-SD1451's scope (CV, EG, PP, RE per its sheet) - each authority faithful to its own Domains cell (PMDA row 402: 'PP')."
#library standard=sdtmig version=3-4
dataset EG class=FINDINGS label="ECG Test Results"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col EGSEQ    type=Num
col EGTESTCD type=Char
col EGENINT  type=Char
---
S1 | EG | 001 | 1 | QTMEAN | P1H
---
