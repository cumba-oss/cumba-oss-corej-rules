#!RuleTest
#test CDISC-CG0272 expect=noViolation domain=TS
#note "HLTSUBJI = N, so the filtered count (TSPARMCD = HLTSUBJI and TSVAL = Y) is 0 and the TDIGRP value 'PATIENTS' is allowed -> nothing fires. The filter's TSVAL = Y key is what keeps this quiet: a count on TSPARMCD alone would be 1. W6 phase 0, scenarios-first."
#library standard=sdtmig version=3-3
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
CDISCPILOT01 | TS | 1 | HLTSUBJI | Healthy Subject Indicator | N
CDISCPILOT01 | TS | 2 | TDIGRP | Diagnosis Group | PATIENTS
