#!RuleTest
#test CDISC-CG0220 expect=violation domain=AE
#note "Row 2: AESTDTC 2014-01-05 against RFSTDTC 2014-01-02 is study day 4, but AESTDY carries 3 (the off-by-one of a day-0 algorithm), so the rule fires once. Row 1 is correct."
#expectViolationCount 1
#expectViolationAt row=2 AESEQ=2 AESTDY=3
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AESTDTC type=Char label="Start Date/Time of Adverse Event"
col AESTDY type=Num label="Study Day of Start of Adverse Event"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | 2014-01-02 | 1
CDISCPILOT01 | AE | 01-701-1015 | 2 | 2014-01-05 | 3
---

dataset DM label=Demographics
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
---
CDISCPILOT01 | DM | 01-701-1015 | 2014-01-02
---
