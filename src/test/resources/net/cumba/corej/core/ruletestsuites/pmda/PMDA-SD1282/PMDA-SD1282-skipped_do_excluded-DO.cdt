#!RuleTest
#test PMDA-SD1282 expect=skipped domain=DO
#note "DO declared class=FINDINGS is in Classes.Include, so ONLY the Domains.Exclude [DM, DO, SE, SV] rejects. Pins this rule's sheet-exact block (same sheet Domains cell as SD1250, WITH the -DO token retained here) - the third face of the batch's DO-divergence pin set."
#library standard=sdtmig version=3-4
dataset DO class=FINDINGS label="Device Properties"
col STUDYID   type=Char
col DOMAIN    type=Char
col SPDEVID   type=Char
col DOSEQ     type=Num
col DOTESTCD  type=Char
col DOTPTREF  type=Char
---
S1 | DO | DEV01 | 1 | DEVTYPE | DEVICE ACTIVATION
---
