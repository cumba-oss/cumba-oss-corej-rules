#!RuleTest
#test CDISC-CG0337 expect=noViolation domain=AE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0337 (Rule: --CAT ^= --DECOD). Every AECAT is a real grouping ('NEUROLOGICAL', 'GASTROINTESTINAL') that differs from its AEDECOD; both columns are present and populated on every row, so the rule executes -> silent."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEDECOD type=Char label="Dictionary-Derived Term"
col AECAT   type=Char label="Category for Adverse Event"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE | HEADACHE | NEUROLOGICAL
CDISCPILOT01 | AE | 01-701-1015 | 2 | DIARRHOEA | DIARRHOEA | GASTROINTESTINAL
---
