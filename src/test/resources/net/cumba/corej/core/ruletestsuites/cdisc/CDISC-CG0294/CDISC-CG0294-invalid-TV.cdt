#!RuleTest
#test CDISC-CG0294 expect=violation domain=TV
# Rule:Description: Raise an error when the Arm Name (ARM) is populated but its value is not one of the Arm names (ARM) defined in the Trial Arms (TA) dataset.
#note "TV.ARM=Screening is populated but is not one of the TA.ARM values"
#expectViolationCount 1
#expectViolationAt row=1
dataset TV label="Trial Visits"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col VISITNUM type=Num label="Visit Number"
col VISIT type=Char label="Visit Name"
col ARM type=Char label="Description of Planned Arm" format=$ARM.
---
CDISCPILOT01 | TV | 1 | SCREENING 1 | Screening
CDISCPILOT01 | TV | 2 | BASELINE | Placebo
---

dataset TA label="Trial Arms"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col ARM type=Char label="Description of Planned Arm" format=$ARM.
---
CDISCPILOT01 | TA | Placebo
CDISCPILOT01 | TA | Xanomeline High Dose
---
