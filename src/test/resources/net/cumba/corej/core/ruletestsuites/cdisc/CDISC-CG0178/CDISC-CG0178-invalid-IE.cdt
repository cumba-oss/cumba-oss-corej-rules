#!RuleTest
#test CDISC-CG0178 expect=violation domain=IE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0178 (Rule: IETEST in TI.IETEST). Row 2's IETEST 'Undefined criterion' is not a TI.IETEST value -> fires; row 1's is. ALSO THE S3 DISCRIMINATOR (SKELETON-distinct-function hazard 3): IETEST in distinct(IETEST, domain=TI) belongs to the FOREIGN dataset TI; a port that read IETEST from the primary IE would find row 2's own value in the set and fall silent."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=002 IETESTCD=EXCL99
dataset IE class=FINDINGS label="Inclusion/Exclusion Criteria Not Met"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IESEQ    type=Num  label="Sequence Number"
col IETESTCD type=Char label="Incl/Excl Criterion Short Name"
col IETEST   type=Char label="Inclusion/Exclusion Criterion"
---
S1 | IE | 001 | 1 | INCL01 | Age 18 or older
S1 | IE | 002 | 1 | EXCL99 | Undefined criterion
---

dataset TI class="TRIAL DESIGN" label="Trial Inclusion/Exclusion Criteria"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col IETESTCD type=Char label="Incl/Excl Criterion Short Name"
col IETEST   type=Char label="Inclusion/Exclusion Criterion"
col IECAT    type=Char label="Inclusion/Exclusion Category"
---
S1 | TI | INCL01 | Age 18 or older | INCLUSION
S1 | TI | EXCL01 | Pregnant        | EXCLUSION
---
