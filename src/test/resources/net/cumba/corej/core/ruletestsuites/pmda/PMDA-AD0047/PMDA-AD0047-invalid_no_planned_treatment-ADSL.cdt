#!RuleTest
#test PMDA-AD0047 expect=violation domain=ADSL
#note "FRESH for Fix #368 — the OTHER direction of template substitution, and the one that is easy to lose. Every literal Required variable is present, but the dataset carries NO planned-treatment variable at all: no TRT01P, no TRT02P, nothing matching TRTxxP. The obligation must still be reported, as the template verbatim. An implementation that expanded TRTxxP to whatever happened to match would make this dataset pass silently — the absent-column trap, in the one place where the absence IS the defect."
#library standard=adamig version=1-3
#library required-variables-for-structure "SUBJECT LEVEL ANALYSIS DATASET" STUDYID USUBJID SUBJID SITEID AGE AGEU SEX RACE ARM TRTxxP
#expectViolationCount 1
dataset ADSL structure=ADSL
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col SITEID  type=Char label="Study Site Identifier"
col AGE     type=Num  label="Age"
col AGEU    type=Char label="Age Units"
col SEX     type=Char label="Sex"
col RACE    type=Char label="Race"
col ARM     type=Char label="Description of Planned Arm"
---
CDISCPILOT01 | 01-701-1015 | 1015 | 701 | 63 | YEARS | F | WHITE | Placebo
