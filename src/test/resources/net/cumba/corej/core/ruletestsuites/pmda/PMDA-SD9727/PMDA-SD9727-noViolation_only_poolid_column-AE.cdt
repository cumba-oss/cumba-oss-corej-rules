#!RuleTest
#test PMDA-SD9727 expect=noViolation domain=AE
#note "ANY one of the four identifier columns suffices to silence the sister: only POOLID is in the dataset, so the last conjunct not var_exists(\"POOLID\") is false and the conjunction cannot hold -- pinning that the sister demands the absence of ALL FOUR, mirroring the parent's Any gate, not the absence of any one."
#library standard=sdtmig version=3-4
#expectViolationCount 0
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col POOLID  type=Char label="Pool Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
---
S1 | AE | POOL1 | 1 | Body weight decreased
