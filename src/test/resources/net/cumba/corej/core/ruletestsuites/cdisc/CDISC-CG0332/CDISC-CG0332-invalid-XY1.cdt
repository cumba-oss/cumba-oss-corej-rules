#!RuleTest
#test CDISC-CG0332 expect=violation domain=XY1
# Rule:Description: Raise an error when a split dataset (a three- or four-character dataset name not beginning with AP or FA) does not have its two-character parent domain present in the study.
#note "Split dataset XY1 carries DOMAIN ZZ; no dataset in the study carries DOMAIN XY, so the name's two-character prefix XY matches no domain present -> violation"
#expectViolationCount 1
dataset XY1 label="Split dataset whose name prefix XY is no domain in the study"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | ZZ | 01-701-1015
CDISCPILOT01 | ZZ | 01-701-1023
---

dataset DM label=Demographics
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | DM | 01-701-1015
CDISCPILOT01 | DM | 01-701-1023
---

dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | AE | 01-701-1015
---
