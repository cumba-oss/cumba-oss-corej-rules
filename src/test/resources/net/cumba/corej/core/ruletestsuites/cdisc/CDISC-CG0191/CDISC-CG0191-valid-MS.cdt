#!RuleTest
#test CDISC-CG0191 expect=noViolation domain=MS
#note "MS and its companion MB dataset are both present -> no violation."
#library standard=sdtmig version=3-4
dataset MS class=FINDINGS label="Microbiology Susceptibility Test"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col MSSEQ   type=Num  label="Sequence Number"
col MSTESTCD type=Char label="Microbiology Susceptibility Test Short Name"
---
S1 | MS | 001 | 1 | MIC
---

dataset MB class=FINDINGS label="Microbiology Specimen"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col MBSEQ   type=Num  label="Sequence Number"
col MBTESTCD type=Char label="Microbiology Test or Finding Short Name"
---
S1 | MB | 001 | 1 | ORGANISM
