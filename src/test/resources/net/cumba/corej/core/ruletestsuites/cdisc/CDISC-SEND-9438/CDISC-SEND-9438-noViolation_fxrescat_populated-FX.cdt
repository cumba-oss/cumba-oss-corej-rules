#!RuleTest
#test CDISC-SEND-9438 expect=noViolation domain=FX
#note "Neither exemption column is in the dataset, but every row's FXRESCAT is populated - the requirement the family exists to state is met on every record, so the absent exemption columns are unremarkable. The sister fires only where its parent would have fired (R-4.11c)."
#library standard=sendig-dart version=1-2
dataset FX class=FINDINGS label="Fetal Pathology Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col FXSEQ    type=Num  label="Sequence Number"
col FXTESTCD type=Char label="Fetal Pathology Test Short Name"
col FXRESCAT type=Char label="Result Category"
---
S1 | FX | 001 | 1 | FPEXAM | SKELETAL
S1 | FX | 002 | 2 | FPEXAM | VISCERAL
