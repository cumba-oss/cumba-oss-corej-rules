#!RuleTest
#test CDISC-CG0337 expect=violation domain=AE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0337 (Rule: --CAT ^= --DECOD). Row 1's AECAT 'Headache' repeats the dictionary-derived term AEDECOD 'HEADACHE' (case-insensitive) -> fires. Row 2's AECAT 'NEUROLOGICAL' differs from AEDECOD 'DIZZINESS' -> silent."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 AESEQ=1 AEDECOD=HEADACHE
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEDECOD type=Char label="Dictionary-Derived Term"
col AECAT   type=Char label="Category for Adverse Event"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE | HEADACHE | Headache
CDISCPILOT01 | AE | 01-701-1015 | 2 | DIZZY | DIZZINESS | NEUROLOGICAL
---
