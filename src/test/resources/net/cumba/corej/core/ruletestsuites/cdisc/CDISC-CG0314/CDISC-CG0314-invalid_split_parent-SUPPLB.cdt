#!RuleTest
#test CDISC-CG0314 expect=violation domain=SUPPLB
#note "D2 (shape census, fixed in W4): the parent LB is SPLIT into LBCH and LBHE - no dataset is named LB. get_parent_model_column_order must resolve RDOMAIN=LB to every member of the split family (tablesForDomain) and union their model column orders; QNAM=LBTESTCD is a model variable of LB -> fires. Before the fix the parent resolved to nothing and the rule SKIPPED silently. W4 (PLAN-list-functions phase 0, scenarios-first on the pre-port engine)."
#library standard=sdtmig version=3-4
#library model-column-order LBCH STUDYID DOMAIN USUBJID LBSEQ LBTESTCD LBTEST LBORRES
#library model-column-order LBHE STUDYID DOMAIN USUBJID LBSEQ LBTESTCD LBTEST LBORRES
#expectViolationCount 1
#expectViolationAt row=1 QNAM=LBTESTCD
dataset SUPPLB class=RELATIONSHIP label="Supplemental Qualifiers for LB"
col STUDYID type=Char label="Study Identifier"
col RDOMAIN type=Char label="Related Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col IDVAR   type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM    type=Char label="Qualifier Variable Name"
col QLABEL  type=Char label="Qualifier Variable Label"
col QVAL    type=Char label="Data Value"
---
S1 | LB | 001 | LBSEQ | 1 | LBTESTCD | Test code | X
S1 | LB | 001 | LBSEQ | 1 | LBXTRA | Extra | Y
---

dataset LBCH label="Laboratory Test Results (LBCH)"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
---
S1 | LB | 001 | 1 | GLUC
---

dataset LBHE label="Laboratory Test Results (LBHE)"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
---
S1 | LB | 001 | 1 | GLUC
---
