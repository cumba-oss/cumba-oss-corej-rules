#!RuleTest
#test CDISC-CG0554-C expect=noViolation domain=AE
#note "R-5.25 wave-3 group K split of CG0554 (each missing key variable is its own defect), subject-identifier half: only SPDEVID of the four identifier columns is present - ANY one silences the half, pinning that the within-branch and-group demands the absence of ALL FOUR."
#library standard=sdtmig version=3-4
#expectViolationCount 0
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col SPDEVID type=Char label="Sponsor Device Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
---
S1 | AE | DEV1 | 1 | Device issue
