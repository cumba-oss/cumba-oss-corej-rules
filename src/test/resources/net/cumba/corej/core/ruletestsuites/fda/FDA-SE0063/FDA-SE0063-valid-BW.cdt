#!RuleTest
#test FDA-SE0063 expect=noViolation domain=BW
#note "Every IG-known variable carries exactly the label the SEND IG specifies. STUDYID/USUBJID have no IG entry, so the variable_name = library_variable_name gate excludes them."
#library standard=sendig version=3-1-1
#library variable-metadata BW BWTESTCD name=BWTESTCD label="Test Short Name"
#library variable-metadata BW BWSTRESC name=BWSTRESC label="Standardized Result in Character Format"
#library variable-metadata BW BWSTRESN name=BWSTRESN label="Standardized Result in Numeric Format"
dataset BW label="Body Weight"
col STUDYID  type=Char label="Study Identifier"
col USUBJID  type=Char label="Unique Subject Identifier"
col BWTESTCD type=Char label="Test Short Name"
col BWSTRESC type=Char label="Standardized Result in Character Format"
col BWSTRESN type=Num  label="Standardized Result in Numeric Format"
---
S1 | 001 | BW | 250 | 250
