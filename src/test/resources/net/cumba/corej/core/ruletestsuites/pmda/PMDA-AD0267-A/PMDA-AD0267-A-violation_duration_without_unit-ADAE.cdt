#!RuleTest
#test PMDA-AD0267-A expect=violation domain=ADAE
#note "The half this R-5.25 split sibling owns: row 1 has ADURN with no ADURU -> fires. Row 2 (ADURU with no ADURN) is the PARENT PMDA-AD0267's state and must NOT fire here - the discriminator of the split, on the same dataset the parent's violation fixture uses. Record granularity -> exactly 1 violation."
#library standard=adamig version=1-0
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015 ADURN=5
dataset ADAE
col STUDYID type=Char
col USUBJID type=Char
col AEDECOD type=Char
col ADURN   type=Num
col ADURU   type=Char
