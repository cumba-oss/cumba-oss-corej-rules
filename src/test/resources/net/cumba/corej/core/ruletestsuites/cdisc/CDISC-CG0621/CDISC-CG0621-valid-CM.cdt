#!RuleTest
#test CDISC-CG0621 expect=noViolation domain=CM
# Rule:Description: Raise an error when --METHOD is present in an Interventions class dataset, because this variable is not permitted in human clinical trials.
#note "CMMETHOD column absent from the Interventions dataset -> '--METHOD exists' is false, no violation"
dataset CM label="Concomitant Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ type=Num label="Sequence Number"
col CMTRT type=Char label="Reported Name of Drug, Med, or Therapy"
---
CDISCPILOT01 | CM | 01-701-1015 | 1 | ASPIRIN
CDISCPILOT01 | CM | 01-701-1015 | 2 | CALCIUM
---
