#!RuleTest
#test CDISC-SEND-9439 expect=noViolation domain=SE
#note "SEUPDES is not in the dataset, but no row codes ETCD='UNPLAN' - every element is planned, so an absent SEUPDES is unremarkable. The sister fires only where its parent would have fired (R-4.11c)."
#library standard=sendig version=3-1-1
dataset SE label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ   type=Num  label="Sequence Number"
col ETCD    type=Char label="Element Code"
col ELEMENT type=Char label="Description of Element"
---
S1 | SE | 001 | 1 | SCRN | Screening
S1 | SE | 001 | 2 | TRT  | Treatment
---
