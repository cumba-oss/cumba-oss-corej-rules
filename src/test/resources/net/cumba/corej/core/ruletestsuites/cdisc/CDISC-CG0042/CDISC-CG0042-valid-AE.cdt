#!RuleTest
#test CDISC-CG0042 expect=noViolation domain=AE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0042 (Condition: no seriousness criterion = 'Y'; Rule: AESER = 'N'). Rows 1-2: AESER=Y, each backed by a criterion = Y (Condition false). Row 3: no criterion = Y and AESER=N -> silent."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESER   type=Char label="Serious Event"
col AESDTH  type=Char label="Results in Death"
col AESHOSP type=Char label="Requires or Prolongs Hospitalization"
col AESLIFE type=Char label="Is Life Threatening"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | PNEUMONIA | Y | N | Y | N
CDISCPILOT01 | AE | 01-701-1023 | 1 | ANAPHYLAXIS | Y | N | N | Y
CDISCPILOT01 | AE | 01-701-1028 | 1 | HEADACHE | N | N | N | N
