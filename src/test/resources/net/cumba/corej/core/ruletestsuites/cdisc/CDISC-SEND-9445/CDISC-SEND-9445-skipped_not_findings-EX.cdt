#!RuleTest
#test CDISC-SEND-9445 expect=skipped domain=EX
#note "Scope boundary: the companion is Class FND, as its parents; EX is an INTERVENTIONS dataset, so the rule does not apply although the body would fire (EXREASEX populated, no EXEXCLFL column)."
#library standard=sendig version=3-1-1
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col EXSEQ    type=Num  label="Sequence Number"
col EXTRT    type=Char label="Name of Treatment"
col EXREASEX type=Char label="Reason for Exclusion"
---
S1 | EX | 001 | 1 | DRUG A | Dosing error
