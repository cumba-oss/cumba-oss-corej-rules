#!RuleTest
#test PMDA-AD0090 expect=violation domain=ADLBC
#note "The 2-row shape pins the DATASET granularity (a per-record derivation would report 2). No column matches ^(ARM|ACTARM|TRTSEQ[PA]|TRT\\d\\d[PA]|TR\\d\\d[PA]G\\d+|TSEQ[PA]G\\d+|TRT[PA]|TRT[PA]G\\d+)$ -> count 0 -> exactly ONE violation regardless of row count (Sensitivity DATASET, certain)."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt "$treatment_variable_count"=0
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
---
S1 | 01-701-1015 | ALB | 30
S1 | 01-701-1023 | ALB | 31
