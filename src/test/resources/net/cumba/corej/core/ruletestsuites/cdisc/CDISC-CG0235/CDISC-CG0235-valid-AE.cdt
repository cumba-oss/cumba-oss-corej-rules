#!RuleTest
#test CDISC-CG0235 expect=noViolation domain=AE
# Rule:Description: Raise an error when the end reference time point (--ENTPT) is a complete date that is prior to the date/time of collection (--DTC), but the end relative to reference time point (--ENRTPT) is not one of 'BEFORE', 'COINCIDENT', 'ONGOING', 'AFTER', or 'UNKNOWN'.
#note "AEENTPT prior to AEDTC but AEENRTPT is an allowed value, so the rule does not fire"
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AEDTC type=Char label="Date/Time of Collection"
col AEENTPT type=Char label="End Reference Time Point"
col AEENRTPT type=Char label="End Relative to Reference Time Point"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | 2014-01-20 | 2014-01-10 | COINCIDENT
CDISCPILOT01 | AE | 01-701-1015 | 2 | 2014-01-16 | 2014-01-10 | BEFORE
---
