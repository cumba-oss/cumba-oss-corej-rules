#!RuleTest
#test CDISC-CG0135 expect=noViolation domain=DM
#note "ADAPTED-FROM fda/FDA-SD1255/FDA-SD1255-valid-no_aesdth-DM.cdt (verbatim; renamed). AE without the AESDTH column - the AUTHORED var_exists(AE.AESDTH) guard keeps it silent."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DTHFL   type=Char label="Subject Death Flag"
---
S1 | DM | 001 | N
---

dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
---
S1 | AE | 001 | 1 | CARDIAC ARREST
---
