#!RuleTest
#test FDA-SD9738 expect=noViolation domain=CM
# Rule:Description: Raise an error when Total Daily Dose (--DOSTOT) is populated and its value is less than 0.
#note "CMDOSTOT holds a non-negative value (20); the other record leaves it empty -> no violation"
#library standard=sdtmig version=3-4
dataset CM label="Concomitant Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ type=Num label="Sequence Number"
col CMDOSTOT type=Num label="Total Daily Dose"
---
CDISCPILOT01 | CM | 01-701-1015 | 1 | 20
CDISCPILOT01 | CM | 01-701-1015 | 2 |
---
