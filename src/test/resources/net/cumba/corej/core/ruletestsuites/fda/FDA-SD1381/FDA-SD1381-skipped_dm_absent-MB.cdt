#!RuleTest
#test FDA-SD1381 expect=skipped domain=MB
#note "PLAN-function-surface-wave1 phase 2 (a1) on a parameterised-reference rule: the study has no DM dataset, so All_Or_None [USUBJID, DM.USUBJID] SKIPs the rule before dy(--DTC, DM.RFXSTDTC) is evaluated. MBXDY is deliberately wrong so that an EXECUTE would show as a finding."
#library standard=sendig version=ar-1-0
dataset MB class=FINDINGS
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col MBSEQ   type=Num  label="Sequence Number"
col MBTESTCD type=Char label="Microbiology Test Code"
col MBDTC type=Char label="Date/Time of Collection"
col MBXDY  type=Num  label="Day of Obs Relative to Exposure"
---
S1 | MB | 001 | 1 | BACT | 2023-06-15 | 99
---
