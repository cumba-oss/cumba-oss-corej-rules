#!RuleTest
#test CDISC-CG0086 expect=skipped domain=CM
# Rule:Description: Raise an error when --OCCUR is empty while --PRESP is equal to 'Y' and --STAT is empty.
#note "C4 silent: only var_exists(--OCCUR) is false (CMOCCUR column absent); CMPRESP=Y and CMSTAT blank keep the other conjuncts true, so the rule is silenced solely by the missing OCCUR column"
dataset CM label="Concomitant Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ type=Num label="Sequence Number"
col CMPRESP type=Char label="Pre-Specified"
col CMSTAT type=Char label="Completion Status"
---
CDISCPILOT01 | CM | 01-701-1015 | 1 | Y |
---
