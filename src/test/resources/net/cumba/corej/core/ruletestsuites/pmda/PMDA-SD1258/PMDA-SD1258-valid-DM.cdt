#!RuleTest
#test PMDA-SD1258 expect=noViolation domain=DM
#note "Untreated subjects (ACTARMCD empty or SCRNFAIL / NOTASSGN / NOTTRT) leave RFSTDTC empty; only the treated subject carries a reference start date -> no violation."
#library standard=sdtmig version=3-2
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFSTDTC  type=Char label="Subject Reference Start Date/Time"
col ACTARMCD type=Char label="Actual Arm Code"
---
S1 | DM | 001 |            |
S1 | DM | 002 |            | SCRNFAIL
S1 | DM | 003 |            | NOTASSGN
S1 | DM | 004 |            | NOTTRT
S1 | DM | 005 | 2020-01-18 | A
