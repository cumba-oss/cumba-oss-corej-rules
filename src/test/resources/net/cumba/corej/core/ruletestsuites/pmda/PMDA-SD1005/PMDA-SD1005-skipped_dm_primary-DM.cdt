#!RuleTest
#test PMDA-SD1005 expect=skipped domain=DM
#note "The Exclude-only Scope (Domains.Exclude [DM], no Include - the manual-conformant shape) rejects DM. Twin discriminator: FDA-SD1005 (Domains [ALL], per its sheet 'ALL') RUNS on DM (trivially clean); PMDA's sheet cell is 'ALL (-DM)'."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col SEX     type=Char
---
STUDY01 | DM | 001 | M
