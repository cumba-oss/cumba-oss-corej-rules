#!RuleTest
#test PMDA-SD1231 expect=violation domain=LB
#note "Track B: adapted from FDA-SD1231-invalid-LB.cdt. The GLUC value-level condition declares LBSTRESC Length=3; row 1 carries a 6-character value -> fires. Row 2 is exactly 3 characters and row 3 matches the PH/URINE condition whose Length=7."
#library standard=sdtmig version=3-4
#define-xml PMDA-SD1231-define.xml
#expectViolationCount 1
#expectViolationAt row=1 LBTESTCD=GLUC define_vlm_length=3 variable_value_length=6
dataset LB
col USUBJID  type=Char
col LBTESTCD type=Char
col LBSPEC   type=Char
col LBSTRESC type=Char
---
001 | GLUC | SERUM | 123456
001 | GLUC | SERUM | 5.5
001 | PH   | URINE | ACIDIC
