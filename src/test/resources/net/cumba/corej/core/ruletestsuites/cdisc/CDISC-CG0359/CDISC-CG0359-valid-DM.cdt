#!RuleTest
#test CDISC-CG0359 expect=noViolation domain=DM
#library standard=sdtmig version=3-3
#library variable-metadata DM USUBJID name=USUBJID label="Unique Subject Identifier"
# Rule:Description: Raise an error when a variable label is not in title case, i.e. the first letter of every word is not capitalized except for articles, prepositions, and conjunctions (per SDTMIG Section 2.6, item 3h), which may remain lowercase.
#note "All variable labels are in title case"
dataset DM label=Demographics
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | DM | 01-701-1015
CDISCPILOT01 | DM | 01-701-1023
---
