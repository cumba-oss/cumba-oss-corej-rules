#!RuleTest
#test CDISC-CG0653 expect=violation domain=SV
# Rule:Description: Raise an error when Subject Visit Pre-specified (SVPRESP) is populated with a value that is not equal to 'Y'.
#note "SVSEQ=1 has SVPRESP=N, a non-empty value other than Y, so the rule fires"
#expectViolationCount 1
#expectViolationAt row=1 SVSEQ=1 USUBJID=01-701-1015
dataset SV label="Subject Visits"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SVSEQ type=Num label="Sequence Number"
col SVPRESP type=Char label="Pre-Specified"
---
CDISCPILOT01 | SV | 01-701-1015 | 1 | N
CDISCPILOT01 | SV | 01-701-1015 | 2 | Y
---
