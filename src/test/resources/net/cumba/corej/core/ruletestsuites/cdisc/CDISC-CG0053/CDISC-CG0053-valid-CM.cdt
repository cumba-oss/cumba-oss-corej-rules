#!RuleTest
#test CDISC-CG0053 expect=noViolation domain=CM
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0053 (Condition: --PRESP not present in dataset; Rule: --REASND not present in dataset). CMPRESP is present beside CMREASND (a pre-specified medication question), so the Condition does not hold -> silent."
#library standard=sdtmig version=3-4
dataset CM class=INTERVENTIONS label="Concomitant Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ   type=Num  label="Sequence Number"
col CMTRT   type=Char label="Reported Name of Drug, Med, or Therapy"
col CMPRESP type=Char label="CM Pre-specified"
col CMOCCUR type=Char label="CM Occurrence"
col CMREASND type=Char label="Reason Medication Not Collected"
---
CDISCPILOT01 | CM | 01-701-1015 | 1 | ASPIRIN | Y | Y |
CDISCPILOT01 | CM | 01-701-1023 | 1 | IBUPROFEN | Y | | NOT ASKED
