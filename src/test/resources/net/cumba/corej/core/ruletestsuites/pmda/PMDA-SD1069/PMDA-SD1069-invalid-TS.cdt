#!RuleTest
#test PMDA-SD1069 expect=violation domain=TS
#note "TSPARMCD=TITLE carries two different parameter names ('Trial Title' and 'Study Title'), so --PARM is not constant for a given --PARMCD. Both records of the conflicting pair are reported."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 TSPARMCD=TITLE TSPARM="Trial Title"
#expectViolationAt row=2 TSPARMCD=TITLE TSPARM="Study Title"
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S1 | TS | 1 | TITLE   | Trial Title      | A Study
S1 | TS | 2 | TITLE   | Study Title      | A Study
S1 | TS | 3 | TPHASE  | Trial Phase Classification | PHASE III
