#!RuleTest
#test FDA-SD1347 expect=noViolation domain=AE
#note "Row 1: FATAL AE with AEENDTC equal to DTHDTC -> ok. Row 2: FATAL AE with AEENDTC empty -> guard blocks. Row 3: non-fatal AE with AEENDTC different from DTHDTC -> condition not met. Row 4: FATAL AE for subject with empty DTHDTC -> guard DM.DTHDTC non_empty blocks."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEOUT   type=Char label="Outcome of Adverse Event"
col AEENDTC type=Char label="End Date/Time of Adverse Event"
---
S1 | AE | 001 | 1 | CARDIAC ARREST | FATAL              | 2020-05-10
S1 | AE | 001 | 2 | SEPSIS         | FATAL              |
S1 | AE | 001 | 3 | HEADACHE       | RECOVERED/RESOLVED | 2020-04-01
S1 | AE | 002 | 1 | CARDIAC ARREST | FATAL              | 2020-06-01
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DTHDTC  type=Char label="Date/Time of Death"
---
S1 | DM | 001 | 2020-05-10
S1 | DM | 002 |
---
