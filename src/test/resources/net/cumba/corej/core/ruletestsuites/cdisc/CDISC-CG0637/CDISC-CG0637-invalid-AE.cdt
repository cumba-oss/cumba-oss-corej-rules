#!RuleTest
#test CDISC-CG0637 expect=violation domain=AE
# Rule:Description: Raise an error when --RPDY is present.
#note "AERPDY column is present in the dataset"
#expectViolationCount 1
#expectViolationAt row=1
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AERPDY type=Char label="Day Within Period of Reference"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | 1
CDISCPILOT01 | AE | 01-701-1015 | 2 | 5
---
