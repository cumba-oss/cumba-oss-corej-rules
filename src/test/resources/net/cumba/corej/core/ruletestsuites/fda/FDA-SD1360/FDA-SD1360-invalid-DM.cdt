#!RuleTest
#test FDA-SD1360 expect=violation domain=DM
#note "Row 1 populates ARMNRS although both ARMCD and ACTARMCD are populated -> fires. Row 2 is the conformant fully-populated case."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001 ARMNRS="UNPLANNED TREATMENT"
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARMCD    type=Char label="Planned Arm Code"
col ACTARMCD type=Char label="Actual Arm Code"
col ARMNRS   type=Char label="Reason Arm and/or Actual Arm is Null"
---
S1 | DM | 001 | A | B | UNPLANNED TREATMENT
S1 | DM | 002 | A | A |
