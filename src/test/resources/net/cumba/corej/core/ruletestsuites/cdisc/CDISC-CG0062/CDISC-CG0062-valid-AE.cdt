#!RuleTest
#test CDISC-CG0062 expect=noViolation domain=AE
# Rule:Description: Raise an error when Start Relative to Reference Time Point (--STRTPT) is present in the dataset but Start Reference Time Point (--STTPT) is not present in the dataset.
#note "AESTRTPT present and its anchor AESTTPT also present"
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AESTRTPT type=Char label="Start Relative to Reference Time Point"
col AESTTPT type=Char label="Start Reference Time Point"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | BEFORE | 2014-01-01
CDISCPILOT01 | AE | 01-701-1015 | 2 | COINCIDENT | 2014-01-01
---
