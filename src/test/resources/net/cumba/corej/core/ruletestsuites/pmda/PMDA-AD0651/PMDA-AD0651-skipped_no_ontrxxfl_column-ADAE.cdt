#!RuleTest
#test PMDA-AD0651 expect=skipped domain=ADAE
#note "WILDCARD-NoMatch skip: ONTRTFL is the only ONTR* column and it does not match ^ONTR(\d{2})FL$, so the expander returns NoMatch. This is the boundary that proves the two names are kept apart by the two-digit requirement."
#library standard=adamig version=1-3
dataset ADAE class=OCCDS
col STUDYID  type=Char
col USUBJID  type=Char
col ASEQ     type=Num
col AEDECOD  type=Char
col ONTRTFL  type=Char
---
CDISCPILOT01 | 01-701-1015 | 1 | HEADACHE | Y
