#!RuleTest
#test CDISC-CG0153 expect=violation domain=DM
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0153 (Rule: ARMCD value length <= 20). Row 2's ARMCD 'XANOHI_81MG_PATCH_ARM' is 21 characters, one over the limit -> fires. Row 1's ARMCD 'PBO' (3 characters) is within the limit and stays silent."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1023 ARMCD=XANOHI_81MG_PATCH_ARM
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015 | PBO | Placebo
CDISCPILOT01 | DM | 01-701-1023 | 1023 | XANOHI_81MG_PATCH_ARM | Xanomeline High Dose
---
