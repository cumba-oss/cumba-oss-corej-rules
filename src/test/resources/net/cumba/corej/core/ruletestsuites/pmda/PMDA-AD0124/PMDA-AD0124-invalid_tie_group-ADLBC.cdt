#!RuleTest
#test PMDA-AD0124 expect=violation domain=ADLBC
#note "Pins the D.2 tie contract: group GLUC holds two distinct non-blank PARCAT1 values with one occurrence each, so there is no unique most-common value -> on a tie EVERY non-blank row of the group is flagged."
#library standard=adamig version=1-3
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=001 PARAMCD=GLUC PARCAT1=LABS
#expectViolationAt row=2 USUBJID=002 PARAMCD=GLUC PARCAT1=CHEMISTRY
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col PARCAT1 type=Char
---
S1 | 001 | GLUC | LABS
S1 | 002 | GLUC | CHEMISTRY
