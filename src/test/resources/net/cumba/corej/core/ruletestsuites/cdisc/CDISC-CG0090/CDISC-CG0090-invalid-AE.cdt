#!RuleTest
#test CDISC-CG0090 expect=violation domain=AE
# Rule:Description: Raise an error when --RFTDTC is present in the dataset but --TPTREF is not present in the dataset.
#note "AERFTDTC column is present but AETPTREF column is absent"
#expectViolationCount 1
#expectViolationAt row=1
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AERFTDTC type=Char label="Date/Time of Reference Time Point"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | 2014-01-03T08:00
CDISCPILOT01 | AE | 01-701-1015 | 2 | 2014-01-09T09:00
CDISCPILOT01 | AE | 01-701-1023 | 1 | 2012-08-07T10:00
