#!RuleTest
#test CDISC-CG0211 expect=violation domain=SE
# Rule:Description: Raise an error when SEUPDES ^= null, ETCD ^= 'UNPLAN'
#note "SESEQ=1 is a planned element (ETCD=PBO, not UNPLAN) yet SEUPDES is populated"
#expectViolationCount 1
#expectViolationAt row=1 SESEQ=1 USUBJID=01-701-1015
dataset SE label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ type=Num label="Sequence Number"
col ETCD type=Char label="Element Code" format=$ETCD.
col SEUPDES type=Char label="Description of Unplanned Element"
---
CDISCPILOT01 | SE | 01-701-1015 | 1 | PBO  | Extra dosing visit
CDISCPILOT01 | SE | 01-701-1015 | 2 | SCRN |
---
