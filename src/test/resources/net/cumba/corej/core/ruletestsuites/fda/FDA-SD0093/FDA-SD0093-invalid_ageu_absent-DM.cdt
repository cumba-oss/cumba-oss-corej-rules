#!RuleTest
#test FDA-SD0093 expect=violation domain=DM
#note "AGEU is not present in the dataset while AGE is populated on both rows -> the age units are not provided. Encodes the column-absent case: the Check carries a bare empty(AGEU) leaf, which under absent = all-missing (EC-43) is TRUE on every row of a column that is not there. Plan B phase 4d' deleted the redundant not var_exists(AGEU) disjunct that used to spell this out; the verdict is unchanged."
#library standard=sdtmig version=3-1-2
#expectViolationCount 2
#expectViolationAt row=1 AGE=56
#expectViolationAt row=2 AGE=63
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col AGE     type=Num  label="Age"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015 | 56
CDISCPILOT01 | DM | 01-701-1023 | 1023 | 63
