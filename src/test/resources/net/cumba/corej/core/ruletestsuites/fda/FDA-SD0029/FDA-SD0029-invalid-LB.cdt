#!RuleTest
#test FDA-SD0029 expect=violation domain=LB
#note "Row 1 reports a numeric standardised result (5.5) with empty standard units -> 'Standard Units (--STRESU) should not be NULL, when Character Result/Finding in Std Units (--STRESC) is provided as a numeric result'."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 LBSTRESC=5.5 LBSTRESU=
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBSTRESC type=Char label="Character Result/Finding in Std Format"
col LBSTRESU type=Char label="Standard Units"
col LBORRESU type=Char label="Original Units"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | GLUC | 5.5 | | mg/dL
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALB  | 40  | g/L | mg/dL
