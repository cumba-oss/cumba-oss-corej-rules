#!RuleTest
#test CDISC-CG0441 expect=violation domain=TS
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0441 (Domain TS, Variable TSVAL; Condition: TSPARMCD = 'STOPRULE'; Rule: TSVAL ^= null). Row 2 is the STOPRULE record with TSVAL empty -> fires. Row 1 (TITLE) is outside the Condition and row 3 (a second STOPRULE record) states its stopping rule: silent. TSVAL is populated elsewhere, so the finding is record-level, not the folded dataset message."
#library standard=sdtmig version=3-3
#expectViolationCount 1
#expectViolationAt row=2 TSSEQ=1 TSPARMCD=STOPRULE
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
col TSVALNF  type=Char label="Parameter Null Flavor"
---
CDISCPILOT01 | TS | 1 | TITLE | Trial Title | A Study of Xanomeline |
CDISCPILOT01 | TS | 1 | STOPRULE | Study Stop Rules | |
CDISCPILOT01 | TS | 2 | STOPRULE | Study Stop Rules | INTERIM ANALYSIS FOR FUTILITY |
---
