#!RuleTest
#test CDISC-CG0042 expect=skipped domain=AE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0042 (Rule: AESER = 'N'). AESER is withheld: Requirements.Variables.All [AESER] is unmet, so the rule must skip instead of reading an absent AESER as not 'N' on every record."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESHOSP type=Char label="Requires or Prolongs Hospitalization"
---
CDISCPILOT01 | AE | 01-701-1028 | 1 | HEADACHE | N
