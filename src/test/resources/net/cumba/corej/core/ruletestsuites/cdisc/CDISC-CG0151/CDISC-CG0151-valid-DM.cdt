#!RuleTest
#test CDISC-CG0151 expect=noViolation domain=DM
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0151 (Rule: USUBJID unique within a submission). Each DM record carries a distinct USUBJID -> silent."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SUBJID   type=Char label="Subject Identifier for the Study"
col SITEID   type=Char label="Study Site Identifier"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015 | 701
CDISCPILOT01 | DM | 01-701-1023 | 1023 | 701
CDISCPILOT01 | DM | 01-701-1028 | 1028 | 701
