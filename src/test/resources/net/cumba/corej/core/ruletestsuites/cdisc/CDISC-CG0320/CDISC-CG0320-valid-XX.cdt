#!RuleTest
#test CDISC-CG0320 expect=noViolation domain=XX
#note "XX is class=FINDINGS and a custom domain, and it carries its topic variable XXTESTCD -> no violation. W4b (PLAN-scalar-metadata-functions phase 0, scenarios-first on the pre-port engine)."
#library standard=sdtmig version=3-4
#library custom-domain XX
dataset XX class=FINDINGS label="Custom FINDINGS"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col XXSEQ   type=Num  label="Sequence Number"
col XXTESTCD type=Char label="Short Name of Measurement, Test or Examination"
---
S1 | XX | 001 | 1 | TEST1
