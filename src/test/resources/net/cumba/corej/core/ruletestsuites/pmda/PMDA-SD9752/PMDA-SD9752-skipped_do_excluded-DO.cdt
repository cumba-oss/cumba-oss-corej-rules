#!RuleTest
#test PMDA-SD9752 expect=skipped domain=DO
#note "Scope boundary: DO is excluded (the parent PMDA-SD1085 excludes DO); the body would fire (DODY populated, no DODTC)."
#library standard=sdtmig version=3-2
dataset DO class=FINDINGS label="Device Properties"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col DOSEQ    type=Num  label="Sequence Number"
col DOTESTCD type=Char label="Device Property Short Name"
col DODY type=Num label="Study Day of Collection"
---
S1 | DO | 001 | 1 | LEN | 5
S1 | DO | 002 | 2 | LEN | 6
S1 | DO | 003 | 3 | LEN | 
