#!RuleTest
#test CDISC-CG0034 expect=noViolation domain=LB
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0034 (Condition VISITNUM ^= null; Rule VISITNUM in SV.VISITNUM; Description: VISITNUM must match a VISITNUM value FOR THE SUBJECT in SV). Every populated LB VISITNUM is one of the SV VISITNUMs of the SAME subject, including subject 01-701-1015's unplanned visit 1.5 (VISITNUM declared Num on both sides). Row 4's VISITNUM is null, so the Condition excludes it."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB | 1   | SCREENING
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALB | 1.5 | UNSCHEDULED 1.5
CDISCPILOT01 | LB | 01-701-1023 | 1 | ALB | 2   | BASELINE
CDISCPILOT01 | LB | 01-701-1023 | 2 | ALB |     |
---

dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | SV | 01-701-1015 | 1   | SCREENING
CDISCPILOT01 | SV | 01-701-1015 | 1.5 | UNSCHEDULED 1.5
CDISCPILOT01 | SV | 01-701-1023 | 1   | SCREENING
CDISCPILOT01 | SV | 01-701-1023 | 2   | BASELINE
---
