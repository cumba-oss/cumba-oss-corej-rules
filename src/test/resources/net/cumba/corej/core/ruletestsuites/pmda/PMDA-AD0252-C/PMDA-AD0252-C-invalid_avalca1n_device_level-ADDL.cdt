#!RuleTest
#test PMDA-AD0252-C expect=violation domain=ADDL
#note "The -C mirror of PMDA-AD0252-B-invalid_device_level_dataset-ADDL (M2-P5, Fix #305), pinning that DEVICE LEVEL ANALYSIS DATASET is in scope. Since the D-15 rewrite (2026-09-12) AVALCA1N matches the first varname() regex and the per-variable evaluation emits exactly ONE finding for that one column, pinned by variable_name (no row= pin: Violation.row carries the colIndex)."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt variable_name=AVALCA1N
dataset ADDL structure="DEVICE LEVEL ANALYSIS DATASET"
col STUDYID  type=Char
col USUBJID  type=Char
col SPDEVID  type=Char
col AVALCA1N type=Num
---
CDISCPILOT01 | 01-701-1015 | DEV01 | 1
CDISCPILOT01 | 01-701-1023 | DEV02 | 2
