#!RuleTest
#test CDISC-CG0465 expect=violation domain=CO
# Rule:Description: Raise an error when Identifying Variable (IDVAR) is empty and Identifying Variable Value (IDVARVAL) is populated.
#note "IDVAR is empty while IDVARVAL is non-empty"
#expectViolationCount 1
#expectViolationAt row=1 COSEQ=1 USUBJID=01-701-1015
dataset CO label="Comments"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col COSEQ type=Num label="Sequence Number"
col IDVAR type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
---
CDISCPILOT01 | CO | 01-701-1015 | 1 | | 1
---
