#!RuleTest
#test PMDA-SD0032 expect=violation domain=LB
#note "No LBTPT column at all; the bare empty(--TPT) leaf decides, TRUE on every row of the absent column (absent = all-missing, EC-43). Row 1: LBTPTNUM=1 -> fires. Row 2: LBTPTNUM missing -> clean."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 LBTPTNUM=1
dataset LB class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
col LBTPTNUM type=Num
---
S1 | LB | 001 | 1 | GLUC | 1
S1 | LB | 001 | 2 | GLUC | .
