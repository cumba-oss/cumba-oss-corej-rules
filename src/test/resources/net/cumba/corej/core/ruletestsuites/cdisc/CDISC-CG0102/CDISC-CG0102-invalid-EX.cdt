#!RuleTest
#test CDISC-CG0102 expect=violation domain=EX
#note "Row 2 is a placebo administration recorded with a non-zero dose -> fires."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 EXTRT=PLACEBO EXDOSE=54
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXDOSE  type=Num  label="Dose per Administration"
---
CDISCPILOT01 | EX | 01-701-1015 | 1 | PLACEBO | 0
CDISCPILOT01 | EX | 01-701-1023 | 1 | PLACEBO | 54
