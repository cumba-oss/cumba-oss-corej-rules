#!RuleTest
#test FDA-SD1083 expect=noViolation domain=AE
# Rule:Description: Raise an error when --DTC is present in the dataset but --DY is not present.
#note "AEDTC present and the companion AEDY column is also present"
#library standard=sdtmig version=3-4
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AEDTC type=Char label="Date/Time of Collection"
col AEDY type=Num label="Study Day of Collection"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | 2014-01-16 | 15
CDISCPILOT01 | AE | 01-701-1015 | 2 | 2014-01-16 | 15
---
