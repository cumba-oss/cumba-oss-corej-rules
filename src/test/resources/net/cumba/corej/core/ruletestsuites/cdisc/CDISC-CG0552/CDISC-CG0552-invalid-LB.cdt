#!RuleTest
#test CDISC-CG0552 expect=violation domain=LB
# Rule:Description: Raise an error when --RESLOC is present in the dataset.
#note "--RESLOC column present in the dataset -> violation"
#expectViolationCount 1
#expectViolationAt row=1
dataset LB label="Laboratory Tests Results"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col LBSEQ type=Num label="Sequence Number"
col LBRESLOC type=Char label="Location Used for the Measurement"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ARM
CDISCPILOT01 | LB | 01-701-1015 | 2 |
---
