#!RuleTest
#test FDA-SD1255 expect=skipped domain=DM
#note "⚠ RE-CUT 2026-09-08 (R-4.12 hoist): expect moved noViolation -> skipped. `var_exists(AE.AESDTH)` was a top-level conjunct, so an absent AE made the whole AND false and the rule reported a SILENT ZERO -- which is what this scenario used to pin. It is now Requirements.Variables.All ["AE.AESDTH"], so the rule is gated out and reports SKIPPED naming the variable. Same violations either way; only the status channel moves, which is R-4.11's whole argument. If this EXECUTES again the entry was dropped -- escalate, do not rewrite the pin. PRIOR NOTE: AE dataset has no AESDTH column (Permissible variable absent): the 'AE.AESDTH exists' guard in the Check keeps the rule from firing even though DTHFL=N."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DTHFL   type=Char label="Subject Death Flag"
---
S1 | DM | 001 | N
---

dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
---
S1 | AE | 001 | 1 | CARDIAC ARREST
---
