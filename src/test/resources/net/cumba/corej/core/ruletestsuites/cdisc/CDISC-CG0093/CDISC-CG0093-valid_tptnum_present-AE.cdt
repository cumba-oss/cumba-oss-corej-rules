#!RuleTest
#test CDISC-CG0093 expect=noViolation domain=AE
# Rule:Description: Raise an error when --ELTM, --TPTNUM, --TPT, --STINT, and --ENINT are not present in the dataset but --TPTREF is present.
#note "AETPTNUM present alongside AETPTREF -> 'not var_exists(--TPTNUM)' is false, rule silent"
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AETPTNUM type=Num label="Planned Time Point Number"
col AETPTREF type=Char label="Time Point Reference"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | 1 | DOSING
CDISCPILOT01 | AE | 01-701-1015 | 2 | 2 | DOSING
---
