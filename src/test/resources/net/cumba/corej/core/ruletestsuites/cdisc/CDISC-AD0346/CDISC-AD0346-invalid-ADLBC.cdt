#!RuleTest
#test CDISC-AD0346 expect=violation domain=ADLBC
# Rule:Description: R2AyLO is present and AyLO is not present
#note "R2A1LO present, A1LO absent -> violation"
#expectViolationCount 1
#expectViolationAt nameOnly=R2A1LO
# Declared-tier scope: the class= declaration disagrees with the columns, so #define must
# carry it to RuleRunner (ScenarioDeclaredScopeProvider.install).
#define standard=adamig version=1-3
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col R2A1LO type=Char
---
CDISCPILOT01 | 01-701-1015 | X
---
