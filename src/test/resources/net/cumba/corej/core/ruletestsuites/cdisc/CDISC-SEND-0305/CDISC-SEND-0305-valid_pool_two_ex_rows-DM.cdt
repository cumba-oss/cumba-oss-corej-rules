#!RuleTest
#test CDISC-SEND-0305 expect=noViolation domain=DM
#note "PLAN-scalar-date-extremes (T2 review B-M2): Pool-only subject; pool P1 has TWO EX rows, EXSTDTC 2020-01-01 and 2020-01-05; RFXSTDTC 2020-01-01. The per-pool extreme is the EARLIER row (the inner min_date of $pool_min_exstdtc) -> RFXSTDTC equals it -> silent. Pins the inner call's direction: the sabotage inner min_date -> max_date (pool part 2020-01-05) reports this row."
#library standard=sendig version=3-1-1
dataset DM label=Demographics
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFXSTDTC type=Char label="Date/Time of First Study Treatment"
---
S1 | DM | 001 | 2020-01-01
---
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col POOLID  type=Char label="Pool Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
---
S1 | EX |  | P1 | 1 | DRUG A | 2020-01-01
S1 | EX |  | P1 | 2 | DRUG A | 2020-01-05
---
dataset POOLDEF label="Pool Definition"
col STUDYID type=Char label="Study Identifier"
col POOLID  type=Char label="Pool Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
---
S1 | P1 | 001
---
