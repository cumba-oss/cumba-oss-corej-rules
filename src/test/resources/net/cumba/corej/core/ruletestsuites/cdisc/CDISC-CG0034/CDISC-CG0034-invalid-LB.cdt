#!RuleTest
#test CDISC-CG0034 expect=violation domain=LB
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0034 (Condition VISITNUM ^= null; Rule VISITNUM in SV.VISITNUM; Description: VISITNUM must match a VISITNUM value FOR THE SUBJECT in SV). Row 2's VISITNUM=3 is not an SV VISITNUM of subject 01-701-1015 (SV holds 1 and 2 for that subject, and no subject has 3) -> fires. Row 1's VISITNUM=1 is in the subject's SV set and must not fire. ALSO THE S3 DISCRIMINATOR (SKELETON-distinct-function hazard 3): the target column VISITNUM belongs to the FOREIGN dataset SV; a port that read VISITNUM from the primary LB, grouped by LB.USUBJID, would put row 2's own 3 into 01-701-1015's set and fall silent."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1015 VISITNUM=3
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB | 1 | SCREENING
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALB | 3 | WEEK 2
---

dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | SV | 01-701-1015 | 1 | SCREENING
CDISCPILOT01 | SV | 01-701-1015 | 2 | BASELINE
CDISCPILOT01 | SV | 01-701-1023 | 1 | SCREENING
CDISCPILOT01 | SV | 01-701-1023 | 2 | BASELINE
---
