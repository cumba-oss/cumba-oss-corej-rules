#!RuleTest
#test FDA-SD0075 expect=violation domain=RELREC
#note "Row 2 references RDOMAIN=CM with IDVAR=AESEQ; CM has no AESEQ column, so the row must fire. Row 1 legitimately uses AESEQ against RDOMAIN=AE. This pins that the whitelist has to be evaluated per RDOMAIN, not as one study-wide set of valid names."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 RDOMAIN=CM IDVAR=AESEQ
dataset RELREC class=RELATIONSHIP label="Related Records"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col RELTYPE  type=Char label="Relationship Type"
col RELID    type=Char label="Relationship Identifier"
---
S1 | AE | 001 | AESEQ | 1 | ONE  | 1
S1 | CM | 001 | AESEQ | 1 | MANY | 1
---

dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE
---

dataset CM class=INTERVENTIONS label="Concomitant Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ   type=Num  label="Sequence Number"
col CMTRT   type=Char label="Reported Name of Drug, Med, or Therapy"
---
S1 | CM | 001 | 1 | ASPIRIN
