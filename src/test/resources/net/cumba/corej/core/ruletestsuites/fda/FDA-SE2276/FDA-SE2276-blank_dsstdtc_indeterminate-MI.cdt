#!RuleTest
#test FDA-SE2276 expect=violation domain=MI
#note "$max_ds_dsstdtc declares missing_values: indeterminate. DSSTDTC is Required in every SENDIG package this rule ships to, so a blank one is itself a violation and the subject's LATEST disposition cannot be established: the extreme yields no value and date_not_equal_to reports on the populated MIDTC. Under the default `skip` the blank row would simply not be a candidate, the extreme would come out as 2020-01-20, MIDTC would match it and the rule would stay silent -- so this scenario is red exactly when the declaration is absent."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset MI label="Microscopic Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col MISEQ    type=Num  label="Sequence Number"
col MITESTCD type=Char label="Microscopic Examination Short Name"
col MISPEC   type=Char label="Specimen Material Type"
col MIORRES  type=Char label="Result or Finding in Original Units"
col MIDTC    type=Char label="Date/Time of Collection"
---
S1 | MI | 001 | 1 | MIEXAM | LIVER | NECROSIS | 2020-01-20
---

dataset DS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSTERM  type=Char label="Reported Term for the Disposition Event"
col DSDECOD type=Char label="Standardized Disposition Term"
col DSSTDTC type=Char label="Start Date/Time of Disposition Event"
---
S1 | DS | 001 | 1 | TERMINAL SACRIFICE | TERMINAL SACRIFICE | 2020-01-20
S1 | DS | 001 | 2 | MOVED TO RECOVERY | RECOVERY |
---
