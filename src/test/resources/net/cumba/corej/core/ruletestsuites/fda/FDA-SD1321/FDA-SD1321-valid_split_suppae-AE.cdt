#!RuleTest
#test FDA-SD1321 expect=noViolation domain=AE
#note "PLAN-split-supp-resolution (Q1-Q3): the study submits its AE supplemental qualifiers as SUPPAE1 + SUPPAE2 (both RDOMAIN=AE), no SUPPAE. record_count(domain=\"SUPPAE\") reads the FAMILY -- every member keyed by RDOMAIN -- so a subject flagged ONLY in SUPPAE2 (002) is flagged. Every subject has its AETRTEM flag in one member or the other -> no violation. Red on the pre-plan engine: the family name resolved to nothing, every subject counted 0 and fired."
#library standard=sdtmig version=3-4
#expectViolationCount 0
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEDECOD type=Char label="Dictionary-Derived Term"
---
S1 | AE | 001 | 1 | Headache | HEADACHE
S1 | AE | 002 | 1 | Nausea   | NAUSEA
---

dataset SUPPAE1 label="Supplemental Qualifiers for AE (part 1)"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM     type=Char label="Qualifier Variable Name"
col QLABEL   type=Char label="Qualifier Variable Label"
col QVAL     type=Char label="Data Value"
---
S1 | AE | 001 | AESEQ | 1 | AETRTEM | Treatment Emergent Flag | Y
---

dataset SUPPAE2 label="Supplemental Qualifiers for AE (part 2)"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM     type=Char label="Qualifier Variable Name"
col QLABEL   type=Char label="Qualifier Variable Label"
col QVAL     type=Char label="Data Value"
---
S1 | AE | 002 | AESEQ | 1 | AETRTEM | Treatment Emergent Flag | N
---
