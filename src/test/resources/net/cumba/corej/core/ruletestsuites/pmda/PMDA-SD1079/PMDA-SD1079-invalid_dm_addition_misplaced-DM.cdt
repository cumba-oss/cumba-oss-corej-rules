#!RuleTest
#test PMDA-SD1079 expect=violation domain=DM
#note "VISITNUM (Timing) follows DMDY; the timing table puts VISITNUM before DMDTC -> the permitted order is violated."
#library standard=sdtmig version=3-3
#library dataset-class DM Special-Purpose
#library model-column-order DM STUDYID DOMAIN USUBJID SUBJID RFSTDTC RFENDTC RFXSTDTC RFXENDTC RFICDTC RFPENDTC DTHDTC DTHFL SITEID INVID INVNAM BRTHDTC AGE AGETXT AGEU SEX RACE ETHNIC SPECIES STRAIN SBSTRAIN ARMCD ARM ACTARMCD ACTARM ARMNRS ACTARMUD SETCD RPATHCD COUNTRY DMDTC DMDY
