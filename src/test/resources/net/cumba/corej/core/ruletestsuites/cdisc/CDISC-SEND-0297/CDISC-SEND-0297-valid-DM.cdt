#!RuleTest
#test CDISC-SEND-0297 expect=noViolation domain=DM
#note "Every DM variable is defined for the domain in the SENDIG -> no violation. W4 (PLAN-list-functions phase 0, scenarios-first on the pre-port engine)."
#library standard=sendig version=3-1
#library column-order DM STUDYID DOMAIN USUBJID SUBJID SEX
dataset DM
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SEX     type=Char label="Sex"
---
S1 | DM | 001 | M
