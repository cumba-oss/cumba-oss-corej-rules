#!RuleTest
#test CDISC-AD0622 expect=violation domain=ADAE
# Rule:Description: Raise an error when AEOCCUR is present in an ADVERSE EVENT sub-class OCCDS dataset (e.g., ADAE), since AEOCCUR is disallowed for the AE sub-class per OCCDS v1.1.
#expectViolationCount 1
#expectViolationAt nameOnly=AEOCCUR
dataset ADAE
col AEOCCUR type=Char
col AETERM type=Char
---
- | HEADACHE
---
