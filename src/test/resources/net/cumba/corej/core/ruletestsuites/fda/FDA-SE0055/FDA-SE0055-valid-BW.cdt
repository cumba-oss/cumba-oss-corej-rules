#!RuleTest
#test FDA-SE0055 expect=noViolation domain=BW
#note "Every variable the SEND IG describes carries the same data type in the dataset (BWSTRESN numeric, BWTESTCD/BWSTRESC character). STUDYID/USUBJID have no IG entry here, so the library_variable_data_type non_empty gate excludes them."
#library standard=sendig version=3-1-1
#library variable-metadata BW BWTESTCD name=BWTESTCD simpleDatatype=Char label="Test Short Name"
#library variable-metadata BW BWSTRESC name=BWSTRESC simpleDatatype=Char label="Standardized Result in Character Format"
#library variable-metadata BW BWSTRESN name=BWSTRESN simpleDatatype=Num  label="Standardized Result in Numeric Format"
dataset BW label="Body Weight"
col STUDYID  type=Char label="Study Identifier"
col USUBJID  type=Char label="Unique Subject Identifier"
col BWTESTCD type=Char label="Test Short Name"
col BWSTRESC type=Char label="Standardized Result in Character Format"
col BWSTRESN type=Num  label="Standardized Result in Numeric Format"
---
S1 | 001 | BW | 250 | 250
