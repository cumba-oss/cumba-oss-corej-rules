#!RuleTest
#test CDISC-SEND-0061 expect=violation domain=PC
#note "R-5.25 split of SEND61 (top-level-or board wave 2, group J), the parent (--EVLINT half): row 1's PCEVLINT is a week (W) component mixed with another date/time component -> fires, named against this one variable instead of the three-name disjunction. The other rows are conformant."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 PCSEQ=1
dataset PC class=FINDINGS label="Pharmacokinetics Concentrations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PCSEQ    type=Num  label="Sequence Number"
col PCTESTCD type=Char label="Test Short Name"
col PCEVLINT type=Char label="Evaluation Interval"
---
S1 | PC | 001 | 1 | DRUGX | P1W2D
S1 | PC | 001 | 2 | DRUGX | P2W
S1 | PC | 001 | 3 | DRUGX | P10D
