#!RuleTest
#test PMDA-AD0018 expect=noViolation domain=ADSL
#note "PMDA AD0018: an all-lowercase ADSL whose labels equal the ADaM labels. studyid and usubjid resolve to the Library's STUDYID and USUBJID and are judged; both labels conform -> silent. The negative twin of -invalid_lowercase_name."
#library standard=adamig version=1-3
#library variable-metadata ADSL STUDYID name=STUDYID label="Study Identifier"
#library variable-metadata ADSL USUBJID name=USUBJID label="Unique Subject Identifier"
#expectViolationCount 0
dataset ADSL structure=ADSL
col studyid type=Char label="Study Identifier"
col usubjid type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | 01-701-1015
---
