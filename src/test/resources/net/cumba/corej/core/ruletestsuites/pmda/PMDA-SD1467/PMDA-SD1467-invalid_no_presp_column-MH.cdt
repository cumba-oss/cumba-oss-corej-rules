#!RuleTest
#test PMDA-SD1467 expect=violation domain=MH
#note "MECHANISM PIN - or-branch independence under a dropped column, on the EVENTS class arm. NO MHPRESP column at all. Row 1: branch 1 is dead (var_exists(--PRESP) false) but branch 2 fires on its own (MHOCCUR=Y, MHSTAT='NOT DONE'). Row 2: MHSTAT blank -> silent."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001 MHOCCUR=Y
dataset MH class=EVENTS
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col MHSEQ   type=Num
col MHTERM  type=Char
col MHOCCUR type=Char
col MHSTAT  type=Char
---
S1 | MH | 001 | 1 | ASTHMA | Y | NOT DONE
S1 | MH | 002 | 1 | ASTHMA | Y |
