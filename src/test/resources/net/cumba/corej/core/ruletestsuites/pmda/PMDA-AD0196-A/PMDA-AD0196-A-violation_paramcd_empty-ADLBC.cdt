#expectViolationAt row=3 USUBJID=01-701-1034 PARAM=Alanine
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col PARAM   type=Char
col AVAL    type=Num
