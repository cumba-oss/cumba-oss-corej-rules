#!RuleTest
#test FDA-SE1151 expect=noViolation domain=EX
#note "H2 guard scenario (WORKORDER-H2-guard-coverage / REVIEW1B-date-order-flip.tsv): TS is present but carries NO EXPENDTC parameter row, so ts_parameter_value yields EmptyResult.MISSING and the not empty($exp_end) guard silences the rule despite a populated EXENDTC. If this FIRES, the order-flip guard was deleted: post-6c totality makes date(EXENDTC) > date(MISSING) true on every dated EX row."
#library standard=sendig version=3-1-1
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXENDTC type=Char label="Date/Time of Treatment"
---
S1 | EX | 001 | 1 | DRUG A | 2020-07-01
---

dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Trial Summary Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL    type=Char label="Parameter Value"
---
S1 | TS | 1 | SSPONSOR | ACME LABS
