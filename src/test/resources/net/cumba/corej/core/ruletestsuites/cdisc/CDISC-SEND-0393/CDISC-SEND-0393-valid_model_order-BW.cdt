#!RuleTest
#test CDISC-SEND-0393 expect=noViolation domain=BW
#note "Identical to -invalid_model_order-BW except that BWTESTCD is declared before BWTEST, so the order is an ordered subset of the Model order and the rule is silent. Same model-column-order line."
#library standard=sendig-dart version=1-2
#library model-column-order BW STUDYID DOMAIN USUBJID BWSEQ BWGRPID BWTESTCD BWTEST BWORRES BWORRESU BWSTRESC
#expectViolationCount 0
dataset BW class=FINDINGS label="Body Weight"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col BWSEQ    type=Num  label="Sequence Number"
col BWTESTCD type=Char label="Body Weight Test Short Name"
col BWTEST   type=Char label="Body Weight Test Name"
col BWORRES  type=Char label="Result or Finding in Original Units"
---
S1 | BW | 001 | 1 | BW | Body Weight | 250
S1 | BW | 002 | 1 | BW | Body Weight | 262
---
