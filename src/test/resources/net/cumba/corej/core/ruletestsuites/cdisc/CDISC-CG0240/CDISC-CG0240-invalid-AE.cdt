#!RuleTest
#test CDISC-CG0240 expect=violation domain=AE
# Rule:Description: Raise an error when Planned Time Point Name (--TPT) is not consistent for a given Planned Time Point Number (--TPTNUM), i.e. when VISITNUM and --TPTREF are not present and --TPT and --TPTNUM do not have a one-to-one relationship.
#note "VISITNUM and AETPTREF absent; AETPT 'BEFORE' maps to two AETPTNUM values"
#expectViolationCount 2
#expectViolationAt row=1 AESEQ=1 USUBJID=01-701-1015
#expectViolationAt row=2 AESEQ=2 USUBJID=01-701-1015
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AETPT type=Char label="Planned Time Point Name"
col AETPTNUM type=Char label="Planned Time Point Number"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | BEFORE | 1
CDISCPILOT01 | AE | 01-701-1015 | 2 | BEFORE | 2
CDISCPILOT01 | AE | 01-701-1023 | 1 | AFTER | 3
---
