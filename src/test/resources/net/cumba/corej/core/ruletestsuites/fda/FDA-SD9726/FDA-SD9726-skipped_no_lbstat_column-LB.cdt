#!RuleTest
#test FDA-SD9726 expect=skipped domain=LB
#note "Neither LBSTAT nor LBREASND is in the dataset: Requirements.Variables.All [--STAT] is unsatisfied, so the sister skips naming LBSTAT. Without the trigger column the sister cannot tell whether any test was NOT DONE; --STAT is Permissible in LB, and a dataset with no completion-status column simply has nothing for this family to check."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBORRES  type=Char label="Result or Finding in Original Units"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB | 4.1
