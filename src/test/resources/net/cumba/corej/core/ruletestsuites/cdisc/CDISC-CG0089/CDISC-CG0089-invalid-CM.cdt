#!RuleTest
#test CDISC-CG0089 expect=violation domain=CM
#note "CG0089: Condition --OCCUR ^= null, Rule --PRESP = 'Y'. Row 1: OCCUR populated, PRESP empty -> fires. Row 2: OCCUR populated, PRESP 'N' -> fires. Row 3: pre-specified -> clean. Row 4: OCCUR empty -> clean."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 CMSEQ=1
#expectViolationAt row=2 CMSEQ=2
dataset CM class=INTERVENTIONS label="Concomitant Medications"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col CMSEQ    type=Num
col CMTRT    type=Char
col CMPRESP  type=Char
col CMOCCUR  type=Char
---
S1 | CM | 001 | 1 | ASPIRIN   |   | Y
S1 | CM | 001 | 2 | IBUPROFEN | N | Y
S1 | CM | 001 | 3 | NAPROXEN  | Y | N
S1 | CM | 001 | 4 | CODEINE   |   |
