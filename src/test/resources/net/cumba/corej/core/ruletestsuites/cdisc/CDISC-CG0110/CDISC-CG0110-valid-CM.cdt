#!RuleTest
#test CDISC-CG0110 expect=noViolation domain=CM
# Rule:Description: Raise an error when --DOSE is populated and --DOSTXT is populated.
#note "CMDOSE and CMDOSTXT are mutually exclusive per record -> never both populated, no violation"
dataset CM label="Concomitant Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ type=Num label="Sequence Number"
col CMDOSE type=Num label="Dose per Administration"
col CMDOSTXT type=Char label="Dose Description"
---
CDISCPILOT01 | CM | 01-701-1015 | 1 | 10 |
CDISCPILOT01 | CM | 01-701-1015 | 2 |    | 10-20
---
