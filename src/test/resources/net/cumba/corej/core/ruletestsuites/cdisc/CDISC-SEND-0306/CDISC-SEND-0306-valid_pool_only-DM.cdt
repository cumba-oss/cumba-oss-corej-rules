#!RuleTest
#test CDISC-SEND-0306 expect=noViolation domain=DM
#note "PLAN-scalar-date-extremes: Pool-only subject; pool P1 EXENDTC 2020-01-10; RFXENDTC 2020-01-10. RFXENDTC is judged against latest_date(own latest EXENDTC, the latest EXENDTC of every pool POOLDEF assigns the subject to), else the latest EXSTDTC likewise (SENDIG 3.1.1 5.1.1 p.45). Silent. Pin (silent before too, through the USUBJID in $ex_subjects guard)."
#library standard=sendig version=3-1-1
dataset DM label=Demographics
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFXENDTC type=Char label="Date/Time of Last Study Treatment"
---
S1 | DM | 001 | 2020-01-10
---
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col POOLID  type=Char label="Pool Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
col EXENDTC type=Char label="End Date/Time of Treatment"
---
S1 | EX |  | P1 | 1 | DRUG A | 2020-01-01 | 2020-01-10
---
dataset POOLDEF label="Pool Definition"
col STUDYID type=Char label="Study Identifier"
col POOLID  type=Char label="Pool Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
---
S1 | P1 | 001
---
