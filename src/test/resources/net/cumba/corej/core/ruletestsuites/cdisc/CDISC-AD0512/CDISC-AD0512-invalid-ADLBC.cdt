#note "ASDY label "Start Day" lacks "Relative Start Day" -> violation"
#expectViolationCount 1
#expectViolationAt variable_label="Start Day" variable_name=ASDY
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ASDY type=Char label="Start Day"
