#!RuleTest
#test CDISC-SEND-0365 expect=skipped domain=PY
#note "NO #library line at all: codelist_terms needs the CDISC Library -> the rule SKIPs. The body is the invalid one. W4 (PLAN-list-functions phase 0, scenarios-first on the pre-port engine)."
dataset PY
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PYSEQ    type=Num  label="Sequence Number"
col PYTESTCD type=Char label="Pregnancy Findings Test Short Name"
col PYSTRESC type=Char label="Character Result/Finding in Std Format"
col PYRESCAT type=Char label="Result Category"
---
S1 | PY | 001 | 1 | PREGSTAT | MAYBE | NORMAL
