#!RuleTest
#test FDA-SD0012 expect=skipped domain=DM
#note "R-6 (ruled 2026-08-19): FDA-SD0012 carries the sheet-backed Domains Exclude [CO, DM]. A sponsor-invented DMSTDY/DMENDY pair no longer fires - both sheets scope the rule to SE/SM/SV + Interventions/Events. Out-of-scope primary = skipped."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DMSTDY  type=Num  label="Study Day of Start (nonstandard)"
col DMENDY  type=Num  label="Study Day of End (nonstandard)"
---
S1 | DM | 001 | 8 | 3
