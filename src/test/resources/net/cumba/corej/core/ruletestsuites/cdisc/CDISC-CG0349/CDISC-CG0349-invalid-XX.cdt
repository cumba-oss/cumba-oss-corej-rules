#!RuleTest
#test CDISC-CG0349 expect=violation domain=XX
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0349 (Condition: custom domain and variable name is not one of the non-prefixed standard variables; Rule: first 2 characters of the variable name = the 2-character domain code). Per-variable rule: pinned by variable_name=, never row=. XX is a custom Findings domain (#library custom-domain XX). LBORRESU is prefixed LB, not the domain code XX, and is not an exempt variable -> exactly one violation, on variable LBORRESU. The XX-prefixed and exempt variables (STUDYID, DOMAIN, USUBJID, VISITNUM, EPOCH) do not fire."
#library standard=sdtmig version=3-4
#library custom-domain XX
#expectViolationCount 1
#expectViolationAt variable_name=LBORRESU
dataset XX class=FINDINGS label="Custom Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col XXSEQ    type=Num  label="Sequence Number"
col XXTESTCD type=Char label="Test Short Name"
col XXTEST   type=Char label="Test Name"
col XXORRES  type=Char label="Result or Finding in Original Units"
col LBORRESU type=Char label="Original Units"
col VISITNUM type=Num  label="Visit Number"
col EPOCH    type=Char label="Epoch"
---
S1 | XX | 001 | 1 | TEST1 | Test One | 5 | mg/dL | 1 | SCREENING
---
