#!RuleTest
#test CDISC-AD0505 expect=noViolation domain=ADLBC
#library standard=adamig version=1-3
#library variable-metadata ADLBC *DTM name=*DTM label="{Datetime}"
# Rule:Description: A variable ending in DTM must contain "Datetime" in the label
#note "XDTM label contains "Datetime" -> noViolation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col XDTM type=Char label="Analysis Datetime"
---
CDISCPILOT01 | 01-701-1015 | ALB | x
---
