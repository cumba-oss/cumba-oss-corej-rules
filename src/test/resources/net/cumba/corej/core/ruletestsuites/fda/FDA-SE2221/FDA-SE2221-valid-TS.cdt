#!RuleTest
#test FDA-SE2221 expect=noViolation domain=TS
#note "TS carries a TSPARMCD=TRT record ('Investigational Therapy or Treatment'), so the required Trial Summary parameter is present -> no violation."
#library standard=sendig version=3-1-1
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | TRTV | Treatment Vehicle | SALINE
S01 | TS | 2 | TRT | Investigational Therapy or Treatment | COMPOUND X
S01 | TS | 3 | TRTCAS | Primary Treatment CAS Registry Number | 50-00-0
S01 | TS | 4 | TRMSAC | Time to Terminal Sacrifice | P28D
