#!RuleTest
#test CDISC-CG0063 expect=skipped domain=DS
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0063 (Condition: multiple events per subject where DSCAT = 'DISPOSITION EVENT'; Rule: EPOCH ^= null). DSCAT is withheld: Requirements.Variables.All [DSCAT] is unmet, so disposition events cannot be identified and the rule must skip."
#library standard=sdtmig version=3-2
dataset DS class=EVENTS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSTERM  type=Char label="Reported Term for the Disposition Event"
col DSDECOD type=Char label="Standardized Disposition Term"
col EPOCH   type=Char label="Epoch"
---
CDISCPILOT01 | DS | 01-701-1015 | 2 | COMPLETED | COMPLETED | TREATMENT
CDISCPILOT01 | DS | 01-701-1015 | 3 | COMPLETED | COMPLETED |
