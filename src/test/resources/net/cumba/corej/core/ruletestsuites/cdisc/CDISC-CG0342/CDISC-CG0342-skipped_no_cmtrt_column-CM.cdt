#!RuleTest
#test CDISC-CG0342 expect=skipped domain=CM
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0342 (Rule: --TRT ^= 'OTHER'). The CM dataset carries no CMTRT column; Requirements.Variables.All [--TRT] is unmet, so the rule must skip rather than evaluate an absent column."
#library standard=sdtmig version=3-4
dataset CM class=INTERVENTIONS label="Concomitant/Prior Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ   type=Num  label="Sequence Number"
col CMDECOD type=Char label="Standardized Medication Name"
---
CDISCPILOT01 | CM | 01-701-1015 | 1 | ACETYLSALICYLIC ACID
---
