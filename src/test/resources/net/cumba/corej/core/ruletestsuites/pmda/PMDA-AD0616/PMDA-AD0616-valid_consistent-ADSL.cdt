#!RuleTest
#test PMDA-AD0616 expect=noViolation domain=ADSL
#note "Each TRCMPG1N value maps to a single TRCMPG1 value."
#library standard=adamig version=1-3
dataset ADSL
col STUDYID   type=Char
col USUBJID   type=Char
col TRCMPG1   type=Char
col TRCMPG1N  type=Num
---
S1 | 001 | HIGH | 1
S1 | 002 | HIGH | 1
S1 | 003 | LOW  | 2
---
