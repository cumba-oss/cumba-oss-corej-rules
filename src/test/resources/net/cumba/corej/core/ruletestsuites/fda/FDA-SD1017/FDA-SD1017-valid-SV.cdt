#!RuleTest
#test FDA-SD1017 expect=noViolation domain=SV
#note "Every planned visit (SVUPDES empty) has a VISITNUM declared in TV; row 3 is an unplanned visit whose VISITNUM 99 is absent from TV but exempt because SVUPDES is populated."
#library standard=sdtmig version=3-4
dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col SVSTDTC  type=Char label="Start Date/Time of Visit"
col SVUPDES  type=Char label="Description of Unplanned Visit"
---
CDISCPILOT01 | SV | 001 | 1 | SCREENING | 2020-01-01 |
CDISCPILOT01 | SV | 001 | 2 | BASELINE | 2020-01-08 |
CDISCPILOT01 | SV | 002 | 99 | UNSCHEDULED | 2020-02-01 | Unplanned safety follow-up
---

dataset TV label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | TV | 1 | SCREENING
CDISCPILOT01 | TV | 2 | BASELINE
---
