#!RuleTest
#test CDISC-SEND-0276 expect=violation domain=BW
#note "(library variable-metadata: the SENDIG 3.1.1 BW labels as our metadata store holds them) SEND276: a variable the SENDIG defines must carry the SENDIG label. BWTESTCD is labelled 'Body Weight Test Code' (SENDIG: 'Test Short Name') -> one finding for the variable, not one per record (three rows). Every other label is the SENDIG's own, including BWDTC 'Date/Time Animal Weighed'."
#library standard=sendig version=3-1-1
#library variable-metadata BW STUDYID  name=STUDYID  label="Study Identifier"
#library variable-metadata BW DOMAIN   name=DOMAIN   label="Domain Abbreviation"
#library variable-metadata BW USUBJID  name=USUBJID  label="Unique Subject Identifier"
#library variable-metadata BW BWSEQ    name=BWSEQ    label="Sequence Number"
#library variable-metadata BW BWTESTCD name=BWTESTCD label="Test Short Name"
#library variable-metadata BW BWORRES  name=BWORRES  label="Result or Findings as Collected"
#library variable-metadata BW BWDTC    name=BWDTC    label="Date/Time Animal Weighed"
#expectViolationCount 1
#expectViolationAt variable_name=BWTESTCD
dataset BW class=FINDINGS label="Body Weights"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col BWSEQ    type=Num  label="Sequence Number"
col BWTESTCD type=Char label="Body Weight Test Code"
col BWORRES  type=Char label="Result or Findings as Collected"
col BWDTC    type=Char label="Date/Time Animal Weighed"
---
S1 | BW | S1-001 | 1 | BW | 250 | 2020-01-01
S1 | BW | S1-002 | 2 | BW | 260 | 2020-01-01
S1 | BW | S1-003 | 3 | BW | 255 | 2020-01-01
