#!RuleTest
#test PMDA-SD0033 expect=noViolation domain=LB
#note "Row 1: LBTPT populated with LBTPTNUM populated -> clean. Row 2: both unset -> clean."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
col LBTPT    type=Char
col LBTPTNUM type=Num
---
S1 | LB | 001 | 1 | GLUC | PRE-DOSE |   1
S1 | LB | 001 | 2 | GLUC |          |   .
