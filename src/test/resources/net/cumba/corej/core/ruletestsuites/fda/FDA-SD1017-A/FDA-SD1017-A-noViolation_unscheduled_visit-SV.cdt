#!RuleTest
#test FDA-SD1017-A expect=noViolation domain=SV
#note "THE POINT OF THE SPLIT (wave D, T1-39): identical to the violation fixture except row 2 reads UNSCHEDULED VISIT 1 -- conformant data that the ungated parent reported before this wave, because with the SVUPDES column absent its empty(SVUPDES) leaf treated every visit as planned. The name heuristic reads the visit as unscheduled and stays silent. It IS a heuristic: EXTRA VISIT or AD HOC would still read as planned, which is why Executability stays Possible Overreporting."
#library standard=sdtmig version=3-4
#expectViolationCount 0
dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col SVSTDTC  type=Char label="Start Date/Time of Visit"
---
CDISCPILOT01 | SV | 001 | 1  | SCREENING           | 2020-01-01
CDISCPILOT01 | SV | 001 | 99 | UNSCHEDULED VISIT 1 | 2020-01-15
---

dataset TV label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | TV | 1 | SCREENING
CDISCPILOT01 | TV | 2 | BASELINE
---
