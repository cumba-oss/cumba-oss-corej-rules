#!RuleTest
#test PMDA-AD0243B expect=skipped domain=ADSL
#note "TRT01A is not declared. The expansion is seeded from the other side (TRTxxAN matches TRT01AN, xx=01) and TRTxxA is synthesised as the absent TRT01A; Requirements.Variables.All ['TRTxxA'] rewrites to ['TRT01A'], absent, so the rule is reported not executed. Together with AD0242B's skip fixture this pins both seeding directions of the two-pattern expansion."
#library standard=adamig version=1-3
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRT01AN type=Num
---
S1 | 001 | 1
S1 | 002 | 3
