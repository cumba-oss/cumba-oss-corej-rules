#!RuleTest
#test FDA-SE2307-A expect=noViolation domain=BG
#note "Negative control: BGENDY is populated on every record -> silent."
#library standard=sendig version=3-1-1
#expectViolationCount 0
dataset BG class=FINDINGS label="Body Weight Gain"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col BGSEQ    type=Num  label="Sequence Number"
col BGTESTCD type=Char label="Test Short Name"
col BGDY     type=Num  label="Study Day of Start of Interval"
col BGENDY   type=Num  label="Study Day of End of Weight Interval"
---
S1 | BG | 001 | 1 | BWGAIN | 1 | 8
S1 | BG | 001 | 2 | BWGAIN | 8 | 15
