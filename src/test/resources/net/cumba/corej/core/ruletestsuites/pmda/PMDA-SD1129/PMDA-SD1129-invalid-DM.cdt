#!RuleTest
#test PMDA-SD1129 expect=violation domain=DM
#note "DM carries neither AGE nor AGETXT -> fires once for the dataset. COUNT-ONLY PIN, NO #expectViolationAt: dataset-granularity presence rule (BroadcastFold constant); no Output_Variables to project."
#library standard=sdtmig version=3-4
#expectViolationCount 1
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col BRTHDTC type=Char label="Date/Time of Birth"
col SEX     type=Char label="Sex"
---
S1 | DM | 001 | 1960-05-04 | M
