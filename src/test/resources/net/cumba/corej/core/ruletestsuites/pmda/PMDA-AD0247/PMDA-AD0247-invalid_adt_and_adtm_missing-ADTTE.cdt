#!RuleTest
#test PMDA-AD0247 expect=violation domain=ADTTE
#note "Row 1: both ADT and ADTM are present-in-the-dataset but blank on the row -> the third inner disjunct (empty(ADT) and empty(ADTM)) fires. Row 2: ADT populated, ADTM blank -> silent, which is the sheet's 'at least ONE of ADT or ADTM'. Isolates the ADT/ADTM conjunction and proves it is an AND, not an OR."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 nameOnly=AVAL nameOnly=STARTDT nameOnly=CNSR
dataset ADTTE structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col STARTDT type=Num
col ADT     type=Num
col ADTM    type=Num
col CNSR    type=Num
---
CDISCPILOT01 | 01-701-1015 | TTDEATH | 30 | 22000 |       |       | 1
CDISCPILOT01 | 01-701-1023 | TTDEATH | 30 | 22000 | 22100 |       | 0
