#!RuleTest
#test PMDA-AD0208 expect=violation domain=ADSL
#note "Row 1: SUBJID 9999 != DM.SUBJID 1015 -> fires. Row 2: SUBJID 1023 == DM.SUBJID 1023 -> silent. Join DM on Keys=[USUBJID], loader-default inner, 1:1 (DM unique per USUBJID, both primary rows matched)."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 SUBJID=9999 DM.SUBJID=1015
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col SUBJID  type=Char
---
S1 | 01-701-1015 | 9999
S1 | 01-701-1023 | 1023
---

dataset DM label=Demographics
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col SUBJID  type=Char
---
S1 | DM | 01-701-1015 | 1015
S1 | DM | 01-701-1023 | 1023
