#!RuleTest
#test CDISC-SEND-0149 expect=violation domain=BW
#note "SEND149: Condition --REASEX ^= null, Rule --EXCLFL = 'Y'. Row 1 excluded with a reason -> clean. Row 2 gives a reason with BWEXCLFL 'N' -> fires. Row 3 gives a reason with BWEXCLFL empty -> fires. Row 4 no reason -> clean."
#library standard=sendig version=3-1-1
#expectViolationCount 2
#expectViolationAt row=2 BWSEQ=2
#expectViolationAt row=3 BWSEQ=3
dataset BW class=FINDINGS label="Body Weights"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col BWSEQ    type=Num  label="Sequence Number"
col BWTESTCD type=Char label="Test Short Name"
col BWORRES  type=Char label="Result or Findings as Collected"
col BWEXCLFL type=Char label="Exclusion Flag"
col BWREASEX type=Char label="Reason for Exclusion"
---
S1 | BW | 001 | 1 | BW | 250 | Y | Fasting not done
S1 | BW | 002 | 2 | BW | 260 | N | Scale error
S1 | BW | 003 | 3 | BW | 255 |   | Scale error
S1 | BW | 004 | 4 | BW | 270 |   |
