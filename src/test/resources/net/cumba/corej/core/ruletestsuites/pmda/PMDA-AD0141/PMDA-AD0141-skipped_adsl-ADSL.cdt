#!RuleTest
#test PMDA-AD0141 expect=skipped domain=ADSL
#note "The dataset name ADSL decides the structure before the columns are consulted -> SUBJECT LEVEL ANALYSIS DATASET, outside [BDS, MDBDS] -> out of scope, never runs, even though this tie WOULD fire twice."
#library standard=adamig version=1-3
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col PARAM   type=Char
---
CDISCPILOT01 | 01-701-1015 | GLUC | Glucose
CDISCPILOT01 | 01-701-1023 | GLUC | GlucoseSI
---
