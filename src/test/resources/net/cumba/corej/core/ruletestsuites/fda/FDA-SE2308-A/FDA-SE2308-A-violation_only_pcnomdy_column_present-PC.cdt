#!RuleTest
#test FDA-SE2308-A expect=violation domain=PC
#note "THE ANY-GATE EXECUTION PIN: only PCNOMDY of the two anchor columns exists, and Requirements.Variables.Any [VISITDY, PCNOMDY] is satisfied by ONE present column, so the rule EXECUTES - an All gate here would wrongly skip the normal one-anchor submission. Row 1's PCNOMDY is missing and VISITDY (absent column) is all-missing -> no day anchor -> fires; row 2 is anchored."
#library standard=sendig version=3-1
#expectViolationCount 1
#expectViolationAt row=1 PCSEQ=1
dataset PC class=FINDINGS label="Pharmacokinetics Concentrations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PCSEQ    type=Num  label="Sequence Number"
col PCNOMDY type=Num  label="Nominal Study Day for Tabulations"
col PCELTM  type=Char label="Planned Elapsed Time from Time Point Ref"
---
S1 | PC | 001 | 1 | . | PT1H
S1 | PC | 001 | 2 | 1 | PT2H
