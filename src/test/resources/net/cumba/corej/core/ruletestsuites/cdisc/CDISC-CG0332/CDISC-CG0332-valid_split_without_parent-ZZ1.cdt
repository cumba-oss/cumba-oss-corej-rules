#!RuleTest
#test CDISC-CG0332 expect=noViolation domain=ZZ1
# Rule:Description: Raise an error when a split dataset (a three- or four-character dataset name not beginning with AP or FA) does not have its two-character parent domain present in the study.
#note "Split dataset ZZ1 has no unsplit ZZ dataset beside it, but its DOMAIN is ZZ, so the domain ZZ IS present in the study (SDTMIG 4.1.7 does not require a parent dataset; a domain may be submitted wholly as splits, e.g. QSCO/QSNI without QS). Until 2026-10-02 the rule compared the prefix with dataset_names() (member names) instead of study_domains(), and this scenario expected a violation."
dataset ZZ1 label="Split dataset with no unsplit ZZ dataset"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | ZZ | 01-701-1015
CDISCPILOT01 | ZZ | 01-701-1023
---

dataset DM label=Demographics
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | DM | 01-701-1015
CDISCPILOT01 | DM | 01-701-1023
---

dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | AE | 01-701-1015
---
