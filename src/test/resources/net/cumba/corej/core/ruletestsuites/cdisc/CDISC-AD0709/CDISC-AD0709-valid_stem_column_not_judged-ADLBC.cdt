#!RuleTest
#test CDISC-AD0709 expect=noViolation domain=ADLBC
#note "QH1 (a), PLAN-library-template-label-resolution: a column governed only by a published *-stem (RANDSDT, *SDT) has no library label - the stem serves its phrase to label_template alone - so the exact-label rules' not empty(var_label(\"LIBRARY\")) guard keeps it out of this rule whatever its label; the stem rule CDISC-AD0509 judges it (no double report under a second id). PARAMCD is the positive control."
#library standard=adamig version=1-3
#library variable-metadata ADLBC PARAMCD name=PARAMCD label="Parameter Code"
#library variable-metadata ADLBC *SDT name=*SDT label="{Start Date}"
#expectViolationCount 0
dataset ADLBC class=BDS
col STUDYID type=Char label="Study Identifier"
col PARAMCD type=Char label="Parameter Code"
col RANDSDT type=Char label="Foo"
---
CDISCPILOT01 | ALB | x
---
