#!RuleTest
#test FDA-SD1071 expect=violation domain=DM
#note "Dataset metadata reports dataset_size of 6000000000 bytes, above the 5 GB (5368709120 bytes) threshold -> exactly one dataset-level violation."
#library standard=sdtmig version=3-4
#expectViolationCount 1
dataset DM label="Demographics" dataset_size=6000000000
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | DM | 01-701-1015
CDISCPILOT01 | DM | 01-701-1023
