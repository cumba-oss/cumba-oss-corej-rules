#!RuleTest
#test PMDA-AD0356 expect=skipped domain=ADLBC
#note "PARAMCD makes the dataset BASIC DATA STRUCTURE, whose structure set matches neither Include token ([SLAD, DLAD]) - the scope pre-gate refuses the dataset before wildcard expansion runs. Data would fire if it ran. Single negative pin of the [SLAD, DLAD] block, shared with PMDA-AD0359 and PMDA-AD0360."
#library standard=adamig version=1-3
dataset ADLBC
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col REGION1  type=Char
col REGION1N type=Num
---
CDISCPILOT01 | 01-701-1015 | SYSBP | ASIA | 1
CDISCPILOT01 | 01-701-1023 | SYSBP | ASIA | 1
