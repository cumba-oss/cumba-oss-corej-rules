#!RuleTest
#test CDISC-CG0087 expect=violation domain=MH
#note "MHPRESP and MHSTAT are not in the dataset (rule round 2026-10-12, var_exists sweep): no record is pre-specified, so every record with a populated MHOCCUR is reported (rows 1 and 2), the record without one is not. The removed `not var_exists(\"--PRESP\") or` disjunct fired on the absence exactly as the bare `--PRESP != \"Y\"` does; verdict 1 / TRIGGER in absent-column-verdicts.tsv."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 MHSEQ=1
#expectViolationAt row=2 MHSEQ=2
dataset MH class=EVENTS label="Medical History"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col MHSEQ   type=Num  label="Sequence Number"
col MHTERM  type=Char label="Reported Term for the Medical History"
col MHOCCUR type=Char label="Medical History Occurrence"
---
S1 | MH | 001 | 1 | ASTHMA       | Y
S1 | MH | 001 | 2 | HYPERTENSION | N
S1 | MH | 001 | 3 | GOUT         |
