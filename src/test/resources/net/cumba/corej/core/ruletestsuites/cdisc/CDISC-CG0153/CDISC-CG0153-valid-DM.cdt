#!RuleTest
#test CDISC-CG0153 expect=noViolation domain=DM
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0153 (Rule: ARMCD value length <= 20). Boundary: row 2's ARMCD 'XANOMELINE_HIGH_DOSE' is exactly 20 characters, which the Rule allows; row 1's ARMCD 'PBO' is 3 characters. Nothing exceeds 20 -> silent."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015 | PBO | Placebo
CDISCPILOT01 | DM | 01-701-1023 | 1023 | XANOMELINE_HIGH_DOSE | Xanomeline High Dose
---
