#!RuleTest
#test CDISC-CG0045 expect=skipped domain=AE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0045 (Condition: --ENTPT ^= null; Rule: --ENRTPT ^= null). AEENRTPT is withheld: Requirements.Variables.All [--ENRTPT, --ENTPT] is unmet -> skip (the column's absence is CG0057's finding, not a per-record one here)."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEENTPT  type=Char label="End Reference Time Point"
---
CDISCPILOT01 | AE | 01-701-1023 | 1 | NAUSEA | END OF STUDY
