#!RuleTest
#test CDISC-CG0142 expect=noViolation domain=DM
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0142 (Condition: end-of-treatment milestone and ACTARM not in ('Screen Failure', 'Not Assigned', 'Not Treated'); Rule: RFENDTC ^= null). Rows 1-2: treated subjects with RFENDTC populated. Row 3 (SCRNFAIL) and row 4 (NOTASSGN) are outside the Condition; their null RFENDTC is not reported -> silent."
#library standard=sdtmig version=3-2
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFSTDTC  type=Char label="Subject Reference Start Date/Time"
col RFENDTC  type=Char label="Subject Reference End Date/Time"
col ACTARMCD type=Char label="Actual Arm Code"
col ACTARM   type=Char label="Description of Actual Arm"
---
CDISCPILOT01 | DM | 01-701-1015 | 2014-01-02 | 2014-07-02 | PBO | Placebo
CDISCPILOT01 | DM | 01-701-1023 | 2012-08-05 | 2012-09-02 | XANHI | Xanomeline High Dose
CDISCPILOT01 | DM | 01-701-1028 | | | SCRNFAIL | Screen Failure
CDISCPILOT01 | DM | 01-701-1033 | | | NOTASSGN | Not Assigned
