#!RuleTest
#test PMDA-SD1288 expect=skipped domain=CM
#note "The batch's Classes.Include reject pin. CM (class INTERVENTIONS) carries VIOLATING-SHAPED data (one CMDECOD, two CMPTCD values), but Scope.Classes.Include [EVENTS] rejects class=INTERVENTIONS, so the rule must not execute."
#library standard=sdtmig version=3-4
dataset CM class=INTERVENTIONS label="Concomitant Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ   type=Num  label="Sequence Number"
col CMTRT   type=Char label="Reported Name of Drug, Med, or Therapy"
col CMDECOD type=Char label="Standardized Medication Name"
col CMPTCD  type=Num  label="Preferred Term Code"
---
S1 | CM | 001 | 1 | ASPIRIN     | Aspirin | 10003504
S1 | CM | 002 | 1 | ASPIRIN TAB | Aspirin | 10003599
