#!RuleTest
#test PMDA-AD0135B expect=noViolation domain=ADLBC
#note "D.13 blank-DEPENDENT exclusion: the blank SHIFT1 is excluded from the fold, so key 2 carries the single dependent {NORMALTOHIGH} and nothing fires."
#library standard=adamig version=1-3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col SHIFT1  type=Char
col SHIFT1N type=Num
---
CDISCPILOT01 | 01-701-1015 | SYSBP | NORMALTOHIGH | 2
CDISCPILOT01 | 01-701-1023 | SYSBP |              | 2
