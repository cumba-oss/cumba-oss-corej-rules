#!RuleTest
#test CDISC-CG0218 expect=skipped domain=SV
# Rule:Description: Raise an error when the Epoch (EPOCH) in the Subject Visits (SV) domain does not match the EPOCH value of the corresponding Subject Elements (SE) element whose date range (SESTDTC to SEENDTC) contains the visit start date (SVSTDTC).
#note "SV has no EPOCH column, so the Requirements.Variables.All gate skips the rule (there is no Precondition involved)"
dataset SV label="Subject Visits"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SVSEQ type=Num label="Sequence Number"
col SVSTDTC type=Char label="Start Date/Time of Visit"
---
CDISCPILOT01 | SV | 01-701-1015 | 1 | 2013-12-31
---

dataset SE label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ type=Num label="Sequence Number"
col SESTDTC type=Char label="Start Date/Time of Element"
col SEENDTC type=Char label="End Date/Time of Element"
col EPOCH type=Char label="Epoch"
---
CDISCPILOT01 | SE | 01-701-1015 | 1 | 2013-12-26 | 2014-01-02 | SCREENING
---
