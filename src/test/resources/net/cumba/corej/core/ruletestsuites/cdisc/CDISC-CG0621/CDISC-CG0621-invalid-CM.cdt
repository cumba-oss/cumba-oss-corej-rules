#!RuleTest
#test CDISC-CG0621 expect=violation domain=CM
# Rule:Description: Raise an error when --METHOD is present in an Interventions class dataset, because this variable is not permitted in human clinical trials.
#note "CMMETHOD column is present in the Interventions dataset -> violation"
#expectViolationCount 1
#expectViolationAt row=1
dataset CM label="Concomitant Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ type=Num label="Sequence Number"
col CMMETHOD type=Char label="Method of Test or Examination"
---
CDISCPILOT01 | CM | 01-701-1015 | 1 | ORAL
CDISCPILOT01 | CM | 01-701-1015 | 2 |
---
