#!RuleTest
#test FDA-SD0031 expect=violation domain=SE
#note "Special Purpose scope branch (SE is in class, not excluded like CO/DM): SEENDTC populated with SESTDTC empty -> fires."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 SESEQ=1
dataset SE class="SPECIAL PURPOSE" label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ   type=Num  label="Sequence Number"
col ETCD    type=Char label="Element Code"
col SESTDTC type=Char label="Start Date/Time of Element"
col SEENDTC type=Char label="End Date/Time of Element"
---
S1 | SE | 001 | 1 | SCRN |            | 2020-01-10
S1 | SE | 001 | 2 | TRT  | 2020-01-10 | 2020-02-10
