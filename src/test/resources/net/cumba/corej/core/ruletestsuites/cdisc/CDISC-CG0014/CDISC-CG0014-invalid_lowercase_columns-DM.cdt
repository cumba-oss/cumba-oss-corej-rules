#!RuleTest
#test CDISC-CG0014 expect=violation domain=DM
#note "Lowercase columns; the SDTMIG-Required SEX is genuinely absent. CG0014 -> one dataset-level finding naming SEX in the library's spelling."
#library standard=sdtmig version=3-4
#library required-variables DM STUDYID DOMAIN USUBJID SUBJID SITEID SEX
#expectViolationCount 1
#expectViolationAt "$missing_required_variables"="[SEX]"
dataset DM label="Demographics"
col studyid type=Char label="Study Identifier"
col domain  type=Char label="Domain Abbreviation"
col usubjid type=Char label="Unique Subject Identifier"
col subjid  type=Char label="Subject Identifier for the Study"
col siteid  type=Char label="Study Site Identifier"
---
S1 | DM | S1-001 | 001 | 01
