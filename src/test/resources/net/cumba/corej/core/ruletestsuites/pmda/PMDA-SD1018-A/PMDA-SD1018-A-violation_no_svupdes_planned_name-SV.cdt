#!RuleTest
#test PMDA-SD1018-A expect=violation domain=SV
#note "The record half of the R-5.25 split (wave D, T1-40, sheet issue #209): SV carries no SVUPDES column, so the gated parent PMDA-SD1018 skips this dataset -- and this sibling re-derives planned-ness from the VISIT name instead, keeping the parent's TV left join on (VISITNUM, VISIT, VISITDY) and its All [VISITNUM] gate. Row 2 reads WEEK2, which marks nothing, so it is treated as planned; its triple (3, WEEK2, 15) matches no TV entry -> empty(TV.VISITNUM) -> fires. Row 1 matches TV -> clean."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1015 VISITNUM=3
dataset SV label="Subject Visits"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col VISITNUM type=Num
col VISIT    type=Char
col VISITDY  type=Num
---
CDISCPILOT01 | SV | 01-701-1015 | 1 | SCREENING | -7
CDISCPILOT01 | SV | 01-701-1015 | 3 | WEEK2     | 15
---

dataset TV label="Trial Visits"
col STUDYID  type=Char
col DOMAIN   type=Char
col VISITNUM type=Num
col VISIT    type=Char
col VISITDY  type=Num
---
CDISCPILOT01 | TV | 1 | SCREENING | -7
CDISCPILOT01 | TV | 2 | BASELINE  | 1
---
