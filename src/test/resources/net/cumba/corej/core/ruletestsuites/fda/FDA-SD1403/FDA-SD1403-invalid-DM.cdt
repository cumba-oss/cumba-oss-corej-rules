#!RuleTest
#test FDA-SD1403 expect=violation domain=DM
#note "Animal 002's first challenge-agent administration (2020-01-21) is after the last one (2020-01-20)."
#library standard=sendig-ar version=1-0
#expectViolationCount 1
#expectViolationAt row=2 RFCSTDTC=2020-01-21 RFCENDTC=2020-01-20
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SUBJID   type=Char label="Subject Identifier for the Study"
col RFCSTDTC type=Char label="Date/Time of First Challenge Agent Admin"
col RFCENDTC type=Char label="Date/Time of Last Challenge Agent Admin"
---
STUDY01 | DM | STUDY01-001 | 001 | 2020-01-05 | 2020-01-20
STUDY01 | DM | STUDY01-002 | 002 | 2020-01-21 | 2020-01-20
