#!RuleTest
#test PMDA-SD1135-A expect=violation domain=EC
#note "The half this R-5.25 split sibling owns (top-level-or board wave 2, group J; the PMDA twin of FDA-SD1135-A, Severity Warning from the parent): ECENDY=-1 on row 1 -> fires, named against --ENDY alone. ECSTDY is positive throughout, so the parent PMDA-SD1135 is silent here - the discriminator of the split. The EC domain is in scope alongside EX."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 ECENDY=-1
dataset EC class=INTERVENTIONS label="Exposure as Collected"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col ECSEQ   type=Num  label="Sequence Number"
col ECTRT   type=Char label="Name of Treatment"
col ECSTDY  type=Num  label="Study Day of Start of Treatment"
col ECENDY  type=Num  label="Study Day of End of Treatment"
---
S1 | EC | 001 | 1 | DRUG A | 1 | -1
S1 | EC | 001 | 2 | DRUG A | 2 | 5
