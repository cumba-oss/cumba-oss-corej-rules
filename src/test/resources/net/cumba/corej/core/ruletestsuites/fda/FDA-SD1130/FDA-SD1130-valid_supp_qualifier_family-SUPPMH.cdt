#!RuleTest
#test FDA-SD1130 expect=noViolation domain=SUPPMH
#note "PLAN-stopped-rule-engine-fixes item 3 (SR5): a supplemental qualifier that itself exceeds 200 characters is split the same way (SDTMIG 3.3 section 4.5.3.2): MHCOMM continues as MHCOMM1 under one QLABEL. One family stem, so the rule must not fire. Fires twice under the rule before its family-stem conjunct."
#library standard=sdtmig version=3-3
dataset SUPPMH label="Supplemental Qualifiers for MH"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM     type=Char label="Qualifier Variable Name"
col QLABEL   type=Char label="Qualifier Variable Label"
col QVAL     type=Char label="Data Value"
col QORIG    type=Char label="Origin"
col QEVAL    type=Char label="Evaluator"
---
12345 | MH | 99-123 | MHSEQ | 6 | MHCOMM | Medical History Comment | first 200 chars of the comment | CRF |
12345 | MH | 99-123 | MHSEQ | 6 | MHCOMM1 | Medical History Comment | the rest of the comment | CRF |
