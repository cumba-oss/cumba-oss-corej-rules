#!RuleTest
#test PMDA-SD2236 expect=violation domain=DM
#note "Row 2 was randomised to 'PBO' but the actual arm code says 'TRT' -> fires."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 ACTARMCD=TRT
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SUBJID   type=Char label="Subject Identifier for the Study"
col ARMCD    type=Char label="Planned Arm Code"
col ACTARMCD type=Char label="Actual Arm Code"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015 | PBO | PBO
CDISCPILOT01 | DM | 01-701-1023 | 1023 | PBO | TRT
