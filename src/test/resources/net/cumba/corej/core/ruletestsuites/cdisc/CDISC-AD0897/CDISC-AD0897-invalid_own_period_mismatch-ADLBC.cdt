#!RuleTest
#test CDISC-AD0897 expect=violation domain=ADLBC
#note "Round 2026-10-15 (owner: compare by APERIOD against TRTxxA of the record's own period). Row 1 (APERIOD 1) equals TRT01A -> silent; row 2 (APERIOD 2) equals TRT01A but not TRT02A -> fires. The old rule took any TRTxxA as a match and stayed silent on row 2."
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1015
#define standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col TRTA type=Char
col APERIOD type=Num
---
CDISCPILOT01 | 01-701-1015 | Drug X | 1
CDISCPILOT01 | 01-701-1015 | Drug X | 2
---

dataset ADSL label="Subject-Level Analysis"
col STUDYID type=Char
col USUBJID type=Char
col TRT01A type=Char
col TRT02A type=Char
---
CDISCPILOT01 | 01-701-1015 | Drug X | Placebo
