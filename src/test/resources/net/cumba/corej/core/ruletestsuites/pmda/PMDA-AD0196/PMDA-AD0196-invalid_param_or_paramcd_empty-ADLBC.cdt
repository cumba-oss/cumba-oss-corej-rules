#!RuleTest
#test PMDA-AD0196 expect=violation domain=ADLBC
#note "Positive control at Record granularity, narrowed to the PARAM half by the R-5.25 split (top-level-or board wave 2, group J): row 1 (PARAM blank) fires. Row 3 (PARAMCD blank) is the split sibling PMDA-AD0196-A's state and must NOT fire here - the discriminator; row 2 has both populated. PARAM values are single-token stand-ins so they remain pinnable - #expectViolationAt is space-delimited and a pinned value may never contain a space."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015 PARAMCD=ALT
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col PARAM   type=Char
col AVAL    type=Num
