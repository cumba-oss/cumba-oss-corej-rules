#!RuleTest
#test PMDA-AD0159 expect=violation domain=ADLBC
#note "THE AWTARGET COLUMN IS ABSENT. Row 1: the first disjunct empty(AWTARGET) is TRUE on every row of the absent column (absent = all-missing, EC-43) -> fires. Row 2: AWTDIFF blank -> the leading guard is false -> silent. Pins that an ABSENT AWTARGET FIRES rather than silencing the rule, which is what the sheet's applicability condition requires. Plan B phase 4d' deleted the AUTHORED not var_exists(AWTARGET) disjunct that used to carry the absence case separately from the emptiness case; the single empty() leaf subsumes both and the verdict is unchanged."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 nameOnly=ADY nameOnly=AWTDIFF
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col ADY     type=Num
col AWTDIFF type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | 30 | 5 | 2
CDISCPILOT01 | 01-701-1023 | ALB | 31 | 9 |
