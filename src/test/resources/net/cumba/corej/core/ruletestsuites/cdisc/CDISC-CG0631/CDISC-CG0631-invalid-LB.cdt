#!RuleTest
#test CDISC-CG0631 expect=violation domain=LB
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0631 (Rule: RPHASE not present in dataset; not permitted in human clinical trials). LB carries a RPHASE column (populated on row 1, empty on row 2) -> the dataset-level presence check fires once."
#library standard=sdtmig version=3-4
#expectViolationCount 1
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBORRES  type=Char label="Result or Finding in Original Units"
col RPHASE type=Char label="Reproductive Phase"
---
S1 | LB | S1-001 | 1 | ALT | 25 | PREMATING
S1 | LB | S1-002 | 1 | ALT | 31 | 
