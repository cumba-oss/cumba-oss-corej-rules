#!RuleTest
#test CDISC-CG0244 expect=violation domain=TV
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0244 (Rule: ARM not in ('Screen Failure', 'Not Assigned', 'Unplanned Treatment', 'Not Treated'); Domain: TA, TV). Row 2's ARM 'NOT ASSIGNED' is a non-treatment value; the check compares upper-cased, so the upper-case spelling is caught too -> fires. Row 1's ARM is the planned Placebo arm -> silent."
#library standard=sdtmig version=3-2
#expectViolationCount 1
#expectViolationAt row=2 VISITNUM=2 ARM="NOT ASSIGNED"
dataset TV class="TRIAL DESIGN" label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col ARMCD    type=Char label="Planned Arm Code"
col ARM      type=Char label="Description of Planned Arm"
---
CDISCPILOT01 | TV | 1 | SCREENING 1 | PBO | Placebo
CDISCPILOT01 | TV | 2 | BASELINE | NOTASSGN | NOT ASSIGNED
---
