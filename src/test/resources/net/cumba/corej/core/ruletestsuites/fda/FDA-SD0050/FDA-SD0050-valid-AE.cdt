#!RuleTest
#test FDA-SD0050 expect=noViolation domain=AE
#note "Every record with an end-relative-to-reference value (AEENRTPT) also names the end reference time point (AEENTPT); row 3 has neither."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEENRTPT type=Char label="End Relative to Reference Time Point"
col AEENTPT  type=Char label="End Reference Time Point"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE | ONGOING | 2020-03-01
CDISCPILOT01 | AE | 01-701-1015 | 2 | NAUSEA   | BEFORE  | 2020-03-01
CDISCPILOT01 | AE | 01-701-1023 | 1 | RASH     |         |
