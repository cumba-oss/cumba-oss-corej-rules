#!RuleTest
#test FDA-SD0045 expect=noViolation domain=LB
# Rule:Description: Raise an error when Result Category (--RESCAT) is specified but Character Result/Finding in Std Units (--STRESC) is empty.
#note "LBRESCAT is populated and LBSTRESC is also populated, so the rule does not fire"
#library standard=sdtmig version=3-4
dataset LB label="Laboratory Tests Results"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col LBSEQ type=Num label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBSTRESC type=Char label="Character Result/Finding in Std Format"
col LBRESCAT type=Char label="Result Category"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB | 38 | NORMAL
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALP | 39 |
---
