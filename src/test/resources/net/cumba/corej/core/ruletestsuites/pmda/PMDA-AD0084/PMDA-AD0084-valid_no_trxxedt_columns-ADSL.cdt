#!RuleTest
#test PMDA-AD0084 expect=noViolation domain=ADSL
#note "dataset ADSL with STUDYID/USUBJID/TRTEDT only - the name_pattern matches NO column, so row_max answers the computed missing on every row -> `not empty($trxx_max)` false -> noViolation WITH execution (row_max is not library-dependent; there is no skip arm, so a SKIPPED here would be a defect)."
#library standard=adamig version=1-3
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRTEDT  type=Num
---
S1 | 01-001 | 22000
