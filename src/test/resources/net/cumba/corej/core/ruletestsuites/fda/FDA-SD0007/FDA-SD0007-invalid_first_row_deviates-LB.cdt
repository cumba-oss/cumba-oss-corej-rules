#!RuleTest
#test FDA-SD0007 expect=violation domain=LB
#note "Same data as FDA-SD0007-invalid_majority-LB.cdt, only the record order differs: the deviating mg/dL record is now the group's FIRST row. The group is inconsistent either way, so both files must report the group once. Pairing this green scenario with the red -invalid_majority- one isolates the defect to record order, not to the data. (Sensitivity Record since 2026-07-28: every minority row reports; formerly red under Group representative-row collection.)"
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 LBTESTCD=GLUC LBSTRESU=mg/dL
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBCAT    type=Char label="Category for Lab Test"
col LBSCAT   type=Char label="Subcategory for Lab Test"
col LBSPEC   type=Char label="Specimen Type"
col LBMETHOD type=Char label="Method of Test or Examination"
col LBSTRESU type=Char label="Standard Units"
---
S1 | LB | 003 | 1 | GLUC | CHEMISTRY | GLUCOSE | SERUM | ENZYMATIC | mg/dL
S1 | LB | 001 | 1 | GLUC | CHEMISTRY | GLUCOSE | SERUM | ENZYMATIC | mmol/L
S1 | LB | 002 | 1 | GLUC | CHEMISTRY | GLUCOSE | SERUM | ENZYMATIC | mmol/L
