#!RuleTest
#test CDISC-CG0124 expect=violation domain=DM
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0124 (SDTMIG 3.2), Condition \"ACTARMCD not in TA.ARMCD\", Rule \"ACTARMCD in (SCRNFAIL, NOTASSGN, NOTTRT, UNPLAN)\"; exemption literals are the sheet's exact upper-case values. Rows 2 (XANLO) and 5 (XANMED) carry an ACTARMCD that TA does not define and that is no exemption value -> both fire. Row 1 matches TA; rows 3 (SCRNFAIL) and 4 (NOTTRT) are exempt by the Rule -> silent."
#library standard=sdtmig version=3-2
#expectViolationCount 2
#expectViolationAt row=2 USUBJID=01-002 ACTARMCD=XANLO
#expectViolationAt row=5 USUBJID=01-005 ACTARMCD=XANMED
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARMCD    type=Char label="Planned Arm Code"
col ACTARMCD type=Char label="Actual Arm Code"
---
CDISCPILOT01 | DM | 01-001 | PBO      | PBO
CDISCPILOT01 | DM | 01-002 | XANHI    | XANLO
CDISCPILOT01 | DM | 01-003 | SCRNFAIL | SCRNFAIL
CDISCPILOT01 | DM | 01-004 | XANHI    | NOTTRT
CDISCPILOT01 | DM | 01-005 | PBO      | XANMED
---

dataset TA label="Trial Arms"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
col TAETORD type=Num  label="Planned Order of Element within Arm"
col ETCD    type=Char label="Element Code"
col ELEMENT type=Char label="Description of Element"
---
CDISCPILOT01 | TA | PBO   | Placebo         | 1 | SCRN | Screening
CDISCPILOT01 | TA | PBO   | Placebo         | 2 | PBO  | Placebo
CDISCPILOT01 | TA | XANHI | Xanomeline High | 1 | SCRN | Screening
CDISCPILOT01 | TA | XANHI | Xanomeline High | 2 | XANH | Xanomeline High
---
