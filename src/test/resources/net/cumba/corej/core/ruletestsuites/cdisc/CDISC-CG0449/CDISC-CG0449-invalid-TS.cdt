#!RuleTest
#test CDISC-CG0449 expect=violation domain=TS
#note "PLAN-per-row-functions phase 0 (first scenario for CDISC-CG0449): row 2's TSVALCD=99999999 under TSPARMCD=TDIGRP is not a SNOMED CT concept id (SNOMEDCD level) of the (dummy) snomed dictionary -> fires. Row 1 is valid (25064002); row 3 carries the same invalid value under AGEMAX (outside the rule's TSPARMCD condition); row 4's blank TSVALCD is a completeness concern of another rule -> no fire. Executing pin written against the pre-port engine."
#library standard=sdtmig version=3-3
#dictionaries dummy
#expectViolationCount 1
#expectViolationAt row=2 TSSEQ=2 TSPARMCD=TDIGRP TSVALCD=99999999
dataset TS
col STUDYID  type=Char
col DOMAIN   type=Char
col TSSEQ    type=Num
col TSPARMCD type=Char
col TSVALCD  type=Char
---
S01 | TS | 1 | TDIGRP | 25064002
S01 | TS | 2 | TDIGRP | 99999999
S01 | TS | 3 | AGEMAX | 99999999
S01 | TS | 4 | TDIGRP |
