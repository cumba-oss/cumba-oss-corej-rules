#!RuleTest
#test FDA-SD1078 expect=violation domain=AE
#note "Authority: FDA Validator Rules v1.6 SD1078 / SDTMIG Conformance Rules v2.0 CG0015 (a Permissible variable should not be present when it has no values). The lowercase twin of FDA-SD1078-invalid-AE: aesev is Permissible in SDTMIG 3.4 AE and empty on every record -> fires once, reported as aesev (CIT 3: upper-cased name against the upper-cased Permissible list, which names the dataset's own columns)."
#library-include FDA-SD1078-library.yaml
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt variable_name=aesev
dataset AE label="Adverse Events"
col studyid type=Char label="Study Identifier"
col domain  type=Char label="Domain Abbreviation"
col usubjid type=Char label="Unique Subject Identifier"
col aeseq   type=Num  label="Sequence Number"
col aeterm  type=Char label="Reported Term for the Adverse Event"
col aesev   type=Char label="Severity/Intensity"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE |
CDISCPILOT01 | AE | 01-701-1023 | 1 | NAUSEA   |
