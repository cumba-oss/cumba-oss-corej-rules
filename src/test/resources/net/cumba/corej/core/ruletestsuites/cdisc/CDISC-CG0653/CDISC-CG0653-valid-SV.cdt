#!RuleTest
#test CDISC-CG0653 expect=noViolation domain=SV
# Rule:Description: Raise an error when Subject Visit Pre-specified (SVPRESP) is populated with a value that is not equal to 'Y'.
#note "SVPRESP is either Y or empty on every row, so neither row meets non-empty-and-not-Y"
dataset SV label="Subject Visits"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SVSEQ type=Num label="Sequence Number"
col SVPRESP type=Char label="Pre-Specified"
---
CDISCPILOT01 | SV | 01-701-1015 | 1 | Y
CDISCPILOT01 | SV | 01-701-1015 | 2 |
---
