#!RuleTest
#test CDISC-SEND-0305 expect=executionError domain=DM
#note "PLAN-scalar-date-extremes: S14 / GKI Q2: EX POOLID Char (all blank), POOLDEF POOLID Num -> the POOLDEF read's key pair differs in kind and the rule ERRORs. Green only after the rule reads POOLDEF (red-before: executed, POOLDEF unread)."
#library standard=sendig version=3-1-1
#expect-execution-error "key column POOLID is Character in EX"
dataset DM label=Demographics
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFXSTDTC type=Char label="Date/Time of First Study Treatment"
---
S1 | DM | 001 | 2020-01-01
---
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col POOLID  type=Char label="Pool Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
---
S1 | EX | 001 |  | 1 | DRUG A | 2020-01-01
---
dataset POOLDEF label="Pool Definition"
col STUDYID type=Char label="Study Identifier"
col POOLID  type=Num  label="Pool Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
---
S1 | 1 | 001
---
