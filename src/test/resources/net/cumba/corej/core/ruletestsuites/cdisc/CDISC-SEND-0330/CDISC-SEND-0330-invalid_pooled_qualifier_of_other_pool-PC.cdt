#!RuleTest
#test CDISC-SEND-0330 expect=violation domain=PC
#note "Combined review of runbook W2-W8, W2 H2 (red-before on the pre-fix engine: 0 findings). SEND pooled records: USUBJID blank, POOLID populated (SENDIG: either USUBJID or POOLID must be populated). SUPPPC qualifies pool P1's record (POOLID=P1, PCSEQ=1) only. The pivot used to key on USUBJID alone, so the blank USUBJID matched BOTH pools and P2's BLQ record read P1's PCCALCN. Keyed on (USUBJID, POOLID): P1 is supplemented (clean), P2 is not (fires)."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=2 POOLID=P2
dataset PC class=FINDINGS label="Pharmacokinetics Concentrations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col POOLID   type=Char label="Pool Identifier"
col PCSEQ    type=Num  label="Sequence Number"
col PCTESTCD type=Char label="Test Short Name"
col PCSTRESC type=Char label="Result or Finding in Standard Format"
col PCSTRESN type=Num  label="Numeric Result/Finding in Standard Units"
---
S1 | PC |  | P1 | 1 | DRUGX | BLQ |
S1 | PC |  | P2 | 1 | DRUGX | BLQ |
---

dataset SUPPPC label="Supplemental Qualifiers for PC"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col POOLID   type=Char label="Pool Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM     type=Char label="Qualifier Variable Name"
col QLABEL   type=Char label="Qualifier Variable Label"
col QVAL     type=Char label="Data Value"
---
S1 | PC |  | P1 | PCSEQ | 1 | PCCALCN | Numeric Interpretation for Calculations | 0.05
---
