#!RuleTest
#test CDISC-AD0514 expect=violation domain=ADLBC
# Rule:Description: A variable ending in STMF must have a label that ends with "Imputation Flag" (or "Imput. Flag") and contains "Start" and "Time"
#note "ASTMF has no Imputation-Flag suffix; BSTMF lacks "Start"; CSTMF lacks "Time"; DSTMF carries the phrase but not at the END; ESTMF differs only in CASE. TR1STMF, TRTSTMF, TR01STMF and TR99STMF all carry the SAME label, and only the library tells them apart: TRTSTMF is the ADSL literal TRTSTMF and TR01STMF / TR99STMF match the ADSL template TRxxSTMF (D9, PLAN-library-template-label-resolution), so var_name(\"LIBRARY\") is not *STMF and the rule does not judge them; the near-miss TR1STMF (one digit) matches no template, falls to the *STMF stem and still fires."
#expectViolationCount 6
#expectViolationAt variable_label="Start Time Flag" variable_name=ASTMF
#expectViolationAt variable_label="Analysis Time Imput. Flag" variable_name=BSTMF
#expectViolationAt variable_label="Analysis Start Imput. Flag" variable_name=CSTMF
#expectViolationAt variable_label="Start Time Imputation Flag Extra" variable_name=DSTMF
#expectViolationAt variable_label="Analysis Start Time imputation Flag" variable_name=ESTMF
#expectViolationAt variable_label="Time of First Exposure Imput. Flag" variable_name=TR1STMF
#library standard=adamig version=1-3
#library variable-metadata ADLBC *STMF name=*STMF label="{Start Time Imputation Flag}"
#library variable-metadata ADLBC *TMF name=*TMF label="{Time Imputation Flag}"
#library variable-metadata ADSL TRTSTMF name=TRTSTMF label="Time of First Exposure Imput. Flag"
#library variable-metadata ADSL TRxxSTMF name=TRxxSTMF label="Time 1st Exposure Period xx Imput. Flag"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ASTMF type=Char label="Start Time Flag"
col BSTMF type=Char label="Analysis Time Imput. Flag"
col CSTMF type=Char label="Analysis Start Imput. Flag"
col DSTMF type=Char label="Start Time Imputation Flag Extra"
col ESTMF type=Char label="Analysis Start Time imputation Flag"
col TR1STMF type=Char label="Time of First Exposure Imput. Flag"
col TRTSTMF type=Char label="Time of First Exposure Imput. Flag"
col TR01STMF type=Char label="Time of First Exposure Imput. Flag"
col TR99STMF type=Char label="Time of First Exposure Imput. Flag"
---
CDISCPILOT01 | 01-701-1015 | ALB | x | x | x | x | x | x | x | x | x
---
