#!RuleTest
#test PMDA-AD0366 expect=violation domain=ADSL
#note "No RANDDT column at all. Row 1 carries RANDFL=Y -> $RANDFL_Y_COUNT=1 > 0 and RANDDT absent -> fires once. Fires under BOTH the shipped rule and the proposed presence-conditioned rule - ruling-neutral. Y record kept on data row 1 (the finding materialises from the broadcast row)."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 nameOnly=RANDFL
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col RANDFL  type=Char
---
S1 | 001 | Y
S1 | 002 | N
