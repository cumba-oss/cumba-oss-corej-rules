#!RuleTest
#test CDISC-AD9704 expect=violation domain=ADSL
#note "Authority: ADaMIG v1.3 Section 3.2 ADSL variables with Core = Req. Lowercase columns; the Required siteid is genuinely absent while trt01p satisfies TRTxxP -> one dataset-level finding whose missing list names SITEID in the library's spelling, and neither the present lowercase columns nor the matched template instance."
#library standard=adamig version=1-3
#library required-variables-for-structure "SUBJECT LEVEL ANALYSIS DATASET" STUDYID USUBJID SUBJID SITEID AGE AGEU SEX RACE ARM TRTxxP
#expectViolationCount 1
#expectViolationAt "$missing_required_variables"="[SITEID]"
dataset ADSL structure=ADSL
col studyid type=Char label="Study Identifier"
col usubjid type=Char label="Unique Subject Identifier"
col subjid  type=Char label="Subject Identifier for the Study"
col age     type=Num  label="Age"
col ageu    type=Char label="Age Units"
col sex     type=Char label="Sex"
col race    type=Char label="Race"
col arm     type=Char label="Description of Planned Arm"
col trt01p  type=Char label="Planned Treatment for Period 01"
---
CDISCPILOT01 | 01-701-1015 | 1015 | 63 | YEARS | F | WHITE | Placebo | Placebo
