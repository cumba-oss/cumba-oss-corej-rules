#!RuleTest
#test PMDA-SD1369 expect=noViolation domain=LB
#note "PMDA sheet row 379's condition is '--ORREF is populated', nothing about derived records - the --DRVFL='Y' branch belongs to CDISC-CG0549 and was removed from this pair by CL-A A.11 (wave TA-4). Row 1 is a derived record (LBDRVFL=Y) with LBORREF empty and LBSTREFC empty -> silent under the sheet-faithful shape (the --ORREF condition never holds). Row 2 is derived with LBSTREFC populated."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBORREF  type=Char label="Reference Result in Original Units"
col LBSTREFC type=Char label="Reference Result in Standard Format"
col LBDRVFL  type=Char label="Derived Flag"
---
S1 | LB | 001 | 1 | GLUC |     |     | Y
S1 | LB | 001 | 2 | ALB  |     | 7.0 | Y
