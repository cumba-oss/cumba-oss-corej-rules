#!RuleTest
#test CDISC-CG0219 expect=noViolation domain=VS
#note "VS carries VSDTC, one of the Model Timing variables -> the two sets share an element -> no violation. W4 (PLAN-list-functions phase 0, scenarios-first on the pre-port engine)."
#library standard=sdtmig version=3-4
#library dataset-class VS FINDINGS
#library model-variables VS STUDYID:Identifier DOMAIN:Identifier USUBJID:Identifier VSSEQ:Identifier VSTESTCD:Topic "VSORRES:Result Qualifier" VSDTC:Timing VSDY:Timing
dataset VS class=FINDINGS label="Vital Signs"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VSSEQ    type=Num  label="Sequence Number"
col VSTESTCD type=Char label="Vital Signs Test Short Name"
col VSORRES  type=Char label="Result or Finding in Original Units"
col VSDTC    type=Char label="Date/Time of Measurements"
---
S1 | VS | 001 | 1 | SYSBP | 120 | 2020-01-01
