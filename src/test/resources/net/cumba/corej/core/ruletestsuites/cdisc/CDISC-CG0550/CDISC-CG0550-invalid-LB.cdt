#!RuleTest
#test CDISC-CG0550 expect=violation domain=LB
# Rule:Description: Raise an error when --STREFC is populated but --STREFN is missing.
#note "--STREFC populated but --STREFN empty -> violation"
#expectViolationCount 1
#expectViolationAt row=1 LBSEQ=1 USUBJID=01-701-1015
dataset LB label="Laboratory Tests Results"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col LBSEQ type=Num label="Sequence Number"
col LBSTREFC type=Char label="Character Reference Result in Std Format"
col LBSTREFN type=Char label="Numeric Reference Result in Std Units"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | NORMAL |
CDISCPILOT01 | LB | 01-701-1015 | 2 | NORMAL | 38
---
