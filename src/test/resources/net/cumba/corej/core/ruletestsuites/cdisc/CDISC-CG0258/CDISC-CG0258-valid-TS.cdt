#!RuleTest
#test CDISC-CG0258 expect=noViolation domain=TS
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0258 (Rule: TSPARM value length <= 40). Boundary: row 3's TSPARM 'Planned Number of Subjects per Arm Group' is exactly 40 characters, which the Rule allows; rows 1-2 are shorter -> silent."
#library standard=sdtmig version=3-4
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
CDISCPILOT01 | TS | 1 | TITLE | Trial Title | Safety and Efficacy of Xanomeline
CDISCPILOT01 | TS | 1 | AGEMAX | Planned Maximum Age of Subjects | P90Y
CDISCPILOT01 | TS | 1 | PLANSUB | Planned Number of Subjects per Arm Group | 86
---
