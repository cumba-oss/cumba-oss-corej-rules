#!RuleTest
#test CDISC-AD0504 expect=violation domain=ADLBC
#library standard=adamig version=1-3
#library variable-metadata ADLBC *TM name=*TM label="{Time}"
#library variable-metadata ADLBC *DTM name=*DTM label="{Datetime}"
# Rule:Description: A variable ending in TM must contain "Time" in the label
#note "ATM label "Analysis Foo" lacks "Time" -> violation"
#expectViolationCount 1
#expectViolationAt variable_label="Analysis Foo" variable_name=ATM
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ATM type=Char label="Analysis Foo"
---
CDISCPILOT01 | 01-701-1015 | ALB | x
---
