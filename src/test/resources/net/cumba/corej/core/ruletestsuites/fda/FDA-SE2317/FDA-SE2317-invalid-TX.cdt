#!RuleTest
#test FDA-SE2317 expect=violation domain=TX
#note "Rows 1/2: TXPARMCD='SPECIES' twice within SET01 -> both fire. Rows 3/4: SET02 keeps its parameter codes unique (SPECIES appearing again in a different set is fine)."
#library standard=sendig version=3-1-1
#expectViolationCount 2
#expectViolationAt row=1 TXSEQ=1
#expectViolationAt row=2 TXSEQ=2
dataset TX
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col SETCD    type=Char label="Set Code"
col SET      type=Char label="Set Description"
col TXSEQ    type=Num  label="Sequence Number"
col TXPARMCD type=Char label="Trial Set Parameter Short Name"
col TXPARM   type=Char label="Trial Set Parameter"
col TXVAL    type=Char label="Trial Set Parameter Value"
---
S1 | TX | SET01 | Control   | 1 | SPECIES | Species | RAT
S1 | TX | SET01 | Control   | 2 | SPECIES | Species | MOUSE
S1 | TX | SET02 | High Dose | 3 | SPECIES | Species | RAT
S1 | TX | SET02 | High Dose | 4 | STRAIN  | Strain  | WISTAR
