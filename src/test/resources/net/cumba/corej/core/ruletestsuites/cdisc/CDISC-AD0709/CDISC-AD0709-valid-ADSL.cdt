#!RuleTest
#test CDISC-AD0709 expect=noViolation domain=ADSL
# Rule:Description: Variable label does not match the standard (Library) label for the variable.
#note "Synthetic: AGE label 'Age' matches the Library label 'Age' -> no violation"
#library standard=adamig version=1-3
#library variable-metadata ADSL AGE label="Age" simpleDatatype=Num
dataset ADSL
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col AGE type=Num label="Age"
---
CDISCPILOT01 | 01-701-1015 | 56
---
