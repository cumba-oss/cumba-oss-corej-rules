#!RuleTest
#test CDISC-CG0565 expect=violation domain=LB
# Rule:Description: Raise an error when --CONC is present in a Findings-class dataset whose domain is not MS.
#note "LBCONC column is present in LB, so the rule fires"
#expectViolationCount 1
#expectViolationAt row=1
dataset LB label="Laboratory Tests Results"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col LBSEQ type=Num label="Sequence Number"
col LBCONC type=Char label="Concentration"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 |
CDISCPILOT01 | LB | 01-701-1015 | 2 |
---
