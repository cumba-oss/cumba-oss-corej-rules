#!RuleTest
#test CDISC-CG0531 expect=noViolation domain=DM
# Rule:Description: Raise an error when RACE in DM equals 'MULTIPLE' but multiple race records are not present in SUPPDM for the subject.
#note "PLAN-split-supp-resolution (Q1-Q3): SUPPDM is submitted split as SUPPDM1 + SUPPDM2 (RDOMAIN=DM, no SUPPDM). record_count(domain=\"SUPPDM\") counts the family: subject 01-701-1015 has RACE1 in SUPPDM1 and RACE2 in SUPPDM2 -> two race records -> no violation. Red on the pre-plan engine: SUPPDM resolved to nothing, the count was 0 and the MULTIPLE subject fired."
#expectViolationCount 0
dataset DM label=Demographics
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RACE type=Char label=Race format=$RACE.
---
CDISCPILOT01 | DM | 01-701-1015 | MULTIPLE
CDISCPILOT01 | DM | 01-701-1023 | WHITE
---

dataset SUPPDM1 label="Supplemental Qualifiers for DM (part 1)"
col STUDYID type=Char label="Study Identifier"
col RDOMAIN type=Char label="Related Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col QNAM type=Char label="Qualifier Variable Name"
---
CDISCPILOT01 | DM | 01-701-1015 | RACE1
---

dataset SUPPDM2 label="Supplemental Qualifiers for DM (part 2)"
col STUDYID type=Char label="Study Identifier"
col RDOMAIN type=Char label="Related Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col QNAM type=Char label="Qualifier Variable Name"
---
CDISCPILOT01 | DM | 01-701-1015 | RACE2
---
