#!RuleTest
#test FDA-SD1017 expect=skipped domain=SV
#note "GATED 2026-09-11 (wave D, T1-39): Requirements.Variables.All now carries SVUPDES, so a dataset with no SVUPDES column takes one auditable skip naming the column instead of flooding -- before the gate the bare empty(SVUPDES) leaf was TRUE on every row (absent = all-missing, EC-43) and every visit counted as planned, so row 2 fired. The check itself is NOT lost on this shape: the R-5.25 split sibling FDA-SD1017-A re-derives planned-ness from the VISIT name on this same data and stays silent here because row 2 reads UNSCHEDULED."
#library standard=sdtmig version=3-4
dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col SVSTDTC  type=Char label="Start Date/Time of Visit"
---
CDISCPILOT01 | SV | 001 | 1 | SCREENING | 2020-01-01
CDISCPILOT01 | SV | 001 | 99 | UNSCHEDULED | 2020-01-15
---

dataset TV label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | TV | 1 | SCREENING
CDISCPILOT01 | TV | 2 | BASELINE
---
