#!RuleTest
#test PMDA-SD0033 expect=skipped domain=LB
#note "No LBTPTNUM column at all while LBTPT is populated. Requirements.Variables.All [--TPT, --TPTNUM] gates the rule out -> auditable skip naming the absent variable, instead of one finding per row under absent = all-missing (EC-43). Row 1 WOULD fire were the gate removed. Verdict 2-1': PMDA-SD1250 reports the absence itself."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
col LBTPT    type=Char
---
S1 | LB | 001 | 1 | GLUC | PRE-DOSE
S1 | LB | 001 | 2 | GLUC |
