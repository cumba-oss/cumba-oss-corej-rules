#!RuleTest
#test CDISC-CG0088 expect=noViolation domain=CM
# Rule:Description: Raise an error when the Occurrence (--OCCUR) variable is present in the dataset but the Pre-specified (--PRESP) variable is not present in the dataset.
dataset CM label="Concomitant Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ type=Num
col CMOCCUR type=Char
col CMPRESP type=Char
---
CDISCPILOT01 | CM | 01-701-1015 | 1 | | 
CDISCPILOT01 | CM | 01-701-1015 | 1 | | 
---
