#!RuleTest
#test CDISC-CG0115 expect=violation domain=LB
# Rule:Description: Raise an error when --LOC is not present but --PORTOT is present.
#note "LBPORTOT is present while LBLOC is absent, so the rule fires"
#expectViolationCount 1
#expectViolationAt row=1
dataset LB label="Laboratory Tests Results"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col LBSEQ type=Num label="Sequence Number"
col LBPORTOT type=Char label="Portion or Totality"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 |
CDISCPILOT01 | LB | 01-701-1015 | 2 |
---
