#!RuleTest
#test CDISC-AD0591 expect=violation domain=ADAE
#note "SEX is shared by name with ADSL and disagrees for the same USUBJID -> violation. The template binds &VAR to the shared set {SEX}: STUDYID/USUBJID are the merge keys and AETERM is not in ADSL, so exactly one expansion runs."
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015
dataset ADAE
col STUDYID type=Char
col USUBJID type=Char
col SEX     type=Char
col AETERM  type=Char
---
CDISCPILOT01 | 01-701-1015 | F | HEADACHE
---

dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col SEX     type=Char
---
CDISCPILOT01 | 01-701-1015 | M
---
