#!RuleTest
#test CDISC-CG0169 expect=skipped domain=CO
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0169 (Domain CO, Variable COVAL; Condition: no comment > 200 characters; Rule: COVALn not present in dataset). COVAL is withheld (COVAL1 kept and populated): Requirements.Variables.All [COVAL] is unmet, so the comment length cannot be measured and the rule must skip."
#library standard=sdtmig version=3-4
dataset CO class="SPECIAL PURPOSE" label="Comments"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col COSEQ    type=Num  label="Sequence Number"
col COVAL1   type=Char label="Comment"
col CODTC    type=Char label="Date/Time of Comment"
---
CDISCPILOT01 | CO | | 01-701-1023 | 1 | ABROAD | 2014-03-02
