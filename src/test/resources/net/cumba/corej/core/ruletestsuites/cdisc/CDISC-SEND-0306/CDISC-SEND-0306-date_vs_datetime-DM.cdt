#!RuleTest
#test CDISC-SEND-0306 expect=noViolation domain=DM
#note "PLAN-scalar-date-extremes: Measured in phase 0: own EXENDTC 2020-02-01 (a date) and pool P7 EXENDTC 2020-02-01T10:00 (a datetime) -> latest_date answers the DATE (its hull ends at the end of the day), and date(RFXENDTC) != that answer is silent for RFXENDTC 2020-02-01T10:00 (008) and for 2020-02-01 (009): typed date equality holds on the same day. Pin (silent before too)."
#library standard=sendig version=3-1-1
dataset DM label=Demographics
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFXENDTC type=Char label="Date/Time of Last Study Treatment"
---
S1 | DM | 008 | 2020-02-01T10:00
S1 | DM | 009 | 2020-02-01
---
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col POOLID  type=Char label="Pool Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
col EXENDTC type=Char label="End Date/Time of Treatment"
---
S1 | EX | 008 |  | 1 | DRUG A | 2020-01-01 | 2020-02-01
S1 | EX |  | P7 | 2 | DRUG A | 2020-01-01 | 2020-02-01T10:00
S1 | EX | 009 |  | 3 | DRUG A | 2020-01-01 | 2020-02-01
S1 | EX |  | P8 | 4 | DRUG A | 2020-01-01 | 2020-02-01T10:00
---
dataset POOLDEF label="Pool Definition"
col STUDYID type=Char label="Study Identifier"
col POOLID  type=Char label="Pool Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
---
S1 | P7 | 008
S1 | P8 | 009
---
