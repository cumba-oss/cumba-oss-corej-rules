#!RuleTest
#test CDISC-AD0515 expect=violation domain=ADLBC
# Rule:Description: A variable ending in EDT must contain "End Date" in the label
#note "AEDT label "Analysis Date" lacks "End Date" -> violation"
#expectViolationCount 1
#expectViolationAt variable_label="Analysis Date" variable_name=AEDT
#library standard=adamig version=1-3
#library variable-metadata ADLBC *EDT name=*EDT label="{End Date}"
#library variable-metadata ADLBC *DT name=*DT label="{Date}"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AEDT type=Char label="Analysis Date"
---
CDISCPILOT01 | 01-701-1015 | ALB | x
---
