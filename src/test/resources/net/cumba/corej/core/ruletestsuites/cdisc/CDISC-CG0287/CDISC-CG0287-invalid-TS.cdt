#!RuleTest
#test CDISC-CG0287 expect=violation domain=TS
#note "Positive control added by PLAN-absent-guard-test-hardening P3: this rule previously had ONLY an expect=skipped fixture, which asserts non-execution and so proved nothing about the rule ever running at this standard/version. TS carries only TITLE, so the required parameter set is not fully present and the rule fires once for the dataset. Since rule round 2026-10-03 the finding names the 26 MISSING codes in $missing_parameters (owner: \"agree to the proposed rule change\") instead of TSPARMCD, which carried the first row's value and read as if that code were missing."
#library standard=sdtmig version=3-3
#expectViolationCount 1
#expectViolationAt row=1 "$missing_parameters"="[ADDON, AGEMAX, AGEMIN, LENGTH, PLANSUB, RANDOM, SEXPOP, STOPRULE, TBLIND, TCNTRL, TPHASE, TTYPE, OBJPRIM, SPONSOR, REGID, OUTMSPRI, FCNTRY, ADAPT, DCUTDTC, DCUTDESC, NARMS, STYPE, SSTDTC, SENDTC, ACTSUB, HLTSUBJI]"
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL    type=Char label="Parameter Value"
---
CDISCPILOT01 | TS | 1 | TITLE | A Phase 3 Study
---
