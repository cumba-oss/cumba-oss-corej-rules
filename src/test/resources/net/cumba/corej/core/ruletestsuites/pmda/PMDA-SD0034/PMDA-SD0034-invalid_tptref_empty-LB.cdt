#!RuleTest
#test PMDA-SD0034 expect=violation domain=LB
#note "Both columns present (the Requirements.Variables.All [--ELTM, --TPTREF] gate is satisfied), so the verdict is unchanged by the gate: row 1 has LBELTM=PT1H with LBTPTREF empty -> fires. Row 2: both populated -> clean."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 LBSEQ=1
dataset LB class=FINDINGS
col STUDYID   type=Char
col DOMAIN    type=Char
col USUBJID   type=Char
col LBSEQ     type=Num
col LBTESTCD  type=Char
col LBELTM    type=Char
col LBTPTREF  type=Char
---
S1 | LB | 001 | 1 | GLUC | PT1H |
S1 | LB | 001 | 2 | GLUC | PT1H | DOSE ADMINISTRATION
