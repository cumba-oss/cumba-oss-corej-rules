#!RuleTest
#test CDISC-CG0372 expect=skipped domain=LB
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0372 (Class FND, TDM; Rule: --TESTCD <= 8 chars and contains only letters, numbers, and underscores and can not start with a number). LBTESTCD is withheld: Requirements.Variables.All [--TESTCD] is unmet -> skip."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTEST   type=Char label="Lab Test or Examination Name"
col LBORRES  type=Char label="Result or Finding in Original Units"
---
CDISCPILOT01 | LB | 01-701-1015 | 2 | Cholesterol | 5.2
