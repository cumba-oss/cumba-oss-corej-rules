#!RuleTest
#test CDISC-CG0166 expect=noViolation domain=CO
#note "IDVARVAL populated with RDOMAIN populated (row 1); IDVARVAL empty (row 2) -> no violation."
#library standard=sdtmig version=3-4
dataset CO class="SPECIAL PURPOSE" label="Comments"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col COSEQ    type=Num  label="Sequence Number"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col COVAL    type=Char label="Comment"
---
S1 | AE |  | 1 | AESEQ | 1 | Comment on the AE record
S1 |    | 001 | 2 |  |  | General subject comment
