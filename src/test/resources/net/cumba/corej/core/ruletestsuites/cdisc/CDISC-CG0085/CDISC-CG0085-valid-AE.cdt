#!RuleTest
#test CDISC-CG0085 expect=noViolation domain=AE
# Rule:Description: Raise an error when --PRESP is populated with a value that is not equal to 'Y'.
#note "AEPRESP is either Y or empty"
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AEPRESP type=Char label="Pre-Specified"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | Y
CDISCPILOT01 | AE | 01-701-1015 | 2 | 
---
