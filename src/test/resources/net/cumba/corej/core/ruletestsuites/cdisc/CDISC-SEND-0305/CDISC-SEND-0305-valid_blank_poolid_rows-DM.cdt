#!RuleTest
#test CDISC-SEND-0305 expect=noViolation domain=DM
#note "PLAN-scalar-date-extremes: Own EX rows with a BLANK POOLID (001 2020-01-05, 002 2020-01-01) and a POOLDEF row for 001 with a blank POOLID; RFXSTDTC = each own earliest -> silent. Pin of the filter=(not empty(POOLID)): without it the blank-POOLID EX rows form a group under the default KEEP_MISSING_KEYS policy, which the blank-POOLID POOLDEF row joins -> 001 reported. The 7 filter sabotage reds this scenario."
#library standard=sendig version=3-1-1
dataset DM label=Demographics
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFXSTDTC type=Char label="Date/Time of First Study Treatment"
---
S1 | DM | 001 | 2020-01-05
S1 | DM | 002 | 2020-01-01
---
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col POOLID  type=Char label="Pool Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
---
S1 | EX | 001 |  | 1 | DRUG A | 2020-01-05
S1 | EX | 002 |  | 2 | DRUG A | 2020-01-01
---
dataset POOLDEF label="Pool Definition"
col STUDYID type=Char label="Study Identifier"
col POOLID  type=Char label="Pool Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
---
S1 |  | 001
---
