#!RuleTest
#test CDISC-CG0037 expect=skipped domain=AE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0037 (Condition: Primary SOC used for analysis; Rule: --SOCCD = --BDSYCD). AEBDSYCD is withheld: Requirements.Variables.All [--BDSYCD, --SOCCD] is unmet, so the rule cannot compare the codes and must skip."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEDECOD  type=Char label="Dictionary-Derived Term"
col AESOCCD  type=Num  label="Primary System Organ Class Code"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE | HEADACHE | 10029205
