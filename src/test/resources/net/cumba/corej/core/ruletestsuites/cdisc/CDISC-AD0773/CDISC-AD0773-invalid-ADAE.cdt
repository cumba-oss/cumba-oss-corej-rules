#!RuleTest
#test CDISC-AD0773 expect=violation domain=ADAE
# Rule:Description: There is more than one value of SEVGRy for a given value of SEVGRyN, considering only those rows on which both variables are populated
#note "SEVGR1N=1 maps to two distinct SEVGR1 -> violation"
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015
#expectViolationAt row=2 USUBJID=01-701-1015
# Declared-tier scope: the class= declaration disagrees with the columns, so #define must
# carry it to RuleRunner (ScenarioDeclaredScopeProvider.install).
#define standard=adamig version=1-3
dataset ADAE class=OCCDS
col STUDYID type=Char
col USUBJID type=Char
col ASEQ type=Num
col SEVGR1 type=Char
col SEVGR1N type=Num
---
CDISCPILOT01 | 01-701-1015 | 1 | MILD | 1
CDISCPILOT01 | 01-701-1015 | 2 | LOW | 1
---
