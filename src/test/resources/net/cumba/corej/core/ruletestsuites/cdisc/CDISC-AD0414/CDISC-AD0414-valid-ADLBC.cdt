#!RuleTest
#test CDISC-AD0414 expect=noViolation domain=ADLBC
# Rule:Description: There is more than one value of ANLzzFL for a given value of ANLzzFN , considering only those rows on which both variables are populated
#note "each ANL01FN value maps to a single ANL01FL value -> noViolation"
# Declared-tier scope: the class= declaration disagrees with the columns, so #define must
# carry it to RuleRunner (ScenarioDeclaredScopeProvider.install).
#define standard=adamig version=1-3
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col ANL01FL type=Char
col ANL01FN type=Char
---
CDISCPILOT01 | 01-701-1015 | A1 | G
CDISCPILOT01 | 01-701-1023 | A2 | H
---
