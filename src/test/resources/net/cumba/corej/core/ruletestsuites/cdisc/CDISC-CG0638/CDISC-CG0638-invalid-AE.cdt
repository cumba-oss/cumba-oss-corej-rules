#!RuleTest
#test CDISC-CG0638 expect=violation domain=AE
# Rule:Description: Raise an error when --RPSTDY is present.
#note "AERPSTDY column is present in the dataset"
#expectViolationCount 1
#expectViolationAt row=1
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AERPSTDY type=Char label="Reference Period Relative Start Day"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | 1
CDISCPILOT01 | AE | 01-701-1015 | 2 | 3
---
