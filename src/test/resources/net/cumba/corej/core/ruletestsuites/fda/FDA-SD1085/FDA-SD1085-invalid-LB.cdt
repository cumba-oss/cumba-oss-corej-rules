#!RuleTest
#test FDA-SD1085 expect=violation domain=LB
#note "Row 1: LBDY populated with partial LBDTC (2020-06) -> fires. Row 2: 002 has LBDY populated, complete LBDTC but partial RFSTDTC (2020) -> fires. Row 3: all complete -> no fire."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=001
#expectViolationAt row=2 USUBJID=002
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test Short Name"
col LBDTC    type=Char label="Date/Time of Specimen Collection"
col LBDY     type=Num  label="Study Day of Specimen Collection"
---
S1 | LB | 001 | 1 | ALB | 2020-06    | 5
S1 | LB | 002 | 1 | ALB | 2020-01-15 | 15
S1 | LB | 001 | 2 | ALB | 2020-01-15 | 15
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
---
S1 | DM | 001 | 2020-01-01
S1 | DM | 002 | 2020
---
