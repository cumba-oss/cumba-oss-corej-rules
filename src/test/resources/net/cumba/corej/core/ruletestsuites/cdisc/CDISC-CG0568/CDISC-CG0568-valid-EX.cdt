#!RuleTest
#test CDISC-CG0568 expect=noViolation domain=EX
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0568 (Rule: EXMETHOD not present in dataset). EX without an EXMETHOD column -> the rule executes and stays silent. SDTMIG 3.3 package: the rule's only listed standard."
#library standard=sdtmig version=3-3
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXDOSE  type=Num  label="Dose"
col EXDOSU  type=Char label="Dose Units"
col EXROUTE type=Char label="Route of Administration"
---
S1 | EX | S1-001 | 1 | DRUG A | 10 | mg | ORAL
S1 | EX | S1-002 | 1 | DRUG A | 10 | mg | ORAL
