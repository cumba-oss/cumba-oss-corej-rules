#!RuleTest
#test CDISC-AD0207 expect=noViolation domain=ADSL
# Rule:Description: The value of ADSL.USUBJID is equal to the value of DM.USUBJID and ADSL.RACE is not equal to DM.RACE
#note "same USUBJID, ADSL.RACE == DM.RACE -> noViolation"
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col RACE type=Char
---
CDISCPILOT01 | 01-701-1015 | WHITE
---

dataset DM label=Demographics
col STUDYID type=Char
col DOMAIN type=Char
col USUBJID type=Char
col RACE type=Char
---
CDISCPILOT01 | DM | 01-701-1015 | WHITE
---
