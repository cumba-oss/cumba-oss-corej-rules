#!RuleTest
#test PMDA-SD1321 expect=executionError domain=AE
#expect-execution-error "group= over 'SUPPAE' has no usable key"
#note "PLAN-join-key-one-side-absent-drop QK16 (b) / QK18 (owner 2026-10-11): SUPPAE without USUBJID - the domain= call's only group= member is on the evaluated side only, so no key member is left on both sides and the rule ERRORs (never an aggregate over the whole of SUPPAE). Derived from PMDA-SD1321-invalid-AE.cdt with SUPPAE.USUBJID removed. A gate declaring SUPPAE.USUBJID would turn this into a SKIP."
#library standard=sdtmig version=3-4
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEDECOD type=Char label="Dictionary-Derived Term"
---
S1 | AE | 001 | 1 | Headache | HEADACHE
S1 | AE | 002 | 1 | Nausea   | NAUSEA
---

dataset SUPPAE label="Supplemental Qualifiers for AE"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM     type=Char label="Qualifier Variable Name"
col QLABEL   type=Char label="Qualifier Variable Label"
col QVAL     type=Char label="Data Value"
---
S1 | AE | AESEQ | 1 | AETRTEM | Treatment Emergent Flag | Y
---
