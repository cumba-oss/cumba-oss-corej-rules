#!RuleTest
#test FDA-SD1319 expect=violation domain=DS
#note "Row 1: DSSTDTC before RFICDTC -> fires. Row 2: DSSTDTC equal to RFICDTC -> clean."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 DSSEQ=1
dataset DS class=EVENTS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSDECOD type=Char label="Standardized Disposition Term"
col DSSTDTC type=Char label="Start Date/Time of Disposition Event"
---
S1 | DS | 001 | 1 | RANDOMIZED                | 2019-12-15
S1 | DS | 001 | 2 | INFORMED CONSENT OBTAINED | 2020-01-01
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFICDTC type=Char label="Date/Time of Informed Consent"
---
S1 | DM | 001 | 2020-01-01
---
