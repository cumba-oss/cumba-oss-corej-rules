#!RuleTest
#test CDISC-SEND-0137 expect=noViolation domain=EX
#note "As invalid, but the EXDOSE ItemDef carries def:CommentOID=COM.EXDOSE (+ CommentDef) -> no violation. Every OTHER declared variable also carries a CommentOID (as in the invalid fixture) or it would fire instead."
#library standard=sendig version=3-1-1
#define-xml CDISC-SEND-0137-valid-define.xml
dataset EX
col STUDYID type=Char
col USUBJID type=Char
col EXTRT   type=Char
col EXDOSE  type=Num
---
S1 | S1-001 | DRUG A | 10
