#!RuleTest
#test FDA-SD9716 expect=skipped domain=AE
#note "No AEBDSYCD column: Requirements.Variables.All [--BDSYCD] gates the sister out. Without a populated code there is nothing that demands the text, so an absent AEBODSYS says nothing here. Note --BODSYS itself is in None, not in the gate - gating on it is what the parent does, and doing it here would blind the sister to the case it exists for."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE
