#!RuleTest
#test PMDA-SD1238 expect=skipped domain=PC
#note "No PCTPTREF column at all while PCRFTDTC is populated. Requirements.Variables.All [--TPTREF] gates the rule out -> auditable skip naming the absent variable, instead of one finding per row under absent = all-missing (EC-43). Row 1 WOULD fire were the gate removed. Verdict 2-1': PMDA-SD1245 reports the absence itself."
#library standard=sdtmig version=3-4
dataset PC class=FINDINGS
col STUDYID   type=Char
col DOMAIN    type=Char
col USUBJID   type=Char
col PCSEQ     type=Num
col PCTESTCD  type=Char
col PCRFTDTC  type=Char
---
