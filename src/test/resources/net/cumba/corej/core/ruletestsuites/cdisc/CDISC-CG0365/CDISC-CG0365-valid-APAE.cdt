#!RuleTest
#test CDISC-CG0365 expect=noViolation domain=APAE
# Rule:Description: Raise an error when Related Subject or Pool Identifier (RSUBJID) is populated and Related Device Identifier (RDEVID) is also populated for the same record.
#note "RSUBJID is populated but RDEVID is present-and-empty, so not both are populated"
dataset APAE label="Associated Persons Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col APID type=Char label="Associated Persons Identifier"
col AESEQ type=Num label="Sequence Number"
col RSUBJID type=Char label="Related Subject or Pool Identifier"
col RDEVID type=Char label="Related Device Identifier"
---
CDISCPILOT01 | APAE | AP-701-1015 | 1 | 01-701-1015 |
---
