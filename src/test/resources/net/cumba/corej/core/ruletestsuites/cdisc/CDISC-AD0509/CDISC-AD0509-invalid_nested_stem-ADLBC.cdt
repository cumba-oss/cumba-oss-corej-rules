#!RuleTest
#test CDISC-AD0509 expect=violation domain=ADLBC
#note "PLAN-library-template-label-resolution R2-3 (owner 2026-10-04, follow the authority): RANDSDT ends in SDT, so this rule judges it with *SDT's phrase - label_template(\"LIBRARY\", stem=\"*SDT\") is '{Start Date}' for it. CDISC-AD0503 judges it too, with *DT's phrase (its invalid_nested_stem scenario); this label carries 'Date', so only this rule fires here. The label lacks 'Start Date' -> one violation, showing the published phrase as library_variable_label_template."
#library standard=adamig version=1-3
#library variable-metadata ADLBC *DT name=*DT label="{Date}"
#library variable-metadata ADLBC *SDT name=*SDT label="{Start Date}"
#expectViolationCount 1
#expectViolationAt variable_name=RANDSDT variable_label="Randomization Date" library_variable_label_template="{Start Date}"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col RANDSDT type=Char label="Randomization Date"
---
CDISCPILOT01 | 01-701-1015 | ALB | x
---
