#!RuleTest
#test PMDA-AD0159 expect=violation domain=ADLBC
#note "Row 1: AWTDIFF populated while AWTARGET is present-but-blank -> the first disjunct empty(AWTARGET) fires. Row 2: everything populated -> silent. Record granularity -> 1 violation. AWTARGET is blank on the fired row and is NOT pinned."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 nameOnly=ADY nameOnly=AWTDIFF
dataset ADLBC
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVAL     type=Num
col ADY      type=Num
col AWTARGET type=Num
col AWTDIFF  type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | 30 | 5 |   | 2
CDISCPILOT01 | 01-701-1023 | ALB | 31 | 9 | 7 | 2
