#!RuleTest
#test CDISC-CG0441 expect=noViolation domain=TS
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0441 (Condition: TSPARMCD = 'STOPRULE'; Rule: TSVAL ^= null). The STOPRULE record states its stopping rule in TSVAL (NONE is a valid statement that no stopping rule applies); row 3 (AGEMAX, TSVAL empty with null flavor PINF) is outside the Condition. No row fires."
#library standard=sdtmig version=3-3
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
col TSVALNF  type=Char label="Parameter Null Flavor"
---
CDISCPILOT01 | TS | 1 | TITLE | Trial Title | A Study of Xanomeline |
CDISCPILOT01 | TS | 1 | STOPRULE | Study Stop Rules | NONE |
CDISCPILOT01 | TS | 1 | AGEMAX | Planned Maximum Age of Subjects | | PINF
---
