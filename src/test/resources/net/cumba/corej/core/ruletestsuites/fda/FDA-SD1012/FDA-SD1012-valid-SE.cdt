#!RuleTest
#test FDA-SD1012 expect=noViolation domain=SE
#note "Rows 1/2 pair ETCD/ELEMENT exactly as defined in TE; row 3 is an unplanned element (ETCD=UNPLAN exception) whose description is deliberately not in TE and must not fire."
#library standard=sdtmig version=3-4
dataset SE label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ   type=Num  label="Sequence Number"
col ETCD    type=Char label="Element Code"
col ELEMENT type=Char label="Description of Element"
col SESTDTC type=Char label="Start Date/Time of Element"
---
CDISCPILOT01 | SE | 01-701-1015 | 1 | SCRN   | Screening         | 2013-12-26
CDISCPILOT01 | SE | 01-701-1015 | 2 | TRT    | Treatment         | 2014-01-02
CDISCPILOT01 | SE | 01-701-1015 | 3 | UNPLAN | Unplanned Washout | 2014-02-01
---

dataset TE label="Trial Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ETCD    type=Char label="Element Code"
col ELEMENT type=Char label="Description of Element"
---
CDISCPILOT01 | TE | SCRN | Screening
CDISCPILOT01 | TE | TRT  | Treatment
