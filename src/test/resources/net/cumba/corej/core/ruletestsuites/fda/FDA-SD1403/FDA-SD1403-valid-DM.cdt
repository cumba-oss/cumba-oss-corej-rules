#!RuleTest
#test FDA-SD1403 expect=noViolation domain=DM
#note "Sheet: 'RFCSTDTC must be less than or equal to RFCENDTC' (SENDIG-AR challenge-agent administration window). Subject 1 first < last, subject 2 a single administration (equal), subject 3 has no last-administration date."
#library standard=sendig-ar version=1-0
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SUBJID   type=Char label="Subject Identifier for the Study"
col RFCSTDTC type=Char label="Date/Time of First Challenge Agent Admin"
col RFCENDTC type=Char label="Date/Time of Last Challenge Agent Admin"
---
STUDY01 | DM | STUDY01-001 | 001 | 2020-01-05 | 2020-01-20
STUDY01 | DM | STUDY01-002 | 002 | 2020-01-06 | 2020-01-06
STUDY01 | DM | STUDY01-003 | 003 | 2020-01-07 |
