#!RuleTest
#test FDA-SD2223 expect=noViolation domain=TS
#note "Regression pin for the T2 fix: the positive pharm-INTTYPE gate (record_count over DRUG/BIOLOGIC/VACCINE/DIETARY SUPPLEMENT/COMBINATION PRODUCT) keeps a device-intervention trial from requiring PCLAS."
#library standard=sdtmig version=3-4
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | TITLE   | Trial Title | A Pivotal Study of Device X in Subjects With Condition Y
S01 | TS | 2 | STYPE   | Study Type | INTERVENTIONAL
S01 | TS | 3 | INTTYPE | Intervention Type | DEVICE
S01 | TS | 4 | TTYPE   | Trial Type | EFFICACY
