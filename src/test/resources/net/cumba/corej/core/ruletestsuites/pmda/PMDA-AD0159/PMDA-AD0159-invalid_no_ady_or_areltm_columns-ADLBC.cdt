#!RuleTest
#test PMDA-AD0159 expect=violation domain=ADLBC
#note "NEITHER ADY NOR ARELTM is present. Row 1: both factors of the second disjunct are true (empty(ADY) and empty(ARELTM), each TRUE on its absent column under absent = all-missing, EC-43) -> fires even though AWTARGET is perfectly populated. This pins the sentence the Source itself writes: 'If only AWTDIFF is present and populated, this rule will fire even if some or all other variables are not present' - which is also why the rule is authored 'Partially Executable - Possible Underreporting'."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 nameOnly=AWTARGET nameOnly=AWTDIFF
dataset ADLBC
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVAL     type=Num
col AWTARGET type=Num
col AWTDIFF  type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | 30 | 7 | 2
