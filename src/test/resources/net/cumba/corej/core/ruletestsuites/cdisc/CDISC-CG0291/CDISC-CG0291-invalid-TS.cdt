#!RuleTest
#test CDISC-CG0291 expect=violation domain=TS
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0291 (Condition: TSVALNF = null; Rule: TSVAL not populated with values or synonyms of values in the ISO 21090 null flavor codelist). Row 1 writes the null flavor 'UNKNOWN' into TSVAL with TSVALNF null -> fires. Row 2 carries a real value (P50Y) -> silent. Row 3 leaves TSVAL null and puts the null flavor PINF in TSVALNF, as required -> silent. TSVALNF is populated on row 3, so the finding is per row, not the folded dataset-level form."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 TSPARMCD=AGEMAX TSVAL=UNKNOWN
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
col TSVALNF  type=Char label="Parameter Null Flavor"
---
CDISCPILOT01 | TS | 1 | AGEMAX | Planned Maximum Age of Subjects | UNKNOWN | 
CDISCPILOT01 | TS | 1 | AGEMIN | Planned Minimum Age of Subjects | P50Y | 
CDISCPILOT01 | TS | 2 | AGEMAX | Planned Maximum Age of Subjects |  | PINF
---
