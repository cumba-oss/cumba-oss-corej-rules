#!RuleTest
#test CDISC-CG0033-A expect=violation domain=LB
#note "The SVPRESP-unavailable arm of the CDISC-CG0033 split. SV has no SVPRESP column, so planned-ness is read from the VISIT name instead - the operationalisation FDA-SD1023 / PMDA-SD1023 already use for the same question, and which their own sheets authorise (\"with the exception of Unscheduled and Unplanned visits\"). Row 2's VISIT is \"WEEK 99\", which marks nothing, so it is treated as scheduled and VISITNUM=99 is checked against TV - and is absent. Row 1's VISITNUM=2 is in TV."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1015 VISITNUM=99
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB | 2  | BASELINE
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALB | 99 | WEEK 99
---

dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | SV | 01-701-1015 | 2  | BASELINE
CDISCPILOT01 | SV | 01-701-1015 | 99 | WEEK 99
---

dataset TV label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | TV | 1 | SCREENING
CDISCPILOT01 | TV | 2 | BASELINE
---

