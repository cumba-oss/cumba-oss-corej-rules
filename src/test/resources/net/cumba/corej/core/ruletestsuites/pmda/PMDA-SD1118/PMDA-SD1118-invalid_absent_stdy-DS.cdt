#!RuleTest
#test PMDA-SD1118 expect=violation domain=DS
#note "Boundary case for the --STDY leaf: DSSTDY is not present in the dataset at all, DSDTC and DSSTDTC are present-and-empty. The record therefore populates none of the three timing variables, so the rule must fire (compare the --DTC leaf, which is authored absent-tolerant)."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 DSTERM=WITHDRAWN
dataset DS class=EVENTS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSTERM  type=Char label="Reported Term for the Disposition Event"
col DSDECOD type=Char label="Standardized Disposition Term"
col DSDTC   type=Char label="Date/Time of Collection"
col DSSTDTC type=Char label="Start Date/Time of Disposition Event"
---
S1 | DS | 001 | 1 | WITHDRAWN | WITHDRAWN |  |
