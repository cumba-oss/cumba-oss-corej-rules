#!RuleTest
#test CDISC-CG0218 expect=violation domain=SV
#runLevel Info
#note "SV Assumption 11 (SDTMIG 3.2/3.3; #15 in 3.4): SV.EPOCH is the epoch of the element in progress when the visit starts; SE Assumption 10: an element's SEENDTC is the next element's SESTDTC, the transition instant belongs to the next element (end-exclusive). PLAN-cg0218-transition-day-precision (B2, owner 2026-10-05): a visit is judged against every element that MAY be in progress at its start and reported only when its EPOCH matches none of them, once, on the element that contains it (ERROR); partial dates on the same principle at INFO (Q4), once per candidate element. Pin (no movement; grouping by visit, never by subject): visit 1 on the transition day 2012-07-09 labelled SCREENING matches the ending element and is silent; visit 2 on 2012-07-20 labelled SCREENING lies inside TREATMENT only (SCREENING ended eleven days earlier and is no candidate) and is reported on TREATMENT. Grouped by subject, visit 1's SCREENING candidate would wrongly silence visit 2."
#expectViolationCount 1
#expectViolationAt row=2 severity=ERROR VISITNUM=2 SE.EPOCH=TREATMENT
dataset SV label="Subject Visits"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col VISITNUM type=Num label="Visit Number"
col VISIT type=Char label="Visit Name"
col SVSTDTC type=Char label="Start Date/Time of Visit"
col EPOCH type=Char label="Epoch"
---
CDISCPILOT01 | SV | 01-701-0001 | 1 | DAY 1 | 2012-07-09 | SCREENING
CDISCPILOT01 | SV | 01-701-0001 | 2 | WEEK 2 | 2012-07-20 | SCREENING
---

dataset SE label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ type=Num label="Sequence Number"
col SESTDTC type=Char label="Start Date/Time of Element"
col SEENDTC type=Char label="End Date/Time of Element"
col EPOCH type=Char label="Epoch"
---
CDISCPILOT01 | SE | 01-701-0001 | 1 | 2012-07-06 | 2012-07-09 | SCREENING
CDISCPILOT01 | SE | 01-701-0001 | 2 | 2012-07-09 | 2012-08-20 | TREATMENT
---
