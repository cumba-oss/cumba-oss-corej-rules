#!RuleTest
#test CDISC-CG0110 expect=violation domain=CM
# Rule:Description: Raise an error when --DOSE is populated and --DOSTXT is populated.
#note "CMDOSE and CMDOSTXT both populated on the same record -> violation"
#expectViolationCount 1
#expectViolationAt row=1 CMSEQ=1 USUBJID=01-701-1015
dataset CM label="Concomitant Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ type=Num label="Sequence Number"
col CMDOSE type=Num label="Dose per Administration"
col CMDOSTXT type=Char label="Dose Description"
---
CDISCPILOT01 | CM | 01-701-1015 | 1 | 10 | 10-20
CDISCPILOT01 | CM | 01-701-1015 | 2 | 1  |
---
