#!RuleTest
#test PMDA-SD0053 expect=noViolation domain=DM
#note "Row 1 pairs both sentinels together, rows 2-3 use ordinary arms - both disjuncts are false on every row."
#library standard=sdtmig version=3-2
dataset DM
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col ARMCD   type=Char
col ARM     type=Char
---
S1 | DM | 001 | NOTASSGN | Not Assigned
S1 | DM | 002 | A        | Placebo
S1 | DM | 003 | B        | Drug X 10 mg
