#!RuleTest
#test CDISC-SEND-0371 expect=skipped domain=FM
#note "NO #library line at all: codelist_terms needs the CDISC Library -> the rule SKIPs. The body is the invalid one. W4 (PLAN-list-functions phase 0, scenarios-first on the pre-port engine)."
dataset FM
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col FMSEQ    type=Num  label="Sequence Number"
col FMTESTCD type=Char label="Fetal Measurement Test Short Name"
col FMSTRESC type=Char label="Character Result/Finding in Std Format"
---
S1 | FM | 001 | 1 | SEXFETAL | MALE
