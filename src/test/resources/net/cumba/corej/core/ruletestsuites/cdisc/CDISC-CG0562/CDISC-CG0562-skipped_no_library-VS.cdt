#!RuleTest
#test CDISC-CG0562 expect=skipped domain=VS
#note "NO #library line at all: $TIMING_VARIABLES (get_dataset_filtered_variables) needs the CDISC Library, so the rule SKIPs before the record_count / is_unique_set splice can run over an empty timing-variable list. The body is the invalid-VS-1 one (with a Library it fires twice). W4 (PLAN-list-functions phase 0, scenarios-first on the pre-port engine)."
dataset VS class=FINDINGS label="Vital Signs"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VSSEQ    type=Num  label="Sequence Number"
col VSTESTCD type=Char label="Vital Signs Test Short Name"
col VSREPNUM type=Num  label="Repetition Number"
col VSDTC    type=Char label="Date/Time of Measurements"
---
S1 | VS | 001 | 1 | SYSBP | 1 | 2020-01-01
S1 | VS | 001 | 2 | SYSBP | 1 | 2020-01-01
