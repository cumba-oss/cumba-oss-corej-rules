#!RuleTest
#test CDISC-AD0018 expect=noViolation domain=ADSL
#note "CR18 (ADaM Conformance Rules v5.0, ADaMIG 1.0): the exception for variables whose names contain an index (y, xx, zz, w). trt01p is a period-indexed instance of the ADaMIG template TRTxxP; the Library publishes the template only, so trt01p resolves to no Library variable (var_label(\"LIBRARY\") is empty) and is not judged, whatever its label. studyid is the positive control: resolved, label matches."
#library standard=adamig version=1-0
#library variable-metadata ADSL STUDYID name=STUDYID label="Study Identifier"
#library variable-metadata ADSL TRTxxP name=TRTxxP label="Planned Treatment for Period xx"
#expectViolationCount 0
dataset ADSL
col studyid type=Char label="Study Identifier"
col trt01p  type=Char label="Any Sponsor Label"
---
CDISCPILOT01 | Placebo
---
