#!RuleTest
#test FDA-SE9708 expect=skipped domain=BW
#note "The discriminator: BWDTC is PRESENT (blank on row 2) -> the companion SKIPS on None [--DTC]; the imputation parent FDA-SD1085 runs and reports the record whose date is incomplete."
#library standard=sendig version=3-1-1
dataset BW class=FINDINGS label="Body Weights"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col BWSEQ    type=Num  label="Sequence Number"
col BWTESTCD type=Char label="Test Short Name"
col BWDY type=Num label="Study Day of Collection"
col BWDTC type=Char label="Date/Time of Collection"
---
S1 | BW | 001 | 1 | BW | 5 | 2020-01-05
S1 | BW | 002 | 2 | BW | 6 | 
S1 | BW | 003 | 3 | BW |  | 2020-01-07
