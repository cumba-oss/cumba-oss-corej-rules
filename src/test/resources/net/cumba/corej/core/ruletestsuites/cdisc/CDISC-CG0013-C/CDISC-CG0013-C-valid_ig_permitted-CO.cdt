#!RuleTest
#test CDISC-CG0013-C expect=noViolation domain=CO
#note "SDTMIG 3.2 CO Assumption 6 permits exactly COGRPID, COREFID, COSPID, VISIT, VISITNUM, VISITDY, TAETORD, CODY, COTPT, COTPTNUM, COELTM, COTPTREF and CORFTDTC. VISITNUM, TAETORD and COTPT are present and none is reported."
#library standard=sdtmig version=3-2
#library model-column-order CO STUDYID DOMAIN RDOMAIN USUBJID COSEQ IDVAR IDVARVAL COREF COVAL COEVAL CODTC
dataset CO
col STUDYID type=Char
col DOMAIN type=Char
col USUBJID type=Char
col COSEQ type=Num
col COVAL type=Char
col VISITNUM type=Num
col TAETORD type=Char
col COTPT type=Char
---
S1 | CO | 001 | 1 | Comment | 1 | 1 | PRE-DOSE
---
