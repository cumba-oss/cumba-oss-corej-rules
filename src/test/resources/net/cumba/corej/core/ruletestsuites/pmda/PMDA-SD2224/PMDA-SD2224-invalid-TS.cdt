#!RuleTest
#test PMDA-SD2224 expect=violation domain=TS
#note "ADAPTED-FROM fda/FDA-SD2224/FDA-SD2224-invalid-TS.cdt. TS with TITLE/SPONSOR/TTYPE records but NO FCNTRY -> $fcntry_count=0 -> one dataset-level finding."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | TITLE   | Trial Title | A Phase 3 Study of Drug X in Subjects With Condition Y
S01 | TS | 2 | SPONSOR | Clinical Study Sponsor | ACME PHARMA
S01 | TS | 3 | TTYPE   | Trial Type | EFFICACY
