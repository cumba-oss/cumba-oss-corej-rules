#!RuleTest
#test PMDA-SD1474 expect=noViolation domain=LB
#note "Every name conformant -> the rule EXECUTES and stays silent; LBTESTCD also pins the 8-character boundary as ACCEPTED."
#library standard=sdtmig version=3-4
#expectViolationCount 0
dataset LB
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col LBSEQ   type=Num
col LBTESTCD type=Char
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | GLUC
