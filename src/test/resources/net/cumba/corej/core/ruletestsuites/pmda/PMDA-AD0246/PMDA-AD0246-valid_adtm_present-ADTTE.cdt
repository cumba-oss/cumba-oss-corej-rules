#!RuleTest
#test PMDA-AD0246 expect=noViolation domain=ADTTE
#note "ADT absent, ADTM present -> not var_exists(ADT) true but not var_exists(ADTM) false -> conjunction fails -> silent. Pins that EITHER date variable satisfies the rule."
#library standard=adamig version=1-3
dataset ADTTE structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col CNSR    type=Num
col ADTM    type=Num
