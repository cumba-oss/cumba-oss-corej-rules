#!RuleTest
#test PMDA-SD9750 expect=noViolation domain=MH
#note "MHBDSYCD column absent, but MHBODSYS is empty on every record: no populated body system needs its code, so nothing is reported."
#library standard=sdtmig version=3-4
dataset MH
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col MHSEQ    type=Num
col MHBODSYS type=Char
---
S1 | MH | 001 | 1 |
---
