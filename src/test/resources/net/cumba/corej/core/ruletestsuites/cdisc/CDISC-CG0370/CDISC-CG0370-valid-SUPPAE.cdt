#!RuleTest
#test CDISC-CG0370 expect=noViolation domain=SUPPAE
# Rule:Description: Raise an error when Identifying Variable (IDVAR) is populated but does not represent a variable present in the dataset referenced by RDOMAIN.
#note "IDVAR=AESEQ is a real column of the RDOMAIN=AE dataset, so no violation"
dataset SUPPAE label="Supplemental Qualifiers for AE"
col STUDYID type=Char label="Study Identifier"
col RDOMAIN type=Char label="Related Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col IDVAR type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
---
CDISCPILOT01 | AE | 01-701-1015 | AESEQ | 1
CDISCPILOT01 | AE | 01-701-1015 | AESEQ | 2
---

dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
---
CDISCPILOT01 | AE | 01-701-1015 | 1
CDISCPILOT01 | AE | 01-701-1015 | 2
---
