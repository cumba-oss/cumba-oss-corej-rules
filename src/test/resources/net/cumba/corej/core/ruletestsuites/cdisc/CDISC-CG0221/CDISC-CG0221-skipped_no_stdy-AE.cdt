#!RuleTest
#test CDISC-CG0221 expect=skipped domain=AE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0221 (Condition: --STDTC or DM.RFSTDTC does not contain complete values in their date portion; Rule: --STDY = null). AESTDY is withheld: Requirements.Variables.All [--STDY, STUDYID, USUBJID] is unmet, so there is no study day to judge and the rule must skip."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col AESEQ    type=Num  label="Sequence Number"
col AETERM   type=Char label="Reported Term for the Adverse Event"
col AESTDTC type=Char label="Start Date/Time of Adverse Event"
---
CDISCPILOT01 | AE | 01-701-1015 | 2 | NAUSEA | 2014-01
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
---
CDISCPILOT01 | DM | 01-701-1015 | 2014-01-02
---
