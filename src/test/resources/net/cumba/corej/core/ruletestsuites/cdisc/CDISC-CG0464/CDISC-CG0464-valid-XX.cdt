#!RuleTest
#test CDISC-CG0464 expect=noViolation domain=XX
#note "XX is class=EVENTS and a custom domain, and it carries its topic variable XXTERM -> no violation. W4b (PLAN-scalar-metadata-functions phase 0, scenarios-first on the pre-port engine)."
#library standard=sdtmig version=3-4
#library custom-domain XX
dataset XX class=EVENTS label="Custom EVENTS"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col XXSEQ   type=Num  label="Sequence Number"
col XXTERM type=Char label="Reported Term"
---
S1 | XX | 001 | 1 | HEADACHE
