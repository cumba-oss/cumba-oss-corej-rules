#!RuleTest
#test CDISC-CG0244 expect=skipped domain=TA
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0244 (Rule: ARM not in ('Screen Failure', 'Not Assigned', 'Unplanned Treatment', 'Not Treated'); Domain: TA, TV). The ARM column is absent; Requirements.Variables.All [ARM] gates the rule to SKIPPED."
#library standard=sdtmig version=3-2
dataset TA class="TRIAL DESIGN" label="Trial Arms"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ARMCD   type=Char label="Planned Arm Code"
col TAETORD type=Num  label="Planned Order of Element within Arm"
col ETCD    type=Char label="Element Code"
col ELEMENT type=Char label="Description of Element"
col EPOCH   type=Char label="Epoch"
---
CDISCPILOT01 | TA | PBO | 1 | SCRN | Screening | SCREENING
---
