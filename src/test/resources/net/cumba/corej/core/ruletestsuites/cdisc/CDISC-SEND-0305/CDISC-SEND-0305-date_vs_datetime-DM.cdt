#!RuleTest
#test CDISC-SEND-0305 expect=noViolation domain=DM
#note "PLAN-scalar-date-extremes: Measured in phase 0 (the investigation's S305 subject 008): own EXSTDTC 2020-01-01 (a date) and pool P7 2020-01-01T08:00 (a datetime) -> earliest_date answers the DATE (its hull starts at 00:00), and date(RFXSTDTC) != that answer is silent for RFXSTDTC 2020-01-01T08:00 (008) and for 2020-01-01 (009): typed date equality holds on the same day. Pin (silent before too)."
#library standard=sendig version=3-1-1
dataset DM label=Demographics
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFXSTDTC type=Char label="Date/Time of First Study Treatment"
---
S1 | DM | 008 | 2020-01-01T08:00
S1 | DM | 009 | 2020-01-01
---
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col POOLID  type=Char label="Pool Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
---
S1 | EX | 008 |  | 1 | DRUG A | 2020-01-01
S1 | EX |  | P7 | 2 | DRUG A | 2020-01-01T08:00
S1 | EX | 009 |  | 3 | DRUG A | 2020-01-01
S1 | EX |  | P8 | 4 | DRUG A | 2020-01-01T08:00
---
dataset POOLDEF label="Pool Definition"
col STUDYID type=Char label="Study Identifier"
col POOLID  type=Char label="Pool Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
---
S1 | P7 | 008
S1 | P8 | 009
---
