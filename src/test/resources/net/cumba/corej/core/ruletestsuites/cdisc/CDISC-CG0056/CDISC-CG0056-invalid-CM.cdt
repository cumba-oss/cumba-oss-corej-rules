#!RuleTest
#test CDISC-CG0056 expect=violation domain=CM
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0056 (Condition: --PRESP not present in dataset; Rule: --STAT not present in dataset). The CM dataset carries CMSTAT but not CMPRESP -> the dataset-level check fires once for the dataset (reported on its first record)."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1
dataset CM class=INTERVENTIONS label="Concomitant Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ   type=Num  label="Sequence Number"
col CMTRT   type=Char label="Reported Name of Drug, Med, or Therapy"
col CMSTAT type=Char label="Completion Status"
---
CDISCPILOT01 | CM | 01-701-1015 | 1 | ASPIRIN |
CDISCPILOT01 | CM | 01-701-1023 | 1 | IBUPROFEN | NOT DONE
