#!RuleTest
#test CDISC-SEND-0269 expect=noViolation domain=BW
#note "Two deliberate near-misses. BWCUSTOM is in NO class table -> conjunct 2 false -> silent here (it is CDISC-SEND-0270's population, and 0270 fires on it; CDISC-SEND-0268 is its parked duplicate). BWLAT is in BW's OWN class table -> conjunct 1 false -> silent. A scenario that fires on either has re-introduced the Fix #292 defect."
#library standard=sendig version=3-0
#library model-column-order      BW STUDYID DOMAIN USUBJID POOLID BWSEQ BWGRPID BWTESTCD BWTEST BWORRES BWORRESU BWSTRESC BWSTRESN BWSTRESU BWSTAT BWREASND BWLAT BWDIR BWDTC BWDY
#library domain-variables        BW STUDYID:Identifier DOMAIN:Identifier USUBJID:Identifier BWSEQ:Identifier BWTESTCD:Topic "BWTEST:Synonym Qualifier" "BWORRES:Result Qualifier" "BWORRESU:Variable Qualifier" "BWSTRESC:Result Qualifier" "BWSTRESN:Result Qualifier" "BWSTRESU:Variable Qualifier" "BWSTAT:Record Qualifier" "BWREASND:Record Qualifier" "BWBLFL:Record Qualifier" "BWFAST:Record Qualifier" BWDTC:Timing BWDY:Timing BWNOMDY:Timing
#library model-class-variables   FINDINGS      --TESTCD:Topic "--TEST:Synonym Qualifier" "--ORRES:Result Qualifier" "--STRESC:Result Qualifier" "--STAT:Record Qualifier" "--REASND:Record Qualifier" "--LAT:Variable Qualifier" "--DIR:Variable Qualifier"
#library model-class-variables   "FINDINGS ABOUT" --TESTCD:Topic "--TEST:Synonym Qualifier" "--OBJ:Record Qualifier" "--ORRES:Result Qualifier"
#library model-class-variables   EVENTS        --TERM:Topic "--DECOD:Synonym Qualifier" "--SEV:Record Qualifier" "--SER:Record Qualifier" "--OUT:Record Qualifier"
#library model-class-variables   INTERVENTIONS --TRT:Topic "--DOSE:Record Qualifier" "--DOSU:Variable Qualifier" "--ROUTE:Variable Qualifier"
dataset BW class=FINDINGS label="Body Weight"
col STUDYID   type=Char label="Study Identifier"
col DOMAIN    type=Char label="Domain Abbreviation"
col USUBJID   type=Char label="Unique Subject Identifier"
col BWSEQ     type=Num  label="Sequence Number"
col BWTESTCD  type=Char label="Body Weight Test Short Name"
col BWORRES   type=Char label="Result or Finding in Original Units"
col BWLAT     type=Char label="Laterality"
col BWCUSTOM  type=Char label="Sponsor Defined Variable"
---
S1 | BW | 001 | 1 | BW | 250 | LEFT | X
