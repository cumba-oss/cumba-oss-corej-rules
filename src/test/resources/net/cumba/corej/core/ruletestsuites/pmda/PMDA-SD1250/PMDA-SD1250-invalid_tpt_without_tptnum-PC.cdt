#!RuleTest
#test PMDA-SD1250 expect=violation domain=PC
#note "Shipped Check var_exists(\"--TPT\") and not var_exists(\"--TPTNUM\") resolves per the EC-36 prefix rule to PCTPT/PCTPTNUM; both leaves are dataset constants -> BroadcastFold -> exactly ONE violation at row=1 regardless of row count."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 nameOnly=PCTPT
dataset PC class=FINDINGS label="Pharmacokinetic Concentrations"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col PCSEQ    type=Num
col PCTESTCD type=Char
col PCTPT    type=Char
---
S1 | PC | 001 | 1 | DRUGA | 1H POST-DOSE
---
