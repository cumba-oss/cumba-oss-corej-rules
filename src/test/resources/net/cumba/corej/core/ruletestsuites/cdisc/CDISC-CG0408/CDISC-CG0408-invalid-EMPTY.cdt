#!RuleTest
#test CDISC-CG0408 expect=violation domain=EMPTY
# Rule:Description: Raise an error when a dataset has no records; a dataset should have at least one record.
#note "Dataset EMPTY declares columns but contains zero records (record_count = 0) -> violation"
#expectViolationCount 1
dataset EMPTY label="A dataset with no records"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
---
