#!RuleTest
#test PMDA-SD2247A expect=violation domain=TS
#note "A blank folds to '', whose date portion is not complete, so the negative form FIRES on it - and it should: SSTDTC is a required trial-summary parameter. The blank value IS pinnable and IS pinned (TSVAL=), the shipped green idiom being fda/FDA-SD2247-invalid_empty_tsval-TS.cdt."
#expectViolationCount 1
#expectViolationAt row=1 TSPARMCD=SSTDTC TSVAL=
#library standard=sdtmig version=3-4
dataset TS label="Trial Summary"
col STUDYID  type=Char
col DOMAIN   type=Char
col TSSEQ    type=Num
col TSPARMCD type=Char
col TSPARM   type=Char
col TSVAL    type=Char
---
CDISCPILOT01 | TS | 1 | SSTDTC  | Study Start Date |
CDISCPILOT01 | TS | 2 | DCUTDTC | Data Cutoff Date | 2020-06-30
