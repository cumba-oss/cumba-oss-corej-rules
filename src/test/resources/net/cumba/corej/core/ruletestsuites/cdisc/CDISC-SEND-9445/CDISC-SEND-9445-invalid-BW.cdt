#!RuleTest
#test CDISC-SEND-9445 expect=violation domain=BW
#note "Rule round 2026-10-12 (owner, batch C item 2): the dataset-sensitivity companion of the --EXCLFL gate on CDISC-SEND-0149 / FDA-SE2354. BWREASEX is populated on rows 1 and 2 and the dataset carries no BWEXCLFL column -> ONE finding for the dataset, not one per record."
#library standard=sendig version=3-1-1
#expectViolationCount 1
dataset BW class=FINDINGS label="Body Weights"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col BWSEQ    type=Num  label="Sequence Number"
col BWTESTCD type=Char label="Test Short Name"
col BWORRES  type=Char label="Result or Findings as Collected"
col BWREASEX type=Char label="Reason for Exclusion"
---
S1 | BW | 001 | 1 | BW | 250 | Fasting not done
S1 | BW | 002 | 2 | BW | 260 | Scale error
S1 | BW | 003 | 3 | BW | 270 |
