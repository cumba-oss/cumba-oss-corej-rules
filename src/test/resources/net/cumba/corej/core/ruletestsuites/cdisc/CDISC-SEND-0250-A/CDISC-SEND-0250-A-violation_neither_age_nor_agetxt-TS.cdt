#!RuleTest
#test CDISC-SEND-0250-A expect=violation domain=TS
#note "The half this R-5.25 split sibling owns: TS carries NEITHER a TSPARMCD 'AGE' record NOR a TSPARMCD 'AGETXT' record; the remedy is to add one - the opposite fix from the parent's both-present half, which is what made this an R-5.25 split. Dataset-level -> exactly 1 finding."
#library standard=sendig version=3-1-1
#expectViolationCount 1
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL    type=Char label="Parameter Value"
---
S1 | TS | 1 | SPECIES | RAT
S1 | TS | 2 | STRAIN  | WISTAR
