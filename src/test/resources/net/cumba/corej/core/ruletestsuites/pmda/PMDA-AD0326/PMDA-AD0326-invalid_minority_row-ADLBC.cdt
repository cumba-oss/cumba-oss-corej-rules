#!RuleTest
#test PMDA-AD0326 expect=violation domain=ADLBC
#note "Group (APERIOD=1, ASPER=1) holds ASPERC {A, A, B} -> minority row 3 fires. The AD0325 fixture with the two subperiod columns' roles swapped. APERIOD is not pinned (finding AD0326-F1)."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=01-701-1034 ASPER=1 ASPERC=B
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col APERIOD type=Num
col ASPER   type=Num
col ASPERC  type=Char
---
CDISCPILOT01 | 01-701-1015 | GLUC | 5.5 | 1 | 1 | A
CDISCPILOT01 | 01-701-1023 | GLUC | 5.6 | 1 | 1 | A
CDISCPILOT01 | 01-701-1034 | GLUC | 5.7 | 1 | 1 | B
