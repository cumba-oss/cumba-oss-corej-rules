#!RuleTest
#test CDISC-CG0073 expect=violation domain=DS
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0073 (Condition: DSCAT = 'PROTOCOL MILESTONE'; Rule: EPOCH = null). Row 2 is a protocol milestone with EPOCH=SCREENING populated -> fires. Row 1 is a milestone with EPOCH null. Row 3 is a DISPOSITION EVENT, which carries an EPOCH legitimately (Condition false), silent."
#library standard=sdtmig version=3-2
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1023 EPOCH=SCREENING
dataset DS class=EVENTS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSTERM  type=Char label="Reported Term for the Disposition Event"
col DSDECOD type=Char label="Standardized Disposition Term"
col DSCAT   type=Char label="Category for Disposition Event"
col EPOCH   type=Char label="Epoch"
---
CDISCPILOT01 | DS | 01-701-1015 | 1 | INFORMED CONSENT OBTAINED | INFORMED CONSENT OBTAINED | PROTOCOL MILESTONE |
CDISCPILOT01 | DS | 01-701-1023 | 1 | INFORMED CONSENT OBTAINED | INFORMED CONSENT OBTAINED | PROTOCOL MILESTONE | SCREENING
CDISCPILOT01 | DS | 01-701-1023 | 2 | COMPLETED | COMPLETED | DISPOSITION EVENT | TREATMENT
