#!RuleTest
#test PMDA-AD0018 expect=noViolation domain=ADLBC
#note "PMDA AD0018 (PLAN-library-template-label-resolution): the column is spelled CRITy - the template itself - and resolves to the Library's CRITy as a literal hit; a template-spelled column names no concrete variable and has no label template, so the rule's not empty(label_template(\"LIBRARY\")) guard keeps it out whatever its label -> silent. A real instance, CRIT1, would be checked against 'Analysis Criterion 1 ...' (see -valid_y_tail for the y-tail rule). PARAMCD is the positive control."
#library standard=adamig version=1-3
#library variable-metadata ADLBC CRITy name=CRITy label="Analysis Criterion y"
#expectViolationCount 0
dataset ADLBC structure=BDS
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col PARAMCD type=Char label="Parameter Code"
col CRITy   type=Char label="Wrong Label"
---
CDISCPILOT01 | 01-701-1015 | ALT | AGE-GT-60
