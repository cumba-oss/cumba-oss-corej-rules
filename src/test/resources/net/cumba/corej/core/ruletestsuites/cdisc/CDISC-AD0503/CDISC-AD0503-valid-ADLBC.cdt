#!RuleTest
#test CDISC-AD0503 expect=noViolation domain=ADLBC
#library standard=adamig version=1-3
#library variable-metadata ADLBC *DT name=*DT label="{Date}"
# Rule:Description: A variable ending in DT must contain "Date" in the label
#note "XDT label contains "Date" -> noViolation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col XDT type=Char label="Analysis Date"
---
CDISCPILOT01 | 01-701-1015 | ALB | x
