#!RuleTest
#test CDISC-CG0208 expect=noViolation domain=SE
# Rule:Description: Raise an error when Start Date/Time of Element (SESTDTC) is not populated.
#note "every SESTDTC is populated"
dataset SE label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ type=Num label="Sequence Number"
col SESTDTC type=Char label="Start Date/Time of Element"
---
CDISCPILOT01 | SE | 01-701-1015 | 1 | 2013-12-26
CDISCPILOT01 | SE | 01-701-1015 | 2 | 2014-01-02
CDISCPILOT01 | SE | 01-701-1023 | 1 | 2013-02-18
