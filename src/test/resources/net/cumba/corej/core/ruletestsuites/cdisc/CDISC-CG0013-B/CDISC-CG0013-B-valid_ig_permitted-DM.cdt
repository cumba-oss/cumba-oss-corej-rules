#!RuleTest
#test CDISC-CG0013-B expect=noViolation domain=DM
#note "DM Assumption 8: only VISITNUM, VISIT and VISITDY (Timing) and DMXFN (Record Qualifier) may be added to DM. All four are present and none is reported."
#library standard=sdtmig version=3-4
#library model-column-order DM STUDYID DOMAIN USUBJID SUBJID RFSTDTC SITEID AGE SEX ARMCD ARM COUNTRY
dataset DM
col STUDYID type=Char
col DOMAIN type=Char
col USUBJID type=Char
col SUBJID type=Char
col SITEID type=Char
col VISITNUM type=Num
col VISIT type=Char
col VISITDY type=Num
col DMXFN type=Char
---
S1 | DM | 001 | 001 | 01 | 1 | SCREENING | -7 | narr001.pdf
---
