#!RuleTest
#test CDISC-CG0425 expect=noViolation domain=LB
#note "Units are applicable only when the original result carries a unit (owner, 2026-10-02: --ORRESU populated). Urinalysis pH and specific gravity and a dipstick grade are numeric but unitless in the original (LBORRESU empty), so an empty LBSTRESU is correct and nothing fires. This is the shape that produced thousands of false findings on the PhUSE pilot data (LBUR, and every QS score) before the --ORRESU condition."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBSTRESC type=Char label="Character Result/Finding in Std Format"
col LBSTRESU type=Char label="Standard Units"
col LBORRESU type=Char label="Original Units"
---
S1 | LB | 001 | 1 | PH      | 6.5   | |
S1 | LB | 001 | 2 | SPGRAV  | 1.015 | |
S1 | LB | 001 | 3 | KETONES | 0     | |
---
