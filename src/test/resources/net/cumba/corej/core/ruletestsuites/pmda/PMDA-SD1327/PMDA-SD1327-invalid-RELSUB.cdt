#!RuleTest
#test PMDA-SD1327 expect=violation domain=RELSUB
#note "Row 2 relates the pool to itself: RSUBJID repeats POOLID 'POOL02' -> fires."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 RSUBJID=POOL02
dataset RELSUB label="Related Subjects"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col POOLID  type=Char label="Pool Identifier"
col RSUBJID type=Char label="Related Subject or Pool Identifier"
col SREL    type=Char label="Subject Relationship"
---
CDISCPILOT01 |  | POOL01 | 01-701-1015 | LITTERMATE
CDISCPILOT01 |  | POOL02 | POOL02      | LITTERMATE
