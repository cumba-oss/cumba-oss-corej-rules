#!RuleTest
#test PMDA-SD1339 expect=violation domain=AE
#note "Row 1: start date populated, EPOCH empty -> fires. Row 2: EPOCH populated -> clean. Row 3: no date -> second conjunct false -> clean."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 AESEQ=1
dataset AE class=EVENTS
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col AESEQ   type=Num
col AETERM  type=Char
col AESTDTC type=Char
col EPOCH   type=Char
---
S1 | AE | 001 | 1 | HEADACHE | 2020-06-01 |
S1 | AE | 001 | 2 | NAUSEA   | 2020-06-02 | TREATMENT
S1 | AE | 001 | 3 | RASH     |            |
