#!RuleTest
#test FDA-SD1350 expect=skipped domain=PP
#note "PPENINT column absent while PPSTINT is populated. Requirements.Variables.All [--STINT, --ENINT] gates the rule out -> auditable skip instead of one finding per row under absent = all-missing (EC-43). Row 1 WOULD fire were the gate removed. Verdict 2-1': FDA-SD1450 reports the absence itself."
#library standard=sdtmig version=3-4
dataset PP class=FINDINGS label="Pharmacokinetic Parameters"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PPSEQ    type=Num  label="Sequence Number"
col PPTESTCD type=Char label="Parameter Short Name"
col PPSTRESC type=Char label="Character Result/Finding in Std Format"
col PPSTINT  type=Char label="Planned Start of Assessment Interval"
---
S1 | PP | 001 | 1 | AUCALL | 120.5 | P0D
