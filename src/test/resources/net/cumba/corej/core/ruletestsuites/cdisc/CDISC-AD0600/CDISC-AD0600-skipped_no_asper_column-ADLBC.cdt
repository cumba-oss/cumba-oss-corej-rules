#!RuleTest
#test CDISC-AD0600 expect=skipped domain=ADLBC
#note "PLAN-join-key-authoring-gate phase 4: ADLBC has no ASPER column: with APERIOD it drives the constructed ADSL.P${APERIOD:%02d}S${ASPER:%d}SDM name and is declared in Requirements.Variables.All (§3b.4), so the rule skips."
#define standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col APERIOD type=Num
col ASPRSDTM type=Num
---
CDISCPILOT01 | 01-701-1015 | 1 | 21950
---

dataset ADSL label="Subject-Level Analysis"
col STUDYID type=Char
col USUBJID type=Char
col P01S1SDM type=Num
col P01S2SDM type=Num
