#!RuleTest
#test CDISC-SEND-0236.1 expect=noViolation domain=TX
#note "Authority: SEND Conformance Rules v5.0 SEND236.1 (SENDIG 3.0-3.1.1, DART 1.1/1.2, GENETOX 1.0; scenario at SENDIG 3.1.1), Condition \"TXPARMCD = ARMCD\", Rule \"TXVAL is present in the TA.ARMCD\". Both TXPARMCD=ARMCD records carry a TXVAL that is a TA.ARMCD (1, 2). The SPECIES / SPGRPCD records are outside the Condition, so their TXVALs (RAT, 1) are not compared -> silent."
#library standard=sendig version=3-1-1
#expectViolationCount 0
dataset TX label="Trial Sets"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col SETCD    type=Char label="Set Code"
col SET      type=Char label="Set Description"
col TXSEQ    type=Num  label="Sequence Number"
col TXPARMCD type=Char label="Trial Set Parameter Short Name"
col TXPARM   type=Char label="Trial Set Parameter"
col TXVAL    type=Char label="Trial Set Parameter Value"
---
S1 | TX | C1 | Control   | 1 | ARMCD   | Planned Arm Code           | 1
S1 | TX | C1 | Control   | 2 | SPGRPCD | Sponsor-Defined Group Code | 1
S1 | TX | C1 | Control   | 3 | SPECIES | Species                    | RAT
S1 | TX | H1 | High Dose | 4 | ARMCD   | Planned Arm Code           | 2
---

dataset TA label="Trial Arms"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
col TAETORD type=Num  label="Order of Element within Arm"
col ETCD    type=Char label="Element Code"
col ELEMENT type=Char label="Description of Element"
---
S1 | TA | 1 | Control   | 1 | SCRN | Screening
S1 | TA | 1 | Control   | 2 | CTRL | Vehicle Control
S1 | TA | 2 | High Dose | 1 | SCRN | Screening
S1 | TA | 2 | High Dose | 2 | HD   | 100 mg/kg
---
