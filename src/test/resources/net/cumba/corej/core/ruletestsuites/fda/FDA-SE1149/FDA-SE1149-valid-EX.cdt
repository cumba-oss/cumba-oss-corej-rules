#!RuleTest
#test FDA-SE1149 expect=noViolation domain=EX
#note "TS declares EXPENDTC=2020-06-30. Row 1: EXSTDTC before the experimental end -> clean. Row 2: equal to the experimental end (rule is strictly later-than, boundary clean). Row 3: EXSTDTC empty -> guarded out by non_empty."
#library standard=sendig version=3-1-1
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
---
S1 | EX | 001 | 1 | DRUG A | 2020-01-15
S1 | EX | 001 | 2 | DRUG A | 2020-06-30
S1 | EX | 002 | 1 | DRUG A |
---

dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL    type=Char label="Parameter Value"
---
S1 | TS | 1 | EXPENDTC | 2020-06-30
S1 | TS | 1 | SSPONSOR | ACME LABS
