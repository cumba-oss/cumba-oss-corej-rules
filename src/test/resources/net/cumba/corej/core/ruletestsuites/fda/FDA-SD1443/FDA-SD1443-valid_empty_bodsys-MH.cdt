#!RuleTest
#test FDA-SD1443 expect=noViolation domain=MH
#note "Boundary: one 'ASTHMA' record leaves --BODSYS empty while the others agree. An empty --BODSYS is not a competing value, so no inconsistency is reported."
#library standard=sdtmig version=3-4
dataset MH class=EVENTS label="Medical History"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col MHSEQ    type=Num  label="Sequence Number"
col MHTERM   type=Char label="Reported Term for the Medical History"
col MHDECOD  type=Char label="Dictionary-Derived Term"
col MHBODSYS type=Char label="Body System or Organ Class"
---
S1 | MH | 001 | 1 | ASTHMA | Asthma | Respiratory, thoracic and mediastinal disorders
S1 | MH | 002 | 1 | ASTHMA | Asthma |
S1 | MH | 003 | 1 | ASTHMA | Asthma | Respiratory, thoracic and mediastinal disorders
