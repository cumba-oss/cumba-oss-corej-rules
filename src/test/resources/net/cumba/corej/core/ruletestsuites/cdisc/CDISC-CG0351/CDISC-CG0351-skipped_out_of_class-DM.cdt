#!RuleTest
#test CDISC-CG0351 expect=skipped domain=DM
#note "Scope boundary (round 2026-10-02 c close): Scope.Classes.Include is EVENTS, FINDINGS and INTERVENTIONS, so DM (SPECIAL PURPOSE) is out of scope -> skipped. Both lists are served and DMCUSTOM is in neither, so the check would report it if the Classes scope were dropped."
#library standard=sdtmig version=3-3
#library dataset-class DM "SPECIAL PURPOSE"
#library model-column-order DM STUDYID DOMAIN USUBJID SUBJID RFSTDTC SITEID AGE SEX ARMCD ARM COUNTRY
#library domain-variables DM STUDYID:Identifier DOMAIN:Identifier USUBJID:Identifier SUBJID:Topic RFSTDTC:Timing "SITEID:Record Qualifier" "AGE:Record Qualifier" "SEX:Record Qualifier" "ARMCD:Record Qualifier" "ARM:Synonym Qualifier" "COUNTRY:Record Qualifier" "ARMNRS:Record Qualifier"
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SUBJID   type=Char label="Subject Identifier for the Study"
col SITEID   type=Char label="Study Site Identifier"
col DMCUSTOM type=Char label="Sponsor Defined Variable"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015 | 701 | X
---
