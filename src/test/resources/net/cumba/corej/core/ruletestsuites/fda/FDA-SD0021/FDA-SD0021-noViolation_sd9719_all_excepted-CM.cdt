#!RuleTest
#test FDA-SD0021 expect=noViolation domain=CM
#note "No end-point column exists (None satisfied), so the sister RUNS - but every record is excepted: row 1 CMOCCUR='N', row 2 a populated CMSTAT. The remaining condition --OCCUR != 'N' and empty(--STAT) holds nowhere, so the sister stays silent. R-4.11c containment: the parent would not fire on this dataset either."
#library standard=sdtmig version=3-4
dataset CM class=INTERVENTIONS label="Concomitant Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ   type=Num  label="Sequence Number"
col CMTRT   type=Char label="Reported Name of Drug, Med, or Therapy"
col CMOCCUR type=Char label="CM Occurrence"
col CMSTAT  type=Char label="Completion Status"
---
S1 | CM | 001 | 1 | ASPIRIN   | N |
S1 | CM | 001 | 2 | IBUPROFEN |   | NOT DONE
