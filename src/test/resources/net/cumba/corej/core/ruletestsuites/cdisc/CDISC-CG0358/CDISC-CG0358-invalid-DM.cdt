#!RuleTest
#test CDISC-CG0358 expect=violation domain=DM
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0358 (Domain DM, Variable SBSTRAIN; Rule: SBSTRAIN not present in dataset). SBSTRAIN is a non-clinical (SEND) variable and must not be used in the human-clinical DM domain. This DM dataset carries a SBSTRAIN column, so the presence check fires once for the dataset (regardless of the column's values: row 1 is populated, row 2 is not); the finding lists SBSTRAIN by name, with no value."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt nameOnly=SBSTRAIN
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col SEX     type=Char label="Sex"
col SBSTRAIN type=Char label="Strain/Substrain Details"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015 | F | NOT APPLICABLE
CDISCPILOT01 | DM | 01-701-1023 | 1023 | M | 
---
