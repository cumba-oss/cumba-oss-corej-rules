#!RuleTest
#test CDISC-CG0149 expect=violation domain=DM
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0149 (Rule: SETCD value length <= 8). Row 2: SETCD=HIGHDOSE01 is 10 characters -> fires. Row 1: SETCD=LOWDOSE1 is exactly 8 characters, at the limit, silent."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 SETCD=HIGHDOSE01
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARMCD    type=Char label="Planned Arm Code"
col SETCD    type=Char label="Set Code"
---
CDISCPILOT01 | DM | 01-701-1015 | XANLO | LOWDOSE1
CDISCPILOT01 | DM | 01-701-1023 | XANHI | HIGHDOSE01
