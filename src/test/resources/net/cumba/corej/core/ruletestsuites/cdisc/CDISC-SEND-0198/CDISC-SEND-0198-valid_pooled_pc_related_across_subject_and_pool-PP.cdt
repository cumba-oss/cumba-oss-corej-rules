#!RuleTest
#test CDISC-SEND-0198 expect=noViolation domain=PP
# Rule:Description: Raise an error when the Date/Time of Reference Point (PPRFTDTC) in the Pharmacokinetics Parameters (PP) domain does not equal the Date/Time of Reference Point (PCRFTDTC) of a related Pharmacokinetics Concentrations (PC) record.
#note "PLAN-merged-evaluation-table W5 (OD-3): the same cross-subject SEND relationship with an equal PCRFTDTC — the pair forms and the rule has nothing to report."

dataset PP label="Pharmacokinetics Parameters"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col POOLID type=Char label="Pool Identifier"
col PPSEQ type=Num label="Sequence Number"
col PPTESTCD type=Char label="Parameter Short Name"
col PPRFTDTC type=Char label="Date/Time of Reference Point"
---
S1 | PP | A1 |  | 1 | AUC | 2024-01-01T08:00
---

dataset PC label="Pharmacokinetics Concentrations"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col POOLID type=Char label="Pool Identifier"
col PCSEQ type=Num label="Sequence Number"
col PCTESTCD type=Char label="Test Short Name"
col PCRFTDTC type=Char label="Date/Time of Reference Point"
---
S1 | PC |  | P1 | 1 | CONC | 2024-01-01T08:00
---

dataset RELREC label="Related Records"
col STUDYID type=Char label="Study Identifier"
col RDOMAIN type=Char label="Related Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col POOLID type=Char label="Pool Identifier"
col IDVAR type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col RELID type=Char label="Relationship Identifier"
---
S1 | PP | A1 |  | PPSEQ | 1 | R1
S1 | PC |  | P1 | PCSEQ | 1 | R1
---
