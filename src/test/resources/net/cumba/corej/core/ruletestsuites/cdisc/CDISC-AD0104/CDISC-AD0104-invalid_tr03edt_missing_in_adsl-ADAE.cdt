#!RuleTest
#test CDISC-AD0104 expect=violation domain=ADAE
#note "PLAN-dynamic-column-corpus-respelling §6.2, the first CDISC-AD0104 scenarios (column ABSENT): ADSL carries TR02EDT only. Row 1 (APERIOD=2) finds ADSL.TR02EDT; row 2 (APERIOD=3) names ADSL.TR03EDT, which ADSL does not carry -> fires on row 2 only."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=S1 APERIOD=3
dataset ADAE
col STUDYID type=Char
col USUBJID type=Char
col APERIOD type=Num
col AETERM  type=Char
---
STUDY1 | S1 | 2 | AE1
STUDY1 | S1 | 3 | AE1
---

dataset ADSL label="Subject-Level Analysis"
col STUDYID type=Char
col USUBJID type=Char
col TR02EDT type=Date
---
STUDY1 | S1 | 2024-03-01
---
