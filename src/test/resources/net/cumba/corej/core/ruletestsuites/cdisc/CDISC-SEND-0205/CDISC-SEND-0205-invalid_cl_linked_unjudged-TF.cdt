#!RuleTest
#test CDISC-SEND-0205 expect=violation domain=TF
#note "PLAN-send-tfdetect-pathology-unpark: Row 1 (001, M1) is a CL clinical sign and in no PM or MA record (CL is its ONLY link) -> detected in life, CDISC-SEND-0202's case, NOT judged here though TFDETECT 50 is wrong, and the silence is owed to the CL test alone (review M1: row 1 was MA-linked too, so the MA test silenced it and the CL test was untested). Row 2 (002, M2) is linked to no CL, PM or MA record -> REPORTED. Near-misses: CL holds M2 for subject 001, which must not link subject 002's M2 (the link is per subject); subject 003 IS in CL, but under another CLSPID (M8), so its M3 is not CL-linked and is still judged -> REPORTED (the link is per mass, not per subject; review L1). Red-before (review fix, TF-2): with the 'not in $cl_masses' term deleted, row 1 fired (3 findings, expected 2); with the CL link read per subject only (USUBJID not in a CL subject set) row 3 went silent (fired 1, expected 2). When first written (TF-1) the rule was parked (Executability Not Executable), so the scenario failed with the rule not a member of the sendig 3.1.1 package."
#library standard=sendig version=3-1-1
#expectViolationCount 2
#expectViolationAt row=2 TFSPID=M2
#expectViolationAt row=3 TFSPID=M3
dataset TF class=FINDINGS label="Tumor Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col TFSEQ    type=Num  label="Sequence Number"
col TFSPID   type=Char label="Sponsor-Defined Identifier"
col TFTESTCD type=Char label="Tumor Findings Test Short Name"
col TFDETECT type=Num  label="Time in Days to Detection of Tumor"
---
S1 | TF | 001 | 1 | M1 | TUMEXAM | 50
S1 | TF | 002 | 2 | M2 | TUMEXAM | 50
S1 | TF | 003 | 3 | M3 | TUMEXAM | 50
---
dataset DS class=EVENTS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSTERM  type=Char label="Reported Term for the Disposition Event"
col DSDECOD type=Char label="Standardized Disposition Term"
col DSSTDTC type=Char label="Date/Time of Disposition"
---
S1 | DS | 001 | 1 | TERMINAL SACRIFICE | TERMINAL SACRIFICE | 2020-04-09
S1 | DS | 002 | 1 | TERMINAL SACRIFICE | TERMINAL SACRIFICE | 2020-04-09
S1 | DS | 003 | 1 | TERMINAL SACRIFICE | TERMINAL SACRIFICE | 2020-04-09
---
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
---
S1 | EX | 001 | 1 | DRUG A | 2020-01-01
S1 | EX | 002 | 2 | DRUG A | 2020-01-01
S1 | EX | 003 | 3 | DRUG A | 2020-01-01
---
dataset MA class=FINDINGS label="Macroscopic Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col MASEQ    type=Num  label="Sequence Number"
col MASPID   type=Char label="Sponsor-Defined Identifier"
col MATESTCD type=Char label="Macroscopic Examination Short Name"
col MAORRES  type=Char label="Result or Finding in Original Units"
---
S1 | MA | 001 | 1 | M9 | GROSPATH | MASS
S1 | MA | 002 | 2 | M9 | GROSPATH | MASS
---
dataset CL class=FINDINGS label="Clinical Observations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col CLSEQ    type=Num  label="Sequence Number"
col CLSPID   type=Char label="Sponsor-Defined Identifier"
col CLTESTCD type=Char label="Clinical Observations Short Name"
col CLORRES  type=Char label="Result or Finding in Original Units"
col CLDTC    type=Char label="Date/Time of Observation"
---
S1 | CL | 001 | 1 | M1 | CLSIGN | MASS | 2020-02-19
S1 | CL | 001 | 2 | M2 | CLSIGN | MASS | 2020-02-19
S1 | CL | 003 | 3 | M8 | CLSIGN | MASS | 2020-02-19
---
