#!RuleTest
#test CDISC-AD0313 expect=violation domain=ADAE
# Rule:Description: SMQzzSCN is not equal to 1 or 2, where zz is a zero-padded two-digit integer [01-99]
#note "SMQ01SCN=3 is non-empty and not in the allowed numeric set -> violation"
#expectViolationCount 1
#expectViolationAt row=1
# Declared-tier scope: the class= declaration disagrees with the columns, so #define must
# carry it to RuleRunner (ScenarioDeclaredScopeProvider.install).
#define standard=adamig version=1-3
dataset ADAE class=OCCDS
col STUDYID type=Char
col USUBJID type=Char
col ASEQ type=Num
col SMQ01SCN type=Num
---
CDISCPILOT01 | 01-701-1015 | 1 | 3
---
