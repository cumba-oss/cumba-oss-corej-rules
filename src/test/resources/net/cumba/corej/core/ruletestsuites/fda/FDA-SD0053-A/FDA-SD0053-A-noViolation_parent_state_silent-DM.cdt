#!RuleTest
#test FDA-SD0053-A expect=noViolation domain=DM
#note "THE DISCRIMINATOR OF THE SPLIT: this is the PARENT FDA-SD0053's violating dataset (row 1 has ARMCD='NOTASSGN' with the wrong ARM text) and this sibling must stay silent on it - its own half needs ARM to equal 'Not Assigned' exactly, which no row here does. Executes without firing."
#library standard=sdtmig version=3-2
dataset DM
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
---
S1 | DM | 001 | NOTASSGN | Not assigned to arm
S1 | DM | 002 | NOTASSGN | Not Assigned
S1 | DM | 003 | A        | Placebo
