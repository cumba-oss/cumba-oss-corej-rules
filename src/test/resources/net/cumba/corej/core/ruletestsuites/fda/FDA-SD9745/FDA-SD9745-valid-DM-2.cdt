#!RuleTest
#test FDA-SD9745 expect=noViolation domain=DM
# Rule:Description: Raise an error when the trial is interventional (TS.TSPARMCD equals 'STYPE' and TS.TSVAL equals 'INTERVENTIONAL'), the subject has no record in the EX dataset, and ARMNRS is empty or equals 'UNPLANNED TREATMENT'.
#note "STYPE guard false: subject 01-701-1057 has no EX record but the study is OBSERVATIONAL, so neither any-branch fires"
#library standard=sdtmig version=3-4
dataset DM label=Demographics
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col ARMNRS type=Char label="Reason Arm and/or Actual Arm is Null"
---
CDISCPILOT01 | DM | 01-701-1015 |
CDISCPILOT01 | DM | 01-701-1057 |
---

dataset TS label="Trial Summary"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL type=Char label="Parameter Value"
---
CDISCPILOT01 | TS | STYPE | OBSERVATIONAL
---

dataset EX label=Exposure
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | EX | 01-701-1015
---
