#!RuleTest
#test CDISC-SEND-0333 expect=violation domain=PP
#note "S5 (tuple) + numeric scenario. Authority: SEND Conformance Rules v5.0 SEND333 (Condition: PC records contribute to a single time concentration profile in PP; Rule: PCNOMDY & PCTPTREF = PPNOMDY & PPTPTREF). Partially Executable (underreporting): the Check tests the PP pair against the study-wide set of PC pairs, not against the pair of that profile own PC records; here every silent PP row pairs with its OWN subject profile, so the unchecked association is not violated (plan §2.4). PCNOMDY / PPNOMDY are declared Num. PC holds the pairs (-1, Day -1 Predose), (1, Day 1 Dose) and (7, Day 7 Dose) (the last for S1-002 and S1-003). Rows 1-2 are S1-001's own pairs, row 1 with the NEGATIVE nominal day -1 -> silent. Row 3 (S1-002: 7, Day 1 Dose) and row 4 (S1-003: -1, Day 7 Dose) each belong to a subject with exactly ONE PP profile and ONE contributing PC profile carrying a different pair, so the Condition holds; each uses a PPNOMDY and a PPTPTREF that EXIST in PC separately, but the PAIR is in no PC record -> both fire. Catches a port that tests the components independently (rows 3-4 would fall silent), and one that renders or compares the negative day through different paths for the PP value and the PC tuple members (asymmetric rendering: row 1 would fire). PCNOMDY and PPNOMDY are both Num, so both sides load -1 as the identical double: this scenario does NOT test text-vs-number spelling, which a .cdt cannot express."
#library standard=sendig version=3-1-1
#expectViolationCount 2
#expectViolationAt row=3 USUBJID=S1-002 PPNOMDY=7 PPTPTREF="Day 1 Dose"
#expectViolationAt row=4 USUBJID=S1-003 PPNOMDY=-1 PPTPTREF="Day 7 Dose"
dataset PP class=FINDINGS label="Pharmacokinetics Parameters"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PPSEQ    type=Num  label="Sequence Number"
col PPTESTCD type=Char label="Parameter Short Name"
col PPNOMDY  type=Num  label="Nominal Study Day for Tabulations"
col PPTPTREF type=Char label="Time Point Reference"
---
S1 | PP | S1-001 | 1 | CMAX | -1 | Day -1 Predose
S1 | PP | S1-001 | 2 | CMAX | 1  | Day 1 Dose
S1 | PP | S1-002 | 1 | CMAX | 7  | Day 1 Dose
S1 | PP | S1-003 | 1 | CMAX | -1 | Day 7 Dose
---

dataset PC class=FINDINGS label="Pharmacokinetics Concentrations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PCSEQ    type=Num  label="Sequence Number"
col PCTESTCD type=Char label="Test Short Name"
col PCNOMDY  type=Num  label="Nominal Study Day for Tabulations"
col PCTPTREF type=Char label="Time Point Reference"
col PCTPTNUM type=Num  label="Planned Time Point Number"
---
S1 | PC | S1-001 | 1 | DRUGX | -1 | Day -1 Predose | 1
S1 | PC | S1-001 | 2 | DRUGX | 1  | Day 1 Dose     | 1
S1 | PC | S1-002 | 1 | DRUGX | 7  | Day 7 Dose     | 1
S1 | PC | S1-003 | 1 | DRUGX | 7  | Day 7 Dose     | 1
---
