#!RuleTest
#test CDISC-CG0345 expect=violation domain=CM
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0345 (Class INT, Domain ALL; Rule: --TRT ^= 'MULTIPLE'). Row 2 records CMTRT=MULTIPLE, a placeholder rather than the name of a treatment -> fires. Rows 1 and 3 name real medications (row 3's text merely contains the word) and must stay silent."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1015 CMSEQ=2 CMTRT=MULTIPLE
dataset CM class=INTERVENTIONS label="Concomitant/Prior Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ   type=Num  label="Sequence Number"
col CMTRT   type=Char label="Reported Name of Drug, Med, or Therapy"
col CMDECOD type=Char label="Standardized Medication Name"
---
CDISCPILOT01 | CM | 01-701-1015 | 1 | ASPIRIN | ACETYLSALICYLIC ACID
CDISCPILOT01 | CM | 01-701-1015 | 2 | MULTIPLE |
CDISCPILOT01 | CM | 01-701-1023 | 1 | MULTIPLE VITAMINS PRODUCT | VITAMINS NOS
---
