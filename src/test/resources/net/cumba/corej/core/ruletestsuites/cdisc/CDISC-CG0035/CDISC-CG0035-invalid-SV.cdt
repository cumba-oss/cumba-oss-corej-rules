#!RuleTest
#test CDISC-CG0035 expect=violation domain=SV
# Rule:Description: Raise an error when VISITNUM is present in TV.VISITNUM but VISIT and VISITNUM do not have a one-to-one relationship.
#note "VISITNUM=1 (present in TV) maps to two different VISIT names, breaking the one-to-one relationship, so the rule fires"
#expectViolationCount 2
#expectViolationAt row=1 SVSEQ=1 USUBJID=01-701-1015
#expectViolationAt row=2 SVSEQ=1 USUBJID=01-701-1023
dataset SV label="Subject Visits"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SVSEQ type=Num label="Sequence Number"
col VISITNUM type=Num label="Visit Number" format=VISITNUM.
col VISIT type=Char label="Visit Name" format=$VISIT.
---
CDISCPILOT01 | SV | 01-701-1015 | 1 | 1 | SCREENING 1
CDISCPILOT01 | SV | 01-701-1023 | 1 | 1 | BASELINE
---

dataset TV label="Trial Visits"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col VISITNUM type=Num label="Visit Number" format=VISITNUM.
col VISIT type=Char label="Visit Name" format=$VISIT.
---
CDISCPILOT01 | TV | 1 | SCREENING 1
CDISCPILOT01 | TV | 2 | SCREENING 2
---
