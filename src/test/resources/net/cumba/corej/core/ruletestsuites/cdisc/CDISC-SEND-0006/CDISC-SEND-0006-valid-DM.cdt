#!RuleTest
#test CDISC-SEND-0006 expect=noViolation domain=DM
#note "As invalid but AGEU label=Age Unit - all define-declared labels agree with the dataset labels."
#library standard=sendig version=3-1-1
#define variable-metadata DM AGEU name=AGEU label="Age Unit"
#define variable-metadata DM SEX  name=SEX  label="Sex"
dataset DM
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col AGEU    type=Char label="Age Unit"
col SEX     type=Char label="Sex"
---
S1 | S1-001 | WEEKS | M
