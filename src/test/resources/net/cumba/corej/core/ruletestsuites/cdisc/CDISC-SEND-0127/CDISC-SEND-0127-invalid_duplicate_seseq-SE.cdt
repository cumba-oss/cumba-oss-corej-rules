#!RuleTest
#test CDISC-SEND-0127 expect=violation domain=SE
#note "PLAN-function-surface-wave1 D-W1-2, tie population (b): the source SE carries SESEQ=2 twice for subject 001 (no join expansion; DS is 1:1). Both rows hold the group's maximum ordering value, so both are the last Element, and both SEENDTC values differ from DSSTDTC 2020-01-15: TWO findings. Pre-port (measured at the go) the tie collapsed to one result key and both rows read false: ZERO findings."
#library standard=sendig version=3-0
#expectViolationCount 2
dataset SE label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ   type=Num  label="Sequence Number"
col ETCD    type=Char label="Element Code"
col SESTDTC type=Char label="Start Date/Time of Element"
col SEENDTC type=Char label="End Date/Time of Element"
---
S1 | SE | 001 | 1 | SCRN | 2020-01-01 | 2020-01-10
S1 | SE | 001 | 2 | TRT | 2020-01-10 | 2020-01-20
S1 | SE | 001 | 2 | FU | 2020-01-20 | 2020-01-22
---

dataset DS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSDECOD type=Char label="Standardized Disposition Term"
col DSSTDTC type=Char label="Start Date/Time of Disposition Event"
---
S1 | DS | 001 | 1 | TERMINAL SACRIFICE | 2020-01-15
---
