#!RuleTest
#test CDISC-CG0628 expect=noViolation domain=LB
# Rule:Description: Raise an error when --EXCLFL is present in a Findings dataset, since --EXCLFL is not permitted in human clinical trials.
#note "LBEXCLFL column is absent from an otherwise normal LB dataset, so the rule does not fire"
dataset LB label="Laboratory Tests Results"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col LBSEQ type=Num label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALP
---
