#!RuleTest
#test FDA-SD0058 expect=skipped domain=DM
#note "DM is out of FDA-SD0058 scope since 2026-10-02 (Domains.Exclude): DM Assumption 8 grants VISITNUM, VISIT, VISITDY and DMXFN, so DM is checked by the split sibling FDA-SD0058-B. VISITNUM here is not in the DM model list and would be reported if the DM exclusion were dropped."
#library standard=sdtmig version=3-4
#library model-column-order DM STUDYID DOMAIN USUBJID SUBJID RFSTDTC SITEID AGE SEX ARMCD ARM COUNTRY
dataset DM
col STUDYID type=Char
col DOMAIN type=Char
col USUBJID type=Char
col SUBJID type=Char
col SITEID type=Char
col VISITNUM type=Num
---
S1 | DM | 001 | 001 | 01 | 1
---
