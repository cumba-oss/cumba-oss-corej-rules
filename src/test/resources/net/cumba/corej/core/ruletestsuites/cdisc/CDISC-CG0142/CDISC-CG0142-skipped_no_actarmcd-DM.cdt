#!RuleTest
#test CDISC-CG0142 expect=skipped domain=DM
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0142 (Condition: ACTARM not in ('Screen Failure', 'Not Assigned', 'Not Treated'); Rule: RFENDTC ^= null). ACTARMCD is withheld: Requirements.Variables.All [ACTARMCD] is unmet, so randomized subjects cannot be told from screen failures -> skip."
#library standard=sdtmig version=3-2
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFENDTC  type=Char label="Subject Reference End Date/Time"
---
CDISCPILOT01 | DM | 01-701-1023 |
