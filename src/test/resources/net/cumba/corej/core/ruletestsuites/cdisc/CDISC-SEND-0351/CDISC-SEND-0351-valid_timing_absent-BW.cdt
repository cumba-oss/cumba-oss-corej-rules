#!RuleTest
#test CDISC-SEND-0351 expect=noViolation domain=BW
#note "None of the six repro-phase timing variables is in the dataset (rule round 2026-10-12, var_exists sweep): every `not empty(X)` disjunct is false on an absent column, so the empty RPHASE is not reported."
#library standard=sendig-dart version=1-2
dataset BW class=FINDINGS label="Body Weights"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col BWSEQ    type=Num  label="Sequence Number"
col BWTESTCD type=Char label="Test Short Name"
col RPHASE   type=Char label="Repro Phase"
---
S1 | BW | 001 | 1 | BW |
S1 | BW | 001 | 2 | BW |
