#!RuleTest
#test CDISC-SEND-0250 expect=noViolation domain=TS
#note "Exactly one of the pair is present (an AGE record, no AGETXT record) - the conformant state; neither half of the split fires. THE DISCRIMINATOR: the sibling's neither-present half must also stay silent here, asserted by its own twin fixture on this dataset."
#library standard=sendig version=3-1-1
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL    type=Char label="Parameter Value"
---
S1 | TS | 1 | AGE     | 8
S1 | TS | 2 | SPECIES | RAT
