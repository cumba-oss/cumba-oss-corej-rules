#!RuleTest
#test FDA-SD1021 expect=violation domain=CO
#note "Violation twin of the COVAL exemption: the same leading space in COREF (which is NOT exempt) must be reported, proving the exemption is name-scoped and not a blanket CO skip."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 variable_name=COREF
dataset CO class="SPECIAL PURPOSE" label="Comments"
col STUDYID type=Char label="Study Identifier"
col RDOMAIN type=Char label="Related Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col COSEQ   type=Num  label="Sequence Number"
col COREF   type=Char label="Reference"
col COVAL   type=Char label="Comment"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | " VISIT 2" | subject reported dizziness
