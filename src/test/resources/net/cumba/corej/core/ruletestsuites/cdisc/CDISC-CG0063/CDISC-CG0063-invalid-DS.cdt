#!RuleTest
#test CDISC-CG0063 expect=violation domain=DS
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0063 (Condition: multiple events per subject where DSCAT = 'DISPOSITION EVENT'; Rule: EPOCH ^= null). Subject 01-701-1015 has two DISPOSITION EVENT records (end of treatment, end of follow-up); row 2 of them has EPOCH null -> fires. Row 1 is the subject's other disposition event with EPOCH populated -> silent. Row 3 is a PROTOCOL MILESTONE with EPOCH null (Condition false). Row 4: subject 01-701-1023 has a SINGLE disposition event with EPOCH null, so the multiple-events Condition is not met -> silent."
#library standard=sdtmig version=3-2
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1015 DSSEQ=3
dataset DS class=EVENTS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSTERM  type=Char label="Reported Term for the Disposition Event"
col DSDECOD type=Char label="Standardized Disposition Term"
col DSCAT   type=Char label="Category for Disposition Event"
col EPOCH   type=Char label="Epoch"
---
CDISCPILOT01 | DS | 01-701-1015 | 2 | COMPLETED | COMPLETED | DISPOSITION EVENT | TREATMENT
CDISCPILOT01 | DS | 01-701-1015 | 3 | COMPLETED | COMPLETED | DISPOSITION EVENT |
CDISCPILOT01 | DS | 01-701-1015 | 1 | INFORMED CONSENT OBTAINED | INFORMED CONSENT OBTAINED | PROTOCOL MILESTONE |
CDISCPILOT01 | DS | 01-701-1023 | 1 | ADVERSE EVENT | ADVERSE EVENT | DISPOSITION EVENT |
