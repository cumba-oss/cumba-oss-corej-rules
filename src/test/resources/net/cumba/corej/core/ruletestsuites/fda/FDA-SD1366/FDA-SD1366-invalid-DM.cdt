#!RuleTest
#test FDA-SD1366 expect=violation domain=DM
#note "Row 1: a not-assigned subject has a populated RFENDTC -> fires. Row 2: the same reason with an empty RFENDTC is conformant."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 RFENDTC=2020-02-10
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFSTDTC  type=Char label="Subject Reference Start Date/Time"
col RFENDTC  type=Char label="Subject Reference End Date/Time"
col ARMNRS   type=Char label="Reason Arm and/or Actual Arm is Null"
---
CDISCPILOT01 | DM | 01-701-1015 |  | 2020-02-10 | NOT ASSIGNED
CDISCPILOT01 | DM | 01-701-1023 |  |            | NOT ASSIGNED
