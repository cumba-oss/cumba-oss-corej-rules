#!RuleTest
#test CDISC-SEND-0241.1 expect=noViolation domain=TX
#note "SET01's TRTDOS is a number with mg/kg units (the Check's TXVAL == 'SEE PROTOCOL' leaf is false), SET02 says SEE PROTOCOL on both TRTDOS and TRTDOSU -> nothing fires. W6 phase 0, scenarios-first."
#library standard=sendig version=3-1-1
dataset TX class="TRIAL DESIGN" label="Trial Sets"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col SETCD    type=Char label="Set Code"
col SET      type=Char label="Set Description"
col TXSEQ    type=Num  label="Sequence Number"
col TXPARMCD type=Char label="Trial Set Parameter Short Name"
col TXPARM   type=Char label="Trial Set Parameter"
col TXVAL    type=Char label="Trial Set Parameter Value"
---
S01 | TX | SET01 | Control | 1 | TRTDOS | Treatment Dose | 10
S01 | TX | SET01 | Control | 2 | TRTDOSU | Treatment Dose Units | mg/kg
S01 | TX | SET02 | High Dose | 3 | TRTDOS | Treatment Dose | SEE PROTOCOL
S01 | TX | SET02 | High Dose | 4 | TRTDOSU | Treatment Dose Units | SEE PROTOCOL
