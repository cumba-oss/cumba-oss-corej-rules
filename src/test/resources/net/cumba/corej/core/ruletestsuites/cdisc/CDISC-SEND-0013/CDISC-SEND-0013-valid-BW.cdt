#!RuleTest
#test CDISC-SEND-0013 expect=noViolation domain=BW
#note "Every Expected variable of BW is present -> no violation. W4 (PLAN-list-functions phase 0, scenarios-first on the pre-port engine)."
#library standard=sendig version=3-1-1
#library expected-variables BW STUDYID DOMAIN USUBJID BWSEQ BWTESTCD BWDTC
dataset BW label="Body Weight"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col BWSEQ    type=Num  label="Sequence Number"
col BWTESTCD type=Char label="Body Weight Test Short Name"
col BWDTC    type=Char label="Date/Time of Collection"
---
S1 | BW | 001 | 1 | BW | 2020-01-01
