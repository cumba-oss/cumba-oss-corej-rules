#!RuleTest
#test CDISC-CG0226 expect=noViolation domain=AE
#note "Every subject with a populated AESTRF has DM.RFSTDTC populated -> no violation."
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESTRF  type=Char label="Start Relative to Reference Period"
---
CDISCPILOT01 | AE | 01-701-1015 | BEFORE
CDISCPILOT01 | AE | 01-701-1023 |

---
dataset DM label=Demographics
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
---
CDISCPILOT01 | 01-701-1015 | 2012-08-01
CDISCPILOT01 | 01-701-1023 |
---
