#!RuleTest
#test PMDA-AD0043A expect=noViolation domain=ADLBC
#note "ADTM is declared format=DATETIME20. Any non-empty format silences the rule; validating the format's VALUE is PMDA-AD0043's job."
#library standard=adamig version=1-3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ADTM    type=Num format=DATETIME20.
---
S1 | 001 | ALB | 1900000
---
