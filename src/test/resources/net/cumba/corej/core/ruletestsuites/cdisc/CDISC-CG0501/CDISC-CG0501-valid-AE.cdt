#!RuleTest
#test CDISC-CG0501 expect=noViolation domain=AE
#note "AE carries the MIDS variable and the TM dataset is present in the study -> no violation."
#library standard=sdtmig version=3-4
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col MIDS    type=Char label="Disease Milestone Instance Name"
---
S1 | AE | 001 | 1 | HEADACHE | HYPOGLYCEMIC EVENT 1
---

dataset TM label="Trial Disease Milestones"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col MIDSTYPE type=Char label="Disease Milestone Type"
col TMDEF    type=Char label="Disease Milestone Definition"
---
S1 | TM | HYPOGLYCEMIC EVENT | First hypoglycemic event after diagnosis
