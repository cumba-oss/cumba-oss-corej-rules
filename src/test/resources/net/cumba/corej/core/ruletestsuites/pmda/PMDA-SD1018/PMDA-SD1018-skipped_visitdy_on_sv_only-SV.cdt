#!RuleTest
#test PMDA-SD1018 expect=skipped domain=SV
#note "PLAN-join-key-authoring-gate phase 3/4, sensitivity arm row 1 — a key absent on ONE side. SV carries VISITDY, TV does not, so the All_Or_None group [VISITDY, TV.VISITDY] is only partly present and the rule SKIPS. Before the gate the rule ran: TV's missing VISITDY contributed its type default, no SV row matched, and BOTH planned visits were reported although TV defines them (a flood). Red-first: with the VISITDY group removed from the rule this scenario fails with the rule executed."
#library standard=sdtmig version=3-4
dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col VISITDY  type=Num  label="Planned Study Day of Visit"
col SVUPDES  type=Char label="Description of Unplanned Visit"
---
CDISCPILOT01 | SV | 01-701-1015 | 1 | SCREENING | -7 |
CDISCPILOT01 | SV | 01-701-1015 | 2 | BASELINE  | 1  |
---

dataset TV label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | TV | 1 | SCREENING
CDISCPILOT01 | TV | 2 | BASELINE
