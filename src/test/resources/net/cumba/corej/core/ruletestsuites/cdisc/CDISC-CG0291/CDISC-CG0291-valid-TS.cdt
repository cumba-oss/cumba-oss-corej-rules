#!RuleTest
#test CDISC-CG0291 expect=noViolation domain=TS
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0291 (Condition: TSVALNF = null; Rule: TSVAL not populated with values or synonyms of values in the ISO 21090 null flavor codelist). The missing maximum age is expressed through TSVALNF=PINF with TSVAL null (row 1); row 2 carries a real value. TSVALNF is present, so the rule executes -> silent."
#library standard=sdtmig version=3-4
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
col TSVALNF  type=Char label="Parameter Null Flavor"
---
CDISCPILOT01 | TS | 1 | AGEMAX | Planned Maximum Age of Subjects |  | PINF
CDISCPILOT01 | TS | 1 | AGEMIN | Planned Minimum Age of Subjects | P50Y | 
---
