#!RuleTest
#test PMDA-AD0018 expect=violation domain=ADSL
#note "PMDA AD0018 states no index exception (PLAN-library-template-label-resolution, QH1 (a)): every index-named variable that carries a label in the ADaM metadata is checked against its resolved template. trt01p resolves through the ADSL template TRTxxP and 'Any Sponsor Label' does not conform to 'Planned Treatment for Period 01' -> one violation. Until this plan the column resolved to no library row (this scenario was valid_lowercase_indexed_name). studyid is the positive control."
#library standard=adamig version=1-3
#library variable-metadata ADSL STUDYID name=STUDYID label="Study Identifier"
#library variable-metadata ADSL TRTxxP name=TRTxxP label="Planned Treatment for Period xx"
#expectViolationCount 1
#expectViolationAt variable_name=trt01p library_variable_label="Planned Treatment for Period 01" library_variable_label_template="Planned Treatment for Period 01" variable_label="Any Sponsor Label"
dataset ADSL structure=ADSL
col studyid type=Char label="Study Identifier"
col trt01p  type=Char label="Any Sponsor Label"
---
CDISCPILOT01 | Placebo
---
