#!RuleTest
#test CDISC-CG0142 expect=violation domain=DM
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0142 (Condition: Milestone associated with RFENDTC is end of treatment and ACTARM not in ('Screen Failure', 'Not Assigned', 'Not Treated'); Rule: RFENDTC ^= null). Row 2: subject 01-701-1023 was treated (ACTARMCD=XANHI) but RFENDTC is null -> fires. Row 1 is a treated subject with RFENDTC populated. Row 3 is a screen failure (ACTARMCD=SCRNFAIL), outside the Condition, silent."
#library standard=sdtmig version=3-2
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1023 ACTARMCD=XANHI
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFSTDTC  type=Char label="Subject Reference Start Date/Time"
col RFENDTC  type=Char label="Subject Reference End Date/Time"
col ACTARMCD type=Char label="Actual Arm Code"
col ACTARM   type=Char label="Description of Actual Arm"
---
CDISCPILOT01 | DM | 01-701-1015 | 2014-01-02 | 2014-07-02 | PBO | Placebo
CDISCPILOT01 | DM | 01-701-1023 | 2012-08-05 | | XANHI | Xanomeline High Dose
CDISCPILOT01 | DM | 01-701-1028 | | | SCRNFAIL | Screen Failure
