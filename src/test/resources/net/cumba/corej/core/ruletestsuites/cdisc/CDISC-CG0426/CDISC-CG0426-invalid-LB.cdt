#!RuleTest
#test CDISC-CG0426 expect=violation domain=LB
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0426 (Class FND; Condition: --STRESU ^= null; Rule: --STRESC (in standard units) ^= null). Row 2: LBSTRESU=mmol/L is populated but the standardized result LBSTRESC is null -> fires. Row 1 carries both; row 3 (test not done) has LBSTRESU null (Condition false). LBSTRESC is populated on row 1, so the dataset is not the all-empty folded case."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1023 LBSEQ=1
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBTEST   type=Char label="Lab Test or Examination Name"
col LBORRES  type=Char label="Result or Finding in Original Units"
col LBSTRESC type=Char label="Character Result/Finding in Std Format"
col LBSTRESU type=Char label="Standard Units"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | GLUC | Glucose | 101 | 5.6 | mmol/L
CDISCPILOT01 | LB | 01-701-1023 | 1 | GLUC | Glucose | 99 | | mmol/L
CDISCPILOT01 | LB | 01-701-1028 | 1 | GLUC | Glucose | | |
