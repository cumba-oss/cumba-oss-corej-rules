#!RuleTest
#test PMDA-SD2012C expect=violation domain=AE
#note "AEHLGT 'HEADACHES' is a valid High Level Group Term but not in MedDRA's preferred case ('Headaches') -> the case-sensitive check fires on row 2; row 1 matches exactly."
#library standard=sdtmig version=3-4
#dictionaries dummy
#expectViolationCount 1
#expectViolationAt row=2 AEHLGT=HEADACHES
dataset AE
col USUBJID type=Char
col AEHLGT  type=Char
---
001 | Headaches
001 | HEADACHES
