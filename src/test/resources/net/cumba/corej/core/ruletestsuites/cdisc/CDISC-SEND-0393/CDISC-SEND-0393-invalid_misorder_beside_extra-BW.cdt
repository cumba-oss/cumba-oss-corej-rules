#!RuleTest
#test CDISC-SEND-0393 expect=violation domain=BW
#note "BWTEST is declared before BWTESTCD, contradicting the model order, and BWCUSTOM (not in the model list) sits between them. The unknown variable is ignored, the misorder among the known ones is still reported - once for the dataset."
#library standard=sendig-dart version=1-2
#library model-column-order BW STUDYID DOMAIN USUBJID BWSEQ BWGRPID BWTESTCD BWTEST BWCAT BWPOS BWORRES BWORRESU
#expectViolationCount 1
dataset BW class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col BWSEQ    type=Num
col BWTEST   type=Char
col BWCUSTOM type=Char
col BWTESTCD type=Char
col BWORRES  type=Char
---
S1 | BW | 001 | 1 | Test | X | X1 | 1
---
