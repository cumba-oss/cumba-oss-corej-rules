#!RuleTest
#test PMDA-SD1339 expect=skipped domain=MH
#note "MH is a member of the included EVENTS class, so ONLY the PMDA Domains.Exclude rejects - the FDA twin (Exclude only CO/DM/SV) RUNS on MH: this is the B-targeting discriminator. Row would fire if in scope (populated MHSTDTC, empty EPOCH)."
#library standard=sdtmig version=3-4
dataset MH class=EVENTS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col MHTERM   type=Char
col MHSTDTC  type=Char
col EPOCH    type=Char
---
S1 | MH | 001 | ASTHMA | 2020-01-01 |
