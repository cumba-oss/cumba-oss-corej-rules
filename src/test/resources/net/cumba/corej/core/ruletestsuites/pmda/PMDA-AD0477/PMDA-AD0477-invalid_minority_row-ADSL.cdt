#!RuleTest
#test PMDA-AD0477 expect=violation domain=ADSL
#note "Mirror of PMDA-AD0476: key is the character STRATAV, target is the numeric STRATAVN. Group STRATAV=G1 holds {1 x2, 2 x1}, so the one minority row fires."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=003 STRATAV=G1 STRATAVN=2
dataset ADSL
col STUDYID  type=Char
col USUBJID  type=Char
col STRATAV  type=Char
col STRATAVN type=Num
---
S1 | 001 | G1 | 1
S1 | 002 | G1 | 1
S1 | 003 | G1 | 2
---
