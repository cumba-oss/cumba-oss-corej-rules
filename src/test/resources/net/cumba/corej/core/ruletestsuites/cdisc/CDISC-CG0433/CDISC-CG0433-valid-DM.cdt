#!RuleTest
#test CDISC-CG0433 expect=noViolation domain=DM
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0433 (Condition: AGEU ^= null and AGETXT = null; Rule: AGE ^= null). Rows 1-2 populate AGE with AGEU; row 3 gives the age as a range in AGETXT (AGE null), so the Condition does not hold; row 4 leaves AGE, AGETXT and AGEU all empty (AGEU null, Condition not met). No row fires."
#library standard=sdtmig version=3-3
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col AGE     type=Num  label="Age"
col AGETXT  type=Char label="Age Range"
col AGEU    type=Char label="Age Units"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015 | 64 |       | YEARS
CDISCPILOT01 | DM | 01-701-1023 | 1023 | 71 |       | YEARS
CDISCPILOT01 | DM | 01-701-1028 | 1028 |    | 18-65 | YEARS
CDISCPILOT01 | DM | 01-701-1033 | 1033 |    |       |
---
