#!RuleTest
#test CDISC-CG0353 expect=violation domain=AE
# Rule:Description: Raise an error when --EXCLFL is present in a dataset submitted for human clinical trials.
#note "AEEXCLFL column present in the dataset"
#expectViolationCount 1
#expectViolationAt row=1
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AEEXCLFL type=Char label="Exclusion Flag"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | 
CDISCPILOT01 | AE | 01-701-1015 | 2 | 
---
