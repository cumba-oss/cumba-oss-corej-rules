#!RuleTest
#test PMDA-AD0677 expect=violation domain=ADDL
#note "AD-prefixed name, no BDS indicator, no column ending TERM/TRT/DECOD -> base ADAM OTHER; SPDEVID refines it to DEVICE LEVEL ANALYSIS DATASET, the rule's single Include token. Group DEVTYG1N=1 holds {PUMP x2, VALVE x1} -> one minority row."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=003 DEVTYG1=VALVE DEVTYG1N=1
dataset ADDL
col STUDYID   type=Char
col USUBJID   type=Char
col SPDEVID   type=Char
col DEVTYG1   type=Char
col DEVTYG1N  type=Num
---
S1 | 001 | DEV01 | PUMP  | 1
S1 | 002 | DEV01 | PUMP  | 1
S1 | 003 | DEV02 | VALVE | 1
---
