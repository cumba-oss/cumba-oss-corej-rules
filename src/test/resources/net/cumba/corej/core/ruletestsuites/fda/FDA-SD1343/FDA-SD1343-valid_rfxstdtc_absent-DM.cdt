#!RuleTest
#test FDA-SD1343 expect=skipped domain=DM
#note "CL-D / §9 Q2 (wave TA-4): RFXSTDTC is Permissible in SENDIG DM; before the Requirements.Variables gate the Java engine read the absent column as empty and fired 'RFXSTDTC is empty for a treated subject' on EVERY treated row - a finding-per-row flood about a column the standard allowed the sponsor to omit. With the gate the engine records one auditable skip."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SUBJID   type=Char label="Subject Identifier for the Study"
col ACTARMCD type=Char label="Actual Arm Code"
---
S1 | DM | 001 | 001 | TRT01
S1 | DM | 002 | 002 | TRT01
