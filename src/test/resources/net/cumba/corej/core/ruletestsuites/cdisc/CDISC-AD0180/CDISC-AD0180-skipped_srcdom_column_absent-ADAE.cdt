#!RuleTest
#test CDISC-AD0180 expect=skipped domain=ADAE
#note "No SRCDOM column: Requirements.Variables.All [SRCDOM] skips the rule with the reason named. Without the gate the absent column would read as all-missing and not empty(SRCDOM) would hold nothing back silently (noViolation instead of skipped)."
#library standard=adamig version=1-0
#library standard-domains AE DM LB VS
dataset ADAE structure=BDS label="Adverse Events Analysis Dataset"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col PARAMCD type=Char label="Parameter Code"
---
S1 | 001 | AEP
---
