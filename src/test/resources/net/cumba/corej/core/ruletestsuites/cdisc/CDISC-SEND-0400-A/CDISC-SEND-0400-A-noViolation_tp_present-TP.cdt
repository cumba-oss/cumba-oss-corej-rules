#!RuleTest
#test CDISC-SEND-0400-A expect=noViolation domain=TP
#note "The R-5.25 wave-3 split's discriminator, sibling side: TP is present, so the TP half is SILENT - the missing TT of this study is the parent's finding (this dataset shape is the parent's violation data)."
#library standard=sendig-dart version=1-2
#expectViolationCount 0
dataset TP class="TRIAL DESIGN" label="Trial Repro Paths"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col TPSEQ   type=Num  label="Sequence Number"
---
S1 | TP | 1
