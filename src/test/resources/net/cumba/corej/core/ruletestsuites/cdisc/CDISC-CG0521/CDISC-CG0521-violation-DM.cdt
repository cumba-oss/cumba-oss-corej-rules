#!RuleTest
#test CDISC-CG0521 expect=violation domain=DM
#note "Row 1 has ARM without ARMCD -> the published direction fires. Row 2 (ARMCD without ARM) is the MIRROR direction, minted as CDISC-CG9677 (D-17), and must NOT fire here - the discriminator between the pair. Rows 3/4 are the paired cases."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
---
S1 | DM | 001 |   | Treatment A
S1 | DM | 002 | B |
S1 | DM | 003 | C | Treatment C
S1 | DM | 004 |   |
