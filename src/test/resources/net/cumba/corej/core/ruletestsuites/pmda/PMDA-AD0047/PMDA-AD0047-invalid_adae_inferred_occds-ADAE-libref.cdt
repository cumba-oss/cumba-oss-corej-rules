#!RuleTest
#test PMDA-AD0047 expect=violation domain=ADAE
#note "PLAN-library-template-label-resolution R2-1, on OUR metadata store: the positive twin of -valid_adae_inferred_occds. ADAE (AE by its occurrence variables AESEQ / AETERM) under the D10-inferred OCCDS 1.0 lacks AESER, which carries the AE prefix and so IS demanded of an AE dataset -> one violation naming exactly AESER: the resolved --SEQ / --TERM are present as AESEQ / AETERM, and CMTRT (a CM variable) is not demanded."
#library-ref standard=adamig version=1-1
#expectViolationCount 1
#expectViolationAt "$missing_required_variables"="[AESER]"
dataset ADAE
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AETERM type=Char label="Reported Term for the Adverse Event"
col AEDECOD type=Char label="Dictionary-Derived Term"
---
CDISCPILOT01 | 01-701-1015 | 1 | HEADACHE | HEADACHE
---
