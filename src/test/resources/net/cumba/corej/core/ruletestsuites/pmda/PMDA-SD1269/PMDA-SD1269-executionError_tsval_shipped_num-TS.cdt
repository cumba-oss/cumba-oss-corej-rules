#!RuleTest
#test PMDA-SD1269 expect=executionError domain=TS
#expect-execution-error "TSVAL is declared Num"
#note "R7 (PLAN-column-type-conformance): TSVAL shipped as Num is nonconformant data (SDTMIG declares it Char), and the rule's format-regex arm reads it as a regex subject. Per R9 a numeric column's text form is formatting-dependent, so the engine must ERROR rather than judge a rendering. The 0.5 value keeps both num(TSVAL) comparisons false, so the regex arm is genuinely the deciding read."
#library standard=sdtmig version=3-4
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Num  label="Parameter Value"
---
S1 | TS | 1 | RANDQT | Randomization Quotient | 0.5
---
