#!RuleTest
#test PMDA-SD1250 expect=noViolation domain=PC
#note "Direction discriminator: the rule conditions on --TPT being present; --TPTNUM alone must not fire (first conjunct false)."
#library standard=sdtmig version=3-4
dataset PC class=FINDINGS label="Pharmacokinetic Concentrations"
col STUDYID   type=Char
col DOMAIN    type=Char
col USUBJID   type=Char
col PCSEQ     type=Num
col PCTESTCD  type=Char
col PCTPTNUM  type=Num
---
S1 | PC | 001 | 1 | DRUGA | 1
---
