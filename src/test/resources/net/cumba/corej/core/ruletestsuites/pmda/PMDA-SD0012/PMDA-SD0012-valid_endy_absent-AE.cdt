#!RuleTest
#test PMDA-SD0012 expect=skipped domain=AE
#note "R-6 cross-graft (ruled 2026-08-19): the twins gained the Requirements.Variables [--ENDY, --STDY] gate. AEENDY is not present, so the rule records one auditable skip instead of a silent no-finding."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AESTDY  type=Num  label="Study Day of Start of Adverse Event"
---
S1 | AE | 001 | 1 | 12
