#!RuleTest
#test FDA-SD1032 expect=executionError domain=DM
#expect-execution-error "group= over 'IE' has no usable key"
#note "PLAN-join-key-one-side-absent-drop QK16 (b) / QK18 (owner 2026-10-11): IE without USUBJID - the domain= call's only group= member is on the evaluated side only, so no key member is left on both sides and the rule ERRORs (never an aggregate over the whole of IE). Derived from FDA-SD1032-invalid-DM.cdt with IE.USUBJID removed. A gate declaring IE.USUBJID would turn this into a SKIP."
#library standard=sdtmig version=3-2
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARMCD    type=Char label="Planned Arm Code"
col ARM      type=Char label="Description of Planned Arm"
---
S1 | DM | 001 | SCRNFAIL | Screen Failure
S1 | DM | 002 | SCRNFAIL | Screen Failure
S1 | DM | 003 | A        | Drug A
---

dataset IE label="Inclusion/Exclusion Criteria Not Met"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col IESEQ    type=Num  label="Sequence Number"
col IETESTCD type=Char label="Inclusion/Exclusion Criterion Short Name"
col IEORRES  type=Char label="I/E Criterion Original Result"
---
S1 | IE | 1 | INCL01 | Y

