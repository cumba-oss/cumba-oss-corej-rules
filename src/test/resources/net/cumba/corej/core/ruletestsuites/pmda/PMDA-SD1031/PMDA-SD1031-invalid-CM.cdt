#!RuleTest
#test PMDA-SD1031 expect=violation domain=CM
#note "Row 1: subject 002 has CMENRF populated while DM.RFENDTC is empty -> fires. Row 2: subject 001 has RFENDTC populated -> no fire. First scenario coverage for this rule (authored with the D-TA-2 Join_Type removal)."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=002
dataset CM class=INTERVENTIONS label="Concomitant/Prior Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ   type=Num  label="Sequence Number"
col CMTRT   type=Char label="Reported Name of Drug, Med, or Therapy"
col CMENRF  type=Char label="End Relative to Reference Period"
---
S1 | CM | 002 | 1 | ASPIRIN | AFTER
S1 | CM | 001 | 1 | ASPIRIN | AFTER
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFENDTC type=Char label="Subject Reference End Date/Time"
---
S1 | DM | 001 | 2020-06-30
S1 | DM | 002 |
