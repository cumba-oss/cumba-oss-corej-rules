#!RuleTest
#test CDISC-SEND-0359-A expect=violation domain=FM
#note "R-5.25 split of SEND359 (top-level-or board wave 2, group J), the RPPLSTDY split sibling: row 1's RPPLSTDY value '3.5' is populated and not an integer -> fires, named against this one variable instead of the six-name disjunction. Row 2 is a plain integer and row 3 a negative integer (is_integer admits a sign); row 4 is blank - 'when populated' means a missing value is conformant."
#library standard=sendig-dart version=1-2
#expectViolationCount 1
#expectViolationAt row=1 FMSEQ=1
dataset FM class=FINDINGS label="Fetal Measurements"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col FMSEQ    type=Num  label="Sequence Number"
col FMTESTCD type=Char label="Test Short Name"
col RPPLSTDY type=Num label="Repro Phase Day Timing"
---
S1 | FM | 001 | 1 | BWFET | 3.5
S1 | FM | 001 | 2 | BWFET | 12
S1 | FM | 001 | 3 | BWFET | -3
S1 | FM | 001 | 4 | BWFET | 
