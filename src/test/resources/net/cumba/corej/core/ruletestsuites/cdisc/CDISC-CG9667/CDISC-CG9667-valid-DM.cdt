#!RuleTest
#test CDISC-CG9667 expect=noViolation domain=DM
#note "Authority: coreJ-minted rule (no SDTM and SDTMIG Conformance Rules v2.0 row; sheet issue #101): the dataset-presence counterpart, for TS (Trial Summary), of CG0368 (Rule: DM dataset present in study). The same DM dataset as the invalid scenario, but the study also carries a TS dataset, so the presence check is satisfied while evaluating DM."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015
---

dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
CDISCPILOT01 | TS | 1 | AGEMIN | Planned Minimum Age of Subjects | P50Y
---
