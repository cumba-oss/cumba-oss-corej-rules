#!RuleTest
#test PMDA-SD9711 expect=violation domain=DM
# Rule:Description: PMDA-SD9711 — the Required key USUBJID is not populated.
#note "USUBJID blank -> violation; the twin scenario differs only in the value of USUBJID."
#library standard=sdtmig version=3-4
#expectViolationCount 1
dataset DM
col STUDYID type=Char
col DOMAIN type=Char
col USUBJID type=Char
col SUBJID type=Char
col SITEID type=Char
---
S1      | DM     |         | 001    | 01
---
