#!RuleTest
#test CDISC-CG0033-A expect=noViolation domain=LB
#note "R-4.11b PIN, LOAD-BEARING. SVPRESP is absent AND the LB dataset carries no VISIT column, so this arm has nothing to read planned-ness from. The `not empty(VISIT)` conjunct is FALSE on an absent column and suppresses the rule - bucket 1, the leaf's absent-column verdict is the one the check wants. ⚠ REMOVE THAT CONJUNCT AND THIS FIXTURE FLOODS: `not contains(upper(VISIT), \"UNSCHEDUL\")` is TRUE on an absent column (absent = all-missing), so every populated VISITNUM not in TV would fire. VISIT is Permissible, so its absence is legitimate. If this scenario reports a violation, the guard has been removed - escalate, do not rewrite the pin."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col VISITNUM type=Num  label="Visit Number"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB | 2
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALB | 99
---

dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | SV | 01-701-1015 | 2  | BASELINE
CDISCPILOT01 | SV | 01-701-1015 | 99 | WEEK 99
---

dataset TV label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | TV | 1 | SCREENING
CDISCPILOT01 | TV | 2 | BASELINE
---
