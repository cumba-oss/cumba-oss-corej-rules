#!RuleTest
#test CDISC-SEND-0273 expect=violation domain=BW
#note "Authority: SEND Conformance Rules v5.0 SEND273 ('Variable label is unique'). BWORRES and BWSTRESC both carry the label 'Result' -> both variables fire, one finding per variable; every other label is distinct."
#library standard=sendig version=3-1-1
#expectViolationCount 2
#expectViolationAt variable_name=BWORRES
#expectViolationAt variable_name=BWSTRESC
dataset BW label="Body Weight"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col BWSEQ    type=Num  label="Sequence Number"
col BWORRES  type=Char label="Result"
col BWSTRESC type=Char label="Result"
---
S1 | BW | 001 | 1 | 250 | 250
