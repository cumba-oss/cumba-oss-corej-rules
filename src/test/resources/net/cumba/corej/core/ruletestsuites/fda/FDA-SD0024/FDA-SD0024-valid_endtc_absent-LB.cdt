#!RuleTest
#test FDA-SD0024 expect=skipped domain=LB
#note "LBENDTC (the permissible trigger, listed in Requirements.Variables.All) is not present, so the sheet condition can never hold -> no violation even though LBDTC is empty."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBDTC    type=Char label="Date/Time of Specimen Collection"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | GLUC |
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALB  | 2020-02-01T08:00
