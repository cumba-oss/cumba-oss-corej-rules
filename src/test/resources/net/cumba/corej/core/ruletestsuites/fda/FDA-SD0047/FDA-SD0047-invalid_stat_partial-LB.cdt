#!RuleTest
#test FDA-SD0047 expect=violation domain=LB
#note "CL-A A.4 (wave TA-4): the middle leaf became PMDA's --STAT != 'NOT DONE' per both sheets. Row 1 has LBORRES empty with the non-standard status 'PARTIAL' - under the old empty(--STAT) leaf any junk in LBSTAT bought an exemption the sheet never granted; now it fires. Row 2's 'NOT DONE' is the sheet's exemption."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 nameOnly=LBSTAT
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col LBSEQ   type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBORRES type=Char label="Result or Finding in Original Units"
col LBSTAT  type=Char label="Completion Status"
---
S1 | LB | 001 | 1 | SYSBP |  | PARTIAL
S1 | LB | 001 | 2 | SYSBP |  | NOT DONE
