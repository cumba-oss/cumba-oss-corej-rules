#!RuleTest
#test CDISC-SEND-0045 expect=noViolation domain=MA
#note "MADECOD is not in the dataset (rule round 2026-10-12, var_exists sweep): a populated MASCAT never equals the absent column's empty value, so the removed var_exists guard changed nothing. MASCAT differs from MABODSYS on every row -> no violation."
#library standard=sendig version=3-1-1
dataset MA class=FINDINGS label="Macroscopic Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col MASEQ    type=Num  label="Sequence Number"
col MATESTCD type=Char label="Macroscopic Examination Short Name"
col MASCAT   type=Char label="Subcategory for Macroscopic Finding"
col MABODSYS type=Char label="Body System or Organ Class"
---
S1 | MA | 001 | 1 | GROSPATH | GROSS  | HEPATOBILIARY
S1 | MA | 001 | 2 | GROSPATH | GROSS  | RENAL
