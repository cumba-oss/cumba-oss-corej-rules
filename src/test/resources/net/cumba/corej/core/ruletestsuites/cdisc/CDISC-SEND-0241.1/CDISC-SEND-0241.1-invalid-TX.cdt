#!RuleTest
#test CDISC-SEND-0241.1 expect=violation domain=TX
#note "SET01's TRTDOS is 'SEE PROTOCOL' but SET01 has no TRTDOSU record with TXVAL 'SEE PROTOCOL' (its TRTDOSU says mg/kg) -> the TRTDOS row fires. SET02 has the matching pair and never fires. The two-key filter (TXPARMCD and TXVAL) is what makes SET01's mg/kg record not count. W6 phase 0, scenarios-first: the rule had no scenario."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 SETCD=SET01 TXPARMCD=TRTDOS
dataset TX class="TRIAL DESIGN" label="Trial Sets"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col SETCD    type=Char label="Set Code"
col SET      type=Char label="Set Description"
col TXSEQ    type=Num  label="Sequence Number"
col TXPARMCD type=Char label="Trial Set Parameter Short Name"
col TXPARM   type=Char label="Trial Set Parameter"
col TXVAL    type=Char label="Trial Set Parameter Value"
---
S01 | TX | SET01 | Control | 1 | TRTDOS | Treatment Dose | SEE PROTOCOL
S01 | TX | SET01 | Control | 2 | TRTDOSU | Treatment Dose Units | mg/kg
S01 | TX | SET02 | High Dose | 3 | TRTDOS | Treatment Dose | SEE PROTOCOL
S01 | TX | SET02 | High Dose | 4 | TRTDOSU | Treatment Dose Units | SEE PROTOCOL
