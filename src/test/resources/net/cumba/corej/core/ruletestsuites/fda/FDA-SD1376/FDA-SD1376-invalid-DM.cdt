#!RuleTest
#test FDA-SD1376 expect=violation domain=DM
#note "Row 1: a randomised subject (ACTARMCD='A') has an empty RFENDTC -> fires; row 2 (SCRNFAIL) is guarded out."
#library standard=sdtmig version=3-2
#expectViolationCount 1
#expectViolationAt row=1 RFENDTC= ACTARMCD=A
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFENDTC  type=Char label="Subject Reference End Date/Time"
col ACTARMCD type=Char label="Actual Arm Code"
---
CDISCPILOT01 | DM | 01-701-1015 |  | A
CDISCPILOT01 | DM | 01-701-1023 |  | SCRNFAIL
