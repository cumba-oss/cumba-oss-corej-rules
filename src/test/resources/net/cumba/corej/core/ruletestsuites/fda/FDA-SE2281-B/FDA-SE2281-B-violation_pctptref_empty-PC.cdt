#!RuleTest
#test FDA-SE2281-B expect=violation domain=PC
#note "The half this R-5.25 split sibling owns (top-level-or board wave 2, group J): PCTPTREF is not populated on row 1 -> fires, named against this one required timing variable instead of the three-name disjunction. The other two timing variables are populated throughout, so neither the parent nor the other sibling fires here."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 PCSEQ=1
dataset PC class=FINDINGS label="Pharmacokinetics Concentrations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PCSEQ    type=Num  label="Sequence Number"
col PCNOMDY  type=Num  label="Nominal Study Day for Tabulations"
col PCELTM   type=Char label="Planned Elapsed Time from Time Point Ref"
col PCTPTREF type=Char label="Time Point Reference"
---
S1 | PC | 001 | 1 | 1 | PT1H |
S1 | PC | 001 | 2 | 1 | PT2H | DOSE 1
