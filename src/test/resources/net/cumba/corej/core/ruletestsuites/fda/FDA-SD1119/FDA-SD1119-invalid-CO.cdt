#!RuleTest
#test FDA-SD1119 expect=violation domain=CO
#note "Row 1: RDOMAIN populated (related comment) and VISIT populated -> fires. Row 2 related but no Identifier/Timing variable populated -> no fire."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 nameOnly=RDOMAIN
dataset CO class="SPECIAL PURPOSE" label="Comments"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col COSEQ    type=Num  label="Sequence Number"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col COVAL    type=Char label="Comment"
col VISIT    type=Char label="Visit Name"
---
S1 | CO | AE | 001 | 1 | AESEQ | 1 | Comment on AE record | WEEK 1
S1 | CO | AE | 001 | 2 | AESEQ | 2 | Another comment      |
