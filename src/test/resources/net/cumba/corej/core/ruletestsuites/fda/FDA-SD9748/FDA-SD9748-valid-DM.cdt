#!RuleTest
#test FDA-SD9748 expect=noViolation domain=DM
# Rule:Description: Raise an error when the trial is interventional (TS.TSPARMCD equals 'STYPE' and TS.TSVAL equals 'INTERVENTIONAL'), the subject has a record in the EX dataset, and ARMNRS is populated with a value other than 'UNPLANNED TREATMENT'.
#note "Interventional study; every subject with an EX record has ARMNRS empty (assigned to an arm)"
#library standard=sdtmig version=3-4
dataset DM label=Demographics
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col ARMNRS type=Char
---
CDISCPILOT01 | DM | 01-701-1015 |
CDISCPILOT01 | DM | 01-701-1023 |
---

dataset TS label="Trial Summary"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL type=Char label="Parameter Value"
---
CDISCPILOT01 | TS | STYPE | INTERVENTIONAL
---

dataset EX label=Exposure
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | EX | 01-701-1015
CDISCPILOT01 | EX | 01-701-1023
---
