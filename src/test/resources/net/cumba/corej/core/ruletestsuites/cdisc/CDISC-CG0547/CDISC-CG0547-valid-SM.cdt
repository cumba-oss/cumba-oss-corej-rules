#!RuleTest
#test CDISC-CG0547 expect=noViolation domain=SM
#note "Every disease-milestone record carries SMSTDTC -> no violation."
#library standard=sdtmig version=3-4
dataset SM class="SPECIAL PURPOSE" label="Disease Milestones"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SMSEQ    type=Num  label="Sequence Number"
col MIDS     type=Char label="Disease Milestone Instance Name"
col MIDSTYPE type=Char label="Disease Milestone Type"
col SMSTDTC  type=Char label="Start Date/Time of Milestone"
---
S1 | SM | 001 | 1 | DIAGNOSIS1 | DIAGNOSIS | 2020-01-15
S1 | SM | 001 | 2 | RELAPSE1   | RELAPSE   | 2020-06-02
