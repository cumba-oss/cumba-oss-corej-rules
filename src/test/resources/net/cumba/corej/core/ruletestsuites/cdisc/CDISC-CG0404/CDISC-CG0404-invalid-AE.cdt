#!RuleTest
#test CDISC-CG0404 expect=violation domain=AE
# Rule:Description: Raise an error when --PRESP is equal to 'Y' and --OCCUR is empty and --STAT is not present in dataset.
#note "AEPRESP=Y with empty AEOCCUR and no AESTAT column in the dataset"
#expectViolationCount 1
#expectViolationAt row=1 AESEQ=1 USUBJID=01-701-1015
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AEPRESP type=Char label="Pre-Specified"
col AEOCCUR type=Char label="Occurrence"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | Y |
CDISCPILOT01 | AE | 01-701-1023 | 1 |  | Y
---
