#!RuleTest
#test PMDA-AD0058 expect=noViolation domain=ADLBC
#note "No column name ends in 'DT', so the varname() guard is false for every column and the rule EXECUTES and reports nothing. This is a noViolation, not a skip: unlike a wildcard TEMPLATE rule, a varname()-guarded metadata rule always runs."
#library standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col AVALC   type=Char
---
CDISCPILOT01 | 01-701-1015 | ALB | 4.1 | NORMAL
