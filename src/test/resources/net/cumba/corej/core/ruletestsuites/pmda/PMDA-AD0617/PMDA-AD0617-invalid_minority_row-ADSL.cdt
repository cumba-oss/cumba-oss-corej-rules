#!RuleTest
#test PMDA-AD0617 expect=violation domain=ADSL
#note "Mirror of PMDA-AD0616: key TRCMPG1, target TRCMPG1N. Group GOOD holds {1 x2, 2 x1} -> the minority row fires."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=003 TRCMPG1=GOOD TRCMPG1N=2
dataset ADSL
col STUDYID   type=Char
col USUBJID   type=Char
col TRCMPG1   type=Char
col TRCMPG1N  type=Num
---
S1 | 001 | GOOD | 1
S1 | 002 | GOOD | 1
S1 | 003 | GOOD | 2
---
