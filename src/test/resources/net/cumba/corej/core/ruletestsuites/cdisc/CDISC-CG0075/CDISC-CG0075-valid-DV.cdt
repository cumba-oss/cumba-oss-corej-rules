#!RuleTest
#test CDISC-CG0075 expect=noViolation domain=DV
# Rule:Description: Raise an error when the Start Date/Time of Deviation (DVSTDTC) in the Protocol Deviations (DV) dataset is earlier than the subject's Date/Time of Informed Consent (RFICDTC) in the Demographics (DM) dataset.
#note "DVSTDTC is on or after the subject's DM.RFICDTC"
dataset DV label="Protocol Deviations"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DVSEQ type=Num label="Sequence Number"
col DVSTDTC type=Char label="Start Date/Time of Deviation"
---
CDISCPILOT01 | DV | 01-701-1015 | 1 | 2014-03-15
---

dataset DM label=Demographics
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFICDTC type=Char label="Date/Time of Informed Consent"
---
CDISCPILOT01 | DM | 01-701-1015 | 2014-01-02
---
