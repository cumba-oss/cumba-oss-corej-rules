#!RuleTest
#test CDISC-CG0148 expect=noViolation domain=DM
# Rule:Description: Raise an error when Exposure (EX) records are present for a subject, but the Subject Reference Start Date/Time of Study Treatment (RFXSTDTC) in the Demographics (DM) domain does not equal the earliest Exposure Start Date/Time (EXSTDTC) in the EX domain for that subject.
#note "RFXSTDTC equals the earliest EX.EXSTDTC for each subject -> no violation"
dataset DM label=Demographics
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFXSTDTC type=Char label="Date/Time of First Study Treatment"
---
CDISCPILOT01 | DM | 01-701-1015 | 2014-01-02
CDISCPILOT01 | DM | 01-701-1023 | 2012-08-05
---

dataset EX label=Exposure
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
---
CDISCPILOT01 | EX | 01-701-1015 | 2014-01-02
CDISCPILOT01 | EX | 01-701-1015 | 2014-01-17
CDISCPILOT01 | EX | 01-701-1015 | 2014-06-19
CDISCPILOT01 | EX | 01-701-1023 | 2012-08-05
CDISCPILOT01 | EX | 01-701-1023 | 2012-08-28
---
