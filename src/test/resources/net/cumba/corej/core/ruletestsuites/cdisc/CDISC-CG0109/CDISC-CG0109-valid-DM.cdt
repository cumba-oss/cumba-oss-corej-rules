#!RuleTest
#test CDISC-CG0109 expect=noViolation domain=DM
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0109 (SDTMIG 3.2; Condition: no records in EX for the subject; Rule: DM.ACTARMCD in (SCRNFAIL, NOTASSGN, NOTTRT)). Subjects 01-701-1015 and 01-701-1023 have EX records, so the Condition does not hold for them; the three subjects without EX records carry exactly the exempt ACTARMCD values SCRNFAIL, NOTASSGN and NOTTRT."
#library standard=sdtmig version=3-2
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARMCD    type=Char label="Planned Arm Code"
col ACTARMCD type=Char label="Actual Arm Code"
---
CDISCPILOT01 | DM | 01-701-1015 | PBO      | PBO
CDISCPILOT01 | DM | 01-701-1023 | XANHI    | XANHI
CDISCPILOT01 | DM | 01-701-1028 | SCRNFAIL | SCRNFAIL
CDISCPILOT01 | DM | 01-701-1033 | NOTASSGN | NOTASSGN
CDISCPILOT01 | DM | 01-701-1034 | XANLO    | NOTTRT
---

dataset EX label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
---
CDISCPILOT01 | EX | 01-701-1015 | 1 | PLACEBO    | 2014-01-02
CDISCPILOT01 | EX | 01-701-1023 | 1 | XANOMELINE | 2012-08-05
---
