#!RuleTest
#test PMDA-SD9722 expect=skipped domain=EC
#note "The discriminator that keeps the pair from double-reporting: the ECDOSTXT column EXISTS (blank on the qualifying row), so Requirements.Variables.None [ECDOSTXT] skips this sister with a reason naming the column, and PMDA-SD1279 owns the case, reporting row 1 (ECDOSE missing, ECOCCUR=Y) with its location."
#library standard=sdtmig version=3-4
dataset EC class=INTERVENTIONS label="Exposure as Collected"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col ECSEQ   type=Num  label="Sequence Number"
col ECTRT   type=Char label="Name of Treatment"
col ECOCCUR type=Char label="Occurrence"
col ECDOSE  type=Num  label="Dose"
col ECDOSTXT type=Char label="Dose Description"
---
S1 | EC | 001 | 1 | DRUG A | Y | . |
S1 | EC | 001 | 2 | DRUG A | Y | 5 | 
