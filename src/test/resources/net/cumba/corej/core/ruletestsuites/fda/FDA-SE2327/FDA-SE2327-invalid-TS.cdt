#!RuleTest
#test FDA-SE2327 expect=violation domain=TS
#note "No TSPARMCD=SPLANSUB record anywhere in TS -> the 'Planned Number of Nonclinical Subjects' parameter is missing, one dataset-level finding. the near-miss parameters PLANMSUB / PLANFSUB share the SUB suffix, so a substring match on the filter would wrongly silence the rule."
#library standard=sendig version=3-1-1
#expectViolationCount 1
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | PLANMSUB | Planned Number of Male Subjects            | 20
S01 | TS | 2 | PLANFSUB | Planned Number of Female Subjects          | 20
S01 | TS | 3 | STITLE   | Nonclinical Study Title                    | 13-Week Repeat Dose Toxicity Study
