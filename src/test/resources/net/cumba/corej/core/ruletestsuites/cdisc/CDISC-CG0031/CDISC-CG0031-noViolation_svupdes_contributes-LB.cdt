#!RuleTest
#test CDISC-CG0031 expect=noViolation domain=LB
#note "B5's improvement pinned on the joined family (PLAN-unplanned-visit-cascade): SV carries no SVPRESP column, and the retired -A sibling read ONLY the visit name - row 2's neutral WEEK 99 with an unmatched value fired there. The merged cascade lets SVUPDES contribute: the matching SV record describes an unplanned visit, so the row is exempt. Row 1 matches TV -> clean either way."
#library standard=sdtmig version=3-3
dataset LB label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | 2 | BASELINE
CDISCPILOT01 | LB | 01-701-1015 | 2 | 99 | WEEK 99
---

dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col SVUPDES  type=Char label="Description of Unplanned Visit"
---
CDISCPILOT01 | SV | 01-701-1015 | 2 | BASELINE | 
CDISCPILOT01 | SV | 01-701-1015 | 99 | WEEK 99 | EXTRA VISIT AFTER AE
---

dataset TV label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | TV | 1 | SCREENING
CDISCPILOT01 | TV | 2 | BASELINE
---
