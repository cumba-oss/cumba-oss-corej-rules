#!RuleTest
#test PMDA-AD0102 expect=noViolation domain=ADLBC
#note "PLAN-dynamic-column-corpus-respelling §2.2 Q1 / QS (b), S2, the PMDA twin of CDISC-AD0102-valid_nonintegral_aperiod_silent: APERIOD=1.5 is not a period number. printf(\"%02d\", 1.5) is a computed missing, so the bound name $trt_p is missing and `not empty($trt_p)` is false -> silent. The base ${APERIOD:%02d} spelling truncated 1.5 to 1, found no ADSL.TRT01P (ADSL carries TRT02P only) and fired (red on the base text, as ruled 2026-10-03)."
#library standard=adamig version=1-3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col APERIOD type=Num
---
S1 | 001 | GLUC | 5.1 | 1.5
---

dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRT02P  type=Char
---
S1 | 001 | Active
---
