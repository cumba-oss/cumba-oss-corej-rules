#!RuleTest
#test PMDA-SD0022 expect=skipped domain=AE
#note "None of the three start-point columns (AESTDTC/AESTRF/AESTRTPT) exists, so Requirements.Variables.Any [--STDTC, --STRF, --STRTPT] gates the rule out -> auditable skip instead of one finding per row under absent = all-missing (EC-43). Both rows WOULD fire were the gate removed. Verdict 2-1: the absence is itself reportable, and the minted sister PMDA-SD9720 reports it ONCE for this dataset."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE
S1 | AE | 001 | 2 | NAUSEA
