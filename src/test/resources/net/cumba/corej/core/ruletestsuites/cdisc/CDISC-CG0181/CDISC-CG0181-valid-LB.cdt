#!RuleTest
#test CDISC-CG0181 expect=noViolation domain=LB
# Rule:Description: Raise an error when LBORRES is populated with a non-quantitative result and the upper end of the reference range in original units (LBORNRHI) is populated. LBORNRHI should be populated only for continuous measurements; a quantitative (continuous) result is approximated by a numeric LBORRES value, optionally prefixed with a relational operator.
#note "numeric LBORRES is a continuous measurement -> no violation"
dataset LB label="Laboratory Tests Results"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col LBSEQ type=Num label="Sequence Number"
col LBORRES type=Char label="Result or Finding in Original Units"
col LBORNRHI type=Char label="Reference Range Upper Limit in Orig Unit"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | 12.5 | 20
---
