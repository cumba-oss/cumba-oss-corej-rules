#!RuleTest
#test CDISC-CG0624 expect=violation domain=LB
# Rule:Description: Raise an error when --RSTMOD is present in an Interventions or Findings class dataset, because this variable is not permitted in human clinical trials.
#note "LBRSTMOD column is present in LB, so the rule fires"
#expectViolationCount 1
#expectViolationAt row=1
dataset LB label="Laboratory Tests Results"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col LBSEQ type=Num label="Sequence Number"
col LBRSTMOD type=Char label="Method of Test or Examination Range"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 |
CDISCPILOT01 | LB | 01-701-1015 | 2 |
---
