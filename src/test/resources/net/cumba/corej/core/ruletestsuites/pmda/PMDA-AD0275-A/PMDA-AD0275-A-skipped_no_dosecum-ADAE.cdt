#!RuleTest
#test PMDA-AD0275-A expect=skipped domain=ADAE
#note "DOSECUM is not declared. The gate is load-bearing on THIS half: its Check is empty(DOSECUM) with a populated DOSECUMU, which on an absent DOSECUM column would fire on both rows. Requirements.Variables.All rejects the dataset instead - mirror of the parent's skipped_no_dosecumu fixture."
#library standard=adamig version=1-0
dataset ADAE
col STUDYID  type=Char
col USUBJID  type=Char
col AEDECOD  type=Char
col DOSECUMU type=Char
---
CDISCPILOT01 | 01-701-1015 | HEADACHE | mg
CDISCPILOT01 | 01-701-1023 | NAUSEA   | mg
