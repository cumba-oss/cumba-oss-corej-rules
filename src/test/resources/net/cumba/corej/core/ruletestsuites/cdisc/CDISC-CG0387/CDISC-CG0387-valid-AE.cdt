#!RuleTest
#test CDISC-CG0387 expect=noViolation domain=AE
# Rule:Description: Raise an error when AESER is populated and its value is not 'Y' or 'N'.
#note "AESER is populated only with valid codelist values Y and N"
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AESER type=Char label="Serious Event" format=$YN.
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | Y
CDISCPILOT01 | AE | 01-701-1015 | 2 | N
---
