#!RuleTest
#test CDISC-SEND-0340 expect=violation domain=DM
#note "PLAN-stopped-rule-engine-fixes item 1, the sensitivity arm: DM.AGEU has no comment at the variable level and only ONE of its two value-level entries (ARMCD=A) carries one - the ARMCD=B entry does not. Not every value is documented, so the variable is reported once, never once per record."
#library standard=sendig version=3-1-1
#library variable-metadata DM AGEU core=Exp
#define-xml CDISC-SEND-0340-vlm-partial-define.xml
#expectViolationCount 1
#expectViolationAt define_variable_name=AGEU
dataset DM
col STUDYID  type=Char
col USUBJID  type=Char
col ARMCD    type=Char
col AGEU     type=Char
---
S1 | S1-001 | A |
S1 | S1-002 | B |
