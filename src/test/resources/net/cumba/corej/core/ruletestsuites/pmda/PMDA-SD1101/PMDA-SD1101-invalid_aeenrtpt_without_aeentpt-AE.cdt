#!RuleTest
#test PMDA-SD1101 expect=violation domain=AE
#note "Shipped Check var_exists(\"--ENRTPT\") and not var_exists(\"--ENTPT\") resolves per the EC-36 prefix rule to AEENRTPT/AEENTPT; both leaves are dataset constants -> BroadcastFold -> exactly ONE violation reported at row=1 regardless of row count."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 nameOnly=AEENRTPT
dataset AE class=EVENTS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col AESEQ    type=Num
col AEENRTPT type=Char
---
S1 | AE | 001 | 1 | ONGOING
