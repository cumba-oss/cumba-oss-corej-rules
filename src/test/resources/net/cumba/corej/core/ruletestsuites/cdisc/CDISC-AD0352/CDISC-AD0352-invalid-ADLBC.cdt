#!RuleTest
#test CDISC-AD0352 expect=violation domain=ADLBC
# Rule:Description: AyIND is present and AyLO, AyHI, AyLOC, and AyHIC are all not present
#note "A1IND present, none of A1LO/A1HI/A1LOC/A1HIC present -> violation"
#expectViolationCount 1
#expectViolationAt nameOnly=A1IND
# Declared-tier scope: the class= declaration disagrees with the columns, so #define must
# carry it to RuleRunner (ScenarioDeclaredScopeProvider.install).
#define standard=adamig version=1-3
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col A1IND type=Char
---
CDISCPILOT01 | 01-701-1015 | NORMAL
---
