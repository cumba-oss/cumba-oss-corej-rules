#!RuleTest
#test CDISC-SEND-0403 expect=violation domain=FW
#note "PLAN-rprfdy-offset-tp-join: the RPRFDY offset is applied again, read from TP through DM.RPATHCD by read_value(RPRFDY, domain="TP", group=[DM.RPATHCD, RPHASE], mode="MAX") (owner EC-47 option B, C2, D-SJ, D-GUARD (b)), D-COPIES (D32 / D32a): DM carries subject 001 TWICE, on path A (RPRFDY 0) and path B (RPRFDY 1), so the DM join makes two copies of the one record and each copy reads its own path's offset. FWRPENDY 14 is conformant on the A copy (14 + 0) and REPORTED on the B copy (expected 15): one finding, from the second copy of row 1. Red-before on the W2b rule (no DM join, offset-free): silent."
#library standard=sendig-dart version=1-2
#expectViolationCount 1
#expectViolationAt row=1 FWRPENDY=14 DM.RPATHCD=B "$rprfdy"=1
dataset FW class=FINDINGS label="Food and Water Consumption"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col FWSEQ   type=Num  label="Sequence Number"
col RPHASE  type=Char label="Repro Phase"
col FWENDTC type=Char label="End Date/Time of Observation"
col FWRPENDY type=Num  label="Repro Phase Day of End of Observation"
---
S1 | FW | 001 | 1 | P1 | 2020-01-15 | 14
---
dataset SJ class="SPECIAL PURPOSE" label="Subject Repro Stages"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SJSEQ   type=Num  label="Sequence Number"
col RPHASE  type=Char label="Repro Phase"
col RSTAGE  type=Char label="Repro Stage"
col SJSTDTC type=Char label="Start Date/Time of Repro Stage"
col SJENDTC type=Char label="End Date/Time of Repro Stage"
---
S1 | SJ | 001 | 1 | P1 | STAGE1 | 2020-01-01 | 2020-01-20
---
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RPATHCD type=Char label="Planned Repro Path Code"
---
S1 | DM | 001 | A
S1 | DM | 001 | B
---
dataset TP class="TRIAL DESIGN" label="Trial Repro Paths"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col RPATHCD  type=Char label="Planned Repro Path Code"
col TPSTGORD type=Num  label="Order of Repro Stage within Repro Path"
col RSTGCD   type=Char label="Repro Stage Code"
col RSTAGE   type=Char label="Description of Repro Stage"
col RPHASE   type=Char label="Repro Phase"
col RPRFDY   type=Num  label="Repro Phase Start Reference Day"
---
S1 | TP | A | 1 | STG1 | Stg1 | P1 | 0
S1 | TP | B | 1 | STG1 | Stg1 | P1 | 1
---
