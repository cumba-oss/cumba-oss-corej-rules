#!RuleTest
#test CDISC-CG0459 expect=skipped domain=TS
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0459 (Condition: TSVAL not populated with values or synonyms of values in the ISO 21090 null flavor codelist (or other terms that can be represented as null flavors); Rule: TSVALNF = null). TSVALNF is withheld: Requirements.Variables.All [TSVALNF] is unmet, so there is no null-flavor value to test and the rule must skip."
#library standard=sdtmig version=3-3
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
CDISCPILOT01 | TS | 1 | AGEMIN | Planned Minimum Age of Subjects | P50Y
CDISCPILOT01 | TS | 1 | AGEMAX | Planned Maximum Age of Subjects | P85Y
