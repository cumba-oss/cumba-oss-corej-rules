#!RuleTest
#test CDISC-SEND-0235 expect=violation domain=TX
#note "SET01 carries TWO ARMCD records (grouped by STUDYID, SETCD) -> both ARMCD rows fire; SET02's single ARMCD record and the GRPLBL rows never do. W6 phase 0, scenarios-first: the rule had no scenario."
#library standard=sendig version=3-1-1
#expectViolationCount 2
#expectViolationAt row=1 SETCD=SET01 TXPARMCD=ARMCD
#expectViolationAt row=2 SETCD=SET01 TXPARMCD=ARMCD
dataset TX class="TRIAL DESIGN" label="Trial Sets"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col SETCD    type=Char label="Set Code"
col SET      type=Char label="Set Description"
col TXSEQ    type=Num  label="Sequence Number"
col TXPARMCD type=Char label="Trial Set Parameter Short Name"
col TXPARM   type=Char label="Trial Set Parameter"
col TXVAL    type=Char label="Trial Set Parameter Value"
---
S01 | TX | SET01 | Control | 1 | ARMCD | Arm Code | CTRL
S01 | TX | SET01 | Control | 2 | ARMCD | Arm Code | CTRL2
S01 | TX | SET01 | Control | 3 | GRPLBL | Group Label | Control
S01 | TX | SET02 | High Dose | 4 | ARMCD | Arm Code | HIGH
