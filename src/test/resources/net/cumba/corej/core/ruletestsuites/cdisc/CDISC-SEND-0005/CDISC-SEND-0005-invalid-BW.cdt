#!RuleTest
#test CDISC-SEND-0005 expect=violation domain=BW
#note "Define declares USUBJID, BWTESTCD (both known to the SENDIG -> silent) and BWFOO -- a name the SENDIG library does NOT declare (no variable-metadata line) and deliberately NOT a dataset column (universe pin). var_name(LIBRARY) for BWFOO is empty -> 'BWFOO' != '' fires."
#library standard=sendig version=3-1-1
#library variable-metadata BW USUBJID name=USUBJID
#library variable-metadata BW BWTESTCD name=BWTESTCD
#define-xml CDISC-SEND-0005-define.xml
#expectViolationCount 1
#expectViolationAt define_variable_name=BWFOO
dataset BW
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col BWSEQ    type=Num
col BWTESTCD type=Char
---
S1 | BW | 001 | 1 | BW
