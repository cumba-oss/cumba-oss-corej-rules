#!RuleTest
#test FDA-SD0080 expect=executionError domain=AE
#expect-execution-error "group= over 'DS' has no usable key"
#note "PLAN-join-key-one-side-absent-drop QK16 (b) / QK18 (owner 2026-10-11): DS without USUBJID - the domain= call's only group= member is on the evaluated side only, so no key member is left on both sides and the rule ERRORs (never an aggregate over the whole of DS). Derived from FDA-SD0080-invalid-AE.cdt with DS.USUBJID removed. A gate declaring DS.USUBJID would turn this into a SKIP."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESTDTC type=Char label="Start Date/Time of Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE | 2023-06-02
S1 | AE | 002 | 1 | NAUSEA   | 2023-06-15
---

dataset DS class=EVENTS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col DSSEQ   type=Num  label="Sequence Number"
col DSDECOD type=Char label="Standardized Disposition Term"
col DSSTDTC type=Char label="Start Date/Time of Disposition Event"
---
S1 | DS | 1 | RANDOMIZED | 2023-05-01
S1 | DS | 2 | COMPLETED  | 2023-06-01
S1 | DS | 1 | COMPLETED  | 2023-06-30

