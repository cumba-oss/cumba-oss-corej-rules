#!RuleTest
#test CDISC-AD0504 expect=noViolation domain=ADLBC
#note "PLAN-library-template-label-resolution (review H2): the former 'not ends_with DTM' conjunct is structural now - XDTM is governed by the longest published stem, *DTM, so var_name(\"LIBRARY\") is *DTM and this rule (*TM) does not judge it; CDISC-AD0505 does. Its label lacks 'Time' on purpose. ATM is the positive control: governed by *TM, its label contains 'Time'."
#library standard=adamig version=1-3
#library variable-metadata ADLBC *TM name=*TM label="{Time}"
#library variable-metadata ADLBC *DTM name=*DTM label="{Datetime}"
#expectViolationCount 0
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ATM type=Char label="Analysis Time"
col XDTM type=Char label="Foo"
---
CDISCPILOT01 | 01-701-1015 | ALB | x | y
---
