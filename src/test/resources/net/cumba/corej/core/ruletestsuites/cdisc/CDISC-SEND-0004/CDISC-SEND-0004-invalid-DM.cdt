#!RuleTest
#test CDISC-SEND-0004 expect=violation domain=DM
#note "Define declares AGE as integer (numeric) but the dataset submits AGE as Char -> type mismatch on AGE only. STUDYID/USUBJID are not declared in the define, so the not-empty(var_name(DEFINE)) applicability term excludes them; AGEU/SEX agree (text vs Char)."
#library standard=sendig version=3-1-1
#define variable-metadata DM AGE  name=AGE  simpleDatatype=integer label="Age"
#define variable-metadata DM AGEU name=AGEU simpleDatatype=text    label="Age Unit"
#define variable-metadata DM SEX  name=SEX  simpleDatatype=text    label="Sex"
#expectViolationCount 1
#expectViolationAt variable_name=AGE
dataset DM
col STUDYID type=Char
col USUBJID type=Char
col AGE     type=Char label="Age"
col AGEU    type=Char
col SEX     type=Char
---
S1 | S1-001 | 56 | WEEKS | M
