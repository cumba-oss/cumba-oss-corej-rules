#!RuleTest
#test CDISC-SEND-0290 expect=noViolation domain=LB
#note "ESCALATE -- do not re-aim: the discriminator for the --TESTCD member of the partition. Within ALB the key '1 HOUR' maps only to 1 and within GLUC only to 2. If the partition were ignored, '1 HOUR' would carry two dependents study-wide and ALL FOUR rows would fire; a report of 4 refutes it."
#library standard=sendig version=3-1-1
#expectViolationCount 0
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBTEST   type=Char label="Lab Test or Examination Name"
col LBORRES  type=Char label="Result or Finding in Original Units"
col LBTPT    type=Char label="Planned Time Point Name"
col LBTPTNUM type=Num  label="Planned Time Point Number"
---
S1 | LB | 001 | 1 | ALB  | Albumin | 41  | 1 HOUR | 1
S1 | LB | 002 | 1 | ALB  | Albumin | 39  | 1 HOUR | 1
S1 | LB | 001 | 2 | GLUC | Glucose | 5.4 | 1 HOUR | 2
S1 | LB | 002 | 2 | GLUC | Glucose | 5.1 | 1 HOUR | 2
---
