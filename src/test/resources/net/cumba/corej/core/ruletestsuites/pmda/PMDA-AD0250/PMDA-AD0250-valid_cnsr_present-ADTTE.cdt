#!RuleTest
#test PMDA-AD0250 expect=noViolation domain=ADTTE
#note "Isolates the not var_exists(\"CNSR\") conjunct: both descriptions are present, but so is CNSR, so a properly built time-to-event dataset carries the censoring variable and the rule executes without firing."
#library standard=adamig version=1-3
dataset ADTTE structure=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVAL     type=Num
col STARTDT  type=Num
col CNSR     type=Num
col EVNTDESC type=Char
col CNSDTDSC type=Char
---
CDISCPILOT01 | 01-701-1015 | TTDEATH | 120 | 21915 | 0 | DEATH | LASTCONTACT
CDISCPILOT01 | 01-701-1023 | TTDEATH | 300 | 21915 | 1 | ALIVE | WITHDRAWAL
