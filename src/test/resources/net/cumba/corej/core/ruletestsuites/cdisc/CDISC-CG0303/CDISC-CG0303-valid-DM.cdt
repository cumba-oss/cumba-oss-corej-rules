#!RuleTest
#test CDISC-CG0303 expect=noViolation domain=DM
#note "Every variable with a Library entry carries exactly the SDTMIG label -> no violation."
#library standard=sdtmig version=3-2
#library variable-metadata DM AGE  name=AGE  label="Age"
#library variable-metadata DM AGEU name=AGEU label="Age Units"
#library variable-metadata DM SEX  name=SEX  label="Sex"
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col AGE     type=Num  label="Age"
col AGEU    type=Char label="Age Units"
col SEX     type=Char label="Sex"
---
S1 | 001 | 56 | YEARS | M
