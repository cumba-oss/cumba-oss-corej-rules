#!RuleTest
#test PMDA-SD2019 expect=noViolation domain=DM
#note "AGETXT follows the 'number-number' format on rows 1/2; row 3 leaves it empty, which the non-empty leaf guards out."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AGETXT  type=Char label="Age Range"
col AGEU    type=Char label="Age Units"
---
CDISCPILOT01 | DM | 01-701-1015 | 25-30 | YEARS
CDISCPILOT01 | DM | 01-701-1023 | 6-11  | YEARS
CDISCPILOT01 | DM | 01-701-1034 |       | YEARS
