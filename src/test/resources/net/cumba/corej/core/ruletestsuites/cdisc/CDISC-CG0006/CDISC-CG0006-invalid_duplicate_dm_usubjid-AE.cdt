#!RuleTest
#test CDISC-CG0006 expect=executionError domain=AE
#note "PLAN-merged-evaluation-table W3f, OD-10: the DM join authors Cardinality n:1 on [STUDYID, USUBJID], so a DM carrying the subject twice is refused - the rule ERRORs naming DM, the key and the two rows, instead of evaluating one copy of the record per DM row. A duplicate DM is reported by the DM uniqueness rules (CG0151), not by every rule joining DM. Until W3f this was the D32 copies sensitivity arm of PLAN-function-surface-wave1 phase 2 (b): one finding from the copy paired with the second DM row."
#expect-execution-error "Cardinality n:1: DM has duplicate key (STUDYID=CDISCPILOT01, USUBJID=01-701-1015) at rows 1 and 2"
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AEDTC type=Char label="Date/Time of Collection"
col AEDY type=Num label="Study Day of Collection"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | 2020-01-10 | 10
---

dataset DM label=Demographics
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
---
CDISCPILOT01 | DM | 01-701-1015 | 2020-01-01
CDISCPILOT01 | DM | 01-701-1015 | 2020-01-05
---
