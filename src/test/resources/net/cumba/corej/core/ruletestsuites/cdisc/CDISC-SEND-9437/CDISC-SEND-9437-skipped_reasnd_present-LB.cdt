#!RuleTest
#test CDISC-SEND-9437 expect=skipped domain=LB
#note "The discriminator that keeps the family from double-reporting: the LBREASND column EXISTS (blank on the NOT DONE row), so Requirements.Variables.None [--REASND] skips this sister with a reason naming the column, and the parent CDISC-SEND-0280 owns the case, reporting row 1 with its location."
#library standard=sendig version=3-1-1
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBSTAT   type=Char label="Completion Status"
col LBREASND type=Char label="Reason Not Done"
---
S1 | LB | 001 | 1 | ALB | NOT DONE |
