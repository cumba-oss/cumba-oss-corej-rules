#!RuleTest
#test CDISC-AD0538 expect=noViolation domain=ADAE
# Rule:Description: SMQzzSCN is present and SMQzzSC is not present
#note "SMQ01SCN and SMQ01SC both present -> noViolation"
# Declared-tier scope: the class= declaration disagrees with the columns, so #define must
# carry it to RuleRunner (ScenarioDeclaredScopeProvider.install).
#define standard=adamig version=1-3
dataset ADAE class=OCCDS
col STUDYID type=Char
col USUBJID type=Char
col ASEQ type=Num
col SMQ01SCN type=Char
col SMQ01SC type=Char
---
CDISCPILOT01 | 01-701-1015 | 1 | Y | Y
---
