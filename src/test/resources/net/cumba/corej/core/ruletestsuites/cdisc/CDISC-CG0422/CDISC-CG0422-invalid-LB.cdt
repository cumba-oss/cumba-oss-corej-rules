#!RuleTest
#test CDISC-CG0422 expect=violation domain=LB
# Rule:Description: Raise an error when --STAT is populated and --ORRES is also populated, since --STAT (used to indicate the measurement was not done) must be empty when a result exists in --ORRES.
#note "LBORRES and LBSTAT are both populated on the same record, so the rule fires"
#expectViolationCount 1
#expectViolationAt row=1 LBSEQ=1 USUBJID=01-701-1015
dataset LB label="Laboratory Tests Results"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col LBSEQ type=Num label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBORRES type=Char label="Result or Finding in Original Units"
col LBSTAT type=Char label="Completion Status"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB | 3.8 | NOT DONE
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALP | 39 | 
---
