#!RuleTest
#test FDA-SD0014 expect=violation domain=CM
#note "The rule is class-scoped to INTERVENTIONS, so the generic --DOSE resolves to CMDOSE here as well; the negative CMDOSE on row 1 must be reported."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 CMDOSE=-1
dataset CM class=INTERVENTIONS label="Concomitant Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ   type=Num  label="Sequence Number"
col CMTRT   type=Char label="Reported Name of Drug, Med, or Therapy"
col CMDOSE  type=Num  label="Dose per Administration"
---
S1 | CM | 001 | 1 | ASPIRIN     | -1
S1 | CM | 001 | 2 | PARACETAMOL | 500
