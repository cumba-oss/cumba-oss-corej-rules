#!RuleTest
#test CDISC-CG0654 expect=violation domain=SV
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0654 (Condition: SVOCCUR ^= null; Rule: SVPRESP = "Y"). SVPRESP is not in the dataset, so no visit is pre-specified: row 1 populates SVOCCUR=Y -> fires; row 2 leaves SVOCCUR null -> silent."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015 VISITNUM=1
dataset SV class="SPECIAL PURPOSE" label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col SVSTDTC  type=Char label="Start Date/Time of Observation"
col SVOCCUR  type=Char label="Occurrence"
---
CDISCPILOT01 | SV | 01-701-1015 | 1 | SCREENING 1 | 2013-12-26 | Y
CDISCPILOT01 | SV | 01-701-1015 | 2 | BASELINE | 2014-01-02 | 
