#!RuleTest
#test PMDA-SD2270 expect=violation domain=LB
#note "var_exists(\"--DY\") and not var_exists(\"--DTC\") -> broadcast fires ONCE at row=1. Numeric pin compares numerically (LBDY Num)."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 nameOnly=LBDY
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
col LBDY     type=Num
---
S1 | LB | 001 | 1 | GLUC | 5
---
