#!RuleTest
#test PMDA-SD1354 expect=skipped domain=DM
#note "FRESH - the batch's Domains.Include reject pin (Include [TA]). The domain axis rejects before any operation resolution - no second dataset block needed."
#library standard=sdtmig version=3-4
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARMCD    type=Char label="Planned Arm Code"
col ARM      type=Char label="Description of Planned Arm"
---
CDISCPILOT01 | DM | 01-001 | PBO | Placebo
