#!RuleTest
#test PMDA-SD0091 expect=violation domain=AE
#note "Boundary: a death-related event (AESDTH='Y') with an empty AEOUT does not equal 'FATAL', so the rule must fire (row 1). Row 2 is the conformant pair."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 AEOUT= AESDTH=Y
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEOUT   type=Char label="Outcome of Adverse Event"
col AESDTH  type=Char label="Results in Death"
---
S1 | AE | 001 | 1 | CARDIAC ARREST |       | Y
S1 | AE | 002 | 1 | SEPSIS         | FATAL | Y
