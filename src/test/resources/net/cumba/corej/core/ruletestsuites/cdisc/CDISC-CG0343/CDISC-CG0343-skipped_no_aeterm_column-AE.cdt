#!RuleTest
#test CDISC-CG0343 expect=skipped domain=AE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0343 (Rule: --TERM ^= 'OTHER'). The AE dataset carries no AETERM column; Requirements.Variables.All [--TERM] is unmet, so the rule must skip rather than evaluate an absent column."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AEDECOD type=Char label="Dictionary-Derived Term"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | Headache
---
