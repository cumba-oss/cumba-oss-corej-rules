#!RuleTest
#test CDISC-SEND-0378-B expect=skipped domain=TT
#note "DISCRIMINATOR (R-5.26): TTDUR is not in the dataset either, so Requirements.Variables.All [TTDUR] is unmet and this sibling SKIPS - the neither-column state belongs to the dataset sister CDISC-SEND-9441, which reports it once."
#library standard=sendig-dart version=1-2
dataset TT class="TRIAL DESIGN" label="Trial Repro Stages"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col RSTGCD  type=Char label="Repro Stage Code"
col RSTAGE  type=Char label="Description of Repro Stage"
---
S1 | TT | ST1 | Premating
S1 | TT | ST2 | Gestation
