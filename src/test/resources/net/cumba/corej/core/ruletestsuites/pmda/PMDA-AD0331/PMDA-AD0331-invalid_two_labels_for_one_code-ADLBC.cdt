#!RuleTest
#test PMDA-AD0331 expect=violation domain=ADLBC
#note "Group (PARAMCD=ALB, CHGCAT1N=1) holds CHGCAT1 {INCREASE x2, RISE x1} -> row 3 is the minority. Naming trap: CHGCATy compiles to CHGCAT(digits)$ and CHGCATyN to CHGCAT(digits)N$ -- CHGCAT1N does NOT match the first pattern (anchored), so exactly one expansion (y=1) is produced."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 CHGCAT1=RISE CHGCAT1N=1 PARAMCD=ALB
dataset ADLBC class=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col CHGCAT1  type=Char
col CHGCAT1N type=Num
---
S1 | 001 | ALB | INCREASE | 1
S1 | 002 | ALB | INCREASE | 1
S1 | 003 | ALB | RISE     | 1
S1 | 004 | ALB | DECREASE | 2
S1 | 005 | ALB | DECREASE | 2
