#!RuleTest
#test CDISC-SEND-0194 expect=executionError domain=PC
#expect-execution-error "PCLLOQ is declared Char"
#note "R7 (PLAN-column-type-conformance): PCLLOQ shipped as Char is nonconformant data (SENDIG declares it Num). The migrated comparison num(PCORRES) < PCLLOQ reads PCLLOQ in a numeric order comparison, so per R4 the engine must ERROR rather than silently compare against a text limit. PCSTRESC is a plain numeric string so the BLQ witness cannot short-circuit the limit read."
#library standard=sendig version=3-1-1
dataset PC class=FINDINGS label="Pharmacokinetic Concentrations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PCSEQ    type=Num  label="Sequence Number"
col PCTESTCD type=Char label="Test Short Name"
col PCORRES  type=Char label="Result or Finding in Original Units"
col PCLLOQ   type=Char label="Lower Limit of Quantitation"
col PCSTRESC type=Char label="Character Result/Finding in Std Format"
col PCSTRESN type=Num  label="Numeric Result/Finding in Std Units"
---
S1 | PC | S1-001 | 1 | DRUGX | 0.04 | 0.1 | 0.04 | 0.04
