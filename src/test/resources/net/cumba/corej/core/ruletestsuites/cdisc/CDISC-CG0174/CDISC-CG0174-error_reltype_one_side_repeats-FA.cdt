#!RuleTest
#test CDISC-CG0174 expect=executionError domain=FA
# Rule:Description: Raise an error when a related record is present in the parent domain dataset but FAOBJ does not equal the --TERM, --TRT or --DECOD value of that parent record.
#note "PLAN-merged-evaluation-table W5 (OD-5, OD-9): a dataset-level relationship's RELTYPE states the IG's cardinality — AE ONE, FA MANY — and the ONE side is checked within the relationship. AE carries AELNKID L1 twice, so one FA record relates to two AE records on the ONE side: the merge is refused and the rule ERRORs naming AE. Before W5 the expander paired every combination silently (two findings on FA 2)."
#expect-execution-error "Cardinality"
dataset FA label="Findings About"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col FASEQ type=Num label="Sequence Number"
col FALNKGRP type=Char label="Link Group"
col FAOBJ type=Char label="Object of the Observation"
---
S1 | FA | 01 | 1 | L1 | ERYTHEMA
S1 | FA | 01 | 2 | L1 | PAIN
---

dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AELNKID type=Char label="Link ID"
col AETERM type=Char label="Reported Term for the Adverse Event"
col AEDECOD type=Char label="Dictionary-Derived Term"
---
S1 | AE | 01 | 1 | L1 | ERYTHEMA | ERYTHEMA
S1 | AE | 01 | 2 | L1 | RASH | RASH
---

dataset RELREC label="Related Records"
col STUDYID type=Char label="Study Identifier"
col RDOMAIN type=Char label="Related Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col IDVAR type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col RELTYPE type=Char label="Relationship Type"
col RELID type=Char label="Relationship Identifier"
---
S1 | AE |  | AELNKID |  | ONE | AEFA
S1 | FA |  | FALNKGRP |  | MANY | AEFA
---
