#!RuleTest
#test CDISC-CG0411 expect=violation domain=SUPPDM
#note "Rule round 2026-10-12 (owner, queued item C3, as c5206c02): RDOMAIN names a domain, and dataset names match case-insensitively (owner 2026-10-01), so the literal comparison reads upper(RDOMAIN). Copy of CDISC-CG0411-invalid-dm-SUPPDM.cdt with the RDOMAIN cells lower-cased; the expected outcome is the original one. Red under the old exact comparison."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 QNAM=RACEOTH
#expectViolationAt row=2 QNAM=RACEOTH
dataset SUPPDM class=RELATIONSHIP label="Supplemental Qualifiers for DM"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM     type=Char label="Qualifier Variable Name"
col QVAL     type=Char label="Data Value"
---
S1 | dm | 001 |  |  | RACEOTH | Other race A
S1 | dm | 001 |  |  | RACEOTH | Other race B
S1 | dm | 002 |  |  | RACEOTH | Other race
