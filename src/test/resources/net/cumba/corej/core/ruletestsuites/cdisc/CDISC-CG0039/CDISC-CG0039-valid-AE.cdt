#!RuleTest
#test CDISC-CG0039 expect=noViolation domain=AE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0039 (Condition: Primary SOC used for analysis; Rule: --BODSYS = --SOC). Every record carries the primary SOC in both AEBODSYS and AESOC -> silent."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEDECOD  type=Char label="Dictionary-Derived Term"
col AEBODSYS type=Char label="Body System or Organ Class"
col AESOC    type=Char label="Primary System Organ Class"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE | HEADACHE | NERVOUS SYSTEM DISORDERS | NERVOUS SYSTEM DISORDERS
CDISCPILOT01 | AE | 01-701-1023 | 1 | NAUSEA | NAUSEA | GASTROINTESTINAL DISORDERS | GASTROINTESTINAL DISORDERS
