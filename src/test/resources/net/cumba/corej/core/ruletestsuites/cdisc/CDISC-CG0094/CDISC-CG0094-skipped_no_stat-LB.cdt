#!RuleTest
#test CDISC-CG0094 expect=skipped domain=LB
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0094 (Condition: --REASND ^= null; Rule: --STAT = 'NOT DONE'). LBSTAT is withheld: Requirements.Variables.All [--REASND, --STAT] is unmet -> skip (row 1 would otherwise be judged against an absent LBSTAT)."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBREASND type=Char label="Reason Test Not Done"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | K | SAMPLE HEMOLYZED
