#!RuleTest
#test CDISC-SEND-0402 expect=noViolation domain=EX
#note "Written FIRST in runbook W2b (PLAN-operation-replacements §8, date_diff_days composed from min_date), on the pre-change engine. The earliest SJSTDTC of the phase is on the SECOND SJ row (STAGE2 row first, 2020-01-11; STAGE1 row second, 2020-01-01), so a reference taken from the first row in file order would give 4 and fire. EXSTDTC 2020-01-15 minus the earliest 2020-01-01 is 14, which EXRPSTDY carries -> silent. Pins that the reference is the group's minimum, not its first record, across the move from the operation's grouped subtrahend to min_date(SJSTDTC, domain=SJ, group=[USUBJID, RPHASE])."
#library standard=sendig-dart version=1-2
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col RPHASE  type=Char label="Repro Phase"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
col EXRPSTDY type=Num label="Repro Phase Day of Start of Treatment"
---
S1 | EX | 001 | 1 | P1 | 2020-01-15 | 14
---

dataset SJ class="SPECIAL PURPOSE" label="Subject Repro Stages"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SJSEQ   type=Num  label="Sequence Number"
col RPHASE  type=Char label="Repro Phase"
col RSTAGE  type=Char label="Repro Stage"
col SJSTDTC type=Char label="Start Date/Time of Repro Stage"
col SJENDTC type=Char label="End Date/Time of Repro Stage"
---
S1 | SJ | 001 | 2 | P1 | STAGE2 | 2020-01-11 | 2020-01-20
S1 | SJ | 001 | 1 | P1 | STAGE1 | 2020-01-01 | 2020-01-10
---
