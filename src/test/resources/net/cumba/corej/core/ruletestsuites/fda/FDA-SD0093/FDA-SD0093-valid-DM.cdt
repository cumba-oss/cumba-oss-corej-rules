#!RuleTest
#test FDA-SD0093 expect=noViolation domain=DM
#note "Every subject with a populated AGE also carries AGEU; the third subject has neither."
#library standard=sdtmig version=3-1-2
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col AGE     type=Num  label="Age"
col AGEU    type=Char label="Age Units"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015 | 56 | YEARS
CDISCPILOT01 | DM | 01-701-1023 | 1023 | 63 | YEARS
CDISCPILOT01 | DM | 01-701-1028 | 1028 |    |
