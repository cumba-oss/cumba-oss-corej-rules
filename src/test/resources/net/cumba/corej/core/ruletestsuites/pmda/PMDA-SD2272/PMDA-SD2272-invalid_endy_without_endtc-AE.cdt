#!RuleTest
#test PMDA-SD2272 expect=violation domain=AE
#note "var_exists(\"--ENDY\") and not var_exists(\"--ENDTC\") -> broadcast fires ONCE at row=1."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 nameOnly=AEENDY
dataset AE class=EVENTS label="Adverse Events"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col AESEQ    type=Num
col AETERM   type=Char
col AEENDY   type=Num
---
S1 | AE | 001 | 1 | HEADACHE | 9
