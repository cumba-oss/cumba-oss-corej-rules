#!RuleTest
#test CDISC-CG0549 expect=noViolation domain=LB
#note "LBORREF is not in the dataset (rule round 2026-10-12, var_exists sweep): its `not empty(X)` disjunct is false on an absent column. The derived record (LBDRVFL = Y) carries LBSTREFC, the other has no reference result -> no violation."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBDRVFL  type=Char label="Derived Flag"
col LBSTREFC type=Char label="Reference Result in Standard Format"
---
S1 | LB | 001 | 1 | GLUC | Y | NEGATIVE
S1 | LB | 001 | 2 | ALB  |   |
