#!RuleTest
#test FDA-SD0004 expect=noViolation domain=LBCH
#note "Boundary: a split dataset LBCH still begins with its DOMAIN value 'LB'. Only the first two characters are compared, so a legitimate split name must not be reported."
#library standard=sdtmig version=3-4
dataset LBCH class=FINDINGS label="Laboratory Test Results - Chemistry"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
---
S1 | LB | 001 | 1 | ALB
S1 | LB | 001 | 2 | GLUC
