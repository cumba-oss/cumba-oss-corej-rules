#!RuleTest
#test CDISC-AD0337 expect=noViolation domain=ADLBC
# Rule:Description: MCRITyML is present and MCRITy is not present
#note "MCRIT1ML present and MCRIT1 also present -> noViolation"
# Declared-tier scope: the class= declaration disagrees with the columns, so #define must
# carry it to RuleRunner (ScenarioDeclaredScopeProvider.install).
#define standard=adamig version=1-3
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col MCRIT1ML type=Char
col MCRIT1 type=Char
---
CDISCPILOT01 | 01-701-1015 | X | X
