#!RuleTest
#test PMDA-AD0473 expect=violation domain=ADSL
#note "Mirror of AD0472: target is the numeric STRAT1RN, key is the label STRAT1R. Group STRAT1R=REGIONA holds STRAT1RN {1 x2, 2 x1} -> row 3 is the lone minority; group REGIONB holds one value and is silent. One expansion (w=1)."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 STRAT1R=REGIONA STRAT1RN=2
dataset ADSL
col STUDYID  type=Char
col USUBJID  type=Char
col STRAT1R  type=Char
col STRAT1RN type=Num
---
S1 | 001 | REGIONA | 1
S1 | 002 | REGIONA | 1
S1 | 003 | REGIONA | 2
S1 | 004 | REGIONB | 3
