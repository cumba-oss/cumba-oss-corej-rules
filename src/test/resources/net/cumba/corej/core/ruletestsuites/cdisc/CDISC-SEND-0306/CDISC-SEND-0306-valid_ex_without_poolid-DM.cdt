#!RuleTest
#test CDISC-SEND-0306 expect=noViolation domain=DM
#note "PLAN-scalar-date-extremes: EX has NO POOLID column; POOLDEF assigns 001 to P1 and carries a second row for 001 with a BLANK POOLID; own EXENDTC 001 2020-01-05, 002 2020-01-10; RFXENDTC = each own latest -> silent. Pin of the pool binding's filter=(not empty(POOLID)): without it all EX rows are one block keyed blank, which the blank-POOLID POOLDEF row takes as 001's pool part (latest 2020-01-10) -> 001 reported. The 7 filter sabotage reds this scenario."
#library standard=sendig version=3-1-1
dataset DM label=Demographics
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFXENDTC type=Char label="Date/Time of Last Study Treatment"
---
S1 | DM | 001 | 2020-01-05
S1 | DM | 002 | 2020-01-10
---
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
col EXENDTC type=Char label="End Date/Time of Treatment"
---
S1 | EX | 001 | 1 | DRUG A | 2020-01-01 | 2020-01-05
S1 | EX | 002 | 2 | DRUG A | 2020-01-01 | 2020-01-10
---
dataset POOLDEF label="Pool Definition"
col STUDYID type=Char label="Study Identifier"
col POOLID  type=Char label="Pool Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
---
S1 | P1 | 001
S1 |  | 001
---
