#!RuleTest
#test PMDA-SD1018 expect=skipped domain=SV
#note "GATED 2026-09-11 (wave D, T1-40): All grows [VISITNUM] -> [VISITNUM, SVUPDES], so this SVUPDES-less dataset takes one auditable skip naming the column -- before the gate the bare empty(SVUPDES) leaf was TRUE on every row (absent = all-missing, EC-43), every visit counted as planned, and row 2's unmatched triple fired. The check is NOT lost: the R-5.25 split sibling PMDA-SD1018-A re-derives planned-ness from the VISIT name and reports row 2 (WEEK2 is planned-looking) on this same data."
#library standard=sdtmig version=3-4
dataset SV label="Subject Visits"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col VISITNUM type=Num
col VISIT    type=Char
col VISITDY  type=Num
---
CDISCPILOT01 | SV | 01-701-1015 | 1 | SCREENING | -7
CDISCPILOT01 | SV | 01-701-1015 | 3 | WEEK2     | 15
---

dataset TV label="Trial Visits"
col STUDYID  type=Char
col DOMAIN   type=Char
col VISITNUM type=Num
col VISIT    type=Char
col VISITDY  type=Num
---
CDISCPILOT01 | TV | 1 | SCREENING | -7
CDISCPILOT01 | TV | 2 | BASELINE  | 1
---
