#!RuleTest
#test FDA-SE2239 expect=noViolation domain=CL
#note "CLTEST and CLCAT are not in the dataset (rule round 2026-10-12, var_exists sweep): a populated CLRESCAT never equals an absent column's empty value, so the removed guards changed nothing; CLRESCAT differs from CLSCAT -> no violation."
#library standard=sendig version=3-1-1
dataset CL label="Clinical Observations"
col STUDYID  type=Char label="Study Identifier"
col USUBJID  type=Char label="Unique Subject Identifier"
col CLSEQ    type=Num  label="Sequence Number"
col CLTESTCD type=Char label="Clinical Observation Short Name"
col CLSCAT   type=Char label="Subcategory for Clinical Observation"
col CLRESCAT type=Char label="Result Category"
---
S1 | 001 | 1 | CLSIGN | SKIN | ERYTHEMA
S1 | 001 | 2 | CLSIGN | SKIN |
