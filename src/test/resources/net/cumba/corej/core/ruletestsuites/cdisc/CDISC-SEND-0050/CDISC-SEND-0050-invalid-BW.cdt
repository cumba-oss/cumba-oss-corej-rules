#!RuleTest
#test CDISC-SEND-0050 expect=violation domain=BW
#note "BWTESTCD's define ItemDef carries a CodeListRef to a sponsor codelist that has CodeListItems but no <Alias Context=nci:ExtCodeID> -> var_codelist(DEFINE) non-empty but var_ccode(DEFINE) empty -> fires: the define's codelist does not reference the published CT."
#library standard=sendig version=3-1-1
#library variable-metadata BW BWTESTCD name=BWTESTCD codelist=C90001
#library variable-metadata BW USUBJID name=USUBJID
#define-xml CDISC-SEND-0050-define.xml
#expectViolationCount 1
#expectViolationAt define_variable_name=BWTESTCD library_variable_codelist=C90001
dataset BW
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col BWSEQ    type=Num
col BWTESTCD type=Char
---
S1 | BW | 001 | 1 | BW
