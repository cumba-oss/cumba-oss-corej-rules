#!RuleTest
#test CDISC-CG0148 expect=executionError domain=DM
#expect-execution-error "group= over 'EX' has no usable key"
#note "PLAN-join-key-one-side-absent-drop QK16 (b) / QK18 (owner 2026-10-11): EX without USUBJID - the domain= call's only group= member is on the evaluated side only, so no key member is left on both sides and the rule ERRORs (never an aggregate over the whole of EX). Derived from CDISC-CG0148-typed_equality_probes-DM.cdt with EX.USUBJID removed. A gate declaring EX.USUBJID would turn this into a SKIP."
dataset DM label=Demographics
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFXSTDTC type=Char label="Date/Time of First Study Treatment"
---
S1 | DM | P1 | 2026-03-15
S1 | DM | P2 | 2026-01-01
S1 | DM | P3 | 2026-01-01T11:00+02:00
S1 | DM | P4 | 2026-02-99
---

dataset EX label=Exposure
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
col EXENDTC type=Char label="End Date/Time of Treatment"
---
S1 | EX | 2026-01-01 | 2026-01-10
S1 | EX | 2026-01-01T09:00 | 2026-01-10
S1 | EX | 2026-01-01T09:00 | 2026-01-10
S1 | EX | 2026-01-01 | 2026-01-10
---
