#!RuleTest
#test PMDA-AD0272 expect=noViolation domain=ADAE
#note "Both extra columns populated with a non-Y value; AOCC01F fails the trailing FL$ anchor and OCCFL fails the leading ^AOCC anchor, so neither fires. Pins that .* is breadth in the middle only - anchors still hold."
#library standard=adamig version=1-3
dataset ADAE
col STUDYID type=Char
col USUBJID type=Char
col AEDECOD type=Char
col AOCC01F type=Char
col OCCFL   type=Char
---
CDISCPILOT01 | 01-701-1015 | HEADACHE | N | N
