#!RuleTest
#test CDISC-SEND-0306 expect=noViolation domain=DM
#note "PLAN-scalar-date-extremes (T2 review B-M2): Pool-only subject; pool P1 has TWO EX rows, (EXSTDTC 2019-12-30, EXENDTC 2020-01-01) and (EXSTDTC 2020-01-03, EXENDTC 2020-01-05); RFXENDTC 2020-01-05. The per-pool EXENDTC extreme is the LATER row (the inner max_date) -> RFXENDTC equals it -> silent (the EXSTDTC conjunct, 2020-01-03, fires alone). Pins the inner call's direction: were the earlier row taken (2020-01-01), both conjuncts would fire and the row would be reported."
#library standard=sendig version=3-1-1
dataset DM label=Demographics
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFXENDTC type=Char label="Date/Time of Last Study Treatment"
---
S1 | DM | 001 | 2020-01-05
---
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col POOLID  type=Char label="Pool Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
col EXENDTC type=Char label="End Date/Time of Treatment"
---
S1 | EX |  | P1 | 1 | DRUG A | 2019-12-30 | 2020-01-01
S1 | EX |  | P1 | 2 | DRUG A | 2020-01-03 | 2020-01-05
---
dataset POOLDEF label="Pool Definition"
col STUDYID type=Char label="Study Identifier"
col POOLID  type=Char label="Pool Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
---
S1 | P1 | 001
---
