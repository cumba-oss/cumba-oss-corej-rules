#!RuleTest
#test PMDA-SD1036 expect=violation domain=CP
#note "CP is in PMDA's sheet Domains list only - FDA-SD1036 would not run here (discriminator). --TOX/--TOXGR are Findings model class variables (model-permissible on CP). Row 1: CPTOX populated with CPTOXGR empty -> fires. Row 2: both empty -> clean."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 CPTOX=Neurotoxicity
dataset CP class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col CPSEQ    type=Num
col CPTESTCD type=Char
col CPTOX    type=Char
col CPTOXGR  type=Char
---
S1 | CP | 001 | 1 | CD4 | Neurotoxicity |
S1 | CP | 001 | 2 | CD4 |                |
