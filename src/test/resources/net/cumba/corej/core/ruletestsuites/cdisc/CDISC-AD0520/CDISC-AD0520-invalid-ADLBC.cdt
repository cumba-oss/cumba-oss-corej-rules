#!RuleTest
#test CDISC-AD0520 expect=violation domain=ADLBC
# Rule:Description: A variable ending in ETMF must have a label that ends with "Imputation Flag" (or "Imput. Flag") and contains "End" and "Time"
#note "AETMF has no Imputation-Flag suffix; BETMF lacks "End"; CETMF lacks "Time"; DETMF carries the phrase but not at the END; EETMF differs only in CASE. TR1ETMF, TRTETMF, TR01ETMF and TR99ETMF all carry the SAME label, and only the library tells them apart: TRTETMF is the ADSL literal TRTETMF and TR01ETMF / TR99ETMF match the ADSL template TRxxETMF (D9, PLAN-library-template-label-resolution), so they are no stem case - label_template(\"LIBRARY\", stem=\"*ETMF\") answers a missing for them (R2-3) - and the rule does not judge them; the near-miss TR1ETMF (one digit) matches no template, falls to the *ETMF stem and still fires."
#expectViolationCount 6
#expectViolationAt variable_label="End Time Flag" variable_name=AETMF
#expectViolationAt variable_label="Analysis Time Imput. Flag" variable_name=BETMF
#expectViolationAt variable_label="Analysis End Imput. Flag" variable_name=CETMF
#expectViolationAt variable_label="End Time Imputation Flag Extra" variable_name=DETMF
#expectViolationAt variable_label="Analysis End Time imputation Flag" variable_name=EETMF
#expectViolationAt variable_label="Time of Last Exposure Imput. Flag" variable_name=TR1ETMF
#library standard=adamig version=1-3
#library variable-metadata ADLBC *ETMF name=*ETMF label="{End Time Imputation Flag}"
#library variable-metadata ADLBC *TMF name=*TMF label="{Time Imputation Flag}"
#library variable-metadata ADSL TRTETMF name=TRTETMF label="Time of Last Exposure Imput. Flag"
#library variable-metadata ADSL TRxxETMF name=TRxxETMF label="Time Last Exposure Period xx Imput. Flag"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AETMF type=Char label="End Time Flag"
col BETMF type=Char label="Analysis Time Imput. Flag"
col CETMF type=Char label="Analysis End Imput. Flag"
col DETMF type=Char label="End Time Imputation Flag Extra"
col EETMF type=Char label="Analysis End Time imputation Flag"
col TR1ETMF type=Char label="Time of Last Exposure Imput. Flag"
col TRTETMF type=Char label="Time of Last Exposure Imput. Flag"
col TR01ETMF type=Char label="Time of Last Exposure Imput. Flag"
col TR99ETMF type=Char label="Time of Last Exposure Imput. Flag"
---
CDISCPILOT01 | 01-701-1015 | ALB | x | x | x | x | x | x | x | x | x
---
