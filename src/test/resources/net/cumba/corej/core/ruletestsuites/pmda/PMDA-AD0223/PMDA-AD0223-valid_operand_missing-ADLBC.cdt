#!RuleTest
#test PMDA-AD0223 expect=noViolation domain=ADLBC
#note "Every row would be arithmetically wrong if the blanks counted as zero, but ExprCompiler skips any row on which the compared variable or either operand is missing, so all three rows are silent. This is how the sheet's 'when all 3 variables are populated' is realised WITHOUT an authored guard - and the reason no guard is proposed."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col BASE    type=Num
col CHG     type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | 10 |   | 5
CDISCPILOT01 | 01-701-1023 | ALB |    | 4 | 5
CDISCPILOT01 | 01-701-1034 | ALB | 10 | 4 |
