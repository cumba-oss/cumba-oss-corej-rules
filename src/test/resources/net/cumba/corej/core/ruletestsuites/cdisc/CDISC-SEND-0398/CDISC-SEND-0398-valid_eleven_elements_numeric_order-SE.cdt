#!RuleTest
#test CDISC-SEND-0398 expect=noViolation domain=SE
#library standard=sendig version=3-1-1
#note "Eleven elements in file order 1, 10, 11, 2, 3, 4, 5, 6, 7, 8, 9: each SEENDTC equals the next element's SESTDTC, a clean chain only in NUMERIC SESEQ order. Ordered by the key's text (1, 10, 11, 2, ...) under relation <= the 1->10 jump still corresponds, but 11->2 (SEENDTC after the next SESTDTC) fires; PLAN-by-key-numeric-order (CellOrder by= key)."
dataset SE label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ   type=Num  label="Sequence Number"
col SESTDTC type=Char label="Start Date/Time of Element"
col SEENDTC type=Char label="End Date/Time of Element"
---
