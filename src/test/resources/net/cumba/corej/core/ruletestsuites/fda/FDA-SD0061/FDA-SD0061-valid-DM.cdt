#!RuleTest
#test FDA-SD0061 expect=noViolation domain=DM
#note "Both datasets the Define-XML declares (DM, AE) are present in the study -> no violation."
#library standard=sdtmig version=3-4
#define-xml FDA-SD0061-define.xml
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
S1 | DM | S1-001
---

dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AETERM  type=Char label="Reported Term for the Adverse Event"
---
S1 | AE | S1-001 | HEADACHE
