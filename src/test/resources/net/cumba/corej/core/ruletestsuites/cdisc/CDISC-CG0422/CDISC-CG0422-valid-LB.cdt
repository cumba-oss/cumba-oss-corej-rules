#!RuleTest
#test CDISC-CG0422 expect=noViolation domain=LB
# Rule:Description: Raise an error when --STAT is populated and --ORRES is also populated, since --STAT (used to indicate the measurement was not done) must be empty when a result exists in --ORRES.
#note "no record has both LBORRES and LBSTAT populated, so the rule does not fire"
dataset LB label="Laboratory Tests Results"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col LBSEQ type=Num label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBORRES type=Char label="Result or Finding in Original Units"
col LBSTAT type=Char label="Completion Status"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB | 3.8 |
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALP |     | NOT DONE
---
