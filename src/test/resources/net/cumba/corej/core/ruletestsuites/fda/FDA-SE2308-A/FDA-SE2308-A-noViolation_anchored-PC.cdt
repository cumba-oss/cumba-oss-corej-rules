#!RuleTest
#test FDA-SE2308-A expect=noViolation domain=PC
#note "Negative control: every record carries at least one populated day anchor (row 1 PCNOMDY, row 2 VISITDY) -> silent."
#library standard=sendig version=3-1
#expectViolationCount 0
dataset PC class=FINDINGS label="Pharmacokinetics Concentrations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PCSEQ    type=Num  label="Sequence Number"
col VISITDY type=Num  label="Planned Study Day of Visit"
col PCNOMDY type=Num  label="Nominal Study Day for Tabulations"
col PCELTM  type=Char label="Planned Elapsed Time from Time Point Ref"
---
S1 | PC | 001 | 1 | . | 1 | PT0H
S1 | PC | 001 | 2 | 3 | . | PT1H
