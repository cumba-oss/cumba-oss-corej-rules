#!RuleTest
#test CDISC-CG0313 expect=noViolation domain=AE
#note "R-5.25 wave-3 group K split of CG0313 (each missing key variable is its own defect): negative control - STUDYID is present (as are the other key variables, which are the siblings' subjects)."
#library standard=sdtmig version=3-2
#expectViolationCount 0
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
---
S1 | AE | 001 | 1 | Headache
