#expectViolationAt row=3 USUBJID=01-701-1034 PARAMCD=GLUC ATPT=WEEK2 ATPTN=3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ATPT    type=Char
col ATPTN   type=Num
