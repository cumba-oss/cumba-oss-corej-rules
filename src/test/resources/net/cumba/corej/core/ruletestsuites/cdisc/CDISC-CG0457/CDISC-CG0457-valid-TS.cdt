#!RuleTest
#test CDISC-CG0457 expect=noViolation domain=TS
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0457 (Condition: TSPARMCD = 'ACTSUB'; Rule: TSVAL is integer and > 0). The ACTSUB record carries TSVAL=287, a positive integer; the other parameters (free text and an ISO 8601 duration) are outside the Condition. TSPARMCD and TSVAL are present, so the rule executes and does not fire."
#library standard=sdtmig version=3-3
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
col TSVALNF  type=Char label="Parameter Null Flavor"
---
CDISCPILOT01 | TS | 1 | TITLE | Trial Title | A Study of Xanomeline |
CDISCPILOT01 | TS | 1 | ACTSUB | Actual Number of Subjects | 287 |
CDISCPILOT01 | TS | 1 | AGEMIN | Planned Minimum Age of Subjects | P50Y |
---
