#!RuleTest
#test CDISC-SEND-0112.1 expect=violation domain=DM
#note "PLAN-stopped-rule-engine-fixes item 1, the sensitivity arm: DM.AGE has no method at the variable level and only ONE of its two value-level entries (AGEU=WEEKS) carries one - the AGEU=DAYS entry does not. Not every value is documented, so the variable is reported once, never once per record."
#library standard=sendig version=3-1-1
#define-xml CDISC-SEND-0112.1-vlm-partial-define.xml
#expectViolationCount 1
#expectViolationAt variable_name=AGE
dataset DM
col STUDYID  type=Char
col USUBJID  type=Char
col AGE      type=Num
col AGEU     type=Char
---
S1 | S1-001 | 56 | WEEKS
S1 | S1-002 | 70 | DAYS
