#!RuleTest
#test CDISC-AD0711 expect=noViolation domain=ADLBC
# Rule:Description: A variable with a suffix of PFL has a value that is not Y, N, or null
#note "MYPFL value "Y" is in the allowed set -> noViolation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col MYPFL type=Char
---
CDISCPILOT01 | 01-701-1015 | ALB | Y
---
