#!RuleTest
#test CDISC-CG0658 expect=violation domain=SV
# Rule:Description: Raise an error when SVPRESP is empty and VISITDY is populated. VISITDY is the Planned Study Day of a visit and should not be populated for unplanned visits.
#note "SVSEQ=1 has VISITDY populated while SVPRESP is empty, so the rule fires"
#expectViolationCount 1
#expectViolationAt row=1 SVSEQ=1 USUBJID=01-701-1015
dataset SV label="Subject Visits"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SVSEQ type=Num label="Sequence Number"
col VISITDY type=Num label="Planned Study Day of Visit"
col SVPRESP type=Char label="Pre-Specified"
---
CDISCPILOT01 | SV | 01-701-1015 | 1 | 1 |
CDISCPILOT01 | SV | 01-701-1015 | 2 | 14 | Y
---
