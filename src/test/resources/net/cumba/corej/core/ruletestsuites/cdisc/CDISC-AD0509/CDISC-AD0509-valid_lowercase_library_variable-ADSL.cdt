#!RuleTest
#test CDISC-AD0509 expect=noViolation domain=ADSL
#note "Authority: ADaM Conformance Rules v5.0 CR509 ('A variable ending in SDT must contain Start Date in the label'), whose exception is the standard library variables. A lowercase ADSL: trtsdt is the library variable TRTSDT carrying its ADaMIG label 'Date of First Exposure to Treatment', so it is exempt in any letter case (CIT 1/3: the library exclusion folds the name as the SDT test does) -> noViolation."
#library standard=adamig version=1-3
#library variable-metadata ADSL *SDT name=*SDT label="{Start Date}"
#library variable-metadata ADSL *DT name=*DT label="{Date}"
#library variable-metadata ADSL TRTSDT name=TRTSDT label="Date of First Exposure to Treatment"
dataset ADSL class=ADSL
col studyid type=Char
col usubjid type=Char
col trtsdt type=Num label="Date of First Exposure to Treatment"
---
CDISCPILOT01 | 01-701-1015 | 19000
---
