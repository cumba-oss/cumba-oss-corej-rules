#!RuleTest
#test CDISC-SEND-0057 expect=noViolation domain=MA
#note "DISCRIMINATOR of the R-5.25 split: MADIR carries a semicolon combination with a token outside (DIR) - the split sibling CDISC-SEND-0057-A's state - while MALAT is a single lawful term. This rule owns only the --LAT half and must stay silent."
#library standard=sendig version=3-1-1
#library codelist-terms LAT LEFT RIGHT BILATERAL
#library codelist-terms DIR DORSAL VENTRAL
#expectViolationCount 0
dataset MA class=FINDINGS label="Macroscopic Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col MASEQ    type=Num  label="Sequence Number"
col MATESTCD type=Char label="Macroscopic Examination Short Name"
col MALAT type=Char label="Laterality"
col MADIR type=Char label="Directionality"
---
S1 | MA | 001 | 1 | GMACROS | LEFT | DORSAL;SIDEWAYS
