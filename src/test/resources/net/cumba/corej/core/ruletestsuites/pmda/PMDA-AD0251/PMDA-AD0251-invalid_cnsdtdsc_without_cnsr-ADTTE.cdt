#!RuleTest
#test PMDA-AD0251 expect=violation domain=ADTTE
#note "CNSDTDSC is declared but CNSR is not: a censoring-date description without the censoring variable it describes. Exists-only Check -> dataset granularity -> exactly one violation at reported row 1. CNSDTDSC is the rule's single Output_Variable, row-1 value LASTCONTACT. Deliberately the same data shape as PMDA-AD0250-invalid_cnsdtdsc_without_cnsr-ADTTE.cdt: PMDA-AD0250 strictly subsumes this rule, and the two genuinely overlap here - that is a duplication in the sheet, not an oversight in the fixtures."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 nameOnly=CNSDTDSC
dataset ADTTE structure=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVAL     type=Num
col STARTDT  type=Num
col CNSDTDSC type=Char
---
CDISCPILOT01 | 01-701-1015 | TTDEATH | 120 | 21915 | LASTCONTACT
CDISCPILOT01 | 01-701-1023 | TTDEATH | 300 | 21915 | WITHDRAWAL
