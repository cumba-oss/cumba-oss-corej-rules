#!RuleTest
#test CDISC-AD0199 expect=noViolation domain=ADAE
# Rule:Description: A variable is present in ADaM with the same name as a variable present in SDTM but the variables do not have identical data types
#note "AESEQ is Num in both ADAE and SDTM AE -> noViolation"
dataset ADAE
col STUDYID type=Char
col USUBJID type=Char
col AESEQ type=Num
---
CDISCPILOT01 | 01-701-1015 | 1
---

dataset AE label="Adverse Events"
col STUDYID type=Char
col USUBJID type=Char
col AESEQ type=Num
---
CDISCPILOT01 | 01-701-1015 | 1
---
