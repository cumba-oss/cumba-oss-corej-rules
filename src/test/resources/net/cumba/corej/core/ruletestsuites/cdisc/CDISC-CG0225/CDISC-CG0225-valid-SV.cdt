#!RuleTest
#test CDISC-CG0225 expect=noViolation domain=SV
# Rule:Description: Raise an error when VISITDY is populated even though VISITNUM is not present in the Trial Visits (TV) dataset, indicating the record is for an unplanned visit.
#note "Every SV.VISITNUM is contained in TV.VISITNUM, so even though VISITDY is populated the rule does not fire"
dataset SV label="Subject Visits"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SVSEQ type=Num label="Sequence Number"
col VISITNUM type=Num label="Visit Number" format=VISITNUM.
col VISITDY type=Num label="Planned Study Day of Visit"
---
CDISCPILOT01 | SV | 01-701-1015 | 1 | 1 | 1
CDISCPILOT01 | SV | 01-701-1015 | 2 | 2 | 14
---

dataset TV label="Trial Visits"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col VISITNUM type=Num label="Visit Number" format=VISITNUM.
col VISITDY type=Num label="Planned Study Day of Visit"
---
CDISCPILOT01 | TV | 1 | 1
CDISCPILOT01 | TV | 2 | 14
---
