#!RuleTest
#test CDISC-CG0085 expect=violation domain=AE
# Rule:Description: Raise an error when --PRESP is populated with a value that is not equal to 'Y'.
#note "AEPRESP populated with a value other than Y"
#expectViolationCount 1
#expectViolationAt row=1 AESEQ=1 USUBJID=01-701-1015
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AEPRESP type=Char label="Pre-Specified"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | N
CDISCPILOT01 | AE | 01-701-1015 | 2 | 
---
