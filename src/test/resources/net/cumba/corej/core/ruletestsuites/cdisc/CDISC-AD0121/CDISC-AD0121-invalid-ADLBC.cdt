#!RuleTest
#test CDISC-AD0121 expect=violation domain=ADLBC
# Rule:Description: The value of a variable with a suffix of SDT is greater than the value of a variable with the same root and a suffix of EDT, considering only rows on which both variables are populated
#note "ASDT=100 > AEDT=50, both populated -> violation"
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ASDT type=Num
col AEDT type=Num
---
CDISCPILOT01 | 01-701-1015 | GLUC | 100 | 50
---
