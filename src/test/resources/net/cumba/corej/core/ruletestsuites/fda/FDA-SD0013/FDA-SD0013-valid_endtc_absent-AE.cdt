#!RuleTest
#test FDA-SD0013 expect=skipped domain=AE
#note "R-7 cross-graft (ruled 2026-08-19): the twins gained the Requirements.Variables [--ENDTC, --STDTC] gate. AEENDTC is not present, so the rule records one auditable skip instead of a silent no-finding."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AESTDTC type=Char label="Start Date/Time of Adverse Event"
---
S1 | AE | 001 | 1 | 2026-01-10
