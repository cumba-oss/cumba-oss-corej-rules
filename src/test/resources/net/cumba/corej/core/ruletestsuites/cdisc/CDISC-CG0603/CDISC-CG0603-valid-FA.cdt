#!RuleTest
#test CDISC-CG0603 expect=noViolation domain=FA
#note "PLAN-join-key-authoring-gate review round 1 (F7): the same link; FAOBJ equals the parent AEDECOD Headache -> no finding. The rule executes: FAOBJ is present."
#library standard=sdtmig version=3-4
dataset FA label="Findings About"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col FASEQ type=Num label="Sequence Number"
col FAOBJ type=Char label="Object of the Observation"
---
CDISCPILOT01 | FA | 01-701-1015 | 1 | Headache
---

dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AETERM type=Char label="Reported Term for the Adverse Event"
col AEDECOD type=Char label="Dictionary-Derived Term"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE | Headache
---

dataset RELREC label="Related Records"
col STUDYID type=Char label="Study Identifier"
col RDOMAIN type=Char label="Related Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col IDVAR type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col RELID type=Char label="Relationship Identifier"
---
CDISCPILOT01 | AE | 01-701-1015 | AESEQ | 1 | R1
CDISCPILOT01 | FA | 01-701-1015 | FASEQ | 1 | R1
---
