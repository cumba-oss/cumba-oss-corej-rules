#!RuleTest
#test CDISC-CG0343 expect=violation domain=AE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0343 (Class EVT, Domain ALL; Rule: --TERM ^= 'OTHER'). Row 2 records AETERM=OTHER, a placeholder rather than the reported event -> fires. Rows 1 and 3 report real events (row 3's text merely contains the word) and must stay silent."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1015 AESEQ=2 AETERM=OTHER
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEDECOD type=Char label="Dictionary-Derived Term"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE | Headache
CDISCPILOT01 | AE | 01-701-1015 | 2 | OTHER |
CDISCPILOT01 | AE | 01-701-1023 | 1 | OTHER INSECT BITES | Arthropod bite
---
