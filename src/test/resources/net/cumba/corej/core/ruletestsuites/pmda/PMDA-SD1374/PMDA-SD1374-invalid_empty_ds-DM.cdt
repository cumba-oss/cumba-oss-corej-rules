#!RuleTest
#test PMDA-SD1374 expect=violation domain=DM
#note "FRESH, DISCRIMINATING - DS present with ZERO rows. distinct's EmptyResult is SET: ds_usubjid is the EMPTY set, so every subject with a populated ACTARMCD fires; the untreated subject (empty ACTARMCD) stays guarded. Two findings - also the group's record-multiplicity pin. If this reports 0, escalate."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-001
#expectViolationAt row=2 USUBJID=01-002
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARMCD    type=Char label="Planned Arm Code"
col ACTARMCD type=Char label="Actual Arm Code"
col ACTARM   type=Char label="Description of Actual Arm"
---
CDISCPILOT01 | DM | 01-001 | PBO   | PBO   | Placebo
CDISCPILOT01 | DM | 01-002 | XANHI | XANHI | Xanomeline High
CDISCPILOT01 | DM | 01-003 |       |       |
---

dataset DS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSTERM  type=Char label="Reported Term for the Disposition Event"
col DSDECOD type=Char label="Standardized Disposition Term"
---
---
