#!RuleTest
#test PMDA-SD1135 expect=violation domain=EX
#note "Per-row multiplicity, narrowed to the --STDY half by the R-5.25 split (top-level-or board wave 2, group J): rows 1 and 3 carry a negative EXSTDY -> two findings. Row 2 (negative EXENDY only) is the split sibling PMDA-SD1135-A's state and must NOT fire here; row 3's negative EXENDY is reported by the sibling AT THE SAME ROW - two rules, two defects, no double-report of one defect (both being negative is two sponsor errors)."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 EXSTDY=-1
#expectViolationAt row=3 EXSTDY=-4
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDY  type=Num  label="Study Day of Start of Treatment"
col EXENDY  type=Num  label="Study Day of End of Treatment"
---
S1 | EX | 001 | 1 | DRUG A | -1 | 5
S1 | EX | 001 | 2 | DRUG A | 2  | -2
S1 | EX | 001 | 3 | DRUG A | -4 | -4
