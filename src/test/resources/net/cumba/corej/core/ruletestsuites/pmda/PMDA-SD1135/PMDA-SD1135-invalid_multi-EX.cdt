#!RuleTest
#test PMDA-SD1135 expect=violation domain=EX
#note "FRESH: per-row multiplicity. Row 1 fires the EXSTDY branch, row 2 fires the EXENDY branch, row 3 has BOTH branches true but a Check is one boolean per row -> fires once. Three findings total."
#library standard=sdtmig version=3-4
#expectViolationCount 3
#expectViolationAt row=1 EXSTDY=-1
#expectViolationAt row=2 EXENDY=-2
#expectViolationAt row=3 EXSTDY=-4
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDY  type=Num  label="Study Day of Start of Treatment"
col EXENDY  type=Num  label="Study Day of End of Treatment"
---
S1 | EX | 001 | 1 | DRUG A | -1 | 5
S1 | EX | 001 | 2 | DRUG A | 2  | -2
S1 | EX | 001 | 3 | DRUG A | -4 | -4
