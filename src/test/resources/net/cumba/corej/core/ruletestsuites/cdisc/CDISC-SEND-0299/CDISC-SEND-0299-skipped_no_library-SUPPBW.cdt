#!RuleTest
#test CDISC-SEND-0299 expect=skipped domain=SUPPBW
#note "NO #library line at all: get_column_order_from_library needs the CDISC Library -> the rule SKIPs rather than flagging every variable against an empty list. The body is the invalid one. W4 (PLAN-list-functions phase 0, scenarios-first on the pre-port engine)."
dataset SUPPBW
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM     type=Char label="Qualifier Variable Name"
col QLABEL   type=Char label="Qualifier Variable Label"
col QVAL     type=Char label="Data Value"
col QXTRA    type=Char label="Sponsor Defined"
---
S1 | BW | 001 | BWSEQ | 1 | BWXTRA | Extra | Y | X
