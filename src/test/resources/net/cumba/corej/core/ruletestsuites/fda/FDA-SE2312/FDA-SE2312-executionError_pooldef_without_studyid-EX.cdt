#!RuleTest
#test FDA-SE2312 expect=executionError domain=EX
#expect-execution-error "group= over 'POOLDEF' has no usable key"
#note "PLAN-join-key-one-side-absent-drop QK16 (b) / QK18 (owner 2026-10-11): POOLDEF without STUDYID - the domain= call's only group= member is on the evaluated side only, so no key member is left on both sides and the rule ERRORs (never an aggregate over the whole of POOLDEF). Derived from FDA-SE2312-invalid-EX.cdt with POOLDEF.STUDYID removed. A gate declaring POOLDEF.STUDYID would turn this into a SKIP."
#library standard=sendig version=3-1-1
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col POOLID   type=Char label="Pool Identifier"
col EXSEQ    type=Num  label="Sequence Number"
col EXTRT    type=Char label="Name of Treatment"
col EXDOSFRQ type=Char label="Dosing Frequency per Interval"
col EXROUTE  type=Char label="Route of Administration"
---
S1 | EX |  | POOLX | 1 | DRUG A | QD | ORAL
S1 | EX |  | POOL1 | 2 | DRUG A | QD | ORAL
---

dataset POOLDEF label="Pool Definition"
col POOLID  type=Char label="Pool Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
---
POOL1 | 001
POOL1 | 002
---
