#!RuleTest
#test CDISC-CG0421 expect=violation domain=AE
# Rule:Description: Raise an error when --OCCUR is 'N' and --ENRF (End Relative to Reference Period) is populated for a non-occurred event or intervention.
#note "AEOCCUR=N yet AEENRF is populated"
#expectViolationCount 1
#expectViolationAt row=1 AESEQ=1 USUBJID=01-701-1015
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AEOCCUR type=Char label="Adverse Event Occurrence"
col AEENRF type=Char label="End Relative to Reference Period"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | N | AFTER
CDISCPILOT01 | AE | 01-701-1015 | 2 | Y | DURING
---
