#!RuleTest
#test PMDA-SD1373 expect=violation domain=DM
#note "Boundary: the exclusion `ARMNRS != \"UNPLANNED TREATMENT\"` is exact and case-SENSITIVE. Row 1 carries the exact excluded literal and stays silent. Row 2 carries the same term in mixed case, which is NOT the excluded literal, so all three conjuncts hold and it fires -- contrast SD1263's equalsIgnoreCase exclusions and SD1363's upper()+in."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 ARMNRS="Unplanned Treatment"
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SUBJID   type=Char label="Subject Identifier for the Study"
col RFSTDTC  type=Char label="Subject Reference Start Date/Time"
col ARM      type=Char label="Description of Planned Arm"
col ARMNRS   type=Char label="Reason Arm and/or Actual Arm is Null"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015 | 2020-02-11 |         | UNPLANNED TREATMENT
CDISCPILOT01 | DM | 01-701-1023 | 1023 | 2020-02-12 |         | Unplanned Treatment
