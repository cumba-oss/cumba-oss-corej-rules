#!RuleTest
#test CDISC-CG0109 expect=violation domain=DM
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0109 (SDTMIG 3.2; Condition: no records in EX for the subject; Rule: DM.ACTARMCD in (SCRNFAIL, NOTASSGN, NOTTRT)). Subject 01-701-1023 has no EX record and ACTARMCD=XANHI, which is not SCRNFAIL, NOTASSGN or NOTTRT -> row 2 fires. Row 1 has EX records; rows 3-4 have no EX record but an exempt ACTARMCD. ALSO THE S3 DISCRIMINATOR (SKELETON-distinct-function hazard 3): USUBJID in distinct(USUBJID, domain=EX) belongs to the FOREIGN dataset EX; a port that read USUBJID from the primary DM would find every subject in its own set and fall silent."
#library standard=sdtmig version=3-2
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1023 ACTARMCD=XANHI
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARMCD    type=Char label="Planned Arm Code"
col ACTARMCD type=Char label="Actual Arm Code"
---
CDISCPILOT01 | DM | 01-701-1015 | PBO      | PBO
CDISCPILOT01 | DM | 01-701-1023 | XANHI    | XANHI
CDISCPILOT01 | DM | 01-701-1028 | SCRNFAIL | SCRNFAIL
CDISCPILOT01 | DM | 01-701-1034 | XANLO    | NOTTRT
---

dataset EX label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
---
CDISCPILOT01 | EX | 01-701-1015 | 1 | PLACEBO | 2014-01-02
---
