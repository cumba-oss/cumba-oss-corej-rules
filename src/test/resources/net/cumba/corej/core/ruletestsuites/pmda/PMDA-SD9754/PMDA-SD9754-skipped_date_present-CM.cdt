#!RuleTest
#test PMDA-SD9754 expect=skipped domain=CM
#note "The discriminator: CMENDTC is PRESENT (blank on row 2) -> the companion SKIPS on None [--ENDTC]; the imputation parent PMDA-SD1093 runs and reports the record whose date is incomplete."
#library standard=sdtmig version=3-2
dataset CM class=INTERVENTIONS label="Concomitant Medications"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col CMSEQ    type=Num  label="Sequence Number"
col CMTRT type=Char label="Reported Name of Drug, Med, or Therapy"
col CMENDY type=Num label="Study Day of End of Observation"
col CMENDTC type=Char label="End Date/Time of Observation"
---
S1 | CM | 001 | 1 | ASPIRIN | 5 | 2020-01-05
S1 | CM | 002 | 2 | ASPIRIN | 6 | 
S1 | CM | 003 | 3 | ASPIRIN |  | 2020-01-07
