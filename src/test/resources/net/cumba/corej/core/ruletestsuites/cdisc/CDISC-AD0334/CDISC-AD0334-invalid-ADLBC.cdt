#!RuleTest
#test CDISC-AD0334 expect=violation domain=ADLBC
# Rule:Description: Within a parameter, there is more than one value of PCHGCAyN for a given value of PCHGCATy, considering only those rows on which both variables are populated
#note "within PARAMCD GLUC, PCHGCAT1=G maps to two distinct PCHGCA1N values -> violation"
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015
#expectViolationAt row=2 USUBJID=01-701-1015
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col PCHGCA1N type=Char
col PCHGCAT1 type=Char
---
CDISCPILOT01 | 01-701-1015 | GLUC | A1 | G
CDISCPILOT01 | 01-701-1015 | GLUC | A2 | G
---
