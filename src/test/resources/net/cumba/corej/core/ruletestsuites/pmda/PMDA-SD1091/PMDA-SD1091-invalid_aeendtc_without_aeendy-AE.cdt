#!RuleTest
#test PMDA-SD1091 expect=violation domain=AE
#note "Shipped Check var_exists(\"--ENDTC\") and not var_exists(\"--ENDY\") resolves per the EC-36 prefix rule to AEENDTC/AEENDY; both leaves are dataset constants -> BroadcastFold -> exactly ONE violation reported at row=1 regardless of row count."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 AEENDTC=2020-01-20
dataset AE class=EVENTS
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col AESEQ   type=Num
col AEENDTC type=Char
---
S1 | AE | 001 | 1 | 2020-01-20
