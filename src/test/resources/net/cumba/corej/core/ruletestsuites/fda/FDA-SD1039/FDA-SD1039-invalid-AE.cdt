#!RuleTest
#test FDA-SD1039 expect=violation domain=AE
#note "Events branches: row 1 AECAT='ae' equals DOMAIN case-insensitively; row 2 AECAT equals AETERM; row 3 AECAT equals AEBODSYS; row 4 clean -> 3 violations."
#library standard=sdtmig version=3-4
#expectViolationCount 3
#expectViolationAt row=1 AESEQ=1
#expectViolationAt row=2 AESEQ=2
#expectViolationAt row=3 AESEQ=3
dataset AE class=EVENTS label="Adverse Events"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col AESEQ    type=Num  label="Sequence Number"
col AETERM   type=Char label="Reported Term for the Adverse Event"
col AECAT    type=Char label="Category for Adverse Event"
col AEBODSYS type=Char label="Body System or Organ Class"
---
S1 | AE | 001 | 1 | HEADACHE | ae                | NERVOUS SYSTEM DISORDERS
S1 | AE | 001 | 2 | NAUSEA   | Nausea            | GASTROINTESTINAL DISORDERS
S1 | AE | 001 | 3 | PRURITUS | SKIN DISORDERS    | SKIN DISORDERS
S1 | AE | 001 | 4 | FEVER    | GENERAL SYMPTOMS  | GENERAL DISORDERS
