#!RuleTest
#test PMDA-SD0024 expect=skipped domain=LB
#note "LBDTC is not present in the dataset while LBENDTC is populated. Requirements.Variables.All [--ENDTC, --DTC] gates the rule out -> auditable skip instead of one finding per row under absent = all-missing (EC-43). Row 1 WOULD fire were the gate removed. Verdict 2-2: the absence is not reportable here (no sister; PMDA-SD2270 triggers on --DY, which this rule never mentions)."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBENDTC  type=Char label="End Date/Time of Specimen Collection"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | GLUC | 2020-01-01T09:00
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALB  |
