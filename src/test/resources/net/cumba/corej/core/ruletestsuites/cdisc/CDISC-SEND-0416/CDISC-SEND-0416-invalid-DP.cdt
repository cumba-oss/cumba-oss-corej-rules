#!RuleTest
#test CDISC-SEND-0416 expect=violation domain=DP
#note "DPTEST is populated with a value that is not a term of the DPTEST codelist (codelist_terms) on the qualifying record -> fires; the conformant and the non-qualifying rows stay silent. W4 (PLAN-list-functions phase 0, scenarios-first on the pre-port engine)."
#library standard=sendig-dart version=1-2
#library codelist-terms DPTEST "EYE OPENING" "PINNA DETACHMENT"
#expectViolationCount 1
#expectViolationAt row=1 DPTEST=WALKING
dataset DP
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col DPSEQ    type=Num  label="Sequence Number"
col DPTESTCD type=Char label="Developmental Milestone Short Name"
col DPTEST   type=Char label="Developmental Milestone"
---
S1 | DP | 001 | 1 | WALK | WALKING
S1 | DP | 001 | 2 | EYEOPEN | EYE OPENING
