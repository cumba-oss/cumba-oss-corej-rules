#!RuleTest
#test CDISC-CG0368 expect=violation domain=AE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0368 (Domain DM, Variable GEN; Condition: study on human subjects; Rule: DM dataset present in study). The study inventory holds an AE dataset of a human clinical study but no DM dataset -> the dataset-presence check fires once for the evaluated dataset."
#library standard=sdtmig version=3-4
#expectViolationCount 1
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE
---
