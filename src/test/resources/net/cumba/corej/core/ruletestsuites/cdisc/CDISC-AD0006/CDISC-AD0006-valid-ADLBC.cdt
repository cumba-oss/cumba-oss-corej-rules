#!RuleTest
#test CDISC-AD0006 expect=noViolation domain=ADLBC
# Rule:Description: A variable with a suffix of FL is present and a variable with the same root and a suffix of FN has a value that is not 0, 1 or null
#note "SAFFN=1 is in [0,1] -> noViolation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col SAFFL type=Char
col SAFFN type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | Y | 1
---
