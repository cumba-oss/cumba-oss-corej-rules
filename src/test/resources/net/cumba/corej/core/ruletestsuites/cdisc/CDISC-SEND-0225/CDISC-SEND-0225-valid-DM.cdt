#!RuleTest
#test CDISC-SEND-0225 expect=noViolation domain=DM
#note "Authority: SEND Conformance Rules v5.0 SEND225 (SENDIG 3.0-3.1.1, DART 1.1/1.2, GENETOX 1.0; scenario at SENDIG 3.1.1), Condition \"DM.ARM ^= null\", Rule \"DM.ARM exists in TA.ARM\". Every populated DM.ARM (Control, High Dose) is a TA.ARM; row 3's ARM is null, which the Condition excludes -> silent."
#library standard=sendig version=3-1-1
#expectViolationCount 0
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col SEX     type=Char label="Sex"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
col SETCD   type=Char label="Set Code"
---
S1 | DM | S1-001 | 001 | M | 1 | Control   | C1
S1 | DM | S1-002 | 002 | F | 2 | High Dose | H1
S1 | DM | S1-003 | 003 | M |   |           |
---

dataset TA label="Trial Arms"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
col TAETORD type=Num  label="Order of Element within Arm"
col ETCD    type=Char label="Element Code"
col ELEMENT type=Char label="Description of Element"
---
S1 | TA | 1 | Control   | 1 | SCRN | Screening
S1 | TA | 1 | Control   | 2 | CTRL | Vehicle Control
S1 | TA | 2 | High Dose | 1 | SCRN | Screening
S1 | TA | 2 | High Dose | 2 | HD   | 100 mg/kg
---
