#!RuleTest
#test FDA-SD9719 expect=violation domain=AE
#note "The sister half of the FDA-SD0021 pair (minted 2026-09-11, M3/T1-04/05/08/09). None of AEENDTC/AEENRF/AEENRTPT/AEDUR is present (None satisfied), and the exemption columns AEOCCUR/AESTAT are absent too, so the remaining condition holds structurally on every row (R-5.22: --OCCUR != 'N' fires on a missing value; empty(--STAT) is true). Sensitivity is Dataset, so the absence is reported ONCE although both rows qualify. Same dataset shape as the parent's skipped_no_end_columns scenario: the parent skips, this rule reports."
#library standard=sdtmig version=3-4
#expectViolationCount 1
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE
S1 | AE | 001 | 2 | NAUSEA
