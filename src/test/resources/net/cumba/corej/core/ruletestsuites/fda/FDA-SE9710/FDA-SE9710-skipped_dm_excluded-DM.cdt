#!RuleTest
#test FDA-SE9710 expect=skipped domain=DM
#note "Scope boundary: DM is excluded (the parent FDA-SD1093 excludes DM); the body would fire (DMENDY populated, no DMENDTC)."
#library standard=sendig version=3-1-1
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SEX type=Char label="Sex"
col DMENDY type=Num label="Study Day of End of Observation"
---
S1 | DM | 001 | F | 5
S1 | DM | 002 | M | 6
S1 | DM | 003 | F | 
