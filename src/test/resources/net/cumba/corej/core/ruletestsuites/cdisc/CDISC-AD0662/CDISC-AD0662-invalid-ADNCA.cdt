#!RuleTest
#test CDISC-AD0662 expect=violation domain=ADNCA
# Rule:Description: Raise an error when TMPCTDF is populated but ARRLT and NRRLT are not populated in an ADNCA v1.0 dataset.
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015
dataset ADNCA
col STUDYID type=Char
col USUBJID type=Char
col TMPCTDF type=Char
col ARRLT type=Char
col NRRLT type=Char
col PARAMCD type=Char
col NFRLT type=Num
col AFRLT type=Num
---
CDISCPILOT01 | 01-701-1015 | Y |  | | CONC | 0 | 0.5
---
