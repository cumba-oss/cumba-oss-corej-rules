#!RuleTest
#test PMDA-AD0565 expect=violation domain=ADLBC
#note "DISCRIMINATING (batch measurement 1: missing _wildcards y filter). PMDA-AD0565 declares no _wildcards block, so y compiles to (\d+) and a two-digit index survives -> ONE expansion var_exists(BCHGCA10N) and not var_exists(BCHGCAT10) fires. The {min 1, max 9}-filtered twin CDISC-AD0565 would instead return NoMatch. Pins today's behaviour; nothing is proposed."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 BCHGCA10N=1
dataset ADLBC structure=BDS
col STUDYID   type=Char
col USUBJID   type=Char
col PARAMCD   type=Char
col AVAL      type=Num
col BCHGCA10N type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | 3.5 | 1
