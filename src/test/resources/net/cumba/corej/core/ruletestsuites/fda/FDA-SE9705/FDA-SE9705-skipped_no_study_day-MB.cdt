#!RuleTest
#test FDA-SE9705 expect=skipped domain=MB
#note "Neither column: no MBCHDY / MBXDY and no MBDTC -> SKIPPED on Any [--CHDY, --XDY]; nothing is populated that would need the date."
#library standard=sendig version=ar-1-0
dataset MB class=FINDINGS label="Microbiology Specimen"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col MBSEQ    type=Num  label="Sequence Number"
col MBTESTCD type=Char label="Test Short Name"
---
S1 | MB | 001 | 1 | CULT
S1 | MB | 002 | 2 | CULT
S1 | MB | 003 | 3 | CULT
