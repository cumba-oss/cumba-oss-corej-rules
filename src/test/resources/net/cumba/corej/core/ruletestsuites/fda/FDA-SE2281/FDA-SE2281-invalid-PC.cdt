#!RuleTest
#test FDA-SE2281 expect=violation domain=PC
#note "Since the R-5.25 split (top-level-or board wave 2, group J) this rule owns ONLY the PCNOMDY half: row 1 (PCNOMDY missing) fires. Row 2 (PCELTM empty) and row 3 (PCTPTREF empty) are the split siblings FDA-SE2281-A/-B's states and must NOT fire here - the discriminator of the split; row 4 is fully populated."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 PCSEQ=1
dataset PC class=FINDINGS label="Pharmacokinetics Concentrations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PCSEQ    type=Num  label="Sequence Number"
col PCNOMDY  type=Num  label="Nominal Study Day for Tabulations"
col PCELTM   type=Char label="Planned Elapsed Time from Time Point Ref"
col PCTPTREF type=Char label="Time Point Reference"
---
S1 | PC | 001 | 1 | . | PT0H | DOSE 1
S1 | PC | 001 | 2 | 1 |      | DOSE 1
S1 | PC | 001 | 3 | 1 | PT1H |
S1 | PC | 001 | 4 | 1 | PT2H | DOSE 1
