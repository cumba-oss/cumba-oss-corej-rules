#!RuleTest
#test CDISC-CG9685 expect=skipped domain=AE
#note "AEBDSYCD column present: Requirements.Variables.None [--BDSYCD] skips the sister; a missing code on a record is CDISC-CG0082's finding."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col AESEQ    type=Num
col AETERM   type=Char
col AEBODSYS type=Char
col AEBDSYCD type=Char
---
S1 | AE | 001 | 1 | HEADACHE | Nervous system disorders |
---
