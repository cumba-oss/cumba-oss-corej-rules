#!RuleTest
#test PMDA-SD0065 expect=violation domain=LB
#note "CL-A A.6 (wave TA-4): the per-subject VISITNUM membership became the sheet's USUBJID+VISIT+VISITNUM tuple. Row 2's VISIT text ('WEEK 2 (EARLY)') does not match SV's row for visit 2, so the tuple is unmatched and the rule fires - under the old VISITNUM-only key it stayed silent. Row 1 matches SV exactly."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=001 VISITNUM=2
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col LBSEQ   type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBSTAT  type=Char label="Completion Status"
col VISITNUM type=Num  label="Visit Number"
col VISIT   type=Char label="Visit Name"
---
S1 | LB | 001 | 1 | ALB |  | 1 | SCREENING
S1 | LB | 001 | 2 | ALB |  | 2 | WEEK 2 (EARLY)
---

dataset SV class="SPECIAL PURPOSE" label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col SVSTDTC  type=Char label="Start Date/Time of Visit"
---
S1 | SV | 001 | 1 | SCREENING | 2020-01-01
S1 | SV | 001 | 2 | WEEK 2    | 2020-01-15
