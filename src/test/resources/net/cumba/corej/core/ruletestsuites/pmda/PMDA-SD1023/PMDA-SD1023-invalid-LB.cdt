#!RuleTest
#test PMDA-SD1023 expect=violation domain=LB
#note "Row 2's (VISIT, VISITNUM) pair ('WEEK 99', 99) matches no TV row -> fires. Row 1 matches TV; row 3 is an unscheduled visit and exempt. ⭐ 2026-09-22 (PLAN-unplanned-visit-sv-match-tier): the rule now carries a left join to SV and Requirements.Datasets: [SV], so a fixture WITHOUT an SV dataset no longer exercises it at all — it SKIPs. The SV block below exists to satisfy that requirement and DELIBERATELY matches no row (USUBJID 01-701-9999), so every primary row takes the `not SV._matched_` tier and is decided by the VISIT name exactly as before. ⛔ The verdicts above are therefore UNCHANGED by the join, which is the point: do not add a matching SV row here without re-deriving them."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 VISITNUM=99
dataset LB label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB | 2  | WEEK 2
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALB | 99 | WEEK 99
CDISCPILOT01 | LB | 01-701-1015 | 3 | ALB | 42 | UNSCHEDULED 4.2
---

dataset TV label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | TV | 1 | BASELINE
CDISCPILOT01 | TV | 2 | WEEK 2
---

dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | SV | 01-701-9999 | 1 | SCREENING
---
