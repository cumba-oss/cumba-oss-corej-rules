#!RuleTest
#test CDISC-SEND-0306 expect=skipped domain=DM
#note "PLAN-join-key-one-side-absent-drop QK18 (owner 2026-10-11): EX has NO USUBJID column. The own extreme groups EX by USUBJID, a key the rule's dataset carries and EX does not, so without a gate the key would be left with no member on both sides and the rule would ERROR (QK16 (b)); the declared All: [EX.USUBJID] turns that study into a SKIP. Derived from CDISC-SEND-0306-valid_pool_earlier-DM.cdt with EX.USUBJID removed."
#library standard=sendig version=3-1-1
dataset DM label=Demographics
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFXENDTC type=Char label="Date/Time of Last Study Treatment"
---
S1 | DM | 001 | 2020-01-10
---
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col POOLID  type=Char label="Pool Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
col EXENDTC type=Char label="End Date/Time of Treatment"
---
S1 | EX |  | 1 | DRUG A | 2020-01-01 | 2020-01-10
S1 | EX | P1 | 2 | DRUG A | 2020-01-01 | 2020-01-05
---
dataset POOLDEF label="Pool Definition"
col STUDYID type=Char label="Study Identifier"
col POOLID  type=Char label="Pool Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
---
S1 | P1 | 001
---
