#!RuleTest
#test CDISC-CG0154 expect=violation domain=TE
# Rule:Description: Raise an error when Element Code (ETCD) and Description of Element (ELEMENT) do not have a one-to-one relationship within the domain.
#note "ELEMENT=Screen maps to two different ETCD values -> ELEMENT is_not_unique_relationship ETCD"
#expectViolationCount 2
#expectViolationAt row=1
#expectViolationAt row=2
dataset TE label="Trial Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col ETCD type=Char label="Element Code" format=$ETCD.
col ELEMENT type=Char label="Description of Element" format=$ELEMENT.
---
CDISCPILOT01 | TE | SCRN | Screen
CDISCPILOT01 | TE | SCN2 | Screen
---
