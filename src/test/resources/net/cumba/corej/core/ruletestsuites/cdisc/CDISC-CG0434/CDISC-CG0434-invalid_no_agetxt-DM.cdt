#!RuleTest
#test CDISC-CG0434 expect=violation domain=DM
#note "ADAPTED-FROM fda/FDA-SD2021/FDA-SD2021-invalid-noagetxt-DM.cdt (data and pins verbatim; file-name suffix regularised from -noagetxt- to -no_agetxt- for this batch's underscore convention). No AGETXT column. Fires via the SECOND disjunct, the author's explicit not var_exists(\"AGETXT\") arm. Output_Variables names AGETXT and the column is absent -- that is fine and is exactly what the twin already ships green."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 nameOnly=AGEU
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col AGE     type=Num  label="Age"
col AGEU    type=Char label="Age Units"
---
S1 | DM | 001 | .  | YEARS
S1 | DM | 002 | 30 | YEARS
