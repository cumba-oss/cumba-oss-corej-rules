#!RuleTest
#test CDISC-AD0168 expect=violation domain=ADLB
#note "Mirrors rulespec CDISC-AD0168.yaml (the rule's only prior guard). 201/GLUC is the FILTER discriminator: post-baseline ANRIND 'NORMAL' sorts above the baseline 'HIGH' while BNRIND='HIGH' everywhere, so a filter-ignoring max() computes $baseline_anrind='NORMAL' and false-fires on rows 1-2 (exact-set match reds). 202/GLUC row 4 is the genuine violation (BNRIND 'LOW' != baseline ANRIND 'NORMAL'). 203/GLUC has no ABLFL=Y row -> missing $-value, populated BNRIND fires on row 5; row 6 keeps BNRIND empty and the non_empty guard keeps it quiet."
#library standard=adamig version=1-2
#expectViolationCount 2
#expectViolationAt row=4 PARAMCD=GLUC BASETYPE=LAST ANRIND=LOW BNRIND=LOW "$baseline_anrind"=NORMAL
#expectViolationAt row=5 PARAMCD=GLUC BASETYPE=LAST ANRIND=NORMAL BNRIND=NORMAL
dataset ADLB label="Analysis Dataset Lab"
col STUDYID  type=Char label="Study Identifier"
col USUBJID  type=Char label="Unique Subject Identifier"
col PARAMCD  type=Char label="Parameter Code"
col AVISITN  type=Num  label="Analysis Visit (N)"
col BASETYPE type=Char label="Baseline Type"
col ABLFL    type=Char label="Baseline Record Flag"
col ANRIND   type=Char label="Analysis Reference Range Indicator"
col BNRIND   type=Char label="Baseline Reference Range Indicator"
---
S1 | 201 | GLUC | 0 | LAST | Y | HIGH   | HIGH
S1 | 201 | GLUC | 1 | LAST |   | NORMAL | HIGH
S1 | 202 | GLUC | 0 | LAST | Y | NORMAL | NORMAL
S1 | 202 | GLUC | 1 | LAST |   | LOW    | LOW
S1 | 203 | GLUC | 1 | LAST |   | NORMAL | NORMAL
S1 | 203 | GLUC | 2 | LAST |   | LOW    |
