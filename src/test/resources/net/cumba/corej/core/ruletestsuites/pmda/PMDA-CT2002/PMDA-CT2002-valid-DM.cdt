#!RuleTest
#test PMDA-CT2002 expect=noViolation domain=DM
#note "Every populated RACE value is a term of the extensible CDISC codelist -> no violation."
#library standard=sdtmig version=3-4
#library variable-metadata DM RACE codelist=RACE codelist_extensible=true codelist_coded_values="[\"WHITE\",\"ASIAN\"]"
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RACE    type=Char label="Race"
---
S1 | DM | 001 | WHITE
S1 | DM | 002 | ASIAN
