#!RuleTest
#test CDISC-CG0285 expect=skipped domain=TS
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0285 (Condition: TSPARMCD = SSTDTC; Rule: TSVAL conforms to ISO 8601 date). The TSPARMCD column is absent; Requirements.Variables.All [TSPARMCD] gates the rule to SKIPPED (the Condition cannot be decided)."
#library standard=sdtmig version=3-3
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col TSSEQ   type=Num  label="Sequence Number"
col TSPARM  type=Char label="Trial Summary Parameter"
col TSVAL   type=Char label="Parameter Value"
---
CDISCPILOT01 | TS | 1 | Study Start Date | 02JAN2014
