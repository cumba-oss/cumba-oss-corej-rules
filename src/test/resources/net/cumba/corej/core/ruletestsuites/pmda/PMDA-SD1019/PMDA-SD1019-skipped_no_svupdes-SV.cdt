#!RuleTest
#test PMDA-SD1019 expect=skipped domain=SV
#note "SV deliberately carries no SVUPDES column. Requirements.Variables.All is [SVUPDES, VISITDY] and the absent SVUPDES skips the whole rule; SVUPDES is Perm in SV, so a study with no unplanned visits legitimately omits the column."
#library standard=sdtmig version=3-4
dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col VISITDY  type=Num  label="Planned Study Day of Visit"
---
CDISCPILOT01 | SV | 01-701-1015 | 1 | SCREENING | 1
