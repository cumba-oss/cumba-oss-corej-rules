#!RuleTest
#test FDA-SD9742 expect=violation domain=DM
# Rule:Description: Raise an error when a CE record has CETERM or CEDECOD equal to DEATH but DTHFL in DM for the corresponding subject is not Y.
#note "any-branch 1: CE.CETERM='DEATH' for subject 01-701-1015 but DM.DTHFL is not 'Y'"
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015
dataset DM label=Demographics
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DTHFL type=Char label="Subject Death Flag" format=$Y_BLANK.
---
CDISCPILOT01 | DM | 01-701-1015 |
CDISCPILOT01 | DM | 01-701-1023 |
---

dataset CE label="Clinical Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CESEQ type=Num label="Sequence Number"
col CETERM type=Char label="Reported Term for the Clinical Event"
col CEDECOD type=Char label="Dictionary-Derived Term"
---
CDISCPILOT01 | CE | 01-701-1015 | 1 | HEADACHE | HEADACHE
CDISCPILOT01 | CE | 01-701-1015 | 2 | DEATH    | DEATH
---
