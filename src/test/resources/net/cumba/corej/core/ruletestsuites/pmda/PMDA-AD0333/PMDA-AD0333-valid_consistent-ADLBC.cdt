#!RuleTest
#test PMDA-AD0333 expect=noViolation domain=ADLBC
#note "Same shape as the invalid fixture except row 3 carries PCHGCAT1=INCR, so each (PARAMCD, PCHGCA1N) group holds one distinct label."
#library standard=adamig version=1-3
dataset ADLBC
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVAL     type=Num
col PCHGCAT1 type=Char
col PCHGCA1N type=Num
---
S1 | 001 | GLUC | 5.0 | INCR | 1
S1 | 002 | GLUC | 5.1 | INCR | 1
S1 | 003 | GLUC | 5.2 | INCR | 1
S1 | 004 | GLUC | 5.3 | DECR | 2
