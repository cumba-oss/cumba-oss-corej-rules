#!RuleTest
#test PMDA-AD0267 expect=violation domain=ADAE
#note "Since the R-5.25 split this rule owns ONLY the units-without-duration half: row 2 (ADURU with no ADURN) fires. Row 1 (ADURN without ADURU) is the SIBLING PMDA-AD0267-A's state and must NOT fire here - the discriminator of the split. No structure= is needed because the Scope is Domains.Include [ALL] plus Requirements.Variables. Row 3 has the pair populated and row 4 has both blank. Record granularity -> 1 violation."
#library standard=adamig version=1-0
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1023 ADURU=DAYS
dataset ADAE
col STUDYID type=Char
col USUBJID type=Char
col AEDECOD type=Char
col ADURN   type=Num
col ADURU   type=Char
---
CDISCPILOT01 | 01-701-1015 | HEADACHE | 5 |
CDISCPILOT01 | 01-701-1023 | NAUSEA   |   | DAYS
CDISCPILOT01 | 01-701-1034 | RASH     | 3 | DAYS
CDISCPILOT01 | 01-701-1045 | FEVER    |   |
