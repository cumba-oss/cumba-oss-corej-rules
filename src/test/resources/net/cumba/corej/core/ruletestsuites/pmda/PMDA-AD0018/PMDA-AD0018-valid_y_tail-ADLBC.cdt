#!RuleTest
#test PMDA-AD0018 expect=noViolation domain=ADLBC
#note "D8 (PLAN-library-template-label-resolution, ADaMIG section 3): descriptive text is allowed at the end of the label of a variable whose name carries the index y or zz. AVALCAT1 resolves through the BDS template AVALCATy ('Analysis Value Category y'), so its label template is 'Analysis Value Category 1 ...', and 'Analysis Value Category 1 (Low/Normal/High)' conforms; AVALCAT2's bare 'Analysis Value Category 2' conforms to 'Analysis Value Category 2 ...' (the tail may be empty); ANL01FL, a zz name, resolves through ANLzzFL to 'Analysis Flag 01 ...' and 'Analysis Flag 01 - Efficacy' conforms -> silent."
#library standard=adamig version=1-3
#library variable-metadata ADLBC AVALCATy name=AVALCATy label="Analysis Value Category y"
#library variable-metadata ADLBC ANLzzFL name=ANLzzFL label="Analysis Flag zz"
#expectViolationCount 0
dataset ADLBC structure=BDS
col STUDYID type=Char label="Study Identifier"
col PARAMCD type=Char label="Parameter Code"
col AVALCAT1 type=Char label="Analysis Value Category 1 (Low/Normal/High)"
col AVALCAT2 type=Char label="Analysis Value Category 2"
col ANL01FL type=Char label="Analysis Flag 01 - Efficacy"
---
CDISCPILOT01 | ALB | LOW | NORMAL | Y
---
