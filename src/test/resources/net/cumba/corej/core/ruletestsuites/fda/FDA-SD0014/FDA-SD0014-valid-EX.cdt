#!RuleTest
#test FDA-SD0014 expect=noViolation domain=EX
#note "Boundary: EXDOSE=0 is explicitly permitted ('must be greater than or equal to 0'), and a missing EXDOSE is out of the condition -> no violation."
#library standard=sdtmig version=3-4
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXDOSE  type=Num  label="Dose"
col EXDOSU  type=Char label="Dose Units"
---
S1 | EX | 001 | 1 | DRUG A | 10 | mg
S1 | EX | 001 | 2 | DRUG A | 0  | mg
S1 | EX | 001 | 3 | DRUG A | .  | mg
