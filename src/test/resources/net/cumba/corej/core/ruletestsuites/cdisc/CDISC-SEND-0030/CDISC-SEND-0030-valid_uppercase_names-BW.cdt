#!RuleTest
#test CDISC-SEND-0030 expect=noViolation domain=BW
#note "Authority: SEND Conformance Rules v5.0 SEND30 ('Variable name is in uppercase'). Every variable name is upper case (digits and underscores are not letters) -> no violation."
#library standard=sendig version=3-1-1
dataset BW label="Body Weight"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col BWSEQ    type=Num  label="Sequence Number"
col BWTESTCD type=Char label="Test Short Name"
col BWSTRESN type=Num  label="Numeric Result/Finding in Standard Units"
---
S1 | BW | 001 | 1 | BW | 250
