#!RuleTest
#test CDISC-CG0034 expect=violation domain=LB
#note "S4(a), two USUBJID groups whose answers differ. Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0034 (Condition VISITNUM ^= null; Rule VISITNUM in SV.VISITNUM; Description: VISITNUM must match a VISITNUM value FOR THE SUBJECT in SV). VISITNUM=3 is an SV visit of subject 01-701-1015 but NOT of subject 01-701-1023. Row 1 (01-701-1015, 3) is silent; row 2 (01-701-1023, 3) fires because the rule is per subject. Catches a port that dropped group=[USUBJID] (a study-wide SV set holds 3, so row 2 would fall silent) or that looked the row up under the wrong subject's group."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1023 VISITNUM=3
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB | 3 | WEEK 2
CDISCPILOT01 | LB | 01-701-1023 | 1 | ALB | 3 | WEEK 2
---

dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | SV | 01-701-1015 | 1 | SCREENING
CDISCPILOT01 | SV | 01-701-1015 | 2 | BASELINE
CDISCPILOT01 | SV | 01-701-1015 | 3 | WEEK 2
CDISCPILOT01 | SV | 01-701-1023 | 1 | SCREENING
CDISCPILOT01 | SV | 01-701-1023 | 2 | BASELINE
---
