#!RuleTest
#test FDA-SD2244 expect=violation domain=TS
#note "Row 2 is the FCNTRY record and carries TSVCDREF='ISO 639' instead of the required 'ISO 3166' -> fires. Row 1 carries the same wrong reference but under a different TSPARMCD, so this rule must leave it alone (pins the TSPARMCD gate)."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 TSPARMCD=FCNTRY TSVCDREF="ISO 639"
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
col TSVALCD  type=Char label="Parameter Value Code"
col TSVCDREF type=Char label="Parameter Value Code Reference"
---
S1 | TS | 1 | SPLNCTRY | Planned Country of Investigational Sites | USA | USA | ISO 639
S1 | TS | 2 | FCNTRY | Planned Country of Investigational Sites | USA | USA | ISO 639
