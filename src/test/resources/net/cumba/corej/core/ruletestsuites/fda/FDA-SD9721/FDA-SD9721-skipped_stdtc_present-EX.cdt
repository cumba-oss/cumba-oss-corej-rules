#!RuleTest
#test FDA-SD9721 expect=skipped domain=EX
#note "The discriminator: the EXSTDTC column EXISTS (blank on both rows), so Requirements.Variables.None [--STDTC, --STRF, --STRTPT] skips this sister with a reason naming the column, and FDA-SD0031 owns the case, reporting row 1 (EXENDTC populated, no start populated) with its location."
#library standard=sendig version=3-1-1
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Actual Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
col EXENDTC type=Char label="End Date/Time of Treatment"
---
S1 | EX | 001 | 1 | VEHICLE   | | 2023-04-05
S1 | EX | 001 | 2 | TEST ITEM | |
