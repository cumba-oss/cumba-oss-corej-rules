#!RuleTest
#test CDISC-AD0078 expect=violation domain=ADSL
# Rule:Description: At least one TRTxxP is present where xx is greater than 01 and TRxxSDT is not present
#note "TRT02P present (xx=02>01) but TR02SDT absent -> violation"
#expectViolationCount 1
#expectViolationAt nameOnly=TRT02P
dataset ADSL class=ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRT01P type=Char
col TRT02P type=Char
---
CDISCPILOT01 | 01-701-1015 | Placebo | Drug A
---
