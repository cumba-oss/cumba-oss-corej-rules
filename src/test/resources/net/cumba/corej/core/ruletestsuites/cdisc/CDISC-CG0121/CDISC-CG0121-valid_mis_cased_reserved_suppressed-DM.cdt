#!RuleTest
#test CDISC-CG0121 expect=noViolation domain=DM
#note "The ARM-side twin of CDISC-CG0118's suppression case. ARM='NOT ASSIGNED' in the CT casing against the IG's 'Not Assigned'; before upper() the rule fired, after it the value is recognised as reserved. ⚠ CG0121 carries no 'not empty(ARM)' guard, so every row here has a populated ARM on purpose - an empty one would fire for an unrelated reason and mask what this file pins."
#library standard=sdtmig version=3-2
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARM      type=Char label="Description of Planned Arm"
---
CDISCPILOT01 | DM | 01-001 | Placebo
CDISCPILOT01 | DM | 01-002 | NOT ASSIGNED
---

dataset TA label="Trial Arms"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
col TAETORD type=Num  label="Planned Order of Element within Arm"
col ETCD    type=Char label="Element Code"
---
CDISCPILOT01 | TA | PBO   | Placebo | 1 | TRT
---
