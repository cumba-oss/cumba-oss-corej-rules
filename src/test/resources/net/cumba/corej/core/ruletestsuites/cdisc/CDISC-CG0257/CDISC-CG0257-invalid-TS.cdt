#!RuleTest
#test CDISC-CG0257 expect=violation domain=TS
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0257 (Domain TS, Variable TSPARMCD; Rule: TSPARMCD value length <= 8). Row 2: TSPARMCD=AGEMINIMUM is 10 characters -> fires. Row 1 (AGEMIN, 6 characters) and row 3 (ADDONTRT, exactly 8 characters, the boundary) -> silent."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 TSSEQ=1 TSPARMCD=AGEMINIMUM
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
CDISCPILOT01 | TS | 1 | AGEMIN | Planned Minimum Age of Subjects | P50Y
CDISCPILOT01 | TS | 1 | AGEMINIMUM | Planned Minimum Age of Subjects | P50Y
CDISCPILOT01 | TS | 1 | ADDONTRT | Added on to Existing Treatments | N
