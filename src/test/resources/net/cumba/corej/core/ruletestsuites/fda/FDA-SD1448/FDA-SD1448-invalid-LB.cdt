#!RuleTest
#test FDA-SD1448 expect=violation domain=LB
#note "Row 2 LBSTRESC='<0.5' is not a numeric value, yet LBSTRESN=0.5 is populated; row 3 does the same with 'BLQ'. ⭐ Row 4 added 2026-09-14 and it is a SILENT row on purpose — the count stays 2. This rule is the FDA twin of PMDA-SD1448, byte-identical, and that one is where the is_numeric ruling of 2026-09-14 cost a finding (see its note). This suite stayed green through that change only because no row held an exponent. The conformant exponent pair now sits here too, asserting that it is NOT flagged: '1.23E-4' and 0.000123 are the same number, correctly paired. If a future change to is_numeric narrows it back, this row starts firing and the count breaks — which is the whole point of putting it in a file that counts."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=2 LBSTRESC=<0.5 LBSTRESN=0.5
#expectViolationAt row=3 LBSTRESC=BLQ LBSTRESN=0
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBSTRESC type=Char label="Character Result/Finding in Std Format"
col LBSTRESN type=Num  label="Numeric Result/Finding in Standard Units"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB  | 40   | 40
CDISCPILOT01 | LB | 01-701-1015 | 2 | GLUC | <0.5 | 0.5
CDISCPILOT01 | LB | 01-701-1015 | 3 | CREA | BLQ  | 0
CDISCPILOT01 | LB | 01-701-1015 | 4 | TSH  | 1.23E-4 | 0.000123
