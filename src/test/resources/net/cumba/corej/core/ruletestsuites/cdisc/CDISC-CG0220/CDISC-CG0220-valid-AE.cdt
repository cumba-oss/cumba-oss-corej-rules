#!RuleTest
#test CDISC-CG0220 expect=noViolation domain=AE
#note "AESTDTC and DM.RFSTDTC are complete dates and AESTDY matches the study day algorithm (2014-01-05 against RFSTDTC 2014-01-02 is day 4; the reference day itself is day 1), so the rule does not fire."
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AESTDTC type=Char label="Start Date/Time of Adverse Event"
col AESTDY type=Num label="Study Day of Start of Adverse Event"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | 2014-01-02 | 1
CDISCPILOT01 | AE | 01-701-1015 | 2 | 2014-01-05 | 4
---

dataset DM label=Demographics
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
---
CDISCPILOT01 | DM | 01-701-1015 | 2014-01-02
---
