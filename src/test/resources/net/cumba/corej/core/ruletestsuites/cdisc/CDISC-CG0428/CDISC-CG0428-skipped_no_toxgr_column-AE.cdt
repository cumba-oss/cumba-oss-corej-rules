#!RuleTest
#test CDISC-CG0428 expect=skipped domain=AE
#note "AETOXGR column absent while AETOX is populated. Requirements.Variables.All [--TOX, --TOXGR] gates the rule out -> auditable skip naming the absent variable, instead of one finding per row under absent = all-missing (EC-43). Row 1 WOULD fire were the gate removed. Verdict 2-1': CDISC-CG0084 reports the absence itself (its Source inverts the subject: 'do not ship a toxicity without a grade'); FDA/PMDA-SD1036 already gated this shape and are thereby confirmed right."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col AESEQ    type=Num  label="Sequence Number"
col AETERM   type=Char label="Reported Term for the Adverse Event"
col AETOX    type=Char label="Toxicity"
---
S1 | AE | 001 | 1 | ANEMIA | CTCAE
