#!RuleTest
#test CDISC-SEND-0306 expect=noViolation domain=DM
#note "PLAN-scalar-date-extremes: EX ABSENT while POOLDEF is present: no subject is dosed per the data ($ex_subjects is empty, $pool_ex_rows counts nothing), RFXENDTC populated -> silent. Pin."
#library standard=sendig version=3-1-1
dataset DM label=Demographics
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFXENDTC type=Char label="Date/Time of Last Study Treatment"
---
S1 | DM | 001 | 2020-01-10
---
dataset POOLDEF label="Pool Definition"
col STUDYID type=Char label="Study Identifier"
col POOLID  type=Char label="Pool Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
---
S1 | P1 | 001
---
