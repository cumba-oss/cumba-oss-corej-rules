#!RuleTest
#test CDISC-CG0380 expect=violation domain=AE
#note "PLAN-per-row-functions phase 0 (first scenario for CDISC-CG0380): AEPTCD=1234567 on row 2 is not a Preferred Term code of the (dummy) MedDRA dictionary at the PTCD level -> fires. Row 1 carries a valid PTCD (10019211); row 3's missing AEPTCD is a completeness concern of another rule -> no fire (a blank is valid). Executing pin written against the pre-port engine."
#library standard=sdtmig version=3-4
#dictionaries dummy
#expectViolationCount 1
#expectViolationAt row=2 AESEQ=2 AEPTCD=1234567
dataset AE class=EVENTS
col USUBJID type=Char
col AESEQ   type=Num
col AEDECOD type=Char
col AEPTCD type=Num
---
001 | 1 | Headache | 10019211
001 | 2 | Nausea   | 1234567
002 | 1 | Headache | .
