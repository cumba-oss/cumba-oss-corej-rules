#!RuleTest
#test CDISC-SEND-0247 expect=violation domain=TS
#note "Positive control added by PLAN-absent-guard-test-hardening P3: this rule previously had ONLY an expect=skipped fixture, which asserts non-execution and so proved nothing about the rule ever running at this standard/version. TS carries only TITLE, so the required parameter set is not fully present and not_contains_all fires."
#library standard=sendig version=3-0
#expectViolationCount 1
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL    type=Char label="Parameter Value"
---
CDISCPILOT01 | TS | 1 | TITLE | A Phase 3 Study
---
