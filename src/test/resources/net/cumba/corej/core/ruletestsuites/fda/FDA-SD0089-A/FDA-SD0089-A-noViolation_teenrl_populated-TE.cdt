#!RuleTest
#test FDA-SD0089-A expect=noViolation domain=TE
#note "TEDUR is not present in the dataset, but TEENRL is populated on every record - each Element carries an end rule or a planned duration through the one column it has, so the sibling stays silent."
#library standard=sdtmig version=3-4
dataset TE label="Trial Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ETCD    type=Char label="Element Code"
col ELEMENT type=Char label="Description of Element"
col TESTRL  type=Char label="Rule for Start of Element"
col TEENRL  type=Char label="Rule for End of Element"
---
CDISCPILOT01 | TE | SCRN | Screening | Informed consent | End of screening
CDISCPILOT01 | TE | TRT | Treatment | First dose | End of study
