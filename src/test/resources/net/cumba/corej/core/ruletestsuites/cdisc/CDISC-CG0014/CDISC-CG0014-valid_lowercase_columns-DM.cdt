#!RuleTest
#test CDISC-CG0014 expect=noViolation domain=DM
#note "All SDTMIG-Required DM variables are present as columns spelled in lower case, as a SAS dataset may carry them. CG0014 tests presence; a column is present in any letter case (owner ruling 2026-09-28: the rule compares the upper-cased dataset names against the library's upper-case names) -> no violation."
#library standard=sdtmig version=3-4
#library required-variables DM STUDYID DOMAIN USUBJID SUBJID SITEID SEX
dataset DM label="Demographics"
col studyid type=Char label="Study Identifier"
col domain  type=Char label="Domain Abbreviation"
col usubjid type=Char label="Unique Subject Identifier"
col subjid  type=Char label="Subject Identifier for the Study"
col siteid  type=Char label="Study Site Identifier"
col sex     type=Char label="Sex"
---
S1 | DM | S1-001 | 001 | 01 | F
