#!RuleTest
#test PMDA-AD0228B expect=noViolation domain=ADSL
#note "Row 3 carries TRTSEQPN=1, so each TRTSEQP group maps to one TRTSEQPN."
#library standard=adamig version=1-3
dataset ADSL class=ADSL
col STUDYID  type=Char
col USUBJID  type=Char
col TRTSEQP  type=Char
col TRTSEQPN type=Num
---
S1 | 001 | A-B | 1
S1 | 002 | A-B | 1
S1 | 003 | A-B | 1
S1 | 004 | B-A | 3
S1 | 005 | B-A | 3
