#!RuleTest
#test CDISC-CG0063 expect=noViolation domain=DS
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0063 (Condition: multiple events per subject where DSCAT = 'DISPOSITION EVENT'; Rule: EPOCH ^= null). Subject 01-701-1015 has two DISPOSITION EVENT records and both carry EPOCH (TREATMENT, FOLLOW-UP). Subject 01-701-1023 has a single disposition event with EPOCH null, outside the multiple-events Condition. The PROTOCOL MILESTONE row (EPOCH null) is outside the Condition -> silent."
#library standard=sdtmig version=3-2
dataset DS class=EVENTS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSTERM  type=Char label="Reported Term for the Disposition Event"
col DSDECOD type=Char label="Standardized Disposition Term"
col DSCAT   type=Char label="Category for Disposition Event"
col EPOCH   type=Char label="Epoch"
---
CDISCPILOT01 | DS | 01-701-1015 | 1 | INFORMED CONSENT OBTAINED | INFORMED CONSENT OBTAINED | PROTOCOL MILESTONE |
CDISCPILOT01 | DS | 01-701-1015 | 2 | COMPLETED | COMPLETED | DISPOSITION EVENT | TREATMENT
CDISCPILOT01 | DS | 01-701-1015 | 3 | COMPLETED | COMPLETED | DISPOSITION EVENT | FOLLOW-UP
CDISCPILOT01 | DS | 01-701-1023 | 1 | ADVERSE EVENT | ADVERSE EVENT | DISPOSITION EVENT |
