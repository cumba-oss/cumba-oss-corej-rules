#!RuleTest
#test CDISC-AD0102 expect=noViolation domain=ADAE
#note "PLAN-dynamic-column-corpus-respelling §2.2 Q1 / QS (b), S2: APERIOD=1.5 is not a period number. printf(\"%02d\", 1.5) is a computed missing, so the bound name $trt_p is missing and `not empty($trt_p)` is false -> silent. The base ${APERIOD:%02d} spelling truncated 1.5 to 1, found no ADSL.TRT01P (ADSL carries TRT02P only) and fired (red on the base text, as ruled 2026-10-03)."
#library standard=adamig version=1-3
dataset ADAE
col STUDYID type=Char
col USUBJID type=Char
col APERIOD type=Num
col AETERM  type=Char
---
STUDY1 | S1 | 1.5 | AE1
---

dataset ADSL label="Subject-Level Analysis"
col STUDYID type=Char
col USUBJID type=Char
col TRT02P  type=Char
---
STUDY1 | S1 | Drug B
---
