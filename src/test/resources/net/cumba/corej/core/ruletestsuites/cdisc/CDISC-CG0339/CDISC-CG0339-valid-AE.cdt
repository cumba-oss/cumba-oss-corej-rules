#!RuleTest
#test CDISC-CG0339 expect=noViolation domain=AE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0339 (Rule: --CAT ^= --BODSYS). No AECAT repeats its AEBODSYS; row 3's AECAT is null. Both columns are present, so the rule executes -> silent."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col AESEQ    type=Num  label="Sequence Number"
col AETERM   type=Char label="Reported Term for the Adverse Event"
col AEDECOD  type=Char label="Dictionary-Derived Term"
col AEBODSYS type=Char label="Body System or Organ Class"
col AECAT    type=Char label="Category for Adverse Event"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE | HEADACHE | NERVOUS SYSTEM DISORDERS | STUDY DRUG RELATED
CDISCPILOT01 | AE | 01-701-1015 | 2 | DIARRHOEA | DIARRHOEA | GASTROINTESTINAL DISORDERS | NOT RELATED
CDISCPILOT01 | AE | 01-701-1023 | 1 | PALPITATIONS | PALPITATIONS | CARDIAC DISORDERS | 
---
