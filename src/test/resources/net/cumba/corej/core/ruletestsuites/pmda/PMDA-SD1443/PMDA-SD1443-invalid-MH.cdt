#!RuleTest
#test PMDA-SD1443 expect=violation domain=MH
#note "The collected term 'ASTHMA' is assigned two different body systems, so --BODSYS is not consistent for the same --TERM. Both records of the conflicting pair are reported."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 MHTERM=ASTHMA MHBODSYS="Respiratory, thoracic and mediastinal disorders"
#expectViolationAt row=2 MHTERM=ASTHMA MHBODSYS="Immune system disorders"
dataset MH class=EVENTS label="Medical History"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col MHSEQ    type=Num  label="Sequence Number"
col MHTERM   type=Char label="Reported Term for the Medical History"
col MHDECOD  type=Char label="Dictionary-Derived Term"
col MHBODSYS type=Char label="Body System or Organ Class"
---
S1 | MH | 001 | 1 | ASTHMA | Asthma | Respiratory, thoracic and mediastinal disorders
S1 | MH | 002 | 1 | ASTHMA | Asthma | Immune system disorders
S1 | MH | 003 | 1 | ECZEMA | Eczema | Skin and subcutaneous tissue disorders
