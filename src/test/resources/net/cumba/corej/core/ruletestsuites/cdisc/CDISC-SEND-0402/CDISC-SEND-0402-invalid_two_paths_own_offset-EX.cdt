#!RuleTest
#test CDISC-SEND-0402 expect=violation domain=EX
#note "PLAN-rprfdy-offset-tp-join: the RPRFDY offset is applied again, read from TP through DM.RPATHCD by read_value(RPRFDY, domain="TP", group=[DM.RPATHCD, RPHASE], mode="MAX") (owner EC-47 option B, C2, D-SJ, D-GUARD (b)), C2: each record reads ITS path's RPRFDY. Two paths share phase P1 — A with RPRFDY 0 (subject 001), B with RPRFDY 1 (subject 002) — and both records carry 15 (diff 14 + 1). 002 is conformant on path B; 001 is REPORTED (path A expects 14). Red-before on the W2b rule (offset-free, both expect 14): two findings. A grouped read keyed by RPHASE alone (the EC-44 trap) would answer MAX over both paths, 1, for both records and report neither."
#library standard=sendig-dart version=1-2
#expectViolationCount 1
#expectViolationAt row=1 EXRPSTDY=15
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col RPHASE  type=Char label="Repro Phase"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
col EXRPSTDY type=Num  label="Repro Phase Day of Start of Treatment"
---
S1 | EX | 001 | 1 | P1 | 2020-01-15 | 15
S1 | EX | 002 | 2 | P1 | 2020-01-15 | 15
---
dataset SJ class="SPECIAL PURPOSE" label="Subject Repro Stages"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SJSEQ   type=Num  label="Sequence Number"
col RPHASE  type=Char label="Repro Phase"
col RSTAGE  type=Char label="Repro Stage"
col SJSTDTC type=Char label="Start Date/Time of Repro Stage"
col SJENDTC type=Char label="End Date/Time of Repro Stage"
---
S1 | SJ | 001 | 1 | P1 | STAGE1 | 2020-01-01 | 2020-01-20
S1 | SJ | 002 | 2 | P1 | STAGE1 | 2020-01-01 | 2020-01-20
---
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RPATHCD type=Char label="Planned Repro Path Code"
---
S1 | DM | 001 | A
S1 | DM | 002 | B
---
dataset TP class="TRIAL DESIGN" label="Trial Repro Paths"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col RPATHCD  type=Char label="Planned Repro Path Code"
col TPSTGORD type=Num  label="Order of Repro Stage within Repro Path"
col RSTGCD   type=Char label="Repro Stage Code"
col RSTAGE   type=Char label="Description of Repro Stage"
col RPHASE   type=Char label="Repro Phase"
col RPRFDY   type=Num  label="Repro Phase Start Reference Day"
---
S1 | TP | A | 1 | STG1 | Stg1 | P1 | 0
S1 | TP | B | 1 | STG1 | Stg1 | P1 | 1
---
