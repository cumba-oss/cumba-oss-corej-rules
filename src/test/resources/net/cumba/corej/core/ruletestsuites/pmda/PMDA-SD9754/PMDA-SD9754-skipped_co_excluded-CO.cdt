#!RuleTest
#test PMDA-SD9754 expect=skipped domain=CO
#note "Scope boundary: CO is excluded (the parent PMDA-SD1093 excludes CO); the body would fire (COENDY populated, no COENDTC)."
#library standard=sdtmig version=3-2
dataset CO class="SPECIAL PURPOSE" label="Comments"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col COSEQ    type=Num  label="Sequence Number"
col COVAL type=Char label="Comment"
col COENDY type=Num label="Study Day of End of Observation"
---
S1 | CO | 001 | 1 | NOTE A | 5
S1 | CO | 002 | 2 | NOTE B | 6
S1 | CO | 003 | 3 | NOTE C | 
