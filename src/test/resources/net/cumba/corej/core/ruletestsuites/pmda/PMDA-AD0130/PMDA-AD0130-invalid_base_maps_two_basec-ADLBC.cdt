#!RuleTest
#test PMDA-AD0130 expect=violation domain=ADLBC
#note "Mirror of AD0129: dependent BASEC, key BASE. Key 120 carries two distinct dependents {NORMAL, WITHINRANGE}, so both rows holding it fire."
#library standard=adamig version=1-3
#expectViolationCount 2
#expectViolationAt row=1 PARAMCD=SYSBP BASE=120 BASEC=NORMAL
#expectViolationAt row=2 PARAMCD=SYSBP BASE=120 BASEC=WITHINRANGE
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col BASE    type=Num
col BASEC   type=Char
---
CDISCPILOT01 | 01-701-1015 | SYSBP | 120 | NORMAL
CDISCPILOT01 | 01-701-1015 | SYSBP | 120 | WITHINRANGE
CDISCPILOT01 | 01-701-1015 | SYSBP | 140 | HIGH
