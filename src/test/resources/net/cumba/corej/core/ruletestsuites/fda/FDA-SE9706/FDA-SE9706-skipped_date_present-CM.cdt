#!RuleTest
#test FDA-SE9706 expect=skipped domain=CM
#note "The discriminator: CMSTDTC is PRESENT (blank on row 2) -> the companion SKIPS on None [--STDTC]; the imputation parents FDA-SD1388 / FDA-SD1391 runs and reports the record whose date is incomplete."
#library standard=sendig version=ar-1-0
dataset CM class=INTERVENTIONS label="Concomitant/Prior Medications"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col CMSEQ    type=Num  label="Sequence Number"
col CMTRT type=Char label="Reported Name of Drug, Med, or Therapy"
col CMCHSTDY type=Num label="Start Day of Obs Rel to Challenge Agent"
col CMXSTDY type=Num label="Start Day of Obs Rel to Exposure"
col CMSTDTC type=Char label="Start Date/Time of Observation"
---
S1 | CM | 001 | 1 | SALINE | 5 |  | 2020-01-05
S1 | CM | 002 | 2 | SALINE | 6 |  | 
S1 | CM | 003 | 3 | SALINE |  |  | 2020-01-07
