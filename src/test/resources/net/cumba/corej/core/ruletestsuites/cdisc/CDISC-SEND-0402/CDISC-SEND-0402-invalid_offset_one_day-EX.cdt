#!RuleTest
#test CDISC-SEND-0402 expect=violation domain=EX
#note "Written FIRST in runbook W2a (PLAN-operation-replacements phase 0), on the pre-change engine. EXRPSTDY carries 15 - the value the sheet's algorithm yields on a path whose RPRFDY is 1 (14 + 1). The engine does not apply the RPRFDY offset (owner ruling EC-47 = (C), 2026-09-29; TP is reachable only through DM.RPATHCD, see PLAN-rprfdy-offset-tp-join), so the derived day is 14 and this record is REPORTED although it may be conformant for an RPRFDY=1 path. That is the documented over-reporting of the Partially Executable rule, pinned here so the limitation is visible rather than assumed. One SJ stage on purpose: the count-bearing fixture must not be multiplied by the (USUBJID, RPHASE) join."
#library standard=sendig-dart version=1-2
#expectViolationCount 1
#expectViolationAt row=1 EXRPSTDY=15
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col RPHASE  type=Char label="Repro Phase"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
col EXRPSTDY type=Num label="Repro Phase Day of Start of Treatment"
---
S1 | EX | 001 | 1 | P1 | 2020-01-15 | 15
---

dataset SJ class="SPECIAL PURPOSE" label="Subject Repro Stages"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SJSEQ   type=Num  label="Sequence Number"
col RPHASE  type=Char label="Repro Phase"
col RSTAGE  type=Char label="Repro Stage"
col SJSTDTC type=Char label="Start Date/Time of Repro Stage"
col SJENDTC type=Char label="End Date/Time of Repro Stage"
---
S1 | SJ | 001 | 1 | P1 | STAGE1 | 2020-01-01 | 2020-01-20
---
