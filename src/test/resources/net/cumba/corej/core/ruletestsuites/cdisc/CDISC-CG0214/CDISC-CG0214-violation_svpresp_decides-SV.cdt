#!RuleTest
#test CDISC-CG0214 expect=violation domain=SV
#note "B1 of PLAN-unplanned-visit-cascade: SVPRESP is present and DECIDES. Row 2 carries SVPRESP='' - present and not Y, so tier 1 calls it unplanned, and its VISITNUM sits in TV -> fires. Row 1 is flagged Y -> planned -> exempt. Row 3 is unplanned but its VISITNUM is not in TV -> clean. No SVUPDES column on purpose: the pre-cascade SVUPDES form of this rule was silent on this whole dataset, so this fixture reds under the old form."
#library standard=sdtmig version=3-3
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1015
dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SVSEQ    type=Num  label="Sequence Number"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col SVPRESP  type=Char label="Pre-Specified"
---
CDISCPILOT01 | SV | 01-701-1015 | 1 | 2 | BASELINE | Y
CDISCPILOT01 | SV | 01-701-1015 | 2 | 2 | BASELINE | 
CDISCPILOT01 | SV | 01-701-1015 | 3 | 99 | WEEK 99 | 
---

dataset TV label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | TV | 1 | SCREENING
CDISCPILOT01 | TV | 2 | BASELINE
---
