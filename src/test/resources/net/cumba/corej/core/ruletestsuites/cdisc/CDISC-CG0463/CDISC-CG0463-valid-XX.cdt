#!RuleTest
#test CDISC-CG0463 expect=noViolation domain=XX
#note "XX is class=INTERVENTIONS and a custom domain, and it carries its topic variable XXTRT -> no violation. W4b (PLAN-scalar-metadata-functions phase 0, scenarios-first on the pre-port engine)."
#library standard=sdtmig version=3-4
#library custom-domain XX
dataset XX class=INTERVENTIONS label="Custom INTERVENTIONS"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col XXSEQ   type=Num  label="Sequence Number"
col XXTRT type=Char label="Name of Treatment"
---
S1 | XX | 001 | 1 | ASPIRIN
