#!RuleTest
#test PMDA-SD9715 expect=skipped domain=LB
#note "No LBSTRESC column: Requirements.Variables.All [--STRESC] gates the rule out. --STRESU is deliberately absent from the gate - that is PMDA-SD0029's job, and putting it here would blind the sister to the case it exists for."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
col LBORRES  type=Char
---
S1 | LB | 001 | 1 | GLUC | 7.2
