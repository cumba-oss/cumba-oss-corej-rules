#!RuleTest
#test PMDA-SD1018 expect=violation domain=SV
#note "PLAN-join-key-authoring-gate phase 3/4, sensitivity arm row 2 — a NON-first key absent on BOTH sides. Neither SV nor TV carries VISITDY, so the group [VISITDY, TV.VISITDY] is all-absent and satisfied: the rule RUNS and JKM R7 drops the VISITDY component, joining on VISITNUM + VISIT. Row 1 matches TV on the reduced key and must not fire; row 2 (VISITNUM 3 / WEEK 2) matches no TV entry and fires. Proves the pairing gate does not skip the conformant SDTMIG shape an All gate would have skipped."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1015 VISITNUM=3
dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col SVUPDES  type=Char label="Description of Unplanned Visit"
---
CDISCPILOT01 | SV | 01-701-1015 | 1 | SCREENING |
CDISCPILOT01 | SV | 01-701-1015 | 3 | WEEK 2    |
---

dataset TV label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | TV | 1 | SCREENING
CDISCPILOT01 | TV | 2 | BASELINE
