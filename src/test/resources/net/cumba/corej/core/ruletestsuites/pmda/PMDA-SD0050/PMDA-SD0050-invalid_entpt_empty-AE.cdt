#!RuleTest
#test PMDA-SD0050 expect=violation domain=AE
#note "Both columns present (the Requirements.Variables.All [--ENRTPT, --ENTPT] gate is satisfied), so the verdict is unchanged by the gate: row 1 has AEENRTPT=ONGOING with AEENTPT empty -> fires. Row 2: both populated -> clean."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 AEENRTPT=ONGOING
dataset AE class=EVENTS
col STUDYID   type=Char
col DOMAIN    type=Char
col USUBJID   type=Char
col AESEQ     type=Num
col AETERM    type=Char
col AEENRTPT  type=Char
col AEENTPT   type=Char
---
S1 | AE | 001 | 1 | HEADACHE | ONGOING |
S1 | AE | 001 | 2 | NAUSEA   | ONGOING | 2020-03-15
