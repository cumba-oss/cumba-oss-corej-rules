#!RuleTest
#test CDISC-CG0456 expect=violation domain=TS
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0456 (Domain TS, Variable TSVCDREF; Condition: TSPARMCD = 'FCNTRY'; Rule: TSVCDREF = 'ISO 3166-1 alpha-3'). row 3 (FCNTRY, TSVCDREF=ISO 3166-1 alpha-2) meets the Condition with a different reference terminology -> fires. Silent: row 1 (TITLE, outside the Condition); row 2 (FCNTRY, TSVCDREF=ISO 3166-1 alpha-3); row 4 (REGID, TSVCDREF=ClinicalTrials.gov)."
#library standard=sdtmig version=3-3
#expectViolationCount 1
#expectViolationAt row=3 TSSEQ=2 TSPARMCD=FCNTRY TSVCDREF="ISO 3166-1 alpha-2"
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
col TSVALCD  type=Char label="Parameter Value Code"
col TSVCDREF type=Char label="Name of the Reference Terminology"
col TSVCDVER type=Char label="Version of the Reference Terminology"
---
CDISCPILOT01 | TS | 1 | TITLE | Trial Title | A Study of Xanomeline | | |
CDISCPILOT01 | TS | 1 | FCNTRY | Planned Country of Investigational Sites | USA | USA | ISO 3166-1 alpha-3 | 
CDISCPILOT01 | TS | 2 | FCNTRY | Planned Country of Investigational Sites | DE | DE | ISO 3166-1 alpha-2 | 
CDISCPILOT01 | TS | 1 | REGID | Registry Identifier | NCT00000000 | NCT00000000 | ClinicalTrials.gov | 
---
