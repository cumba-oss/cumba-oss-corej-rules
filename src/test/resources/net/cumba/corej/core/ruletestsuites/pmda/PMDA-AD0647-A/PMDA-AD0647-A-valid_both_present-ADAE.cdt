#!RuleTest
#test PMDA-AD0647-A expect=noViolation domain=ADAE
#note "Both columns present: the indexed flag TREM01FL and the overall TRTEMFL. The presence requirement is satisfied, so this rule is silent regardless of the VALUES -- the value comparison is the job of the sibling rules, not this one."
#library standard=adamig version=1-3
dataset ADAE structure=OCCDS subclass=AE
col STUDYID  type=Char
col USUBJID  type=Char
col ASEQ     type=Num
col AEDECOD  type=Char
col TREM01FL type=Char
col TRTEMFL  type=Char
---
CDISCPILOT01 | 01-701-1015 | 1 | HEADACHE | Y | N
