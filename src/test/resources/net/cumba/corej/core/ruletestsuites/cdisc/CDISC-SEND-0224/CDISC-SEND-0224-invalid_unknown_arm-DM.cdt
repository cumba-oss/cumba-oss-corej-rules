#!RuleTest
#test CDISC-SEND-0224 expect=violation domain=DM
#note "Row 2's pair (Z, Arm Z) matches no TA record at all -> FIRES. Row 1's (A, Arm A) is a real TA pair -> silent. Row 3 leaves both blank, so the two `not empty` conjuncts are false -> silent. Pin on ARMCD, not ARM: 'Arm Z' contains a space and a space-free code is the stabler pin."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=002 ARMCD=Z
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col SEX     type=Char label="Sex"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
---
S1 | DM | 001 | 001 | M | A | Arm A
S1 | DM | 002 | 002 | F | Z | Arm Z
S1 | DM | 003 | 003 | M |   |
---

dataset TA label="Trial Arms"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
col TAETORD type=Num  label="Order of Element within Arm"
col ETCD    type=Char label="Element Code"
col ELEMENT type=Char label="Description of Element"
---
S1 | TA | A | Arm A | 1 | SCRN | Screening
S1 | TA | B | Arm B | 1 | SCRN | Screening
---
