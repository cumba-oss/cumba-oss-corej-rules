#!RuleTest
#test PMDA-SD1104 expect=violation domain=CE
#note "Shipped Check var_exists(\"--STTPT\") and not var_exists(\"--STRTPT\") resolves per the EC-36 prefix rule to CESTTPT/CESTRTPT; both leaves are dataset constants -> BroadcastFold -> exactly ONE violation reported at row=1 regardless of row count."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 CESTTPT=SCREENING
dataset CE class=EVENTS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col CESEQ    type=Num
col CESTTPT  type=Char
---
S1 | CE | 001 | 1 | SCREENING
