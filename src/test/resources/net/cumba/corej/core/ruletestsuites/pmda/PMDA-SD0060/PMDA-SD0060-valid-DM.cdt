#!RuleTest
#test PMDA-SD0060 expect=noViolation domain=DM
#note "Every submitted variable (STUDYID, USUBJID, AGE, AGEU) has a define declaration."
#library standard=sdtmig version=3-4
#define variable-metadata DM STUDYID name=STUDYID label="Study Identifier"
#define variable-metadata DM USUBJID name=USUBJID label="Unique Subject Identifier"
#define variable-metadata DM AGE name=AGE label="Age"
#define variable-metadata DM AGEU name=AGEU label="Age Units"
dataset DM
col STUDYID type=Char
col USUBJID type=Char
col AGE     type=Num  label="Age"
col AGEU    type=Char label="Age Units"
---
CDISCPILOT01 | 01-701-1015 | 56 | YEARS
