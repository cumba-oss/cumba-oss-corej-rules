#!RuleTest
#test FDA-SD1452 expect=noViolation domain=CM
# Rule:Description: Raise an error when a non-missing Treatment Vehicle Amount (--VAMT) value is negative (less than 0).
#note "CMVAMT holds a non-negative value (100); the other record leaves it empty -> no violation"
#library standard=sdtmig version=3-4
dataset CM label="Concomitant Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ type=Num label="Sequence Number"
col CMVAMT type=Num label="Treatment Vehicle Amount"
---
CDISCPILOT01 | CM | 01-701-1015 | 1 | 100
CDISCPILOT01 | CM | 01-701-1015 | 2 |
---
