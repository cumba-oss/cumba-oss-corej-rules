#!RuleTest
#test CDISC-AD9704 expect=noViolation domain=ADSL
#note "Authority: ADaMIG v1.3 Section 3.2 ADSL variables with Core = Req (the list the structure-keyed library publishes, carrying the naming template TRTxxP). Every Required variable is present, spelled in lower case, and trt01p is the planned-treatment instance of TRTxxP -> no violation. The template match enters the Required list in the dataset's own spelling, so the rule compares the upper-cased dataset names against the upper-cased Required list (CIT 3)."
#library standard=adamig version=1-3
#library required-variables-for-structure "SUBJECT LEVEL ANALYSIS DATASET" STUDYID USUBJID SUBJID SITEID AGE AGEU SEX RACE ARM TRTxxP
dataset ADSL structure=ADSL
col studyid type=Char label="Study Identifier"
col usubjid type=Char label="Unique Subject Identifier"
col subjid  type=Char label="Subject Identifier for the Study"
col siteid  type=Char label="Study Site Identifier"
col age     type=Num  label="Age"
col ageu    type=Char label="Age Units"
col sex     type=Char label="Sex"
col race    type=Char label="Race"
col arm     type=Char label="Description of Planned Arm"
col trt01p  type=Char label="Planned Treatment for Period 01"
---
CDISCPILOT01 | 01-701-1015 | 1015 | 701 | 63 | YEARS | F | WHITE | Placebo | Placebo
