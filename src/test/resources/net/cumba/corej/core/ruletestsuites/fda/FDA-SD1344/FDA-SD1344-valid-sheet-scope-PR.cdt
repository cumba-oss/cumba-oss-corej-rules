#!RuleTest
#test FDA-SD1344 expect=skipped domain=PR
#note "Regression pin for the T1 Scope fix (ERROR lane): Scope is Domains [CM] per the sheet, so PR records are not judged by this rule."
#library standard=sdtmig version=3-4
#dictionaries dummy
dataset PR class=INTERVENTIONS
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col PRSEQ   type=Num
col PRTRT   type=Char
col PRDECOD type=Char
---
S01 | PR | 001 | 1 | Appendectomy | APPENDECTOMY
