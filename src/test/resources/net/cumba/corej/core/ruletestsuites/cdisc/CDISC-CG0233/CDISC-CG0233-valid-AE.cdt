#!RuleTest
#test CDISC-CG0233 expect=noViolation domain=AE
# Rule:Description: Raise an error when the start reference time point (--STTPT) is a complete date earlier than the date/time of collection (--DTC) but the start relative to reference time point (--STRTPT) is not one of 'BEFORE', 'COINCIDENT', 'AFTER', or 'UNKNOWN'.
#note "AESTTPT prior to AEDTC but AESTRTPT is an allowed value, so the rule does not fire"
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AEDTC type=Char label="Date/Time of Collection"
col AESTTPT type=Char label="Start Reference Time Point"
col AESTRTPT type=Char label="Start Relative to Reference Time Point"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | 2014-01-20 | 2014-01-10 | BEFORE
CDISCPILOT01 | AE | 01-701-1015 | 2 | 2014-01-16 | 2014-01-10 | COINCIDENT
---
