#!RuleTest
#test CDISC-SEND-0070 expect=violation domain=LB
#note "THIRD-DISJUNCT PIN. LBDTC and LBSTDTC are blank and LBENDTC carries the mismatching interval, so the finding can only come from $interval_mismatch_endtc: row 1 is tier 10 against tier 4, row 2 is 10 against 10. Because the Check is a three-way OR, this proves the third operand is wired and not shadowed by the first."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 LBSEQ=1
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Test Short Name"
col LBDTC    type=Char label="Date/Time of Specimen Collection"
col LBSTDTC  type=Char label="Start Date/Time of Specimen Collection"
col LBENDTC  type=Char label="End Date/Time of Specimen Collection"
---
S1 | LB | 001 | 1 | ALB |  |  | 2023-01-15/2023
S1 | LB | 001 | 2 | ALB |  |  | 2023-01-15/2023-01-20
---
