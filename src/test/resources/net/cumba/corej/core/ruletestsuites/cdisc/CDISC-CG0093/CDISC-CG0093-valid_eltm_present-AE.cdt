#!RuleTest
#test CDISC-CG0093 expect=noViolation domain=AE
# Rule:Description: Raise an error when --ELTM, --TPTNUM, --TPT, --STINT, and --ENINT are not present in the dataset but --TPTREF is present.
#note "AEELTM present alongside AETPTREF -> 'not var_exists(--ELTM)' is false, rule silent"
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AEELTM type=Char label="Elapsed Time from Reference Point"
col AETPTREF type=Char label="Time Point Reference"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | PT1H | DOSING
CDISCPILOT01 | AE | 01-701-1015 | 2 | PT2H | DOSING
---
