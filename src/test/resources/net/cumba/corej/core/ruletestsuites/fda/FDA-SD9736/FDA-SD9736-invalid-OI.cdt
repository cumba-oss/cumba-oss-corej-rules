#!RuleTest
#test FDA-SD9736 expect=violation domain=OI
# Rule:Description: Raise an error when OIPARMCD and OIPARM do not have a one-to-one relationship.
#note "OIPARMCD=PARAM1 maps to two different OIPARM values, breaking the one-to-one relationship"
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1
#expectViolationAt row=2
dataset OI label="Non-host Organism Identifiers"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col OIPARMCD type=Char label="Organism Identifier Parameter Short Name"
col OIPARM type=Char label="Organism Identifier Parameter"
---
CDISCPILOT01 | OI | PARAM1 | Parameter One
CDISCPILOT01 | OI | PARAM1 | Different Parameter
---
