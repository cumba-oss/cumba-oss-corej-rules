#!RuleTest
#test CDISC-AD0506 expect=noViolation domain=ADLBC
#library standard=adamig version=1-3
#library variable-metadata ADLBC *ADY name=*ADY label="{Relative Day}"
# Rule:Description: A variable ending in ADY must contain "Relative Day" in the label
#note "PADY label contains "Relative Day" -> noViolation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col PADY type=Char label="Analysis Relative Day"
---
CDISCPILOT01 | 01-701-1015 | ALB | x
---
