#!RuleTest
#test CDISC-CG0362 expect=skipped domain=RELSUB
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0362 (Condition: POOLID ^= null; Rule: USUBJID = null). The RELSUB dataset carries no POOLID column, so the Condition can never hold; Requirements.Variables.All [POOLID] gates the rule to SKIPPED."
#library standard=sdtmig version=3-4
dataset RELSUB class=RELATIONSHIP label="Related Subjects"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col RSUBJID type=Char label="Related Subject or Pool Identifier"
col SREL    type=Char label="Subject Relationship"
---
CDISCPILOT01 | 01-701-1015 | 01-701-1016 | MOTHER, BIOLOGICAL
CDISCPILOT01 | 01-701-1016 | 01-701-1015 | CHILD, BIOLOGICAL
---
