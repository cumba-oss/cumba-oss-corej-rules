#!RuleTest
#test CDISC-CG0147 expect=noViolation domain=DM
# Rule:Description: Raise an error when Exposure (EX) records are present for a subject, but the Subject Reference End Date/Time (RFXENDTC) in the Demographics (DM) domain does not equal the latest Exposure Start Date/Time (EXSTDTC) or the latest Exposure End Date/Time (EXENDTC) in the EX domain for that subject.
#note "RFXENDTC equals the latest EX.EXENDTC for each subject -> no violation"
dataset DM label=Demographics
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFXENDTC type=Char label="Date/Time of Last Study Treatment"
---
CDISCPILOT01 | DM | 01-701-1015 | 2014-07-02
CDISCPILOT01 | DM | 01-701-1023 | 2012-09-01
---

dataset EX label=Exposure
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
col EXENDTC type=Char label="End Date/Time of Treatment"
---
CDISCPILOT01 | EX | 01-701-1015 | 2014-01-02 | 2014-01-16
CDISCPILOT01 | EX | 01-701-1015 | 2014-01-17 | 2014-06-18
CDISCPILOT01 | EX | 01-701-1015 | 2014-06-19 | 2014-07-02
CDISCPILOT01 | EX | 01-701-1023 | 2012-08-05 | 2012-08-27
CDISCPILOT01 | EX | 01-701-1023 | 2012-08-28 | 2012-09-01
---
