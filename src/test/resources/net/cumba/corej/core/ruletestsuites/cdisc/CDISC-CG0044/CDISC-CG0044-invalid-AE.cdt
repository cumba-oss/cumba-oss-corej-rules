#!RuleTest
#test CDISC-CG0044 expect=violation domain=AE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0044 (Rule: AESTAT not present in dataset). The AE dataset carries the AESTAT column -> the dataset-level check fires once for the dataset (reported on its first record), however many records it holds."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESTAT type=Char label="Completion Status"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE | NOT DONE
CDISCPILOT01 | AE | 01-701-1023 | 1 | NAUSEA |
