      <ItemDef OID="IT.DM.AGEU.B" Name="AGEU_B" DataType="text" Length="8" CommentOID="COM.AGEU.B">
        <Description><TranslatedText xml:lang="en">Age Unit (B)</TranslatedText></Description>
      </ItemDef>

      <def:ValueListDef OID="VL.DM.AGEU">
        <ItemRef ItemOID="IT.DM.AGEU.A" OrderNumber="1" Mandatory="No">
          <def:WhereClauseRef WhereClauseOID="WC.AGEU.A"/>
