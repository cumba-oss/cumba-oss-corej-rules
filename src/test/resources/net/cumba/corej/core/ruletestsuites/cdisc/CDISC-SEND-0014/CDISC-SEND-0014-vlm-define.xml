      </def:ValueListDef>

      <def:WhereClauseDef OID="WC.AGEU.A">
        <RangeCheck SoftHard="Soft" def:ItemOID="IT.DM.ARMCD" Comparator="EQ">
          <CheckValue>A</CheckValue>
        </RangeCheck>
      </def:WhereClauseDef>
      <def:WhereClauseDef OID="WC.AGEU.B">
        <RangeCheck SoftHard="Soft" def:ItemOID="IT.DM.ARMCD" Comparator="EQ">
          <CheckValue>B</CheckValue>
        </RangeCheck>
      </def:WhereClauseDef>
      <CommentDef OID="COM.STUDYID">
        <Description><TranslatedText xml:lang="en">Standard study identifier.</TranslatedText></Description>
      </CommentDef>
      <CommentDef OID="COM.USUBJID">
        <Description><TranslatedText xml:lang="en">Standard unique subject identifier.</TranslatedText></Description>
