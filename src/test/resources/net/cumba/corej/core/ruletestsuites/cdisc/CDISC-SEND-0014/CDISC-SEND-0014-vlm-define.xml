      </CommentDef>
      <CommentDef OID="COM.AGEU.A">
        <Description><TranslatedText xml:lang="en">Age Unit for ARMCD=A, as collected.</TranslatedText></Description>
      </CommentDef>
      <CommentDef OID="COM.AGEU.B">
