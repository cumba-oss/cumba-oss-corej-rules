#!RuleTest
#test FDA-SD1018 expect=noViolation domain=SV
#note "Row 1 is a planned visit (SVUPDES empty) whose VISITNUM/VISIT/VISITDY triple matches TV; row 2 is an unplanned visit (SVUPDES populated) not in TV and must not fire."
#library standard=sdtmig version=3-4
dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col VISITDY  type=Num  label="Planned Study Day of Visit"
col SVUPDES  type=Char label="Description of Unplanned Visit"
---
CDISCPILOT01 | SV | 01-701-1015 | 1   | SCREENING     | -7 |
CDISCPILOT01 | SV | 01-701-1015 | 1.1 | UNSCHEDULED 1 | .  | Subject felt unwell
---

dataset TV label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col VISITDY  type=Num  label="Planned Study Day of Visit"
---
CDISCPILOT01 | TV | 1 | SCREENING | -7
CDISCPILOT01 | TV | 2 | BASELINE  | 1
