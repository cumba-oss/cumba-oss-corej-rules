#!RuleTest
#test FDA-SD9725 expect=skipped domain=PP
#note "Neither PPTEST nor an interval column is in the dataset: Requirements.Variables.All [--TEST] is unsatisfied, so the sister skips naming PPTEST. Without the trigger column the sister cannot tell whether any parameter is an interval; PPTEST is Required in PP, so this shape is already reported by the generic Required-variable rules."
#library standard=sdtmig version=3-4
dataset PP class=FINDINGS label="Pharmacokinetics Parameters"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PPSEQ    type=Num  label="Sequence Number"
col PPTESTCD type=Char label="Parameter Short Name"
---
S1 | PP | 001 | 1 | AUCINT
