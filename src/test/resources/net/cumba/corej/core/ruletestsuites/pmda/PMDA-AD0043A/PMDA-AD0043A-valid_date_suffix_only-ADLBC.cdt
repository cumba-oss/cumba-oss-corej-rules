#!RuleTest
#test PMDA-AD0043A expect=noViolation domain=ADLBC
#note "ADT ends with DT, not DTM, so this rule is silent even though the format is missing - that variable belongs to PMDA-AD0041A. Pins the suffix boundary from the other side."
#library standard=adamig version=1-3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ADT     type=Num
---
S1 | 001 | ALB | 22000
---
