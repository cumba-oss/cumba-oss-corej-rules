#!RuleTest
#test CDISC-SEND-0353.1 expect=violation domain=SJ
#library standard=sendig-dart version=1-1
#note "ordered by SJSEQ, record 1's SJENDTC does not equal record 2's SJSTDTC (a gap) - one finding, on the current row; the last record never fires"
#expectViolationCount 1
#expectViolationAt row=1 SJSEQ=1 USUBJID=R-001
dataset SJ label="Subject Stages"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SJSEQ   type=Num  label="Sequence Number"
col SJSTDTC type=Char label="Start Date/Time of Repro Stage"
col SJENDTC type=Char label="End Date/Time of Repro Stage"
---
STUDY01 | SJ | R-001 | 1 | 2013-12-26 | 2014-01-02
STUDY01 | SJ | R-001 | 2 | 2014-01-05 | 2014-07-02
---
