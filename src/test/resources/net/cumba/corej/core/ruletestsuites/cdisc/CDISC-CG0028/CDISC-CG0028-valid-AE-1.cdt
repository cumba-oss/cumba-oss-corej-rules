#!RuleTest
#test CDISC-CG0028 expect=noViolation domain=AE
# Rule:Description: Raise an error when Sequence Number (--SEQ), excluding Trial Summary Sequence Number (TSSEQ), is not a unique number per USUBJID per domain, nor a unique number per POOLID per domain, including when the domain is split into multiple files.
#note "AESEQ is a unique number within each USUBJID per domain, so the rule does not fire"
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
---
CDISCPILOT01 | AE | 01-701-1015 | 1
CDISCPILOT01 | AE | 01-701-1015 | 2
CDISCPILOT01 | AE | 01-701-1023 | 1
---
