#!RuleTest
#test CDISC-AD0520 expect=noViolation domain=ADLBC
# Rule:Description: A variable ending in ETMF must have a label that ends with "Imputation Flag" (or "Imput. Flag") and contains "End" and "Time"
#note "CDISC's own ADaMIG labels: AETMF spells Imputation in full; APERETMF, PHETMF and the expanded AP01ETMF abbreviate to "Imput." -> all accepted"
#library standard=adamig version=1-3
#library column-order ADLBC STUDYID USUBJID PARAMCD
#library variable-metadata ADLBC *ETMF name=*ETMF label="{End Time Imputation Flag}"
#library variable-metadata ADLBC *TMF name=*TMF label="{Time Imputation Flag}"
#library variable-metadata ADSL TRTETMF name=TRTETMF label="Time of Last Exposure Imput. Flag"
#library variable-metadata ADSL TRxxETMF name=TRxxETMF label="Time Last Exposure Period xx Imput. Flag"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AETMF type=Char label="Analysis End Time Imputation Flag"
col APERETMF type=Char label="Period End Time Imput. Flag"
col PHETMF type=Char label="Phase End Time Imput. Flag"
col AP01ETMF type=Char label="Period 01 End Time Imput. Flag"
---
CDISCPILOT01 | 01-701-1015 | ALB | x | x | x | x
---
