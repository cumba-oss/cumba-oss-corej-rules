#!RuleTest
#test CDISC-CG0001 expect=skipped domain=LB
#note "Define-XML sidecar present, but NO #library line at all (legal in the cdisc family) -> the library-dependent declared operations (domain_is_custom, codelist_terms) make the rule SKIP."
#define-xml CDISC-CG0001-define.xml
dataset LB class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
---
S1 | LB | 001 | 1 | GLUC
