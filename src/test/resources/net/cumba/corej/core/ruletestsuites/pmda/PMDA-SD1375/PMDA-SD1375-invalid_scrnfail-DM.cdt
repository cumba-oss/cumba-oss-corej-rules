#!RuleTest
#test PMDA-SD1375 expect=violation domain=DM
#note "The membership branch. Row 1: ACTARMCD=SCRNFAIL, RFENDTC populated -> fires. Row 2: ACTARMCD=NOTASSGN, RFENDTC empty -> conformant. Isolates ACTARMCD in [SCRNFAIL,NOTASSGN,NOTTRT] against the empty-ACTARMCD branch of the previous fixture."
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015 ACTARMCD=SCRNFAIL
#library standard=sdtmig version=3-4
dataset DM label="Demographics"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col RFSTDTC  type=Char
col RFENDTC  type=Char
col ACTARMCD type=Char
---
CDISCPILOT01 | DM | 01-701-1015 | | 2020-02-10 | SCRNFAIL
CDISCPILOT01 | DM | 01-701-1023 | | | NOTASSGN
---
