#!RuleTest
#test CDISC-CG0174 expect=violation domain=FA
# Rule:Description: Raise an error when a related record is present in the parent domain dataset but FAOBJ does not equal the --TERM, --TRT or --DECOD value of that parent record.
#note "PLAN-merged-evaluation-table W5 (OD-4, MET #17): the cross product is taken PER RELATIONSHIP. FA 1 (ASPIRIN) is related to AE 1 (AEDECOD ASPIRIN) in R1 and to CM 1 (IBU / IBUPROFEN) in R3; FA 2 (MYSTERY) to CM 1 in R2. Each relationship is its own row: FA 1's R1 row carries AE (match, silent), its R3 row carries CM (mismatch, one finding); FA 2's R2 row carries CM (mismatch, one finding). Two findings, one per FA record — never AE beside CM on one row."
#expectViolationCount 2
#expectViolationAt row=1 FASEQ=1 USUBJID=01
#expectViolationAt row=2 FASEQ=2 USUBJID=01
dataset FA label="Findings About"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col FASEQ type=Num label="Sequence Number"
col FAOBJ type=Char label="Object of the Observation"
---
S1 | FA | 01 | 1 | ASPIRIN
S1 | FA | 01 | 2 | MYSTERY
---

dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AETERM type=Char label="Reported Term for the Adverse Event"
col AEDECOD type=Char label="Dictionary-Derived Term"
---
S1 | AE | 01 | 1 | Headache | ASPIRIN
---

dataset CM label="Concomitant/Prior Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ type=Num label="Sequence Number"
col CMTRT type=Char label="Reported Name of Drug, Med, or Therapy"
col CMDECOD type=Char label="Standardized Medication Name"
---
S1 | CM | 01 | 1 | IBU | IBUPROFEN
---

dataset RELREC label="Related Records"
col STUDYID type=Char label="Study Identifier"
col RDOMAIN type=Char label="Related Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col IDVAR type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col RELID type=Char label="Relationship Identifier"
---
S1 | FA | 01 | FASEQ | 1 | R1
S1 | AE | 01 | AESEQ | 1 | R1
S1 | FA | 01 | FASEQ | 2 | R2
S1 | CM | 01 | CMSEQ | 1 | R2
S1 | FA | 01 | FASEQ | 1 | R3
S1 | CM | 01 | CMSEQ | 1 | R3
---
