#!RuleTest
#test CDISC-AD0511 expect=noViolation domain=ADLBC
# Rule:Description: A variable ending in SDTM must contain "Start Datetime" in the label
#note "ASDTM label contains "Start Datetime" -> noViolation"
#library standard=adamig version=1-3
#library column-order ADLBC STUDYID USUBJID PARAMCD
#library variable-metadata ADLBC *SDTM name=*SDTM label="{Start Datetime}"
#library variable-metadata ADLBC *DTM name=*DTM label="{Datetime}"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ASDTM type=Char label="Analysis Start Datetime"
---
CDISCPILOT01 | 01-701-1015 | ALB | x
---
