#!RuleTest
#test PMDA-AD0283 expect=skipped domain=ADSL
#note "Declared ADSL structure beats any column signal; Scope.Data_Structures:[BDS,OCCDS] does not admit ADSL -> pre-gate skips before the operator runs, even though the same inconsistent data (MILD|1, MODERATE|1, SEVERE|3) WOULD fire if in scope. THE BATCH'S SINGLE PIN on the [BDS,OCCDS] block, shared by AD0289/0290/0295/0296."
#library standard=adamig version=1-0
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col ASEV    type=Char
col ASEVN   type=Num
---
CDISCPILOT01 | 01-701-1015 | MILD | 1
CDISCPILOT01 | 01-701-1023 | MODERATE | 1
CDISCPILOT01 | 01-701-1034 | SEVERE | 3
