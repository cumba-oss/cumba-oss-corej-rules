#!RuleTest
#test CDISC-CG0628 expect=violation domain=LB
# Rule:Description: Raise an error when --EXCLFL is present in a Findings dataset, since --EXCLFL is not permitted in human clinical trials.
#note "LBEXCLFL column is present in LB, so the rule fires"
#expectViolationCount 1
#expectViolationAt row=1
dataset LB label="Laboratory Tests Results"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col LBSEQ type=Num label="Sequence Number"
col LBEXCLFL type=Char label="Exclusion Flag"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 |
CDISCPILOT01 | LB | 01-701-1015 | 2 |
---
