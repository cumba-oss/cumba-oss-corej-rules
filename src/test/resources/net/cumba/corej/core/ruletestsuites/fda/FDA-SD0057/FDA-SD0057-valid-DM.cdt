#!RuleTest
#test FDA-SD0057 expect=noViolation domain=DM
#note "All Expected variables are present as columns -> no violation."
#library standard=sdtmig version=3-4
#library expected-variables DM RFSTDTC RFENDTC AGE AGEU RACE
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
col RFENDTC type=Char label="Subject Reference End Date/Time"
col AGE     type=Num  label="Age"
col AGEU    type=Char label="Age Units"
col RACE    type=Char label="Race"
---
S1 | DM | S1-001 | 2024-01-01 | 2024-02-01 | 56 | YEARS | ASIAN
