#!RuleTest
#test CDISC-CG0454 expect=violation domain=TS
#note "PLAN-per-row-functions phase 0 (first scenario for CDISC-CG0454): row 2's TSVALCD=N9999999999 under TSPARMCD=PCLAS is not a MED-RT class code (MEDRTCD level) of the (dummy) medrt dictionary -> fires. Row 1 is valid (N0000000181); row 3 carries the same invalid value under AGEMAX (outside the rule's TSPARMCD condition); row 4's blank TSVALCD is a completeness concern of another rule -> no fire. Executing pin written against the pre-port engine."
#library standard=sdtmig version=3-3
#dictionaries dummy
#expectViolationCount 1
#expectViolationAt row=2 TSSEQ=2 TSPARMCD=PCLAS TSVALCD=N9999999999
dataset TS
col STUDYID  type=Char
col DOMAIN   type=Char
col TSSEQ    type=Num
col TSPARMCD type=Char
col TSVALCD  type=Char
---
S01 | TS | 1 | PCLAS | N0000000181
S01 | TS | 2 | PCLAS | N9999999999
S01 | TS | 3 | AGEMAX | N9999999999
S01 | TS | 4 | PCLAS |
