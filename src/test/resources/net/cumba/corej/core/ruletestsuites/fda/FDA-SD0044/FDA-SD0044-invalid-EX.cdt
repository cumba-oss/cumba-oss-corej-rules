#!RuleTest
#test FDA-SD0044 expect=violation domain=EX
#note "Row 1 gives a treatment vehicle amount of 5 with empty units -> 'Treatment Vehicle Amount Units (--VAMTU) should not be NULL, when Treatment Vehicle Amount (--VAMT) is populated'."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 EXVAMT=5 EXVAMTU=
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXVAMT  type=Num  label="Treatment Vehicle Amount"
col EXVAMTU type=Char label="Treatment Vehicle Amount Units"
---
CDISCPILOT01 | EX | 01-701-1015 | 1 | DRUG A | 5  |
CDISCPILOT01 | EX | 01-701-1015 | 2 | DRUG A | 10 | mL
