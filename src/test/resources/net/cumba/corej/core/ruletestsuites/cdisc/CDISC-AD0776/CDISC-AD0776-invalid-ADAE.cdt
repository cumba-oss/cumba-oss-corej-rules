#!RuleTest
#test CDISC-AD0776 expect=violation domain=ADAE
# Rule:Description: There is more than one value of AERELN for a given value of AEREL, considering only those rows on which both variables are populated
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015
#expectViolationAt row=2 USUBJID=01-701-1015
# Declared-tier scope: structure= states the ADaM data structure this minimal table stands for;
# #define is its mandatory carrier (ScenarioDeclaredScopeProvider.install).
#define standard=adamig version=1-3
dataset ADAE structure=OCCDS
col STUDYID type=Char
col USUBJID type=Char
col ASEQ type=Num
col AERELN type=Char
col AEREL type=Char
---
CDISCPILOT01 | 01-701-1015 | 1 | 1 | RELATED
CDISCPILOT01 | 01-701-1015 | 2 | 2 | RELATED
CDISCPILOT01 | 01-701-1015 | 3 | 0 | NOT RELATED
