#!RuleTest
#test CDISC-SEND-0288-A expect=noViolation domain=TS
#note "Every record populates exactly one of TSVAL / TSVALNF. Same dataset as CDISC-SEND-0288-noViolation_exactly_one-TS: neither half of the split fires on the conformant state."
#library standard=sendig version=3-1-1
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL    type=Char label="Parameter Value"
col TSVALNF  type=Char label="Parameter Value Null Flavor"
---
S1 | TS | 1 | SPECIES | RAT    |
S1 | TS | 2 | STSTDTC |        | NA
