#!RuleTest
#test PMDA-AD0492 expect=violation domain=ADLBC
#note "Presence is a property of the DECLARED COLUMN SCHEMA, which survives at 0 rows; BroadcastFold decides a dataset-constant Check ABOVE the 0-row zero-column substitution, so the rule fires exactly once at row=1. NO VALUE PIN - extractOutputValues past the end of a 0-row table yields the empty string. Precedent: pmda/PMDA-AD0133A/PMDA-AD0133A-invalid_empty_dataset-ADLBC.cdt."
#expectViolationCount 1
#expectViolationAt row=1
#library standard=adamig version=1-3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col SHIFT1  type=Char
---
