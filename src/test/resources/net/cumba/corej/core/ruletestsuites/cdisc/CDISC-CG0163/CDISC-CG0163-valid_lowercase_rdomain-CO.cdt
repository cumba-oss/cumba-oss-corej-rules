#!RuleTest
#test CDISC-CG0163 expect=noViolation domain=CO
#note "Row 1: a non-DM comment with IDVARVAL carries IDVAR. Row 2: a subject-level comment on DM (RDOMAIN = dm, lower case) needs no IDVAR. Rule round 2026-10-12 (owner, queued item C3, as c5206c02): RDOMAIN names a domain, and dataset names match case-insensitively (owner 2026-10-01), so the literal comparison reads upper(RDOMAIN). Red under the old exact comparison (row 2 fired)."
#library standard=sdtmig version=3-4
dataset CO class="SPECIAL PURPOSE" label="Comments"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col COSEQ    type=Num  label="Sequence Number"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col COVAL    type=Char label="Comment"
---
S1 | CO | AE | 001 | 1 | AESEQ | 1 | MILD
S1 | CO | dm | 001 | 2 |       | 1 | SUBJECT COMMENT
