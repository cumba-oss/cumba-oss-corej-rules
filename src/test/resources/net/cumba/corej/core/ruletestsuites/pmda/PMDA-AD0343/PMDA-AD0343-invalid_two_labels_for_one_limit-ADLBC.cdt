#!RuleTest
#test PMDA-AD0343 expect=violation domain=ADLBC
#note "Mirror of AD0342: target is the character ANRLOC, key is the pair [PARAMCD, ANRLO], guard is not empty(ANRLO). Group (GLUC, 3) holds ANRLOC {LOWNORM x2, LN x1} -> row 3 is the lone minority. Row 4 shares the label but has key value 4 and stays silent. No wildcards."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 PARAMCD=GLUC ANRLO=3 ANRLOC=LN
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col ANRLO   type=Num
col ANRLOC  type=Char
---
S1 | 001 | GLUC | 5.0 | 3 | LOWNORM
S1 | 002 | GLUC | 5.1 | 3 | LOWNORM
S1 | 003 | GLUC | 5.2 | 3 | LN
S1 | 004 | GLUC | 5.3 | 4 | LN
