#!RuleTest
#test CDISC-CG0309 expect=noViolation domain=APAE
# Rule:Description: Raise an error when the DOMAIN value length of an Associated Persons (AP--) dataset is not equal to 4 characters.
#note "AP-- DOMAIN value APAE has length 4 -> no violation"
dataset APAE label="Associated Persons AE"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | APAE | 01-701-1015
---
