#!RuleTest
#test FDA-SD0095-A expect=noViolation domain=SUPPDM
#note "RDOMAIN=DM is explicitly exempt (Demographics) -> no violation regardless of DM's non-general-observation class"
#library standard=sdtmig version=3-4
#library dataset-class DM "SPECIAL PURPOSE"
dataset SUPPDM class=RELATIONSHIP label="Supplemental Qualifiers for DM"
col STUDYID type=Char label="Study Identifier"
col RDOMAIN type=Char label="Related Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col QNAM    type=Char label="Qualifier Variable Name"
col QVAL    type=Char label="Data Value"
---
S1 | DM | 001 | RACEOTH | Other race
S1 | DM | 002 | RACEOTH | Other race
