#!RuleTest
#test PMDA-SD0031 expect=skipped domain=AE
#note "None of the three start-point columns (AESTDTC/AESTRF/AESTRTPT) exists, so Requirements.Variables.Any [--STDTC, --STRF, --STRTPT] gates the rule out -> auditable skip. Row 1 is violating-shaped (AEENDTC populated, no start column) to prove ONLY the gate silences. Verdict 2-1: the absence is itself reportable, and the minted sister PMDA-SD9720 reports it ONCE for this dataset."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEENDTC type=Char label="End Date/Time of Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE | 2020-01-05
