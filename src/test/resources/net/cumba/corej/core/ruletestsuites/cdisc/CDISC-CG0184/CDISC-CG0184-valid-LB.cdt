#!RuleTest
#test CDISC-CG0184 expect=noViolation domain=LB
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0184 (Condition: LBORRES = continuous measurement; Rule: LBSTNRC = null). Rows 1-2: continuous results (5.6, <2.8) with LBSTNRC null. Rows 3-4: categorical / ordinal results (NEGATIVE, 1+) carry the character range NEGATIVE, which is what LBSTNRC is for -> silent."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBTEST   type=Char label="Lab Test or Examination Name"
col LBORRES  type=Char label="Result or Finding in Original Units"
col LBSTRESC type=Char label="Character Result/Finding in Std Format"
col LBSTNRC  type=Char label="Reference Range for Char Rslt-Std Units"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | GLUC | Glucose | 5.6 | 5.6 |
CDISCPILOT01 | LB | 01-701-1015 | 2 | GLUC | Glucose | <2.8 | <2.8 |
CDISCPILOT01 | LB | 01-701-1015 | 3 | KETONES | Ketones | NEGATIVE | NEGATIVE | NEGATIVE
CDISCPILOT01 | LB | 01-701-1015 | 4 | PROT | Protein | 1+ | 1+ | NEGATIVE
