#!RuleTest
#test PMDA-SD2001 expect=noViolation domain=DM
#note "FRESH, DISCRIMINATING. Zero data rows. Full column block including ACTARMCD (the fixture is about zero ROWS; the missing-column contract is the fixture above). Sensitivity RECORD, no synthetic table -> 0 findings."
#library standard=sdtmig version=3-4
#expectViolationCount 0
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ACTARMCD type=Char label="Actual Arm Code"
col ACTARM   type=Char label="Description of Actual Arm"
---
