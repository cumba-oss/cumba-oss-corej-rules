#!RuleTest
#test FDA-SE2241 expect=executionError domain=CL
#expect-execution-error "group= over 'DS' has no usable key"
#note "PLAN-join-key-one-side-absent-drop QK16 (b) / QK18 (owner 2026-10-11): DS without USUBJID - the domain= call's only group= member is on the evaluated side only, so no key member is left on both sides and the rule ERRORs (never an aggregate over the whole of DS). Derived from FDA-SE2241-invalid-CL.cdt with DS.USUBJID removed. A gate declaring DS.USUBJID would turn this into a SKIP."
#library standard=sendig version=3-1-1
#library dataset-class CL FINDINGS
dataset CL class=FINDINGS label="Clinical Observations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col CLSEQ    type=Num  label="Sequence Number"
col CLTESTCD type=Char label="Clinical Observation Short Name"
col CLDTC    type=Char label="Date/Time of Observation"
---
S1 | CL | 001 | 1 | CLSIGN | 2020-01-21
S1 | CL | 002 | 1 | CLSIGN | 2020-01-21
---

dataset DS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col DSSEQ   type=Num  label="Sequence Number"
col DSTERM  type=Char label="Reported Term for the Disposition Event"
col DSDECOD type=Char label="Standardized Disposition Term"
col DSSTDTC type=Char label="Start Date/Time of Disposition Event"
---
S1 | DS | 1 | MOVED TO RECOVERY   | RECOVERY            | 2020-01-10
S1 | DS | 2 | TERMINAL SACRIFICE  | TERMINAL SACRIFICE  | 2020-01-20
S1 | DS | 1 | TERMINAL SACRIFICE  | TERMINAL SACRIFICE  | 2020-01-25

