#!RuleTest
#test CDISC-SEND-0400 expect=noViolation domain=TT
#note "The R-5.25 wave-3 split's discriminator, parent side: TT is present, so the TT half is SILENT - although TP and SJ are both missing from this study, those are the siblings' findings (CDISC-SEND-0400-A and -B fire on exactly this study shape)."
#library standard=sendig-dart version=1-2
#expectViolationCount 0
dataset TT class="TRIAL DESIGN" label="Trial Repro Stages"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col TTSEQ   type=Num  label="Sequence Number"
---
S1 | TT | 1
