#!RuleTest
#test CDISC-CG0037 expect=violation domain=AE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0037 (Condition: Primary SOC used for analysis; Rule: --SOCCD = --BDSYCD). Row 2: the analysis SOC code AESOCCD=10029205 (nervous system) differs from the body system code AEBDSYCD=10017947 (gastrointestinal), both populated -> fires. Row 1 carries the same code on both sides and is silent."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1023 AESEQ=1
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEDECOD  type=Char label="Dictionary-Derived Term"
col AEBDSYCD type=Num  label="Body System or Organ Class Code"
col AESOCCD  type=Num  label="Primary System Organ Class Code"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE | HEADACHE | 10029205 | 10029205
CDISCPILOT01 | AE | 01-701-1023 | 1 | DIZZINESS | DIZZINESS | 10017947 | 10029205
