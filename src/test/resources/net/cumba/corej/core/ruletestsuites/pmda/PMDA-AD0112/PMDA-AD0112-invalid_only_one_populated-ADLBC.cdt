#!RuleTest
#test PMDA-AD0112 expect=violation domain=ADLBC
#note "Since the R-5.25 split this rule owns ONLY the time-without-unit half: row 1 (ARELTM with no ARELTMU) fires, row 2 (a unit with no time) is the SIBLING PMDA-AD0112-A's state and must NOT fire here - the discriminator of the split. Row 3 has both populated and row 4 has both blank, and neither is a violation. Record granularity -> exactly 1 violation."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015 ARELTM=4
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col ARELTM  type=Num
col ARELTMU type=Char
---
CDISCPILOT01 | 01-701-1015 | ALT | 2.5 | 4 |
CDISCPILOT01 | 01-701-1023 | ALT | 7.0 |   | HOURS
CDISCPILOT01 | 01-701-1034 | ALT | 9.9 | 8 | HOURS
CDISCPILOT01 | 01-701-1045 | ALT | 1.1 |   |
