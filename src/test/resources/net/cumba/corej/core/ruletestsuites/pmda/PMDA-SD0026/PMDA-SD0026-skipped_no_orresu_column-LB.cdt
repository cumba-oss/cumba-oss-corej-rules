#!RuleTest
#test PMDA-SD0026 expect=violation domain=LB
#note "dataset LB without the LBORRESU column, one numeric-result row. Requirements.Variables.All [--ORRESU] gates -> auditable skip naming the absent variable. Same encoding as the FDA twin; the deliberate contrast with SD0029's fire-on-absent arm is each sheet's own text."
#library standard=sdtmig version=3-4
#expectViolationCount 1
dataset LB class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
col LBORRES  type=Char
---
S1 | LB | 001 | 1 | GLUC | 120
