#!RuleTest
#test PMDA-AD0130 expect=noViolation domain=ADLBC
#note "Mirror of AD0129-valid_blank_basec's blank-KEY case: D.13 blank-DEPENDENT exclusion. Key 120 is populated on both rows, but the blank dependent (BASEC) is excluded from the fold, leaving the single dependent {NORMAL}, so nothing fires."
#library standard=adamig version=1-3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col BASE    type=Num
col BASEC   type=Char
---
CDISCPILOT01 | 01-701-1015 | SYSBP | 120 | NORMAL
CDISCPILOT01 | 01-701-1015 | SYSBP | 120 |
