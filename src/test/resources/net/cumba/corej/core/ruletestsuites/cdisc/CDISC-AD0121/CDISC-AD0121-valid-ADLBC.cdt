#!RuleTest
#test CDISC-AD0121 expect=noViolation domain=ADLBC
# Rule:Description: The value of a variable with a suffix of SDT is greater than the value of a variable with the same root and a suffix of EDT, considering only rows on which both variables are populated
#note "ASDT=50 not greater than AEDT=100 -> noViolation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ASDT type=Num
col AEDT type=Num
---
CDISCPILOT01 | 01-701-1015 | GLUC | 50 | 100
---
