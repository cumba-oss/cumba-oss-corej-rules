#!RuleTest
#test PMDA-SD1279 expect=violation domain=EC
#note "row 1: ECDOSE column present with a missing cell, ECOCCUR=Y, ECSTAT empty, ECDOSTXT present but empty -> fires; row 2 dose populated, row 3 ECOCCUR=N -> guarded. (H3 template form of the shared EQ class check; byte-identical twins CDISC-CG0462 / FDA-SD1279.)"
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 ECSEQ=1
dataset EC class=INTERVENTIONS label="Exposure as Collected"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ECSEQ    type=Num  label="Sequence Number"
col ECTRT    type=Char label="Name of Treatment"
col ECOCCUR  type=Char label="Occurrence"
col ECDOSE   type=Num  label="Dose"
col ECDOSTXT type=Char label="Dose Description"
col ECSTAT   type=Char label="Completion Status"
---
S1 | EC | 001 | 1 | DRUG A | Y | . | |
S1 | EC | 001 | 2 | DRUG A | Y | 5 | |
S1 | EC | 001 | 3 | DRUG A | N | . | |
