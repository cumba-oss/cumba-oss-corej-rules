#!RuleTest
#test FDA-SD0058-E expect=violation domain=SE
#note "SESTDY is not in the SEND SE model list and the SENDIG grants no additional Timing variables to SE (unlike SDTMIG SE assumptions 12/13), so it is reported at ERROR."
#library standard=sendig version=3-1
#library model-column-order SE STUDYID DOMAIN USUBJID SESEQ ETCD ELEMENT SESTDTC SEENDTC SEUPDES
#expectViolationCount 1
#expectViolationAt severity=ERROR variable_name=SESTDY
dataset SE
col STUDYID type=Char
col DOMAIN type=Char
col USUBJID type=Char
col SESEQ type=Num
col ETCD type=Char
col SESTDTC type=Char
col SEENDTC type=Char
col SESTDY type=Char
---
S1 | SE | 001 | 1 | SCRN | 2012-07-06 | 2012-07-09 | 1
---
