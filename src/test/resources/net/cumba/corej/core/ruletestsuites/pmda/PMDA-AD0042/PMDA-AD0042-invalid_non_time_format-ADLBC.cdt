#!RuleTest
#test PMDA-AD0042 expect=violation domain=ADLBC
#note "ASTTM ends with TM (not DTM), not ARELTM, Num, non-empty format matching none of the 14 SAS time formats -> one finding. No row= pin."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt variable_name=ASTTM variable_format=8.
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ASTTM   type=Num format=8.
---
CDISCPILOT01 | 01-701-1015 | ALB | 13.5
