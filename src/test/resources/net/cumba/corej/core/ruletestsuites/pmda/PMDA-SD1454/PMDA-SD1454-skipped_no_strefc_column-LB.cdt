#!RuleTest
#test PMDA-SD1454 expect=skipped domain=LB
#note "LBSTREFC column absent -> Requirements.Variables.All [--STREFC, --DRVFL] unsatisfied -> variable-scope SKIP."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
col LBDRVFL  type=Char
---
S1 | LB | 001 | 1 | GLUC | Y
S1 | LB | 001 | 2 | GLUC | Y
