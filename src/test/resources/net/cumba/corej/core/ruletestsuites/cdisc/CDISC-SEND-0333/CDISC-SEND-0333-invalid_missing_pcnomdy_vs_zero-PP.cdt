#!RuleTest
#test CDISC-SEND-0333 expect=violation domain=PP
#note "Tuple-identity pin (runbook W7, PLAN-distinct-function; the FINDINGS-distinct-scenarios-ahead F4 hazard-2 shape). Authority: SEND Conformance Rules v5.0 SEND333 (Rule: PCNOMDY & PCTPTREF = PPNOMDY & PPTPTREF). PC row 2 carries a MISSING PCNOMDY (an unquoted `.` in a Num column) with PCTPTREF `Day 0`, so the PC pair set holds the tuple (missing, Day 0). PP row 2 carries the PRESENT number 0 with `Day 0`. A missing value is not the number 0, not the empty string and not the text `.` (rulings D11 / D12 / D34 #5-2): the PP pair (0, Day 0) is in no PC record, so row 2 fires; row 1 (1, Day 1 Dose) has its PC pair and stays silent. Catches a port that renders a missing tuple component as 0, as `` or as its `.` display string on either side — under any of those the two tuples compare equal and row 2 falls silent."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=S1-001 PPNOMDY=0 PPTPTREF="Day 0"
dataset PP class=FINDINGS label="Pharmacokinetics Parameters"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PPSEQ    type=Num  label="Sequence Number"
col PPTESTCD type=Char label="Parameter Short Name"
col PPNOMDY  type=Num  label="Nominal Study Day for Tabulations"
col PPTPTREF type=Char label="Time Point Reference"
---
S1 | PP | S1-001 | 1 | CMAX | 1 | Day 1 Dose
S1 | PP | S1-001 | 2 | CMAX | 0 | Day 0
---

dataset PC class=FINDINGS label="Pharmacokinetics Concentrations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PCSEQ    type=Num  label="Sequence Number"
col PCTESTCD type=Char label="Test Short Name"
col PCNOMDY  type=Num  label="Nominal Study Day for Tabulations"
col PCTPTREF type=Char label="Time Point Reference"
col PCTPTNUM type=Num  label="Planned Time Point Number"
---
S1 | PC | S1-001 | 1 | DRUGX | 1 | Day 1 Dose | 1
S1 | PC | S1-001 | 2 | DRUGX | . | Day 0      | 1
---
