#!RuleTest
#test CDISC-CG0430 expect=noViolation domain=AE
# Rule:Description: Raise an error when --SCAT is present in a dataset, but --CAT is not present.
#note "AESCAT is present (exists true) but AECAT is also present, so the not_exists(--CAT) conjunct is false and the rule does not fire"
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AECAT type=Char label="Category for Adverse Event"
col AESCAT type=Char label="Subcategory for Adverse Event"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | GENERAL | SERIOUS
CDISCPILOT01 | AE | 01-701-1015 | 2 | GENERAL | NON-SERIOUS
---
