#!RuleTest
#test FDA-SD1078 expect=noViolation domain=TF
#note "SENDIG-AR 1.0 prints no TF; the base-IG view (PLAN-send-base-ig-view, B-BASE) reads it from SENDIG v3.1. TFNAM is populated -> no finding (executed, not SKIPPED)."
#library-ref standard=sendig version=ar-1-0 ct=sendct-2026-03-27
dataset TF label="Tumor Findings"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col TFSEQ type=Num label="Sequence Number"
col TFSPID type=Char label="Mass Identifier"
col TFTESTCD type=Char label="Tumor Examination Short Name"
col TFTEST type=Char label="Tumor Examination Name"
col TFORRES type=Char label="Result or Finding as Collected"
col TFSTRESC type=Char label="Standardized Result in Character Format"
col TFRESCAT type=Char label="Neoplasm Classification"
col TFSPEC type=Char label="Specimen Material Type"
col TFDTHREL type=Char label="Relationship to Death"
col TFDETECT type=Num label="Time in Days to Detection of Tumor"
col TFNAM type=Char label="Laboratory Name"
---
S1 | TF | S1-001 | 1 | MASS 1 | TUMEX | Tumor Examination | ADENOCARCINOMA | ADENOCARCINOMA, MALIGNANT | MALIGNANT | ABDOMINAL WALL | N | 127 | LAB 1
S1 | TF | S1-002 | 1 | MASS 2 | TUMEX | Tumor Examination | ADENOCARCINOMA | ADENOCARCINOMA, MALIGNANT | MALIGNANT | ABDOMINAL WALL | N | 127 | LAB 1
---
