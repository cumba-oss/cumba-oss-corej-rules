#!RuleTest
#test PMDA-SD0063 expect=violation domain=DM
#note "AGE carries the sponsor label instead of the SDTMIG label -> fires on AGE. AGEU/SEX match; STUDYID/USUBJID have no Library entry so the equality guard excludes them."
#library standard=sdtmig version=3-2
#library variable-metadata DM AGE  name=AGE  label="Age"
#library variable-metadata DM AGEU name=AGEU label="Age Units"
#library variable-metadata DM SEX  name=SEX  label="Sex"
#expectViolationCount 1
#expectViolationAt variable_name=AGE
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col AGE     type=Num  label="Age in Years"
col AGEU    type=Char label="Age Units"
col SEX     type=Char label="Sex"
---
S1 | 001 | 56 | YEARS | M
