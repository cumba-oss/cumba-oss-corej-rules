#!RuleTest
#test CDISC-CG0425 expect=noViolation domain=QS
#note "QS without a QSSTRESU column - QSSTRESU is Permissible and SDTMIG 3.4's own QS examples omit it - and every result is categorical, so the numeric restriction is false on every row. This is the case that used to produce one CG0425 finding per record; nothing is reported now, by either half of the pair."
#library standard=sdtmig version=3-4
dataset QS class=FINDINGS label="Questionnaires"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col QSSEQ    type=Num  label="Sequence Number"
col QSTESTCD type=Char label="Question Short Name"
col QSSTRESC type=Char label="Character Result/Finding in Std Format"
col QSORRESU type=Char label="Original Units"
---
CDISCPILOT01 | QS | 01-701-1015 | 1 | ADAS01 | NEVER |
CDISCPILOT01 | QS | 01-701-1015 | 2 | ADAS02 | SOMETIMES |
