#!RuleTest
#test PMDA-AD0376-A expect=noViolation domain=ADLBC
#note "Negative control: the APERIODC expansion exists (APERIODC seeds it) and the character secondary is populated wherever the primary is -> the rule executes without firing."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADLBC
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col APERIOD  type=Num
col APERIODC type=Char
---
CDISCPILOT01 | 01-701-1015 | ALB | 1 | PERIOD1
CDISCPILOT01 | 01-701-1023 | ALB | 2 | PERIOD2
