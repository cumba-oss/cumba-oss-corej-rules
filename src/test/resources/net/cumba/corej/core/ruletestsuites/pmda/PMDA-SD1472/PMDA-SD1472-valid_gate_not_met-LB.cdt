#!RuleTest
#test PMDA-SD1472 expect=noViolation domain=LB
#note "LBSTNRLO missing -- the `not empty(--STNRLO)` gate is false, no fire despite the non-numeric result."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID   type=Char
col DOMAIN    type=Char
col USUBJID   type=Char
col LBSEQ     type=Num
col LBTESTCD  type=Char
col LBORRES   type=Char
col LBSTNRLO  type=Num
---
S1 | LB | 001 | 1 | GLUC | POSITIVE | .
