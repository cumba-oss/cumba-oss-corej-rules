#!RuleTest
#test CDISC-AD0518 expect=noViolation domain=ADLBC
#library standard=adamig version=1-3
#library variable-metadata ADLBC *EDY name=*EDY label="{Relative End Day}"
#library variable-metadata ADLBC *ADY name=*ADY label="{Relative Day}"
# Rule:Description: A variable ending in EDY must contain "Relative End Day" in the label
#note "AEDY label contains "Relative End Day" -> noViolation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AEDY type=Char label="Analysis Relative End Day"
---
CDISCPILOT01 | 01-701-1015 | ALB | x
---
