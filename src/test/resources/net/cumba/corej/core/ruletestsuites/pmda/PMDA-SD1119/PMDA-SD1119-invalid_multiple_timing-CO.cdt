#!RuleTest
#test PMDA-SD1119 expect=violation domain=CO
#note "FRESH. FOUR of the thirteen Permissible variables are populated (COSPID, VISIT, VISITNUM, CODY) AND BOTH related-arms hold (RDOMAIN and IDVAR). The count must still be 1: the thirteen-way disjunction is ONE predicate on ONE record, so the finding does not scale with how many disjuncts are true. This is the SD1073 lesson from batch T3-K1-04 restated for a Record-level rule, and no twin covers it."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 nameOnly=RDOMAIN
dataset CO class="SPECIAL PURPOSE" label="Comments"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col COSEQ    type=Num  label="Sequence Number"
col IDVAR    type=Char label="Identifying Variable"
col COVAL    type=Char label="Comment"
col COSPID   type=Char label="Sponsor-Defined Identifier"
col VISIT    type=Char label="Visit Name"
col VISITNUM type=Num  label="Visit Number"
col CODY     type=Num  label="Study Day of Comment"
---
S1 | CO | AE | 001 | 1 | AESEQ | Comment on AE record | SPID-1 | WEEK 1 | 1 | 5
