#!RuleTest
#test CDISC-SEND-0326 expect=violation domain=PC
#note "PLAN-engine-fixture-join-key-drift: ported from cumba-corej SendPcProfileRulesProbeTest.send0326_firesWhenProfileRecordHasNoPceltm. Row 1 is a profile record with PCELTM, row 2 a profile record (PCTPTREF populated) with PCELTM empty, row 3 carries no PCTPTREF -> only row 2 fires."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=S1
dataset PC label="Pharmacokinetic Concentrations"
col USUBJID  type=Char
col PCTPTREF type=Char
col PCELTM   type=Char
---
S1 | DOSE | PT1H
S1 | DOSE |
S1 |      |
