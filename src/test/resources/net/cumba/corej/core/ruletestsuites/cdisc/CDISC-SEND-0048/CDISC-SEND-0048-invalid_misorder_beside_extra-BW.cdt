#!RuleTest
#test CDISC-SEND-0048 expect=violation domain=BW
#note "BWORRES is declared before BWTESTCD, contradicting the SENDIG order, and BWCUSTOM (not in the library list) sits between them. The unknown variable is ignored; the misorder among the known ones is still reported, once for the dataset."
#library standard=sendig version=3-1-1
#library column-order BW STUDYID DOMAIN USUBJID BWSEQ BWTESTCD BWORRES
#expectViolationCount 1
dataset BW label="Body Weight"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col BWSEQ    type=Num  label="Sequence Number"
col BWORRES  type=Char label="Result or Finding in Original Units"
col BWCUSTOM type=Char label="Sponsor Variable"
col BWTESTCD type=Char label="Body Weight Test Short Name"
---
S1 | BW | 001 | 1 | 250 | X | BW
---
