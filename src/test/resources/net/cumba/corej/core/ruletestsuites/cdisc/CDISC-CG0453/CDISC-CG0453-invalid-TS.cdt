#!RuleTest
#test CDISC-CG0453 expect=violation domain=TS
#note "PLAN-per-row-functions phase 0 (first scenario for CDISC-CG0453): row 2's TSVAL="Unknown Class" under TSPARMCD=PCLAS is not a MED-RT class name (MEDRT level) of the (dummy) medrt dictionary -> fires. Row 1 is valid (Cyclooxygenase Inhibitors); row 3 carries the same invalid value under AGEMAX (outside the rule's TSPARMCD condition); row 4's blank TSVAL is a completeness concern of another rule -> no fire. Executing pin written against the pre-port engine."
#library standard=sdtmig version=3-3
#dictionaries dummy
#expectViolationCount 1
#expectViolationAt row=2 TSSEQ=2 TSPARMCD=PCLAS TSVAL="Unknown Class"
dataset TS
col STUDYID  type=Char
col DOMAIN   type=Char
col TSSEQ    type=Num
col TSPARMCD type=Char
col TSVAL    type=Char
---
S01 | TS | 1 | PCLAS | Cyclooxygenase Inhibitors
S01 | TS | 2 | PCLAS | Unknown Class
S01 | TS | 3 | AGEMAX | Unknown Class
S01 | TS | 4 | PCLAS |
