#!RuleTest
#test CDISC-CG0041 expect=noViolation domain=AE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0041 (Condition: any seriousness criterion = 'Y'; Rule: AESER = 'Y'). Rows 1-2 carry a criterion = Y and AESER=Y; row 3 has no criterion = Y (Condition false). The criteria columns not present in the dataset (AESCAN, AESCONG, ...) do not satisfy the Condition -> silent."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESER   type=Char label="Serious Event"
col AESDTH  type=Char label="Results in Death"
col AESHOSP type=Char label="Requires or Prolongs Hospitalization"
col AESLIFE type=Char label="Is Life Threatening"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | MYOCARDIAL INFARCTION | Y | Y | Y | N
CDISCPILOT01 | AE | 01-701-1023 | 1 | ANAPHYLAXIS | Y | N | N | Y
CDISCPILOT01 | AE | 01-701-1028 | 1 | HEADACHE | N | N | N | N
