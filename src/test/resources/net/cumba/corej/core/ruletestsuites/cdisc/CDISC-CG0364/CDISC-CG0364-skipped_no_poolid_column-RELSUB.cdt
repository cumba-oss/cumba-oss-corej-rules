#!RuleTest
#test CDISC-CG0364 expect=skipped domain=RELSUB
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0364 (Condition: RSUBJID ^= null; Rule: RSUBJID ^= POOLID). The RELSUB dataset carries no POOLID column; Requirements.Variables.All [POOLID, RSUBJID] is unmet, so the rule skips."
#library standard=sdtmig version=3-4
dataset RELSUB class=RELATIONSHIP label="Related Subjects"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col RSUBJID type=Char label="Related Subject or Pool Identifier"
col SREL    type=Char label="Subject Relationship"
---
CDISCPILOT01 | 01-701-1015 | 01-701-1016 | MOTHER, BIOLOGICAL
---
