#!RuleTest
#test CDISC-AD0521 expect=violation domain=ADLBC
# Rule:Description: A variable which has a suffix of GRyN is present and a variable with the same root name and suffix of GRy is not present
#note "AETOXGR1N present, AETOXGR1 not present -> violation"
#expectViolationCount 1
#expectViolationAt nameOnly=AETOXGR1N
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AETOXGR1N type=Char
---
CDISCPILOT01 | 01-701-1015 | GLUC | 1
---
