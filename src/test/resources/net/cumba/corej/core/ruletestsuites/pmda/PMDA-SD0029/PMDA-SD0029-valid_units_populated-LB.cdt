#!RuleTest
#test PMDA-SD0029 expect=noViolation domain=LB
#note "dataset LB with both columns; rows: numeric STRESC + populated STRESU; text STRESC + empty STRESU; empty STRESC. All clean."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
col LBSTRESC type=Char
col LBSTRESU type=Char
---
S1 | LB | 001 | 1 | GLUC  | 7.2      | mmol/L
S1 | LB | 001 | 2 | HBSAG | NEGATIVE |
S1 | LB | 001 | 3 | CHOL  |          |
