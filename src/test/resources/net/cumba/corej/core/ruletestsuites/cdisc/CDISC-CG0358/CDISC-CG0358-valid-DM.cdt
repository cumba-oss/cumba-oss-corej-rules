#!RuleTest
#test CDISC-CG0358 expect=noViolation domain=DM
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0358 (Domain DM, Variable SBSTRAIN; Rule: SBSTRAIN not present in dataset). This DM dataset carries the usual human-clinical demographics columns and no SBSTRAIN column, so the presence check is satisfied."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col SEX     type=Char label="Sex"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015 | F
CDISCPILOT01 | DM | 01-701-1023 | 1023 | M
---
