#!RuleTest
#test PMDA-AD0169 expect=violation domain=ADLBC
#note "Row 1 CNSR=0 - the event indicator, conformant; row 2 CNSR=1 - a censoring indicator, conformant; row 3 CNSR=1.5 - NOT an integer, fires through the first disjunct; row 4 CNSR=-1 - an integer but NEGATIVE, fires through the second. Two of four rows fire, which pins RECORD granularity and covers both disjuncts in one file."
#library standard=adamig version=1-3
#expectViolationCount 2
#expectViolationAt row=3 CNSR=1.5
#expectViolationAt row=4 CNSR=-1
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col CNSR    type=Num
---
CDISCPILOT01 | 01-701-1015 | OS | 100 | 0
CDISCPILOT01 | 01-701-1023 | OS | 120 | 1
CDISCPILOT01 | 01-701-1034 | OS | 130 | 1.5
CDISCPILOT01 | 01-701-1040 | OS | 140 | -1
