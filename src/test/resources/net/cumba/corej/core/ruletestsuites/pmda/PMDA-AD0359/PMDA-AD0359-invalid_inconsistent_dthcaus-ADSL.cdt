#!RuleTest
#test PMDA-AD0359 expect=violation domain=ADSL
#note "Key is DTHCAUSN, target is DTHCAUS. Group DTHCAUSN=1 holds {MYOCARDIALINFARCTION x2, SEPSIS x1}: strict majority, so only the minority row 3 fires. Group 2 is a singleton."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 DTHCAUS=SEPSIS DTHCAUSN=1
dataset ADSL
col STUDYID  type=Char
col USUBJID  type=Char
col DTHCAUS  type=Char
col DTHCAUSN type=Num
---
CDISCPILOT01 | 01-701-1015 | MYOCARDIALINFARCTION | 1
CDISCPILOT01 | 01-701-1023 | MYOCARDIALINFARCTION | 1
CDISCPILOT01 | 01-701-1034 | SEPSIS                | 1
CDISCPILOT01 | 01-701-1047 | STROKE                | 2
