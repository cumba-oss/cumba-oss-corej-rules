#!RuleTest
#test CDISC-CG0177 expect=violation domain=IE
#note "Row 1: IEORRES='Y' but IESTRESC='N' -> the standardised result contradicts the original result and the rule fires. Row 2 agrees."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 IEORRES=Y IESTRESC=N
dataset IE class=FINDINGS label="Inclusion/Exclusion Criteria Not Met"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IESEQ    type=Num  label="Sequence Number"
col IETESTCD type=Char label="Inclusion/Exclusion Criterion Short Name"
col IECAT    type=Char label="Inclusion/Exclusion Category"
col IEORRES  type=Char label="I/E Criterion Original Result"
col IESTRESC type=Char label="I/E Criterion Result in Std Format"
---
S1 | IE | 001 | 1 | EXCL01 | EXCLUSION | Y | N
S1 | IE | 002 | 1 | EXCL02 | EXCLUSION | Y | Y
