#!RuleTest
#test CDISC-CG0517 expect=violation domain=DM
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0517 (Condition: ARMCD = null; Rule: ARMNRS ^= null). Row 1: ARMCD populated -> silent. Row 2: screen-failed subject with no planned arm, ARMCD empty and ARMNRS empty -> fires. Row 3: same shape but ARMNRS = SCREEN FAILURE -> silent."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=S1-002 ARMCD= ARMNRS=
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SUBJID   type=Char label="Subject Identifier for the Study"
col RFSTDTC  type=Char label="Subject Reference Start Date/Time"
col RFENDTC  type=Char label="Subject Reference End Date/Time"
col ARMCD    type=Char label="Planned Arm Code"
col ARM      type=Char label="Description of Planned Arm"
col ACTARMCD type=Char label="Actual Arm Code"
col ACTARM   type=Char label="Description of Actual Arm"
col ARMNRS   type=Char label="Reason Arm and/or Actual Arm is Null"
---
S1 | DM | S1-001 | 001 | 2024-01-10 | 2024-06-10 | PBO  | Placebo | PBO | Placebo |
S1 | DM | S1-002 | 002 |            |            |      |         |     |         |
S1 | DM | S1-003 | 003 |            |            |      |         |     |         | SCREEN FAILURE
