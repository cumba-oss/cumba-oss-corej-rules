#!RuleTest
#test PMDA-AD0033 expect=violation domain=ADLBC
#note "Melted (record x variable) check: only SAFRFL ends in RFL. Row 2's N is populated and not in [\"Y\"] -> one cell fires. Addressed by row + variable_name per the AD0019 precedent; variable_value is deliberately never pinned."
#library standard=adamig version=1-1
#expectViolationCount 1
#expectViolationAt row=2 variable_name=SAFRFL USUBJID=01-701-1023
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col SAFRFL  type=Char
---
CDISCPILOT01 | 01-701-1015 | ALB | Y
CDISCPILOT01 | 01-701-1023 | ALB | N
