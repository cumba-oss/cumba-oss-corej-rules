#!RuleTest
#test PMDA-SD1019 expect=noViolation domain=SV
#note "RE-CUT 2026-09-18 (PLAN-unplanned-visit-cascade): expect moved skipped -> noViolation. SVUPDES left Requirements.Variables.All, so a study that legitimately omits the Perm column no longer skips - the cascade runs and finds nothing: no SVPRESP, no SVUPDES, SCREENING carries no unscheduled/unplanned marker -> the visit is planned and a populated VISITDY is exactly right."
#library standard=sdtmig version=3-4
dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col VISITDY  type=Num  label="Planned Study Day of Visit"
---
CDISCPILOT01 | SV | 01-701-1015 | 1 | SCREENING | 1
