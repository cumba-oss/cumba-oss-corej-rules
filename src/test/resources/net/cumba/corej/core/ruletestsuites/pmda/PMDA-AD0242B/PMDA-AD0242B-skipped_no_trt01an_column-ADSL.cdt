#!RuleTest
#test PMDA-AD0242B expect=skipped domain=ADSL
#note "TRT01AN is not declared. The expansion is seeded from TRTxxA (xx=01) and TRTxxAN is synthesised as the absent TRT01AN; Requirements.Variables.All ['TRTxxAN'] rewrites to ['TRT01AN'], which is absent, so the rule is reported not executed with the Requirements.Variables reason."
#library standard=adamig version=1-3
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRT01A  type=Char
---
S1 | 001 | DRUGX
S1 | 002 | PLACEBO
