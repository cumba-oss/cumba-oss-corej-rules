#!RuleTest
#test CDISC-CG0532 expect=noViolation domain=DM
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0532 (Condition: Milestone associated with RFSTDTC is start of treatment and ARMNRS = null; Rule: RFSTDTC ^= null). Partially executable: whether the sponsor tied RFSTDTC to start of treatment is not in the data; the executable part tests ARMNRS null and RFSTDTC null. Rows 1 and 3: ARMNRS null and RFSTDTC populated. Row 2: ARMNRS=SCREEN FAILURE with RFSTDTC null -> silent."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SUBJID   type=Char label="Subject Identifier for the Study"
col RFSTDTC  type=Char label="Subject Reference Start Date/Time"
col ARMCD    type=Char label="Planned Arm Code"
col ARM      type=Char label="Description of Planned Arm"
col ACTARMCD type=Char label="Actual Arm Code"
col ACTARM   type=Char label="Description of Actual Arm"
col ARMNRS   type=Char label="Reason Arm and/or Actual Arm is Null"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015 | 2014-01-02 | PBO | Placebo | PBO | Placebo | 
CDISCPILOT01 | DM | 01-701-1023 | 1023 |  |  |  |  |  | SCREEN FAILURE
CDISCPILOT01 | DM | 01-701-1028 | 1028 | 2014-03-05 | XAN_LO | Xanomeline Low Dose | XAN_LO | Xanomeline Low Dose | 
