#!RuleTest
#test PMDA-AD0146B expect=violation domain=ADLBC
#note "Group PARAMN=1 holds PARAM {Albumin x2, Bilirubin x1} -> row 3 is the minority. Group PARAMN=2 is consistent."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 PARAM=Bilirubin PARAMN=1
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col PARAM   type=Char
col PARAMN  type=Num
---
S1 | 001 | ALB   | Albumin    | 1
S1 | 002 | ALB   | Albumin    | 1
S1 | 003 | ALB   | Bilirubin  | 1
S1 | 001 | CREAT | Creatinine | 2
S1 | 002 | CREAT | Creatinine | 2
