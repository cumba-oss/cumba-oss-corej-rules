#!RuleTest
#test CDISC-SEND-0295 expect=skipped domain=PP
#note "--ENINT is not declared, so Requirements.Variables.All [--STINT, --ENINT] gates the rule to SKIPPED naming the absent variable. Load-bearing on this half: its Check is a populated --STINT with empty(--ENINT), which on an absent --ENINT column would fire on every populated interval start."
#library standard=sendig version=3-1-1
dataset PP class=FINDINGS label="Pharmacokinetic Parameters"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col PPSEQ    type=Num
col PPTESTCD type=Char
col PPSTINT  type=Char
---
S1 | PP | 001 | 1 | AUCALL | P0H
