#!RuleTest
#test FDA-SD0011-A expect=violation domain=DM
#note "The half this R-5.25 split sibling owns (formerly FDA-SD0011's 'invalid_reverse' fixture): row 1 carries ARM='Screen Failure' while ARMCD='SCRN' is not 'SCRNFAIL' -> fires. Row 2 is the conformant pair; row 3 an ordinary arm."
#library standard=sdtmig version=3-2
#expectViolationCount 1
#expectViolationAt row=1 ARMCD=SCRN ARM="Screen Failure"
dataset DM
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
---
S1 | DM | 001 | SCRN     | Screen Failure
S1 | DM | 002 | SCRNFAIL | Screen Failure
S1 | DM | 003 | A        | Placebo
