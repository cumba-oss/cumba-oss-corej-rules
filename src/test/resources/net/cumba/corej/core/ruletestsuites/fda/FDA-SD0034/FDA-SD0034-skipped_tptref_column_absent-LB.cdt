#!RuleTest
#test FDA-SD0034 expect=skipped domain=LB
#note "LBTPTREF is not present in the dataset while LBELTM is populated. Requirements.Variables.All [--ELTM, --TPTREF] gates the rule out -> auditable skip instead of one finding per row under absent = all-missing (EC-43). Row 1 WOULD fire were the gate removed. Verdict 2-1': FDA-SD1246 reports the absence itself."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBELTM   type=Char label="Planned Elapsed Time from Time Point Ref"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | GLUC | PT1H
CDISCPILOT01 | LB | 01-701-1015 | 2 | GLUC |
