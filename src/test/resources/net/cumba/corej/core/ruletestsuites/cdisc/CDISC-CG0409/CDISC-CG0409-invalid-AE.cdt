#!RuleTest
#test CDISC-CG0409 expect=violation domain=AE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0409 (Rule: STUDYID = DM.STUDYID). Primary is AE, not DM: the rule scope is ALL and includes DM itself, where the foreign and primary readings agree (scope-ALL trap, plan §2.2). Row 2's STUDYID CDISCPILOT02 does not equal DM.STUDYID CDISCPILOT01 -> fires; row 1 matches. ALSO THE S3 DISCRIMINATOR (SKELETON-distinct-function hazard 3): STUDYID in distinct(STUDYID, domain=DM) belongs to the FOREIGN dataset DM; a port that read STUDYID from the primary AE would find CDISCPILOT02 in its own set and fall silent."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1023 STUDYID=CDISCPILOT02
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE
CDISCPILOT02 | AE | 01-701-1023 | 1 | NAUSEA
---

dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | DM | 01-701-1015
CDISCPILOT01 | DM | 01-701-1023
---
