#!RuleTest
#test CDISC-AD0102 expect=noViolation domain=ADAE
#note "PLAN-engine-fixture-join-key-drift: ported from cumba-corej CdiscAd0102To0707IntegrationTest.cdiscAd0102_columnExists_noFire. ADSL carries TRT01P and TRT02P, so both APERIOD values find their TRTxxP -> no violation."
#library standard=adamig version=1-3
dataset ADAE
col STUDYID type=Char
col USUBJID type=Char
col APERIOD type=Num
col AETERM  type=Char
---
STUDY1 | S1 | 1 | AE1
STUDY1 | S1 | 2 | AE1
---

dataset ADSL label="Subject-Level Analysis"
col STUDYID type=Char
col USUBJID type=Char
col TRT01P  type=Char
col TRT02P  type=Char
---
STUDY1 | S1 | Drug A | Drug B
---
