#!RuleTest
#test PMDA-AD0252-A expect=violation domain=ADAE
#note "Positive control on the first disjunct. Since the D-15 rewrite (2026-09-12) the Check is a varname() regex pair (^AVALCA([1-9]|[1-9][0-9])N$ / ^BASECA([1-9]|[1-9][0-9])N$) with no wildcards block, routed as Variable Metadata Check / Record and evaluated per variable: AVALCA1N matches the first regex -> exactly ONE finding for that one column, pinned by variable_name (no row= pin: Violation.row carries the colIndex)."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt variable_name=AVALCA1N
dataset ADAE structure=OCCDS
col STUDYID  type=Char
col USUBJID  type=Char
col AEDECOD  type=Char
col AVALCA1N type=Num
---
CDISCPILOT01 | 01-701-1015 | HEADACHE | 1
CDISCPILOT01 | 01-701-1023 | NAUSEA | 2
