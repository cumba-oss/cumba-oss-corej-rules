#!RuleTest
#test FDA-SD0031 expect=noViolation domain=AE
#note "r1 end+start DTC both populated; r2 AEENRTPT populated with AESTDTC populated (any start satisfies); r3 no end populated -> no violation."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col AESEQ    type=Num  label="Sequence Number"
col AETERM   type=Char label="Reported Term for the Adverse Event"
col AESTDTC  type=Char label="Start Date/Time of Adverse Event"
col AEENDTC  type=Char label="End Date/Time of Adverse Event"
col AEENRTPT type=Char label="End Relative to Reference Time Point"
---
S1 | AE | 001 | 1 | HEADACHE  | 2020-01-01 | 2020-01-05 |
S1 | AE | 001 | 2 | NAUSEA    | 2020-01-02 |            | ONGOING
S1 | AE | 001 | 3 | DIZZINESS |            |            |
