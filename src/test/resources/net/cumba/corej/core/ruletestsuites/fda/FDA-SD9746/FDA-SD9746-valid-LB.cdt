#!RuleTest
#test FDA-SD9746 expect=noViolation domain=LB
# Rule:Description: Raise an error when the Normal Range Upper Limit (--ORNRHI) is less than or equal to the Normal Range Lower Limit (--ORNRLO).
#note "LBORNRHI is greater than LBORNRLO on every record, so the rule does not fire"
#library standard=sdtmig version=3-4
dataset LB label="Laboratory Tests Results"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col LBSEQ type=Num label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBORNRLO type=Num label="Reference Range Lower Limit in Orig Unit"
col LBORNRHI type=Num label="Reference Range Upper Limit in Orig Unit"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB | 50 | 100
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALP | 35 | 115
---
