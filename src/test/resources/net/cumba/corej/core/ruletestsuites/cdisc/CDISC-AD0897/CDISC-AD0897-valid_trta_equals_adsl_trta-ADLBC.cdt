#!RuleTest
#test CDISC-AD0897 expect=noViolation domain=ADLBC
#note "PLAN-engine-fixture-join-key-drift: ported from cumba-corej CdiscAd0897IntegrationTest.trtaEqualsAdslTrta_noFire. TRTA equals ADSL.TRTA; ADSL.TRT01A carries a DIFFERENT value, so the TRT${*}A leg alone would fire -> the rule is silenced ONLY by the TRTA == ADSL.TRTA leg -> no violation."
# Declared-tier scope: structure= states the ADaM data structure this minimal table stands for;
# #define is its mandatory carrier (ScenarioDeclaredScopeProvider.install).
#define standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col TRTA type=Char
---
CDISCPILOT01 | 01-701-1015 | Xanomeline High Dose
---

dataset ADSL label="Subject-Level Analysis"
col STUDYID type=Char
col USUBJID type=Char
col TRTA type=Char
col TRT01A type=Char
---
CDISCPILOT01 | 01-701-1015 | Xanomeline High Dose | Placebo
---
