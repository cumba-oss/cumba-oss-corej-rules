#!RuleTest
#test PMDA-SD1333 expect=skipped domain=AE
#note "Neither AEENDTC nor AEDUR is in the dataset: since 2026-09-11 the rule gates on Requirements.Variables.Any [AEENDTC, AEDUR] (R-4.11b, verdict 2-1, T1-30), and with no member of the Any group present the run is an auditable SKIP naming the list instead of one finding per RECOVERED/RESOLVED row. The absence itself is reported ONCE by the minted sister PMDA-SD9724, whose violation_no_end_columns scenario carries this same dataset shape."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEOUT   type=Char label="Outcome of Adverse Event"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE | RECOVERED/RESOLVED
