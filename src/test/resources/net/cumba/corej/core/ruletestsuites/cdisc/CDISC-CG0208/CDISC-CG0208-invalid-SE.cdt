#!RuleTest
#test CDISC-CG0208 expect=violation domain=SE
# Rule:Description: Raise an error when Start Date/Time of Element (SESTDTC) is not populated.
#note "SESEQ=2 has an empty SESTDTC"
#expectViolationCount 1
#expectViolationAt row=2 SESEQ=2 USUBJID=01-701-1015
dataset SE label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ type=Num label="Sequence Number"
col SESTDTC type=Char label="Start Date/Time of Element"
---
CDISCPILOT01 | SE | 01-701-1015 | 1 | 2013-12-26
CDISCPILOT01 | SE | 01-701-1015 | 2 |
