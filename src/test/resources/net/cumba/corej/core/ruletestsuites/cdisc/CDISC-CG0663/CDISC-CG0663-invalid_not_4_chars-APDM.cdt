#!RuleTest
#test CDISC-CG0663 expect=violation domain=APDM
#note "DOMAIN=AP is only 2 characters, so the 4-character AP-- shape test fails before any codelist lookup -> fires once (Dataset sensitivity). W4 (PLAN-list-functions phase 0, scenarios-first on the pre-port engine)."
#library standard=sdtmig version=3-4
#library codelist-terms DOMAIN AE DM LB
#expectViolationCount 1
#expectViolationAt row=1 DOMAIN=AP
dataset APDM label="Associated Persons Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col APID    type=Char label="Associated Persons Identifier"
---
S1 | AP | AP001
