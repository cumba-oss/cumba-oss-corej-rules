#!RuleTest
#test FDA-SE2348 expect=noViolation domain=TX
#note "Every TXSEQ is unique within the whole TX dataset (STUDYID group), even across trial sets -> no violation."
#library standard=sendig version=3-1-1
dataset TX class="TRIAL DESIGN"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col SETCD    type=Char label="Set Code"
col TXSEQ    type=Num  label="Sequence Number"
col TXPARMCD type=Char label="Trial Set Parameter Short Name"
col TXVAL    type=Char label="Trial Set Parameter Value"
---
S1 | TX | SET1 | 1 | SPGRPCD | 1
S1 | TX | SET1 | 2 | GRPLBL  | Control
S1 | TX | SET2 | 3 | SPGRPCD | 2
