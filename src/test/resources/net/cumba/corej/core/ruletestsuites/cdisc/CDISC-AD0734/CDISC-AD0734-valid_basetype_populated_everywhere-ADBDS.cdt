#!RuleTest
#test CDISC-AD0734 expect=noViolation domain=ADBDS
#note "PLAN-engine-fixture-join-key-drift: ported from cumba-corej CdiscAd0734IntegrationTest.allPopulated_noViolation (PARAMCD added so the dataset is detected as BASIC DATA STRUCTURE and the rule runs). BASETYPE is populated on every record -> no violation."
#library standard=adamig version=1-1
dataset ADBDS
col USUBJID  type=Char
col PARAMCD  type=Char
col BASETYPE type=Char
---
S01 | PARAM1 | BASE1
S02 | PARAM1 | BASE2
