#!RuleTest
#test PMDA-AD0230B expect=violation domain=ADSL
#note "Sequence A-B carries both 1 and 2; 1 is the strict majority so row 3 alone fires."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 TRTSEQA=A-B TRTSEQAN=2
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRTSEQA type=Char
col TRTSEQAN type=Num
---
S1 | 001 | A-B | 1
S1 | 002 | A-B | 1
S1 | 003 | A-B | 2
S1 | 004 | B-A | 2
S1 | 005 | B-A | 2
