#!RuleTest
#test CDISC-CG0046 expect=noViolation domain=AE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0046 (Condition: --ENRTPT ^= null; Rule: --ENTPT ^= null). Rows 1-2: AEENRTPT populated and AEENTPT names the reference time point. Row 3: AEENRTPT null (Condition false) -> silent."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col AESEQ    type=Num  label="Sequence Number"
col AETERM   type=Char label="Reported Term for the Adverse Event"
col AEENRTPT type=Char label="End Relative to Reference Time Point"
col AEENTPT  type=Char label="End Reference Time Point"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE | ONGOING | END OF STUDY
CDISCPILOT01 | AE | 01-701-1023 | 1 | NAUSEA | BEFORE | END OF STUDY
CDISCPILOT01 | AE | 01-701-1028 | 1 | DIZZINESS | |
