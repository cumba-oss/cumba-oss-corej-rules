#!RuleTest
#test PMDA-AD0117B expect=noViolation domain=ADLBC
#note "The ATPT spellings disagree under the same ATPTN, but the PARAMCD half of the key separates them into two groups so neither fires. Pins the PARAMCD half, as PMDA-AD0110B-valid_different_avisitn pins the numeric half."
#library standard=adamig version=1-3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ATPT    type=Char
col ATPTN   type=Num
---
CDISCPILOT01 | 01-701-1015 | SYSBP | PREDOSE    | 1
CDISCPILOT01 | 01-701-1023 | DIABP | BEFOREDOSE | 1
