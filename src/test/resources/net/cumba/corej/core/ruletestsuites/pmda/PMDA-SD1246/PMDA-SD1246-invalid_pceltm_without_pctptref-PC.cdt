#!RuleTest
#test PMDA-SD1246 expect=violation domain=PC
#note "Shipped Check var_exists(\"--ELTM\") and not var_exists(\"--TPTREF\") resolves per the EC-36 prefix rule to PCELTM/PCTPTREF; both leaves are dataset constants -> BroadcastFold -> exactly ONE violation reported at row=1 regardless of row count. NOT a RELREC rule."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 nameOnly=PCELTM
dataset PC class=FINDINGS
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col PCSEQ   type=Num
col PCELTM  type=Char
---
S1 | PC | 001 | 1 | PT1H
