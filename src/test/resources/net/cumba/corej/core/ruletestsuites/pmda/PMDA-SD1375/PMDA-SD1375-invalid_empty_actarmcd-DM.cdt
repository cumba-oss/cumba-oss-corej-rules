#!RuleTest
#test PMDA-SD1375 expect=violation domain=DM
#note "The (or null) branch of the sheet text. Row 1: RFENDTC populated, ACTARMCD empty -> fires. Row 2: RFENDTC empty -> silent."
#expectViolationCount 1
#expectViolationAt row=1 nameOnly=RFENDTC
#library standard=sdtmig version=3-4
dataset DM label="Demographics"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col RFSTDTC  type=Char
col RFENDTC  type=Char
col ACTARMCD type=Char
---
