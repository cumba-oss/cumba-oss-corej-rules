#!RuleTest
#test CDISC-AD0205 expect=violation domain=ADSL
# Rule:Description: The value of ADSL.USUBJID is equal to the value of DM.USUBJID and ADSL.AGEU is not equal to DM.AGEU
#note "same USUBJID, ADSL.AGEU != DM.AGEU -> violation"
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col AGEU type=Char
---
CDISCPILOT01 | 01-701-1015 | MONTHS
---

dataset DM label=Demographics
col STUDYID type=Char
col DOMAIN type=Char
col USUBJID type=Char
col AGEU type=Char
---
CDISCPILOT01 | DM | 01-701-1015 | YEARS
---
