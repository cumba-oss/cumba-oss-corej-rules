#!RuleTest
#test CDISC-SEND-0401 expect=violation domain=BW
#note "Written FIRST in runbook W2b (PLAN-operation-replacements §8), on the pre-change engine: the EC-45 carry. The phase's only SJSTDTC is the partial date 2020-01, so there is no complete reference date and the derived day has no value; BWRPDY is populated (14), and a populated day whose inputs cannot support it is REPORTED, not skipped (EC-45: nothing skips). The composed form must keep this answer through min_date's no-result (a present but short candidate) and date_diff_days' missing hand-through. One SJ stage: the count-bearing fixture is not multiplied by the (USUBJID, RPHASE) join."
#library standard=sendig-dart version=1-2
#expectViolationCount 1
#expectViolationAt row=1 BWRPDY=14
dataset BW class=FINDINGS label="Body Weight"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col BWSEQ   type=Num  label="Sequence Number"
col RPHASE  type=Char label="Repro Phase"
col BWDTC   type=Char label="Date/Time of Collection"
col BWRPDY  type=Num  label="Repro Phase Day of Collection"
---
S1 | BW | 001 | 1 | P1 | 2020-01-15 | 14
---

dataset SJ class="SPECIAL PURPOSE" label="Subject Repro Stages"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SJSEQ   type=Num  label="Sequence Number"
col RPHASE  type=Char label="Repro Phase"
col RSTAGE  type=Char label="Repro Stage"
col SJSTDTC type=Char label="Start Date/Time of Repro Stage"
col SJENDTC type=Char label="End Date/Time of Repro Stage"
---
S1 | SJ | 001 | 1 | P1 | STAGE1 | 2020-01 | 2020-01-20
---
