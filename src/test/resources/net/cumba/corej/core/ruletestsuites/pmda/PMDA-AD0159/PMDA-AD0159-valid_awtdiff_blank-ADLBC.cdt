#!RuleTest
#test PMDA-AD0159 expect=noViolation domain=ADLBC
#note "ADY and ARELTM both ABSENT, i.e. the exact configuration that fires in invalid_no_ady_or_areltm_columns, EXCEPT that AWTDIFF is blank. The leading not empty(AWTDIFF) is false, so the rule executes and is silent. Together with the third violation fixture this isolates the leading guard as the only thing standing between 'silent' and 'fires on every row'."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADLBC
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVAL     type=Num
col AWTARGET type=Num
col AWTDIFF  type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | 30 | 7 |
CDISCPILOT01 | 01-701-1023 | ALB | 31 | 7 |
