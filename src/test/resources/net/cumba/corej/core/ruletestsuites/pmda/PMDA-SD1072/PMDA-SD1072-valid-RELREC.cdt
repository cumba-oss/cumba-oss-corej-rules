#!RuleTest
#test PMDA-SD1072 expect=noViolation domain=RELREC
#note "The RELREC arm of the scope: every populated non-DM RDOMAIN carries an IDVAR; the DM reference on row 2 is the documented exception and may leave IDVAR empty."
#library standard=sdtmig version=3-4
dataset RELREC label="Related Records"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col RELTYPE  type=Char label="Relationship Type"
col RELID    type=Char label="Relationship Identifier"
---
S1 | AE | 001 | AESEQ | 1 | ONE | 1
S1 | DM | 001 |       |   | ONE | 1
