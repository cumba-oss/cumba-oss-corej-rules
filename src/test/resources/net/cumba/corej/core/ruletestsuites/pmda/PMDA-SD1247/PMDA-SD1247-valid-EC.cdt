#!RuleTest
#test PMDA-SD1247 expect=noViolation domain=EC
#note "dose > 0 (row 1), ECOCCUR=N (row 2), ECSTAT='NOT DONE' (row 3; its missing ECDOSE is also silent under the H3 bare comparison), ECDOSTXT populated (row 4) each suppress -> no violation"
#library standard=sdtmig version=3-4
dataset EC class=INTERVENTIONS label="Exposure as Collected"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ECSEQ    type=Num  label="Sequence Number"
col ECTRT    type=Char label="Name of Treatment"
col ECOCCUR  type=Char label="Occurrence"
col ECDOSE   type=Num  label="Dose"
col ECDOSTXT type=Char label="Dose Description"
col ECSTAT   type=Char label="Completion Status"
---
S1 | EC | 001 | 1 | DRUG A | Y | 5 |            |
S1 | EC | 001 | 2 | DRUG A | N | 0 |            |
S1 | EC | 001 | 3 | DRUG A | Y | . |            | NOT DONE
S1 | EC | 001 | 4 | DRUG A | Y | . | 100 mg gel |
