#!RuleTest
#test CDISC-SEND-0378 expect=violation domain=TT
#note "Both columns present. Row 1 has TTENRL and TTDUR both empty -> FIRES; row 2 populates TTENRL and row 3 populates TTDUR, so each satisfies the sheet's 'Either TTENRL or TTDUR must be present for each Stage'."
#library standard=sendig-dart version=1-2
#expectViolationCount 1
#expectViolationAt row=1 RSTGCD=ST1
dataset TT class="TRIAL DESIGN" label="Trial Repro Stages"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col RSTGCD  type=Char label="Repro Stage Code"
col RSTAGE  type=Char label="Description of Repro Stage"
col TTENRL  type=Char label="Repro Stage End Rule"
col TTDUR   type=Char label="Duration of Repro Stage"
---
S1 | TT | ST1 | Premating  | | 
S1 | TT | ST2 | Gestation  | LAST DOSE | 
S1 | TT | ST3 | Lactation  | | P21D
---
