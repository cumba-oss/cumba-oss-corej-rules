#!RuleTest
#test CDISC-CG0094 expect=noViolation domain=LB
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0094 (Condition: --REASND ^= null; Rule: --STAT = 'NOT DONE'). Rows 2-3 carry a reason not done and LBSTAT=NOT DONE. Row 1 has a result and no reason (Condition false) -> silent."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBORRES  type=Char label="Result or Finding in Original Units"
col LBSTAT   type=Char label="Completion Status"
col LBREASND type=Char label="Reason Test Not Done"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB | 4.1 | |
CDISCPILOT01 | LB | 01-701-1015 | 2 | K | | NOT DONE | SAMPLE HEMOLYZED
CDISCPILOT01 | LB | 01-701-1023 | 1 | K | | NOT DONE | SAMPLE LOST
