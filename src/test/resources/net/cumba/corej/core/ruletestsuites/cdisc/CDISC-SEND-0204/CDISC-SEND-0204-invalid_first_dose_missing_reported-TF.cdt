#!RuleTest
#test CDISC-SEND-0204 expect=violation domain=TF
#note "PLAN-send-tfdetect-pathology-unpark: EC-45: a TFDETECT that cannot be derived because the first dose is unusable is REPORTED, not silent. Subject 001's only EX row has a blank EXSTDTC; subject 002 has no EX row at all; both carry TFDETECT 100 -> both REPORTED. Subject 003 (first dose 2020-01-01) carries the right 100 -> silent. Red-before: the rule was parked (Executability Not Executable), so the scenario failed with the rule not a member of the sendig 3.1.1 package."
#library standard=sendig version=3-1-1
#expectViolationCount 2
#expectViolationAt row=1 TFSPID=M1
#expectViolationAt row=2 TFSPID=M2
dataset TF class=FINDINGS label="Tumor Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col TFSEQ    type=Num  label="Sequence Number"
col TFSPID   type=Char label="Sponsor-Defined Identifier"
col TFTESTCD type=Char label="Tumor Findings Test Short Name"
col TFDETECT type=Num  label="Time in Days to Detection of Tumor"
---
S1 | TF | 001 | 1 | M1 | TUMEXAM | 100
S1 | TF | 002 | 2 | M2 | TUMEXAM | 100
S1 | TF | 003 | 3 | M3 | TUMEXAM | 100
---
dataset DS class=EVENTS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSTERM  type=Char label="Reported Term for the Disposition Event"
col DSDECOD type=Char label="Standardized Disposition Term"
col DSSTDTC type=Char label="Date/Time of Disposition"
---
S1 | DS | 001 | 1 | TERMINAL SACRIFICE | TERMINAL SACRIFICE | 2020-04-09
S1 | DS | 002 | 1 | TERMINAL SACRIFICE | TERMINAL SACRIFICE | 2020-04-09
S1 | DS | 003 | 1 | TERMINAL SACRIFICE | TERMINAL SACRIFICE | 2020-04-09
---
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
---
S1 | EX | 001 | 1 | DRUG A |
S1 | EX | 003 | 2 | DRUG A | 2020-01-01
---
dataset MA class=FINDINGS label="Macroscopic Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col MASEQ    type=Num  label="Sequence Number"
col MASPID   type=Char label="Sponsor-Defined Identifier"
col MATESTCD type=Char label="Macroscopic Examination Short Name"
col MAORRES  type=Char label="Result or Finding in Original Units"
---
S1 | MA | 001 | 1 | M1 | GROSPATH | MASS
S1 | MA | 002 | 2 | M2 | GROSPATH | MASS
S1 | MA | 003 | 3 | M3 | GROSPATH | MASS
---
