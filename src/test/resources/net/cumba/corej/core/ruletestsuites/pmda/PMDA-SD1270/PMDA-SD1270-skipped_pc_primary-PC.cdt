#!RuleTest
#test PMDA-SD1270 expect=skipped domain=PC
#note "A single PC dataset block, no PP block. Scope is [PP], so the domain axis rejects -> auditable skip. ADAPTED-FROM fda/FDA-SD1270/FDA-SD1270-valid_pc_only-PC.cdt (data verbatim), renamed to the skipped_ convention."
#library standard=sdtmig version=3-4
dataset PC class=FINDINGS label="Pharmacokinetic Concentrations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PCSEQ    type=Num  label="Sequence Number"
col PCTESTCD type=Char label="Pharmacokinetic Test Short Name"
---
CDISCPILOT01 | PC | 01-701-1015 | 1 | DRUGA
