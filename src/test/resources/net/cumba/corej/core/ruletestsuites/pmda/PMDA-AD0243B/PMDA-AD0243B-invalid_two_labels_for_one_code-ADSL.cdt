#!RuleTest
#test PMDA-AD0243B expect=violation domain=ADSL
#note "Mirror of AD0242B: target is the LABEL TRT01A, key is the CODE TRT01AN. Group TRT01AN=1 holds TRT01A {DRUGX x2, DRUGY x1}; row 3 is the lone minority. Group TRT01AN=3 holds one value and is silent. One expansion only (xx=01)."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 TRT01A=DRUGY TRT01AN=1
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRT01A  type=Char
col TRT01AN type=Num
---
S1 | 001 | DRUGX   | 1
S1 | 002 | DRUGX   | 1
S1 | 003 | DRUGY   | 1
S1 | 004 | PLACEBO | 3
