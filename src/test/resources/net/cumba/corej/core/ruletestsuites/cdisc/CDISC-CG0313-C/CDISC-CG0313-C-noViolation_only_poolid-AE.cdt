#!RuleTest
#test CDISC-CG0313-C expect=noViolation domain=AE
#note "R-5.25 wave-3 group K split of CG0313 (each missing key variable is its own defect), subject-identifier half: no USUBJID, but POOLID is present - ANY one of the two identifier columns silences the half, pinning that the within-branch and-group demands the absence of BOTH, not of either one."
#library standard=sdtmig version=3-2
#expectViolationCount 0
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col POOLID  type=Char label="Pool Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
---
S1 | AE | POOL1 | 1 | Body weight decreased
