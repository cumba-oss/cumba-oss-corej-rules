#!RuleTest
#test CDISC-SEND-0306-A expect=skipped domain=DM
#note "PLAN-join-key-one-side-absent-drop QK17 review (2026-10-11): a pooled study — POOLDEF defines pools and EX carries POOLID — belongs to CDISC-SEND-0306, where CDISC-SEND-0306-valid_pool_later_rfx_pool-DM.cdt is silent; CDISC-SEND-0306-A's None: [POOLDEF.POOLID] gate SKIPS it. Without the gate the own records alone would be judged and the subject whose reference comes from its pool reported. Derived from CDISC-SEND-0306-valid_pool_later_rfx_pool-DM.cdt."
#library standard=sendig version=3-1-1
dataset DM label=Demographics
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFXENDTC type=Char label="Date/Time of Last Study Treatment"
---
S1 | DM | 001 | 2020-01-10
---
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col POOLID  type=Char label="Pool Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
col EXENDTC type=Char label="End Date/Time of Treatment"
---
S1 | EX | 001 |  | 1 | DRUG A | 2020-01-01 | 2020-01-05
S1 | EX |  | P1 | 2 | DRUG A | 2020-01-01 | 2020-01-10
---
dataset POOLDEF label="Pool Definition"
col STUDYID type=Char label="Study Identifier"
col POOLID  type=Char label="Pool Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
---
S1 | P1 | 001
---
