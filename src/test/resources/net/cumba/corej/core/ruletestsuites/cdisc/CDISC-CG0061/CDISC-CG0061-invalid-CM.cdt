#!RuleTest
#test CDISC-CG0061 expect=violation domain=CM
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0061 (Condition: --STRTPT ^= null; Rule: --STTPT ^= null). Row 2: CMSTRTPT=BEFORE is populated but its reference time point CMSTTPT is null -> fires. Row 1 has both populated (BEFORE / INFORMED CONSENT); row 3 has CMSTRTPT null (Condition false). CMSTTPT is populated on row 1, so the dataset is not the all-empty folded case."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1023 CMSEQ=1 CMSTRTPT=BEFORE
dataset CM class=INTERVENTIONS label="Concomitant/Prior Medications"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col CMSEQ    type=Num  label="Sequence Number"
col CMTRT    type=Char label="Reported Name of Drug, Med, or Therapy"
col CMSTRTPT type=Char label="Start Relative to Reference Time Point"
col CMSTTPT  type=Char label="Start Reference Time Point"
---
CDISCPILOT01 | CM | 01-701-1015 | 1 | ASPIRIN | BEFORE | INFORMED CONSENT
CDISCPILOT01 | CM | 01-701-1023 | 1 | METFORMIN | BEFORE |
CDISCPILOT01 | CM | 01-701-1028 | 1 | PARACETAMOL | |
