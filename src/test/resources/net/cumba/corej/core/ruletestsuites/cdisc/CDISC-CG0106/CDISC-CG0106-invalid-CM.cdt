#!RuleTest
#test CDISC-CG0106 expect=violation domain=CM
# Rule:Description: Raise an error when Treatment Vehicle (--TRTV) is empty but Treatment Vehicle Amount (--VAMT) is populated.
#note "CMVAMT populated while CMTRTV is empty -> violation"
#expectViolationCount 1
#expectViolationAt row=1 CMSEQ=1 USUBJID=01-701-1015
dataset CM label="Concomitant Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ type=Num label="Sequence Number"
col CMTRTV type=Char label="Treatment Vehicle"
col CMVAMT type=Char label="Treatment Vehicle Amount"
---
CDISCPILOT01 | CM | 01-701-1015 | 1 |  | 100
CDISCPILOT01 | CM | 01-701-1015 | 2 |  |
---
