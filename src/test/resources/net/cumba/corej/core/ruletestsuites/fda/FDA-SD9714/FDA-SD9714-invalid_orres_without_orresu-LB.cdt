#!RuleTest
#test FDA-SD9714 expect=violation domain=LB
#note "LBORRES carries at least one non-empty value but the LBORRESU column is not present at all. var_is_null(--ORRES) is false (a value exists), and --ORRESU is absent -- so the units variable is required and missing. The sibling SD0026 cannot see this: it needs --ORRESU in Requirements.Variables.All and therefore SKIPs."
#expectViolationCount 1
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBORRES  type=Char label="Result or Finding in Original Units"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB | 40
