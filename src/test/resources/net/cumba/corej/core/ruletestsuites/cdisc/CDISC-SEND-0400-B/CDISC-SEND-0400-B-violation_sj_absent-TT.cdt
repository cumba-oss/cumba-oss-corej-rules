#!RuleTest
#test CDISC-SEND-0400-B expect=violation domain=TT
#note "R-5.25 wave-3 group K split of SEND400 (all three DART datasets absent is three defects, not one), SJ half: the study ships TT but no SJ (Subject Reproductive Stages) dataset; Study-level, reported once."
#library standard=sendig-dart version=1-2
#expectViolationCount 1
dataset TT class="TRIAL DESIGN" label="Trial Repro Stages"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col TTSEQ   type=Num  label="Sequence Number"
---
S1 | TT | 1
