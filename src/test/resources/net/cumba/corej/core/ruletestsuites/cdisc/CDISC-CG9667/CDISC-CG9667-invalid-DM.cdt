#!RuleTest
#test CDISC-CG9667 expect=violation domain=DM
#note "Authority: coreJ-minted rule (no SDTM and SDTMIG Conformance Rules v2.0 row; sheet issue #101): the dataset-presence counterpart, for TS (Trial Summary), of CG0368 (Rule: DM dataset present in study). The study inventory holds a DM dataset but no TS dataset -> the dataset-presence check fires once for the evaluated dataset."
#library standard=sdtmig version=3-4
#expectViolationCount 1
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015
---
