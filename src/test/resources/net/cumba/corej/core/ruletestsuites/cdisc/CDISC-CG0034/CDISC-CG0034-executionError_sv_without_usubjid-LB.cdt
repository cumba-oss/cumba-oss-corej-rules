#!RuleTest
#test CDISC-CG0034 expect=executionError domain=LB
#expect-execution-error "group= over 'SV' has no usable key"
#note "PLAN-join-key-one-side-absent-drop QK16 (b) / QK18 (owner 2026-10-11): SV without USUBJID - the domain= call's only group= member is on the evaluated side only, so no key member is left on both sides and the rule ERRORs (never an aggregate over the whole of SV). Derived from CDISC-CG0034-invalid-LB.cdt with SV.USUBJID removed. A gate declaring SV.USUBJID would turn this into a SKIP."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB | 1 | SCREENING
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALB | 3 | WEEK 2
---

dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | SV | 1 | SCREENING
CDISCPILOT01 | SV | 2 | BASELINE
CDISCPILOT01 | SV | 1 | SCREENING
CDISCPILOT01 | SV | 2 | BASELINE
---
