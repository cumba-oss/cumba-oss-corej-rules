#!RuleTest
#test FDA-SD1017-A expect=violation domain=SV
#note "The record half of the R-5.25 split (wave D, T1-39, sheet issue #208): SV carries no SVUPDES column, so the gated parent FDA-SD1017 skips this dataset -- and this sibling re-derives planned-ness from the VISIT name instead. Row 2 reads WEEK 99, which marks nothing, so it is treated as planned; its VISITNUM 99 is not declared in TV -> fires. Row 1 matches TV -> clean. Same operationalisation as FDA-SD1023 and CDISC-CG0031-A/CG0033-A."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=001 VISITNUM=99
dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col SVSTDTC  type=Char label="Start Date/Time of Visit"
---
CDISCPILOT01 | SV | 001 | 1  | SCREENING | 2020-01-01
CDISCPILOT01 | SV | 001 | 99 | WEEK 99   | 2020-01-15
---

dataset TV label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | TV | 1 | SCREENING
CDISCPILOT01 | TV | 2 | BASELINE
---
