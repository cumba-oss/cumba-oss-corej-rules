#!RuleTest
#test FDA-SD1018 expect=noViolation domain=SV
#note "THE POINT OF THE SPLIT (wave D, T1-40): identical to the violation fixture except row 2 reads UNSCHEDULED VISIT 1 -- conformant data the ungated parent reported before this wave, because with the SVUPDES column absent its empty(SVUPDES) leaf treated every visit as planned. The name heuristic reads the visit as unscheduled and stays silent although its triple matches no TV entry; EXTRA VISIT or AD HOC would still read as planned, which is why Executability stays Possible Overreporting."
#library standard=sdtmig version=3-4
#expectViolationCount 0
dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col VISITDY  type=Num  label="Planned Study Day of Visit"
---
CDISCPILOT01 | SV | 01-701-1015 | 1 | SCREENING           | -7
CDISCPILOT01 | SV | 01-701-1015 | 3 | UNSCHEDULED VISIT 1 | 15
---

dataset TV label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col VISITDY  type=Num  label="Planned Study Day of Visit"
---
CDISCPILOT01 | TV | 1 | SCREENING | -7
CDISCPILOT01 | TV | 2 | BASELINE  | 1
---
