#!RuleTest
#test CDISC-CG0428 expect=violation domain=AE
#note "Both columns present (the Requirements.Variables.All [--TOX, --TOXGR] gate is satisfied): row 1 has AETOX populated with AETOXGR empty -> fires. Row 2: both populated -> clean."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 AETOX=CTCAE
dataset AE class=EVENTS label="Adverse Events"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col AESEQ    type=Num  label="Sequence Number"
col AETERM   type=Char label="Reported Term for the Adverse Event"
col AETOX    type=Char label="Toxicity"
col AETOXGR  type=Char label="Standard Toxicity Grade"
---
S1 | AE | 001 | 1 | ANEMIA | CTCAE |
S1 | AE | 001 | 2 | FATIGUE | CTCAE | 2
