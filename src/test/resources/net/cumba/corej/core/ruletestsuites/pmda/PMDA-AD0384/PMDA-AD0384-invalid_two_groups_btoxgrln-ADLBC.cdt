#!RuleTest
#test PMDA-AD0384 expect=violation domain=ADLBC
#note "Two independent inconsistent groups: (GRADE1, GLUC) holds {1,1,2} flags row 3; (GRADE2, ALB) holds {5,5,6} flags row 6. Findings accumulate across groups at RECORD granularity."
#library standard=adamig version=1-3
#expectViolationCount 2
#expectViolationAt row=3 USUBJID=01-701-1034 PARAMCD=GLUC BTOXGRL=GRADE1 BTOXGRLN=2
#expectViolationAt row=6 USUBJID=01-701-1034 PARAMCD=ALB BTOXGRL=GRADE2 BTOXGRLN=6
dataset ADLBC
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col BTOXGRL  type=Char
col BTOXGRLN type=Num
