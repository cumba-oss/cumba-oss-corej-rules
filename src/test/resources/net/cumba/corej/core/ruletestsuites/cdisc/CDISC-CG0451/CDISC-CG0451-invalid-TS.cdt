#!RuleTest
#test CDISC-CG0451 expect=violation domain=TS
#note "PLAN-per-row-functions phase 0 (first scenario for CDISC-CG0451): row 2's TSVALCD=XXXXXXXXXX under TSPARMCD=TRT is not a UNII code (UNII level) of the (dummy) unii dictionary -> fires. Row 1 is valid (R16CO5Y76E); row 3 carries the same invalid value under AGEMAX (outside the rule's TSPARMCD condition); row 4's blank TSVALCD is a completeness concern of another rule -> no fire. Executing pin written against the pre-port engine."
#library standard=sdtmig version=3-3
#dictionaries dummy
#expectViolationCount 1
#expectViolationAt row=2 TSSEQ=2 TSPARMCD=TRT TSVALCD=XXXXXXXXXX
dataset TS
col STUDYID  type=Char
col DOMAIN   type=Char
col TSSEQ    type=Num
col TSPARMCD type=Char
col TSVALCD  type=Char
---
S01 | TS | 1 | TRT | R16CO5Y76E
S01 | TS | 2 | TRT | XXXXXXXXXX
S01 | TS | 3 | AGEMAX | XXXXXXXXXX
S01 | TS | 4 | TRT |
