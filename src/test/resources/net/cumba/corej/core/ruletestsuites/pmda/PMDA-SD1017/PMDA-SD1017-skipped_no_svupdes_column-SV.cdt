#!RuleTest
#test PMDA-SD1017 expect=skipped domain=SV
#note "GATED 2026-09-11 (wave D, T1-39): Requirements.Variables.All now carries SVUPDES, so a dataset with no SVUPDES column takes one auditable skip naming the column instead of flooding -- without the gate the bare empty(SVUPDES) leaf is TRUE on every row (absent = all-missing, EC-43), every visit counts as planned, and row 2 (VISITNUM 99, not in TV) would fire. The check is NOT lost on this shape: the R-5.25 split sibling PMDA-SD1017-A re-derives planned-ness from the VISIT name and reports row 2 (WEEK 99 is planned-looking) on this same data."
#library standard=sdtmig version=3-4
dataset SV class="SPECIAL PURPOSE" label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
S1 | SV | 001 | 1  | SCREENING
S1 | SV | 001 | 99 | WEEK 99
---

dataset TV class="TRIAL DESIGN" label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
S1 | TV | 1 | SCREENING
S1 | TV | 2 | WEEK 2
---
