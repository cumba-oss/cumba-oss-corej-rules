#!RuleTest
#test PMDA-SD1440 expect=noViolation domain=AE
#note "The cluster's AUTHORED-CONDITIONAL face. No AETERM column, AEDECOD present. Requirements.Variables.All [--DECOD] is satisfied, so the rule EXECUTES; the authored var_exists(\"--TERM\") lead conjunct is false -> noViolation."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AEDECOD type=Char label="Dictionary-Derived Term"
---
S1 | AE | 001 | 1 | Headache
