#!RuleTest
#test PMDA-AD0109B expect=noViolation domain=ADLBC
#note "The blank target row is excluded from both the distinct-value count and the flag pass (D.2), so the group holds one distinct value and nothing fires - the row cannot fire on its own either, because not empty(AVISITN) is false there. Pins finding AD0109B-F1 (the added conjunct is inert: the base rule PMDA-AD0109 reaches the same answer)."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVISIT  type=Char
col AVISITN type=Num
