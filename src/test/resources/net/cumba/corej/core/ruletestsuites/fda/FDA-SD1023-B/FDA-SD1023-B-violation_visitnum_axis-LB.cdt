#!RuleTest
#test FDA-SD1023-B expect=violation domain=LB
#note "⭐ THE AXIS PIN. VISIT is "BASELINE", which IS a TV visit name; VISITNUM is 99, which is NOT a TV visit number. ⛔ ADDED AT REVIEW 2026-09-22 because the sibling's only other firing fixture could not tell its own axis apart: there both VISIT and VISITNUM mismatched, so a rule mis-authored on the WRONG axis passed identically. Here the two axes disagree, so only the correct one fires. No SV dataset — this is the SV-absent arm, decided by the VISIT name (BASELINE marks nothing)."
#library standard=sdtmig version=3-2
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015 VISIT="BASELINE"
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB | 99 | BASELINE
---

dataset TV label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | TV | 1 | SCREENING
CDISCPILOT01 | TV | 2 | BASELINE
---
