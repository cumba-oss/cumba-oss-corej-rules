#!RuleTest
#test PMDA-SD1041 expect=noViolation domain=LB
#note "LBSCAT always names a genuine subdivision of LBCAT, never a repeat of it; the record without a subcategory is out of the condition -> no violation. Row 4 adds LBSCAT populated with LBCAT present-but-empty, which stays silent here under equal_to (that row belongs to SD1098's not_exists universe, not this rule's)."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBCAT    type=Char label="Category for Lab Test"
col LBSCAT   type=Char label="Subcategory for Lab Test"
---
S1 | LB | 001 | 1 | ALB  | CHEMISTRY | LIVER FUNCTION
S1 | LB | 001 | 2 | GLUC | CHEMISTRY | METABOLIC
S1 | LB | 001 | 3 | HGB  | HEMATOLOGY |
S1 | LB | 002 | 1 | GLUC |  | METABOLIC
