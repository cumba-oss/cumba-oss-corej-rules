#!RuleTest
#test PMDA-AD1024 expect=noViolation domain=ADSL
#note "DM is present alongside ADSL -> the second conjunct is false -> no violation."
#library standard=adamig version=1-3
dataset ADSL class=ADSL label="Subject Level Analysis Dataset"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col SAFFL   type=Char label="Safety Population Flag"
---
CDISCPILOT01 | 01-701-1015 | 701-1015 | Y
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | DM | 01-701-1015
---
