#!RuleTest
#test PMDA-AD0245 expect=violation domain=ADTTE
#note "CNSR is declared but STARTDT is not, so the time-to-event dataset lacks the required analysis start date. ADT is declared deliberately so the sibling rule PMDA-AD0246 (the ADT/ADTM half of the same sheet row) would NOT fire on this data - this fixture isolates AD0245's own condition. Exists-only Check -> dataset granularity -> exactly one violation at reported row 1. CNSR is the rule's single Output_Variable (row-1 value 0; numeric pins compare numerically); STARTDT is absent by construction and must not be pinned."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 nameOnly=CNSR
dataset ADTTE structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col ADT     type=Num
col CNSR    type=Num
---
CDISCPILOT01 | 01-701-1015 | TTDEATH | 120 | 22035 | 0
CDISCPILOT01 | 01-701-1023 | TTDEATH | 300 | 22215 | 1
