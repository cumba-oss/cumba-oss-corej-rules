#!RuleTest
#test PMDA-SD1037 expect=violation domain=LB
#note "LBTOXGR=3 (>0) but the LBTOX variable is not present in the dataset. Requirements.Variables.All [--TOXGR, --TOX] gates the rule out -> auditable skip instead of one finding per graded row under absent = all-missing (EC-43). Row 1 WOULD fire were the gate removed. Verdict 2-1 (T1-24): the absence is itself reportable, and the minted sister PMDA-SD9717 reports it ONCE for this dataset. Suite gap closed with the gate: this pair had no absent-column scenario before it."
#library standard=sdtmig version=3-4
#expectViolationCount 1
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBTOXGR  type=Char label="Toxicity Grade"
---
S1 | LB | 001 | 1 | ALT | 3
