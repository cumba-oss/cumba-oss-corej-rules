#!RuleTest
#test CDISC-AD0592 expect=violation domain=ADLBC
#note "PLAN-unqualified-joined-column-gate review-fix GF: the finding REPORTS the ADSL period start dates it compared against (Output_Variables template ADSL.APxxSDT, as the AD0593-AD0597 siblings) - a bare APxxSDT named no column of the BDS primary, so the report carried no ADSL value at all. APERIOD=2 names ADSL.AP02SDT; APERSDT 21915 differs -> fires."
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015 APERIOD=2 APERSDT=21915 ADSL.AP01SDT=21915 ADSL.AP02SDT=21950
#define standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col APERIOD type=Num
col APERSDT type=Num
---
CDISCPILOT01 | 01-701-1015 | 2 | 21915
---

dataset ADSL label="Subject-Level Analysis"
