#!RuleTest
#test CDISC-CG0248 expect=violation domain=TA
#note "D-TA-1b (twin of FDA-SD1267): TAETORD=1.5 is populated and not an integer -> fires. The blank TAETORD on row 3 is exempt under the new populated-value guard (blankness is a different rule's business), so exactly one violation."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 ARMCD=Pbo
dataset TA label="Trial Arms"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col ARMCD type=Char label="Planned Arm Code"
col ARM type=Char label="Description of Planned Arm"
col TAETORD type=Num label="Order of Element within Arm"
col ETCD type=Char label="Element Code"
---
CDISCPILOT01 | TA | Pbo | Placebo | 1.5 | SCRN
CDISCPILOT01 | TA | Pbo | Placebo | 2 | PBO
CDISCPILOT01 | TA | Pbo | Placebo |  | FU
