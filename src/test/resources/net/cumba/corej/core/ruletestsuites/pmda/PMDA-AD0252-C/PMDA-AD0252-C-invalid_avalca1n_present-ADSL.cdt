#!RuleTest
#test PMDA-AD0252-C expect=violation domain=ADSL
#note "Positive control for the ADSL half of the AD0252 split - same Check as PMDA-AD0252-A, different Scope.Data_Structures. Since the D-15 rewrite (2026-09-12) AVALCA1N matches the first varname() regex and the per-variable evaluation emits exactly ONE finding for that one column, pinned by variable_name (no row= pin: Violation.row carries the colIndex)."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt variable_name=AVALCA1N
dataset ADSL structure=ADSL
col STUDYID  type=Char
col USUBJID  type=Char
col AGE      type=Num
col SAFFL    type=Char
col AVALCA1N type=Num
---
CDISCPILOT01 | 01-701-1015 | 56 | Y | 1
CDISCPILOT01 | 01-701-1023 | 64 | Y | 2
