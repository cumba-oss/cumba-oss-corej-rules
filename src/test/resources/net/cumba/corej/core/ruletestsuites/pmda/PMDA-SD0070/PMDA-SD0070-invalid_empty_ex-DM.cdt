#!RuleTest
#test PMDA-SD0070 expect=violation domain=DM
#note "FRESH, DISCRIMINATING: the operation-dataset PRESENT-BUT-EMPTY near-miss (EX-entirely-absent is the standing harness carve-out and gets no fixture). Subject 001 treated -> $ex_record_count lookup-miss = 0 -> fires. Subject 002 SCRNFAIL exempt -> silent."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARMCD    type=Char label="Planned Arm Code"
col ARM      type=Char label="Description of Planned Arm"
col ACTARMCD type=Char label="Actual Arm Code"
col ACTARM   type=Char label="Description of Actual Arm"
---
S1 | DM | 001 | A        | Drug A         | A        | Drug A
S1 | DM | 002 | SCRNFAIL | Screen Failure | SCRNFAIL | Screen Failure
---

dataset EX label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Actual Treatment"
---
