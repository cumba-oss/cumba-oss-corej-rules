#!RuleTest
#test CDISC-CG0083 expect=violation domain=AE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0083 (Rule: --BDSYCD and --BODSYS have a one-to-one relationship). Body system code AEBDSYCD=10029205 is paired with NERVOUS SYSTEM DISORDERS on row 1 and PSYCHIATRIC DISORDERS on row 2, so the code does not map to one body system -> both records fire. Row 3 (10017947 / GASTROINTESTINAL DISORDERS) is consistently mapped and silent."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 AEBDSYCD=10029205 AEBODSYS="NERVOUS SYSTEM DISORDERS"
#expectViolationAt row=2 AEBDSYCD=10029205 AEBODSYS="PSYCHIATRIC DISORDERS"
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEBODSYS type=Char label="Body System or Organ Class"
col AEBDSYCD type=Num  label="Body System or Organ Class Code"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE | NERVOUS SYSTEM DISORDERS | 10029205
CDISCPILOT01 | AE | 01-701-1023 | 1 | INSOMNIA | PSYCHIATRIC DISORDERS | 10029205
CDISCPILOT01 | AE | 01-701-1028 | 1 | NAUSEA | GASTROINTESTINAL DISORDERS | 10017947
