#!RuleTest
#test PMDA-AD0367 expect=noViolation domain=ADSL
#note "Row 1: PLACEBO == PLACEBO -> silent. Row 2: ADSL ACTARM EMPTY while DM.ACTARM=PLACEBO -> the `not empty(ACTARM)` conjunct keeps it silent (same family divergence as AD0208-F1). Join 1:1, both matched."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col ACTARM  type=Char
---
S1 | 01-701-1015 | PLACEBO
S1 | 01-701-1023 |
---

dataset DM label=Demographics
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col ACTARM  type=Char
---
S1 | DM | 01-701-1015 | PLACEBO
S1 | DM | 01-701-1023 | PLACEBO
