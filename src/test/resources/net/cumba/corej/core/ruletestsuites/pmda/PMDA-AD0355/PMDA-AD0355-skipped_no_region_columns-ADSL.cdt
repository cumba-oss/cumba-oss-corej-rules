#!RuleTest
#test PMDA-AD0355 expect=skipped domain=ADSL
#note "Wildcard NoMatch contract: no column matches ^REGION(\\d+)$ or ^REGION(\\d+)N$, so expand() returns empty -> SKIPPED. expect=noViolation here would FAIL with 'the rule never executed'."
#library standard=adamig version=1-3
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col AGE     type=Num
col SEX     type=Char
---
CDISCPILOT01 | 01-701-1015 | 56 | M
CDISCPILOT01 | 01-701-1023 | 61 | F
