#!RuleTest
#test PMDA-SD9728 expect=skipped domain=CO
#note "The other half of the B3 pin: NEITHER trigger column is in the dataset (nor RDOMAIN), so Requirements.Variables.Any [IDVAR, IDVARVAL] skips naming both columns. The union Check would be identically false here anyway -- not empty folds false on an absent column (R-5.22) -- so the gate suppresses nothing reachable; it turns a structurally-cannot-fire execution into an auditable skip, which is what R-4.11 exists for."
#library standard=sdtmig version=3-4
dataset CO class="SPECIAL PURPOSE" label="Comments"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col COSEQ   type=Num  label="Sequence Number"
col COVAL   type=Char label="Comment"
---
S1 | 001 | 1 | General subject comment
