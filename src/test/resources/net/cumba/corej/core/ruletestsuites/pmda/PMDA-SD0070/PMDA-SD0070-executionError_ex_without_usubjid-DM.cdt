#!RuleTest
#test PMDA-SD0070 expect=executionError domain=DM
#expect-execution-error "group= over 'EX' has no usable key"
#note "PLAN-join-key-one-side-absent-drop QK16 (b) / QK18 (owner 2026-10-11): EX without USUBJID - the domain= call's only group= member is on the evaluated side only, so no key member is left on both sides and the rule ERRORs (never an aggregate over the whole of EX). Derived from PMDA-SD0070-invalid-DM.cdt with EX.USUBJID removed. A gate declaring EX.USUBJID would turn this into a SKIP."
#library standard=sdtmig version=3-4
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARMCD    type=Char label="Planned Arm Code"
col ARM      type=Char label="Description of Planned Arm"
col ACTARMCD type=Char label="Actual Arm Code"
col ACTARM   type=Char label="Description of Actual Arm"
---
S1 | DM | 001 | A        | Drug A         | A        | Drug A
S1 | DM | 002 | SCRNFAIL | Screen Failure | SCRNFAIL | Screen Failure
S1 | DM | 003 | NOTASSGN | Not Assigned   | NOTASSGN | Not Assigned
S1 | DM | 004 | A        | Drug A         | NOTTRT   | Not Treated
S1 | DM | 005 | A        | Drug A         | A        | Drug A
---

dataset EX label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Actual Treatment"
---
S1 | EX | 1 | DRUG A
---
