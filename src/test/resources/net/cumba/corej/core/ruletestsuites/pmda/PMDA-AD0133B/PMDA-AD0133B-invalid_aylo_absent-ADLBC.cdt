#!RuleTest
#test PMDA-AD0133B expect=violation domain=ADLBC
#note "A1LO not declared. The expansion is seeded by R2A1LO alone (y=1) and the partner name A1LO is SYNTHESISED as an absent column, so the bare empty(AyLO) leaf is TRUE there (absent = all-missing, EC-43) and row 1 fires. Isolates the second operand's absence case; Plan B phase 4d' deleted the not var_exists(AyLO) presence disjunct that used to carry it. A1LO not pinned -- it does not exist."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 AVAL=2.5 R2A1LO=1.25
dataset ADLBC structure=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVAL     type=Num
col R2A1LO   type=Num
---
CDISCPILOT01 | 01-701-1015 | ALT | 2.5 | 1.25
CDISCPILOT01 | 01-701-1023 | ALT | 2.5 |
