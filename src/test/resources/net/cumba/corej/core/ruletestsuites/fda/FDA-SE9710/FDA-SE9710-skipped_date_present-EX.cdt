#!RuleTest
#test FDA-SE9710 expect=skipped domain=EX
#note "The discriminator: EXENDTC is PRESENT (blank on row 2) -> the companion SKIPS on None [--ENDTC]; the imputation parent FDA-SD1093 runs and reports the record whose date is incomplete."
#library standard=sendig version=3-1-1
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col EXSEQ    type=Num  label="Sequence Number"
col EXTRT type=Char label="Name of Treatment"
col EXENDY type=Num label="Study Day of End of Observation"
col EXENDTC type=Char label="End Date/Time of Observation"
---
S1 | EX | 001 | 1 | DRUG A | 5 | 2020-01-05
S1 | EX | 002 | 2 | DRUG A | 6 | 
S1 | EX | 003 | 3 | DRUG A |  | 2020-01-07
