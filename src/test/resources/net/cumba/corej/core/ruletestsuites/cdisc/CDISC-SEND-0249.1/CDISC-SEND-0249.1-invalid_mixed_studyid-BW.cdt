#!RuleTest
#test CDISC-SEND-0249.1 expect=violation domain=BW
#note "3 rows, DOMAIN=BW on all, STUDYID = STUDYA, STUDYA, STUDYB (strict 2-vs-1 majority, no tie). One DOMAIN-keyed group; the minority row 3 is flagged; Sensitivity=Dataset takes the first firing row = row 3."
#expectViolationCount 1
#expectViolationAt row=3 STUDYID=STUDYB DOMAIN=BW
dataset BW label="Body Weight"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col BWSEQ   type=Num  label="Sequence Number"
---
STUDYA | BW | 001 | 1
STUDYA | BW | 002 | 2
STUDYB | BW | 003 | 3
---
