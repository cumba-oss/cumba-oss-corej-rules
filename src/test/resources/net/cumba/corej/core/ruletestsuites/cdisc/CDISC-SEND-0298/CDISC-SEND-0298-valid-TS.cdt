#!RuleTest
#test CDISC-SEND-0298 expect=noViolation domain=TS
#note "Every TS variable is defined for the domain in the SENDIG -> no violation. W4 (PLAN-list-functions phase 0, scenarios-first on the pre-port engine)."
#library standard=sendig version=3-1-1
#library column-order TS STUDYID DOMAIN TSSEQ TSPARMCD TSPARM TSVAL
dataset TS
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL    type=Char label="Parameter Value"
---
S1 | TS | 1 | SSTYP | TOX
