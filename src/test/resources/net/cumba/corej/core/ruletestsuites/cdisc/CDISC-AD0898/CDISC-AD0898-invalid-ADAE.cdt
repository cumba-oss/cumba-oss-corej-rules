#!RuleTest
#test CDISC-AD0898 expect=violation domain=ADAE
#note "ADAE.AESEQ=2 has no matching SDTM AE record, so after the left join AE.AESEQ is empty and the rule fires. The expansion binds &DOM& to AE, the prefix of AESEQ, producing exactly the shape PMDA-AD0258 authors by hand for a pinned AE."
#library standard=adamig version=1-2
#library standard-domains AE CM MH DM LB VS
#expectViolationCount 1
#expectViolationAt row=2 AESEQ=2
dataset ADAE
col STUDYID type=Char
col USUBJID type=Char
col AESEQ   type=Char
col AETERM  type=Char
---
CDISCPILOT01 | 01-701-1015 | 1 | HEADACHE
CDISCPILOT01 | 01-701-1015 | 2 | NAUSEA
---

dataset AE label="Adverse Events"
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col AESEQ   type=Char
---
CDISCPILOT01 | AE | 01-701-1015 | 1
---
