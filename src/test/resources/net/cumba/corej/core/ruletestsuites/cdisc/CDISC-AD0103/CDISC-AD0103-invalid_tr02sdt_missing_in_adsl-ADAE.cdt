#!RuleTest
#test CDISC-AD0103 expect=violation domain=ADAE
#note "PLAN-engine-fixture-join-key-drift: ported from cumba-corej CdiscAd0102To0707IntegrationTest.cdiscAd0103_period2_columnMissing_fires. APERIOD=2 and ADSL has no TR02SDT -> fires."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=S1
dataset ADAE
col STUDYID type=Char
col USUBJID type=Char
col APERIOD type=Num
col AETERM  type=Char
---
STUDY1 | S1 | 2 | AE1
---

dataset ADSL label="Subject-Level Analysis"
col STUDYID type=Char
col USUBJID type=Char
---
STUDY1 | S1
---
