#!RuleTest
#test CDISC-SEND-0330 expect=violation domain=PC
#note "Written in runbook W2a (PLAN-operation-replacements phase 0) BEFORE the change, as the red-before of D-W2-6: SUPPPC carries a QNAM=PCCALCN row for the BLQ record whose QVAL is BLANK. The retired supp_qnam_present answered 'present' for it (a row exists) and the rule was silent; under the declared SUPP merge (Supp_Merge, default true) PCCALCN is read per PC record through the SUPP pivot and its value is empty, and the sheet's 'the PCCALCN should be provided ... value in QVAL' is not met -> fires. Row 2 (numeric result) is out of scope."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset PC class=FINDINGS label="Pharmacokinetics Concentrations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PCSEQ    type=Num  label="Sequence Number"
col PCTESTCD type=Char label="Test Short Name"
col PCSTRESC type=Char label="Result or Finding in Standard Format"
---
S1 | PC | 001 | 1 | DRUGX | BLQ
S1 | PC | 001 | 2 | DRUGX | 4.1
---

dataset SUPPPC label="Supplemental Qualifiers for PC"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM     type=Char label="Qualifier Variable Name"
col QLABEL   type=Char label="Qualifier Variable Label"
col QVAL     type=Char label="Data Value"
---
S1 | PC | 001 | PCSEQ | 1 | PCCALCN | Numeric Interpretation for Calculations |
---
