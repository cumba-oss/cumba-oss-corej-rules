#!RuleTest
#test FDA-SD9724 expect=skipped domain=AE
#note "Neither AEOUT nor an end column is in the dataset: Requirements.Variables.All [AEOUT] is unsatisfied, so the sister skips naming AEOUT. Without the trigger column the sister cannot tell whether any event is resolved; AEOUT is Permissible in AE, and its own absence is a separate question this rule does not answer."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE
