#!RuleTest
#test FDA-SD0090 expect=noViolation domain=AE
#note "The fatal event carries AESDTH='Y'; non-fatal outcomes are outside the condition -> no violation."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEOUT   type=Char label="Outcome of Adverse Event"
col AESDTH  type=Char label="Results in Death"
---
S1 | AE | 001 | 1 | CARDIAC ARREST | FATAL     | Y
S1 | AE | 002 | 1 | HEADACHE       | RECOVERED | N
S1 | AE | 003 | 1 | NAUSEA         | RECOVERED |
