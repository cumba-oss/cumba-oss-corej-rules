#!RuleTest
#test PMDA-SD9750 expect=skipped domain=MH
#note "MHBDSYCD column present: Requirements.Variables.None [--BDSYCD] skips the sister; a missing code on a record is PMDA-SD1461's finding."
#library standard=sdtmig version=3-4
dataset MH
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col MHSEQ    type=Num
col MHBODSYS type=Char
col MHBDSYCD type=Char
---
S1 | MH | 001 | 1 | INFECTIONS |
---
