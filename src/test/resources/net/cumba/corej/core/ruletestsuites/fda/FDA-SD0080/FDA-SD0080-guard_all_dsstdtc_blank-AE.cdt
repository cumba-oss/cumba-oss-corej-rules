#!RuleTest
#test FDA-SD0080 expect=noViolation domain=AE
#note "H2 guard scenario (WORKORDER-H2-guard-coverage / REVIEW1B-date-order-flip.tsv): subject 001 HAS DS records but every DSSTDTC cell is blank, so max_date over the group yields EmptyResult.MISSING and the not empty($max) guard silences the rule despite a populated AESTDTC. If this FIRES, the order-flip guard was deleted: post-6c totality makes date(AESTDTC) > MISSING true on every dated AE row."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESTDTC type=Char label="Start Date/Time of Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE | 2023-07-01
---

dataset DS class=EVENTS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSDECOD type=Char label="Standardized Disposition Term"
col DSSTDTC type=Char label="Start Date/Time of Disposition Event"
---
S1 | DS | 001 | 1 | RANDOMIZED |
S1 | DS | 001 | 2 | COMPLETED  |
