#!RuleTest
#test FDA-SD2009 expect=noViolation domain=AE
#note "Every populated AELLTCD is a Lowest Level Term code of the (dummy) MedDRA dictionary; the missing AELLTCD on row 3 does not fire. AELLTCD is Num per SDTMIG 3.4."
#library standard=sdtmig version=3-4
#dictionaries dummy
dataset AE
col USUBJID type=Char
col AEDECOD type=Char
col AELLTCD type=Num
---
001 | Headache | 10019211
001 | Nausea   | 10028813
002 | Headache | .
