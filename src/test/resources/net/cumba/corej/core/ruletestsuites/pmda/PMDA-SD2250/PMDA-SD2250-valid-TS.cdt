#!RuleTest
#test PMDA-SD2250 expect=noViolation domain=TS
#note "All CURTRT rows carry a valid SRS preferred term of the dummy UNII dictionary (ASPIRIN, IBUPROFEN); the empty TSVAL on row 3 does not fire (completeness is another rule's concern) and the non-SRS value on the AGEMAX row is outside the CURTRT condition."
#library standard=sdtmig version=3-4
#dictionaries dummy
dataset TS
col STUDYID  type=Char
col DOMAIN   type=Char
col TSSEQ    type=Num
col TSPARMCD type=Char
col TSVAL    type=Char
---
S01 | TS | 1 | CURTRT | ASPIRIN
S01 | TS | 2 | CURTRT | IBUPROFEN
S01 | TS | 3 | CURTRT |
S01 | TS | 4 | AGEMAX | P70Y
