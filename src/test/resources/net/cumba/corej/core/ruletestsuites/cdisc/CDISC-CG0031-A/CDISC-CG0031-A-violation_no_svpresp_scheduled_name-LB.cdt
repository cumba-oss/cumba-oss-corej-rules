#!RuleTest
#test CDISC-CG0031-A expect=violation domain=LB
#note "SDTMIG 3.2 has no SVPRESP in SV at all, so this dataset is the SVPRESP-unavailable arm and belongs to this rule. ⚠ MOVED FROM CDISC-CG0031 2026-09-08 (R-5.25 split, sheet issue #176): it used to pin the parent's fallback, whose note read that when SVPRESP is not present all non-missing VISIT values are checked against TV.VISIT. That fallback was the maximum-overreporting assumption and is gone; planned-ness is now read from the VISIT name, the operationalisation FDA/PMDA-SD1023 already carry. The verdict is unchanged on this data: row 1 BASELINE is in TV -> clean; row 2 WEEK 99 marks nothing so it is treated as scheduled and is not in TV -> fires; row 3 VISIT empty -> clean. One violation out of three rows, not three."
#library standard=sdtmig version=3-2
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1015 VISIT="WEEK 99"
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB | 2  | BASELINE
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALB | 99 | WEEK 99
CDISCPILOT01 | LB | 01-701-1015 | 3 | ALB | 3  |
---

dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | SV | 01-701-1015 | 2  | BASELINE
CDISCPILOT01 | SV | 01-701-1015 | 99 | WEEK 99
---

dataset TV label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | TV | 1 | SCREENING
CDISCPILOT01 | TV | 2 | BASELINE
---
