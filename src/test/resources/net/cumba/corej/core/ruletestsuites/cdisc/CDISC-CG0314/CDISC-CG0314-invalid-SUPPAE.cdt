#!RuleTest
#test CDISC-CG0314 expect=violation domain=SUPPAE
#note "QNAM=AETERM equals a variable name of the parent domain AE's SDTM Model column order (get_parent_model_column_order resolves the parent through RDOMAIN=AE) -> fires; QNAM=AEXTRA is no model variable -> silent. W4 (PLAN-list-functions phase 0, scenarios-first on the pre-port engine)."
#library standard=sdtmig version=3-4
#library model-column-order AE STUDYID DOMAIN USUBJID AESEQ AETERM AEDECOD
#expectViolationCount 1
#expectViolationAt row=1 QNAM=AETERM
dataset SUPPAE class=RELATIONSHIP label="Supplemental Qualifiers for AE"
col STUDYID type=Char label="Study Identifier"
col RDOMAIN type=Char label="Related Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col IDVAR   type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM    type=Char label="Qualifier Variable Name"
col QLABEL  type=Char label="Qualifier Variable Label"
col QVAL    type=Char label="Data Value"
---
S1 | AE | 001 | AESEQ | 1 | AETERM | Reported term | X
S1 | AE | 001 | AESEQ | 1 | AEXTRA | Extra | Y
---

dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE
---
