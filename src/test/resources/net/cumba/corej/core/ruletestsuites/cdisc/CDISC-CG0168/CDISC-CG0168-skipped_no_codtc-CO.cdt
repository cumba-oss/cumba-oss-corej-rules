#!RuleTest
#test CDISC-CG0168 expect=skipped domain=CO
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0168 (Condition: IDVAR ^= null; Rule: CODTC = null). The CODTC column is absent; Requirements.Variables.All [CODTC, IDVAR] gates the rule to SKIPPED (a dataset without CODTC cannot carry a populated CODTC)."
#library standard=sdtmig version=3-4
dataset CO class="SPECIAL PURPOSE" label="Comments"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col COSEQ    type=Num  label="Sequence Number"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col COVAL    type=Char label="Comment"
---
CDISCPILOT01 | CO | AE | 01-701-1015 | 1 | AESEQ | 1 | Subject reported headache resolved overnight
---
