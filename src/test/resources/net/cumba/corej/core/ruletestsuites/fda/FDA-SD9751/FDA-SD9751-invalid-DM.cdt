#!RuleTest
#test FDA-SD9751 expect=violation domain=DM
#note "Rule round 2026-10-12 (owner, JKAG-A: mint it): the study holds DM and IE but no Trial Inclusion/Exclusion Criteria (TI) dataset -> the presence rule fires. Since the join-key gate FDA-SD1016 skips when TI is absent, this is the FDA family's only signal of a missing TI (as FDA-SD1112 is for TA)."
#library standard=sdtmig version=3-4
#expectViolationCount 1
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SEX     type=Char label="Sex"
---
S1 | DM | 001 | M
---

dataset IE class=FINDINGS label="Inclusion/Exclusion Criteria Not Met"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IESEQ    type=Num  label="Sequence Number"
col IETESTCD type=Char label="Inclusion/Exclusion Criterion Short Name"
---
S1 | IE | 001 | 1 | IN01
---
