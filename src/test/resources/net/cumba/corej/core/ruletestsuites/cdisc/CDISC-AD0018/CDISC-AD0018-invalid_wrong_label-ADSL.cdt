#!RuleTest
#test CDISC-AD0018 expect=violation domain=ADSL
#note "PLAN-library-template-label-resolution R2-2: the matcher still demands the published label exactly, letter case included - only 'Imput.' and 'Imputation' are one word (D7). TRTSDTF's 'Date of First Exposure Flag' drops the imputation word -> one violation; STUDYID is the conforming control."
#library standard=adamig version=1-0
#library variable-metadata ADSL STUDYID name=STUDYID label="Study Identifier"
#library variable-metadata ADSL TRTSDTF name=TRTSDTF label="Date of First Exposure Imput. Flag"
#expectViolationCount 1
#expectViolationAt variable_name=TRTSDTF variable_label="Date of First Exposure Flag" library_variable_label="Date of First Exposure Imput. Flag"
dataset ADSL structure=ADSL
col STUDYID type=Char label="Study Identifier"
col TRTSDTF type=Char label="Date of First Exposure Flag"
---
CDISCPILOT01 | D
---
