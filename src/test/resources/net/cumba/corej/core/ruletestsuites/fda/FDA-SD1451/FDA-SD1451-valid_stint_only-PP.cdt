#!RuleTest
#test FDA-SD1451 expect=noViolation domain=PP
#note "Boundary: PPSTINT present but PPENINT absent -> the guard leaf (--ENINT exists) is false -> no violation (that direction is FDA-SD1450's job)."
#library standard=sdtmig version=3-4
dataset PP class=FINDINGS label="Pharmacokinetic Parameters"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PPSEQ    type=Num  label="Sequence Number"
col PPTESTCD type=Char label="Parameter Short Name"
col PPSTINT  type=Char label="Planned Start of Assessment Interval"
---
CDISCPILOT01 | PP | 01-701-1015 | 1 | AUCALL | PT0H
---
