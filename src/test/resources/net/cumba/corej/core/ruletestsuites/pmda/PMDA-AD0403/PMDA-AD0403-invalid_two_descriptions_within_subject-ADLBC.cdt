#!RuleTest
#test PMDA-AD0403 expect=violation domain=ADLBC
#note "PARAMCD + AVAL detect BASIC DATA STRUCTURE. No wildcards. Target is ATOXDSCL, key is the pair [USUBJID, PARAMCD]. Group (001, GLUC) holds ATOXDSCL {GRADE1 x2, GRADE2 x1} -> row 3 is the lone minority. Row 4 belongs to a different subject and forms its own single-valued group. AVISITN is filler making the repeated-visit shape realistic; it matches no pattern and is not pinned."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=001 PARAMCD=GLUC ATOXDSCL=GRADE2
dataset ADLBC
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVISITN  type=Num
col AVAL     type=Num
col ATOXDSCL type=Char
---
S1 | 001 | GLUC | 1 | 5.0 | GRADE1
S1 | 001 | GLUC | 2 | 5.1 | GRADE1
S1 | 001 | GLUC | 3 | 5.2 | GRADE2
S1 | 002 | GLUC | 1 | 4.9 | GRADE3
