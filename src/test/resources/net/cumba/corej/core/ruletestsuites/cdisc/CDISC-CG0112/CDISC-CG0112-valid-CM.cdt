#!RuleTest
#test CDISC-CG0112 expect=noViolation domain=CM
# Rule:Description: Raise an error when Dose Description (--DOSTXT) value is numeric.
#note "CMDOSTXT holds non-numeric text (10-20, AS NEEDED) -> does not match the numeric regex, no violation"
dataset CM label="Concomitant Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ type=Num label="Sequence Number"
col CMDOSTXT type=Char label="Dose Description"
---
CDISCPILOT01 | CM | 01-701-1015 | 1 | 10-20
CDISCPILOT01 | CM | 01-701-1015 | 2 | AS NEEDED
---
