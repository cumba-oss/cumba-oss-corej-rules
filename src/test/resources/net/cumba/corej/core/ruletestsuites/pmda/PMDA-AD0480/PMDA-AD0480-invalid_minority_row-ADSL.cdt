#!RuleTest
#test PMDA-AD0480 expect=violation domain=ADSL
#note "`w` compiles to (\\d) - a single digit. Exactly one index (1) is present, so exactly one expansion runs, rewriting Requirements.Variables.All, Check and Output_Variables to STRAT1V/STRAT1VN."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=003 STRAT1V=LOW STRAT1VN=1
dataset ADSL
col STUDYID   type=Char
col USUBJID   type=Char
col STRAT1V   type=Char
col STRAT1VN  type=Num
---
S1 | 001 | HIGH | 1
S1 | 002 | HIGH | 1
S1 | 003 | LOW  | 1
---
