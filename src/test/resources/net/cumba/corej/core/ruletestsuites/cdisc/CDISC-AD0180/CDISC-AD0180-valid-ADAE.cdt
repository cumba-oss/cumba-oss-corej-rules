#!RuleTest
#test CDISC-AD0180 expect=noViolation domain=ADAE
#note "Non-firing counterpart: every populated SRCDOM (DM, LB) is in the declared companion SDTM domain set, and the empty SRCDOM row is held quiet by the non_empty guard. If the membership test were inverted (firing on SRCDOM in $sdtm_domains) rows 1-2 would fire and this scenario would red."
#library standard=adamig version=1-0
#library standard-domains AE DM LB VS
dataset ADAE structure=BDS label="Adverse Events Analysis Dataset"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col PARAMCD type=Char label="Parameter Code"
col SRCDOM  type=Char label="Source Data"
---
S1 | 001 | AEP | DM
S1 | 002 | AEP | LB
S1 | 003 | AEP |
