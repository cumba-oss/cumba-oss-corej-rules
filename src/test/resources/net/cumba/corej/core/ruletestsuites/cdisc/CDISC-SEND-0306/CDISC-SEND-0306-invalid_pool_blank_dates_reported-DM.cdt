#!RuleTest
#test CDISC-SEND-0306 expect=violation domain=DM
#note "PLAN-scalar-date-extremes: Pool-only; the pool's only EX row has BLANK EXSTDTC and EXENDTC; RFXENDTC 2020-01-10 populated -> 1 finding (EC-45 / S12: the subject is dosed — the pool has an EX row — and neither reference can be derived). Red-before: silent through the guard."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset DM label=Demographics
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFXENDTC type=Char label="Date/Time of Last Study Treatment"
---
S1 | DM | 001 | 2020-01-10
---
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col POOLID  type=Char label="Pool Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
col EXENDTC type=Char label="End Date/Time of Treatment"
---
S1 | EX |  | P1 | 1 | DRUG A |  |
---
dataset POOLDEF label="Pool Definition"
col STUDYID type=Char label="Study Identifier"
col POOLID  type=Char label="Pool Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
---
S1 | P1 | 001
---
