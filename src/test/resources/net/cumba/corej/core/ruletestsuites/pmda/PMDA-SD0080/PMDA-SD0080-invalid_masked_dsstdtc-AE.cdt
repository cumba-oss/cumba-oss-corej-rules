#!RuleTest
#test PMDA-SD0080 expect=violation domain=AE
#note "ADAPTED-FROM fda/FDA-SD0080/FDA-SD0080-invalid_masked_dsstdtc-AE.cdt (data verbatim). Subject 001's DS carries 2023-05-01 and masked 2023-06-- whose hull reaches past every determined candidate's upper, so EC-46 yields NO maximum and subject 001 is silenced despite AESTDTC 2023-07-01. Subject 002 is the control: an all-determined DS gives a maximum of 2023-06-01, and AESTDTC 2023-07-01 fires. Neuter hint: change 001's 2023-06-- to 2023-06-30 and the count becomes 2."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 AESTDTC=2023-07-01
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESTDTC type=Char label="Start Date/Time of Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE | 2023-07-01
S1 | AE | 002 | 1 | NAUSEA   | 2023-07-01
---

dataset DS class=EVENTS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSDECOD type=Char label="Standardized Disposition Term"
col DSSTDTC type=Char label="Start Date/Time of Disposition Event"
---
S1 | DS | 001 | 1 | RANDOMIZED | 2023-05-01
S1 | DS | 001 | 2 | COMPLETED  | 2023-06--
S1 | DS | 002 | 1 | RANDOMIZED | 2023-05-01
S1 | DS | 002 | 2 | COMPLETED  | 2023-06-01
