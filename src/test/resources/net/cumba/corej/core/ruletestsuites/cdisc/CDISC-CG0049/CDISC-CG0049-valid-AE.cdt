#!RuleTest
#test CDISC-CG0049 expect=noViolation domain=AE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0049 (Rule: --DECOD and --PTCD have a one-to-one relationship). Every AEPTCD maps to exactly one AEDECOD and vice versa; HEADACHE occurs on two records with the same code 10019211 (repetition is not a conflict) -> silent."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEDECOD type=Char label="Dictionary-Derived Term"
col AEPTCD  type=Num  label="Preferred Term Code"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE | HEADACHE | 10019211
CDISCPILOT01 | AE | 01-701-1023 | 1 | HEADACHE | HEADACHE | 10019211
CDISCPILOT01 | AE | 01-701-1028 | 1 | NAUSEA | NAUSEA | 10028813
