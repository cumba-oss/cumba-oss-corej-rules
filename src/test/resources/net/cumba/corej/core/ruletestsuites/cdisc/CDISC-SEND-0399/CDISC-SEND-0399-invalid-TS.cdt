#!RuleTest
#test CDISC-SEND-0399 expect=violation domain=TS
#note "TSVAL is populated with a value that is not a term of the SNDIGVER codelist (codelist_terms) on the qualifying record -> fires; the conformant and the non-qualifying rows stay silent. W4 (PLAN-list-functions phase 0, scenarios-first on the pre-port engine)."
#library standard=sendig-dart version=1-2
#library codelist-terms SNDIGVER "SEND IG 3.1" "SEND IG 3.1.1"
#expectViolationCount 1
#expectViolationAt row=1 TSVAL=3.1.1
dataset TS
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL    type=Char label="Parameter Value"
---
S1 | TS | 1 | SNDIGVER | 3.1.1
S1 | TS | 2 | SNDIGVER | SEND IG 3.1.1
S1 | TS | 3 | SSTYP | 3.1.1
