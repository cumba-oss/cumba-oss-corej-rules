#!RuleTest
#test PMDA-SD1027 expect=noViolation domain=TA
#note "FRESH, DISCRIMINATING. Zero data rows. Full column block including both ETCD and ELEMENT (so the Requirements.Variables gate passes). Sensitivity RECORD, no synthetic table, and with no rows there is no relationship to violate."
#library standard=sdtmig version=3-4
#expectViolationCount 0
dataset TA class="TRIAL DESIGN" label="Trial Arms"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
col TAETORD type=Num  label="Planned Order of Element within Arm"
col ETCD    type=Char label="Element Code"
col ELEMENT type=Char label="Description of Element"
---
