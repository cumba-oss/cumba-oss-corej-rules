#!RuleTest
#test PMDA-AD0250 expect=violation domain=ADTTE
#note "Isolates the EVNTDESC arm: an event description is present while CNSR is not declared, so (var_exists(EVNTDESC) or var_exists(CNSDTDSC)) and not var_exists(CNSR) holds. Presence-only check, folded by BroadcastFold to exactly ONE dataset-level violation reported at row 1. The pin adds EVNTDESC (present, row-1 value DEATH); CNSDTDSC is not declared here and CNSR must never be pinned - it is absent by construction."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 nameOnly=EVNTDESC
dataset ADTTE structure=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVAL     type=Num
col STARTDT  type=Num
col EVNTDESC type=Char
---
CDISCPILOT01 | 01-701-1015 | TTDEATH | 120 | 21915 | DEATH
CDISCPILOT01 | 01-701-1023 | TTDEATH | 300 | 21915 | ALIVE
