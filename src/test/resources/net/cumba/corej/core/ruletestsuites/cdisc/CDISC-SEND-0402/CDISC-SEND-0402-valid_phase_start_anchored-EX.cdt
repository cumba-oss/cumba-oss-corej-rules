#!RuleTest
#test CDISC-SEND-0402 expect=noViolation domain=EX
#note "Re-read by PLAN-rprfdy-offset-tp-join (phase 4, §8.1): DM and TP added (path A, RPRFDY 0), the SJ join removed from the rule (D-SJ) and the offset read again through DM.RPATHCD (C2). Pins the arithmetic the rule ships with: --RPSTDY = date(--STDTC) - date(earliest SJSTDTC within the subject's RPHASE) + RPRFDY. SJ declares two stages in P1 (earliest 2020-01-01); EXSTDTC 2020-01-15 gives 14, TP's RPRFDY 0 adds nothing, EXRPSTDY carries 14 -> silent. The two SJ stages no longer multiply anything (D-SJ); the earliest-stage anchor is pinned (the later stage, 2020-01-11, would give 4)."
#library standard=sendig-dart version=1-2
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col RPHASE  type=Char label="Repro Phase"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
col EXRPSTDY type=Num label="Repro Phase Day of Start of Treatment"
---
S1 | EX | 001 | 1 | P1 | 2020-01-15 | 14
---

dataset SJ class="SPECIAL PURPOSE" label="Subject Repro Stages"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SJSEQ   type=Num  label="Sequence Number"
col RPHASE  type=Char label="Repro Phase"
col RSTAGE  type=Char label="Repro Stage"
col SJSTDTC type=Char label="Start Date/Time of Repro Stage"
col SJENDTC type=Char label="End Date/Time of Repro Stage"
---
S1 | SJ | 001 | 1 | P1 | STAGE1 | 2020-01-01 | 2020-01-10
S1 | SJ | 001 | 2 | P1 | STAGE2 | 2020-01-11 | 2020-01-20
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RPATHCD type=Char label="Planned Repro Path Code"
---
S1 | DM | 001 | A
---

dataset TP class="TRIAL DESIGN" label="Trial Repro Paths"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col RPATHCD  type=Char label="Planned Repro Path Code"
col TPSTGORD type=Num  label="Order of Repro Stage within Repro Path"
col RSTGCD   type=Char label="Repro Stage Code"
col RSTAGE   type=Char label="Description of Repro Stage"
col RPHASE   type=Char label="Repro Phase"
col RPRFDY   type=Num  label="Repro Phase Start Reference Day"
---
S1 | TP | A | 1 | STG1 | Stg1 | P1 | 0
---
