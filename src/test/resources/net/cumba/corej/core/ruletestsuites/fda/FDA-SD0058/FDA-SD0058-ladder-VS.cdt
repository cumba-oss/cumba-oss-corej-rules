#!RuleTest
#test FDA-SD0058 expect=violation domain=VS
#note "The two-level ladder in one dataset (PLAN-model-vs-ig-column-order §4, owner ruling 2026-09-25). Both lists are served: the model list (get_model_column_order) and the IG list (get_dataset_filtered_variables, served here through domain-variables). VSCUSTOM is in NEITHER -> ERROR (sponsor-defined). VSCSTATE is in the IG list but not in the model list -> WARNING (the IG runs ahead of the model it links to; SENDIG 3.0 measured 60 such variables, VSCSTATE among them). Every other column is in the model list -> silent. NEGATIVE CONTROL: collapsing the levels back to one plain check reports VSCSTATE at ERROR and this scenario goes red on the severity pin."
#library standard=sendig version=3-0
#library model-column-order VS STUDYID DOMAIN USUBJID VSSEQ VSTESTCD VSTEST VSORRES
#library domain-variables VS STUDYID:Identifier DOMAIN:Identifier USUBJID:Identifier VSSEQ:Identifier VSTESTCD:Topic "VSTEST:Synonym Qualifier" "VSORRES:Result Qualifier" "VSCSTATE:Record Qualifier"
#expectViolationCount 2
#expectViolationAt severity=ERROR variable_name=VSCUSTOM
#expectViolationAt severity=WARNING variable_name=VSCSTATE
dataset VS label="Vital Signs"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VSSEQ    type=Num  label="Sequence Number"
col VSTESTCD type=Char label="Vital Signs Test Short Name"
col VSTEST   type=Char label="Vital Signs Test Name"
col VSORRES  type=Char label="Result or Finding in Original Units"
col VSCSTATE type=Char label="Consciousness State"
col VSCUSTOM type=Char label="Sponsor Defined Variable"
---
CDISCPILOT01 | VS | 01-701-1015 | 1 | SYSBP | Systolic Blood Pressure | 120 | CONSCIOUS | X
---
