#!RuleTest
#test CDISC-SEND-0137 expect=violation domain=EX
#note "PLAN-stopped-rule-engine-fixes item 1, the sensitivity arm: EX.EXDOSE has no comment at the variable level and only ONE of its two value-level entries (EXTRT=PLACEBO) carries one - the EXTRT=DRUG A entry does not. Not every value is documented, so the variable is reported once, never once per record."
#library standard=sendig version=3-1-1
#define-xml CDISC-SEND-0137-vlm-partial-define.xml
#expectViolationCount 1
#expectViolationAt variable_name=EXDOSE
dataset EX
col STUDYID  type=Char
col USUBJID  type=Char
col EXTRT    type=Char
col EXDOSE   type=Num
---
S1 | S1-001 | PLACEBO | 0
S1 | S1-002 | DRUG A | 10
