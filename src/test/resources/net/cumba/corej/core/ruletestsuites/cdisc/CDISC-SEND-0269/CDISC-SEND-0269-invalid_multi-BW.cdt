#!RuleTest
#test CDISC-SEND-0269 expect=violation domain=BW
#note "BWTERM (EVENTS) and BWDOSE (INTERVENTIONS) are both borrowed from other general observation classes, and BWOBJ is the FINDINGS ABOUT splice variable (the fourth class, owner ruling Q5); the metadata channel yields ONE finding per offending column, so the count is 3 and the pins are variable_name= (never row=)."
#library standard=sendig version=3-0
#library model-column-order      BW STUDYID DOMAIN USUBJID POOLID BWSEQ BWGRPID BWTESTCD BWTEST BWORRES BWORRESU BWSTRESC BWSTRESN BWSTRESU BWSTAT BWREASND BWLAT BWDIR BWDTC BWDY
#library column-order            BW STUDYID DOMAIN USUBJID BWSEQ BWTESTCD BWTEST BWORRES BWORRESU BWSTRESC BWSTRESN BWSTRESU BWSTAT BWREASND BWBLFL BWFAST BWDTC BWDY BWNOMDY
#library model-class-variables   FINDINGS      --TESTCD:Topic "--TEST:Synonym Qualifier" "--ORRES:Result Qualifier" "--STRESC:Result Qualifier" "--STAT:Record Qualifier" "--REASND:Record Qualifier" "--LAT:Variable Qualifier" "--DIR:Variable Qualifier"
#library model-class-variables   "FINDINGS ABOUT" --TESTCD:Topic "--TEST:Synonym Qualifier" "--OBJ:Record Qualifier" "--ORRES:Result Qualifier"
#library model-class-variables   EVENTS        --TERM:Topic "--DECOD:Synonym Qualifier" "--SEV:Record Qualifier" "--SER:Record Qualifier" "--OUT:Record Qualifier"
#library model-class-variables   INTERVENTIONS --TRT:Topic "--DOSE:Record Qualifier" "--DOSU:Variable Qualifier" "--ROUTE:Variable Qualifier"
#expectViolationCount 3
#expectViolationAt variable_name=BWTERM
#expectViolationAt variable_name=BWDOSE
#expectViolationAt variable_name=BWOBJ
dataset BW class=FINDINGS label="Body Weight"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col BWSEQ    type=Num  label="Sequence Number"
col BWTESTCD type=Char label="Body Weight Test Short Name"
col BWORRES  type=Char label="Result or Finding in Original Units"
col BWTERM   type=Char label="Reported Term"
col BWDOSE   type=Num  label="Dose per Administration"
col BWOBJ    type=Char label="Object of the Observation"
---
S1 | BW | 001 | 1 | BW | 250 | Weight loss | 10 | Tail
