#!RuleTest
#test PMDA-AD0476 expect=violation domain=ADSL
#note "Group STRATAVN=1 holds {HIGH x2, LOW x1}: a strict majority, so is_inconsistent_across_dataset flags exactly the one minority row."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=003 STRATAV=LOW STRATAVN=1
dataset ADSL
col STUDYID  type=Char
col USUBJID  type=Char
col STRATAV  type=Char
col STRATAVN type=Num
---
S1 | 001 | HIGH | 1
S1 | 002 | HIGH | 1
S1 | 003 | LOW  | 1
---
