#!RuleTest
#test CDISC-CG0222 expect=violation domain=AE
#note "Row 1: AEENDTC 2013-12-30 precedes RFSTDTC 2014-01-02 and is study day -3, but AEENDY carries -2 (a day-0 count), so the rule fires once. Row 2 is correct."
#expectViolationCount 1
#expectViolationAt row=1 AESEQ=1 AEENDY=-2
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AEENDTC type=Char label="End Date/Time of Adverse Event"
col AEENDY type=Num label="Study Day of End of Adverse Event"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | 2013-12-30 | -2
CDISCPILOT01 | AE | 01-701-1015 | 2 | 2014-01-09 | 8
---

dataset DM label=Demographics
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
---
CDISCPILOT01 | DM | 01-701-1015 | 2014-01-02
---
