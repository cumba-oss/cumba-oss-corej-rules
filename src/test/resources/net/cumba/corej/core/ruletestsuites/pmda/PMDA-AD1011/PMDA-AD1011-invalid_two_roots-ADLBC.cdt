#!RuleTest
#test PMDA-AD1011 expect=violation domain=ADLBC
#note "Pins the per-root expansion arithmetic: AVISITN and APHASEN are two distinct `*N` matches, so the rule expands TWICE (roots AVISIT and APHASE). The single data row leaves both primaries empty while both secondaries are populated, so BOTH expansions fire on it and the harness aggregates them - 2 violations from 1 row. Count the expansions, not the rows. No other column here ends in N or C."
#library standard=adamig version=1-3
#expectViolationCount 2
#expectViolationAt row=1 nameOnly=AVISITN
#expectViolationAt row=1 nameOnly=APHASEN
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col AVISIT  type=Char
col AVISITN type=Num
col APHASE  type=Char
col APHASEN type=Num
---
CDISCPILOT01 | 01-701-1015 |  | 1 |  | 2
