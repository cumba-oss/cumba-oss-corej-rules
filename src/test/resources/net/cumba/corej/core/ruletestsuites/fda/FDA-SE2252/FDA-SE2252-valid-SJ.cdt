#!RuleTest
#test FDA-SE2252 expect=noViolation domain=SJ
#note "RSTGCD at the 8-character boundary (row 2) is conformant; a shorter value and an empty value never fire."
#library standard=sendig-dart version=1-1
dataset SJ label="Subject Repro Stages"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SJSEQ   type=Num  label="Sequence Number"
col RSTGCD  type=Char label="Repro Stage Code"
---
S1 | SJ | 001 | 1 | GD0
S1 | SJ | 001 | 2 | LACTPERI
S1 | SJ | 001 | 3 |
