#!RuleTest
#test CDISC-AD0792 expect=noViolation domain=ADLBC
# Rule:Description: On a given record, a variable with a suffix of SDT has a value greater than a value of a variable with the same root and a suffix of EDT, and both variables are populated
#note "ASDT=50 not greater than AEDT=100 -> noViolation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ASDT type=Num
col AEDT type=Num
---
CDISCPILOT01 | 01-701-1015 | GLUC | 50 | 100
---
