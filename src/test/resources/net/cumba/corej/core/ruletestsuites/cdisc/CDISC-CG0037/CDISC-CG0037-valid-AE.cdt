#!RuleTest
#test CDISC-CG0037 expect=noViolation domain=AE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0037 (Condition: Primary SOC used for analysis; Rule: --SOCCD = --BDSYCD). Rows 1-2: AESOCCD equals AEBDSYCD. Row 3: the event is not yet coded (both codes null), so there is no SOC code to compare -> silent."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEDECOD  type=Char label="Dictionary-Derived Term"
col AEBDSYCD type=Num  label="Body System or Organ Class Code"
col AESOCCD  type=Num  label="Primary System Organ Class Code"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE | HEADACHE | 10029205 | 10029205
CDISCPILOT01 | AE | 01-701-1023 | 1 | NAUSEA | NAUSEA | 10017947 | 10017947
CDISCPILOT01 | AE | 01-701-1028 | 1 | ITCHY SKIN | | |
