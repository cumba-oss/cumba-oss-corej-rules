#!RuleTest
#test PMDA-AD0042A expect=noViolation domain=ADLBC
#note "Both names end with TM and both carry no format, so both would fire without the two exclusions: ARELTM is excluded by the literal varname() != ARELTM term, ASTDTM by not ends_with(varname(), DTM). Pins both exclusions in one fixture."
#library standard=adamig version=1-3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ARELTM  type=Num
col ASTDTM  type=Num
---
CDISCPILOT01 | 01-701-1015 | SYSBP | 2 | 1
