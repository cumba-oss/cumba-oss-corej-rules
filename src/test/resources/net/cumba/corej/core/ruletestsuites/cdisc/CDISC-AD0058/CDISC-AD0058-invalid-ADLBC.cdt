#!RuleTest
#test CDISC-AD0058 expect=violation domain=ADLBC
# Rule:Description: A variable with a suffix of DT is not a numeric variable
#note "ADT is Char (data_type != Num) -> violation"
#expectViolationCount 1
#expectViolationAt variable_data_type=Char variable_name=ADT
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ADT type=Char
---
CDISCPILOT01 | 01-701-1015 | ALB | x
