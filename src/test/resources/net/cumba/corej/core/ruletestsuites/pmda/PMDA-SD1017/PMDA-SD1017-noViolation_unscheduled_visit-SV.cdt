#!RuleTest
#test PMDA-SD1017 expect=noViolation domain=SV
#note "THE POINT OF THE SPLIT (wave D, T1-39): identical to the violation fixture except row 2 reads UNSCHEDULED VISIT 1 -- conformant data the ungated parent reported before this wave, because with the SVUPDES column absent its empty(SVUPDES) leaf treated every visit as planned. The name heuristic reads the visit as unscheduled and stays silent; EXTRA VISIT or AD HOC would still read as planned, which is why Executability stays Possible Overreporting."
#library standard=sdtmig version=3-4
#expectViolationCount 0
dataset SV class="SPECIAL PURPOSE" label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
S1 | SV | 001 | 1  | SCREENING
S1 | SV | 001 | 99 | UNSCHEDULED VISIT 1
---

dataset TV class="TRIAL DESIGN" label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
S1 | TV | 1 | SCREENING
S1 | TV | 2 | WEEK 2
---
