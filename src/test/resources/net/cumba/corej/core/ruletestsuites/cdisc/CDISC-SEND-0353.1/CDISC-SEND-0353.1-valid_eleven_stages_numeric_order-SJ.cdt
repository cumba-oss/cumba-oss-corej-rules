#!RuleTest
#test CDISC-SEND-0353.1 expect=noViolation domain=SJ
#library standard=sendig-dart version=1-1
#note "Eleven stages in file order 1, 10, 11, 2, 3, 4, 5, 6, 7, 8, 9: each SJENDTC equals the next stage's SJSTDTC, a clean chain only in NUMERIC SJSEQ order. Ordered by the key's text (1, 10, 11, 2, ...) the chain breaks at 1->10 and 11->2; PLAN-by-key-numeric-order (CellOrder by= key)."
dataset SJ label="Subject Stages"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SJSEQ   type=Num  label="Sequence Number"
col SJSTDTC type=Char label="Start Date/Time of Repro Stage"
col SJENDTC type=Char label="End Date/Time of Repro Stage"
