#!RuleTest
#test FDA-SD0021 expect=skipped domain=AE
#note "None of the four end-point columns (AEENDTC/AEENRF/AEENRTPT/AEDUR) exists, so Requirements.Variables.Any [--ENDTC, --ENRF, --ENRTPT, --DUR] gates the rule out -> auditable skip instead of one finding per row under absent = all-missing (EC-43). Both rows WOULD fire were the gate removed (AEOCCUR/AESTAT columns absent too: --OCCUR != 'N' fires on a missing value per R-5.22, empty(--STAT) is true). Verdict 2-1 (T1-04/05/08/09): the absence is itself reportable, and the minted sister FDA-SD9719 reports it ONCE for this dataset."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE
S1 | AE | 001 | 2 | NAUSEA
