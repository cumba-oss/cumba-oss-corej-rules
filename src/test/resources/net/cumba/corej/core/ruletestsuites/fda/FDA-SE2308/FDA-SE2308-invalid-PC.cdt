#!RuleTest
#test FDA-SE2308 expect=violation domain=PC
#note "Since the R-5.25 split (top-level-or board wave 2, group J) this rule owns ONLY the PCELTM half: row 1 (PCELTM empty) fires. Row 2 (no day anchor: VISITDY and PCNOMDY both missing) is the split sibling FDA-SE2308-A's state and must NOT fire here - the discriminator; row 3 is complete."
#library standard=sendig version=3-1
#expectViolationCount 1
#expectViolationAt row=1 PCSEQ=1
dataset PC class=FINDINGS label="Pharmacokinetics Concentrations"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col PCSEQ   type=Num  label="Sequence Number"
col VISITDY type=Num  label="Planned Study Day of Visit"
col PCNOMDY type=Num  label="Nominal Study Day for Tabulations"
col PCELTM  type=Char label="Planned Elapsed Time from Time Point Ref"
---
S1 | PC | 001 | 1 | 3 | 1 |
S1 | PC | 001 | 2 | . | . | PT1H
S1 | PC | 001 | 3 | 3 | 1 | PT0H
