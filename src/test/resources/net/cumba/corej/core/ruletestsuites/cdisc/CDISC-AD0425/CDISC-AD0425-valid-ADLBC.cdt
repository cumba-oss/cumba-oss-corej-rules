#!RuleTest
#test CDISC-AD0425 expect=noViolation domain=ADLBC
# Rule:Description: On a given record, TRTAGy is populated and TRTAGyN is not populated
#note "TRTAG1 populated and TRTAG1N populated -> noViolation"
# Declared-tier scope: the class= declaration disagrees with the columns, so #define must
# carry it to RuleRunner (ScenarioDeclaredScopeProvider.install).
#define standard=adamig version=1-3
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col TRTAG1 type=Char
col TRTAG1N type=Char
---
CDISCPILOT01 | 01-701-1015 | VAL | VAL
---
