#!RuleTest
#test CDISC-CG0042 expect=violation domain=AE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0042 (Condition: AESCAN ^= 'Y' and AESCONG ^= 'Y' and AESDISAB ^= 'Y' and AESDTH ^= 'Y' and AESHOSP ^= 'Y' and AESLIFE ^= 'Y' and AESOD ^= 'Y' and AESMIE ^= 'Y'; Rule: AESER = 'N'). Row 2: AESER=Y but none of the seriousness criteria present (AESDTH, AESHOSP, AESLIFE) is Y -> fires. Row 1: AESER=Y backed by AESHOSP=Y (Condition false), silent. Row 3: no criterion is Y and AESER=N, conformant."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1023 AETERM=DIZZINESS
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESER   type=Char label="Serious Event"
col AESDTH  type=Char label="Results in Death"
col AESHOSP type=Char label="Requires or Prolongs Hospitalization"
col AESLIFE type=Char label="Is Life Threatening"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | PNEUMONIA | Y | N | Y | N
CDISCPILOT01 | AE | 01-701-1023 | 1 | DIZZINESS | Y | N | N | N
CDISCPILOT01 | AE | 01-701-1028 | 1 | HEADACHE | N | N | N | N
