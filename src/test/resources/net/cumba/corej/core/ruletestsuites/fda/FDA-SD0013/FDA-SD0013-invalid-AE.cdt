#!RuleTest
#test FDA-SD0013 expect=violation domain=AE
#note "Row 2 starts 2020-02-10 but ends 2020-02-01, so --STDTC is after --ENDTC. Covers the EVENTS class branch of Scope.Classes."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 AESTDTC=2020-02-10 AEENDTC=2020-02-01
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESTDTC type=Char label="Start Date/Time of Adverse Event"
col AEENDTC type=Char label="End Date/Time of Adverse Event"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE | 2020-01-05 | 2020-01-09
CDISCPILOT01 | AE | 01-701-1015 | 2 | NAUSEA   | 2020-02-10 | 2020-02-01
