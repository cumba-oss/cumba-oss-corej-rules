#!RuleTest
#test CDISC-CG0313-C expect=violation domain=AE
#note "R-5.25 wave-3 group K split of CG0313 (each missing key variable is its own defect), subject-identifier half: neither USUBJID nor POOLID is in the dataset. The composite branch stays whole as ONE condition - the defect is having no subject identifier at all; dataset-level, reported once."
#library standard=sdtmig version=3-2
#expectViolationCount 1
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
---
S1 | AE | 1 | Headache
