#!RuleTest
#test PMDA-AD0616 expect=violation domain=ADSL
#note "`y` compiles to (\\d+). One expansion (y=1); group TRCMPG1N=1 holds {HIGH x2, LOW x1} -> one minority row."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=003 TRCMPG1=LOW TRCMPG1N=1
dataset ADSL
col STUDYID   type=Char
col USUBJID   type=Char
col TRCMPG1   type=Char
col TRCMPG1N  type=Num
---
S1 | 001 | HIGH | 1
S1 | 002 | HIGH | 1
S1 | 003 | LOW  | 1
---
