#!RuleTest
#test PMDA-SD0072 expect=violation domain=SUPPAE
#note "row 2: RDOMAIN=ZZ names no dataset of the study (only AE and SUPPAE are registered) -> fires; row 1 (RDOMAIN=AE) is valid"
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 RDOMAIN=ZZ
dataset SUPPAE class=RELATIONSHIP label="Supplemental Qualifiers for AE"
col STUDYID type=Char label="Study Identifier"
col RDOMAIN type=Char label="Related Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col QNAM    type=Char label="Qualifier Variable Name"
col QVAL    type=Char label="Data Value"
---
S1 | AE | 001 | AESOSP | Y
S1 | ZZ | 001 | AESOSP | Y
---

dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
---
S1 | AE | 001 | 1
