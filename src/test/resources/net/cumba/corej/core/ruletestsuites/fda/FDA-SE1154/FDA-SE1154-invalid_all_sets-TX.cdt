#!RuleTest
#test FDA-SE1154 expect=violation domain=TX
#note "Neither trial set carries a PLANFSUB record -> one finding per SETCD (SET01 and SET02)."
#library standard=sendig version=3-1-1
#expectViolationCount 2
#expectViolationAt SETCD=SET01
#expectViolationAt SETCD=SET02
dataset TX class="TRIAL DESIGN" label="Trial Sets"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col SETCD    type=Char label="Set Code"
col SET      type=Char label="Set Description"
col TXSEQ    type=Num  label="Sequence Number"
col TXPARMCD type=Char label="Trial Set Parameter Short Name"
col TXPARM   type=Char label="Trial Set Parameter"
col TXVAL    type=Char label="Trial Set Parameter Value"
---
S1 | TX | SET01 | Control | 1 | GRPLBL | Group Label | Control
S1 | TX | SET01 | Control | 2 | PLANMSUB | Planned Number of Male Subjects | 10
S1 | TX | SET02 | High Dose | 3 | GRPLBL | Group Label | High Dose
S1 | TX | SET02 | High Dose | 4 | PLANMSUB | Planned Number of Male Subjects | 10
