#!RuleTest
#test CDISC-SEND-0070-B expect=violation domain=LB
#note "The half this R-5.25 split sibling owns (top-level-or board wave 2, group J): LBENDTC carries the mismatching interval - row 1 is tier 10 against tier 4, row 2 is 10 against 10. LBDTC and LBSTDTC are blank throughout, so before the split this dataset was the proof that the parent's third disjunct was wired; now it is this rule's own violation, reported against --ENDTC instead of being mis-attributed to --DTC."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 LBSEQ=1
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Test Short Name"
col LBDTC    type=Char label="Date/Time of Specimen Collection"
col LBSTDTC  type=Char label="Start Date/Time of Specimen Collection"
col LBENDTC  type=Char label="End Date/Time of Specimen Collection"
---
S1 | LB | 001 | 1 | ALB |  |  | 2023-01-15/2023
S1 | LB | 001 | 2 | ALB |  |  | 2023-01-15/2023-01-20
---
