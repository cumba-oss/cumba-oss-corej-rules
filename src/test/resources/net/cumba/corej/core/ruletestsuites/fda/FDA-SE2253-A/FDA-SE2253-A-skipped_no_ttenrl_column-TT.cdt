#!RuleTest
#test FDA-SE2253-A expect=skipped domain=TT
#note "DISCRIMINATOR (R-5.26): TTENRL is not in the dataset either, so Requirements.Variables.All [TTENRL] is unmet and this sibling SKIPS - the neither-column state belongs to the dataset sister FDA-SD9730, which reports it once."
#library standard=sendig version=dart-1-1
dataset TT class="TRIAL DESIGN" label="Trial Repro Stages"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col RSTGCD  type=Char label="Repro Stage Code"
col RSTAGE  type=Char label="Description of Repro Stage"
---
S1 | TT | ST1 | Premating
S1 | TT | ST2 | Gestation
