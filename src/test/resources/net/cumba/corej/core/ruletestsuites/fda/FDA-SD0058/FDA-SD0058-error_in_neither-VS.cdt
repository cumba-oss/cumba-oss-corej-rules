#!RuleTest
#test FDA-SD0058 expect=violation domain=VS
#note "ERROR level alone (PLAN-model-vs-ig-column-order §4d): both lists are served and VSCUSTOM is in neither -> one ERROR. The ladder's WARNING level does not re-report it (it is not in the IG list either)."
#library standard=sendig version=3-0
#library model-column-order VS STUDYID DOMAIN USUBJID VSSEQ VSTESTCD VSTEST VSORRES
#library domain-variables VS STUDYID:Identifier DOMAIN:Identifier USUBJID:Identifier VSSEQ:Identifier VSTESTCD:Topic "VSTEST:Synonym Qualifier" "VSORRES:Result Qualifier" "VSCSTATE:Record Qualifier"
#expectViolationCount 1
#expectViolationAt severity=ERROR variable_name=VSCUSTOM
dataset VS label="Vital Signs"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VSSEQ    type=Num  label="Sequence Number"
col VSTESTCD type=Char label="Vital Signs Test Short Name"
col VSTEST   type=Char label="Vital Signs Test Name"
col VSORRES  type=Char label="Result or Finding in Original Units"
col VSCUSTOM type=Char label="Sponsor Defined Variable"
---
CDISCPILOT01 | VS | 01-701-1015 | 1 | SYSBP | Systolic Blood Pressure | 120 | X
---
