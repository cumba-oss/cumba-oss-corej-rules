#!RuleTest
#test FDA-SD9720 expect=skipped domain=AE
#note "The discriminator that keeps the trio from double-reporting: the AESTDTC column EXISTS (blank on both rows), so Requirements.Variables.None [--STDTC, --STRF, --STRTPT] skips this sister with a reason naming the column, and the parents own the case - FDA-SD0022 reports row 1 (no start populated, no exception) and FDA-SD0031 reports row 2 (end populated, no start) with their locations."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESTDTC type=Char label="Start Date/Time of Adverse Event"
col AEENDTC type=Char label="End Date/Time of Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE | |
S1 | AE | 001 | 2 | NAUSEA   | | 2020-01-05
