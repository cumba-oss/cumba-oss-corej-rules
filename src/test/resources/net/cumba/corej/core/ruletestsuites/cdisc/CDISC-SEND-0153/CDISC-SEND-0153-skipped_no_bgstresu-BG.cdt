#!RuleTest
#test CDISC-SEND-0153 expect=skipped domain=BG
#note "BGSTRESU absent -> Requirements.Variables.All [BGSTRESU] gates the rule to SKIPPED."
dataset BG label="Body Weight Gain"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col BGSEQ   type=Num  label="Sequence Number"
col BGTEST  type=Char label="Body Weight Gain Test Name"
---
CDISCPILOT01 | BG | 001 | 1 | BODY WEIGHT GAIN
---
