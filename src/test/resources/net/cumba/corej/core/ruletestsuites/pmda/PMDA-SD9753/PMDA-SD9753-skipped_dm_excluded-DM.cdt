#!RuleTest
#test PMDA-SD9753 expect=skipped domain=DM
#note "Scope boundary: DM is excluded (the parent PMDA-SD1089 excludes DM); the body would fire (DMSTDY populated, no DMSTDTC)."
#library standard=sdtmig version=3-2
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SEX type=Char label="Sex"
col DMSTDY type=Num label="Study Day of Start of Observation"
---
S1 | DM | 001 | F | 5
S1 | DM | 002 | M | 6
S1 | DM | 003 | F | 
