#!RuleTest
#test PMDA-SD1103 expect=violation domain=CE
#note "Shipped Check var_exists(\"--STRTPT\") and not var_exists(\"--STTPT\") resolves per the EC-36 prefix rule to CESTRTPT/CESTTPT; both leaves are dataset constants -> BroadcastFold -> exactly ONE violation reported at row=1 regardless of row count."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 nameOnly=CESTRTPT
dataset CE class=EVENTS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col CESEQ    type=Num
col CESTRTPT type=Char
---
S1 | CE | 001 | 1 | BEFORE
