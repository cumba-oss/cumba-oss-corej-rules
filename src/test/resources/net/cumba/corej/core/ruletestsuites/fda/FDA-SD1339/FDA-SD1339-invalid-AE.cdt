#!RuleTest
#test FDA-SD1339 expect=violation domain=AE
#note "Row 1 has EPOCH present-but-empty while the start date AESTDTC is populated -> fires. Row 2 carries EPOCH; row 3 has neither EPOCH nor a date -> neither fires."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col EPOCH   type=Char label="Epoch"
col AESTDTC type=Char label="Start Date/Time of Adverse Event"
---
S1 | AE | 001 | 1 | Headache |           | 2023-06-01
S1 | AE | 001 | 2 | Nausea   | TREATMENT | 2023-06-02
S1 | AE | 001 | 3 | Fatigue  |           |
