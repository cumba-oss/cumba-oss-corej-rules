#!RuleTest
#test PMDA-AD0127A expect=violation domain=ADLBC
#note "Isolates the var_exists(\"BASEC\") arm of the leading disjunction: neither BASE nor ABLFL is declared, so only the character baseline triggers the rule. Presence-only check, folded to one dataset-level violation reported at row 1. The pin uses BASEC (present, row-1 value NEGATIVE); BASE is not declared here so it cannot be pinned."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 nameOnly=BASEC
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVALC   type=Char
col BASEC   type=Char
---
CDISCPILOT01 | 01-701-1015 | HGB | POSITIVE | NEGATIVE
CDISCPILOT01 | 01-701-1023 | HGB | POSITIVE | POSITIVE
