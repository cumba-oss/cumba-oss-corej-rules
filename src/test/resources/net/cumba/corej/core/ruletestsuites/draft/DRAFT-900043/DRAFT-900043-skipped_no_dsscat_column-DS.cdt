#!RuleTest
#test DRAFT-900043 expect=violation domain=DS
#note "RE-POINTED violation -> skipped 2026-09-11 (wave C3, T1-31), SUPERSEDING the 2026-08-27 gate-removal rationale: that ruling removed DSSCAT from Requirements.Variables.All because NO rule anywhere reported its absence -- and that missing half is exactly what the minted sister DRAFT-900045 now supplies, so the gate returns with it. The parent skips here naming DSSCAT; DRAFT-900045 reports the same dataset shape ONCE (Sensitivity Dataset), where the pre-gate parent flooded one finding per duplicated DISPOSITION EVENT row (2 here)."
#library standard=sdtmig version=3-4
#expectViolationCount 1
dataset DS class=EVENTS label="Disposition"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col DSSEQ    type=Num  label="Sequence Number"
col DSCAT    type=Char label="Category for Disposition Event"
col EPOCH    type=Char label="Epoch"
---
CDISCPILOT01 | DS | 01-701-1015 | 1 | DISPOSITION EVENT | TREATMENT
CDISCPILOT01 | DS | 01-701-1015 | 2 | DISPOSITION EVENT | TREATMENT
