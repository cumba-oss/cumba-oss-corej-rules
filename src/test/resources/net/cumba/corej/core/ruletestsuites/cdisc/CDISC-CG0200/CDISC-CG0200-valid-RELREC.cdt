#!RuleTest
#test CDISC-CG0200 expect=noViolation domain=RELREC
# Rule:Description: Raise an error when, within a subject, a unique RELID is not present on multiple RELREC records.
#note "each RELID appears on multiple records within its subject (no orphans)"
dataset RELREC label="Related Records"
col STUDYID type=Char label="Study Identifier"
col RDOMAIN type=Char label="Related Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RELID type=Char label="Relationship Identifier"
---
CDISCPILOT01 | AE | 01-701-1015 | 01-701-1015-E09
CDISCPILOT01 | CM | 01-701-1015 | 01-701-1015-E09
CDISCPILOT01 | AE | 01-701-1023 | 01-701-1023-E13
CDISCPILOT01 | LB | 01-701-1023 | 01-701-1023-E13
---
