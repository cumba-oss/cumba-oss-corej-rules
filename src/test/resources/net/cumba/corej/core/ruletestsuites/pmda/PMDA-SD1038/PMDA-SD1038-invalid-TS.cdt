#!RuleTest
#test PMDA-SD1038 expect=violation domain=TS
#note "TSSEQ 1 occurs twice under SPONSOR, so both SPONSOR rows fire; the TITLE record legitimately reuses TSSEQ 1 under a different parameter."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=2 TSPARMCD=SPONSOR
#expectViolationAt row=3 TSPARMCD=SPONSOR
dataset TS class="TRIAL DESIGN"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL    type=Char label="Parameter Value"
---
S1 | TS | 1 | TITLE   | Study of X
S1 | TS | 1 | SPONSOR | Acme
S1 | TS | 1 | SPONSOR | Acme Sub
