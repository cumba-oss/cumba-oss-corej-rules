#!RuleTest
#test PMDA-SD1045 expect=violation domain=IE
#note "Boundary: an EXCLUSION record with an empty IEORRES does not equal the required 'Y', so the rule must fire (row 1). Row 2 is the conformant exclusion."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 IECAT=EXCLUSION IEORRES=
dataset IE class=FINDINGS label="Inclusion/Exclusion Criteria Not Met"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IESEQ    type=Num  label="Sequence Number"
col IETESTCD type=Char label="Inclusion/Exclusion Criterion Short Name"
col IECAT    type=Char label="Inclusion/Exclusion Category"
col IEORRES  type=Char label="I/E Criterion Original Result"
---
S1 | IE | 001 | 1 | EXCL01 | EXCLUSION |
S1 | IE | 002 | 1 | EXCL02 | EXCLUSION | Y
