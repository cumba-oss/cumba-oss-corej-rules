#!RuleTest
#test FDA-SD1381 expect=noViolation domain=MB
#note "PLAN-function-surface-wave1 phase 2 (a2) on a parameterised-reference rule: DM is joined but has no RFXSTDTC column (it does carry RFSTDTC, which the rule must NOT fall back to). The absent joined reference is its type default (D4 / D34 #3-#4), is_complete_date(DM.RFXSTDTC) is false, and the rule EXECUTES without firing. MBXDY=15 is the value RFSTDTC would give, so a fallback to RFSTDTC would still not fire and a fallback to any other date would."
#library standard=sendig version=ar-1-0
dataset MB class=FINDINGS
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col MBSEQ   type=Num  label="Sequence Number"
col MBTESTCD type=Char label="Microbiology Test Code"
col MBDTC type=Char label="Date/Time of Collection"
col MBXDY  type=Num  label="Day of Obs Relative to Exposure"
---
S1 | MB | 001 | 1 | BACT | 2023-06-15 | 99
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFSTDTC  type=Char label="Subject Reference Start Date/Time"
---
S1 | DM | 001 | 2023-06-01
---
