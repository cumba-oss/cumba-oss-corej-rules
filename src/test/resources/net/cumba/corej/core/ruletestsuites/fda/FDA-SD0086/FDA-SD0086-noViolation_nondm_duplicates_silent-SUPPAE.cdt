#!RuleTest
#test FDA-SD0086 expect=noViolation domain=SUPPAE
#note "The R-5.25 wave-3 split's discriminator, parent side: this dataset repeats the non-DM five-member key (USUBJID 001 + IDVAR AESEQ + IDVARVAL 1 + QNAM AEREAS twice) - the sibling FDA-SD0086-A's violation data - but every row has RDOMAIN=AE, so the DM half's RDOMAIN == 'DM' conjunct is false and the parent is SILENT. Exactly one half answers each record."
#library standard=sdtmig version=3-4
#expectViolationCount 0
dataset SUPPAE class=RELATIONSHIP label="Supplemental Qualifiers for AE"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM     type=Char label="Qualifier Variable Name"
col QVAL     type=Char label="Data Value"
---
S1 | AE | 001 | AESEQ | 1 | AEREAS  | reason A
S1 | AE | 001 | AESEQ | 1 | AEREAS  | reason B
