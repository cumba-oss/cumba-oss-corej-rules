#!RuleTest
#test PMDA-AD0133B expect=violation domain=ADLBC
#note "AVAL not declared. One expansion (y=1, seeded by both patterns, deduped to the single tuple). Row 1 fires through the bare empty(AVAL) leaf, TRUE on the absent column (absent = all-missing, EC-43; Plan B phase 4d' deleted the not var_exists(AVAL) disjunct); row 2 does not, because not empty(R2A1LO) is false there -- which makes the count of 1 a RECORD-granularity pin rather than a dataset one. AVAL is absent so it is omitted from the pin entirely."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1
dataset ADLBC structure=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col A1LO     type=Num
col R2A1LO   type=Num
---
CDISCPILOT01 | 01-701-1015 | ALT | 0.5 | 1.25
CDISCPILOT01 | 01-701-1023 | ALT | 0.5 |
