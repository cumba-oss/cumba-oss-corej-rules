#!RuleTest
#test PMDA-AD0329 expect=noViolation domain=ADVS
#note "Each (PARAMCD, BASECA1N) group holds one distinct BASECAT1. Deliberate contrast to the degraded-key fixture below."
#library standard=adamig version=1-3
dataset ADVS class=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col BASECAT1 type=Char
col BASECA1N type=Num
---
S1 | 001 | SYSBP | NORMAL | 1
S1 | 002 | SYSBP | NORMAL | 1
S1 | 003 | SYSBP | HIGH   | 2
