#!RuleTest
#test CDISC-CG0410 expect=violation domain=SV
#note "Authority: SDTM/SDTMIG Conformance Rules v2.0 CG0410, Condition 'Scheduled or Contingent visit (exists in TV)', Rule 'VISITNUM identifies unique record within subject'. NUMERIC PIN. TV spells the planned visit '2'; subject S1-001's two SV records spell it '2.0' and '2'. VISITNUM is Num, and 2.0 and 2 are the same number, so the planned visit 2 is recorded twice within the subject -> rows 2 and 3 BOTH fire. A set or a uniqueness key built from cell TEXT rather than the numeric value would lose the membership or the duplicate and fall silent (the typed-set divergence the plan names for W7). Row 1 (VISITNUM 1) is unique -> silent."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=2 USUBJID=S1-001
#expectViolationAt row=3 USUBJID=S1-001
dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col SVSTDTC  type=Char label="Start Date/Time of Visit"
---
S1 | SV | S1-001 | 1   | SCREENING | 2024-01-02
S1 | SV | S1-001 | 2.0 | BASELINE  | 2024-01-10
S1 | SV | S1-001 | 2   | BASELINE  | 2024-01-12
---

dataset TV label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col TVSTRL   type=Char label="Visit Start Rule"
---
S1 | TV | 1 | SCREENING | Start of screening
S1 | TV | 2 | BASELINE  | Day 1
S1 | TV | 3 | WEEK 4    | Day 29
---
