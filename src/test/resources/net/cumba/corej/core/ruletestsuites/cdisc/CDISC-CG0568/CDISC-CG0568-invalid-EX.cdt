#!RuleTest
#test CDISC-CG0568 expect=violation domain=EX
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0568 (Rule: EXMETHOD not present in dataset; EXMETHOD is not used in human clinical trials). EX carries an EXMETHOD column (populated on row 1, empty on row 2) -> the dataset-level presence check fires once. SDTMIG 3.3 package: the rule's only listed standard."
#library standard=sdtmig version=3-3
#expectViolationCount 1
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXDOSE  type=Num  label="Dose"
col EXDOSU  type=Char label="Dose Units"
col EXROUTE type=Char label="Route of Administration"
col EXMETHOD type=Char label="Method of Administration"
---
S1 | EX | S1-001 | 1 | DRUG A | 10 | mg | ORAL | GAVAGE
S1 | EX | S1-002 | 1 | DRUG A | 10 | mg | ORAL |
