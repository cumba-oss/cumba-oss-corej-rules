#!RuleTest
#test CDISC-SEND-0105 expect=noViolation domain=DM
#note "The sheet's fallback branch and the partner of -invalid_ts_species_blank-DM: DM is unchanged (SPECIES blank on both rows) but TS now carries TSPARMCD=SPECIES with TSVAL=RAT, so empty($ts_species) is FALSE and the rule is silent. *** version=3-0 is LOAD-BEARING. M3-D8 restricted this rule's Standards block to the single (SENDIG, 3.0) entry the sheet supports -- row 520 is SEND105's ONLY row -- so from v3.1 onward only the .1 successor ships. A scenario declaring any other package is now a hard membership red, which is why all five declare 3-0. ***"
#library standard=sendig version=3-0
#expectViolationCount 0
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col SEX     type=Char label="Sex"
col SPECIES type=Char label="Species"
col STRAIN  type=Char label="Strain/Substrain"
---
S1 | DM | 001 | 001 | M |  | SPRAGUE-DAWLEY
S1 | DM | 002 | 002 | F |  | SPRAGUE-DAWLEY
---

dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S1 | TS | 1 | STCAT  | Study Category | CHRONIC TOX
S1 | TS | 2 | STRAIN | Strain         | SPRAGUE-DAWLEY
S1 | TS | 3 | SPECIES | Species | RAT
---
