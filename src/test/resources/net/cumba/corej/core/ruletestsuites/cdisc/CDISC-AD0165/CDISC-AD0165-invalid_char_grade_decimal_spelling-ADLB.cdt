#!RuleTest
#test CDISC-AD0165 expect=violation domain=ADLB
#note "W5 (PLAN-grouped-aggregate-functions §2.4) — the second face of the CHAR-as-text drift guard: max over a Char column answers the winning CELL, so BTOXGR != $baseline_atoxgr compares text against text. Baseline ATOXGR is '3', BTOXGR is spelled '3.0' on both rows: two different texts (D-W1-2a — '5' and '5.0' are distinct), so both rows fire. MEASURED 2026-09-29 on the pre-port engine: GREEN (see the sibling scenario: DataValueString.getValueAsDouble() is NaN, so the retired engine never parsed a real Char cell and already answered the text '3'). Pins what stands."
#library standard=adamig version=1-2
#expectViolationCount 2
#expectViolationAt row=1 PARAMCD=ALT BASETYPE=LAST ATOXGR=3 BTOXGR=3.0 "$baseline_atoxgr"=3
#expectViolationAt row=2 PARAMCD=ALT BASETYPE=LAST ATOXGR=1 BTOXGR=3.0 "$baseline_atoxgr"=3
dataset ADLB label="Analysis Dataset Lab"
col STUDYID  type=Char label="Study Identifier"
col USUBJID  type=Char label="Unique Subject Identifier"
col PARAMCD  type=Char label="Parameter Code"
col AVISITN  type=Num  label="Analysis Visit (N)"
col BASETYPE type=Char label="Baseline Type"
col ABLFL    type=Char label="Baseline Record Flag"
col ATOXGR   type=Char label="Analysis Toxicity Grade"
col BTOXGR   type=Char label="Baseline Toxicity Grade"
---
S1 | 101 | ALT | 0 | LAST | Y | 3 | 3.0
S1 | 101 | ALT | 1 | LAST |   | 1 | 3.0
