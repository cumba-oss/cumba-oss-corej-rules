#!RuleTest
#test PMDA-AD0178 expect=noViolation domain=ADLBC
#note "Both extra columns populated with a non-Y value and would fire if the pattern were loose, but the regex is anchored and demands exactly two digits: ANL1FL (one digit) and ANLFL (none) match nothing. Pins the anchoring and digit count."
#library standard=adamig version=1-3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ANL1FL  type=Char
col ANLFL   type=Char
---
CDISCPILOT01 | 01-701-1015 | SYSBP | N | N
