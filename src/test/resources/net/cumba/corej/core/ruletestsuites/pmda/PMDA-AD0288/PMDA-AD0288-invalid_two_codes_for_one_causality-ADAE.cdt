#!RuleTest
#test PMDA-AD0288 expect=violation domain=ADAE
#note "KEY=AEREL (2nd arg), DEPENDENT=AERELN (1st arg): key RELATED carries {1,2} -> rows 1,2 fire; key NOTRELATED is single-valued. Record granularity -> 2 violations."
#library standard=adamig version=1-0
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015 AEREL=RELATED AERELN=1
#expectViolationAt row=2 USUBJID=01-701-1023 AEREL=RELATED AERELN=2
dataset ADAE structure=OCCDS subclass=AE
col STUDYID type=Char
col USUBJID type=Char
col AESEQ   type=Num
col AEDECOD type=Char
col AEREL   type=Char
col AERELN  type=Num
---
