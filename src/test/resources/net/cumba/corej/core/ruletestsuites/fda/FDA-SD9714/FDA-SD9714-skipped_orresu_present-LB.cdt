#!RuleTest
#test FDA-SD9714 expect=skipped domain=LB
#note "The ordinary case: LBORRES has values AND LBORRESU is present. Since the D-6 hoist (2026-09-12) the presence half lives in Requirements.Variables.None [--ORRESU], so the rule reports an auditable SKIPPED here instead of running to silence - a skip is better than a silenced run, and no finding changes. (The all-empty --ORRES case is pinned by var_is_null returning true and is covered by the sibling rule set.)"
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBORRES  type=Char label="Result or Finding in Original Units"
col LBORRESU type=Char label="Original Units"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB | 40 | g/L
