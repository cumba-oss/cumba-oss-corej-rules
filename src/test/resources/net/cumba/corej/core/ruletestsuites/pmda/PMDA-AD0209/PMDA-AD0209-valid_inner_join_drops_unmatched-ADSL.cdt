#!RuleTest
#test PMDA-AD0209 expect=noViolation domain=ADSL
#note "MECHANISM PIN - inner-join drop. Row 1: matched, SITEID 701 == DM.SITEID 701 -> silent (proves non-vacuous execution). Row 2: subject 01-701-9999 has NO DM row - the loader-stamped inner join DROPS the row from the expanded eval table before the Check runs, so the wildly different SITEID (999 vs no DM row) never fires; the subject-missing-from-DM condition is other rules' business."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col SITEID  type=Char
---
S1 | 01-701-1015 | 701
S1 | 01-701-9999 | 999
---

dataset DM label=Demographics
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col SITEID  type=Char
---
S1 | DM | 01-701-1015 | 701
