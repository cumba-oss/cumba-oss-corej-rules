#!RuleTest
#test FDA-SD9749 expect=noViolation domain=AE
# Rule:Description: Raise an error when DM.DTHFL equals 'Y' for a subject but the subject has no AE record where AEOUT equals 'FATAL' or AESDTH equals 'Y'.
#note "Subject 1015 has DM.DTHFL=Y and an AE record with AEOUT=FATAL and AESDTH=Y"
#library standard=sdtmig version=3-4
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AEOUT type=Char label="Outcome of Adverse Event"
col AESDTH type=Char label="Results in Death"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | NOT RECOVERED/NOT RESOLVED | N
CDISCPILOT01 | AE | 01-701-1015 | 2 | FATAL | Y
---

dataset DM label=Demographics
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DTHFL type=Char label="Subject Death Flag"
---
CDISCPILOT01 | DM | 01-701-1015 | Y
---
