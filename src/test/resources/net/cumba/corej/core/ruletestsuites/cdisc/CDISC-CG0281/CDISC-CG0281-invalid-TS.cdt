#!RuleTest
#test CDISC-CG0281 expect=violation domain=TS
#note "Exactly one TRT record and no RANDQT record -> one dataset-level finding (the Check reads only the two dataset-level counts; both bindings read TS through domain=\"TS\", the dataset under evaluation). Dataset-sensitivity rule: pinned by the projected counts, never by row=. W6 phase 0, scenarios-first."
#library standard=sdtmig version=3-3
#expectViolationCount 1
#expectViolationAt "$trt_count"=1 "$randqt_count"=0
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
CDISCPILOT01 | TS | 1 | TRT | Investigational Therapy or Treatment | DRUG A
CDISCPILOT01 | TS | 2 | SPONSOR | Clinical Study Sponsor | ACME
