#!RuleTest
#test FDA-SE2308-A expect=skipped domain=PC
#note "THE §4 GATE PIN (top-level-or board wave 2, group J): neither VISITDY nor PCNOMDY is present, so Requirements.Variables.Any [VISITDY, PCNOMDY] is unmet and this sibling SKIPs naming the columns - the pre-split rule flooded on every row of exactly this dataset. If this EXECUTES, the gate has been removed - escalate, do not rewrite."
#library standard=sendig version=3-1
dataset PC class=FINDINGS label="Pharmacokinetics Concentrations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PCSEQ    type=Num  label="Sequence Number"
col PCELTM  type=Char label="Planned Elapsed Time from Time Point Ref"
---
S1 | PC | 001 | 1 | PT1H
