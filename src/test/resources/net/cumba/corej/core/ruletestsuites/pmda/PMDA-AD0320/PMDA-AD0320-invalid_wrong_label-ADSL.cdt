#!RuleTest
#test PMDA-AD0320 expect=violation domain=ADSL
#note "ds_label(\"DATA\") returns the submitted dataset label, which differs from the required literal, so the Dataset Metadata Check fires once for the dataset. Pin by dataset_name; dataset_label is not pinnable here because every value in play contains spaces."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt dataset_name=ADSL
dataset ADSL structure=ADSL label="Wrong Label"
col STUDYID type=Char
col USUBJID type=Char
col AGE     type=Num
