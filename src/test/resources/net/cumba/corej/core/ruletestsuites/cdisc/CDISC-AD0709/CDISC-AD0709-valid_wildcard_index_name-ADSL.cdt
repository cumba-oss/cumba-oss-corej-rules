#!RuleTest
#test CDISC-AD0709 expect=noViolation domain=ADSL
#note "CR709: the exception for variables whose names contain the indexes w, y or zz (PLAN-library-template-label-resolution, QH1 (a): kept; xx names are checked). The column is spelled CRITy - the template itself - and resolves to the Library's CRITy as a literal hit whose lower-case y marks it; var_name(\"LIBRARY\") !~ /[wyz]/ excludes it, and a template-spelled column has no label template anyway. Its dataset label differs on purpose. AGE is the positive control in the same dataset: an ordinary upper-case name whose labels agree, silent for the ordinary reason. Pins Fix #282 (ruling M2-D15)."
#library standard=adamig version=1-3
#library variable-metadata ADSL AGE name=AGE label="Age" simpleDatatype=Num
#library variable-metadata ADSL CRITy name=CRITy label="Analysis Criterion y"
#expectViolationCount 0
dataset ADSL
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col AGE type=Num label="Age"
col CRITy type=Char label="Wrong Label"
---
CDISCPILOT01 | 01-701-1015 | 56 | AGE-GT-60
---
