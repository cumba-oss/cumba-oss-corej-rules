#!RuleTest
#test PMDA-SD1041-A expect=skipped domain=TI
#note "DELIBERATELY NO IESCAT COLUMN. Requirements.Variables.All: [IESCAT] is unsatisfied, so the rule does not execute -> skipped. IESCAT is Permissible in SDTMIG 3.4 TI (IECAT is Required)."
#library standard=sdtmig version=3-4
#library dataset-class TI "TRIAL DESIGN"
dataset TI label="Trial Inclusion/Exclusion Criteria"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col IETESTCD type=Char label="Incl/Excl Criterion Short Name"
col IECAT    type=Char label="Inclusion/Exclusion Category"
col IETEST   type=Char label="Inclusion/Exclusion Criterion"
---
S1 | TI | INCL01 | INCLUSION | Subject is at least 18 years old
---
