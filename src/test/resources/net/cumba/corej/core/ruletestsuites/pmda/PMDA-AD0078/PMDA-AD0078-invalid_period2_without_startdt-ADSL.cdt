#!RuleTest
#test PMDA-AD0078 expect=violation domain=ADSL
#note "TRT01P is dropped by the rule's _wildcards xx.min=2 filter, TRT02P seeds xx=02, TR02SDT is synthesised absent -> ONE expansion, one violation at reported row 1. TRTSDT is present ON PURPOSE: it is the study-level date the sheet says is sufficient for a single period, and it must NOT satisfy this rule (it does not match TRxxSDT)."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 TRT02P=DRUGA
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRT01P  type=Char
col TRT02P  type=Char
col TRTSDT  type=Num
