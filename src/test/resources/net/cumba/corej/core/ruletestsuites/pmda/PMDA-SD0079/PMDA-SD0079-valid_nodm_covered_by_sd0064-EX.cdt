#!RuleTest
#test PMDA-SD0079 expect=noViolation domain=EX
#note "Subject 005 has an EX record but no DM record at all. The DEFAULT INNER Match_Datasets join drops the row before evaluation (user decision 2026-07-28): a subject missing from DM is PMDA-SD0064's finding ('USUBJID value not present in DM'), not this rule's."
#library standard=sdtmig version=3-4
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EPOCH   type=Char label="Epoch"
---
S1 | EX | 005 | 1 | DRUG A | TREATMENT
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
---
S1 | DM | 001 | ARM1 | Arm 1
---
