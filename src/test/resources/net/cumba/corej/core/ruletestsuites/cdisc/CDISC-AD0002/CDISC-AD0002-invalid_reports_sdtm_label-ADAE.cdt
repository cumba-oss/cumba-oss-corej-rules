#!RuleTest
#test CDISC-AD0002 expect=violation domain=ADAE
# Rule:Description: A variable is present in ADaM with the same name as a variable present in SDTM but the variables do not have identical labels
#note "The finding reports $sdtm_label as THIS variable's SDTM label (Sequence Number), the value the verdict compared. RED on the pre-port engine: it rendered the whole per-variable map, $sdtm_label=VariableMetadataResult[3 variables] (D-W4b-12). W4b (PLAN-scalar-metadata-functions)."
#expectViolationCount 1
#expectViolationAt variable_label="Sequence Number MODIFIED" variable_name=AESEQ "$sdtm_label"="Sequence Number"
dataset ADAE
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number MODIFIED"
---
CDISCPILOT01 | 01-701-1015 | 1
---

dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
---
CDISCPILOT01 | 01-701-1015 | 1
---
