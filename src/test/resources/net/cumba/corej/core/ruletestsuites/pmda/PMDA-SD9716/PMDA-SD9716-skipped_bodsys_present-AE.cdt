#!RuleTest
#test PMDA-SD9716 expect=skipped domain=AE
#note "The discriminator that keeps the pair from double-reporting: the AEBODSYS column EXISTS (blank on row 1), so Requirements.Variables.None [--BODSYS] skips this sister with a reason naming the column, and PMDA-SD1241 owns the case, reporting row 1 with its location. In the hoisted None form 'sister silent' is an auditable SKIP rather than a silent noViolation - that status change is the point of the canonical form."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col AESEQ    type=Num  label="Sequence Number"
col AETERM   type=Char label="Reported Term for the Adverse Event"
col AEBODSYS type=Char label="Body System or Organ Class"
col AEBDSYCD type=Num  label="Body System or Organ Class Code"
---
S1 | AE | 001 | 1 | HEADACHE |                          | 10029205
S1 | AE | 002 | 1 | NAUSEA   | GASTROINTESTINAL DISORDERS | 10017947
