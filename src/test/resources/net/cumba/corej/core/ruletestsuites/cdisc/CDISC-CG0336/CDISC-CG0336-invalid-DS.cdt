#!RuleTest
#test CDISC-CG0336 expect=violation domain=DS
# Rule:Description: Raise an error when --CAT is equal to the domain label, making the category value redundant with the domain name.
#note "DSCAT equals the DS domain label 'Disposition' (case-insensitive); Fix #371: the ds_label LIBRARY accessor reads it from the Library, so the DS label is supplied via dataset-metadata."
#library standard=sdtmig version=3-4
#library dataset-metadata DS label=Disposition
#expectViolationCount 1
#expectViolationAt row=1 DSSEQ=1 USUBJID=01-701-1015
dataset DS label=Disposition
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ type=Num label="Sequence Number"
col DSCAT type=Char label="Category for Disposition Event" format=$DSCAT.
---
CDISCPILOT01 | DS | 01-701-1015 | 1 | Disposition
CDISCPILOT01 | DS | 01-701-1015 | 2 | OTHER EVENT
---
