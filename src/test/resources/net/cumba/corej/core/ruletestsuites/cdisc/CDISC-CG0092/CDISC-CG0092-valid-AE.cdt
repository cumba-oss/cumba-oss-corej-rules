#!RuleTest
#test CDISC-CG0092 expect=noViolation domain=AE
# Rule:Description: Raise an error when the Time Point Reference (--TPTREF) variable is not present in the dataset while the Planned Elapsed Time from Time Point Ref (--ELTM) variable is present.
#note "AEELTM is present and AETPTREF is also present, so the rule does not fire"
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AEELTM type=Char label="Planned Elapsed Time from Time Point Ref"
col AETPTREF type=Char label="Time Point Reference"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | PT1H | DOSE 1
CDISCPILOT01 | AE | 01-701-1015 | 2 | PT2H | DOSE 1
CDISCPILOT01 | AE | 01-701-1023 | 1 | PT1H | DOSE 1
---
