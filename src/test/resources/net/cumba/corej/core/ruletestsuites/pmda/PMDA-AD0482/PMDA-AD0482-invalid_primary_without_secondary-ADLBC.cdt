#!RuleTest
#test PMDA-AD0482 expect=violation domain=ADLBC
#note "BCHGCAT1 populated but numeric secondary BCHGCA1N missing on row 1 -> fires. Row 2 both populated -> silent. Patterns ^BCHGCAT(\d+)$ and ^BCHGCA(\d+)N$ cannot cross-match, ONE expansion (y=1). structure=BDS inert (ruling-neutrality)."
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015 BCHGCAT1=IMPROVED
#library standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID    type=Char
col USUBJID    type=Char
col PARAMCD    type=Char
col BCHGCAT1   type=Char
col BCHGCA1N   type=Num
---
CDISCPILOT01 | 01-701-1015 | GLUC | IMPROVED |
CDISCPILOT01 | 01-701-1023 | GLUC | WORSENED | 2
---
