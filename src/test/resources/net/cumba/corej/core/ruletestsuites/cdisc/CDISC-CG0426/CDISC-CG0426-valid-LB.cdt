#!RuleTest
#test CDISC-CG0426 expect=noViolation domain=LB
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0426 (Class FND; Condition: --STRESU ^= null; Rule: --STRESC (in standard units) ^= null). Rows 1-2: LBSTRESU populated with LBSTRESC carrying the standardized result. Row 3: a categorical result with no unit (LBSTRESU null, Condition false). Row 4: test not done, both null -> silent."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBTEST   type=Char label="Lab Test or Examination Name"
col LBORRES  type=Char label="Result or Finding in Original Units"
col LBSTRESC type=Char label="Character Result/Finding in Std Format"
col LBSTRESU type=Char label="Standard Units"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | GLUC | Glucose | 101 | 5.6 | mmol/L
CDISCPILOT01 | LB | 01-701-1023 | 1 | GLUC | Glucose | 99 | 5.5 | mmol/L
CDISCPILOT01 | LB | 01-701-1023 | 2 | KETONES | Ketones | NEGATIVE | NEGATIVE |
CDISCPILOT01 | LB | 01-701-1028 | 1 | GLUC | Glucose | | |
