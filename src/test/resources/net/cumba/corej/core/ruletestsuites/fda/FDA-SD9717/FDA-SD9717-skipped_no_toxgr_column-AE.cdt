#!RuleTest
#test FDA-SD9717 expect=skipped domain=AE
#note "No AETOXGR column: Requirements.Variables.All [--TOXGR] gates the sister out. Without a grade there is nothing a toxicity name would qualify, so an absent AETOX says nothing here. Note --TOX itself is in None, not in the gate - gating on it would blind the sister to the case it exists for."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE
