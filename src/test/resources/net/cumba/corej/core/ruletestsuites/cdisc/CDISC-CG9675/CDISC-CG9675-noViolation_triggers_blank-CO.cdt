#!RuleTest
#test CDISC-CG9675 expect=noViolation domain=CO
#note "RDOMAIN is absent but so is any populated trigger: the IDVAR and IDVARVAL columns exist (satisfying the Any gate) and are blank on every row, so neither arm of the union holds and the sister is silent -- a study whose comments are all subject-level omits RDOMAIN legitimately. The sister fires only where a parent would have fired (R-4.11c)."
#library standard=sdtmig version=3-4
#expectViolationCount 0
dataset CO class="SPECIAL PURPOSE" label="Comments"
col STUDYID  type=Char label="Study Identifier"
col USUBJID  type=Char label="Unique Subject Identifier"
col COSEQ    type=Num  label="Sequence Number"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col COVAL    type=Char label="Comment"
---
S1 | 001 | 1 |  |  | General subject comment
S1 | 002 | 2 |  |  | Another general comment
