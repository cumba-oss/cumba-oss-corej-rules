#!RuleTest
#test PMDA-SD1044 expect=noViolation domain=XX
#note "XX is a custom Findings domain but carries XXBLFL (--BLFL present) -> no violation"
#library standard=sdtmig version=3-2
#library custom-domain XX
dataset XX class=FINDINGS label="Custom Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col XXSEQ    type=Num  label="Sequence Number"
col XXTESTCD type=Char label="Test Short Name"
col XXORRES  type=Char label="Result or Finding in Original Units"
col XXBLFL   type=Char label="Baseline Flag"
---
S1 | XX | 001 | 1 | TEST1 | 5 | Y
