#!RuleTest
#test PMDA-AD0693 expect=noViolation domain=ADMD
#note "Same subject, same parameter, same BASEC, but two DIFFERENT devices, so the two rows land in two singleton groups and nothing fires. Pins SPDEVID as a genuine key component - remove it from the key and this fixture would report a tie."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADMD
col STUDYID type=Char
col USUBJID type=Char
col SPDEVID type=Char
col PARAMCD type=Char
col BASE    type=Num
col BASEC   type=Char
---
CDISCPILOT01 | 01-701-1015 | DEV01 | GLUC | 1 | LOW
CDISCPILOT01 | 01-701-1015 | DEV02 | GLUC | 2 | LOW
