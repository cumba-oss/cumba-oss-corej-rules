#!RuleTest
#test CDISC-CG0664 expect=noViolation domain=CO
#note "CO is not in role order (RDOMAIN before USUBJID, COVAL after qualifiers): COGRPID (Identifier) after COSEQ, VISITNUM (Timing) before CODTC -> silent."
#library standard=sdtmig version=3-4
#library dataset-class CO Special-Purpose
#library model-column-order CO STUDYID DOMAIN RDOMAIN USUBJID POOLID SPDEVID COSEQ IDVAR IDVARVAL COREF COVAL COEVAL COEVALID CODTC CODY
#library domain-variables CO STUDYID:Identifier DOMAIN:Identifier "RDOMAIN:Record Qualifier" USUBJID:Identifier COSEQ:Identifier "IDVAR:Record Qualifier" "IDVARVAL:Record Qualifier" "COREF:Record Qualifier" COVAL:Topic "COEVAL:Record Qualifier" "COEVALID:Record Qualifier" CODTC:Timing CODY:Timing
