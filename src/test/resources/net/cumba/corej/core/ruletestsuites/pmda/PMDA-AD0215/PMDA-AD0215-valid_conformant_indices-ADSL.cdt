#!RuleTest
#test PMDA-AD0215 expect=noViolation domain=ADSL
#note "Every index is a single digit in [1-9], with and without the N twin -> the rule executes and stays silent."
#library standard=adamig version=1-0
#expectViolationCount 0
dataset ADSL
col STUDYID  type=Char
col USUBJID  type=Char
col RACEGR1  type=Char
col RACEGR1N type=Num
col RACEGR9  type=Char
col RACEGR9N type=Num
---
CDISCPILOT01 | 01-701-1015 | WHITE | 1 | ASIAN | 2
