#!RuleTest
#test CDISC-CG0172 expect=violation domain=SS
#note "W5 phase 0: a BLANK group key under the shipped default (keep_missings absent = KEEP_MISSING_KEYS for every key-building grouped evaluator, OperationExecutor.groupKeyPolicy). A DS row with an empty USUBJID forms its own group under the empty key, and the SS row with an empty USUBJID reads it: row 2 fires exactly as a named subject would. Row 1 is the named-subject control. Recorded as what stands (a drift guard for the KEEP default the port must carry, D-W5-6 / plan 16), not as a desirable data shape; keep_missings=false (the block dropped, row 2 quiet) is pinned in the engine's GroupedAggregateFunctionsTest because no shipped rule authors it. GREEN on the pre-port engine."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=A
#expectViolationAt row=2
dataset SS label="Subject Status"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SSSTRESC type=Char label="Character Result/Finding in Std Format"
col SSDTC type=Char label="Date/Time of Collection"
---
S1 | SS | A | DEAD | 2013-01-01
S1 | SS |   | DEAD | 2013-01-01
---

dataset DS label=Disposition
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ type=Num label="Sequence Number"
col DSSTDTC type=Char label="Start Date/Time of Disposition Event"
---
S1 | DS | A | 1 | 2014-01-14
S1 | DS |   | 1 | 2014-07-02
---
