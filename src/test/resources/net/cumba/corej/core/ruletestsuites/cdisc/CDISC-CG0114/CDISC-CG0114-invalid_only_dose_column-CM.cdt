#!RuleTest
#test CDISC-CG0114 expect=violation domain=CM
#note "Absent-column boundary (rule round 2026-10-12, var_exists sweep): CMDOSTXT and CMDOSTOT are not in the dataset. Their `not empty(X)` disjuncts are false on an absent column, so they add nothing and the removed var_exists guards were noise. Only row 2 (CMDOSE given, CMDOSU empty) fires."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 CMSEQ=2
dataset CM class=INTERVENTIONS label="Concomitant Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ   type=Num  label="Sequence Number"
col CMTRT   type=Char label="Reported Name of Drug, Med, or Therapy"
col CMDOSE  type=Num  label="Dose per Administration"
col CMDOSU  type=Char label="Dose Units"
---
S1 | CM | 001 | 1 | ASPIRIN   | 100 | mg
S1 | CM | 001 | 2 | IBUPROFEN | 400 |
S1 | CM | 001 | 3 | VITAMIN C |     |
