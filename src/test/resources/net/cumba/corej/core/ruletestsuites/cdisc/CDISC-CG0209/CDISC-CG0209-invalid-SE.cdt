#!RuleTest
#test CDISC-CG0209 expect=violation domain=SE
# Rule:Description: Raise an error when SEENDTC is not populated for an element that is not the subject's last element.
#note "ordered by SESTDTC, the earlier (non-last) element has an empty SEENDTC"
#expectViolationCount 1
#expectViolationAt row=1 SESEQ=1 USUBJID=01-701-1015
dataset SE label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ type=Num label="Sequence Number"
col SESTDTC type=Char label="Start Date/Time of Element"
col SEENDTC type=Char label="End Date/Time of Element"
---
CDISCPILOT01 | SE | 01-701-1015 | 1 | 2013-12-26 |
CDISCPILOT01 | SE | 01-701-1015 | 2 | 2014-01-02 | 2014-07-02
---
