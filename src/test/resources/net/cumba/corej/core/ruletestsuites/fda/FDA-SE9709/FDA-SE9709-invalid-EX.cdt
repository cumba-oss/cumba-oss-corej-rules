#!RuleTest
#test FDA-SE9709 expect=violation domain=EX
#note "Rule round 2026-10-12 (owner, batch D item 4a): EXSTDY is populated on rows 1 and 2 and the dataset carries no EXSTDTC -> ONE finding for the dataset, not one per record."
#library standard=sendig version=3-1-1
#expectViolationCount 1
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col EXSEQ    type=Num  label="Sequence Number"
col EXTRT type=Char label="Name of Treatment"
col EXSTDY type=Num label="Study Day of Start of Observation"
---
S1 | EX | 001 | 1 | DRUG A | 5
S1 | EX | 002 | 2 | DRUG A | 6
S1 | EX | 003 | 3 | DRUG A | 
