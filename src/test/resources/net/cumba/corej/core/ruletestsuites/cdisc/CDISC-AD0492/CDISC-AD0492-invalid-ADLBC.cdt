#!RuleTest
#test CDISC-AD0492 expect=violation domain=ADLBC
# Rule:Description: SHIFTy is present and all of the following variable pairs (BASECATy, AVALCATy), (BNRIND, ANRIND), (ByIND, AyIND), (BTOXGR, ATOXGR), (BTOXGRL, ATOXGRL), (BTOXGRH, ATOXGRH), (BASE, AVAL) and (BASEC, AVALC) are not present
#note "SHIFT1 present and none of the listed analysis/baseline pair variables present -> violation"
#expectViolationCount 1
#expectViolationAt nameOnly=SHIFT1
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col SHIFT1 type=Char
---
CDISCPILOT01 | 01-701-1015 | GLUC | NORMAL to HIGH
---
