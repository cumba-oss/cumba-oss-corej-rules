#!RuleTest
#test FDA-SD0031 expect=violation domain=AE
#note "AESTRF/AESTRTPT columns absent, so their bare empty() leaves are TRUE on every row (absent = all-missing, EC-43; Plan B phase 4d' deleted the redundant not var_exists disjuncts this note used to name). Row 1 fires via populated AEENDTC with empty AESTDTC; row 2 fires via populated AEENRTPT; row 3 has AESTDTC -> no fire."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 AESEQ=1
dataset AE class=EVENTS label="Adverse Events"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col AESEQ    type=Num  label="Sequence Number"
col AETERM   type=Char label="Reported Term for the Adverse Event"
col AESTDTC  type=Char label="Start Date/Time of Adverse Event"
col AEENDTC  type=Char label="End Date/Time of Adverse Event"
col AEENRTPT type=Char label="End Relative to Reference Time Point"
---
S1 | AE | 001 | 1 | HEADACHE |            | 2020-01-05 |
S1 | AE | 001 | 2 | NAUSEA   |            |            | ONGOING
S1 | AE | 001 | 3 | RASH     | 2020-01-01 | 2020-01-04 |
