#!RuleTest
#test FDA-SD1446 expect=executionError domain=EX
#expect-execution-error "group= over 'DS' has no usable key"
#note "PLAN-join-key-one-side-absent-drop QK16 (b) / QK18 (owner 2026-10-11): DS without USUBJID - the domain= call's only group= member is on the evaluated side only, so no key member is left on both sides and the rule ERRORs (never an aggregate over the whole of DS). Derived from FDA-SD1446-invalid-EX.cdt with DS.USUBJID removed. A gate declaring DS.USUBJID would turn this into a SKIP."
#library standard=sdtmig version=3-4
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
---
S1 | EX | 001 | 1 | DRUG A | 2020-06-15
S1 | EX | 002 | 1 | DRUG A | 2020-02-01
---

dataset DS class=EVENTS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col DSSEQ   type=Num  label="Sequence Number"
col DSTERM  type=Char label="Reported Term for the Disposition Event"
col DSDECOD type=Char label="Standardized Disposition Term"
col DSSTDTC type=Char label="Start Date/Time of Disposition"
---
S1 | DS | 1 | RANDOMIZED | RANDOMIZED | 2020-04-01
S1 | DS | 2 | COMPLETED  | COMPLETED  | 2020-05-30
S1 | DS | 1 | COMPLETED  | COMPLETED  | 2020-03-01

