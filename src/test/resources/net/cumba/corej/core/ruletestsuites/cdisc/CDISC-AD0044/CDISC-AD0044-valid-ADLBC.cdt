#!RuleTest
#test CDISC-AD0044 expect=noViolation domain=ADLBC
# Rule:Description: A variable with a suffix of TM and a variable with a suffix of DTM with the same root name have different time values
#note "ATM=09:30:00 matches ADTM time part 09:30:00 -> noViolation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ATM type=Char
col ADTM type=Char
---
CDISCPILOT01 | 01-701-1015 | ALB | 09:30:00 | 2012-01-01T09:30:00
---
