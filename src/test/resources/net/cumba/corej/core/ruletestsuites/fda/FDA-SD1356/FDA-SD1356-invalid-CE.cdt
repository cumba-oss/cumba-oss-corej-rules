#!RuleTest
#test FDA-SD1356 expect=violation domain=CE
#note "RELMIDS is used (present as a column) in CE but the study has no TM dataset -> one dataset-level finding."
#library standard=sdtmig version=3-4
#expectViolationCount 1
dataset CE class=EVENTS label="Clinical Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CESEQ   type=Num  label="Sequence Number"
col CETERM  type=Char label="Reported Term for the Clinical Event"
col RELMIDS type=Char label="Temporal Relation to Milestone Instance"
---
S1 | CE | 001 | 1 | HYPOGLYCEMIC EVENT | IMMEDIATELY BEFORE
