#!RuleTest
#test CDISC-CG0138 expect=noViolation domain=SUPPAE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0138 (Condition: Population flags included in submission; Rule: Population flags in SUPPDM). SUPPAE carries only AE-level qualifiers (AETRTEM, AESOSP); no population flag is placed outside SUPPDM -> silent."
#library standard=sdtmig version=3-2
dataset SUPPAE class=RELATIONSHIP label="Supplemental Qualifiers for AE"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM     type=Char label="Qualifier Variable Name"
col QLABEL   type=Char label="Qualifier Variable Label"
col QVAL     type=Char label="Data Value"
---
CDISCPILOT01 | AE | 01-701-1015 | AESEQ | 1 | AETRTEM | Treatment Emergent Flag | Y
CDISCPILOT01 | AE | 01-701-1023 | AESEQ | 1 | AESOSP | Other Medically Important SAE | SEIZURE
