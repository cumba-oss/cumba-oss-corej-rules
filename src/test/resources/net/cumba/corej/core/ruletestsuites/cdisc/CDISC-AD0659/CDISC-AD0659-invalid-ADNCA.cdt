#expectViolationAt row=1 USUBJID=01-701-1015
dataset ADNCA
col STUDYID type=Char
col USUBJID type=Char
col PKSUMXFN type=Char
col PARAMCD type=Char
col NFRLT type=Num
col AFRLT type=Num
---
CDISCPILOT01 | 01-701-1015 | 2 | CONC | 0 | 0.5
---
