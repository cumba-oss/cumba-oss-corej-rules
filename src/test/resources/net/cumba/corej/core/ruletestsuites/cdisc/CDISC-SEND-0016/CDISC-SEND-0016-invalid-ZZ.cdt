#!RuleTest
#test CDISC-SEND-0016 expect=violation domain=ZZ
#note "DOMAIN=ZZ is not a custom domain (domain_is_custom false) and ZZ is not a term of the SEND Domain Abbreviation codelist (codelist_terms of SDOMAIN: BW, DM) -> fires. W4 (PLAN-list-functions phase 0, scenarios-first on the pre-port engine)."
#library standard=sendig version=3-1-1
#library codelist-terms SDOMAIN BW DM
#expectViolationCount 1
#expectViolationAt row=1 DOMAIN=ZZ
dataset ZZ label="Sponsor dataset"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
S1 | ZZ | 001
