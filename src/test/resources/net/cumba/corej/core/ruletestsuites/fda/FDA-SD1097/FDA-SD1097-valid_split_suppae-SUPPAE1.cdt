#!RuleTest
#test FDA-SD1097 expect=noViolation domain=SUPPAE1
#note "PLAN-split-supp-resolution (Q1, D7): the primary is one MEMBER of a split SUPPAE family (SUPPAE1 + SUPPAE2, RDOMAIN=AE, no SUPPAE) -- Scope.Domains: [SUPPAE] matches it through its RDOMAIN-derived base, and the rule runs per member. record_count(domain=\"SUPPAE\") counts over the FAMILY: the treatment-emergent flag lives in SUPPAE2 only, the count is 1 -> no violation on SUPPAE1. Red on the pre-plan engine: SUPPAE resolved to nothing, count 0, fired."
#library standard=sdtmig version=3-4
#expectViolationCount 0
dataset SUPPAE1 label="Supplemental Qualifiers for AE (part 1)"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM     type=Char label="Qualifier Variable Name"
col QLABEL   type=Char label="Qualifier Variable Label"
col QVAL     type=Char label="Data Value"
---
S1 | AE | 001 | AESEQ | 1 | AESOSP  | Other Medically Important SAE | N
---

dataset SUPPAE2 label="Supplemental Qualifiers for AE (part 2)"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM     type=Char label="Qualifier Variable Name"
col QLABEL   type=Char label="Qualifier Variable Label"
col QVAL     type=Char label="Data Value"
---
S1 | AE | 002 | AESEQ | 1 | AETRTEM | Treatment Emergent Flag       | Y
---
