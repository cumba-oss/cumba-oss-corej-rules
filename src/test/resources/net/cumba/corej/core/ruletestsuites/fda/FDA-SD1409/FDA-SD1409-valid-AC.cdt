#!RuleTest
#test FDA-SD1409 expect=noViolation domain=AC
#note "AC contains a MCCATIND (Multiple Challenge Agent Category Ind) record, so the required Challenge Agent parameter is present -> no violation."
#library standard=sendig version=ar-1-0
dataset AC label="Challenge Agent Characterization"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col ACSEQ    type=Num  label="Sequence Number"
col ACPARMCD type=Char label="Challenge Agent Parameter Short Name"
col ACPARM   type=Char label="Challenge Agent Parameter"
col ACVAL    type=Char label="Challenge Agent Parameter Value"
---
S1 | AC | 1 | BACAT | Biological Agent Category | BACTERIA
S1 | AC | 2 | MCCATIND | Multiple Challenge Agent Category Ind | N
