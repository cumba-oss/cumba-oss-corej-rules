#!RuleTest
#test FDA-SD1393 expect=noViolation domain=MB
#note "Guard boundaries, all clean: row 1 fully conformant; row 2 MBDTC incomplete (year-month) so a missing MBXDY is tolerated; row 3 subject 002 whose DM.RFXSTDTC is incomplete; row 4 subject 003 has no DM record (inner join drops the row); row 5 MBDTC empty."
#library standard=sendig version=ar-1-0
dataset MB class=FINDINGS label="Microbiology Specimen"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col MBSEQ    type=Num  label="Sequence Number"
col MBTESTCD type=Char label="Microbiology Test or Finding Short Name"
col MBDTC    type=Char label="Date/Time of Collection"
col MBXDY    type=Num  label="Day of Obs Relative to Exposure"
---
S1 | MB | 001 | 1 | AEROBIC | 2020-01-10 | 6
S1 | MB | 001 | 2 | AEROBIC | 2020-01    | .
S1 | MB | 002 | 1 | AEROBIC | 2020-01-10 | .
S1 | MB | 003 | 1 | AEROBIC | 2020-01-10 | .
S1 | MB | 001 | 3 | AEROBIC |            | .
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFXSTDTC type=Char label="Date/Time of First Study Treatment"
---
S1 | DM | 001 | 2020-01-05
S1 | DM | 002 | 2020-01
---
