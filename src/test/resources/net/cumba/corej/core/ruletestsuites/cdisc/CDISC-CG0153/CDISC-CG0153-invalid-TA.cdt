#!RuleTest
#test CDISC-CG0153 expect=violation domain=TA
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0153 (Rule: ARMCD value length <= 20); the rule applies to DM and TA). Row 2's ARMCD 'XANOMELINE_HIGH_DOSE_81' is 23 characters -> fires. Row 1's ARMCD 'PBO' is within the limit and stays silent."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 ARMCD=XANOMELINE_HIGH_DOSE_81
dataset TA class="TRIAL DESIGN" label="Trial Arms"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
col TAETORD type=Num  label="Planned Order of Element within Arm"
col ETCD    type=Char label="Element Code"
col ELEMENT type=Char label="Description of Element"
col EPOCH   type=Char label="Epoch"
---
CDISCPILOT01 | TA | PBO | Placebo | 1 | SCRN | Screening | SCREENING
CDISCPILOT01 | TA | XANOMELINE_HIGH_DOSE_81 | Xanomeline High Dose | 1 | SCRN | Screening | SCREENING
---
