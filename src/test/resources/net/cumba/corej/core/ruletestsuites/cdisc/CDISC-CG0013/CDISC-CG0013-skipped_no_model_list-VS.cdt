#!RuleTest
#test CDISC-CG0013 expect=skipped domain=VS
#note "Library-dependency boundary (round 2026-10-02 c close): the IG list is served but the MODEL list is not, so get_model_column_order maps the absent answer to LIBRARY_NOT_AVAILABLE and the rule SKIPS. The IG list alone never decides: an absent model list must not turn every column not in the IG list into a finding. Discriminating: VSCUSTOM is in neither list and would be reported if a model list were served (see the invalid scenario)."
#library standard=sdtmig version=3-3
#library domain-variables VS STUDYID:Identifier DOMAIN:Identifier USUBJID:Identifier VSSEQ:Identifier VSTESTCD:Topic "VSTEST:Synonym Qualifier" "VSORRES:Result Qualifier" "VSCSTATE:Record Qualifier"
dataset VS label="Vital Signs"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VSSEQ    type=Num  label="Sequence Number"
col VSTESTCD type=Char label="Vital Signs Test Short Name"
col VSTEST   type=Char label="Vital Signs Test Name"
col VSORRES  type=Char label="Result or Finding in Original Units"
col VSCSTATE type=Char label="Consciousness State"
col VSCUSTOM type=Char label="Sponsor Defined Variable"
---
CDISCPILOT01 | VS | 01-701-1015 | 1 | SYSBP | Systolic Blood Pressure | 120 | CONSCIOUS | X
---
