#!RuleTest
#test PMDA-SD1475 expect=noViolation domain=LB
#note "Pins the absent-label corner: a missing label folds to length 0, and 0 > 40 is false, so an unlabelled variable must not be reported by a MAXIMUM-length rule."
#library standard=sdtmig version=3-4
dataset LB
col STUDYID type=Char label="Study Identifier"
col NOLABEL type=Char
