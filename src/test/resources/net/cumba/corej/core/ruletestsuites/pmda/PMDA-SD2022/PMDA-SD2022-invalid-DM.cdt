#!RuleTest
#test PMDA-SD2022 expect=violation domain=DM
#note "Row 1 has AGE populated with AGEU empty; row 2 exercises the AGETXT branch (AGE missing, AGETXT populated, AGEU empty) -> both fire. Row 3 is conformant."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=001 AGEU=
#expectViolationAt row=2 USUBJID=002 AGEU=
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AGE     type=Num  label="Age"
col AGETXT  type=Char label="Age Range"
col AGEU    type=Char label="Age Units"
---
S1 | DM | 001 | 45 |       |
S1 | DM | 002 | .  | 18-65 |
S1 | DM | 003 | 52 |       | YEARS
