#!RuleTest
#test FDA-SD9727 expect=noViolation domain=AE
#note "The discriminator that keeps the family from double-reporting: the USUBJID column EXISTS (blank on every row), so not var_exists(\"USUBJID\") is false and this sister is silent -- blank values in a present column are the PARENT's case, and FDA-SD1380 reports each such row with its location (its Any gate is satisfied by the same present column)."
#library standard=sdtmig version=3-4
#expectViolationCount 0
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
---
S1 | AE |  | 1 | Headache
S1 | AE |  | 2 | Nausea
