#!RuleTest
#test PMDA-AD0400 expect=noViolation domain=ADLBC
#note "Every ATOXGRH blank: DROP_MISSING_KEYS discards every row from the partition, and not empty(ATOXGRH) is independently false on every row -> silent (double-covered). The identical ATOXGRHN sequence fires when ATOXGRH is GRADE3 (see the violation fixture)."
#library standard=adamig version=1-3
dataset ADLBC
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col ATOXGRH  type=Char
col ATOXGRHN type=Num
---
CDISCPILOT01 | 01-701-1015 | GLUC |  | 3
CDISCPILOT01 | 01-701-1023 | GLUC |  | 3
CDISCPILOT01 | 01-701-1034 | GLUC |  | 4
