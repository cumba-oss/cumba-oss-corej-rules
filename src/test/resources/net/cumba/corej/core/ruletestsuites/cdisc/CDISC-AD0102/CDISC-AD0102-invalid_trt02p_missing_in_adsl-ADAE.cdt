#!RuleTest
#test CDISC-AD0102 expect=violation domain=ADAE
#note "PLAN-engine-fixture-join-key-drift: ported from cumba-corej CdiscAd0102To0707IntegrationTest.cdiscAd0102_columnMissing_fires. ADSL carries TRT01P only, so the APERIOD=2 row has no ADSL.TRT02P -> fires on row 2; the APERIOD=1 row finds TRT01P."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=S1
dataset ADAE
col STUDYID type=Char
col USUBJID type=Char
col APERIOD type=Num
col AETERM  type=Char
---
STUDY1 | S1 | 1 | AE1
STUDY1 | S1 | 2 | AE1
---

dataset ADSL label="Subject-Level Analysis"
col STUDYID type=Char
col USUBJID type=Char
col TRT01P  type=Char
---
STUDY1 | S1 | Drug A
---
