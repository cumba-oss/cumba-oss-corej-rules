#!RuleTest
#test CDISC-SEND-0288 expect=noViolation domain=TS
#note "Every record populates exactly one of TSVAL / TSVALNF - the conformant state the sheet describes. Also the discriminator against the sibling: CDISC-SEND-0288-A must be silent on this same dataset."
#library standard=sendig version=3-1-1
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL    type=Char label="Parameter Value"
col TSVALNF  type=Char label="Parameter Value Null Flavor"
---
S1 | TS | 1 | SPECIES | RAT    |
S1 | TS | 2 | STSTDTC |        | NA
