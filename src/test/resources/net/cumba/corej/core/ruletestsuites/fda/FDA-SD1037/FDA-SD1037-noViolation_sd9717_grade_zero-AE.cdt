#!RuleTest
#test FDA-SD1037 expect=noViolation domain=AE
#note "AETOX is absent and AETOXGR exists, so the sister RUNS - but every grade is 0, which the regex /[1-9]/ deliberately does not match. R-4.11c containment, recorded as a correction in absent-column-exceptions.tsv: [0-9] would fire on this dataset where the parent (--TOXGR > 0) never does - a trigger broader than its parent's, the exact violation the doctrine exists to prevent."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AETOXGR type=Char label="Standard Toxicity Grade"
---
S1 | AE | 001 | 1 | HEADACHE | 0
S1 | AE | 002 | 1 | NAUSEA   | 0
