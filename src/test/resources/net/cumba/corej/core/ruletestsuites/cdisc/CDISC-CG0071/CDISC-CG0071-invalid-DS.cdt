#!RuleTest
#test CDISC-CG0071 expect=violation domain=DS
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0071 (Condition: DSCAT = 'DISPOSITION EVENT'; Rule: DSTERM = 'COMPLETED' or the reason for discontinuation). Row 2 is a DISPOSITION EVENT whose DSTERM is null, so it is neither COMPLETED nor a reason -> fires. Row 1 is a disposition event with DSTERM=COMPLETED and row 3 a PROTOCOL MILESTONE (Condition false) -> silent. DSTERM is populated on rows 1 and 3, so the dataset is not the all-empty folded case."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1023 DSSEQ=2
dataset DS class=EVENTS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSTERM  type=Char label="Reported Term for the Disposition Event"
col DSDECOD type=Char label="Standardized Disposition Term"
col DSCAT   type=Char label="Category for Disposition Event"
col EPOCH   type=Char label="Epoch"
---
CDISCPILOT01 | DS | 01-701-1015 | 2 | COMPLETED | COMPLETED | DISPOSITION EVENT | TREATMENT
CDISCPILOT01 | DS | 01-701-1023 | 2 | | ADVERSE EVENT | DISPOSITION EVENT | TREATMENT
CDISCPILOT01 | DS | 01-701-1023 | 1 | INFORMED CONSENT OBTAINED | INFORMED CONSENT OBTAINED | PROTOCOL MILESTONE | SCREENING
