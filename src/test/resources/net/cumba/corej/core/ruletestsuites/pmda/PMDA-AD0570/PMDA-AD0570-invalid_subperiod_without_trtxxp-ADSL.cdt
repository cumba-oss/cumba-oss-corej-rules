#!RuleTest
#test PMDA-AD0570 expect=violation domain=ADSL
#note "P01S1 seeds the tuple {xx=01, w=1}; TRT01P resolves absent. var_exists-only Check is folded to dataset level by BroadcastFold, so exactly ONE violation at internal row 0 = reported row 1, independent of the two data rows."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 nameOnly=P01S1
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col P01S1   type=Char
---
CDISCPILOT01 | 01-701-1015 | SP1
CDISCPILOT01 | 01-701-1023 | SP1
