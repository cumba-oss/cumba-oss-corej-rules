#!RuleTest
#test PMDA-SD1332 expect=noViolation domain=AE
#note "Row 1: unresolved event, no end date - conformant. Row 2: resolved event may carry an end date. Isolates both conjuncts in one fixture."
#library standard=sdtmig version=3-4
dataset AE label="Adverse Events"
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col AESEQ   type=Num
col AEOUT   type=Char
col AESTDTC type=Char
col AEENDTC type=Char
