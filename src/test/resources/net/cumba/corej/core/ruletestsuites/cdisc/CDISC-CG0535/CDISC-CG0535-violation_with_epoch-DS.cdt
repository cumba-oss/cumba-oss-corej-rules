#!RuleTest
#test CDISC-CG0535 expect=violation domain=DS
#note "The rule's PRIMARY sheet shape (EPOCH present), tested only on the retired CORE-family twin, never on this rule id before. DSSCAT is NOT declared. The (DSCAT, USUBJID, EPOCH) tuple of rows 1-2 is duplicated, DSCAT matches, DSSCAT is absent -- rows 1-2 fire; authored Sensitivity=Dataset collapses to ONE finding at row 1."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015 EPOCH=TREATMENT
dataset DS label="Disposition"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col DSSEQ    type=Num  label="Sequence Number"
col DSCAT    type=Char label="Category for Disposition Event"
col EPOCH    type=Char label="Epoch"
---
CDISCPILOT01 | DS | 01-701-1015 | 1 | DISPOSITION EVENT | TREATMENT
CDISCPILOT01 | DS | 01-701-1015 | 2 | DISPOSITION EVENT | TREATMENT
CDISCPILOT01 | DS | 01-701-1023 | 3 | DISPOSITION EVENT | SCREENING
---
