#!RuleTest
#test CDISC-CG0059 expect=noViolation domain=AE
# Rule:Description: Raise an error when Start Reference Time Point (--STTPT) is populated but Start Relative to Reference Time Point (--STRTPT) is not populated.
#note "AESTTPT is populated and AESTRTPT is also populated"
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AESTTPT type=Char label="Start Reference Time Point"
col AESTRTPT type=Char label="Start Relative to Reference Time Point"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | VISIT 1 | BEFORE
CDISCPILOT01 | AE | 01-701-1015 | 2 |  | 
---
