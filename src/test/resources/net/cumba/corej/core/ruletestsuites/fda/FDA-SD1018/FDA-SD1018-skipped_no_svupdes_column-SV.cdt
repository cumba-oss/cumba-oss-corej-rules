#!RuleTest
#test FDA-SD1018 expect=skipped domain=SV
#note "GATED 2026-09-11 (wave D, T1-40): the rule gains Requirements.Variables.All [SVUPDES], so a dataset with no SVUPDES column takes one auditable skip naming the column -- before the gate the bare empty(SVUPDES) leaf was TRUE on every row (absent = all-missing, EC-43), every visit counted as planned, and row 2's unmatched triple fired. The check is NOT lost on this shape: the R-5.25 split sibling FDA-SD1018-A re-derives planned-ness from the VISIT name and reports row 2 (WEEK 2 is planned-looking) on this same data."
#library standard=sdtmig version=3-4
dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col VISITDY  type=Num  label="Planned Study Day of Visit"
---
CDISCPILOT01 | SV | 01-701-1015 | 1 | SCREENING | -7
CDISCPILOT01 | SV | 01-701-1015 | 3 | WEEK 2    | 15
---

dataset TV label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col VISITDY  type=Num  label="Planned Study Day of Visit"
---
CDISCPILOT01 | TV | 1 | SCREENING | -7
CDISCPILOT01 | TV | 2 | BASELINE  | 1
