#!RuleTest
#test CDISC-CG0031-B expect=noViolation domain=LB
#note "⭐ THE MUTUAL-EXCLUSION PIN. An SV dataset EXISTS, so `not ds_exists("SV")` is false and this rule must stay silent on every row -- including WEEK 99, which its own SV-absent scenario fires on. ⛔ If this ever reports a violation the split has collapsed and the parent and this sibling are both firing on the same study."
#library standard=sdtmig version=3-2
#expectViolationCount 0
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB | 2  | BASELINE
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALB | 99 | WEEK 99
CDISCPILOT01 | LB | 01-701-1015 | 3 | ALB | 3  | UNSCHEDULED 3
---

dataset TV label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | TV | 1 | SCREENING
CDISCPILOT01 | TV | 2 | BASELINE
---

dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | SV | 01-701-1015 | 2 | BASELINE
---
