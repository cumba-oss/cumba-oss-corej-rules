#!RuleTest
#test CDISC-CG0390 expect=noViolation domain=AE
# Rule:Description: Raise an error when AESDISAB is populated and its value is not 'Y' or 'N'.
#note "AESDISAB is either populated with a valid (Y, N) value or left empty"
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AESDISAB type=Char label="Persist or Signif Disability/Incapacity" format=$YN.
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | Y
CDISCPILOT01 | AE | 01-701-1015 | 2 | N
CDISCPILOT01 | AE | 01-701-1023 | 1 |
---
