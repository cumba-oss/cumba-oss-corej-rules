#!RuleTest
#test FDA-SE2264 expect=violation domain=LB
#note "Row 1 has RPHASE empty while the actual Repro Phase day LBRPDY (--RPDY) is populated -> fires. Row 2 has RPHASE empty while the planned day RPPLDY is populated -> fires. Row 3 carries RPHASE with its timing values; row 4 has neither RPHASE nor any timing value -> neither fires."
#library standard=sendig-dart version=1-1
#expectViolationCount 1
#expectViolationAt row=1
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col RPHASE   type=Char label="Repro Phase"
col RPPLDY   type=Num  label="Planned Repro Phase Day of Observation"
col LBRPDY   type=Num  label="Actual Repro Phase Day of Observation"
---
S1 | LB | 001 | 1 | ALB  |           |   | 5
S1 | LB | 001 | 2 | GLUC |           | 3 |
S1 | LB | 001 | 3 | ALB  | GESTATION | 7 | 7
S1 | LB | 001 | 4 | CHOL |           |   |
