#!RuleTest
#test PMDA-SD0058-B expect=violation domain=DM
#note "DM Assumption 8 lists the only Timing variables permitted in DM (VISITNUM, VISIT, VISITDY). EPOCH is not among them, so it is reported, unlike in SV where the IG permits it."
#library standard=sdtmig version=3-4
#library model-column-order DM STUDYID DOMAIN USUBJID SUBJID RFSTDTC SITEID AGE SEX ARMCD ARM COUNTRY
#expectViolationCount 1
#expectViolationAt variable_name=EPOCH
dataset DM
col STUDYID type=Char
col DOMAIN type=Char
col USUBJID type=Char
col SUBJID type=Char
col SITEID type=Char
col VISITNUM type=Num
col EPOCH type=Char
---
S1 | DM | 001 | 001 | 01 | 1 | SCREENING
---
