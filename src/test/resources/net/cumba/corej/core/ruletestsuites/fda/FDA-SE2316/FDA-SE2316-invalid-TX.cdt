#!RuleTest
#test FDA-SE2316 expect=violation domain=TX
#note "No TXPARMCD=TCNTRL record in any trial set -> one dataset-level finding. The near-miss parameters TRTCAS / TRTV / ARMCD are present, so a loose match on the filter would wrongly silence the rule."
#library standard=sendig version=3-1-1
#expectViolationCount 1
dataset TX class="TRIAL DESIGN" label="Trial Sets"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col SETCD    type=Char label="Set Code"
col SET      type=Char label="Set Description"
col TXSEQ    type=Num  label="Sequence Number"
col TXPARMCD type=Char label="Trial Set Parameter Short Name"
col TXPARM   type=Char label="Trial Set Parameter"
col TXVAL    type=Char label="Trial Set Parameter Value"
---
S01 | TX | SET01 | Control   | 1 | TRTV   | Drug Vehicle     | SALINE
S01 | TX | SET01 | Control   | 2 | ARMCD  | Planned Arm Code | CTRL
S01 | TX | SET02 | High Dose | 3 | TRTCAS | CAS Registry Number | 50-78-2
S01 | TX | SET02 | High Dose | 4 | GRPLBL | Group Label      | High Dose
