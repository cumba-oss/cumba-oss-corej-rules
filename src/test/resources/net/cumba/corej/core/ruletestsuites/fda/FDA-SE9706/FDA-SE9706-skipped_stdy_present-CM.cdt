#!RuleTest
#test FDA-SE9706 expect=skipped domain=CM
#note "Boundary with the --STDY presence rule: CMSTDY is present (and CMSTDTC absent) -> the companion SKIPS on None [--STDY]; FDA-SD2271 reports the absent CMSTDTC instead, so the dataset is reported once."
#library standard=sendig version=ar-1-0
dataset CM class=INTERVENTIONS label="Concomitant/Prior Medications"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col CMSEQ    type=Num  label="Sequence Number"
col CMTRT type=Char label="Reported Name of Drug, Med, or Therapy"
col CMCHSTDY type=Num label="Start Day of Obs Rel to Challenge Agent"
col CMXSTDY type=Num label="Start Day of Obs Rel to Exposure"
col CMSTDY type=Num label="Study Day of Start of Observation"
---
S1 | CM | 001 | 1 | SALINE | 5 |  | 5
S1 | CM | 002 | 2 | SALINE | 6 |  | 6
S1 | CM | 003 | 3 | SALINE |  |  | 
