#!RuleTest
#test FDA-SD1241 expect=skipped domain=AE
#note "AEBODSYS column absent while AEBDSYCD is populated. Requirements.Variables.All [--BDSYCD, --BODSYS] gates the rule out -> auditable skip instead of one finding per row under absent = all-missing (EC-43). Row 1 WOULD fire were the gate removed. Verdict 2-1 (T1-01): the absence is itself reportable, and the minted sister FDA-SD9716 reports it ONCE for this dataset."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col AESEQ    type=Num  label="Sequence Number"
col AETERM   type=Char label="Reported Term for the Adverse Event"
col AEDECOD  type=Char label="Dictionary-Derived Term"
col AEBDSYCD type=Num  label="Body System or Organ Class Code"
---
S1 | AE | 001 | 1 | HEADACHE | HEADACHE | 10029205
