#!RuleTest
#test CDISC-AD0132 expect=noViolation domain=ADLBC
# Rule:Description: R2BASE is not equal to AVAL divided by BASE
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL type=Num label="Analysis Value"
col BASE type=Num label="Baseline Value"
col R2BASE type=Num label="Ratio to Baseline"
