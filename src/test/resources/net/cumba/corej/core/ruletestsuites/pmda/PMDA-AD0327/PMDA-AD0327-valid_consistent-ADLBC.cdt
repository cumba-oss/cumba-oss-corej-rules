#!RuleTest
#test PMDA-AD0327 expect=noViolation domain=ADLBC
#note "Each (PARAMCD, AVALCA1N) group holds one distinct AVALCAT1 -- the numeric code is exactly what separates LOW from HIGH. Deliberate contrast to invalid_degraded_key_no_avalcayn: SAME three rows, minus one column."
#library standard=adamig version=1-3
dataset ADLBC class=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVALCAT1 type=Char
col AVALCA1N type=Num
---
S1 | 001 | ALB | LOW  | 1
S1 | 002 | ALB | LOW  | 1
S1 | 003 | ALB | HIGH | 2
