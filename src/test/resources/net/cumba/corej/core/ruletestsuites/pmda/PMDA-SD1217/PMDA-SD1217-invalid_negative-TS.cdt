#!RuleTest
#test PMDA-SD1217 expect=violation domain=TS
#note "FRESH. Row 1: '-P18Y' FIRES. Row 2: 'P18Y' silent. Carries the negative=false pin across to the AGEMIN member: the kwarg is authored identically on all six TS rules in this batch but only the AGEMAX twin (FDA-SD1215) has a fixture for it, so on AGEMIN and LENGTH the deciding branch was unpinned. No class= (the twins declare none and Scope carries no Classes axis)."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 TSPARMCD=AGEMIN TSVAL=-P18Y
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
CDISCPILOT01 | TS | 1 | AGEMIN | Planned Minimum Age of Subjects | -P18Y
CDISCPILOT01 | TS | 2 | AGEMIN | Planned Minimum Age of Subjects | P18Y
