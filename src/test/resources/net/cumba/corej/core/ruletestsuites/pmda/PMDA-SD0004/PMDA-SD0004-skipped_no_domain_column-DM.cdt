#!RuleTest
#test PMDA-SD0004 expect=skipped domain=DM
#note "Pins Requirements.Variables.All: [DOMAIN]: with no DOMAIN column there is no declared domain value that could disagree with the name, so the rule reports an auditable SKIPPED naming the absent variable. DM is chosen because it appears in no Exclude entry, so the skip is attributable to the Variables gate alone."
#library standard=sdtmig version=3-4
dataset DM label=Demographics
col STUDYID type=Char
col USUBJID type=Char
col AGE     type=Num
col SEX     type=Char
---
