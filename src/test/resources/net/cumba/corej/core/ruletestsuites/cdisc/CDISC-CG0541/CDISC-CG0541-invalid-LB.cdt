#!RuleTest
#test CDISC-CG0541 expect=violation domain=LB
# Rule:Description: Raise an error when the Last Observation Before Exposure Flag (--LOBXFL) is populated and its value is not equal to 'Y'.
#note "LBLOBXFL is populated with N (not Y and not null), so the rule fires"
#expectViolationCount 1
#expectViolationAt row=1 LBSEQ=1 USUBJID=01-701-1015
dataset LB label="Laboratory Tests Results"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col LBSEQ type=Num label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBLOBXFL type=Char label="Last Observation Before Exposure Flag"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB | N
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALP | Y
---
