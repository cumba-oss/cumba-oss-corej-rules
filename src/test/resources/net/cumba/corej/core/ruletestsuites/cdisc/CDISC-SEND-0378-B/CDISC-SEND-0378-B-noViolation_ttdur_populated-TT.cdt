#!RuleTest
#test CDISC-SEND-0378-B expect=noViolation domain=TT
#note "TTENRL is not present in the dataset, but TTDUR is populated on every record - each Repro Stage carries an end rule or a planned duration through the one column it has, so the sibling stays silent."
#library standard=sendig-dart version=1-2
dataset TT class="TRIAL DESIGN" label="Trial Repro Stages"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col RSTGCD  type=Char label="Repro Stage Code"
col RSTAGE  type=Char label="Description of Repro Stage"
col TTDUR   type=Char label="Planned Duration of Repro Stage"
---
S1 | TT | ST1 | Premating | P14D
S1 | TT | ST2 | Gestation | P21D
