#!RuleTest
#test FDA-SD1098 expect=violation domain=EX
#note "INTERVENTIONS branch of the class scope: EXSCAT populated but EXCAT empty -> fires."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 EXSCAT=INFUSION
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Actual Treatment"
col EXCAT   type=Char label="Category of Treatment"
col EXSCAT  type=Char label="Subcategory of Treatment"
---
S1 | EX | 001 | 1 | DRUG A |  | INFUSION
