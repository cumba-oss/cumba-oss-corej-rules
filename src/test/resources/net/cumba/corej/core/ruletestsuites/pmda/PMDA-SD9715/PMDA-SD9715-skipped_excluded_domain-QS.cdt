#!RuleTest
#test PMDA-SD9715 expect=skipped domain=QS
#note "PMDA-only facet, inherited from the parent's sheet cell 'FINDINGS (-IE, -QS, -SC, -SS), FINDINGS ABOUT': QS is a FINDINGS member, so ONLY the Exclude entry rejects. Numeric scores with no QSSTRESU column would otherwise fire exactly as they do for the CDISC sister CDISC-CG9672-violation_scores-QS. The exclusion list is deliberately kept as the sheet has it - it omits RS, which is noted in sheet issue #171 rather than fixed here."
#library standard=sdtmig version=3-4
dataset QS class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col QSSEQ    type=Num
col QSTESTCD type=Char
col QSSTRESC type=Char
col QSORRESU type=Char label="Original Units"
---
S1 | QS | 001 | 1 | ADAS01 | 3 | mg/dL
