#!RuleTest
#test FDA-SE2255 expect=noViolation domain=TP
#note "Each repro stage description is carried by exactly one repro stage code, across both paths."
#library standard=sendig version=dart-1-1
dataset TP class="TRIAL DESIGN" label="Trial Paths"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col RPATHCD  type=Char label="Planned Repro Path Code"
col RPATH    type=Char label="Description of Planned Repro Path"
col TPSTGORD type=Num  label="Order of Repro Stage within Repro Path"
col RSTGCD   type=Char label="Repro Stage Code"
col RSTAGE   type=Char label="Description of Repro Stage"
col RPHASE   type=Char label="Repro Phase"
col RPRFDY   type=Num  label="Repro Phase Start Reference Day"
---
S1 | TP | PATH1 | Main Path   | 1 | GD0-6  | Gestation Day 0 to 6  | GESTATION | 0
S1 | TP | PATH2 | Second Path | 1 | GD0-6  | Gestation Day 0 to 6  | GESTATION | 0
S1 | TP | PATH1 | Main Path   | 2 | GD7-13 | Gestation Day 7 to 13 | GESTATION | 7
