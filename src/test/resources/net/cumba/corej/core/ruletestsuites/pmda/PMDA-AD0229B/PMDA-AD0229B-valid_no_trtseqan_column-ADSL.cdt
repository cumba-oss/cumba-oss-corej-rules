#note "TRTSEQAN is not declared. The guard not empty(TRTSEQAN) is false on every row -> EXECUTED and silent, with the degraded key suppressed."
#library standard=adamig version=1-3
dataset ADSL class=ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRTSEQA type=Char
---
S1 | 001 | A-B
S1 | 002 | A-B
S1 | 003 | B-A
