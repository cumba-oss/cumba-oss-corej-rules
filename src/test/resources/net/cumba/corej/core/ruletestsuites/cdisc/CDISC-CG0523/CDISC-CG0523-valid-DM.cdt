#!RuleTest
#test CDISC-CG0523 expect=noViolation domain=DM
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0523 (Condition: Subject not assigned to treatment; Rule: ARMCD = null). Rows 2-3: subjects not assigned to treatment (SCREEN FAILURE, NOT ASSIGNED) have ARMCD null. Row 1 is an assigned, treated subject and row 4 an assigned subject who was not treated, both keeping their planned ARMCD -> silent."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SUBJID   type=Char label="Subject Identifier for the Study"
col RFSTDTC  type=Char label="Subject Reference Start Date/Time"
col ARMCD    type=Char label="Planned Arm Code"
col ARM      type=Char label="Description of Planned Arm"
col ACTARMCD type=Char label="Actual Arm Code"
col ACTARM   type=Char label="Description of Actual Arm"
col ARMNRS   type=Char label="Reason Arm and/or Actual Arm is Null"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015 | 2014-01-02 | PBO | Placebo | PBO | Placebo | 
CDISCPILOT01 | DM | 01-701-1023 | 1023 |  |  |  |  |  | SCREEN FAILURE
CDISCPILOT01 | DM | 01-701-1028 | 1028 |  |  |  |  |  | NOT ASSIGNED
CDISCPILOT01 | DM | 01-701-1033 | 1033 |  | XAN_HI | Xanomeline High Dose |  |  | ASSIGNED, NOT TREATED
