#!RuleTest
#test CDISC-SEND-0298 expect=violation domain=TS
#note "TSXTRA is present in TS but is not defined for that domain in the SENDIG (get_column_order_from_library) -> fires on that variable only. W4 (PLAN-list-functions phase 0, scenarios-first on the pre-port engine)."
#library standard=sendig version=3-1-1
#library column-order TS STUDYID DOMAIN TSSEQ TSPARMCD TSPARM TSVAL
#expectViolationCount 1
#expectViolationAt variable_name=TSXTRA
dataset TS
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL    type=Char label="Parameter Value"
col TSXTRA   type=Char label="Sponsor Defined"
---
S1 | TS | 1 | SSTYP | TOX | X
