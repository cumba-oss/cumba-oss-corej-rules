#!RuleTest
#test FDA-SD1381 expect=executionError domain=MB
#note "PLAN-merged-evaluation-table W3f, OD-10: the DM join authors Cardinality n:1 on [STUDYID, USUBJID], so a DM carrying the subject twice is refused - the rule ERRORs naming DM, the key and the two rows, instead of evaluating one copy of the record per DM row. A duplicate DM is reported by the DM uniqueness rule (FDA-SD0083: not is_unique_set([USUBJID, STUDYID]) on DM, in FDA SENDIG-AR 1.0), not by every rule joining DM. Until W3f this was the D32 copies sensitivity arm of PLAN-function-surface-wave1 phase 2 (b): one finding from the copy paired with the second DM row."
#library standard=sendig version=ar-1-0
#expect-execution-error "Cardinality n:1: DM has duplicate key (STUDYID=S1, USUBJID=001) at rows 1 and 2"
dataset MB class=FINDINGS
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col MBSEQ   type=Num  label="Sequence Number"
col MBTESTCD type=Char label="Microbiology Test Code"
col MBDTC type=Char label="Date/Time of Collection"
col MBXDY  type=Num  label="Day of Obs Relative to Exposure"
---
S1 | MB | 001 | 1 | BACT | 2023-06-15 | 6
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFSTDTC  type=Char label="Subject Reference Start Date/Time"
col RFXSTDTC type=Char label="Date/Time of First Study Treatment"
---
S1 | DM | 001 | 2023-06-01 | 2023-06-10
S1 | DM | 001 | 2023-06-01 | 2023-06-14
---
