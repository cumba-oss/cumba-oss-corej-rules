#!RuleTest
#test FDA-SD1381 expect=violation domain=MB
#note "PLAN-function-surface-wave1 phase 2 (b) on a parameterised-reference rule: DM carries subject 001 twice with RFXSTDTC 2023-06-10 and 2023-06-14. The inner join row-multiplies the one MB record into two copies (D32). MBXDY=6 is correct against the first DM row (2023-06-15 is day 6 from 2023-06-10); the copy paired with the second row computes day 2 and fires: ONE finding. Pre-port (measured at the go) the operation's subject map gave day 2 to both copies: TWO findings."
#library standard=sendig version=ar-1-0
#expectViolationCount 1
dataset MB class=FINDINGS
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col MBSEQ   type=Num  label="Sequence Number"
col MBTESTCD type=Char label="Microbiology Test Code"
col MBDTC type=Char label="Date/Time of Collection"
col MBXDY  type=Num  label="Day of Obs Relative to Exposure"
---
S1 | MB | 001 | 1 | BACT | 2023-06-15 | 6
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFSTDTC  type=Char label="Subject Reference Start Date/Time"
col RFXSTDTC type=Char label="Date/Time of First Study Treatment"
---
S1 | DM | 001 | 2023-06-01 | 2023-06-10
S1 | DM | 001 | 2023-06-01 | 2023-06-14
---
