#!RuleTest
#test CDISC-CG0084 expect=violation domain=AE
# Rule:Description: Raise an error when --TOXGR is not present in the dataset but --TOX is present.
#note "AETOX column present while AETOXGR column is absent"
#expectViolationCount 1
#expectViolationAt row=1
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AETOX type=Char label="Toxicity"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | MILD
CDISCPILOT01 | AE | 01-701-1015 | 2 | SEVERE
---
