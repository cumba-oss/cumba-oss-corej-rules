#!RuleTest
#test FDA-SD0024 expect=noViolation domain=LB
#note "LBDTC is not present and LBENDTC is present but empty in every record: no record has an end date/time, so the condition '--DTC should not be NULL, when --ENDTC is not NULL' never holds. The rule runs (--ENDTC alone gates it since 2026-10-07; it SKIPPED here while --DTC was gated too) and finds nothing: an absent --DTC is a finding only beside a populated --ENDTC."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBENDTC  type=Char label="End Date/Time of Specimen Collection"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | GLUC |
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALB  |
