#!RuleTest
#test PMDA-SD9999 expect=noViolation domain=XX
#note "The same custom dataset whose Define-XML class EVENTS is one of the SDTM general observation classes -> conformant, no finding. An inverted membership test fires here and reds this scenario."
#library standard=sdtmig version=3-4
#library custom-domain XX
#define dataset-class XX EVENTS
dataset XX label="Custom Dataset"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col XXSEQ   type=Num  label="Sequence Number"
col XXTERM  type=Char label="Reported Term"
---
S1 | XX | 001 | 1 | FOO
