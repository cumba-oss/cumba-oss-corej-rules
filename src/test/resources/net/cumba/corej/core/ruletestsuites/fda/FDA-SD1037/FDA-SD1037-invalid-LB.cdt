#!RuleTest
#test FDA-SD1037 expect=violation domain=LB
#note "LBTOXGR=2 (>0) but LBTOX is empty on row 1 -> fires; row 2 TOXGR=0 guarded; row 3 has LBTOX."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 LBTOX=
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col LBSEQ   type=Num  label="Sequence Number"
col LBTOXGR type=Char label="Standard Toxicity Grade"
col LBTOX   type=Char label="Toxicity"
---
S1 | LB | 001 | 1 | 2 |
S1 | LB | 001 | 2 | 0 |
S1 | LB | 001 | 3 | 3 | Grade 3
---
