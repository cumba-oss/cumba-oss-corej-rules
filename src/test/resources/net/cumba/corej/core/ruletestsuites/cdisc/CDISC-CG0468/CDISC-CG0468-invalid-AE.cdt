#!RuleTest
#test CDISC-CG0468 expect=violation domain=AE
# Rule:Description: Raise an error when the Planned Time Point Number (--TPTNUM) variable is not present in a dataset that contains the Planned Time Point Name (--TPT) variable.
#note "AETPT column present while AETPTNUM column is absent"
#expectViolationCount 1
#expectViolationAt row=1
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AETPT type=Char label="Planned Time Point Name"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | 1 HOUR POST
CDISCPILOT01 | AE | 01-701-1015 | 2 | 2 HOURS POST
---
