#!RuleTest
#test CDISC-CG0427 expect=skipped domain=LB
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0427 (Condition: --RESCAT ^= null; Rule: --STRESC ^= null). LBRESCAT is withheld: Requirements.Variables.All [--RESCAT] is unmet, so there is no category to test and the rule must skip, even though row 2 has a null LBSTRESC."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBTEST   type=Char label="Lab Test or Examination Name"
col LBORRES  type=Char label="Result or Finding in Original Units"
col LBSTRESC type=Char label="Character Result/Finding in Std Format"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | UROBIL | Urobilinogen | NEGATIVE | NEGATIVE
CDISCPILOT01 | LB | 01-701-1023 | 1 | UROBIL | Urobilinogen | 2+ | 
