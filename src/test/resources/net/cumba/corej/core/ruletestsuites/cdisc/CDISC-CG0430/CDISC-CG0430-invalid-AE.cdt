#!RuleTest
#test CDISC-CG0430 expect=violation domain=AE
# Rule:Description: Raise an error when --SCAT is present in a dataset, but --CAT is not present.
#note "AESCAT column present while AECAT column is absent"
#expectViolationCount 1
#expectViolationAt row=1
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AESCAT type=Char label="Subcategory for Adverse Event"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | SERIOUS
CDISCPILOT01 | AE | 01-701-1015 | 2 | NON-SERIOUS
---
