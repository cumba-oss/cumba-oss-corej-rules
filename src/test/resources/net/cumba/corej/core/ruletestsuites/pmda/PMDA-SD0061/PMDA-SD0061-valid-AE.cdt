#!RuleTest
#test PMDA-SD0061 expect=noViolation domain=AE
#note "Every dataset the Define-XML declares (AE, VS, ZZ, YY) is present in the study -> contains_all holds and the rule stays quiet. Paired with the invalid scenario this isolates the firing condition to the two Define-only datasets."
#library standard=sdtmig version=3-4
#define-xml PMDA-SD0061-define.xml
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE
---

dataset VS label="Vital Signs"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VSSEQ    type=Num  label="Sequence Number"
col VSTESTCD type=Char label="Vital Signs Test Short Name"
---
S1 | VS | 001 | 1 | SYSBP
---

dataset ZZ label="Custom Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ZZTESTCD type=Char label="Test Short Name"
---
S1 | ZZ | 001 | XTEST
---

dataset YY label="Custom Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col YYTESTCD type=Char label="Test Short Name"
---
S1 | YY | 001 | XTEST
