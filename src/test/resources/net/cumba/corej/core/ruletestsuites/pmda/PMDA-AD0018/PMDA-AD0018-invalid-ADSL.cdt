#!RuleTest
#test PMDA-AD0018 expect=violation domain=ADSL
#note "AGE's dataset label 'Age in Years' differs from the Library's 'Age' -> fires on AGE; SEX matches; STUDYID and USUBJID have no library line, so var_name(\"LIBRARY\") is null and the first conjunct excludes them."
#library standard=adamig version=1-3
#library variable-metadata ADSL AGE name=AGE label="Age" simpleDatatype=Num
#library variable-metadata ADSL SEX name=SEX label="Sex"
#expectViolationCount 1
#expectViolationAt variable_name=AGE library_variable_label=Age variable_label="Age in Years"
dataset ADSL structure=ADSL
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col AGE     type=Num  label="Age in Years"
col SEX     type=Char label="Sex"
---
CDISCPILOT01 | 01-701-1015 | 56 | M
