#!RuleTest
#test CDISC-CG0333 expect=noViolation domain=FAZZ
# Rule:Description: Raise an error when a Findings About dataset name begins with "FA", is longer than two characters, and the characters following "FA" do not match the two-character code of a domain present in the study.
#note "Findings About dataset FAZZ matches the FA-name regex and is FA-prefixed, but its parent ZZ (the two-letter suffix) IS present in the study, so the suffix_is_not_contained_by conjunct is false"
dataset FAZZ label="Findings About a parent domain that is present"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | FA | 01-701-1015
CDISCPILOT01 | FA | 01-701-1023
---

dataset ZZ label="Parent domain present in the study"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | ZZ | 01-701-1015
CDISCPILOT01 | ZZ | 01-701-1023
---

dataset DM label=Demographics
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | DM | 01-701-1015
CDISCPILOT01 | DM | 01-701-1023
---
