#!RuleTest
#test CDISC-SEND-0400-B expect=noViolation domain=SJ
#note "The R-5.25 wave-3 split's discriminator, sibling side: SJ is present, so the SJ half is SILENT - the missing TT and TP of this study are the parent's and -A's findings."
#library standard=sendig-dart version=1-2
#expectViolationCount 0
dataset SJ class="SPECIAL PURPOSE" label="Subject Reproductive Stages"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SJSEQ   type=Num  label="Sequence Number"
---
S1 | SJ | 001 | 1
