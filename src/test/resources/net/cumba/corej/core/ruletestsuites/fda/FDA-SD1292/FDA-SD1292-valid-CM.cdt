#!RuleTest
#test FDA-SD1292 expect=noViolation domain=CM
#note "row 1 pairs CMSTTPT with CMSTRTPT; row 2 has neither -> no violation."
#library standard=sdtmig version=3-4
dataset CM class=INTERVENTIONS label="Concomitant Medications"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col CMSEQ    type=Num  label="Sequence Number"
col CMTRT    type=Char label="Reported Name of Drug, Med, or Therapy"
col CMSTRTPT type=Char label="Start Relative to Reference Time Point"
col CMSTTPT  type=Char label="Start Reference Time Point"
---
S1 | CM | 001 | 1 | ASPIRIN | BEFORE | 2020-01-01
S1 | CM | 002 | 1 | IBUPROFEN |  |
