#!RuleTest
#test PMDA-SD9754 expect=skipped domain=CM
#note "Neither column: no CMENDY and no CMENDTC -> SKIPPED on All [--ENDY]; nothing is populated that would need the date."
#library standard=sdtmig version=3-2
dataset CM class=INTERVENTIONS label="Concomitant Medications"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col CMSEQ    type=Num  label="Sequence Number"
col CMTRT type=Char label="Reported Name of Drug, Med, or Therapy"
---
S1 | CM | 001 | 1 | ASPIRIN
S1 | CM | 002 | 2 | ASPIRIN
S1 | CM | 003 | 3 | ASPIRIN
