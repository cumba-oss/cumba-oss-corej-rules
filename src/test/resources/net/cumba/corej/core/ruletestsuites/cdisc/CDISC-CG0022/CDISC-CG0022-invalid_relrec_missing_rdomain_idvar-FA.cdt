#!RuleTest
#test CDISC-CG0022 expect=violation domain=FA
#note "Rule round 2026-10-03 review (sheet issue #286). RELREC carries a row whose RDOMAIN and IDVAR are both missing (Dataset-JSON loads an empty value as a missing value), under RELID R1, the same RELID as the FA.FALNKGRP row. concat(missing, \"LNKGRP\") is missing and missing == missing holds (D34/D36), so the unguarded filters took that row as both an LNKGRP and an LNKID half and its RELID alone satisfied the pairing: the rule was silent. Every RELREC filter now requires RDOMAIN and IDVAR to be present, so no LNKGRP is related to an LNKID and the rule fires once for FA."
#expectViolationCount 1
#expectViolationAt row=1 FALNKGRP=1 "$variable_count"=1
dataset FA label="Findings About Events or Interventions"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col FASEQ type=Num label="Sequence Number"
col FALNKGRP type=Char label="Link Group ID"
---
CDISCPILOT01 | FA | 01-701-1015 | 1 | 1
CDISCPILOT01 | FA | 01-701-1015 | 2 | 1
---

dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AELNKID type=Char label="Link ID"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | 1
---

dataset DS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ type=Num label="Sequence Number"
col DSLNKID type=Char label="Link ID"
---
CDISCPILOT01 | DS | 01-701-1015 | 1 | 1
---

dataset RELREC label="Related Records"
col STUDYID type=Char label="Study Identifier"
col RDOMAIN type=Char label="Related Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col IDVAR type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col RELTYPE type=Char label="Relationship Type"
col RELID type=Char label="Relationship Identifier"
---
CDISCPILOT01 | AE | 01-701-1015 | AESEQ | 1 | ONE | R1
CDISCPILOT01 | FA | 01-701-1015 | FALNKGRP | 1 | MANY | R1
CDISCPILOT01 | AE |  | AELNKID |  | ONE | R2
CDISCPILOT01 | DS |  | DSLNKID |  | ONE | R2
CDISCPILOT01 | . |  | . |  |  | R1
---
