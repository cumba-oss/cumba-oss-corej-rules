#!RuleTest
#test FDA-SD9717 expect=skipped domain=AE
#note "The discriminator that keeps the pair from double-reporting: the AETOX column EXISTS (blank on row 1), so Requirements.Variables.None [--TOX] skips this sister with a reason naming the column, and FDA-SD1037 owns the case, reporting row 1 with its location. In the hoisted None form 'sister silent' is an auditable SKIP rather than a silent noViolation."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AETOX   type=Char label="Standard Toxicity Name"
col AETOXGR type=Char label="Standard Toxicity Grade"
---
S1 | AE | 001 | 1 | HEADACHE |          | 3
S1 | AE | 002 | 1 | NAUSEA   | NAUSEA   | 2
