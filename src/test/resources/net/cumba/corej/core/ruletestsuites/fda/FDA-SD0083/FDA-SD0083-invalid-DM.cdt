#!RuleTest
#test FDA-SD0083 expect=violation domain=DM
#note "USUBJID S1-001 appears twice within STUDYID S1 -> both duplicate DM records fire; the unique S1-002 record does not."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=S1-001
#expectViolationAt row=2 USUBJID=S1-001
dataset DM class="SPECIAL PURPOSE"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
---
S1 | DM | S1-001 | 001
S1 | DM | S1-001 | 001A
S1 | DM | S1-002 | 002
