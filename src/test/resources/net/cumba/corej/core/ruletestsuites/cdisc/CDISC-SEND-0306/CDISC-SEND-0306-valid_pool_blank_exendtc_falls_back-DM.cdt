#!RuleTest
#test CDISC-SEND-0306 expect=noViolation domain=DM
#note "PLAN-scalar-date-extremes: Pool-only; the pool's only EX row has a BLANK EXENDTC and EXSTDTC 2020-01-10; RFXENDTC 2020-01-10 -> silent: the pool's latest EXENDTC has no answer (its one EX row's EXENDTC is blank, so there is no candidate — with a single row that is the answer under skip as well, so this scenario does NOT pin missing_values=\"indeterminate\"; invalid_pool_open_interval_reported does), the EXENDTC conjunct fires on the missing answer (D34a), and the EXSTDTC conjunct decides (2020-01-10 = RFXENDTC), as SENDIG 3.1.1 5.1.1 p.45 prescribes. Pin (silent before through the guard)."
#library standard=sendig version=3-1-1
dataset DM label=Demographics
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFXENDTC type=Char label="Date/Time of Last Study Treatment"
---
S1 | DM | 001 | 2020-01-10
---
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col POOLID  type=Char label="Pool Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
col EXENDTC type=Char label="End Date/Time of Treatment"
---
S1 | EX |  | P1 | 1 | DRUG A | 2020-01-10 |
---
dataset POOLDEF label="Pool Definition"
col STUDYID type=Char label="Study Identifier"
col POOLID  type=Char label="Pool Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
---
S1 | P1 | 001
---
