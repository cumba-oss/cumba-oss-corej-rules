#!RuleTest
#test CDISC-CG0082 expect=violation domain=AE
#note "Both columns present: row 2 has AEBODSYS populated and AEBDSYCD empty -> fires on that record only."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2
dataset AE class=EVENTS label="Adverse Events"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col AESEQ    type=Num
col AETERM   type=Char
col AEBODSYS type=Char
col AEBDSYCD type=Char
---
S1 | AE | 001 | 1 | HEADACHE | Nervous system disorders | 10029205
S1 | AE | 001 | 2 | NAUSEA   | Gastrointestinal disorders |
S1 | AE | 002 | 1 | RASH     |  |
