#!RuleTest
#test CDISC-SEND-0280 expect=noViolation domain=MI
#note "The MI half of the LB/MI scope: MIREASND is not in the dataset, but no row reports MISTAT='NOT DONE' - every examination was performed, so an absent reason column is unremarkable. The sister fires only where its parent would have fired (R-4.11c)."
#library standard=sendig version=3-1-1
dataset MI class=FINDINGS label="Microscopic Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col MISEQ    type=Num  label="Sequence Number"
col MITESTCD type=Char label="Microscopic Examination Short Name"
col MISTAT   type=Char label="Completion Status"
col MIORRES  type=Char label="Result or Finding in Original Units"
---
S1 | MI | 001 | 1 | GHISTXQL |  | UNREMARKABLE
