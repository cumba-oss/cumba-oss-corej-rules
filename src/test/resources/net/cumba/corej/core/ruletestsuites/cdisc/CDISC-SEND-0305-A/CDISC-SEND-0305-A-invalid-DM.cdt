#!RuleTest
#test CDISC-SEND-0305-A expect=violation domain=DM
#note "PLAN-scalar-date-extremes: New baseline, non-pooled: RFXSTDTC 2020-01-03 differs from the own earliest EXSTDTC 2020-01-01 -> 1 finding. ⚑ PLAN-join-key-one-side-absent-drop QK17 (owner 2026-10-11): split by the pool gate — a study that defines no pools is judged by CDISC-SEND-0305-A (moved from CDISC-SEND-0305, same expectation)"
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset DM label=Demographics
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFXSTDTC type=Char label="Date/Time of First Study Treatment"
---
S1 | DM | 001 | 2020-01-03
---
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col POOLID  type=Char label="Pool Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
---
S1 | EX | 001 |  | 1 | DRUG A | 2020-01-05
S1 | EX | 001 |  | 2 | DRUG A | 2020-01-01
---
