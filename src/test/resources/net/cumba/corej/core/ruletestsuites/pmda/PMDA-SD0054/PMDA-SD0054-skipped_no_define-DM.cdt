#!RuleTest
#test PMDA-SD0054 expect=skipped domain=DM
#note "The invalid dataset WITHOUT any define channel: the define_variable_names operation yields null and the rule must SKIP (anti-vacuity pin for the whole define bucket)."
#library standard=sdtmig version=3-4
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
S1 | DM | S1-001
