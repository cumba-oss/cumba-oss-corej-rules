#!RuleTest
#test CDISC-CG0157 expect=violation domain=APAE
#note "S3 foreign discrimination (SKELETON-distinct-function hazard 3). Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0157 (Condition: relationship described is to a study subject; Rule: RSUBJID in DM.USUBJID). An RSUBJID that is a POOLDEF POOLID describes a relationship to a pool, not to a subject, so the Condition does not hold for it. Row 1's RSUBJID 01-701-9999 is neither a POOLDEF POOLID nor a DM.USUBJID -> fires. The primary APAE deliberately carries POOLID and USUBJID columns (an AP dataset normally has neither; the rule has no Requirements.Variables.None) whose value is that same RSUBJID, planted in BOTH because the Check is 'not in POOLDEF set and not in DM set': a port that read POOLID or USUBJID from the primary instead of the FOREIGN POOLDEF / DM would find row 1's RSUBJID in its own set and fall silent, whichever of the two it misreads."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 APID=AP-03 RSUBJID=01-701-9999
dataset APAE class=EVENTS label="Associated Persons Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col APID    type=Char label="Associated Persons Identifier"
col RSUBJID type=Char label="Related Subject or Pool Identifier"
col SREL    type=Char label="Subject, Device or Study Relationship"
col POOLID  type=Char label="Pool Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
---
CDISCPILOT01 | APAE | AP-03 | 01-701-9999 | FATHER, BIOLOGICAL | 01-701-9999 | 01-701-9999 | 1 | FEVER
---

dataset POOLDEF label="Pool Definition"
col STUDYID type=Char label="Study Identifier"
col POOLID  type=Char label="Pool Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | POOL01 | 01-701-1023
CDISCPILOT01 | POOL01 | 01-701-1028
---

dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | DM | 01-701-1015
CDISCPILOT01 | DM | 01-701-1023
CDISCPILOT01 | DM | 01-701-1028
---
