#!RuleTest
#test CDISC-AD0771 expect=violation domain=ADAE
# Rule:Description: There is more than one value of ASEV for a given value of ASEVN, considering only those rows on which both variables are populated
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015
#expectViolationAt row=2 USUBJID=01-701-1015
# Declared-tier scope: structure= states the ADaM data structure this minimal table stands for;
# #define is its mandatory carrier (ScenarioDeclaredScopeProvider.install).
#define standard=adamig version=1-3
dataset ADAE structure=OCCDS
col STUDYID type=Char
col USUBJID type=Char
col ASEQ type=Num
col ASEV type=Char
col ASEVN type=Char
---
CDISCPILOT01 | 01-701-1015 | 1 | MILD | 1
CDISCPILOT01 | 01-701-1015 | 2 | MODERATE | 1
CDISCPILOT01 | 01-701-1015 | 3 | SEVERE | 3
---
