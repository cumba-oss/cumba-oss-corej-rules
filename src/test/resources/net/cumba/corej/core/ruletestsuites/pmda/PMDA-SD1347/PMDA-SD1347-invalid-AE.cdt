#!RuleTest
#test PMDA-SD1347 expect=violation domain=AE
#note "Row 1: fatal AE whose end date differs from the DM death date -> fires. Row 2's end date equals the death date."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 AEENDTC=2020-03-10
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEOUT   type=Char label="Outcome of Adverse Event"
col AEENDTC type=Char label="End Date/Time of Adverse Event"
---
S1 | AE | 001 | 1 | CARDIAC ARREST | FATAL | 2020-03-10
S1 | AE | 002 | 1 | CARDIAC ARREST | FATAL | 2020-04-01
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DTHDTC  type=Char label="Date/Time of Death"
col DTHFL   type=Char label="Subject Death Flag"
---
S1 | DM | 001 | 2020-03-15 | Y
S1 | DM | 002 | 2020-04-01 | Y
