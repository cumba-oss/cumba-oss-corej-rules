#!RuleTest
#test CDISC-AD0764 expect=violation domain=ADLBC
# Rule:Description: TRTPGy is present and TRTA is present but TRTAGy is not present, where y is an integer [1-99, not zero-padded]
#note "TRTPG1 and TRTA present, TRTAG1 absent -> violation"
#expectViolationCount 1
#expectViolationAt TRTA="DRUG A" TRTPG1=GROUP1
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col TRTPG1 type=Char
col TRTA type=Char
---
CDISCPILOT01 | 01-701-1015 | GLUC | GROUP1 | DRUG A
---
