#!RuleTest
#test CDISC-AD0596 expect=skipped domain=ADLBC
#note "PLAN-join-key-authoring-gate phase 4: ADLBC has no APERIOD column: it drives the constructed ADSL.APxxETM name of the bound $ap_etm (colref(concat(\"ADSL.AP\", printf(\"%02d\", APERIOD), \"ETM\"))) and is declared in Requirements.Variables.All (§3b), so the rule skips instead of answering a silent no-finding."
#define standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col APERETM type=Num
---
CDISCPILOT01 | 01-701-1015 | 21950
---

dataset ADSL label="Subject-Level Analysis"
col STUDYID type=Char
col USUBJID type=Char
col AP01ETM type=Num
col AP02ETM type=Num
