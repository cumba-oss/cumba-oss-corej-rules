#!RuleTest
#test CDISC-CG9685 expect=skipped domain=LB
#note "LB is a FINDINGS-class dataset: Scope.Classes.Include [EVENTS] rejects it -> skipped. The data would otherwise fire: LBBODSYS is populated and LBBDSYCD is not a column, so both Requirements gates pass and the dataset-level check is true."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
col LBBODSYS type=Char
---
S1 | LB | 001 | 1 | ALT | Hepatobiliary disorders
---
