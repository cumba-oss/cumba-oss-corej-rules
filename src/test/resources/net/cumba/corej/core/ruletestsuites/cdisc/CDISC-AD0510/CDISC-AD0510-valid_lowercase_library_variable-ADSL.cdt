#!RuleTest
#test CDISC-AD0510 expect=noViolation domain=ADSL
#note "Authority: ADaM Conformance Rules v5.0 CR510 ('A variable ending in STM must contain Start Time in the label'), whose exception is the standard library variables. A lowercase ADSL: trtstm is the library variable TRTSTM carrying its ADaMIG label 'Time of First Exposure to Treatment', so it is exempt in any letter case (CIT 1/3: the library exclusion folds the name as the STM test does) -> noViolation."
#library standard=adamig version=1-3
#library column-order ADSL STUDYID USUBJID TRTSTM
#library variable-metadata ADSL *STM name=*STM label="{Start Time}"
#library variable-metadata ADSL *TM name=*TM label="{Time}"
#library variable-metadata ADSL TRTSTM name=TRTSTM label="Time of First Exposure to Treatment"
dataset ADSL class=ADSL
col studyid type=Char
col usubjid type=Char
col trtstm type=Num label="Time of First Exposure to Treatment"
---
CDISCPILOT01 | 01-701-1015 | 36000
---
