#!RuleTest
#test FDA-SE2247 expect=noViolation domain=DM
#note "The Trial Repro Paths (TP) dataset is present in the study inventory alongside DM -> no violation."
#library standard=sendig-dart version=1-1
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col SETCD   type=Char label="Set Code"
---
STUDY01 | DM | STUDY01-001 | 001 | SET1
---

dataset TP class="TRIAL DESIGN" label="Trial Repro Paths"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col RPATHCD  type=Char label="Repro Path Code"
col RPATH    type=Char label="Repro Path"
col TPSTGORD type=Num  label="Repro Stage Order Number"
col RSTGCD   type=Char label="Repro Stage Code"
---
STUDY01 | TP | P1 | Path 1 | 1 | GD0
---
