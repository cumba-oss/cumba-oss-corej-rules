#!RuleTest
#test FDA-SD0033 expect=skipped domain=LB
#note "LBTPTNUM is not present in the dataset while LBTPT is populated. Requirements.Variables.All [--TPT, --TPTNUM] gates the rule out -> auditable skip instead of one finding per row under absent = all-missing (EC-43). Row 1 WOULD fire were the gate removed. Verdict 2-1': FDA-SD1250 reports the absence itself."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBTPT    type=Char label="Planned Time Point Name"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | GLUC | 1 HR POST
CDISCPILOT01 | LB | 01-701-1015 | 2 | GLUC |
