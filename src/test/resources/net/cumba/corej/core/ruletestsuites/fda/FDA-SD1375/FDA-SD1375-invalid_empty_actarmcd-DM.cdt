#!RuleTest
#test FDA-SD1375 expect=violation domain=DM
#note "any-branch 1: RFENDTC is populated while ACTARMCD is empty (the sheet's '(or null)' case) -> fires on row 1."
#library standard=sdtmig version=3-2
#expectViolationCount 1
#expectViolationAt row=1 nameOnly=RFENDTC nameOnly=ACTARMCD
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFENDTC  type=Char label="Subject Reference End Date/Time"
col ACTARMCD type=Char label="Actual Arm Code"
---
CDISCPILOT01 | DM | 01-701-1015 | 2020-02-10 |
CDISCPILOT01 | DM | 01-701-1023 |            |
