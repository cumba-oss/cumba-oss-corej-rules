#!RuleTest
#test CDISC-CG0351 expect=noViolation domain=VS
#note "Every VS column is in the Model list of allowed variables -> no violation. W4 (PLAN-list-functions phase 0, scenarios-first on the pre-port engine)."
#library standard=sdtmig version=3-4
#library dataset-class VS FINDINGS
#library model-column-order VS STUDYID DOMAIN USUBJID VSSEQ VSTESTCD VSORRES VSDTC
dataset VS class=FINDINGS label="Vital Signs"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VSSEQ    type=Num  label="Sequence Number"
col VSTESTCD type=Char label="Vital Signs Test Short Name"
col VSORRES  type=Char label="Result or Finding in Original Units"
---
S1 | VS | 001 | 1 | SYSBP | 120
