#!RuleTest
#test PMDA-AD0274-A expect=skipped domain=ADAE
#note "DOSEAEON is not declared. The gate is load-bearing on THIS half: its Check is empty(DOSEAEON) with a populated DOSAEONU, which on an absent DOSEAEON column would fire on both rows. Requirements.Variables.All rejects the dataset instead - mirror of the parent's skipped_no_dosaeonu fixture."
#library standard=adamig version=1-0
dataset ADAE
col STUDYID  type=Char
col USUBJID  type=Char
col AEDECOD  type=Char
col DOSAEONU type=Char
---
CDISCPILOT01 | 01-701-1015 | HEADACHE | mg
CDISCPILOT01 | 01-701-1023 | NAUSEA   | mg
