#!RuleTest
#test CDISC-CG9685 expect=violation domain=AE
#note "AEBDSYCD column absent while AEBODSYS is populated -> fires ONCE for the dataset (Sensitivity: Dataset), where the ungated CDISC-CG0082 fired once per record. Same rows as CDISC-CG0082-skipped_bdsycd_column_absent-AE."
#library standard=sdtmig version=3-4
#expectViolationCount 1
dataset AE class=EVENTS label="Adverse Events"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col AESEQ    type=Num
col AETERM   type=Char
col AEBODSYS type=Char
---
S1 | AE | 001 | 1 | HEADACHE | Nervous system disorders
S1 | AE | 001 | 2 | NAUSEA   | Gastrointestinal disorders
---
