#!RuleTest
#test CDISC-AD0180 expect=skipped domain=ADSL
#note "Scope.Data_Structures.Include is BASIC DATA STRUCTURE only. ADSL (structure ADSL) carries an SRCDOM value that is no SDTM domain (XX), which would fire if the scope were widened; it is skipped instead."
#library standard=adamig version=1-0
#library standard-domains AE DM LB VS
dataset ADSL structure=ADSL label="Subject Level Analysis Dataset"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col SRCDOM  type=Char label="Source Data"
---
S1 | 001 | XX
---
