#!RuleTest
#test PMDA-AD0018 expect=noViolation domain=ADSL
#note "PMDA AD0018 (PLAN-library-template-label-resolution): a column spelled TRTXXP - the template itself, upper-cased - resolves case-insensitively to the Library's TRTxxP as a LITERAL hit: no digits to substitute, so the library serves no label template for it and the rule's not empty(label_template(\"LIBRARY\")) guard keeps it out whatever its label -> silent. A real period instance, TRT01P, IS checked (-invalid_lowercase_indexed_name). STUDYID is the positive control."
#library standard=adamig version=1-3
#library variable-metadata ADSL STUDYID name=STUDYID label="Study Identifier"
#library variable-metadata ADSL TRTxxP name=TRTxxP label="Planned Treatment for Period xx"
#expectViolationCount 0
dataset ADSL structure=ADSL
col STUDYID type=Char label="Study Identifier"
col TRTXXP  type=Char label="Wrong Label"
---
CDISCPILOT01 | Placebo
---
