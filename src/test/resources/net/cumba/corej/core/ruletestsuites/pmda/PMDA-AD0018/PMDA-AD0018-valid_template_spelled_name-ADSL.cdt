#!RuleTest
#test PMDA-AD0018 expect=noViolation domain=ADSL
#note "PMDA Validation Rules v6.0 AD0018: the exception for variables whose names contain an index (y, xx, zz, w), keyed on the LIBRARY name. The column is spelled TRTXXP - the template itself, upper-cased - and resolves case-insensitively to the Library's TRTxxP, whose lower-case index marks it as a template. Its label differs from the template's, but a template label is not a standard label for any concrete variable -> silent. The case-insensitive name match pairs TRTXXP with TRTxxP, so the Library-name exclusion alone keeps it silent; STUDYID is the positive control."
#library standard=adamig version=1-3
#library variable-metadata ADSL STUDYID name=STUDYID label="Study Identifier"
#library variable-metadata ADSL TRTxxP name=TRTxxP label="Planned Treatment for Period xx"
#expectViolationCount 0
dataset ADSL structure=ADSL
col STUDYID type=Char label="Study Identifier"
col TRTXXP  type=Char label="Wrong Label"
---
CDISCPILOT01 | Placebo
---
