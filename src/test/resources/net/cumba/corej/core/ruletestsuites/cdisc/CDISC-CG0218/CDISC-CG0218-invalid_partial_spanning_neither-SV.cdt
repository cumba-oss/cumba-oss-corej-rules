#!RuleTest
#test CDISC-CG0218 expect=violation domain=SV
#runLevel Info
#note "SV Assumption 11 (SDTMIG 3.2/3.3/3.4): SV.EPOCH is the epoch of the element in progress when the visit starts; SE Assumption 10: an element's SEENDTC is the next element's SESTDTC, the transition instant belongs to the next element (end-exclusive). PLAN-cg0218-transition-day-precision (B2, owner 2026-10-05): a visit is judged against every element that MAY be in progress at its start and reported only when its EPOCH matches none of them, once, on the element that contains it (ERROR); partial dates on the same principle at INFO (Q4), once per candidate element. Pin (no movement; P6 multiplicity): a month-precision visit 2012-07 labelled FOLLOW-UP may lie in SCREENING or TREATMENT, matches neither, and no element contains it exactly, so INFO fires once per candidate element (SCREENING and TREATMENT): two findings, distinct by SE.EPOCH, which the findings sink does not collapse; FOLLOW-UP starts 2012-08-20 and is no candidate."
#expectViolationCount 2
#expectViolationAt row=1 severity=INFO VISITNUM=2 SE.EPOCH=SCREENING
#expectViolationAt row=1 severity=INFO VISITNUM=2 SE.EPOCH=TREATMENT
dataset SV label="Subject Visits"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col VISITNUM type=Num label="Visit Number"
col VISIT type=Char label="Visit Name"
col SVSTDTC type=Char label="Start Date/Time of Visit"
col EPOCH type=Char label="Epoch"
---
CDISCPILOT01 | SV | 01-701-0001 | 2 | DAY 1 | 2012-07 | FOLLOW-UP
---

dataset SE label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ type=Num label="Sequence Number"
col SESTDTC type=Char label="Start Date/Time of Element"
col SEENDTC type=Char label="End Date/Time of Element"
col EPOCH type=Char label="Epoch"
---
CDISCPILOT01 | SE | 01-701-0001 | 1 | 2012-07-06 | 2012-07-15 | SCREENING
CDISCPILOT01 | SE | 01-701-0001 | 2 | 2012-07-15 | 2012-08-20 | TREATMENT
CDISCPILOT01 | SE | 01-701-0001 | 3 | 2012-08-20 | 2012-09-03 | FOLLOW-UP
---
