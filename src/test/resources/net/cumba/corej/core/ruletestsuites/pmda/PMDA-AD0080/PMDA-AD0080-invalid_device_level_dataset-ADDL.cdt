#!RuleTest
#test PMDA-AD0080 expect=violation domain=ADDL
#note "Positive scope pin for the SECOND Include token. structure=\"DEVICE LEVEL ANALYSIS DATASET\" (full token - only ADSL/BDS/OCCDS/OTHER have shortcuts; the quoted full name is one of the seven STRUCTURE_TOKENS). Same data shape as the ADSL violation, different structure -> still in scope -> one violation at reported row 1. The #library line is the carrier for the declaration."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 TRT01A=DRUGA
dataset ADDL structure="DEVICE LEVEL ANALYSIS DATASET"
col STUDYID type=Char
col USUBJID type=Char
col SPDEVID type=Char
col TRT01A  type=Char
---
CDISCPILOT01 | 01-701-1015 | DEV01 | DRUGA
