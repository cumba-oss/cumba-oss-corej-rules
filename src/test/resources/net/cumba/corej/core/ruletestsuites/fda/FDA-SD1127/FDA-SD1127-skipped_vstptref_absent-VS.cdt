#!RuleTest
#test FDA-SD1127 expect=skipped domain=VS
#note "VSTPTREF is not in the dataset (rule round 2026-10-12, var_exists sweep, owner 2026-10-07): the grouping keys --TPT and --TPTREF moved from Check-level var_exists guards into Requirements.Variables.All, so the rule is SKIPPED instead of passing silently. Red under the old rule (it ran: no violation). Without either gate the absent key drops out of [--TPT, --TPTREF, VISITNUM], and 1H POST would carry two VSTPTNUM values -> violations."
#library standard=sdtmig version=3-4
dataset VS class=FINDINGS label="Vital Signs"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VSSEQ    type=Num  label="Sequence Number"
col VSTESTCD type=Char label="Vital Signs Test Short Name"
col VISITNUM type=Num  label="Visit Number"
col VSTPTNUM type=Num  label="Planned Time Point Number"
col VSTPT    type=Char label="Planned Time Point Name"
---
S1 | VS | 001 | 1 | SYSBP | 1 | 1 | 1H POST
S1 | VS | 001 | 2 | SYSBP | 1 | 2 | 1H POST
