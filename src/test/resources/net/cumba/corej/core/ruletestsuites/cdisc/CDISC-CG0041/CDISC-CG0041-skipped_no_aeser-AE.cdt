#!RuleTest
#test CDISC-CG0041 expect=skipped domain=AE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0041 (Rule: AESER = 'Y'). AESER is withheld: Requirements.Variables.All [AESER] is unmet, so the rule must skip (row 1 has AESHOSP=Y and would otherwise be judged against an absent AESER)."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESHOSP type=Char label="Requires or Prolongs Hospitalization"
---
CDISCPILOT01 | AE | 01-701-1023 | 1 | PNEUMONIA | Y
