#!RuleTest
#test PMDA-SD1278 expect=violation domain=TS
#note "TSVAL 'BOTH' maps to two TSVALCD codes (C49636 vs C99999) -> the one-to-one relationship is broken; fires on both 'BOTH' rows."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 TSVAL=BOTH
#expectViolationAt row=3 TSVAL=BOTH
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
col TSVALCD  type=Char label="Parameter Value Code"
---
S1 | TS | 1 | SEXPOP  | Sex of Participants | BOTH | C49636
S1 | TS | 1 | INTTYPE | Intervention Type   | DRUG | C1909
S1 | TS | 2 | SEXPOP  | Sex of Participants | BOTH | C99999
