#!RuleTest
#test CDISC-CG0434 expect=noViolation domain=DM
#note "FRESH, DISCRIMINATING. Zero data rows. Full column block including AGE, AGEU and AGETXT (the fixture is about zero ROWS, not a missing column). Sensitivity RECORD (routing-census.tsv records 'Record' for this rule explicitly), no synthetic table, row loop runs zero times -> 0 findings."
#library standard=sdtmig version=3-4
#expectViolationCount 0
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AGE     type=Num  label="Age"
col AGEU    type=Char label="Age Units"
col AGETXT  type=Char label="Age Range"
---
