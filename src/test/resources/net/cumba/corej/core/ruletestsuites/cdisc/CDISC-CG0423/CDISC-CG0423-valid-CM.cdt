#!RuleTest
#test CDISC-CG0423 expect=noViolation domain=CM
# Rule:Description: Raise an error when --VAMT (Treatment Vehicle Amount) is populated but --TRTV (Treatment Vehicle) is empty.
#note "CMVAMT populated only where CMTRTV is also populated -> '--TRTV empty' is false, no violation"
dataset CM label="Concomitant Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ type=Num label="Sequence Number"
col CMVAMT type=Char label="Treatment Vehicle Amount"
col CMTRTV type=Char label="Treatment Vehicle"
---
CDISCPILOT01 | CM | 01-701-1015 | 1 | 100 | SALINE
CDISCPILOT01 | CM | 01-701-1015 | 2 |     |
---
