#!RuleTest
#test CDISC-CG0412 expect=noViolation domain=DM
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0412 (SDTMIG 3.2; Condition DM.ACTARMCD not in (SCRNFAIL, NOTASSGN, NOTTRT); Rule: subject records in DS > 0). Partially Executable (underreporting): the Check upper()-folds ACTARMCD, so a lower-case exemption literal would be exempted by the Check but flagged by the authority -- no such row is in this fixture (plan §2.4). Both subjects with a non-exempt ACTARMCD have a DS record; the three subjects without one carry exactly SCRNFAIL, NOTASSGN and NOTTRT."
#library standard=sdtmig version=3-2
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARMCD    type=Char label="Planned Arm Code"
col ACTARMCD type=Char label="Actual Arm Code"
---
CDISCPILOT01 | DM | 01-701-1015 | PBO      | PBO
CDISCPILOT01 | DM | 01-701-1023 | XANHI    | XANHI
CDISCPILOT01 | DM | 01-701-1028 | SCRNFAIL | SCRNFAIL
CDISCPILOT01 | DM | 01-701-1033 | NOTASSGN | NOTASSGN
CDISCPILOT01 | DM | 01-701-1034 | XANLO    | NOTTRT
---

dataset DS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSTERM  type=Char label="Reported Term for the Disposition Event"
col DSDECOD type=Char label="Standardized Disposition Term"
---
CDISCPILOT01 | DS | 01-701-1015 | 1 | COMPLETED | COMPLETED
CDISCPILOT01 | DS | 01-701-1023 | 1 | ADVERSE EVENT | ADVERSE EVENT
---
