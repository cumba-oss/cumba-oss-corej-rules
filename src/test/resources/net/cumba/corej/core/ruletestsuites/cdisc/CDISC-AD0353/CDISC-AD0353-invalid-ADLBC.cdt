#!RuleTest
#test CDISC-AD0353 expect=violation domain=ADLBC
# Rule:Description: BASETYPE is present, ByIND is populated, and ByIND is not equal to AyIND where ABLFL is equal to Y for a given value of PARAMCD and BASETYPE for a subject
#note "BASETYPE present, B1IND=HIGH != A1IND=LOW on the ABLFL=Y row -> violation"
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col BASETYPE type=Char
col ABLFL type=Char
col B1IND type=Char
col A1IND type=Char
---
CDISCPILOT01 | 01-701-1015 | GLUC | LAST | Y | HIGH | LOW
---
