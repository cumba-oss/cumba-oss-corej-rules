#!RuleTest
#test CDISC-AD0199 expect=violation domain=ADAE
# Rule:Description: A variable is present in ADaM with the same name as a variable present in SDTM but the variables do not have identical data types
#note "AESEQ is Char in ADAE but Num in SDTM AE -> different data types -> violation"
#expectViolationCount 1
#expectViolationAt variable_data_type=Char variable_name=AESEQ
dataset ADAE
col STUDYID type=Char
col USUBJID type=Char
col AESEQ type=Char
---
CDISCPILOT01 | 01-701-1015 | 1
---

dataset AE label="Adverse Events"
col STUDYID type=Char
col USUBJID type=Char
col AESEQ type=Num
---
CDISCPILOT01 | 01-701-1015 | 1
---
