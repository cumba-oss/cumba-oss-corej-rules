#!RuleTest
#test FDA-SE2257 expect=noViolation domain=TP
#note "Every TPSTGORD is a whole ordering position (1, 2, 3) -> no violation."
#library standard=sendig version=dart-1-1
dataset TP label="Trial Paths"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col RPATHCD  type=Char label="Planned Repro Path Code"
col RPATH    type=Char label="Description of Planned Repro Path"
col TPSTGORD type=Num  label="Order of Repro Stage within Repro Path"
col RSTGCD   type=Char label="Repro Stage Code"
---
S1 | TP | P1 | F0 GENERATION | 1 | PREMATING
S1 | TP | P1 | F0 GENERATION | 2 | MATING
S1 | TP | P1 | F0 GENERATION | 3 | GESTATION
