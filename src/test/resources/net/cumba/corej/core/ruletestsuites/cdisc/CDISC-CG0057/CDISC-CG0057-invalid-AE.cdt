#!RuleTest
#test CDISC-CG0057 expect=violation domain=AE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0057 (Condition: --ENTPT present in dataset; Rule: --ENRTPT present in dataset). The AE dataset carries AEENTPT but not AEENRTPT -> the dataset-level check fires once for the dataset (reported on its first record)."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEENTPT type=Char label="End Reference Time Point"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE | END OF STUDY
CDISCPILOT01 | AE | 01-701-1023 | 1 | NAUSEA |
