#!RuleTest
#test CDISC-CG0664 expect=noViolation domain=DM
#note "DM additions placed by role: DMXFN (Findings --XFN, a qualifier) after COUNTRY, then VISITNUM / VISIT / VISITDY (Timing) before DMDTC -> silent."
#library standard=sdtmig version=3-4
#library dataset-class DM Special-Purpose
#library model-column-order DM STUDYID DOMAIN USUBJID SUBJID RFSTDTC RFENDTC RFXSTDTC RFXENDTC RFCSTDTC RFCENDTC RFICDTC RFPENDTC DTHDTC DTHFL SITEID INVID INVNAM BRTHDTC AGE AGETXT AGEU SEX RACE ETHNIC SPECIES STRAIN SBSTRAIN ARMCD ARM ACTARMCD ACTARM ARMNRS ACTARMUD SETCD RPATHCD COUNTRY DMDTC DMDY
#library domain-variables DM STUDYID:Identifier DOMAIN:Identifier USUBJID:Identifier SUBJID:Topic "RFSTDTC:Record Qualifier" "RFENDTC:Record Qualifier" "RFXSTDTC:Record Qualifier" "RFXENDTC:Record Qualifier" "RFCSTDTC:Record Qualifier" "RFCENDTC:Record Qualifier" "RFICDTC:Record Qualifier" "RFPENDTC:Record Qualifier" "DTHDTC:Record Qualifier" "DTHFL:Record Qualifier" "SITEID:Record Qualifier" "INVID:Record Qualifier" "INVNAM:Synonym Qualifier" "BRTHDTC:Record Qualifier" "AGE:Record Qualifier" "AGEU:Variable Qualifier" "SEX:Record Qualifier" "RACE:Record Qualifier" "ETHNIC:Record Qualifier" "ARMCD:Record Qualifier" "ARM:Synonym Qualifier" "ACTARMCD:Record Qualifier" "ACTARM:Synonym Qualifier" "ARMNRS:Record Qualifier" "ACTARMUD:Record Qualifier" "COUNTRY:Record Qualifier" DMDTC:Timing DMDY:Timing
#library model-class-variables FINDINGS STUDYID:Identifier DOMAIN:Identifier USUBJID:Identifier POOLID:Identifier SPDEVID:Identifier NHOID:Identifier FETUSID:Identifier FOCID:Identifier --SEQ:Identifier --GRPID:Identifier --REFID:Identifier --RECID:Identifier --SPID:Identifier --LNKID:Identifier --LNKGRP:Identifier --TESTCD:Topic "--TEST:Synonym Qualifier" "--CNTMOD:Record Qualifier" "--EPCHGI:Record Qualifier" "--TSTOPO:Variable Qualifier" "--MODIFY:Synonym Qualifier" "--TSTDTL:Variable Qualifier" "--CAT:Grouping Qualifier" "--SCAT:Grouping Qualifier" "--POS:Record Qualifier" "--BODSYS:Record Qualifier" "--ORRES:Result Qualifier" "--ORRESU:Variable Qualifier" "--RESSCL:Record Qualifier" "--RESTYP:Record Qualifier" "--COLSRT:Variable Qualifier" "--ORNRLO:Variable Qualifier" "--ORNRHI:Variable Qualifier" "--ORREF:Variable Qualifier" "--LLOD:Variable Qualifier" "--STRESC:Result Qualifier" "--STRESN:Result Qualifier" "--STRESU:Variable Qualifier" "--STNRLO:Variable Qualifier" "--STNRHI:Variable Qualifier" "--STNRC:Variable Qualifier" "--STREFC:Variable Qualifier" "--STREFN:Variable Qualifier" "--NRIND:Variable Qualifier" "--RESCAT:Variable Qualifier" "--CHRON:Variable Qualifier" "--DISTR:Variable Qualifier" "--RESLOC:Record Qualifier" "--STAT:Record Qualifier" "--REASND:Record Qualifier" "--XFN:Record Qualifier" "--NAM:Record Qualifier" "--LOINC:Record Qualifier" "--SPEC:Record Qualifier" "--ANTREG:Variable Qualifier" "--SPCCND:Record Qualifier" "--SPCUFL:Record Qualifier" "--LOC:Record Qualifier" "--LAT:Variable Qualifier" "--DIR:Variable Qualifier" "--PORTOT:Variable Qualifier" "--METHOD:Record Qualifier" "--RUNID:Record Qualifier" "--ANMETH:Record Qualifier" "--TMTHSN:Record Qualifier" "--LEAD:Record Qualifier" "--CSTATE:Record Qualifier" "--LOBXFL:Record Qualifier" "--BLFL:Record Qualifier" "--FAST:Record Qualifier" "--DRVFL:Record Qualifier" "--EVAL:Record Qualifier" "--EVALID:Variable Qualifier" "--ACPTFL:Record Qualifier" "--TOX:Variable Qualifier" "--TOXGR:Record Qualifier" "--SEV:Record Qualifier" "--CLSIG:Record Qualifier" "--DTHREL:Record Qualifier" "--LLOQ:Variable Qualifier" "--ULOQ:Variable Qualifier" "--REASPF:Record Qualifier" "--EXCLFL:Record Qualifier" "--REASEX:Record Qualifier" "--USCHFL:Record Qualifier" "--REPNUM:Record Qualifier" "--RSTIND:Record Qualifier" "--RSTMOD:Record Qualifier" VISITNUM:Timing VISIT:Timing VISITDY:Timing TAETORD:Timing EPOCH:Timing RPHASE:Timing RPPLDY:Timing RPPLSTDY:Timing RPPLENDY:Timing --DTC:Timing --ENDTC:Timing --DY:Timing --ENDY:Timing --NOMDY:Timing --NOMLBL:Timing --RPDY:Timing --RPSTDY:Timing --RPENDY:Timing --XDY:Timing --XENDY:Timing --CHDY:Timing --CHENDY:Timing --DUR:Timing --TPT:Timing --TPTNUM:Timing --ELTM:Timing --TPTREF:Timing --RFTDTC:Timing --STRF:Timing --ENRF:Timing --EVLINT:Timing --EVINTX:Timing --STRTPT:Timing --STTPT:Timing --ENRTPT:Timing --ENTPT:Timing MIDS:Timing RELMIDS:Timing MIDSDTC:Timing --STINT:Timing --ENINT:Timing --DETECT:Timing
#library model-class-variables EVENTS STUDYID:Identifier DOMAIN:Identifier USUBJID:Identifier POOLID:Identifier SPDEVID:Identifier NHOID:Identifier FETUSID:Identifier FOCID:Identifier --SEQ:Identifier --GRPID:Identifier --REFID:Identifier --RECID:Identifier --SPID:Identifier --LNKID:Identifier --LNKGRP:Identifier --TERM:Topic "--MODIFY:Synonym Qualifier" "--LLT:Variable Qualifier" "--LLTCD:Variable Qualifier" "--DECOD:Synonym Qualifier" "--PTCD:Variable Qualifier" "--HLT:Variable Qualifier" "--HLTCD:Variable Qualifier" "--HLGT:Variable Qualifier" "--HLGTCD:Variable Qualifier" "--CAT:Grouping Qualifier" "--SCAT:Grouping Qualifier" "--PRESP:Variable Qualifier" "--OCCUR:Record Qualifier" "--REASOC:Record Qualifier" "--STAT:Record Qualifier" "--REASND:Record Qualifier" "--BODSYS:Record Qualifier" "--BDSYCD:Variable Qualifier" "--SOC:Variable Qualifier" "--SOCCD:Variable Qualifier" "--CNTMOD:Record Qualifier" "--EPCHGI:Record Qualifier" "--LOC:Record Qualifier" "--LAT:Variable Qualifier" "--DIR:Variable Qualifier" "--PORTOT:Variable Qualifier" "--PARTY:Record Qualifier" "--PRTYID:Variable Qualifier" "--SEV:Record Qualifier" "--SER:Record Qualifier" "--ACN:Record Qualifier" "--ACNOTH:Record Qualifier" "--ACNDEV:Record Qualifier" "--REL:Record Qualifier" "--RLDEV:Record Qualifier" "--RELNST:Record Qualifier" "--PATT:Record Qualifier" "--OUT:Record Qualifier" "--SCAN:Record Qualifier" "--SCONG:Record Qualifier" "--SDISAB:Record Qualifier" "--SDTH:Record Qualifier" "--SHOSP:Record Qualifier" "--SLIFE:Record Qualifier" "--SOD:Record Qualifier" "--SMIE:Record Qualifier" "--CONTRT:Record Qualifier" "--TOX:Variable Qualifier" "--TOXGR:Record Qualifier" "--USCHFL:Record Qualifier" VISITNUM:Timing VISIT:Timing VISITDY:Timing TAETORD:Timing EPOCH:Timing RPHASE:Timing RPPLDY:Timing RPPLSTDY:Timing RPPLENDY:Timing --DTC:Timing --STDTC:Timing --ENDTC:Timing --DY:Timing --STDY:Timing --ENDY:Timing --NOMDY:Timing --NOMLBL:Timing --RPDY:Timing --RPSTDY:Timing --RPENDY:Timing --XDY:Timing --XSTDY:Timing --XENDY:Timing --CHDY:Timing --CHSTDY:Timing --CHENDY:Timing --DUR:Timing --TPT:Timing --TPTNUM:Timing --ELTM:Timing --TPTREF:Timing --RFTDTC:Timing --STRF:Timing --ENRF:Timing --EVLINT:Timing --EVINTX:Timing --STRTPT:Timing --STTPT:Timing --ENRTPT:Timing --ENTPT:Timing MIDS:Timing RELMIDS:Timing MIDSDTC:Timing --STINT:Timing --ENINT:Timing --DETECT:Timing
#expectViolationCount 0
dataset DM
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col SUBJID   type=Char
col ARMCD    type=Char
col ARM      type=Char
col COUNTRY  type=Char
