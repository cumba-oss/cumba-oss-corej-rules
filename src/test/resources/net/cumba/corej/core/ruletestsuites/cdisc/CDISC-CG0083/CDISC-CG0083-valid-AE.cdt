#!RuleTest
#test CDISC-CG0083 expect=noViolation domain=AE
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0083 (Rule: --BDSYCD and --BODSYS have a one-to-one relationship). Each AEBDSYCD maps to exactly one AEBODSYS and vice versa (10029205 = NERVOUS SYSTEM DISORDERS on two records, 10037175 = PSYCHIATRIC DISORDERS, 10017947 = GASTROINTESTINAL DISORDERS) -> silent."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEBODSYS type=Char label="Body System or Organ Class"
col AEBDSYCD type=Num  label="Body System or Organ Class Code"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE | NERVOUS SYSTEM DISORDERS | 10029205
CDISCPILOT01 | AE | 01-701-1015 | 2 | DIZZINESS | NERVOUS SYSTEM DISORDERS | 10029205
CDISCPILOT01 | AE | 01-701-1023 | 1 | INSOMNIA | PSYCHIATRIC DISORDERS | 10037175
CDISCPILOT01 | AE | 01-701-1028 | 1 | NAUSEA | GASTROINTESTINAL DISORDERS | 10017947
