#!RuleTest
#test FDA-SD1362 expect=violation domain=DM
#note "Row 1 has ACTARM without ACTARMCD -> the parent's half of the R-5.25 split fires. Row 2 (ACTARMCD without ACTARM) is the SIBLING FDA-SD1362-A's state and must NOT fire here - the discriminator of the split. Rows 3/4 are the paired cases."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ACTARMCD type=Char label="Actual Arm Code"
col ACTARM   type=Char label="Description of Actual Arm"
---
S1 | DM | 001 |   | Treatment A
S1 | DM | 002 | B |
S1 | DM | 003 | C | Treatment C
S1 | DM | 004 |   |
