#!RuleTest
#test CDISC-SEND-0305 expect=executionError domain=DM
#expect-execution-error "over 'POOLDEF' has no usable key"
#note "PLAN-join-key-one-side-absent-drop QK17 review (2026-10-11): POOLDEF has NO USUBJID column (it is Req there, so only nonconformant data reaches this). The pool part reads POOLDEF per subject, group=[USUBJID], a key the rule's dataset carries and POOLDEF does not, so no key member is left on both sides and the rule ERRORs (QK16 (b)) - never a pool extreme taken over the whole of POOLDEF. Pinned as the measured answer; a gate declaring POOLDEF.USUBJID would turn it into a SKIP. Derived from CDISC-SEND-0305-valid_pool_later-DM.cdt with POOLDEF.USUBJID removed."
#library standard=sendig version=3-1-1
dataset DM label=Demographics
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFXSTDTC type=Char label="Date/Time of First Study Treatment"
---
S1 | DM | 001 | 2020-01-01
---
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col POOLID  type=Char label="Pool Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
---
S1 | EX | 001 |  | 1 | DRUG A | 2020-01-01
S1 | EX |  | P1 | 2 | DRUG A | 2020-01-05
---
dataset POOLDEF label="Pool Definition"
col STUDYID type=Char label="Study Identifier"
col POOLID  type=Char label="Pool Identifier"
---
S1 | P1
---
