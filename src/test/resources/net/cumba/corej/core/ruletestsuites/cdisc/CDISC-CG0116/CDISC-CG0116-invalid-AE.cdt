#!RuleTest
#test CDISC-CG0116 expect=violation domain=AE
# Rule:Description: Raise an error when --LOC is not present but --DIR is present.
#note "AEDIR column present while AELOC column is absent"
#expectViolationCount 1
#expectViolationAt row=1
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AEDIR type=Char label="Directionality"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | UPPER
CDISCPILOT01 | AE | 01-701-1015 | 2 | LOWER
---
