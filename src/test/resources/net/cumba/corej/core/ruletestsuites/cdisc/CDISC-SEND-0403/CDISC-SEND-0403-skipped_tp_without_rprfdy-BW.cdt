#!RuleTest
#test CDISC-SEND-0403 expect=skipped domain=BW
#note "PLAN-rprfdy-offset-tp-join: the RPRFDY offset is applied again, read from TP through DM.RPATHCD by read_value(RPRFDY, domain="TP", group=[DM.RPATHCD, RPHASE], mode="MAX") (owner EC-47 option B, C2, D-SJ, D-GUARD (b)), §6.2 case 2: TP without RPRFDY — TP.RPRFDY:N is in Requirements.Variables.All, so the rule SKIPS. The record carries a wrong day (99). Red-before on the W2b rule: fired."
#library standard=sendig-dart version=1-2
dataset BW class=FINDINGS label="Body Weight"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col BWSEQ   type=Num  label="Sequence Number"
col RPHASE  type=Char label="Repro Phase"
col BWENDTC type=Char label="End Date/Time of Observation"
col BWRPENDY type=Num  label="Repro Phase Day of End of Observation"
---
S1 | BW | 001 | 1 | P1 | 2020-01-15 | 99
---
dataset SJ class="SPECIAL PURPOSE" label="Subject Repro Stages"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SJSEQ   type=Num  label="Sequence Number"
col RPHASE  type=Char label="Repro Phase"
col RSTAGE  type=Char label="Repro Stage"
col SJSTDTC type=Char label="Start Date/Time of Repro Stage"
col SJENDTC type=Char label="End Date/Time of Repro Stage"
---
S1 | SJ | 001 | 1 | P1 | STAGE1 | 2020-01-01 | 2020-01-20
---
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RPATHCD type=Char label="Planned Repro Path Code"
---
S1 | DM | 001 | A
---
dataset TP class="TRIAL DESIGN" label="Trial Repro Paths"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col RPATHCD  type=Char label="Planned Repro Path Code"
col TPSTGORD type=Num  label="Order of Repro Stage within Repro Path"
col RSTGCD   type=Char label="Repro Stage Code"
col RSTAGE   type=Char label="Description of Repro Stage"
col RPHASE   type=Char label="Repro Phase"
---
S1 | TP | A | 1 | STG1 | Stg1 | P1
---
