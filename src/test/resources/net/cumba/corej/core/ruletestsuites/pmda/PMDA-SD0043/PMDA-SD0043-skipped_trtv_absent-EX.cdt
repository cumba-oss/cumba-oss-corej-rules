#!RuleTest
#test PMDA-SD0043 expect=skipped domain=EX
#note "EXTRTV is not present in the dataset while EXVAMT is populated, so Requirements.Variables.All [--TRTV, --VAMT] gates the rule off; variable absence is the presence rules' business - the standing guard-matrix adjudication."
#library standard=sdtmig version=3-4
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXVAMT  type=Num  label="Treatment Vehicle Amount"
---
CDISCPILOT01 | EX | 01-701-1015 | 1 | DRUG A | 5
CDISCPILOT01 | EX | 01-701-1015 | 2 | DRUG A | 10
