#!RuleTest
#test FDA-SE2252 expect=violation domain=SJ
#note "RSTGCD on row 2 is 9 characters, one past the 8-character limit -> fires; the 8-character row 1 is the passing boundary."
#library standard=sendig-dart version=1-1
#expectViolationCount 1
#expectViolationAt row=2 RSTGCD=LACTPERIX
dataset SJ label="Subject Repro Stages"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SJSEQ   type=Num  label="Sequence Number"
col RSTGCD  type=Char label="Repro Stage Code"
---
S1 | SJ | 001 | 1 | LACTPERI
S1 | SJ | 001 | 2 | LACTPERIX
