#!RuleTest
#test FDA-SD1082 expect=violation domain=LB
#note "Round 2026-10-12: the near-miss of the width-1 exemption. LBSTRESC is empty in every row but declared length=5, so it could be sized down to 1 and still fires (5 != 0); the var_length() > 1 guard exempts only the width-1 column. Every other character variable is sized exactly."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt variable_name=LBSTRESC variable_size=5
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char length=12 label="Study Identifier"
col DOMAIN   type=Char length=2  label="Domain Abbreviation"
col USUBJID  type=Char length=11 label="Unique Subject Identifier"
col LBSEQ    type=Num  length=8  label="Sequence Number"
col LBTESTCD type=Char length=4  label="Lab Test or Examination Short Name"
col LBSTRESC type=Char length=5  label="Character Result/Finding in Std Format"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | GLUC |
CDISCPILOT01 | LB | 01-701-1023 | 2 | ALB  |
