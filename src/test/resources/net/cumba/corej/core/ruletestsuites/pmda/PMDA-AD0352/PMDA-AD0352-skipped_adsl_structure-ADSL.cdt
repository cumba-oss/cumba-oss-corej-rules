#!RuleTest
#test PMDA-AD0352 expect=skipped domain=ADSL
#note "SUBJECT LEVEL ANALYSIS DATASET is not among Data_Structures.Include:[BASIC DATA STRUCTURE, MEDICAL DEVICE BASIC DATA STRUCTURE] and has no supertype that is -> pre-gate reports out of scope before the expander is reached. THE BATCH'S SINGLE PIN on the [BDS, MD-BDS] block, which AD0352 carries alone. Firing shape carried by the row so the skip is not mistaken for silence."
#library standard=adamig version=1-3
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col A1IND   type=Char
