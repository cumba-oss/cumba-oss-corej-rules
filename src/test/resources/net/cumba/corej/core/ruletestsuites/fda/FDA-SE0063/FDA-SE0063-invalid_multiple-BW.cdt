#!RuleTest
#test FDA-SE0063 expect=violation domain=BW
#note "Two independently mislabelled variables: BWSTRESN labelled 'Body Weight in Grams' and BWTESTCD labelled 'Test Code'. Each variable's label is its own defect, so both must be reported."
#library standard=sendig version=3-1-1
#library variable-metadata BW BWTESTCD name=BWTESTCD label="Test Short Name"
#library variable-metadata BW BWSTRESC name=BWSTRESC label="Standardized Result in Character Format"
#library variable-metadata BW BWSTRESN name=BWSTRESN label="Standardized Result in Numeric Format"
#expectViolationCount 2
#expectViolationAt variable_name=BWTESTCD
#expectViolationAt variable_name=BWSTRESN
dataset BW label="Body Weight"
col STUDYID  type=Char label="Study Identifier"
col USUBJID  type=Char label="Unique Subject Identifier"
col BWTESTCD type=Char label="Test Code"
col BWSTRESC type=Char label="Standardized Result in Character Format"
col BWSTRESN type=Num  label="Body Weight in Grams"
---
S1 | 001 | BW | 250 | 250
