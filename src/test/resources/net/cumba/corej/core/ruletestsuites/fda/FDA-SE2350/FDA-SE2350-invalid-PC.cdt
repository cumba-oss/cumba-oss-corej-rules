#!RuleTest
#test FDA-SE2350 expect=violation domain=PC
#note "Row 2 has PCLLOQ populated while PCSTRESU is empty -> fires; rows 1 and 3 are conformant."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=2 PCSEQ=2 PCSTRESU=
dataset PC class=FINDINGS label="Pharmacokinetics Concentrations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PCSEQ    type=Num  label="Sequence Number"
col PCTESTCD type=Char label="Test Short Name"
col PCSTRESU type=Char label="Unit of the Standardized Result"
col PCLLOQ   type=Num  label="Lower Limit of Quantitation"
---
S1 | PC | 001 | 1 | DRUGX | ng/mL | 0.5
S1 | PC | 001 | 2 | DRUGX |       | 0.5
S1 | PC | 001 | 3 | DRUGX |       | .
