#!RuleTest
#test FDA-SE2237 expect=violation domain=TS
#note "Synthetic NULLFLAV codelist terms {NA, UNKNOWN, MASKED} (real SEND CT C150810 subset). Row 1: TSVAL='NA' is a NULLFLAV term recorded in TSVAL instead of TSVALNF -> fires. Row 2: TSVAL='UNKNOWN' -> fires. Row 3: ordinary value -> clean. Row 4: empty TSVAL -> guarded out by non_empty."
#library standard=sendig version=3-1-1
#library codelist-terms NULLFLAV NA UNKNOWN MASKED
#expectViolationCount 2
#expectViolationAt row=1 TSVAL=NA
#expectViolationAt row=2 TSVAL=UNKNOWN
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL    type=Char label="Parameter Value"
col TSVALNF  type=Char label="Parameter Null Flavor"
---
S1 | TS | 1 | SPLANSUB | NA        |
S1 | TS | 1 | AGEU     | UNKNOWN   |
S1 | TS | 1 | SSPONSOR | ACME LABS |
S1 | TS | 1 | SDESIGN  |           | MASKED
