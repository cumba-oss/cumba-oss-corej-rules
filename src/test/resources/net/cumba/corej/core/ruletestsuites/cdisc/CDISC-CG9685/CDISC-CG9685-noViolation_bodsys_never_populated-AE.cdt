#!RuleTest
#test CDISC-CG9685 expect=noViolation domain=AE
#note "AEBDSYCD column absent, but AEBODSYS is empty on every record: there is no populated body system that would need its code, so nothing is reported."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col AESEQ    type=Num
col AETERM   type=Char
col AEBODSYS type=Char
---
S1 | AE | 001 | 1 | HEADACHE |
S1 | AE | 001 | 2 | NAUSEA |
---
