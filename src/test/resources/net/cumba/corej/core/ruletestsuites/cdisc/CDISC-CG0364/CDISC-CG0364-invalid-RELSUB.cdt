#!RuleTest
#test CDISC-CG0364 expect=violation domain=RELSUB
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0364 (Domain RELSUB, Variable RSUBJID; Condition: RSUBJID ^= null; Rule: RSUBJID ^= POOLID). A pool cannot be related to itself. Row 2 is a pool record whose RSUBJID=POOL02 equals its own POOLID -> fires. Row 1 (subject record, POOLID empty) and row 3 (pool POOL03 related to subject 01-701-1028) are silent."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 POOLID=POOL02 RSUBJID=POOL02
dataset RELSUB class=RELATIONSHIP label="Related Subjects"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col POOLID  type=Char label="Pool Identifier"
col RSUBJID type=Char label="Related Subject or Pool Identifier"
col SREL    type=Char label="Subject Relationship"
---
CDISCPILOT01 | 01-701-1015 |        | 01-701-1016 | MOTHER, BIOLOGICAL
CDISCPILOT01 |             | POOL02 | POOL02      | POOL MEMBER
CDISCPILOT01 |             | POOL03 | 01-701-1028 | POOL MEMBER
---
