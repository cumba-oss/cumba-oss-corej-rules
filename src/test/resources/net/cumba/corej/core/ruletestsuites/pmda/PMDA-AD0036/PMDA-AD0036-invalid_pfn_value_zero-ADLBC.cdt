#expectViolationCount 1
#expectViolationAt row=2 variable_name=SAFPFN USUBJID=01-701-1023
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col SAFPFN  type=Num
