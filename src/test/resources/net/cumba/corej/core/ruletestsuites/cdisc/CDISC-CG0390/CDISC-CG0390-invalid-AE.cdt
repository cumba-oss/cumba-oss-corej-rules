#!RuleTest
#test CDISC-CG0390 expect=violation domain=AE
# Rule:Description: Raise an error when AESDISAB is populated and its value is not 'Y' or 'N'.
#note "AESDISAB is populated with a value outside the (Y, N) codelist"
#expectViolationCount 1
#expectViolationAt row=1 AESEQ=1 USUBJID=01-701-1015
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AESDISAB type=Char label="Persist or Signif Disability/Incapacity" format=$YN.
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | MAYBE
CDISCPILOT01 | AE | 01-701-1015 | 2 | N
CDISCPILOT01 | AE | 01-701-1023 | 1 | Y
---
