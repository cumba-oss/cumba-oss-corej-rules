#!RuleTest
#test CDISC-CG0501 expect=noViolation domain=DM
# Rule:Description: Raise an error when the Disease Milestone Instance Name (MIDS) variable is present in a dataset but the Trial Disease Milestones (TM) dataset is not present in the study.
#note "No MIDS variable is present, so the rule does not fire"
dataset DM label=Demographics
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | DM | 01-701-1015
CDISCPILOT01 | DM | 01-701-1023
---
