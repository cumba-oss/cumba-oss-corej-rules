#!RuleTest
#test CDISC-CG0366 expect=noViolation domain=APAE
# Rule:Description: Raise an error when Related Device Identifier (RDEVID) is populated and Related Subject or Pool Identifier (RSUBJID) is also populated for the same record.
#note "RDEVID is populated and RSUBJID is empty on the APAE record"
dataset APAE label="Associated Persons Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col APID type=Char label="Associated Persons Identifier"
col AESEQ type=Num label="Sequence Number"
col RSUBJID type=Char label="Related Subject or Pool Identifier"
col RDEVID type=Char label="Related Device Identifier"
---
CDISCPILOT01 | APAE | AP-701-1015 | 1 |  | DEV-001
---
