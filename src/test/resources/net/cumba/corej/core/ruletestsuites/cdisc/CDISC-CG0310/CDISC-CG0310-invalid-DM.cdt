#!RuleTest
#test CDISC-CG0310 expect=violation domain=DM
# Rule:Description: Raise an error when a variable name is longer than 8 characters.
#note "variable name DOMAINLONG is 10 chars (> 8)"
#expectViolationCount 1
#expectViolationAt variable_name=DOMAINLONG
dataset DM label=Demographics
col STUDYID type=Char label="Study Identifier"
col DOMAINLONG type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | DM | 01-701-1015
CDISCPILOT01 | DM | 01-701-1023
---
