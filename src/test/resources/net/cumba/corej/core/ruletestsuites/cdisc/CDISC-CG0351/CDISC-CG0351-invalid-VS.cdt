#!RuleTest
#test CDISC-CG0351 expect=violation domain=VS
#note "VSXTRA is not in the SDTM Model list of allowed variables for the FINDINGS class (get_model_column_order) -> fires on that variable only. W4 (PLAN-list-functions phase 0, scenarios-first on the pre-port engine)."
#library standard=sdtmig version=3-4
#library dataset-class VS FINDINGS
#library model-column-order VS STUDYID DOMAIN USUBJID VSSEQ VSTESTCD VSORRES VSDTC
#expectViolationCount 1
#expectViolationAt variable_name=VSXTRA
dataset VS class=FINDINGS label="Vital Signs"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VSSEQ    type=Num  label="Sequence Number"
col VSTESTCD type=Char label="Vital Signs Test Short Name"
col VSORRES  type=Char label="Result or Finding in Original Units"
col VSXTRA   type=Char label="Sponsor Defined"
---
S1 | VS | 001 | 1 | SYSBP | 120 | X
