#!RuleTest
#test PMDA-SD0053 expect=skipped domain=DM
#note "ARMCD is not declared. Requirements.Variables.All: [ARM, ARMCD] requires BOTH columns present, so the rule is SKIPPED for this dataset. This is the fixture that distinguishes PMDA-SD0053 from its FDA twin, which carries no Variables gate and would execute here."
#library standard=sdtmig version=3-2
dataset DM
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col ARM     type=Char
---
S1 | DM | 001 | Not Assigned
S1 | DM | 002 | Placebo
