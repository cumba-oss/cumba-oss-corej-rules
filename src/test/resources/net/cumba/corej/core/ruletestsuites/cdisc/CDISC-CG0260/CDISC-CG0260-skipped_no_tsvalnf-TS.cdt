#!RuleTest
#test CDISC-CG0260 expect=skipped domain=TS
#note "TS deliberately carries no TSVALNF column. Requirements.Variables.All is [TSVALNF]; TSVALNF is Perm in TS, so a TS dataset that never needs a null flavor legitimately omits the column and the rule SKIPS."
#library standard=sdtmig version=3-4
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S1 | TS | 1 | TITLE  | Trial Title     | A Study of X
S1 | TS | 2 | AGEMAX | Planned Max Age | 65
