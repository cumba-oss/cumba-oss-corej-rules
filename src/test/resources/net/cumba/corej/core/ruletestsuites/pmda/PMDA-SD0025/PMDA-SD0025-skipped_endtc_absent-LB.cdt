#!RuleTest
#test PMDA-SD0025 expect=skipped domain=LB
#note "LBENDTC (Permissible, listed in Requirements.Variables.All) is not present at all. There is no end date to compare against, so nothing can be flagged -- the Check's --ENDTC non_empty leaf is naturally no-fire on an absent column in both engines, and Java additionally skips the rule via Requirements.Variables."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBDTC    type=Char label="Date/Time of Specimen Collection"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | GLUC | 2020-01-01T08:00
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALB  | 2020-02-01T08:00
