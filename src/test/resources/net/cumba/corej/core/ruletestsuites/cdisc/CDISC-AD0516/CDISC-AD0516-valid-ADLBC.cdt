#!RuleTest
#test CDISC-AD0516 expect=noViolation domain=ADLBC
# Rule:Description: A variable ending in ETM must contain "End Time" in the label
#note "AETM label contains "End Time" -> noViolation"
#library standard=adamig version=1-3
#library column-order ADLBC STUDYID USUBJID PARAMCD
#library variable-metadata ADLBC *ETM name=*ETM label="{End Time}"
#library variable-metadata ADLBC *TM name=*TM label="{Time}"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AETM type=Char label="Analysis End Time"
---
CDISCPILOT01 | 01-701-1015 | ALB | x
---
