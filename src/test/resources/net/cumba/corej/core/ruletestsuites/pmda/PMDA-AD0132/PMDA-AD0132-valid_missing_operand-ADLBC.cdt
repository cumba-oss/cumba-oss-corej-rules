#!RuleTest
#test PMDA-AD0132 expect=noViolation domain=ADLBC
#note "Each row is missing exactly one of the three operands while the other two would mismatch. Every row is skipped by the arithmetic operator before comparison. Row 2 also exercises the B.1 corner: missing BASE makes BASE != 0 TRUE, so silence comes from the divide leaf alone."
#library standard=adamig version=1-3
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col BASE    type=Num
col R2BASE  type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | .  | 5 | 3
CDISCPILOT01 | 01-701-1023 | ALB | 10 | . | 3
CDISCPILOT01 | 01-701-1034 | ALB | 10 | 5 | .
