#!RuleTest
#test PMDA-SD1461 expect=skipped domain=MH
#note "MHBDSYCD present (and blank) but MHBODSYS is not a column: Requirements.Variables.All [--BODSYS, --BDSYCD] skips the record rule. Discriminating for the All gate's --BODSYS member only (not for the verdict): without it the absent MHBODSYS reads as a constant missing value, the check is false on every record and the rule would answer noViolation instead of skipped."
#library standard=sdtmig version=3-4
dataset MH
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col MHSEQ    type=Num
col MHBDSYCD type=Num
---
S1 | MH | 001 | 1 | .
---
