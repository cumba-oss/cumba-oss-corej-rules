#!RuleTest
#test DRAFT-900021 expect=noViolation domain=VS
#note "Same as invalid (define enumerates BOGUS for VSPOS, BOGUS2 for VSLAT) but the library declares BOTH codelists codelist_extensible=true. The rule is non-extensible-only: sponsor terms on an extensible codelist are legitimate -> silent. This is the intent discriminator (mirrors the FDA-CT2004 valid_extensible pattern)."
#library standard=sdtmig version=3-4
#library variable-metadata VS VSPOS codelist=C71148 codelist_extensible=true codelist_coded_values="[\"SUPINE\",\"STANDING\"]"
#library variable-metadata VS VSLAT codelist=C99074 codelist_extensible=true codelist_coded_values="[\"LEFT\",\"RIGHT\"]"
#define domain-variables VS VSTESTCD:Topic VSPOS:Qualifier VSLAT:Qualifier
#define variable-metadata VS VSPOS name=VSPOS codelist_coded_values="[\"SUPINE\",\"BOGUS\"]"
#define variable-metadata VS VSLAT name=VSLAT codelist_coded_values="[\"LEFT\",\"BOGUS2\"]"
#define variable-metadata VS VSTESTCD name=VSTESTCD codelist_coded_values="[\"SYSBP\"]"
dataset VS class=FINDINGS
col USUBJID  type=Char
col VSTESTCD type=Char
col VSPOS    type=Char
col VSLAT    type=Char
---
001 | SYSBP | SUPINE | LEFT
---
