#!RuleTest
#test CDISC-AD0375 expect=noViolation domain=ADLBC
# Rule:Description: On a given record, a variable which has a suffix of GRyN is populated and a variable with the same root name and suffix of GRy is not populated
#note "AETOXGR1N populated and AETOXGR1 populated -> noViolation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col AETOXGR1N type=Char
col AETOXGR1 type=Char
---
CDISCPILOT01 | 01-701-1015 | VAL | VAL
---
