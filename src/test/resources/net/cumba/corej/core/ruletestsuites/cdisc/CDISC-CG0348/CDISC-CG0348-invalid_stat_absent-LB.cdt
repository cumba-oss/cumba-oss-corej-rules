#!RuleTest
#test CDISC-CG0348 expect=violation domain=LB
#note "LBSTAT ABSENT (reads blank, so empty(--STAT) is true on every record: nothing is not-done). Row 1: LBDRVFL null, LBORRES empty -> fires. Row 2: derived -> exempt. Row 3: LBDRVFL 'N' -> fires. Row 4: result present -> clean. Verdict identity with the old not var_exists(\"--STAT\") and --DRVFL != \"Y\" arm; per record, LBORRES is populated on row 4 so nothing collapses either way."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 LBSEQ=1
#expectViolationAt row=3 LBSEQ=3
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBDRVFL  type=Char label="Derived Flag"
col LBORRES  type=Char label="Result or Finding in Original Units"
---
S1 | LB | 001 | 1 | ALT |  | 
S1 | LB | 001 | 2 | AST | Y | 
S1 | LB | 001 | 3 | ALB | N | 
S1 | LB | 001 | 4 | CA |  | 9.1
