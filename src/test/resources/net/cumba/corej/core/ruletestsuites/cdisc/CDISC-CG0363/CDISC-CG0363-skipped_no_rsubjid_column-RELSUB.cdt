#!RuleTest
#test CDISC-CG0363 expect=skipped domain=RELSUB
#note "Authority: SDTM and SDTMIG Conformance Rules v2.0 CG0363 (Condition: RSUBJID ^= null; Rule: RSUBJID ^= USUBJID). The RELSUB dataset carries no RSUBJID column; Requirements.Variables.All [RSUBJID, USUBJID] is unmet, so the rule skips."
#library standard=sdtmig version=3-4
dataset RELSUB class=RELATIONSHIP label="Related Subjects"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col POOLID  type=Char label="Pool Identifier"
col SREL    type=Char label="Subject Relationship"
---
CDISCPILOT01 | 01-701-1015 |  | MOTHER, BIOLOGICAL
---
