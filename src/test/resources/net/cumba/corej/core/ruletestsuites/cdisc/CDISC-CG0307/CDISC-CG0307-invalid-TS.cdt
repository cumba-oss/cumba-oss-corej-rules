#!RuleTest
#test CDISC-CG0307 expect=violation domain=TS
# Rule:Description: Raise an error when TSPARM and TSPARMCD do not have a one-to-one relationship.
#note "TSPARMCD 'AGEMAX' maps to two different TSPARM names, breaking the 1:1 relationship"
#expectViolationCount 2
#expectViolationAt row=1
#expectViolationAt row=2
dataset TS label="Trial Summary"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM type=Char label="Trial Summary Parameter"
---
CDISCPILOT01 | TS | AGEMAX | Planned Maximum Age of Subjects
CDISCPILOT01 | TS | AGEMAX | Added on to Existing Treatments
---
