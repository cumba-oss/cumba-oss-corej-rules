#!RuleTest
#test CDISC-AD0709 expect=violation domain=ADSL
#note "ADaMIG 1.3 section 3: descriptive text is allowed at the end of the labels of variables whose names contain the indexes y or zz - not xx (D8, PLAN-library-template-label-resolution). TRT01P's template is the exact text 'Planned Treatment for Period 01', so a trailing ' (Study Part A)' does not conform -> one violation."
#library standard=adamig version=1-3
#library variable-metadata ADSL TRTxxP name=TRTxxP label="Planned Treatment for Period xx"
#expectViolationCount 1
#expectViolationAt variable_name=TRT01P variable_label="Planned Treatment for Period 01 (Study Part A)"
dataset ADSL
col STUDYID type=Char label="Study Identifier"
col TRT01P  type=Char label="Planned Treatment for Period 01 (Study Part A)"
---
CDISCPILOT01 | Placebo
---
