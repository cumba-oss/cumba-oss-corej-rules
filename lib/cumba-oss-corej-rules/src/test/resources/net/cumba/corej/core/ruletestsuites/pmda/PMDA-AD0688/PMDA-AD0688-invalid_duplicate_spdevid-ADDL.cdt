#!RuleTest
#test PMDA-AD0688 expect=violation domain=ADDL
#note "AD*-named with no BDS/OCCDS/PARAMCD signal -> ADAM OTHER, refined by SPDEVID to DEVICE LEVEL ANALYSIS DATASET. Key is the COMBINED (SPDEVID, USUBJID) tuple: rows 1-2 share the tuple, row 3 differs by USUBJID. not is_unique_set flags EVERY row of a duplicate tuple -> TWO violations."
#library standard=adamig version=1-3
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015 SPDEVID=DEV1
#expectViolationAt row=2 USUBJID=01-701-1015 SPDEVID=DEV1
dataset ADDL
col STUDYID type=Char
col USUBJID type=Char
col SPDEVID type=Char
col AGE     type=Num
---
CDISCPILOT01 | 01-701-1015 | DEV1 | 56
CDISCPILOT01 | 01-701-1015 | DEV1 | 56
CDISCPILOT01 | 01-701-1023 | DEV1 | 61
