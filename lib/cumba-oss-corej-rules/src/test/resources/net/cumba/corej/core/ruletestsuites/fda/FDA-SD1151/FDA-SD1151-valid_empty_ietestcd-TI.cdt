#!RuleTest
#test FDA-SD1151 expect=noViolation domain=TI
#note "Boundary: one record of the criterion leaves IETESTCD empty while the others agree on INCL01. An empty code is excluded from the consistency computation."
#library standard=sdtmig version=3-4
dataset TI label="Trial Inclusion/Exclusion Criteria"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col IETESTCD type=Char label="Incl/Excl Criterion Short Name"
col IETEST   type=Char label="Inclusion/Exclusion Criterion"
col IECAT    type=Char label="Inclusion/Exclusion Category"
---
S1 | TI | INCL01 | Age 18 years or older | INCLUSION
S1 | TI |        | Age 18 years or older | INCLUSION
S1 | TI | INCL01 | Age 18 years or older | INCLUSION
