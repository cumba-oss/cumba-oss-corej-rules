#!RuleTest
#test PMDA-SD1248 expect=violation domain=EC
#note "Row 2 (ECDOSE=0) and row 3 (ECDOSE=-5) record a not-taken dose with ECOCCUR='N' but a dose that is not greater than 0 -> both fire. Row 1 carries the intended positive planned amount and row 4 leaves ECDOSE missing."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=2 ECOCCUR=N ECDOSE=0
#expectViolationAt row=3 ECOCCUR=N ECDOSE=-5
dataset EC class=INTERVENTIONS label="Exposure as Collected"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col ECSEQ   type=Num  label="Sequence Number"
col ECTRT   type=Char label="Name of Treatment"
col ECPRESP type=Char label="Pre-Specified"
col ECOCCUR type=Char label="Occurrence"
col ECDOSE  type=Num  label="Dose"
---
S1 | EC | 001 | 1 | DRUG A | Y | N | 10
S1 | EC | 001 | 2 | DRUG A | Y | N | 0
S1 | EC | 001 | 3 | DRUG A | Y | N | -5
S1 | EC | 001 | 4 | DRUG A | Y | N | .
