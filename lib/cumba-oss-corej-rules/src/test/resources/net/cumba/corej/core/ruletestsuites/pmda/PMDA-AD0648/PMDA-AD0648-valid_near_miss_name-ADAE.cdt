#!RuleTest
#test PMDA-AD0648 expect=noViolation domain=ADAE
#note "TRTEM01FL is a TWO-digit index, where the regex demands exactly one, so varname() =~ ^TRTEM\\dFL\$ is false for every column and nothing fires. This is the fixture that keeps the four flag rules apart."
#library standard=adamig version=1-3
dataset ADAE structure=OCCDS subclass=AE
col STUDYID  type=Char
col USUBJID  type=Char
col ASEQ     type=Num
col AEDECOD  type=Char
col TRTEM01FL type=Char
col TRTEMFL   type=Char
---
CDISCPILOT01 | 01-701-1015 | 1 | HEADACHE | Y | N
