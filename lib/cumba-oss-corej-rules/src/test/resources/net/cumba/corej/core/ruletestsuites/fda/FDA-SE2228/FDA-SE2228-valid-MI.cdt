#!RuleTest
#test FDA-SE2228 expect=noViolation domain=MI
#note "Row 1: an abnormal finding carries MIRESCAT. Row 2: MISTRESC='NORMAL' needs no category. Row 3: MISTRESC='UNREMARKABLE' likewise. Row 4: a NOT DONE record has an empty MISTRESC, which the sheet excludes."
#library standard=sendig version=3-1-1
dataset MI label="Microscopic Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col MISEQ    type=Num  label="Sequence Number"
col MITESTCD type=Char label="Microscopic Examination Short Name"
col MISTRESC type=Char label="Standardized Result in Standard Format"
col MIRESCAT type=Char label="Result Category"
col MISTAT   type=Char label="Completion Status"
col MISPEC   type=Char label="Specimen Material Type"
---
STUDY01 | MI | STUDY01-001 | 1 | MIEXAM | INFILTRATE, MONONUCLEAR CELL | INFLAMMATION |          | LIVER
STUDY01 | MI | STUDY01-001 | 2 | MIEXAM | NORMAL                       |              |          | KIDNEY
STUDY01 | MI | STUDY01-002 | 1 | MIEXAM | UNREMARKABLE                 |              |          | LIVER
STUDY01 | MI | STUDY01-002 | 2 | MIEXAM |                              |              | NOT DONE | KIDNEY
