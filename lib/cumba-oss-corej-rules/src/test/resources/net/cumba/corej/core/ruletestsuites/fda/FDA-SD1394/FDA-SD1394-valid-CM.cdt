#!RuleTest
#test FDA-SD1394 expect=noViolation domain=CM
#note "Guard boundaries, all clean: row 1 fully conformant; row 2 CMSTDTC incomplete (year only) so a missing CMXSTDY is tolerated; row 3 subject 002 whose DM.RFXSTDTC is empty; row 4 CMSTDTC empty."
#library standard=sendig version=ar-1-0
dataset CM class=INTERVENTIONS label="Concomitant/Prior Medications"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col CMSEQ    type=Num  label="Sequence Number"
col CMTRT    type=Char label="Reported Name of Drug, Med, or Therapy"
col CMSTDTC  type=Char label="Start Date/Time of Medication"
col CMXSTDY  type=Num  label="Start Day of Obs Relative to Exposure"
---
S1 | CM | 001 | 1 | SALINE | 2020-01-10 | 6
S1 | CM | 001 | 2 | SALINE | 2020       | .
S1 | CM | 002 | 1 | SALINE | 2020-01-10 | .
S1 | CM | 001 | 3 | SALINE |            | .
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFXSTDTC type=Char label="Date/Time of First Study Treatment"
---
S1 | DM | 001 | 2020-01-05
S1 | DM | 002 |
---
