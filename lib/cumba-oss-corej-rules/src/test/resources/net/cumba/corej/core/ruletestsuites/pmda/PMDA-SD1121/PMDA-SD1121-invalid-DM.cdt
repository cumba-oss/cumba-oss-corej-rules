#!RuleTest
#test PMDA-SD1121 expect=violation domain=DM
#note "Row 1: AGE missing, AGETXT empty and ARMCD='A1' (assigned, not SCRNFAIL/NOTASSGN) -> fires. Row 2: AGE populated -> no fire. Row 3: screen failure exception -> no fire. No class= on the dataset line — the twin declares none. ADAPTED-FROM fda/FDA-SD1121/FDA-SD1121-invalid-DM.cdt (verbatim, pin included)."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AGE     type=Num  label="Age"
col AGETXT  type=Char label="Age Range"
col ARMCD   type=Char label="Planned Arm Code"
---
S1 | DM | 001 | .  |       | A1
S1 | DM | 002 | 42 |       | A1
S1 | DM | 003 | .  |       | SCRNFAIL
