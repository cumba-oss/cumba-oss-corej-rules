#!RuleTest
#test PMDA-SD1115 expect=noViolation domain=DM
#note "The Trial Summary (TS) dataset is present in the study inventory -> no violation."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SEX     type=Char label="Sex"
---
S1 | DM | 001 | M
---

dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col TSSEQ   type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL   type=Char label="Parameter Value"
---
S1 | TS | 1 | TITLE | A Study
---
