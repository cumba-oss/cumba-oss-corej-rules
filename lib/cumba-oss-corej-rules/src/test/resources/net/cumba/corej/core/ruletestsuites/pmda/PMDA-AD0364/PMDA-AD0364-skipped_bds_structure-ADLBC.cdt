#!RuleTest
#test PMDA-AD0364 expect=skipped domain=ADLBC
#note "Scope pin. Data that WOULD fire (DOSEON present), but the declared BASIC DATA STRUCTURE is neither of this rule's two Include tokens, so the rule never executes. The declaration decides: without it the PARAMCD/AVAL columns would detect BDS anyway, but the declaration makes the verdict independent of the heuristic."
#library standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col DOSEON  type=Num
---
