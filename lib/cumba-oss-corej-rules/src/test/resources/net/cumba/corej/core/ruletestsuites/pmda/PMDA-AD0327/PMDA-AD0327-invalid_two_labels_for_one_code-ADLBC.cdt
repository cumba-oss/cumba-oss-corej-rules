#!RuleTest
#test PMDA-AD0327 expect=violation domain=ADLBC
#note "One expansion (y=1) pairs AVALCAT1 with AVALCA1N. Group (PARAMCD=ALB, AVALCA1N=1) holds AVALCAT1 {LOW x2, REDUCED x1} -> row 3 is the minority. Group (ALB,2) is consistent."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 AVALCAT1=REDUCED AVALCA1N=1 PARAMCD=ALB
dataset ADLBC class=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVALCAT1 type=Char
col AVALCA1N type=Num
---
S1 | 001 | ALB | LOW     | 1
S1 | 002 | ALB | LOW     | 1
S1 | 003 | ALB | REDUCED | 1
S1 | 004 | ALB | HIGH    | 2
S1 | 005 | ALB | HIGH    | 2
