#!RuleTest
#test PMDA-AD0005B expect=noViolation domain=ADSL
#note "AD0005B's exception regex is the SHORTER ^(ABLFL|ANL\\d\\dFL)$ (RFL/PFL dropped); both cells match it -> silent. Pins that the two surviving exception branches still work."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col ABLFL   type=Char
col ANL01FL type=Char
---
CDISCPILOT01 | 01-701-1015 | X | X
