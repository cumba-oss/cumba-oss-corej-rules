#!RuleTest
#test FDA-SD1390 expect=noViolation domain=MB
#note "row1 MBCHDY populated with MBDTC and DM.RFCSTDTC both complete dates -> no fire even though 999 is not the algorithm value (value correctness is not this rule's check) — DM.RFXSTDTC of 001 is EMPTY, so a rule wrongly reading RFXSTDTC would fire on row1; row2 MBCHDY missing with MBDTC empty; row3 subject 002 has bad DM.RFCSTDTC but MBCHDY missing."
#library standard=sendig version=ar-1-0
dataset MB class=FINDINGS
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col MBSEQ   type=Num  label="Sequence Number"
col MBTESTCD type=Char label="Microbiology Test Code"
col MBDTC type=Char label="Date/Time of Collection"
col MBCHDY  type=Num  label="Day of Obs Rel to Challenge Agent"
---
S1 | MB | 001 | 1 | BACT | 2023-06-25 | 999
S1 | MB | 001 | 2 | BACT |  | 
S1 | MB | 002 | 1 | BACT | 2023-06-25 | 
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFSTDTC  type=Char label="Subject Reference Start Date/Time"
col RFXSTDTC type=Char label="Date/Time of First Study Treatment"
col RFCSTDTC type=Char label="Date/Time of First Challenge Agent Admin"
---
S1 | DM | 001 | 2023-06-01 |            | 2023-06-20
S1 | DM | 002 | 2023-06-01 | 2023-06-10 |           
S1 | DM | 003 | 2023-06-01 | 2023-06-10 | 2023-06   
