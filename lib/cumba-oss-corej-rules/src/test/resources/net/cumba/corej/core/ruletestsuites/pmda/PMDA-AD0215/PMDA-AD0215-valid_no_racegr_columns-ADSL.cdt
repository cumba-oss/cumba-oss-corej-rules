#!RuleTest
#test PMDA-AD0215 expect=noViolation domain=ADSL
#note "No column matches the first regex, so the rule runs and finds nothing. This is the rule's 'executes but silent' control; it deliberately stays on an ADSL primary so it needs no re-authoring whichever way M2-Q1 is ruled (finding AD0215-F1)."
#library standard=adamig version=1-0
#expectViolationCount 0
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col AGE     type=Num
col SEX     type=Char
col SAFFL   type=Char
col RACE    type=Char
---
CDISCPILOT01 | 01-701-1015 | 56 | F | Y | WHITE
