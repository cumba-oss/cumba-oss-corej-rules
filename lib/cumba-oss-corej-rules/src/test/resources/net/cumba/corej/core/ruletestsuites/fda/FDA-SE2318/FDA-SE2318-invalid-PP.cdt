#!RuleTest
#test FDA-SE2318 expect=violation domain=PP
#note "Row 3 leaves both VISITDY and PPNOMDY missing -> fires; rows 1 and 2 populate one of the two."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=3 PPSEQ=3
dataset PP class=FINDINGS label="Pharmacokinetic Parameters"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PPSEQ    type=Num  label="Sequence Number"
col PPTESTCD type=Char label="Parameter Short Name"
col VISITDY  type=Num  label="Planned Study Day of Collection"
col PPNOMDY  type=Num  label="Nominal Study Day for Tabulations"
---
S1 | PP | 001 | 1 | AUCALL | 8 | .
S1 | PP | 001 | 2 | CMAX   | . | 8
S1 | PP | 001 | 3 | TMAX   | . | .
