#!RuleTest
#test PMDA-AD0090 expect=noViolation domain=ADLBC
#note "Record-level arm. Column TRTA (DRUGA) matches TRT[PA] -> count 1 -> silent. (TRTA does not end in TRT/TERM/DECOD, so BDS detection is untouched; structure=BDS is declared anyway.)"
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col TRTA    type=Char
---
S1 | 01-701-1015 | ALB | 30 | DRUGA
S1 | 01-701-1023 | ALB | 31 | DRUGA
