#!RuleTest
#test FDA-SD1124 expect=violation domain=LB
#note "present-but-empty case: row 2 is NOT DONE and LBREASND exists in the dataset but is blank, so empty(--REASND) is true -> fires. The Check's single empty(--REASND) conjunct now carries both this and the column-absent case; Plan B phase 4d' deleted the `or not var_exists(--REASND)` disjunct that used to make them separate branches."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 LBSTAT="NOT DONE"
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBORRES  type=Char label="Result or Finding in Original Units"
col LBSTAT   type=Char label="Completion Status"
col LBREASND type=Char label="Reason Not Done"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | GLUC |     | NOT DONE | SPECIMEN LOST
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALB  |     | NOT DONE |
