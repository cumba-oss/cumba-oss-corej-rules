#!RuleTest
#test FDA-SD1021 expect=noViolation domain=CO
#note "Exception branch: COVAL and COVALn are free-text comment variables and are explicitly exempt, so a leading space in COVAL and a lone '.' in COVAL1 must not be reported."
#library standard=sdtmig version=3-4
dataset CO class="SPECIAL PURPOSE" label="Comments"
col STUDYID type=Char label="Study Identifier"
col RDOMAIN type=Char label="Related Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col COSEQ   type=Num  label="Sequence Number"
col COVAL   type=Char label="Comment"
col COVAL1  type=Char label="Comment Continued"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | " subject reported dizziness" | .
