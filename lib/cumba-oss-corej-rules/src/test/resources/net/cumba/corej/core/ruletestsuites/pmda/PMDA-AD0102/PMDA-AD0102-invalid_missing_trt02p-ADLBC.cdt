#!RuleTest
#test PMDA-AD0102 expect=violation domain=ADLBC
#note "APERIOD is the %02d per-row driver (declared Num, MANDATORY). Row 1: ADSL has TRT01P -> no. Row 2: ADSL has no TRT02P -> FIRES. Row 3: driver value missing -> row unset for both polarities -> no. JOIN: Match_Datasets ADSL on Keys=[USUBJID], inner (default); ADSL has one row per subject and every primary USUBJID appears in ADSL -> 1:1, no primary row dropped. The presence test resolves against ADSL's SCHEMA via the resolver, so TRT01P needs no particular value."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=2 APERIOD=2
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col APERIOD type=Num
---
S1 | 001 | GLUC | 5.1 | 1
S1 | 001 | GLUC | 5.4 | 2
S1 | 001 | GLUC | 5.2 |
---

dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRT01P  type=Char
---
S1 | 001 | Placebo
