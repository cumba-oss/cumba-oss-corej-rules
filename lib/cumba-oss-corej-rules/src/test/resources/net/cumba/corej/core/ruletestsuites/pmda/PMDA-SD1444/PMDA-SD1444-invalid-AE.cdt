#!RuleTest
#test PMDA-SD1444 expect=violation domain=AE
#note "The collected term 'HEADACHE' is assigned two different primary system organ classes, so --SOC is not consistent for the same --TERM. Both records of the conflicting pair are reported."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 AETERM=HEADACHE AESOC="Nervous system disorders"
#expectViolationAt row=2 AETERM=HEADACHE AESOC="General disorders and administration site conditions"
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEDECOD type=Char label="Dictionary-Derived Term"
col AESOC    type=Char label="Primary System Organ Class"
---
S1 | AE | 001 | 1 | HEADACHE | Headache | Nervous system disorders
S1 | AE | 002 | 1 | HEADACHE | Headache | General disorders and administration site conditions
S1 | AE | 003 | 1 | NAUSEA   | Nausea   | Gastrointestinal disorders
