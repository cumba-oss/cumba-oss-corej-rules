#!RuleTest
#test FDA-SD0027 expect=violation domain=LB
#note "LBORRES is not present in the dataset while LBORRESU is populated on row 1 -> the original result is missing. Encodes the column-absent case: the Check carries a bare empty(--ORRES) leaf, which under absent = all-missing (EC-43) is TRUE on every row of a column that is not there. Plan B phase 4d' deleted the redundant not var_exists(--ORRES) disjunct that used to spell this out; the verdict is unchanged."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 LBORRESU=mmol/L
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBORRESU type=Char label="Original Units"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | GLUC | mmol/L
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALB  |
