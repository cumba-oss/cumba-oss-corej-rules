#!RuleTest
#test FDA-SD0051 expect=noViolation domain=VS
#note "Boundary: one VISITNUM=1 record leaves VISIT empty while the others agree on 'SCREENING'. An empty visit name is not a second value, so nothing is reported."
#library standard=sdtmig version=3-4
dataset VS class=FINDINGS label="Vital Signs"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VSSEQ    type=Num  label="Sequence Number"
col VSTESTCD type=Char label="Vital Signs Test Short Name"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
S1 | VS | 001 | 1 | SYSBP | 1 | SCREENING
S1 | VS | 002 | 1 | SYSBP | 1 |
S1 | VS | 003 | 1 | SYSBP | 1 | SCREENING
