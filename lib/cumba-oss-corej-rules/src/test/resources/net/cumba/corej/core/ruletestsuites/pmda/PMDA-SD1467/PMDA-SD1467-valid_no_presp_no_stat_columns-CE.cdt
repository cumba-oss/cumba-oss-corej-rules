#!RuleTest
#test PMDA-SD1467 expect=noViolation domain=CE
#note "Neither --PRESP nor --STAT column present. Both branches are var_exists-guarded false -> executes, 0 violations. (--OCCUR present, so Requirements.Variables passes.)"
#library standard=sdtmig version=3-4
#expectViolationCount 0
dataset CE class=EVENTS
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col CESEQ   type=Num
col CETERM  type=Char
col CEOCCUR type=Char
---
S1 | CE | 001 | 1 | FLUSHING | Y
