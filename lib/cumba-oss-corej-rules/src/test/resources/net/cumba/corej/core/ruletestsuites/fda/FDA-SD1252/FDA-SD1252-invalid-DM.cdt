#!RuleTest
#test FDA-SD1252 expect=violation domain=DM
#note "Subject 001: SS has SSSTRESC=DEAD but DM.DTHFL=N -> fires. Subject 002: DEAD with DTHFL=Y -> ok. Subject 003: SS record is ALIVE, DTHFL=N -> ok."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DTHFL   type=Char label="Subject Death Flag"
---
S1 | DM | 001 | N
S1 | DM | 002 | Y
S1 | DM | 003 | N
---

dataset SS class=FINDINGS label="Subject Status"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SSSEQ    type=Num  label="Sequence Number"
col SSTESTCD type=Char label="Subject Status Short Name"
col SSSTRESC type=Char label="Subject Status Result in Std Format"
---
S1 | SS | 001 | 1 | SURVSTAT | DEAD
S1 | SS | 002 | 1 | SURVSTAT | DEAD
S1 | SS | 003 | 1 | SURVSTAT | ALIVE
---
