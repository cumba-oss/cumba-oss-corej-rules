#!RuleTest
#test CDISC-AD0516 expect=violation domain=ADLBC
# Rule:Description: A variable ending in ETM must contain "End Time" in the label
#note "AETM label "Analysis Time" lacks "End Time" -> violation"
#expectViolationCount 1
#expectViolationAt variable_label="Analysis Time" variable_name=AETM
#library standard=adamig version=1-3
#library column-order ADLBC STUDYID USUBJID PARAMCD
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AETM type=Char label="Analysis Time"
---
CDISCPILOT01 | 01-701-1015 | ALB | x
---
