#!RuleTest
#test FDA-SD2007 expect=noViolation domain=AE
#note "Every populated AEPTCD is a Preferred Term code of the (dummy) MedDRA dictionary; the missing AEPTCD on row 3 does not fire (completeness is another rule's concern). AEPTCD is Num per SDTMIG 3.4."
#library standard=sdtmig version=3-4
#dictionaries dummy
dataset AE
col USUBJID type=Char
col AEDECOD type=Char
col AEPTCD  type=Num
