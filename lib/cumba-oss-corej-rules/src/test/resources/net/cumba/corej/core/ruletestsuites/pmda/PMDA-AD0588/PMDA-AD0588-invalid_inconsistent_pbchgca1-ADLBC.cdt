#!RuleTest
#test PMDA-AD0588 expect=violation domain=ADLBC
#note "INDEX 1 ONLY: PBCHGCA1 matches ^PBCHGCA(\d+)$ and PBCHGC1N matches ^PBCHGC(\d+)N$, both capturing y=1. Key tuple (PARAMCD, PBCHGC1N)=(GLUC, 1); target PBCHGCA1 holds {INCREASE, INCREASE, DECREASE} -> minority row 3 fires."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=01-701-1034 PARAMCD=GLUC PBCHGCA1=DECREASE PBCHGC1N=1
dataset ADLBC
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col PBCHGCA1 type=Char
col PBCHGC1N type=Num
---
CDISCPILOT01 | 01-701-1015 | GLUC | INCREASE | 1
CDISCPILOT01 | 01-701-1023 | GLUC | INCREASE | 1
CDISCPILOT01 | 01-701-1034 | GLUC | DECREASE | 1
