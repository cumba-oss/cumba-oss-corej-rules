#!RuleTest
#test PMDA-SD1002 expect=noViolation domain=DM
#note "Sheet: RFSTDTC must be less than or equal to RFENDTC. Subject 1 start < end, subject 2 start = end, subject 3 has no reference end date -- all conformant."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SUBJID   type=Char label="Subject Identifier for the Study"
col RFSTDTC  type=Char label="Subject Reference Start Date/Time"
col RFENDTC  type=Char label="Subject Reference End Date/Time"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015 | 2020-01-01 | 2020-06-30
CDISCPILOT01 | DM | 01-701-1023 | 1023 | 2020-02-01 | 2020-02-01
CDISCPILOT01 | DM | 01-701-1028 | 1028 | 2020-03-01 |
