#!RuleTest
#test FDA-SD0006 expect=noViolation domain=LB
#note "001 has a baseline record (LBBLFL=Y); 002 SCRNFAIL, 003 NOTASSGN and 004 NOTTRT are exempt -> no violation."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test Short Name"
col LBBLFL   type=Char label="Baseline Flag"
---
S1 | LB | 001 | 1 | ALB |
S1 | LB | 001 | 2 | ALB | Y
S1 | LB | 002 | 1 | ALB |
S1 | LB | 003 | 1 | ALB |
S1 | LB | 004 | 1 | ALB |
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARMCD    type=Char label="Planned Arm Code"
col ARM      type=Char label="Description of Planned Arm"
col ACTARMCD type=Char label="Actual Arm Code"
---
S1 | DM | 001 | ARM1     | Arm 1          | ARM1
S1 | DM | 002 | SCRNFAIL | Screen Failure | SCRNFAIL
S1 | DM | 003 | NOTASSGN | Not Assigned   | NOTASSGN
S1 | DM | 004 | ARM1     | Arm 1          | NOTTRT
---
