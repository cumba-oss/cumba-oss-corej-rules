#!RuleTest
#test PMDA-SD1033 expect=noViolation domain=TA
#note "FRESH. Zero data rows. Predicted SILENT per STAGE-G CRITICAL 4: the rule is RECORD-sensitivity and value-based, so RuleRunner never substitutes the synthetic 1-row table and the group pass runs over zero rows. Belt and braces: even on the synthetic path the table carries ZERO columns, so the authored var_exists(\"ARMCD\") would be false."
#library standard=sdtmig version=3-4
dataset TA label="Trial Arms"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
col TAETORD type=Num  label="Planned Order of Element within Arm"
col ETCD    type=Char label="Element Code"
---
