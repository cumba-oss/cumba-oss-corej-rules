#!RuleTest
#test PMDA-AD0205 expect=noViolation domain=ADSL
#note "ADSL.AGEU = DM.AGEU = YEARS. No fire."
#library standard=adamig version=1-3
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col AGEU    type=Char
---
CDISCPILOT01 | 01-701-1015 | YEARS
---

dataset DM label=Demographics
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col AGEU    type=Char
---
CDISCPILOT01 | DM | 01-701-1015 | YEARS
