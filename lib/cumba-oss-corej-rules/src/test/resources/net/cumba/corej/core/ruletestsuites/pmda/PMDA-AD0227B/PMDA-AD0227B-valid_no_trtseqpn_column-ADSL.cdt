#!RuleTest
#test PMDA-AD0227B expect=noViolation domain=ADSL
#note "TRTSEQPN is not declared. The guard not empty(TRTSEQPN) is false on every row, so the rule EXECUTES and stays silent even though the absent key would otherwise degrade to a single whole-dataset group and flag row 3."
#library standard=adamig version=1-3
dataset ADSL class=ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRTSEQP type=Char
---
S1 | 001 | A-B
S1 | 002 | A-B
S1 | 003 | B-A
