#!RuleTest
#test FDA-SD1374 expect=noViolation domain=DM
#note "Both treated subjects (ACTARMCD populated) have a DS record; subject 01-003 has no DS record but ACTARMCD is empty, which the sheet names as the permitted exception -> no violation."
#library standard=sdtmig version=3-4
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARMCD    type=Char label="Planned Arm Code"
col ACTARMCD type=Char label="Actual Arm Code"
col ACTARM   type=Char label="Description of Actual Arm"
---
CDISCPILOT01 | DM | 01-001 | PBO   | PBO   | Placebo
CDISCPILOT01 | DM | 01-002 | XANHI | XANHI | Xanomeline High
CDISCPILOT01 | DM | 01-003 |       |       |
---

dataset DS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSTERM  type=Char label="Reported Term for the Disposition Event"
col DSDECOD type=Char label="Standardized Disposition Term"
---
CDISCPILOT01 | DS | 01-001 | 1 | COMPLETED | COMPLETED
CDISCPILOT01 | DS | 01-002 | 1 | COMPLETED | COMPLETED
---
