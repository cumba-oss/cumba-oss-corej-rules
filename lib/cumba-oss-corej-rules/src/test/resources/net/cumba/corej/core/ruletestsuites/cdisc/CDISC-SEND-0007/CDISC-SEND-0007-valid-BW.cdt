#!RuleTest
#test CDISC-SEND-0007 expect=noViolation domain=BW
#note "Same library block; the define's BWTESTCD ItemDef now carries a CodeListRef to a sponsor codelist -> var_codelist(DEFINE) non-empty -> silent. USUBJID stays codelist-free on both sides."
#library standard=sendig version=3-1-1
#library variable-metadata BW BWTESTCD name=BWTESTCD codelist=C90001
#library variable-metadata BW USUBJID name=USUBJID
#define-xml CDISC-SEND-0007-valid-define.xml
dataset BW
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col BWSEQ    type=Num
col BWTESTCD type=Char
---
S1 | BW | 001 | 1 | BW
