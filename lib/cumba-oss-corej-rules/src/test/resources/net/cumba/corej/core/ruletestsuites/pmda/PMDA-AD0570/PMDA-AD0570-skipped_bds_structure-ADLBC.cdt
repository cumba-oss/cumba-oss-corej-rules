#!RuleTest
#test PMDA-AD0570 expect=skipped domain=ADLBC
#note "Batch's single pin on the [SUBJECT LEVEL ANALYSIS DATASET, DEVICE LEVEL ANALYSIS DATASET] Scope block (shared with PMDA-AD0355). Declared BDS beats the columns, so the rule never executes even though P01S1 present / TRT01P absent would fire on ADSL."
#library standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col P01S1   type=Char
---
CDISCPILOT01 | 01-701-1015 | ALB | 30 | SP1
