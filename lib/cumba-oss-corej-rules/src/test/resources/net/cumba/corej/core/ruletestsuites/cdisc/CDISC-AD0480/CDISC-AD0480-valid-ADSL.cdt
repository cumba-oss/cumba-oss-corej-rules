#!RuleTest
#test CDISC-AD0480 expect=noViolation domain=ADSL
# Rule:Description: There is more than one value of STRATwV for a given value of STRATwVN, considering only those rows on which both variables are populated
#note "each STRAT1VN value maps to a single STRAT1V -> no violation"
dataset ADSL class=ADSL
col STUDYID type=Char
col USUBJID type=Char
col STRAT1V type=Char
col STRAT1VN type=Char
---
CDISCPILOT01 | 01-701-1015 | a1 | G1
CDISCPILOT01 | 01-701-1023 | a2 | G2
---
