#!RuleTest
#test FDA-SD1134 expect=noViolation domain=DM
#note "Boundary: one 'Placebo' subject leaves ACTARMCD empty while the others agree on PBO. An empty code is excluded from the consistency computation."
#library standard=sdtmig version=3-4
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ACTARMCD type=Char label="Actual Arm Code"
col ACTARM   type=Char label="Description of Actual Arm"
---
S1 | DM | 001 | PBO | Placebo
S1 | DM | 002 |     | Placebo
S1 | DM | 003 | PBO | Placebo
