#!RuleTest
#test PMDA-SD1101 expect=noViolation domain=AE
#note "The DIRECTION discriminator: the rule conditions on AEENRTPT being present, so AEENTPT-without-AEENRTPT must NOT fire (first conjunct false)."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col AESEQ    type=Num
col AEENTPT  type=Char
---
S1 | AE | 001 | 1 | SCREENING
