#!RuleTest
#test FDA-SE2243 expect=violation domain=MA
#note "Row 1 is a clinical signs follow-up record but still names a specimen material type -> fires. Row 2 shows the same specimen value is fine under GROSPATH."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 MATESTCD=CLSFUP MASPEC=LIVER
dataset MA label="Macroscopic Findings"
col STUDYID  type=Char label="Study Identifier"
col USUBJID  type=Char label="Unique Subject Identifier"
col MASEQ    type=Num  label="Sequence Number"
col MATESTCD type=Char label="Macroscopic Examination Short Name"
col MATEST   type=Char label="Macroscopic Examination Name"
col MASTRESC type=Char label="Standardized Result in Character Format"
col MASPEC   type=Char label="Specimen Material Type"
---
S1 | 001 | 1 | CLSFUP   | Clinical Signs Follow-up       | NORMAL   | LIVER
S1 | 001 | 2 | GROSPATH | Gross Pathological Observation | ENLARGED | LIVER
