#!RuleTest
#test FDA-SD1002 expect=violation domain=DM
#note "Subject 2's reference period starts 2020-07-01 and ends 2020-06-30, so RFSTDTC is after RFENDTC."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 RFSTDTC=2020-07-01 RFENDTC=2020-06-30
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SUBJID   type=Char label="Subject Identifier for the Study"
col RFSTDTC  type=Char label="Subject Reference Start Date/Time"
col RFENDTC  type=Char label="Subject Reference End Date/Time"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015 | 2020-01-01 | 2020-06-30
CDISCPILOT01 | DM | 01-701-1023 | 1023 | 2020-07-01 | 2020-06-30
