#!RuleTest
#test CDISC-AD0010 expect=noViolation domain=ADLBC
# Rule:Description: A variable with a suffix of FL is equal to Y and a variable with the same root and a suffix of FN is not equal to 1
#note "SAFFL=Y and SAFFN=1 -> noViolation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col SAFFL type=Char
col SAFFN type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | Y | 1
---
