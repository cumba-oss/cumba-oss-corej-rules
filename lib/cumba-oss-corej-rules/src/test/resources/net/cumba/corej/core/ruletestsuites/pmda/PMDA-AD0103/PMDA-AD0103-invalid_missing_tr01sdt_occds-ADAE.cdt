#!RuleTest
#test PMDA-AD0103 expect=violation domain=ADAE
#note "dataset ADAE (AEDECOD detects OCCDS -- no class= key). Row 1 FIRES: ADSL lacks TR01SDT. TRT01P is present in ADSL to prove the rule tests TRxxSDT specifically, not any period variable. JOIN: ADSL on [USUBJID], inner, 1:1, subject present. Pins the OCCDS structure token positively for the family's shared scope block (pinned on AD0102)."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 APERIOD=1
dataset ADAE
col STUDYID type=Char
col USUBJID type=Char
col AEDECOD type=Char
col APERIOD type=Num
---
S1 | 001 | HEADACHE | 1
---

dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRT01P  type=Char
---
S1 | 001 | Placebo
