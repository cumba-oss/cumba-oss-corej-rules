#!RuleTest
#test FDA-SD2239 expect=noViolation domain=VS
#note "Same VSTPT/VSTPTNUM inconsistency as the invalid scenario, but VISITNUM is present, so the 'VISITNUM not_exists' gate blocks the rule -> no violation (per CG0240's condition the 1:1 check applies only when neither VISITNUM nor --TPTREF is present)."
#library standard=sdtmig version=3-4
dataset VS class=FINDINGS label="Vital Signs"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VSSEQ    type=Num  label="Sequence Number"
col VSTESTCD type=Char label="Vital Signs Test Short Name"
col VISITNUM type=Num  label="Visit Number"
col VSTPT    type=Char label="Planned Time Point Name"
col VSTPTNUM type=Num  label="Planned Time Point Number"
---
S1 | VS | 001 | 1 | SYSBP | 1 | PRE-DOSE  | 1
S1 | VS | 001 | 2 | SYSBP | 1 | POST-DOSE | 2
S1 | VS | 002 | 1 | SYSBP | 2 | PREDOSE   | 1
