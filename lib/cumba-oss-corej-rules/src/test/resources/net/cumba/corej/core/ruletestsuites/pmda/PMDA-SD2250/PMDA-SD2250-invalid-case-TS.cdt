#!RuleTest
#test PMDA-SD2250 expect=violation domain=TS
#note "Case-mismatch pin for the D-TA-3 sensitive default (Fix #266): the dummy UNII SRS preferred terms are upper-case (ASPIRIN), so the mixed-case 'Aspirin' on row 2 fires; row 1 matches the preferred case exactly."
#library standard=sdtmig version=3-4
#dictionaries dummy
#expectViolationCount 1
#expectViolationAt row=2 TSSEQ=2 TSVAL=Aspirin
dataset TS
col STUDYID  type=Char
col DOMAIN   type=Char
col TSSEQ    type=Num
col TSPARMCD type=Char
col TSVAL    type=Char
---
S01 | TS | 1 | CURTRT | ASPIRIN
S01 | TS | 2 | CURTRT | Aspirin
