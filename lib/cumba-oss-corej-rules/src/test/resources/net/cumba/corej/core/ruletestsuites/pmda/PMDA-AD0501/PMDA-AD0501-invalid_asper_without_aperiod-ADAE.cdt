#!RuleTest
#test PMDA-AD0501 expect=violation domain=ADAE
#note "The OCCDS half of Scope.Data_Structures.Include, which the ADLBC fixture does not reach. ASPER populated but APERIOD missing on row 1 -> fires. Row 2 both populated -> silent. The declared structure beats the column heuristic."
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015 ASPER=2
#library standard=adamig version=1-3
dataset ADAE structure=OCCDS
col STUDYID  type=Char
col USUBJID  type=Char
col AEDECOD  type=Char
col APERIOD  type=Num
col ASPER    type=Num
---
CDISCPILOT01 | 01-701-1015 | HEADACHE | | 2
CDISCPILOT01 | 01-701-1023 | NAUSEA   | 1 | 1
---
