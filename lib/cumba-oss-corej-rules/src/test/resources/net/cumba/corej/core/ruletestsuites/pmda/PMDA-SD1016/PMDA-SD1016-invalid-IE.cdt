#!RuleTest
#test PMDA-SD1016 expect=violation domain=IE
#note "ADAPTED-FROM fda/FDA-SD1016/FDA-SD1016-invalid-IE.cdt (verbatim). Row 1 matches TI exactly (INCL01/Age 18 or older/INCLUSION). Row 2 carries the SAME IETESTCD+IETEST but IECAT=EXCLUSION -> the triple matches no TI entry, left join null-fills TI.IETESTCD -> FIRES (partial-key mismatch is the twin's own discriminator)."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1016 IETESTCD=INCL01
dataset IE label="Inclusion/Exclusion Criteria Not Met"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IESEQ    type=Num  label="Sequence Number"
col IETESTCD type=Char label="Incl/Excl Criterion Short Name"
col IETEST   type=Char label="Inclusion/Exclusion Criterion"
col IECAT    type=Char label="Inclusion/Exclusion Category"
---
CDISCPILOT01 | IE | 01-701-1015 | 1 | INCL01 | Age 18 or older | INCLUSION
CDISCPILOT01 | IE | 01-701-1016 | 1 | INCL01 | Age 18 or older | EXCLUSION
---

dataset TI label="Trial Inclusion/Exclusion Criteria"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col IETESTCD type=Char label="Incl/Excl Criterion Short Name"
col IETEST   type=Char label="Inclusion/Exclusion Criterion"
col IECAT    type=Char label="Inclusion/Exclusion Category"
---
CDISCPILOT01 | TI | INCL01 | Age 18 or older | INCLUSION
---
