#!RuleTest
#test FDA-SD1104 expect=violation domain=CE
#note "CESTTPT is present but the relative qualifier CESTRTPT that gives it meaning is absent -> fires once for the dataset."
#library standard=sdtmig version=3-4
#expectViolationCount 1
dataset CE class=EVENTS label="Clinical Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CESEQ    type=Num  label="Sequence Number"
col CESTTPT  type=Char label="Start Reference Time Point"
---
S1 | CE | 001 | 1 | SCREENING
