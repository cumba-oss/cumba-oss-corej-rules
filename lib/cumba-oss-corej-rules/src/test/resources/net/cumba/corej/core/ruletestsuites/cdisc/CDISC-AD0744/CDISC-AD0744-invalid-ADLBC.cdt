#!RuleTest
#test CDISC-AD0744 expect=violation domain=ADLBC
# Rule:Description: BASETYPE is populated, BTOXGR is populated, and BTOXGR is not equal to ATOXGR where ABLFL is equal to Y for a given value of PARAMCD and BASETYPE for a subject
#note "BTOXGR=1 vs max(ATOXGR where ABLFL=Y)=2 -> violation"
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col BASETYPE type=Char
col ABLFL type=Char
col ATOXGR type=Char
col BTOXGR type=Char
---
CDISCPILOT01 | 01-701-1015 | GLUC | LAST | Y | 2 | 1
---
