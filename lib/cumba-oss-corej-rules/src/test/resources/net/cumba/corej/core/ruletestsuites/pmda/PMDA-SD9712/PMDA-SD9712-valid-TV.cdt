#!RuleTest
#test PMDA-SD9712 expect=noViolation domain=TV
# Rule:Description: PMDA-SD9712 — the Required key VISIT is not populated.
#note "VISIT populated -> noViolation; the twin scenario differs only in the value of VISIT."
#library standard=sdtmig version=3-4
dataset TV
col STUDYID type=Char
col DOMAIN type=Char
col VISITNUM type=Char
col VISIT type=Char
col ARMCD type=Char
---
S1      | TV     | 1        | SCREENING | A
---
