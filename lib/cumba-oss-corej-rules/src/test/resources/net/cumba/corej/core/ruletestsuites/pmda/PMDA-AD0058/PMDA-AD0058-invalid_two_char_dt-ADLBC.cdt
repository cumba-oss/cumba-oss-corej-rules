#expectViolationCount 2
#expectViolationAt variable_name=ASTDT variable_data_type=Char
#expectViolationAt variable_name=AENDT variable_data_type=Char
#library standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ASTDT   type=Char
col AENDT   type=Char
