#!RuleTest
#test PMDA-SD1066 expect=violation domain=RELREC
#note "row 1 carries both RELTYPE and IDVARVAL -> fires; row 2 is a conformant dataset-level row."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 RELTYPE=ONE
dataset RELREC label="Related Records"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col RELTYPE  type=Char label="Relationship Type"
col RELID    type=Char label="Relationship Identifier"
---
S1 | AE |  | AESPID | 5 | ONE | RL1
S1 | CM |  | CMSPID |  | MANY | RL1
