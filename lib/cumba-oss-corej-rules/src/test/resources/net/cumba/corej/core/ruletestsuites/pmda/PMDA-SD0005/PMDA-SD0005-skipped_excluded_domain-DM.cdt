#!RuleTest
#test PMDA-SD0005 expect=skipped domain=DM
#note "DM is a member of the included SPECIAL PURPOSE class, so ONLY the PMDA Domains.Exclude [DM, DX, DO, DU, DE, DT] rejects. Discriminator: the FDA twin excludes [TS, DO, DT, DU, DX] and RUNS on DM - each list is verbatim from its own sheet cell."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE"
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col ARMCD   type=Char
---
S1 | DM | 001 | ARM1
