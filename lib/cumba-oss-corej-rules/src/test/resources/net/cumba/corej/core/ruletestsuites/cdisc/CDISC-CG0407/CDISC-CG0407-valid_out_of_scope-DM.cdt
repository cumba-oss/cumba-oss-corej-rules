#!RuleTest
#test CDISC-CG0407 expect=skipped domain=DM
#note "Scope contract: the rule is scoped to its anchor TA, so on an unrelated dataset it is not evaluated at all. Before the re-scope ([ALL]) it ran here and reported a no-violation execution row for every dataset in the study."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | DM | 01-701-1015
