#!RuleTest
#test PMDA-AD0677 expect=violation domain=ADDL
#note "This rule declares NO `_wildcards` block, so the y capture is unfiltered and index 10 expands and fires - the exact counterpart of PMDA-AD0616's skipped_index_ten_filtered, whose identical data is filtered away. Pins finding AD0677-F2 (the missing filter) from the behavioural side."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=003 DEVTYG10=VALVE DEVTYG10N=1
dataset ADDL
col STUDYID    type=Char
col USUBJID    type=Char
col SPDEVID    type=Char
col DEVTYG10   type=Char
col DEVTYG10N  type=Num
---
S1 | 001 | DEV01 | PUMP  | 1
S1 | 002 | DEV01 | PUMP  | 1
S1 | 003 | DEV02 | VALVE | 1
---
