#!RuleTest
#test PMDA-AD0243 expect=violation domain=ADSL
#note "Mirror roles of AD0242: key TRT01AN, target TRT01A. Group 1 holds {DRUGX x2, DRUGY x1} -> row 3 is the minority."
#library standard=adamig version=1-0
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=003 TRT01A=DRUGY TRT01AN=1
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRT01A  type=Char
col TRT01AN type=Num
---
S1 | 001 | DRUGX   | 1
S1 | 002 | DRUGX   | 1
S1 | 003 | DRUGY   | 1
S1 | 004 | PLACEBO | 2
S1 | 005 | PLACEBO | 2
