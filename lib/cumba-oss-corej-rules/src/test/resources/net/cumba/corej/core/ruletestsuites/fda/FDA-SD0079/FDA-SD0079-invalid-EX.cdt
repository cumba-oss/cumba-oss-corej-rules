#!RuleTest
#test FDA-SD0079 expect=violation domain=EX
#note "Non-run-in EX records for 002 (NOTASSGN), 003 (SCRNFAIL) and 004 (ARM empty) fire; 001 is assigned -> 3 violations."
#library standard=sdtmig version=3-4
#expectViolationCount 3
#expectViolationAt row=1 USUBJID=002
#expectViolationAt row=2 USUBJID=003
#expectViolationAt row=3 USUBJID=004
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EPOCH   type=Char label="Epoch"
---
S1 | EX | 002 | 1 | DRUG A | TREATMENT
S1 | EX | 003 | 1 | DRUG A | SCREENING
S1 | EX | 004 | 1 | DRUG A | TREATMENT
S1 | EX | 001 | 1 | DRUG A | TREATMENT
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
---
S1 | DM | 001 | ARM1     | Arm 1
S1 | DM | 002 | NOTASSGN | Not Assigned
S1 | DM | 003 | SCRNFAIL | Screen Failure
S1 | DM | 004 |          |
---
