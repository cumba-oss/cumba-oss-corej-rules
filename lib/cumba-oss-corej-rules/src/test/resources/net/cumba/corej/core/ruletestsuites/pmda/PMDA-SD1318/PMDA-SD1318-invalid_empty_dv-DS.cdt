#!RuleTest
#test PMDA-SD1318 expect=violation domain=DS
#note "FRESH - DOUBLE-DISCRIMINATING pin (group fold + declared-empty DV). Subject 001 has TWO qualifying DS rows (PROTOCOL VIOLATION + PROTOCOL DEVIATION); subject 002 is COMPLETED (not qualifying). DV is DECLARED with the full twin column set and ZERO data rows: DV IS in dataset_names (shares-arm false), so the fire must come through grouped $dv_count=0; Grouping [USUBJID] folds subject 001's two qualifying DS rows into ONE finding -> count 1, count-only pin. Escalate on 2 (group fold refuted) or 0 (grouped zero-fill refuted)."
#library standard=sdtmig version=3-4
#expectViolationCount 1
dataset DS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSTERM  type=Char label="Reported Term for the Disposition Event"
col DSDECOD type=Char label="Standardized Disposition Term"
---
S1 | DS | 001 | 1 | Protocol violation | PROTOCOL VIOLATION
S1 | DS | 001 | 2 | Protocol deviation | PROTOCOL DEVIATION
S1 | DS | 002 | 1 | Completed          | COMPLETED
---

dataset DV label="Protocol Deviations"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DVSEQ   type=Num  label="Sequence Number"
col DVTERM  type=Char label="Protocol Deviation Term"
---
---
