#!RuleTest
#test FDA-SD1392 expect=violation domain=CM
#note "One invalid row per any-branch: row 1 CMENDTC empty; row 2 CMENDTC incomplete (year-month only); row 3 subject 002 whose DM.RFCSTDTC is empty; row 4 subject 003 whose DM.RFCSTDTC is incomplete. Rows 5 (all dates complete) and 6 (CMCHENDY missing) are clean."
#library standard=sendig version=ar-1-0
#expectViolationCount 4
#expectViolationAt row=1 USUBJID=001
#expectViolationAt row=2 USUBJID=001
#expectViolationAt row=3 USUBJID=002
#expectViolationAt row=4 USUBJID=003
dataset CM class=INTERVENTIONS label="Concomitant/Prior Medications"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col CMSEQ    type=Num  label="Sequence Number"
col CMTRT    type=Char label="Reported Name of Drug, Med, or Therapy"
col CMENDTC  type=Char label="End Date/Time of Medication"
col CMCHENDY type=Num  label="End Day of Obs Rel to Challenge Agent"
---
S1 | CM | 001 | 1 | SALINE |            | 5
S1 | CM | 001 | 2 | SALINE | 2020-01    | 5
S1 | CM | 002 | 1 | SALINE | 2020-01-10 | 5
S1 | CM | 003 | 1 | SALINE | 2020-01-10 | 5
S1 | CM | 001 | 3 | SALINE | 2020-01-10 | 5
S1 | CM | 001 | 4 | SALINE |            | .
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFCSTDTC type=Char label="Date/Time of First Challenge Agent Admin"
---
S1 | DM | 001 | 2020-01-05
S1 | DM | 002 |
S1 | DM | 003 | 2020-01
---
