#!RuleTest
#test PMDA-SD1250 expect=skipped domain=SV
#note "SV's class is IN Classes.Include, so ONLY the Domains.Exclude [DM, SE, SV] rejects (SD1126 discipline). Pins the sheet-cell exclusions the FDA twin (Domains [ALL]) does not have."
#library standard=sdtmig version=3-4
dataset SV class="SPECIAL PURPOSE"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col VISITNUM type=Num
col SVTPT    type=Char
---
S1 | SV | 001 | 1 | PRE-DOSE
---
