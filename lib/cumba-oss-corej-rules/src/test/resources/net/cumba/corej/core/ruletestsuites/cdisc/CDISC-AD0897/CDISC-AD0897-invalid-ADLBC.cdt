#!RuleTest
#test CDISC-AD0897 expect=violation domain=ADLBC
# Rule:Description: A non-missing value of TRTA is not equal to at least one value of the character actual treatment variables in ADSL defined in the IG
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015
# Declared-tier scope: structure= states the ADaM data structure this minimal table stands for;
# #define is its mandatory carrier (ScenarioDeclaredScopeProvider.install).
#define standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col TRTA type=Char
---
CDISCPILOT01 | 01-701-1015 | Xanomeline High Dose
---

dataset ADSL label="Subject-Level Analysis"
col STUDYID type=Char
col USUBJID type=Char
col TRTA type=Char
col TRT01A type=Char
---
CDISCPILOT01 | 01-701-1015 | Placebo | Placebo
---
