#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 variable_name=SAFFL USUBJID=01-701-1015
dataset ADAE
col STUDYID type=Char
col USUBJID type=Char
col AETERM  type=Char
col SAFFL   type=Char
