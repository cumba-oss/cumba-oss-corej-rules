#!RuleTest
#test DRAFT-900023 expect=noViolation domain=VS
#note "Same library lines; define declares empty extended lists on all three items (codelist_extended_values=\"[]\"). No sponsor extension flagged -> silent."
#library standard=sdtmig version=3-4
#library variable-metadata VS VSPOS codelist=C71148 codelist_extensible=false
#library variable-metadata VS VSLAT codelist=C99074 codelist_extensible=false
#define domain-variables VS VSTESTCD:Topic VSPOS:Qualifier VSLAT:Qualifier
#define variable-metadata VS VSPOS name=VSPOS codelist_extended_values="[]"
#define variable-metadata VS VSLAT name=VSLAT codelist_extended_values="[]"
#define variable-metadata VS VSTESTCD name=VSTESTCD codelist_extended_values="[]"
dataset VS class=FINDINGS
col USUBJID  type=Char
col VSTESTCD type=Char
col VSPOS    type=Char
col VSLAT    type=Char
---
001 | SYSBP | SUPINE | LEFT
---
