#!RuleTest
#test CDISC-AD0333 expect=violation domain=ADLBC
# Rule:Description: Within a parameter, there is more than one value of PCHGCATy for a given value of PCHGCAyN, considering only those rows on which both variables are populated
#note "within PARAMCD=ALB, PCHGCA1N=1 maps to 2 distinct PCHGCAT1 values -> violation"
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015
#expectViolationAt row=2 USUBJID=01-701-1023
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col PCHGCAT1 type=Char
col PCHGCA1N type=Char
---
CDISCPILOT01 | 01-701-1015 | ALB | low | 1
CDISCPILOT01 | 01-701-1023 | ALB | high | 1
---
