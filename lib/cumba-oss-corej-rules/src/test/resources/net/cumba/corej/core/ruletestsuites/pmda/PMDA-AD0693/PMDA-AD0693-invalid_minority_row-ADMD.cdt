#!RuleTest
#test PMDA-AD0693 expect=violation domain=ADMD
#note "PARAMCD detects BDS and SPDEVID refines it to MEDICAL DEVICE BASIC DATA STRUCTURE. One group (DEV01, 01-701-1015, GLUC, LOW) holding BASE {1, 1, 2} -> minority row 3 fires."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=01-701-1015 SPDEVID=DEV01 PARAMCD=GLUC BASE=2 BASEC=LOW
dataset ADMD
col STUDYID type=Char
col USUBJID type=Char
col SPDEVID type=Char
col PARAMCD type=Char
col BASE    type=Num
col BASEC   type=Char
---
CDISCPILOT01 | 01-701-1015 | DEV01 | GLUC | 1 | LOW
CDISCPILOT01 | 01-701-1015 | DEV01 | GLUC | 1 | LOW
CDISCPILOT01 | 01-701-1015 | DEV01 | GLUC | 2 | LOW
