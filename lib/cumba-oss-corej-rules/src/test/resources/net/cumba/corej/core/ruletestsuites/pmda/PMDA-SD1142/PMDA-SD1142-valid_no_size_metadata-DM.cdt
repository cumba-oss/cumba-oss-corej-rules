#!RuleTest
#test PMDA-SD1142 expect=noViolation domain=DM
#note "No dataset_size key on the dataset line -> extract_metadata answers null -> the $-operand is missing -> '>' never fires (missing input never fires). Pins the silent-degradation face of the metadata channel."
#library standard=sdtmig version=3-4
dataset DM label="Demographics"
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
---
CDISCPILOT01 | DM | 01-701-1015
CDISCPILOT01 | DM | 01-701-1023
