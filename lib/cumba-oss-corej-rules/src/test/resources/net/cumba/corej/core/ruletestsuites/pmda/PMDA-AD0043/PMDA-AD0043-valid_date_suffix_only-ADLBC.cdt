#!RuleTest
#test PMDA-AD0043 expect=noViolation domain=ADLBC
#note "ADT ends with DT, not DTM, so this rule is silent even with an invalid-for-dates format - that variable belongs to PMDA-AD0041. Pins the suffix boundary from the other side."
#library standard=adamig version=1-3
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ADT     type=Num format=8.
---
CDISCPILOT01 | 01-701-1015 | ALB | 1
---
