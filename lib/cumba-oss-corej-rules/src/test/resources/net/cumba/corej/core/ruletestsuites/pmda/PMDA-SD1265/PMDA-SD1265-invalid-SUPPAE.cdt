#!RuleTest
#test PMDA-SD1265 expect=violation domain=SUPPAE
#note "CL-A A.2 (wave TA-4): the dormant literal 'SUPPQUAL' scope became the FDA-shape SUPP--/SQ-- wildcards. Row 1 is subjective data (QORIG='ASSIGNED') with no QEVAL naming who assigned it -> fires. Row 2 records the evaluator, row 3 has a collected (CRF) origin."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 QNAM=AETRTEM QEVAL=
dataset SUPPAE label="Supplemental Qualifiers for AE"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM     type=Char label="Qualifier Variable Name"
col QLABEL   type=Char label="Qualifier Variable Label"
col QVAL     type=Char label="Data Value"
col QORIG    type=Char label="Origin"
col QEVAL    type=Char label="Evaluator"
---
S1 | AE | 001 | AESEQ | 1 | AETRTEM | Treatment Emergent Flag | Y | ASSIGNED |
S1 | AE | 001 | AESEQ | 2 | AETRTEM | Treatment Emergent Flag | N | ASSIGNED | ADJUDICATION COMMITTEE
S1 | AE | 001 | AESEQ | 3 | AESOSP  | Other Medically Import. | N | CRF      |
