#!RuleTest
#test FDA-SD1333 expect=noViolation domain=AE
#note "Each resolved event supplies either an end date (row 1) or a collected duration (row 2); the unresolved event (row 3) needs neither."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEOUT   type=Char label="Outcome of Adverse Event"
col AEENDTC type=Char label="End Date/Time of Adverse Event"
col AEDUR   type=Char label="Duration of Adverse Event"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE | RECOVERED/RESOLVED         | 2020-01-09 | 
CDISCPILOT01 | AE | 01-701-1015 | 2 | NAUSEA   | RECOVERED/RESOLVED         |            | P3D
CDISCPILOT01 | AE | 01-701-1015 | 3 | RASH     | NOT RECOVERED/NOT RESOLVED |            | 
