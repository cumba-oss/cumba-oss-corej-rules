#!RuleTest
#test DRAFT-900024 expect=violation domain=VS
#note "Both offenders declare a term C-code that is not published (C99999 / C77777) while their submission VALUES are all correct -- the exact case DRAFT-900021 misses -> two findings. VSTESTCD has no library coded-codes, so the not-empty(LIBRARY) guard excludes it."
#library standard=sdtmig version=3-4
#library variable-metadata VS VSPOS codelist=C71148 codelist_extensible=false codelist_coded_values="[\"SUPINE\",\"STANDING\"]" codelist_coded_codes="[\"C62167\",\"C62166\"]"
#library variable-metadata VS VSLOC codelist=C74456 codelist_extensible=false codelist_coded_values="[\"ARM\",\"LEG\"]" codelist_coded_codes="[\"C32141\",\"C32226\"]"
#define domain-variables VS VSTESTCD:Topic VSPOS:Qualifier VSLOC:Qualifier
#define variable-metadata VS VSPOS name=VSPOS codelist_coded_values="[\"SUPINE\",\"STANDING\"]" codelist_coded_codes="[\"C62167\",\"C99999\"]"
#define variable-metadata VS VSLOC name=VSLOC codelist_coded_values="[\"ARM\",\"LEG\"]" codelist_coded_codes="[\"C32141\",\"C77777\"]"
#define variable-metadata VS VSTESTCD name=VSTESTCD codelist_coded_codes="[]"
#expectViolationCount 2
#expectViolationAt variable_name=VSPOS define_variable_name=VSPOS
#expectViolationAt variable_name=VSLOC define_variable_name=VSLOC
dataset VS class=FINDINGS
col USUBJID  type=Char
col VSTESTCD type=Char
col VSPOS    type=Char
col VSLOC    type=Char
---
001 | SYSBP | SUPINE | ARM
---
