#!RuleTest
#test FDA-SD0021 expect=violation domain=AE
#note "Row 1: no End Time-Point populated and no exception (AEOCCUR column absent, AESTAT and AEDUR empty) -> fires. Row 2 has AEENDTC -> no fire."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001 AESEQ=1
dataset AE class=EVENTS label="Adverse Events"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col AESEQ    type=Num  label="Sequence Number"
col AETERM   type=Char label="Reported Term for the Adverse Event"
col AEENDTC  type=Char label="End Date/Time of Adverse Event"
col AEENRF   type=Char label="End Relative to Reference Period"
col AEENRTPT type=Char label="End Relative to Reference Time Point"
col AESTAT   type=Char label="Completion Status"
col AEDUR    type=Char label="Duration of Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE |            | | | |
S1 | AE | 001 | 2 | NAUSEA   | 2020-01-05 | | | |
