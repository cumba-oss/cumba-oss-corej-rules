#!RuleTest
#test FDA-SE2212 expect=violation domain=TS
#note "No TSPARMCD=SPLRNAM record anywhere in TS -> the 'Test Subject Supplier' parameter is missing, one dataset-level finding. the four sibling SPLR* supplier parameters are present, so a prefix match on SPLR would wrongly silence the rule, so a prefix/substring match on the filter would wrongly silence the rule."
#library standard=sendig version=3-1-1
#expectViolationCount 1
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | STITLE | Study Title | 28-Day Repeat Dose Toxicity Study
S01 | TS | 2 | SPLRCITY | Test Subject Supplier City | WILMINGTON
S01 | TS | 3 | SPLRCTRY | Test Subject Supplier Country | USA
S01 | TS | 4 | SPLRLOC | Test Subject Supplier Site | SITE 1
S01 | TS | 5 | SPLRREG | Test Subject Supplier Region | DELAWARE
