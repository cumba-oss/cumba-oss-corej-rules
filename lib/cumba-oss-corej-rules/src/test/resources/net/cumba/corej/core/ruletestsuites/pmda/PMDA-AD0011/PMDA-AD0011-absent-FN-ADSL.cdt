#!RuleTest
#test PMDA-AD0011 expect=noViolation domain=ADSL
#library standard=adamig version=1-1
#note "The N-side twin of PMDA-AD0010's exception. *FL columns are N and the dataset carries no *FN column; the *FN exists leaf suppresses the rule. JAVA ONLY - the Python fork cannot resolve a * check target at all, so this rule is inert there either way. Paired with the -invalid- positive control."
dataset ADSL class=ADSL
col STUDYID type=Char
col USUBJID type=Char
col SAFFL   type=Char
col ITTFL   type=Char
col EFFFL   type=Char
---
CDISCPILOT01 | 01-701-1015 | N | N | N
CDISCPILOT01 | 01-701-1023 | N | N | N
---
