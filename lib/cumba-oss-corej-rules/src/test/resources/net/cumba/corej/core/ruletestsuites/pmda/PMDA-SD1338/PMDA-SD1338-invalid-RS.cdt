#!RuleTest
#test PMDA-SD1338 expect=violation domain=RS
#note "Row 2 references RSLNKGRP G09, which TR never carries. Row 3 references G01, which TR carries only for subject 001 — the lookup is grouped by USUBJID, so subject 002 must still fire. Row 1 matches; row 4 leaves RSLNKGRP empty and must not fire."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=2 USUBJID=001 RSLNKGRP=G09
#expectViolationAt row=3 USUBJID=002 RSLNKGRP=G01
dataset RS label="Disease Response"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RSSEQ    type=Num  label="Sequence Number"
col RSLNKGRP type=Char label="Link Group ID"
col RSTESTCD type=Char label="Response Assessment Short Name"
col RSORRES  type=Char label="Result or Finding in Original Units"
---
CDISCPILOT01 | RS | 001 | 1 | G01 | OVRLRESP | PR
CDISCPILOT01 | RS | 001 | 2 | G09 | OVRLRESP | SD
CDISCPILOT01 | RS | 002 | 1 | G01 | OVRLRESP | CR
CDISCPILOT01 | RS | 002 | 2 |  | LSTASS | PD
---

dataset TR label="Tumor Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col TRSEQ    type=Num  label="Sequence Number"
col TRLNKGRP type=Char label="Link Group ID"
col TRTESTCD type=Char label="Tumor Assessment Short Name"
col TRORRES  type=Char label="Result or Finding in Original Units"
---
CDISCPILOT01 | TR | 001 | 1 | G01 | LDIAM | 20
CDISCPILOT01 | TR | 002 | 1 | G05 | LDIAM | 12
---
