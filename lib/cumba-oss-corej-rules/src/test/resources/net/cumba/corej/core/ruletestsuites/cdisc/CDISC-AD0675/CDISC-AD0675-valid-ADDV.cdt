#!RuleTest
#test CDISC-AD0675 expect=noViolation domain=ADDV
# Rule:Description: On a given record, DEVGRy is populated and DEVGRyN is not populated
#note "DEVGR1 and DEVGR1N both populated -> noViolation"
dataset ADDV class="DEVICE LEVEL ANALYSIS DATASET"
col STUDYID type=Char
col USUBJID type=Char
col SPDEVID type=Char
col DEVGR1 type=Char
col DEVGR1N type=Char
---
CDISCPILOT01 | 01-701-1015 | DEV01 | V1 | V2
