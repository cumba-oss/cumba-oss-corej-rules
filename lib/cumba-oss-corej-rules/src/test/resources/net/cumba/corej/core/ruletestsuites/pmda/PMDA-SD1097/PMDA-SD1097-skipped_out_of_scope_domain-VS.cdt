#!RuleTest
#test PMDA-SD1097 expect=skipped domain=VS
#note "Scope.Domains.Include [AE] rejects a VS primary -> skip. Pins the single-domain Include mechanism once, on behalf of SD2219's identical [TS] block."
#library standard=sdtmig version=3-4
dataset VS class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col VSSEQ    type=Num
col VSTESTCD type=Char
---
S1 | VS | 001 | 1 | SYSBP
