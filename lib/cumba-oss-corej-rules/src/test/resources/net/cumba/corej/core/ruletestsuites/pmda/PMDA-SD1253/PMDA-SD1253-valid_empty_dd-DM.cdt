#!RuleTest
#test PMDA-SD1253 expect=noViolation domain=DM
#note "FRESH (distinct EmptyResult.SET, positive polarity). DD PRESENT with ZERO data rows (full column set incl. USUBJID declared); DM rows 001|DTHFL empty and 002|DTHFL=N. $usubjids_in_dd = EMPTY SET -> 'USUBJID in {}' is false everywhere -> silent (nobody is recorded as dead, so no DTHFL is owed). If this reports a violation, escalate."
#library standard=sdtmig version=3-4
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col SITEID  type=Char label="Study Site Identifier"
col SEX     type=Char label="Sex"
col DTHDTC  type=Char label="Date/Time of Death"
col DTHFL   type=Char label="Subject Death Flag"
---
CDISCPILOT01 | DM | 001 | 001 | 70 | M |  |
CDISCPILOT01 | DM | 002 | 002 | 70 | F |  | N
---

dataset DD label="Death Details"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col DDSEQ    type=Num  label="Sequence Number"
col DDTESTCD type=Char label="Death Diagnosis Short Name"
col DDTEST   type=Char label="Death Diagnosis"
col DDORRES  type=Char label="Result or Finding in Original Units"
---
