#!RuleTest
#test PMDA-SD0026 expect=noViolation domain=LB
#note "The shipped regex requires a leading integer part, so the numeric-in-substance value '.5' is NOT classified numeric and the rule stays silent. Pins the declared 'Partially Executable - Possible Underreporting' boundary as today's behaviour."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
col LBORRES  type=Char
col LBORRESU type=Char
---
S1 | LB | 001 | 1 | GLUC | .5 |
