#!RuleTest
#test FDA-SD1060 expect=violation domain=SV
#note "Subject S1-001 has two SV records with VISITNUM 1 -> both duplicate records fire; subject S1-002's visit 1 does not."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=S1-001 VISITNUM=1
#expectViolationAt row=2 USUBJID=S1-001 VISITNUM=1
dataset SV class="SPECIAL PURPOSE"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col SVSTDTC  type=Char label="Start Date/Time of Visit"
---
S1 | SV | S1-001 | 1 | 2020-01-01
S1 | SV | S1-001 | 1 | 2020-01-02
S1 | SV | S1-002 | 1 | 2020-01-03
