#!RuleTest
#test CDISC-CG0381 expect=noViolation domain=AE
#note "Row 1's AEHLT 'Headaches NEC' is a MedDRA High Level Term of the (dummy) dictionary; row 2's upper-case variant passes too under the explicit case_sensitive: false (CL-G.4, the pre-TA-3 insensitive behaviour restored)."
#library standard=sdtmig version=3-4
#dictionaries dummy
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEHLT   type=Char label="High Level Term"
---
S1 | AE | 001 | 1 | headache | Headaches NEC
S1 | AE | 001 | 2 | headache | HEADACHES NEC
