#!RuleTest
#test FDA-SD0018 expect=violation domain=LB
#note "Row 1 LBTESTCD='GLUCOSE01' is 9 characters, row 2 '1ALB' starts with a number, row 3 'alb' is lower case — all three break the --TESTCD naming constraint."
#library standard=sdtmig version=3-4
#expectViolationCount 3
#expectViolationAt row=1 LBTESTCD=GLUCOSE01
#expectViolationAt row=2 LBTESTCD=1ALB
#expectViolationAt row=3 LBTESTCD=alb
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | GLUCOSE01
CDISCPILOT01 | LB | 01-701-1015 | 2 | 1ALB
CDISCPILOT01 | LB | 01-701-1015 | 3 | alb
