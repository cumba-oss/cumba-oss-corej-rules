#!RuleTest
#test FDA-SD1037 expect=violation domain=AE
#note "AETOXGR=3 (>0) but the AETOX variable is not present in the dataset, so the bare empty(--TOX) leaf is TRUE on every row (absent = all-missing, EC-43) -> fires. (Plan B phase 4d' deleted the redundant not var_exists(--TOX) disjunct this note used to name; the verdict is unchanged.)"
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 AETOXGR=3
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETOXGR type=Char label="Standard Toxicity Grade"
---
S1 | AE | 001 | 1 | 3
S1 | AE | 001 | 2 | 0
S1 | AE | 001 | 3 |
