#!RuleTest
#test PMDA-AD0148 expect=skipped domain=ADSL
#note "No scope key; the literal name ADSL detects SUBJECT LEVEL ANALYSIS DATASET before any column heuristic runs, so PARAMN does not make it BDS. Data would fire if the structure gate passed. Single negative pin of the [BASIC DATA STRUCTURE(, MEDICAL DEVICE BDS)] block shared by AD0129, AD0130, AD0135B, AD0136B, AD0148, AD0110B, AD0117B."
#library standard=adamig version=1-0
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col PARAMN  type=Num
