#!RuleTest
#test PMDA-AD0582 expect=noViolation domain=ADLBC
#note "Both rows satisfy BCHG = BASE - AVAL -> executes and stays silent. Row 1 carries a NEGATIVE expected value, which is the normal case for this rule and is why its violation fixture uses a positive BCHG."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col BASE    type=Num
col BCHG    type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | 10 | 4 | -6
CDISCPILOT01 | 01-701-1023 | ALB | 8  | 8 | 0
