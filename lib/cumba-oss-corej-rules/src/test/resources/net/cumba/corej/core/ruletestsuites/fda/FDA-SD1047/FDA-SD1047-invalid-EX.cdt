#!RuleTest
#test FDA-SD1047 expect=violation domain=EX
#note "Row 1 populates both EXDOSE and EXDOSTXT on the same record -> only one of the two may be populated."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 EXDOSE=54 EXDOSTXT="50-100 mg"
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXDOSE  type=Num  label="Dose per Administration"
col EXDOSTXT type=Char label="Dose Description"
---
CDISCPILOT01 | EX | 01-701-1015 | 1 | DRUG A | 54 | 50-100 mg
CDISCPILOT01 | EX | 01-701-1015 | 2 | DRUG A | 54 |
