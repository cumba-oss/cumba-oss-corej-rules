#!RuleTest
#test PMDA-AD0330 expect=violation domain=ADVS
#note "Target is the numeric BASECA1N, key is (PARAMCD, BASECAT1). Group (SYSBP, NORMAL) holds {1 x2, 2 x1} -> row 3 is the minority."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 BASECA1N=2 BASECAT1=NORMAL PARAMCD=SYSBP
dataset ADVS class=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col BASECAT1 type=Char
col BASECA1N type=Num
---
S1 | 001 | SYSBP | NORMAL | 1
S1 | 002 | SYSBP | NORMAL | 1
S1 | 003 | SYSBP | NORMAL | 2
S1 | 004 | SYSBP | HIGH   | 3
S1 | 005 | SYSBP | HIGH   | 3
