#!RuleTest
#test FDA-SE2205 expect=violation domain=TS
#note "No TSPARMCD=EXPENDTC record anywhere in TS -> the 'Experimental End Date' parameter is missing, one dataset-level finding. the near-miss parameters EXPSTDTC (same EXP prefix) and STENDTC are present, so a prefix/substring match on the filter would wrongly silence the rule."
#library standard=sendig version=3-1-1
#expectViolationCount 1
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | STITLE | Study Title | 28-Day Repeat Dose Toxicity Study
S01 | TS | 2 | EXPSTDTC | Experimental Start Date | 2023-06-01
S01 | TS | 3 | STENDTC | Study End Date | 2023-07-15
