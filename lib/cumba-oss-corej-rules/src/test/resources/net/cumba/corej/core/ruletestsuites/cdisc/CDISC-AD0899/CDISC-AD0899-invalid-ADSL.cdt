#!RuleTest
#test CDISC-AD0899 expect=violation domain=ADSL
#note "Positive control: ADSL.RFSTDTC is present and disagrees with DM.RFSTDTC for one subject."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1023
dataset ADSL class=ADSL label="Subject Level Analysis Dataset"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
---
CDISCPILOT01 | 01-701-1015 | 2013-01-04
CDISCPILOT01 | 01-701-1023 | 1999-12-31
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
---
CDISCPILOT01 | DM | 01-701-1015 | 2013-01-04
CDISCPILOT01 | DM | 01-701-1023 | 2012-08-05
---
