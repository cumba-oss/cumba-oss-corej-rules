#!RuleTest
#test PMDA-AD0205 expect=noViolation domain=ADSL
#note "ADSL row for subject 01-701-9999 (AGEU=YEARS); DM contains only 01-701-1015 (AGEU=MONTHS). The INNER join drops the unmatched primary row before the Check runs -> no fire. FAMILY pin of the inner-join firing shape (correct per the Join_Type table: this rule fires on populated merged values; the unmatched-subject defect is AD0053's)."
#library standard=adamig version=1-3
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col AGEU    type=Char
---
CDISCPILOT01 | 01-701-9999 | YEARS
---

dataset DM label=Demographics
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col AGEU    type=Char
---
CDISCPILOT01 | DM | 01-701-1015 | MONTHS
