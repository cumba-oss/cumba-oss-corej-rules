#!RuleTest
#test FDA-SD0045 expect=violation domain=UR
#note "Row 1 categorises a result (ABNORMAL) but leaves URSTRESC empty -> 'Character Result/Finding in Std Units (--STRESC) should be provided, when Result Category (--RESCAT) is specified'."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 URRESCAT=ABNORMAL URSTRESC=
dataset UR class=FINDINGS label="Urinary System Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col URSEQ    type=Num  label="Sequence Number"
col URTESTCD type=Char label="Urinary System Findings Test Short Name"
col URSTRESC type=Char label="Character Result/Finding in Std Format"
col URRESCAT type=Char label="Result Category"
---
CDISCPILOT01 | UR | 01-701-1015 | 1 | VOLUME |     | ABNORMAL
CDISCPILOT01 | UR | 01-701-1015 | 2 | VOLUME | 250 | NORMAL
