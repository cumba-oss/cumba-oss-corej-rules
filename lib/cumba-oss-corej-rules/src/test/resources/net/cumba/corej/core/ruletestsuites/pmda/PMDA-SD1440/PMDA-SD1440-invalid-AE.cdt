#!RuleTest
#test PMDA-SD1440 expect=violation domain=AE
#note "The collected term 'HEADACHE' is coded to two different preferred terms ('Headache' and 'Cephalalgia'), so --DECOD is not consistent for the same --TERM. Both records of the conflicting pair are reported."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 AETERM=HEADACHE AEDECOD=Headache
#expectViolationAt row=2 AETERM=HEADACHE AEDECOD=Cephalalgia
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEDECOD type=Char label="Dictionary-Derived Term"
---
S1 | AE | 001 | 1 | HEADACHE | Headache
S1 | AE | 002 | 1 | HEADACHE | Cephalalgia
S1 | AE | 003 | 1 | NAUSEA   | Nausea
