#!RuleTest
#test PMDA-SD2237 expect=violation domain=DM
#note "Row 2 was planned for 'Placebo' but the actual arm description says 'Xanomeline High Dose' -> fires."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 ACTARM="Xanomeline High Dose"
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col ARM     type=Char label="Description of Planned Arm"
col ACTARM  type=Char label="Description of Actual Arm"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015 | Placebo | Placebo
CDISCPILOT01 | DM | 01-701-1023 | 1023 | Placebo | Xanomeline High Dose
