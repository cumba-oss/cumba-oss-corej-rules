#!RuleTest
#test PMDA-SD1064 expect=violation domain=TE
#note "ETCD SCRN appears on two TE records (whole-dataset uniqueness, no grouping key) -> both duplicate records fire."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 ETCD=SCRN
#expectViolationAt row=2 ETCD=SCRN
dataset TE class="TRIAL DESIGN"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ETCD    type=Char label="Element Code"
col ELEMENT type=Char label="Description of Element"
---
S1 | TE | SCRN | Screening
S1 | TE | SCRN | Screening Part 2
S1 | TE | TRT  | Treatment
