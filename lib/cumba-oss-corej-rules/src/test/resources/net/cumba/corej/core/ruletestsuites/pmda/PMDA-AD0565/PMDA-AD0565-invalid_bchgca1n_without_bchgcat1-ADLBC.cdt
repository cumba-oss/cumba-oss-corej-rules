#!RuleTest
#test PMDA-AD0565 expect=violation domain=ADLBC
#note "BCHGCA1N present, BCHGCAT1 absent from the table -> ^BCHGCA(\d+)N$ matches BCHGCA1N (y=1), ^BCHGCAT(\d+)$ matches nothing -> ONE expansion, presence Check fires at row 1."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 BCHGCA1N=1
dataset ADLBC structure=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVAL     type=Num
col BCHGCA1N type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | 3.5 | 1
