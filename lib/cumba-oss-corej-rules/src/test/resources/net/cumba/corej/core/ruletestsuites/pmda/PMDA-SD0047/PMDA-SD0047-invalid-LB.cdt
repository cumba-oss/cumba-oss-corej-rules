#!RuleTest
#test PMDA-SD0047 expect=violation domain=LB
#note "ADAPTED-FROM fda/FDA-SD0047/FDA-SD0047-invalid-LB.cdt (verbatim). Row 1: LBORRES empty, LBSTAT empty, LBDRVFL empty -> fires. Row 2: LBORRES empty, LBSTAT empty, LBDRVFL='N' (not 'Y') -> fires via the not-equal branch. Row 3: LBORRES populated -> no fire."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 LBSEQ=1
#expectViolationAt row=2 LBSEQ=2
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col LBSEQ   type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBORRES type=Char label="Result or Finding in Original Units"
col LBSTAT  type=Char label="Completion Status"
col LBDRVFL type=Char label="Derived Flag"
---
S1 | LB | 001 | 1 | GLUC |     |          |
S1 | LB | 001 | 2 | ALB  |     |          | N
S1 | LB | 001 | 3 | HGB  | 7.2 |          |
