#!RuleTest
#test PMDA-SD1011 expect=violation domain=LB
#note "FRESH. LBELTM boundary rows: (1) P1Y2W FIRES (the W form is an EXCLUSIVE alternation branch in ISO_8601_DURATION_POSITIVE and cannot combine with Y/M/D/T); (2) PT FIRES (bare designator, explicit early-out in ScalarSemantics.isInvalidDuration); (3) P FIRES (same early-out); (4) P2W SILENT (the week form alone is valid). LBORRES is the REGEX CONTROL: it holds the same invalid duration (P1Y2W) on all four rows and must never fire, because its NAME does not end in any of the nine alternatives — that is what proves the varname() gate is doing the selecting. Count is therefore 3, not 12."
#library standard=sdtmig version=3-4
#expectViolationCount 3
#expectViolationAt row=1 variable_name=LBELTM variable_value=P1Y2W
#expectViolationAt row=2 variable_name=LBELTM variable_value=PT
#expectViolationAt row=3 variable_name=LBELTM variable_value=P
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col LBSEQ   type=Num
col LBELTM  type=Char label="Planned Elapsed Time from Time Point Ref"
col LBORRES type=Char label="Result or Finding in Original Units"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | P1Y2W | P1Y2W
CDISCPILOT01 | LB | 01-701-1015 | 2 | PT    | P1Y2W
CDISCPILOT01 | LB | 01-701-1015 | 3 | P     | P1Y2W
CDISCPILOT01 | LB | 01-701-1015 | 4 | P2W   | P1Y2W
