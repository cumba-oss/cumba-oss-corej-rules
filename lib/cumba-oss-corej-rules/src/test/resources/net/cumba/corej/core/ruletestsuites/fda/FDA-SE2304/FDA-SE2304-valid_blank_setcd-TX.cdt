#!RuleTest
#test FDA-SE2304 expect=noViolation domain=TX
#note "Rows 3/4 form a group whose SETCD is empty and that carries no TRTDOSU record. The Check's 'SETCD non_empty' leaf suppresses that group (an empty Req SETCD is another rule's finding), so only the populated SET01 group is judged - and it carries TRTDOSU -> no violation."
#library standard=sendig version=3-1-1
dataset TX class="TRIAL DESIGN" label="Trial Sets"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col SETCD    type=Char label="Set Code"
col SET      type=Char label="Set Description"
col TXSEQ    type=Num  label="Sequence Number"
col TXPARMCD type=Char label="Trial Set Parameter Short Name"
col TXPARM   type=Char label="Trial Set Parameter"
col TXVAL    type=Char label="Trial Set Parameter Value"
---
S01 | TX | SET01 | Control   | 1 | TRTDOSU | Dose Units  | mg/kg/day
S01 | TX | SET01 | Control   | 2 | GRPLBL  | Group Label | Control
S01 | TX |       |           | 3 | GRPLBL  | Group Label | Unassigned
S01 | TX |       |           | 4 | TRTDOS  | Dose        | 100
