#!RuleTest
#test PMDA-SD0016 expect=noViolation domain=LB
#note "Rows: DRVFL=Y with populated STRESC; DRVFL=N with empty STRESC; DRVFL empty with empty STRESC. All clean."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
col LBORRES  type=Char
col LBSTRESC type=Char
col LBDRVFL  type=Char
---
S1 | LB | 001 | 1 | GLUC | 5.1 | 5.1 | Y
S1 | LB | 001 | 2 | ALB  |     |     | N
S1 | LB | 001 | 3 | CHOL |     |     |
