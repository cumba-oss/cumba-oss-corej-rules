#!RuleTest
#test PMDA-AD0127A expect=noViolation domain=ADLBC
#note "Isolates the leading disjunction: neither BASE nor BASEC nor ABLFL is declared, so a BDS dataset carrying no baseline value at all owes no ABLFL and the rule executes without firing."
#library standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
---
CDISCPILOT01 | 01-701-1015 | ALT | 2.5
CDISCPILOT01 | 01-701-1023 | ALT | 7.0
