#!RuleTest
#test CDISC-SEND-0052 expect=violation domain=BW
#note "BWTESTCD's define ItemDef carries NO CodeListRef at all -> var_codelist(DEFINE) empty AND var_ccode(DEFINE) empty while the SENDIG assigns CT -> fires: the define neither includes CT nor references it."
#library standard=sendig version=3-1-1
#library variable-metadata BW BWTESTCD name=BWTESTCD codelist=C90001
#library variable-metadata BW USUBJID name=USUBJID
#define-xml CDISC-SEND-0052-define.xml
#expectViolationCount 1
#expectViolationAt define_variable_name=BWTESTCD library_variable_codelist=C90001
dataset BW
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col BWSEQ    type=Num
col BWTESTCD type=Char
---
S1 | BW | 001 | 1 | BW
