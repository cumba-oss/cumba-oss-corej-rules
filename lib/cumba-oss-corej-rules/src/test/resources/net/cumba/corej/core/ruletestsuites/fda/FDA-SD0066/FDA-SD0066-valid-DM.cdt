#!RuleTest
#test FDA-SD0066 expect=noViolation domain=DM
#note "Row 1 ARMCD=A is a TA arm; row 2 SCRNFAIL and row 3 NOTASSGN are the sheet's exceptions; row 4 has an empty ARMCD."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
---
S1 | DM | 001 | A        | Arm A
S1 | DM | 002 | SCRNFAIL | Screen Failure
S1 | DM | 003 | NOTASSGN | Not Assigned
S1 | DM | 004 |          |
---

dataset TA class="TRIAL DESIGN" label="Trial Arms"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
col TAETORD type=Num  label="Order of Element within Arm"
col ETCD    type=Char label="Element Code"
---
S1 | TA | A | Arm A | 1 | SCRN
S1 | TA | B | Arm B | 1 | SCRN
