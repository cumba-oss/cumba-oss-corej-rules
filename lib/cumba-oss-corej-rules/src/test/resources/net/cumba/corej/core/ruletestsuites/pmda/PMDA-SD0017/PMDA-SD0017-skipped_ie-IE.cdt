#!RuleTest
#test PMDA-SD0017 expect=skipped domain=IE
#note "FRESH - the batch's Domains.Exclude reject pin. IE is a member of the included FINDINGS class (class=FINDINGS load-bearing), so only the Domains.Exclude [IE] can reject; the value is violating-shaped (41-char IETEST, the twin's measured string) to prove ONLY the exclusion silences. Sheet issue #45 CLOSED no-defect: the sheet's own '(-IE)' IS the exclusion."
#library standard=sdtmig version=3-4
dataset IE class=FINDINGS label="Inclusion/Exclusion Criteria Not Met"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col IESEQ   type=Num  label="Sequence Number"
col IETESTCD type=Char label="IE Criterion Short Name"
col IETEST   type=Char label="IE Criterion"
---
S1 | IE | 001 | 1 | INCL01 | Alanine Aminotransferase Measured in Seru
