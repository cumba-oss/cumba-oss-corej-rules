#!RuleTest
#test PMDA-AD0247 expect=violation domain=ADTTE
#note "CNSR populated on row 1 while AVAL is blank -> the first inner disjunct fires. Row 2 has everything populated (CNSR=0 is POPULATED, not missing) -> silent. Record granularity -> 1 violation. AVAL is blank on the fired row and is therefore not pinned."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015 CNSR=1 STARTDT=22000
dataset ADTTE structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col STARTDT type=Num
col ADT     type=Num
col ADTM    type=Num
col CNSR    type=Num
---
CDISCPILOT01 | 01-701-1015 | TTDEATH |    | 22000 | 22100 | 22100 | 1
CDISCPILOT01 | 01-701-1023 | TTDEATH | 30 | 22000 | 22100 | 22100 | 0
