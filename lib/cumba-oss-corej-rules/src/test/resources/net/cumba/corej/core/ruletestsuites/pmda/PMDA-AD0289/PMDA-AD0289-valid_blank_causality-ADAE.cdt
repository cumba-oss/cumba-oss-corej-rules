#!RuleTest
#test PMDA-AD0289 expect=noViolation domain=ADAE
#note "Row 1's AREL (the DEPENDENT) is blank while ARELN stays 1: key 1 left with single dependent {NOTRELATED} -> silent. Pin on the blank-DEPENDENT side of D.13."
#library standard=adamig version=1-0
#expectViolationCount 0
dataset ADAE structure=OCCDS
col STUDYID type=Char
col USUBJID type=Char
col AESEQ   type=Num
col AEDECOD type=Char
col AREL    type=Char
col ARELN   type=Num
---
