#!RuleTest
#test PMDA-AD0212 expect=violation domain=ADLBC
#note "PMDA admits ONLY 1 (unlike the CDISC *FN family which accepts [0, 1]): a populated 0 IS reported. Grounded in the PMDA sheet's own 'ANLzzFN ... must be 1 or null'."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 variable_name=ANL01FN USUBJID=01-701-1015
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ANL01FN type=Num
---
CDISCPILOT01 | 01-701-1015 | SYSBP | 0
