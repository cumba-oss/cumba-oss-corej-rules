#!RuleTest
#test FDA-SD1383 expect=noViolation domain=CM
#note "CMXENDY equals the study-day value dy(CMENDTC, RFXSTDTC) on every checked row: row1 on/after (+1 branch), row2 precedes (no +1), row3 same day = 1 (no day 0); row4 incomplete CMENDTC and row6 incomplete DM.RFXSTDTC are guard-blocked; row5 CMXENDY missing. DM carries three distinct reference dates so a wrong reference column would mis-compute and fire."
#library standard=sendig version=ar-1-0
dataset CM class=INTERVENTIONS
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ   type=Num  label="Sequence Number"
col CMTRT   type=Char label="Reported Name of Treatment"
col CMENDTC type=Char label="End Date/Time of Observation"
col CMXENDY  type=Num  label="End Day of Obs Relative to Exposure"
---
S1 | CM | 001 | 1 | DRUG A | 2023-06-15 | 6
S1 | CM | 001 | 2 | DRUG A | 2023-06-08 | -2
S1 | CM | 001 | 3 | DRUG A | 2023-06-10 | 1
S1 | CM | 001 | 4 | DRUG A | 2023-06 | 99
S1 | CM | 001 | 5 | DRUG A | 2023-06-15 | 
S1 | CM | 002 | 1 | DRUG A | 2023-06-15 | 6
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFSTDTC  type=Char label="Subject Reference Start Date/Time"
col RFXSTDTC type=Char label="Date/Time of First Study Treatment"
col RFCSTDTC type=Char label="Date/Time of First Challenge Agent Admin"
---
S1 | DM | 001 | 2023-06-01 | 2023-06-10 | 2023-06-20
S1 | DM | 002 | 2023-06-01 | 2023-06    | 2023-06-20
