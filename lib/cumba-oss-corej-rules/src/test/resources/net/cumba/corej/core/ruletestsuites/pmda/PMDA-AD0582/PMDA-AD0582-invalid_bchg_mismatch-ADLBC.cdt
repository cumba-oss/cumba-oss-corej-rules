#!RuleTest
#test PMDA-AD0582 expect=violation domain=ADLBC
#note "Row 1: BASE-AVAL = -6 but BCHG = 5 -> fires. Row 2: correct (BCHG=-6) -> silent. The subtraction runs BASE minus AVAL, the reverse of AD0223's CHG: row 1 would ALSO have fired under AD0223's formula, but row 2 (BCHG = -6) would have fired there and is silent here, which is what makes the two fixtures discriminating."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015 AVAL=10 BASE=4 BCHG=5
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col BASE    type=Num
col BCHG    type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | 10 | 4 | 5
CDISCPILOT01 | 01-701-1023 | ALB | 10 | 4 | -6
