#!RuleTest
#test FDA-SD0082 expect=violation domain=EX
#note "row 1: 001's EXENDTC 2023-06-05 is after 001's latest DSSTDTC 2023-06-01 -> fires; row 2: 002's EXENDTC 2023-06-15 is before 002's own later maximum 2023-06-30 (per-subject grouping) -> no fire"
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 EXENDTC=2023-06-05
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXENDTC type=Char label="End Date/Time of Treatment"
---
S1 | EX | 001 | 1 | DRUG A | 2023-06-05
S1 | EX | 002 | 1 | DRUG A | 2023-06-15
---

dataset DS class=EVENTS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSDECOD type=Char label="Standardized Disposition Term"
col DSSTDTC type=Char label="Start Date/Time of Disposition Event"
---
S1 | DS | 001 | 1 | RANDOMIZED | 2023-05-01
S1 | DS | 001 | 2 | COMPLETED  | 2023-06-01
S1 | DS | 002 | 1 | COMPLETED  | 2023-06-30
