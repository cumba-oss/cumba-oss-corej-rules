#!RuleTest
#test PMDA-AD0092 expect=skipped domain=ADLBC
#note "TRTPN absent, so Requirements.Variables.All: [TRTP, TRTPN] skips the rule and the engine reports the absent variable by name. Without the gate the operator would silently drop the absent target and short-circuit to no violations (EC-53)."
#library standard=adamig version=1-0
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col TRTP    type=Char
---
CDISCPILOT01 | 01-701-1015 | ALB | DRUGA
CDISCPILOT01 | 01-701-1023 | ALB | DRUGA
