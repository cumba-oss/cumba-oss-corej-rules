#!RuleTest
#test PMDA-AD0381 expect=violation domain=ADMD
#note "AD-prefixed; PARAMCD detects BDS and SPDEVID refines it to MEDICAL DEVICE BASIC DATA STRUCTURE -- shipped precedent PMDA-AD0388-invalid_medical_device_bds-ADMD.cdt. Pins the FIFTH and last arm AND the device-BDS half of the Include list in one fixture. SPDEVID is NOT part of this rule's key, so DEV01/DEV02 do not split the group."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=01-701-1034 PARAMCD=GLUC ATOXGRH=GRADE4 ATOXGRHN=3
dataset ADMD
col STUDYID   type=Char
col USUBJID   type=Char
col SPDEVID   type=Char
col PARAMCD   type=Char
col ATOXGRH   type=Char
col ATOXGRHN  type=Num
---
CDISCPILOT01 | 01-701-1015 | DEV01 | GLUC | GRADE3 | 3
CDISCPILOT01 | 01-701-1023 | DEV01 | GLUC | GRADE3 | 3
CDISCPILOT01 | 01-701-1034 | DEV02 | GLUC | GRADE4 | 3
