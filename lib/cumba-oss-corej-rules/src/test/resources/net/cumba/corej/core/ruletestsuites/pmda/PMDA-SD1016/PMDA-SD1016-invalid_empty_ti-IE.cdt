#!RuleTest
#test PMDA-SD1016 expect=violation domain=IE
#note "FRESH (DISCRIMINATING - left-join null-fill on an empty foreign table; T2-K3-02 SD1018 precedent). TI PRESENT with ZERO data rows (full column set incl. all three key columns); every IE row is unmatched -> TI.IETESTCD null-filled -> BOTH fire. If this reports 0, escalate."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=001
#expectViolationAt row=2 USUBJID=002
dataset IE label="Inclusion/Exclusion Criteria Not Met"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IESEQ    type=Num  label="Sequence Number"
col IETESTCD type=Char label="Incl/Excl Criterion Short Name"
col IETEST   type=Char label="Inclusion/Exclusion Criterion"
col IECAT    type=Char label="Inclusion/Exclusion Category"
---
S1 | IE | 001 | 1 | INCL01 | Age 18 or older | INCLUSION
S1 | IE | 002 | 1 | EXCL01 | Pregnant        | EXCLUSION
---

dataset TI label="Trial Inclusion/Exclusion Criteria"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col IETESTCD type=Char label="Incl/Excl Criterion Short Name"
col IETEST   type=Char label="Inclusion/Exclusion Criterion"
col IECAT    type=Char label="Inclusion/Exclusion Category"
---
