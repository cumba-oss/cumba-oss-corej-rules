#!RuleTest
#test PMDA-AD0098 expect=noViolation domain=ADLBC
#note "AEDY column is DECLARED but the cell is missing, so not empty(AEDY) is FALSE on that row and the rule is silent - the sheet's comparison only applies where both ends are known. Pins the authored applicability conjunct, which no guard derivation supplies (a NEGATED call is outside every arm)."
#library standard=adamig version=1-3
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ASDY    type=Num
col AEDY    type=Num
---
