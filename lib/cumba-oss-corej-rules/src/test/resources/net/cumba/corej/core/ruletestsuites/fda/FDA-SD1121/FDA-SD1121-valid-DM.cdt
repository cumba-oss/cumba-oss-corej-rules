#!RuleTest
#test FDA-SD1121 expect=noViolation domain=DM
#note "Row 1: AGE populated. Row 2: AGE missing but AGETXT populated. Rows 3/4: ARMCD='SCRNFAIL'/'NOTASSGN' exception. Row 5: ARMCD empty (null-ARMCD exception) -> no violation."
#library standard=sdtmig version=3-4
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AGE     type=Num  label="Age"
col AGETXT  type=Char label="Age Range"
col ARMCD   type=Char label="Planned Arm Code"
---
S1 | DM | 001 | 34 |       | A1
S1 | DM | 002 | .  | 18-65 | A1
S1 | DM | 003 | .  |       | SCRNFAIL
S1 | DM | 004 | .  |       | NOTASSGN
S1 | DM | 005 | .  |       |
