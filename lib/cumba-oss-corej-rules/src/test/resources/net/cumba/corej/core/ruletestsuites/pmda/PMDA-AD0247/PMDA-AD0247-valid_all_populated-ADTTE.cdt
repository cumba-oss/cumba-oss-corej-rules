#!RuleTest
#test PMDA-AD0247 expect=noViolation domain=ADTTE
#note "Row 1: ADTM blank but ADT populated. Row 2: fully populated. Both conformant -> the rule EXECUTES and stays silent."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADTTE structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col STARTDT type=Num
col ADT     type=Num
col ADTM    type=Num
col CNSR    type=Num
