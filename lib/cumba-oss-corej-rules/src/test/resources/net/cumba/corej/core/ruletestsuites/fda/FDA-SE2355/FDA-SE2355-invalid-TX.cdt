#!RuleTest
#test FDA-SE2355 expect=violation domain=TX
#note "Second scoped domain: --PARMCD/--VAL resolve to TXPARMCD/TXVAL in Trial Sets. Row 1 carries 'Fahrenheit' instead of 'F' -> fires; row 2 is conformant."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 TXPARMCD=ENVTEMPU TXVAL=Fahrenheit
dataset TX label="Trial Sets"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col SETCD    type=Char label="Set Code"
col SET      type=Char label="Set Description"
col TXSEQ    type=Num  label="Sequence Number"
col TXPARMCD type=Char label="Trial Set Parameter Short Name"
col TXPARM   type=Char label="Trial Set Parameter"
col TXVAL    type=Char label="Trial Set Parameter Value"
---
STUDY01 | TX | 1 | Control      | 1 | ENVTEMPU | Environmental Temperature Units | Fahrenheit
STUDY01 | TX | 2 | High Dose    | 1 | ENVTEMPU | Environmental Temperature Units | F
