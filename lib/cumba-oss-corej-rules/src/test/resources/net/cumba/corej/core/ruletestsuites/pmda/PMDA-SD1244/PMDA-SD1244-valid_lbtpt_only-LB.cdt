#!RuleTest
#test PMDA-SD1244 expect=noViolation domain=LB
#note "The DIRECTION discriminator: the rule conditions on LBTPTNUM being present, so LBTPT-without-LBTPTNUM must NOT fire (first conjunct false)."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTPT    type=Char
---
S1 | LB | 001 | 1 | PREDOSE
