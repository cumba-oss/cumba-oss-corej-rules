#!RuleTest
#test PMDA-AD0077B expect=violation domain=ADSL
#note "Code 0 carries both PLACEBO and PLCB; PLACEBO is the strict majority so row 3 alone fires."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 TRT01P=PLCB TRT01PN=0
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRT01P type=Char
col TRT01PN type=Num
---
S1 | 001 | PLACEBO | 0
S1 | 002 | PLACEBO | 0
S1 | 003 | PLCB | 0
S1 | 004 | DRUGA | 1
S1 | 005 | DRUGA | 1
