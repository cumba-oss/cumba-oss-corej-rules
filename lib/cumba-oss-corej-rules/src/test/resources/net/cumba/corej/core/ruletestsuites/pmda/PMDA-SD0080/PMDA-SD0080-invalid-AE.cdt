#!RuleTest
#test PMDA-SD0080 expect=violation domain=AE
#note "ADAPTED-FROM fda/FDA-SD0080/FDA-SD0080-invalid-AE.cdt. row 1: 001's AESTDTC 2023-06-02 is after 001's latest DSSTDTC 2023-06-01 -> fires; row 2: 002's AESTDTC 2023-06-15 is before 002's own later maximum 2023-06-30 (per-subject grouping) -> no fire"
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 AESTDTC=2023-06-02
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESTDTC type=Char label="Start Date/Time of Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE | 2023-06-02
S1 | AE | 002 | 1 | NAUSEA   | 2023-06-15
---

dataset DS class=EVENTS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSDECOD type=Char label="Standardized Disposition Term"
col DSSTDTC type=Char label="Start Date/Time of Disposition Event"
---
S1 | DS | 001 | 1 | RANDOMIZED | 2023-05-01
S1 | DS | 001 | 2 | COMPLETED  | 2023-06-01
S1 | DS | 002 | 1 | COMPLETED  | 2023-06-30
