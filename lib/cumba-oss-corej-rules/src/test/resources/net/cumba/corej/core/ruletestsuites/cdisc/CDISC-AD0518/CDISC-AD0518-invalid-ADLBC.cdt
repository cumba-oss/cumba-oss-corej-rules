#!RuleTest
#test CDISC-AD0518 expect=violation domain=ADLBC
# Rule:Description: A variable ending in EDY must contain "Relative End Day" in the label
#note "AEDY label "End Day" lacks "Relative End Day" -> violation"
#expectViolationCount 1
#expectViolationAt variable_label="End Day" variable_name=AEDY
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AEDY type=Char label="End Day"
---
CDISCPILOT01 | 01-701-1015 | ALB | x
