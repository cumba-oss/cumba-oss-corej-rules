#!RuleTest
#test PMDA-AD0237B expect=violation domain=ADLBC
#note "Pooled code 1 carries both POOLA and POOLAA; POOLA is the strict majority so row 3 alone fires."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 TRTPG1=POOLAA TRTPG1N=1
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col TRTPG1 type=Char
col TRTPG1N type=Num
---
S1 | 001 | SYSBP | POOLA | 1
S1 | 002 | SYSBP | POOLA | 1
S1 | 003 | SYSBP | POOLAA | 1
S1 | 004 | SYSBP | POOLB | 2
S1 | 005 | SYSBP | POOLB | 2
