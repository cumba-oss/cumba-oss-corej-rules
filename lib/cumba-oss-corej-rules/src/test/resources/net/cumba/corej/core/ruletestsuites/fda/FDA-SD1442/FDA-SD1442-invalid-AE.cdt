#!RuleTest
#test FDA-SD1442 expect=violation domain=AE
#note "The collected term 'HEADACHE' is mapped to two different MedDRA high level group terms, so --HLGT is not consistent for the same --TERM. Both records of the conflicting pair are reported."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 AETERM=HEADACHE AEHLGT=Headaches
#expectViolationAt row=2 AETERM=HEADACHE AEHLGT="Neurological disorders NEC"
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEDECOD type=Char label="Dictionary-Derived Term"
col AEHLGT   type=Char label="High Level Group Term"
---
S1 | AE | 001 | 1 | HEADACHE | Headache | Headaches
S1 | AE | 002 | 1 | HEADACHE | Headache | Neurological disorders NEC
S1 | AE | 003 | 1 | NAUSEA   | Nausea   | Gastrointestinal signs and symptoms
