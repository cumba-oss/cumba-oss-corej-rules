#!RuleTest
#test FDA-SD1046 expect=violation domain=IE
#note "Boundary: an empty IEORRES on an INCLUSION record is also 'not equal to N' (populated-vs-empty truth table) -> the rule fires."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 IETESTCD=INCL01
dataset IE class=FINDINGS label="Inclusion/Exclusion Criteria Not Met"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IESEQ    type=Num  label="Sequence Number"
col IETESTCD type=Char label="Inclusion/Exclusion Criterion Short Name"
col IECAT    type=Char label="Inclusion/Exclusion Category"
col IEORRES  type=Char label="I/E Criterion Original Result"
---
CDISCPILOT01 | IE | 01-701-1015 | 1 | INCL01 | INCLUSION |
CDISCPILOT01 | IE | 01-701-1023 | 1 | EXCL02 | EXCLUSION | Y
