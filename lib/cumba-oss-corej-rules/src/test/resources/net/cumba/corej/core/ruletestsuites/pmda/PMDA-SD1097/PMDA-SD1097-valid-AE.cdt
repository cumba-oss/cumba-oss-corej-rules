#!RuleTest
#test PMDA-SD1097 expect=noViolation domain=AE
#note "SUPPAE row 1 carries QNAM=AETRTEM (the correct treatment-emergent flag) -> $aetrtem_count=1 -> silent."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col AESEQ   type=Num
col AETERM  type=Char
---
S1 | AE | 001 | 1 | HEADACHE
S1 | AE | 001 | 2 | NAUSEA
---

dataset SUPPAE
col STUDYID  type=Char
col RDOMAIN  type=Char
col USUBJID  type=Char
col IDVAR    type=Char
col IDVARVAL type=Char
col QNAM     type=Char
col QLABEL   type=Char
col QVAL     type=Char
col QORIG    type=Char
---
S1 | AE | 001 | AESEQ | 1 | AETRTEM | Treatment Emergent Flag | Y | DERIVED
S1 | AE | 001 | AESEQ | 2 | AESOSP  | Other SAE               | N | CRF
