#!RuleTest
#test PMDA-AD0005 expect=noViolation domain=ADSL
#note "Both flag cells hold X (outside [Y,N]) but both are silenced by the exception regex: ABLFL matches the literal alternative, ANL01FL matches ^ANL\\d\\dFL$. Pins the two exception branches that ARE live today. Do not add SAFFL."
#library standard=adamig version=1-0
#expectViolationCount 0
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col ABLFL   type=Char
col ANL01FL type=Char
---
