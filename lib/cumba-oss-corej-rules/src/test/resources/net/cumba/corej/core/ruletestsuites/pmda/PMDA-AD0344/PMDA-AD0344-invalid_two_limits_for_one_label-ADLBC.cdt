#!RuleTest
#test PMDA-AD0344 expect=violation domain=ADLBC
#note "No wildcard here -- ANRHI/ANRHIC are concrete ADaM names. Group (PARAMCD=ALB, ANRHIC=HIGH) holds ANRHI {50 x2, 55 x1} -> row 3 is the minority. The pin 55 compares numerically against 55.0."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 ANRHI=55 ANRHIC=HIGH PARAMCD=ALB
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ANRHI   type=Num
col ANRHIC  type=Char
---
S1 | 001 | ALB | 50 | HIGH
S1 | 002 | ALB | 50 | HIGH
S1 | 003 | ALB | 55 | HIGH
S1 | 004 | ALB | 60 | VERYHIGH
S1 | 005 | ALB | 60 | VERYHIGH
