#!RuleTest
#test PMDA-SD1332 expect=skipped domain=AE
#note "The absent-optional-variable contract. AEOUT is NOT declared. Requirements.Variables.All:[AEOUT] skips the rule and names AEOUT. FDA-SD1332 has NO Variables gate, so on this same data it would execute silently; CORE-000657 carries the same gate as PMDA."
#library standard=sdtmig version=3-4
dataset AE label="Adverse Events"
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col AESEQ   type=Num
col AESTDTC type=Char
col AEENDTC type=Char
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | 2020-01-05 | 2020-01-09
---
