#!RuleTest
#test PMDA-AD0126B expect=violation domain=ADLBC
#note "Category VITALS carries both 1 and 3; 1 is the strict majority so row 3 alone fires."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 PARCAT1=VITALS PARCAT1N=3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col PARCAT1 type=Char
col PARCAT1N type=Num
---
S1 | 001 | SYSBP | VITALS | 1
S1 | 002 | SYSBP | VITALS | 1
S1 | 003 | SYSBP | VITALS | 3
S1 | 001 | ALB | CHEMISTRY | 2
S1 | 002 | ALB | CHEMISTRY | 2
