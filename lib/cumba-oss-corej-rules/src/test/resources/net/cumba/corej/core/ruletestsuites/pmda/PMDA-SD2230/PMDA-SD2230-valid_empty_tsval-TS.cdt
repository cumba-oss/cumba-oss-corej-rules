#!RuleTest
#test PMDA-SD2230 expect=noViolation domain=TS
#note "TSPARMCD=STYPE record is present but TSVAL is empty: the rule checks that the parameter RECORD exists, not that its value is populated -> no violation."
#library standard=sdtmig version=3-4
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | STYPE    | Study Type                             |
S01 | TS | 2 | TITLE    | Trial Title                            | A Study of Drug X in Condition Y
S01 | TS | 3 | TPHASE   | Trial Phase Classification             | PHASE III TRIAL
S01 | TS | 4 | SPONSOR  | Clinical Study Sponsor                 | ACME PHARMA
