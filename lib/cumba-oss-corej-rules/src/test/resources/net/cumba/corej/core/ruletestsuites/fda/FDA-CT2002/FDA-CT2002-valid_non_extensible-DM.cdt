#!RuleTest
#test FDA-CT2002 expect=noViolation domain=DM
#note "Boundary against the sibling non-extensible check: SEX carries a value outside its codelist, but that codelist is non-extensible, so this extensible-only rule must stay silent."
#library standard=sdtmig version=3-4
#library variable-metadata DM SEX codelist=SEX codelist_extensible=false codelist_coded_values="[\"M\",\"F\",\"U\"]"
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SEX     type=Char label="Sex"
---
S1 | DM | 001 | M
S1 | DM | 002 | X
