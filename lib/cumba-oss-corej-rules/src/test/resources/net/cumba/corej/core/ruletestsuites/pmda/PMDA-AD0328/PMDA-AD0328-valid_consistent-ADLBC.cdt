#!RuleTest
#test PMDA-AD0328 expect=noViolation domain=ADLBC
#note "Each (PARAMCD, AVALCAT1) group maps to one numeric code."
#library standard=adamig version=1-3
dataset ADLBC class=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVALCAT1 type=Char
col AVALCA1N type=Num
---
S1 | 001 | ALB | LOW  | 1
S1 | 002 | ALB | LOW  | 1
S1 | 003 | ALB | HIGH | 2
