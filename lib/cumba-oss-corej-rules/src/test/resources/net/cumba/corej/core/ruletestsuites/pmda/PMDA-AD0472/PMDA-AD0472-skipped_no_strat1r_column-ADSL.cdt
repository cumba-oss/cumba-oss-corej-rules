#!RuleTest
#test PMDA-AD0472 expect=skipped domain=ADSL
#note "STRAT1R is not declared. The expansion is seeded from STRATwRN (w=1) and STRATwR is synthesised as the absent STRAT1R; Requirements.Variables.All ['STRATwR'] rewrites to ['STRAT1R'], absent, so the rule is reported not executed."
#library standard=adamig version=1-3
dataset ADSL
col STUDYID  type=Char
col USUBJID  type=Char
col STRAT1RN type=Num
---
S1 | 001 | 1
S1 | 002 | 2
