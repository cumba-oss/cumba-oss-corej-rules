#!RuleTest
#test FDA-SE1152 expect=violation domain=EX
#note "Row 1: EXSTDTC 2019-12-31 is before DM.RFSTDTC 2020-01-01 -> fires. Row 2: equal -> clean (rule is strictly before). Row 3: after -> clean. Row 4: EXSTDTC empty -> clean. Row 5: subject 002 whose RFSTDTC is empty -> clean (date comparison against a null reference does not fire)."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
---
S1 | EX | 001 | 1 | DRUG A | 2019-12-31
S1 | EX | 001 | 2 | DRUG A | 2020-01-01
S1 | EX | 001 | 3 | DRUG A | 2020-01-15
S1 | EX | 001 | 4 | DRUG A |
S1 | EX | 002 | 1 | DRUG A | 2019-01-01
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
---
S1 | DM | 001 | 2020-01-01
S1 | DM | 002 |
---
