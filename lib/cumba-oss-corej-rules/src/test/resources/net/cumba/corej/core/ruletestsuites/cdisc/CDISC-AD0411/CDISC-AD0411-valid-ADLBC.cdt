#!RuleTest
#test CDISC-AD0411 expect=noViolation domain=ADLBC
# Rule:Description: On a given record, ANLzzFN is populated and ANLzzFL is not populated
#note "ANL01FN populated and ANL01FL populated -> noViolation"
# Declared-tier scope: the class= declaration disagrees with the columns, so #define must
# carry it to RuleRunner (ScenarioDeclaredScopeProvider.install).
#define standard=adamig version=1-3
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col ANL01FN type=Char
col ANL01FL type=Char
---
CDISCPILOT01 | 01-701-1015 | VAL | VAL
---
