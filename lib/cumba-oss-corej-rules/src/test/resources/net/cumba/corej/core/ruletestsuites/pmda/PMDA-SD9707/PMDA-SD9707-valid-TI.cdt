#!RuleTest
#test PMDA-SD9707 expect=noViolation domain=TI
# Rule:Description: PMDA-SD9707 — the Required key IETEST is not populated.
#note "IETEST populated -> noViolation; the twin scenario differs only in the value of IETEST."
#library standard=sdtmig version=3-4
dataset TI
col STUDYID type=Char
col DOMAIN type=Char
col IETESTCD type=Char
col IETEST type=Char
col IECAT type=Char
---
S1      | TI     | INCL01   | Age 18 years or older | INCLUSION
---
