#!RuleTest
#test CDISC-SEND-0312 expect=noViolation domain=CO
#note "Every (COSEQ, POOLID) tuple is unique and COSEQ deliberately REPEATS across pools, which is what the sheet permits and what a key-less reading would wrongly flag."
#library standard=sendig version=3-1-1
#expectViolationCount 0
dataset CO
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col POOLID  type=Char
col COSEQ   type=Num  label="Sequence Number"
col COVAL   type=Char label="Comment"
---
S1 | CO |  | POOL1 | 1 | A
S1 | CO |  | POOL1 | 2 | B
S1 | CO |  | POOL2 | 1 | C
S1 | CO |  | POOL2 | 2 | D
---
