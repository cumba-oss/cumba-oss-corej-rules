#!RuleTest
#test CDISC-AD0715 expect=violation domain=ADLBC
# Rule:Description: There is more than one value of a variable which has a suffix of GRy for a given value of a variable with the same root name and suffix of GRyN, considering only those rows on which both variables are populated
#note "AETOXGR1N=1 maps to two distinct AETOXGR1 -> violation"
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015
#expectViolationAt row=2 USUBJID=01-701-1023
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AETOXGR1 type=Char
col AETOXGR1N type=Num
---
CDISCPILOT01 | 01-701-1015 | GLUC | GRADE 1 | 1
CDISCPILOT01 | 01-701-1023 | GLUC | MILD | 1
---
