#!RuleTest
#test FDA-SD9707 expect=violation domain=TI
# Rule:Description: FDA-SD9707 — the Required key IETEST is not populated.
#note "IETEST blank -> violation; the twin scenario differs only in the value of IETEST."
#library standard=sdtmig version=3-4
#expectViolationCount 1
dataset TI
col STUDYID type=Char
col DOMAIN type=Char
col IETESTCD type=Char
col IETEST type=Char
col IECAT type=Char
---
S1      | TI     | INCL01   |        | INCLUSION
---
