#!RuleTest
#test PMDA-AD0344 expect=noViolation domain=ADLBC
#note "ANRHIC is not declared. The guard not empty(ANRHIC) is false on every row, so the rule EXECUTES and stays silent even though the degraded key ([PARAMCD] alone) would otherwise flag row 3."
#library standard=adamig version=1-3
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ANRHI   type=Num
---
S1 | 001 | ALB | 50
S1 | 002 | ALB | 50
S1 | 003 | ALB | 55
