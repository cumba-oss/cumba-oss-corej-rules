#!RuleTest
#test PMDA-SD1040 expect=skipped domain=CM
#note "No CMSCAT column -> Requirements.Variables.All [--SCAT] rejects - this rule's own gate variable (SD1039 pins [--CAT]; the DOMAIN/--TESTCD arms and the TI class gate are pinned on SD1039 for the pair, identical mechanism)."
#library standard=sdtmig version=3-4
dataset CM class=INTERVENTIONS
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col CMSEQ   type=Num
col CMTRT   type=Char
---
S1 | CM | 001 | 1 | ASPIRIN
---
