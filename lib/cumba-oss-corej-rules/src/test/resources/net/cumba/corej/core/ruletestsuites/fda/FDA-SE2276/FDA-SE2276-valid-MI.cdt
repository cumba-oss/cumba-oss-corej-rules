#!RuleTest
#test FDA-SE2276 expect=noViolation domain=MI
#note "Subject 001's latest disposition starts 2020-01-20 (an earlier interim disposition on 2020-01-05 must not win). Row 1: MIDTC equals the latest DSSTDTC -> clean. Row 2: MIDTC empty -> guarded out by non_empty. Row 3: subject 002 has no DS record -> guarded out by is_contained_by $ds_usubjid."
#library standard=sendig version=3-1-1
dataset MI label="Microscopic Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col MISEQ    type=Num  label="Sequence Number"
col MITESTCD type=Char label="Microscopic Examination Short Name"
col MISPEC   type=Char label="Specimen Material Type"
col MIORRES  type=Char label="Result or Finding in Original Units"
col MIDTC    type=Char label="Date/Time of Collection"
---
S1 | MI | 001 | 1 | MIEXAM | LIVER  | NECROSIS | 2020-01-20
S1 | MI | 001 | 2 | MIEXAM | KIDNEY | NORMAL   |
S1 | MI | 002 | 1 | MIEXAM | LIVER  | NORMAL   | 2020-01-11
---

dataset DS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSTERM  type=Char label="Reported Term for the Disposition Event"
col DSDECOD type=Char label="Standardized Disposition Term"
col DSSTDTC type=Char label="Start Date/Time of Disposition Event"
---
S1 | DS | 001 | 1 | MOVED TO RECOVERY  | RECOVERY           | 2020-01-05
S1 | DS | 001 | 2 | TERMINAL SACRIFICE | TERMINAL SACRIFICE | 2020-01-20
