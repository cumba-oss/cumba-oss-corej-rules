#!RuleTest
#test PMDA-AD0143 expect=noViolation domain=ADLBC
#note "Row 2 '_TEMP' - a LEADING UNDERSCORE, which [A-Z_] admits; row 3 'A1' - digits allowed after the first position; row 4 'AbcDef12' - EXACTLY eight characters with a MIXED-CASE tail, which the ADaM class admits (finding AD0143-F1) and PMDA-SD1474's upper-case-only is_valid_name would reject."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
---
CDISCPILOT01 | 01-701-1015 | GLUC | 5.5
CDISCPILOT01 | 01-701-1023 | _TEMP | 5.6
CDISCPILOT01 | 01-701-1034 | A1 | 5.7
CDISCPILOT01 | 01-701-1040 | AbcDef12 | 5.8
