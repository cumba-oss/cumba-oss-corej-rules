#!RuleTest
#test CDISC-CG0031 expect=violation domain=LB
#note "SDTMIG 3.2 has no SVPRESP in SV at all, so the not_exists arm of the pre-specified gate is true for every row. That is the authored fallback, not a flood: the Description states that when SVPRESP is not present all non-missing VISIT values are checked against TV.VISIT, and the two surviving conjuncts still decide. Row 1's BASELINE is in TV -> clean. Row 2's WEEK 99 is not -> fires. Row 3's VISIT is empty -> clean. One violation out of three rows, not three."
#library standard=sdtmig version=3-2
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1015 VISIT="WEEK 99"
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB | 2  | BASELINE
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALB | 99 | WEEK 99
CDISCPILOT01 | LB | 01-701-1015 | 3 | ALB | 3  |
---

dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | SV | 01-701-1015 | 2  | BASELINE
CDISCPILOT01 | SV | 01-701-1015 | 99 | WEEK 99
---

dataset TV label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | TV | 1 | SCREENING
CDISCPILOT01 | TV | 2 | BASELINE
---
