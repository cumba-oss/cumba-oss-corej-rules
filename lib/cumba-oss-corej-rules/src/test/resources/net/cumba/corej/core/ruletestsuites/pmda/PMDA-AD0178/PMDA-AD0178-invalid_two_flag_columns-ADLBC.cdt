#!RuleTest
#test PMDA-AD0178 expect=violation domain=ADLBC
#note "Per-CELL granularity of a melted value check: both columns match ^ANL\\d\\dFL$ and both are populated and not Y, so one data row yields TWO findings, distinguished by variable_name and not by row."
#library standard=adamig version=1-3
#expectViolationCount 2
#expectViolationAt row=1 variable_name=ANL01FL USUBJID=01-701-1015
#expectViolationAt row=1 variable_name=ANL02FL USUBJID=01-701-1015
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ANL01FL type=Char
col ANL02FL type=Char
---
CDISCPILOT01 | 01-701-1015 | SYSBP | N | X
