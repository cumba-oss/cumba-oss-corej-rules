#!RuleTest
#test FDA-SD0063 expect=noViolation domain=qsco
#note "Fix #373 control — a LOWERCASE LETTER split (qsco, DOMAIN=QS) with a conformant label. unsplitName cannot help here (no trailing digits, no SUPP/AP prefix), so this case rests entirely on cdiscDomainOf's DOMAIN-cell leg. The label agrees with the Library's, so the rule must stay silent."
#library standard=sdtmig version=3-2
#library variable-metadata QS QSORRES name=QSORRES label="Finding in Original Units"
dataset qsco class=FINDINGS label="Questionnaires - Cognitive"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col QSORRES type=Char label="Finding in Original Units"
---
S1 | QS | 001 | LOW
