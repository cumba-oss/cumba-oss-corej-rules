#!RuleTest
#test PMDA-SD0045 expect=skipped domain=UR
#note "URRESCAT (the trigger, the only Requirements.Variables.All entry) is not present -> the rule is gated off even though URSTRESC is empty on row 1."
#library standard=sdtmig version=3-4
dataset UR class=FINDINGS label="Urinary System Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col URSEQ    type=Num  label="Sequence Number"
col URTESTCD type=Char label="Urinary System Findings Test Short Name"
col URSTRESC type=Char label="Character Result/Finding in Std Format"
---
CDISCPILOT01 | UR | 01-701-1015 | 1 | VOLUME |
CDISCPILOT01 | UR | 01-701-1015 | 2 | VOLUME | 250
