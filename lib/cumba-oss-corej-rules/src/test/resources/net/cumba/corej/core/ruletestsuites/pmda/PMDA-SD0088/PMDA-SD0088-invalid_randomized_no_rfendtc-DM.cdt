#!RuleTest
#test PMDA-SD0088 expect=violation domain=DM
#note "Row 1: randomized (ARMCD=ARM1) with RFENDTC empty, and TS is present but carries no ONGOSIND/Y row so $ongoing_study_count=0 -> fires. Row 2: excluded arm code SCRNFAIL -> clean. Row 3: ARMCD empty -> clean. Row 4: RFENDTC populated -> clean. TS block is mandatory: TS-entirely-absent is the batch carve-out (Fix #222 diverges harness-vs-production via PMDA-SD1115)."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 ARMCD=ARM1 RFENDTC=
dataset DM class="SPECIAL PURPOSE"
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col ARMCD   type=Char
col RFENDTC type=Char
---
S1 | DM | 001 | ARM1     |
S1 | DM | 002 | SCRNFAIL |
S1 | DM | 003 |          |
S1 | DM | 004 | ARM1     | 2020-06-30
---

dataset TS class="TRIAL DESIGN"
col STUDYID  type=Char
col DOMAIN   type=Char
col TSSEQ    type=Num
col TSPARMCD type=Char
col TSVAL    type=Char
---
S1 | TS | 1 | TITLE | Example Study
