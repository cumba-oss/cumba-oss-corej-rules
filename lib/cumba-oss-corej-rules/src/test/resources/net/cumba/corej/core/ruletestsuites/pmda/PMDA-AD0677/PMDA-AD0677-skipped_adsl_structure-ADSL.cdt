#!RuleTest
#test PMDA-AD0677 expect=skipped domain=ADSL
#note "The name ADSL detects SUBJECT LEVEL ANALYSIS DATASET, which is NOT the single Include token, so the scenario pre-gate refuses execution. Pins the Data_Structures block [DEVICE LEVEL ANALYSIS DATASET] ONCE for the four device rules (AD0677, AD0678, AD0681, AD0682)."
#library standard=adamig version=1-3
dataset ADSL
col STUDYID   type=Char
col USUBJID   type=Char
col DEVTYG1   type=Char
col DEVTYG1N  type=Num
---
S1 | 001 | PUMP  | 1
S1 | 002 | VALVE | 1
---
