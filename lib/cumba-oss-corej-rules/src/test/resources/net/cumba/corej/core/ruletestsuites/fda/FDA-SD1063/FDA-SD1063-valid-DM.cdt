#!RuleTest
#test FDA-SD1063 expect=noViolation domain=DM
#note "DM is declared as an ItemGroupDef in the Define-XML sidecar, so the dataset is described in the define and the rule must not fire."
#library standard=sdtmig version=3-4
#define-xml FDA-SD1063-define.xml
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | DM | 01-701-1015
CDISCPILOT01 | DM | 01-701-1023
