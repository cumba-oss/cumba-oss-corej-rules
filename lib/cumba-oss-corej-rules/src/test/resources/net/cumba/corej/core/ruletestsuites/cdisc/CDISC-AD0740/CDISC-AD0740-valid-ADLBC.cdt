#!RuleTest
#test CDISC-AD0740 expect=noViolation domain=ADLBC
# Rule:Description: Within a dataset, there is more than one value of PARAM for a given value of PARAMN, considering only those rows on which both variables are populated
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAM type=Char
col PARAMN type=Char
