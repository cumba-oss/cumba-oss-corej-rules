#!RuleTest
#test PMDA-SD1269 expect=violation domain=TS
#note "D-TA-7c converged shape (twin of FDA-SD1269 / CDISC-CG0280): row 1 is above the (0,1] range, row 2 is an allocation ratio rather than a number (numeric-format guard), and row 3 is exactly 0 — outside (0,1], the boundary the convergence moved -> three findings. Row 4 is a different parameter."
#library standard=sdtmig version=3-4
#expectViolationCount 3
#expectViolationAt row=1 TSPARMCD=RANDQT TSVAL=1.5
#expectViolationAt row=2 TSPARMCD=RANDQT TSVAL="2:1"
#expectViolationAt row=3 TSPARMCD=RANDQT TSVAL=0
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S1 | TS | 1 | RANDQT  | Randomization Quotient     | 1.5
S1 | TS | 2 | RANDQT  | Randomization Quotient     | 2:1
S1 | TS | 3 | RANDQT  | Randomization Quotient     | 0
S1 | TS | 4 | PLANSUB | Planned Number of Subjects | 306
