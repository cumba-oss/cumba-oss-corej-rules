#!RuleTest
#test CDISC-CG0233 expect=violation domain=AE
#runLevel Info
#note "Two-level partial-date fixture (plan C phase 5b, ruling (a) 2026-08-26). AESTTPT=2012-06-15 is a complete date in every row and AESTRTPT is out of vocabulary in rows 1-3. Row 1: AEDTC=2012-07 (month partial) is CERTAINLY after AESTTPT, so the verbatim ERROR leg fires. Row 2: AEDTC=2012-06 only POSSIBLY places AESTTPT before it (2012-06-15 < latest completion 2012-06-30 but not < earliest 2012-06-01), so the tagged INFO leg claims it. Row 3: AEDTC=2012-05 is certainly before AESTTPT - silent on both legs. Row 4 has an allowed AESTRTPT - silent. Runs at #runLevel Info because the engine default (Warning) never evaluates an INFO level."
#expectViolationCount 2
#expectViolationAt row=1 severity=ERROR AESEQ=1
#expectViolationAt row=2 severity=INFO AESEQ=2
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
col AEDTC type=Char label="Date/Time of Collection"
col AESTTPT type=Char label="Start Reference Time Point"
col AESTRTPT type=Char label="Start Relative to Reference Time Point"
---
CDISCPILOT01 | AE | 01-701-0001 | 1 | 2012-07 | 2012-06-15 | INVALID_VALUE
CDISCPILOT01 | AE | 01-701-0001 | 2 | 2012-06 | 2012-06-15 | INVALID_VALUE
CDISCPILOT01 | AE | 01-701-0001 | 3 | 2012-05 | 2012-06-15 | INVALID_VALUE
CDISCPILOT01 | AE | 01-701-0001 | 4 | 2012-07 | 2012-06-15 | BEFORE
---
