#!RuleTest
#test CDISC-AD0741 expect=noViolation domain=ADLBC
# Rule:Description: Within a dataset, there is more than one value of PARAMN for a given value of PARAM, considering only those rows on which both variables are populated
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMN type=Char
col PARAM type=Char
---
CDISCPILOT01 | 01-701-1015 | 1 | Glucose (mmol/L)
CDISCPILOT01 | 01-701-1015 | 2 | Sodium (mmol/L)
CDISCPILOT01 | 01-701-1015 | 1 | Glucose (mmol/L)
---
