#!RuleTest
#test PMDA-SD9711 expect=noViolation domain=DM
# Rule:Description: PMDA-SD9711 — the Required key USUBJID is not populated.
#note "USUBJID populated -> noViolation; the twin scenario differs only in the value of USUBJID."
#library standard=sdtmig version=3-4
dataset DM
col STUDYID type=Char
col DOMAIN type=Char
col USUBJID type=Char
col SUBJID type=Char
col SITEID type=Char
---
S1      | DM     | S1-001  | 001    | 01
---
