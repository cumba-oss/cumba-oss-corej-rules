#!RuleTest
#test PMDA-AD0234 expect=noViolation domain=ADSL
#note "TRT01A is both the grouping key and the not empty(...) subject, so row 3 (blank TRT01A) is excluded twice: DROP_MISSING_KEYS removes it from grouping and its own conjunct is false; the surviving DRUGA group holds one distinct TR01AG1."
#library standard=adamig version=1-3
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRT01A  type=Char
col TR01AG1 type=Char
---
S1 | 001 | DRUGA | POOLX
S1 | 002 | DRUGA | POOLX
S1 | 003 |       | POOLY
