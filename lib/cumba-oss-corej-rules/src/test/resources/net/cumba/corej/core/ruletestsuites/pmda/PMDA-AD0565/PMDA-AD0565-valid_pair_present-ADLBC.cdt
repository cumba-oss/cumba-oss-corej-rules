#!RuleTest
#test PMDA-AD0565 expect=noViolation domain=ADLBC
#note "Both BCHGCA1N and BCHGCAT1 declared -> not var_exists(BCHGCAT1) is FALSE. The two regexes are disjoint (BCHGCAT1 has 'T' where ^BCHGCA(\d+)N$ wants a digit), so this is still ONE expansion."
#library standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVAL     type=Num
col BCHGCA1N type=Num
col BCHGCAT1 type=Char
---
CDISCPILOT01 | 01-701-1015 | ALB | 3.5 | 1 | INCREASE
