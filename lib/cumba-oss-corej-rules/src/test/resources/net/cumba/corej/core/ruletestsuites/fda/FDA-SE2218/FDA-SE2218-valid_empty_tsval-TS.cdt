#!RuleTest
#test FDA-SE2218 expect=noViolation domain=TS
#note "The TSPARMCD=STSTDTC record is present but its TSVAL is empty. The FDA message is 'Missing STSTDTC Trial Summary Parameter', so this rule counts parameter RECORDS, not populated values (TSVAL-level checks are separate rules) -> no violation."
#library standard=sendig version=3-1-1
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | DOSSTDTC | Start Date/Time of Dose Interval | 2023-06-01
S01 | TS | 2 | STSTDTC | Study Start Date | 
