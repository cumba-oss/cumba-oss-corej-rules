#!RuleTest
#test PMDA-SD1284 expect=noViolation domain=PR
#note "ADAPTED-FROM fda/FDA-SD1284/FDA-SD1284-valid-PR.cdt. PRPORTOT present together with PRLOC -> conformant."
#library standard=sdtmig version=3-4
dataset PR class=INTERVENTIONS label="Procedures"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PRSEQ    type=Num  label="Sequence Number"
col PRTRT    type=Char label="Reported Name of Procedure"
col PRLOC    type=Char label="Location of the Procedure"
col PRPORTOT type=Char label="Portion or Totality"
---
CDISCPILOT01 | PR | 01-701-1015 | 1 | BIOPSY | LUNG | ENTIRE
