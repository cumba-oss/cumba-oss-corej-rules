#!RuleTest
#test PMDA-AD0314 expect=violation domain=ADAE
#note "Pins all six alternatives of the prefix group at once and the per-column granularity at 6. All six names are 8 characters or fewer, so none is separately illegal under PMDA-AD0013."
#library standard=adamig version=1-0
#expectViolationCount 6
#expectViolationAt variable_name=DECDORG0
#expectViolationAt variable_name=BDSYORG0
#expectViolationAt variable_name=HLGTORG0
#expectViolationAt variable_name=HLTORG0
#expectViolationAt variable_name=LLTORG0
#expectViolationAt variable_name=LLTNORG0
dataset ADAE structure=OCCDS subclass=AE
col STUDYID  type=Char
col USUBJID  type=Char
col AEDECOD  type=Char
col DECDORG0 type=Char
col BDSYORG0 type=Char
col HLGTORG0 type=Char
col HLTORG0  type=Char
col LLTORG0  type=Char
col LLTNORG0 type=Char
---
CDISCPILOT01 | 01-701-1015 | HEADACHE | A | B | C | D | E | F
