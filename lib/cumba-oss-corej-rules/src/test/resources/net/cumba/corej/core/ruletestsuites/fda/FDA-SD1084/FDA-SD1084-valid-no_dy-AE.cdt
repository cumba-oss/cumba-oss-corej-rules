#!RuleTest
#test FDA-SD1084 expect=skipped domain=AE
#note "AEDY column is absent from the dataset: the Requirements.Variables gate on --DY skips the rule, so complete AEDTC/RFSTDTC do not fire (house convention: empty-check on a Permissible variable is gated on column presence)."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEDTC   type=Char label="Date/Time of Collection"
---
S1 | AE | 001 | 1 | HEADACHE | 2023-06-15
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
---
S1 | DM | 001 | 2023-06-01
---
