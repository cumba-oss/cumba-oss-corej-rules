#!RuleTest
#test PMDA-AD0659 expect=violation domain=ADNCA
#note "The NUMERIC-ZERO boundary of 'must be 1 or null' (operator-examples E.2: 0 is a value, not empty, so not empty(PKSUMXFN) is TRUE and PKSUMXFN != 1 is TRUE). Zero is also the realistic mis-coding. If row 1 does not fire, escalate - the finding would be that a numeric zero reads as empty, not that the fixture needs a different value."
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015 PKSUMXFN=0
#library standard=adamig version=1-3
dataset ADNCA structure=BDS subclass=NCA
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col PKSUMXFN type=Num
---
CDISCPILOT01 | 01-701-1015 | CONC | 0
CDISCPILOT01 | 01-701-1023 | CONC | 1
---
