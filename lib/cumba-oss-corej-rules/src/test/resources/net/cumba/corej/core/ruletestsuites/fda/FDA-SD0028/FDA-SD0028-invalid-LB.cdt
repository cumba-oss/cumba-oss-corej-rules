#!RuleTest
#test FDA-SD0028 expect=violation domain=LB
#note "Row 2 declares an upper reference limit (LBSTNRHI=1) below the lower limit (LBSTNRLO=5) -> fires. Row 1 is ordered correctly, row 3 has no upper limit."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 LBSTNRLO=5 LBSTNRHI=1
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBSTNRLO type=Num  label="Reference Range Lower Limit-Std Units"
col LBSTNRHI type=Num  label="Reference Range Upper Limit-Std Units"
---
S1 | LB | 001 | 1 | ALB  | 35 | 50
S1 | LB | 001 | 2 | GLUC | 5  | 1
S1 | LB | 001 | 3 | HGB  | 12 |
