#!RuleTest
#test FDA-SD0060 expect=violation domain=DM
#note "Regression pin for the W1 Sensitivity fix: Record sensitivity reports each variable missing from the define, so AGE and AGEU both produce findings (count 2)."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt variable_name=AGE
#expectViolationAt variable_name=AGEU
#define variable-metadata DM STUDYID name=STUDYID label="Study Identifier"
#define variable-metadata DM USUBJID name=USUBJID label="Unique Subject Identifier"
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col AGE     type=Num  label="Age"
col AGEU    type=Char label="Age Units"
---
CDISCPILOT01 | 01-701-1015 | 56 | YEARS
