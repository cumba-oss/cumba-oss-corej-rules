#!RuleTest
#test FDA-SE2231 expect=violation domain=TX
#note "The set description 'Control Group' is coded both CTRL and CTL2, so SETCD is not the same for a given SET. Every record of the offending set description is reported."
#library standard=sendig version=3-1-1
#expectViolationCount 2
#expectViolationAt row=1 SET="Control Group" SETCD=CTRL
#expectViolationAt row=2 SET="Control Group" SETCD=CTL2
dataset TX class="TRIAL DESIGN" label="Trial Sets"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col SETCD    type=Char label="Set Code"
col SET      type=Char label="Set Description"
col TXSEQ    type=Num  label="Sequence Number"
col TXPARMCD type=Char label="Trial Set Parameter Short Name"
col TXPARM   type=Char label="Trial Set Parameter"
col TXVAL    type=Char label="Trial Set Parameter Value"
---
S1 | TX | CTRL | Control Group | 1 | TRTDOS | Treatment Dose | 0
S1 | TX | CTL2 | Control Group | 1 | TRTDOS | Treatment Dose | 0
S1 | TX | HD   | High Dose     | 1 | TRTDOS | Treatment Dose | 100
