#!RuleTest
#test CDISC-CG0152 expect=skipped domain=SE
#note "DELIBERATELY NO ELEMENT COLUMN. Requirements.Variables.All: [ELEMENT] is unsatisfied, so the rule does not execute -> skipped. The row is the firing shape (ETCD=UNPLAN) so the fixture proves the gate, not the data."
#library standard=sdtmig version=3-4
dataset SE label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ   type=Num  label="Sequence Number"
col ETCD    type=Char label="Element Code"
col SESTDTC type=Char label="Start Date/Time of Element"
---
S1 | SE | 001 | 1 | UNPLAN | 2020-01-10
