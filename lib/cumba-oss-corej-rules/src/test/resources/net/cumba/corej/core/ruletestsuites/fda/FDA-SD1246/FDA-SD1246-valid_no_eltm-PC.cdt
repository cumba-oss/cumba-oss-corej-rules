#!RuleTest
#test FDA-SD1246 expect=noViolation domain=PC
#note "Boundary: neither PCELTM nor PCTPTREF present -> the guard leaf (--ELTM exists) is false -> no violation."
#library standard=sdtmig version=3-4
dataset PC class=FINDINGS label="Pharmacokinetic Concentrations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PCSEQ    type=Num  label="Sequence Number"
col PCTESTCD type=Char label="Pharmacokinetic Test Short Name"
col PCORRES  type=Char label="Result or Finding in Original Units"
---
CDISCPILOT01 | PC | 01-701-1015 | 1 | DRUGA | 12.5
---
