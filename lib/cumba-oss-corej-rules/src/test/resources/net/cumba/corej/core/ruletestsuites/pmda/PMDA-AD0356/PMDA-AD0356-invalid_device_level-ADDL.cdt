#!RuleTest
#test PMDA-AD0356 expect=violation domain=ADDL
#note "No structure key: name starts with AD, no BDS indicator, no TERM/TRT/DECOD column -> ADAM OTHER, refined to DEVICE LEVEL ANALYSIS DATASET by SPDEVID. That token has no supertype, so scope holds only because the Include list names it - pins the [SLAD, DLAD] positive DEVICE-LEVEL branch. ASIA -> {1,1,2}, minority row 3 fires."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 REGION1=ASIA REGION1N=2
dataset ADDL
col STUDYID  type=Char
col USUBJID  type=Char
col SPDEVID  type=Char
col REGION1  type=Char
col REGION1N type=Num
---
CDISCPILOT01 | 01-701-1015 | DEV-01 | ASIA | 1
CDISCPILOT01 | 01-701-1023 | DEV-02 | ASIA | 1
CDISCPILOT01 | 01-701-1034 | DEV-03 | ASIA | 2
