#!RuleTest
#test CDISC-SEND-0106.1 expect=noViolation domain=DM
#note "Adapted from -invalid_no_strain_anywhere-DM; the ONLY change is DM row 1's STRAIN cell. No DM row has an empty STRAIN, so the leading empty(STRAIN) leaf is false everywhere and the rule is silent. (Plan B phase 4d' reduced that leading term from a two-way disjunction to the bare leaf; the verdict is unchanged.)"
#library standard=sendig version=3-1-1
#expectViolationCount 0
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SPECIES type=Char label="Species"
col STRAIN  type=Char label="Strain/Substrain"
---
S1 | DM | 001 | RAT | SPRAGUE-DAWLEY
S1 | DM | 002 | RAT | WISTAR
---

dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL    type=Char label="Parameter Value"
---
S1 | TS | 1 | SPECIES  | RAT
S1 | TS | 2 | SNDIGVER | SENDIG 3.1.1
---

dataset TX class="TRIAL DESIGN" label="Trial Sets"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col SETCD    type=Char label="Set Code"
col TXSEQ    type=Num  label="Sequence Number"
col TXPARMCD type=Char label="Trial Set Parameter Short Name"
col TXVAL    type=Char label="Parameter Value"
---
S1 | TX | G1 | 1 | TRTDOS  | 100
S1 | TX | G1 | 2 | SPGRPCD | A
---
