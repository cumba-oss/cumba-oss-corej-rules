#!RuleTest
#test FDA-SD1279 expect=violation domain=EC
#note "ECOCCUR and ECSTAT columns not present (Perm/model-level): ECOCCUR is carried by its SURVIVING authored `not var_exists(ECOCCUR) or` arm and ECSTAT by the bare empty(ECSTAT) leaf, TRUE on an absent column (absent = all-missing, EC-43; Plan B phase 4d' deleted only ECSTAT's presence half); ECDOSE missing + ECDOSTXT present-but-empty -> fires on row 1 only"
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 ECSEQ=1
dataset EC class=INTERVENTIONS label="Exposure as Collected"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ECSEQ    type=Num  label="Sequence Number"
col ECTRT    type=Char label="Name of Treatment"
col ECDOSE   type=Num  label="Dose"
col ECDOSTXT type=Char label="Dose Description"
---
S1 | EC | 001 | 1 | DRUG A | . |
S1 | EC | 001 | 2 | DRUG A | 5 |
