#!RuleTest
#test PMDA-SD1206 expect=noViolation domain=EX
#note "Row 1: EXSTDTC equal to RFXENDTC -> boundary, strict greater-than does not fire. Row 2: EXSTDTC before RFXENDTC -> ok. Row 3: EXSTDTC empty -> ok. Row 4: subject 002 with empty RFXENDTC -> null hull saturates false, no fire. FRESH row 5: subject 003 has NO DM row at all -> the default inner join drops it before evaluation (a subject missing from DM is the DM-membership rules' finding, not this rule's)."
#library standard=sdtmig version=3-4
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
---
S1 | EX | 001 | 1 | DRUG A | 2020-03-31
S1 | EX | 001 | 2 | DRUG A | 2020-02-15
S1 | EX | 001 | 3 | DRUG A |
S1 | EX | 002 | 1 | DRUG A | 2020-06-01
S1 | EX | 003 | 1 | DRUG A | 2099-01-01
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFXENDTC type=Char label="Date/Time of Last Study Treatment"
---
S1 | DM | 001 | 2020-03-31
S1 | DM | 002 |
---
