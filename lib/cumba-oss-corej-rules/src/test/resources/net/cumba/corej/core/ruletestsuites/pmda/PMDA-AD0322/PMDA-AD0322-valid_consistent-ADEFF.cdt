#!RuleTest
#test PMDA-AD0322 expect=noViolation domain=ADEFF
#note "Row 3 carries TRTPG1=POOL1, so each TRTP maps to one pooled-treatment value."
#library standard=adamig version=1-3
dataset ADEFF
col STUDYID type=Char
col USUBJID type=Char
col TRTP    type=Char
col TRTPG1  type=Char
---
S1 | 001 | DrugA | POOL1
S1 | 002 | DrugA | POOL1
S1 | 003 | DrugA | POOL1
S1 | 004 | DrugB | POOLX
S1 | 005 | DrugB | POOLX
