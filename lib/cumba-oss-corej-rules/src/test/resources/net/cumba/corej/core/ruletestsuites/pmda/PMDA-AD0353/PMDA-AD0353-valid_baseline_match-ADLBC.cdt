#!RuleTest
#test PMDA-AD0353 expect=noViolation domain=ADLBC
#note "Negative control on the same header and columns as the invalid fixture. Rows 1 and 2 are baseline records (ABLFL=Y) whose two indicators agree, so the equality itself is silent; row 3 does mismatch but is not the baseline record, which isolates the ABLFL=='Y' conjunct. The rule DOES execute here - the single A1IND/B1IND pair seeds one expansion."
#library standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ABLFL   type=Char
col A1IND   type=Char
col B1IND   type=Char
---
CDISCPILOT01 | 01-701-1015 | ALT | Y | NORMAL | NORMAL
CDISCPILOT01 | 01-701-1023 | ALT | Y | HIGH | HIGH
CDISCPILOT01 | 01-701-1034 | ALT | N | NORMAL | HIGH
