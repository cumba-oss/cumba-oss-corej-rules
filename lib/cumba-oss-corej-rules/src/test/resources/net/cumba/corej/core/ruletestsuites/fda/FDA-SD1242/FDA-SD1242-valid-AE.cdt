#!RuleTest
#test FDA-SD1242 expect=noViolation domain=AE
#note "Each AEBDSYCD maps to exactly one AEBODSYS and vice versa (repeated pairs fine); one row with both empty is a non-participant -> no violation."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col AESEQ    type=Num  label="Sequence Number"
col AETERM   type=Char label="Reported Term for the Adverse Event"
col AEBODSYS type=Char label="Body System or Organ Class"
col AEBDSYCD type=Num  label="Body System or Organ Class Code"
---
S1 | AE | 001 | 1 | Headache    | Nervous system disorders   | 10029205
S1 | AE | 001 | 2 | Nausea      | Gastrointestinal disorders | 10017947
S1 | AE | 002 | 1 | Migraine    | Nervous system disorders   | 10029205
S1 | AE | 002 | 2 | Palpitation |                            |
