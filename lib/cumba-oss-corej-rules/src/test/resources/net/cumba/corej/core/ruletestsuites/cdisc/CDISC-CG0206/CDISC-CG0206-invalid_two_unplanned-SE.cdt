#!RuleTest
#test CDISC-CG0206 expect=violation domain=SE
#note "Record-granularity contrast: two unplanned elements (rows 2 and 3) both carry a populated TAETORD -> both fire. Purpose: pin that this rule's violation count SCALES WITH ROWS, unlike the batch's eleven dataset-level presence rules which emit exactly one finding per dataset."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=2 ETCD=UNPLAN TAETORD=2
#expectViolationAt row=3 ETCD=UNPLAN TAETORD=3
dataset SE label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ   type=Num  label="Sequence Number"
col ETCD    type=Char label="Element Code"
col TAETORD type=Num  label="Planned Order of Element within Arm"
col SESTDTC type=Char label="Start Date/Time of Element"
---
S1 | SE | 001 | 1 | SCRN   | 1 | 2020-01-01
S1 | SE | 001 | 2 | UNPLAN | 2 | 2020-01-10
S1 | SE | 001 | 3 | UNPLAN | 3 | 2020-01-20
S1 | SE | 001 | 4 | UNPLAN | . | 2020-01-25
