#!RuleTest
#test CDISC-CG0377 expect=noViolation domain=AE
#note "Row 1's AELLT 'Headache' is a MedDRA Lowest Level Term of the (dummy) dictionary; row 2's upper-case 'HEADACHE' passes too under the explicit case_sensitive: false (CL-G.4, the pre-TA-3 insensitive behaviour restored)."
#library standard=sdtmig version=3-4
#dictionaries dummy
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AELLT   type=Char label="Lowest Level Term"
---
S1 | AE | 001 | 1 | headache | Headache
S1 | AE | 001 | 2 | headache | HEADACHE
