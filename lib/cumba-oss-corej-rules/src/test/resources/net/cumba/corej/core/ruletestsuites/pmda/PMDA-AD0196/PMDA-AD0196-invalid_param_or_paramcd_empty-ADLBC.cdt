#!RuleTest
#test PMDA-AD0196 expect=violation domain=ADLBC
#note "Positive control at Record granularity, one violation per arm of the disjunction: row 1 has PARAM blank, row 3 has PARAMCD blank, row 2 has both populated and stays silent. PARAM values are single-token stand-ins so they remain pinnable - #expectViolationAt is space-delimited and a pinned value may never contain a space."
#library standard=adamig version=1-3
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015 PARAMCD=ALT
#expectViolationAt row=3 USUBJID=01-701-1034 PARAM=Alanine
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col PARAM   type=Char
col AVAL    type=Num
---
CDISCPILOT01 | 01-701-1015 | ALT |         | 2.5
CDISCPILOT01 | 01-701-1023 | ALT | Alanine | 7.0
CDISCPILOT01 | 01-701-1034 |     | Alanine | 9.9
