#!RuleTest
#test PMDA-SD1235 expect=violation domain=DU
#note "SPDEVID column absent altogether and USUBJID empty -> the bare empty() leaf on the absent column is TRUE on every row (absent = all-missing, EC-43) and the rule fires (Plan B phase 4d' deleted the redundant not var_exists disjunct this note used to name). The USUBJID half is present, so BroadcastFold stays UNKNOWN and the row loop decides -- one finding on row 1."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 DUSEQ=1
dataset DU label="Device In-Use"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DUSEQ   type=Num  label="Sequence Number"
col DUTESTCD type=Char label="Device In-Use Short Name"
---
S1 | DU |  | 1 | SETTING
