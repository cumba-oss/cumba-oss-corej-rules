#!RuleTest
#test FDA-SE2280 expect=noViolation domain=PC
#note "Row 1 pre-dose sample anchored at PT0H -> ok; row 2 post-dose -> ok; row 3 PCDTC lacks a time component -> excluded; row 4 PCRFTDTC empty -> excluded."
#library standard=sendig version=3-1-1
dataset PC class=FINDINGS label="Pharmacokinetics Concentrations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PCSEQ    type=Num  label="Sequence Number"
col PCDTC    type=Char label="Date/Time of Specimen Collection"
col PCELTM   type=Char label="Planned Elapsed Time from Time Point Ref"
col PCRFTDTC type=Char label="Date/Time of Reference Point"
---
S1 | PC | 001 | 1 | 2023-05-01T07:30 | PT0H | 2023-05-01T08:00
S1 | PC | 001 | 2 | 2023-05-01T09:00 | PT1H | 2023-05-01T08:00
S1 | PC | 001 | 3 | 2023-05-01       | PT2H | 2023-05-01T08:00
S1 | PC | 001 | 4 | 2023-05-01T07:30 | PT1H |
