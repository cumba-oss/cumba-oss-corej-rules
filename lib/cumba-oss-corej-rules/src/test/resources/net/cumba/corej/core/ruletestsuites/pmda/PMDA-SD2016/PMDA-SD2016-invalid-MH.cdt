#!RuleTest
#test PMDA-SD2016 expect=violation domain=MH
#note "FRESH: second in-scope domain pin (sheet DOMAINS 'AE, CE, MH'; '--' resolves MHSOCCD). MHSOCCD 7654321 is not a System Organ Class code of the (dummy) MedDRA dictionary -> fires on row 2; row 1 is a valid SOC code."
#library standard=sdtmig version=3-4
#dictionaries dummy
#expectViolationCount 1
#expectViolationAt row=2 MHSOCCD=7654321
dataset MH
col USUBJID type=Char
col MHSOCCD type=Num
---
001 | 10029205
001 | 7654321
