#!RuleTest
#test PMDA-AD0616 expect=noViolation domain=ADSL
#note "TRCMPG1N is not declared. Seeded by TRCMPG1; Requirements.Variables.All expands to TRCMPG1 (present) so the rule runs, and var_exists(TRCMPG1N) keeps it silent instead of letting the absent key drop and regroup."
#library standard=adamig version=1-3
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRCMPG1 type=Char
---
S1 | 001 | HIGH
S1 | 002 | LOW
---
