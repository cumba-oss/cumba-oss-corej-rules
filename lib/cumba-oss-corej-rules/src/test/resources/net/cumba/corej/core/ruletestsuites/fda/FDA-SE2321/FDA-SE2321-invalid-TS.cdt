#!RuleTest
#test FDA-SE2321 expect=violation domain=TS
#note "No TSPARMCD=SLENGTH record anywhere in TS -> the 'Nonclinical Study Length' parameter is missing, one dataset-level finding. SDESIGN / SPLANSUB / STITLE are present but none of them is SLENGTH."
#library standard=sendig version=3-1-1
#expectViolationCount 1
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | STITLE   | Nonclinical Study Title                    | 13-Week Repeat Dose Toxicity Study
S01 | TS | 2 | SDESIGN  | Nonclinical Study Design                   | PARALLEL
S01 | TS | 3 | SPLANSUB | Planned Number of Nonclinical Subjects     | 40
