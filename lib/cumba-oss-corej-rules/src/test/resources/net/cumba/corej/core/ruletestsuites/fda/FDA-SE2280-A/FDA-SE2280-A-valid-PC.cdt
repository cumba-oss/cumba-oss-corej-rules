#!RuleTest
#test FDA-SE2280-A expect=noViolation domain=PC
#note "PCELTM rows carry full datetimes (T-component) in PCDTC/PCRFTDTC; date-only rows have PCELTM empty -> no violation."
#library standard=sendig version=3-1-1
dataset PC class=FINDINGS label="Pharmacokinetics Concentrations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PCSEQ    type=Num  label="Sequence Number"
col PCELTM   type=Char label="Planned Elapsed Time from Time Point Ref"
col PCDTC    type=Char label="Date/Time of Specimen Collection"
col PCRFTDTC type=Char label="Date/Time of Reference Point"
---
S1 | PC | 001 | 1 | PT1H | 2023-06-01T09:00 | 2023-06-01T08:00
S1 | PC | 001 | 2 |      | 2023-06-01       | 2023-06-01
S1 | PC | 001 | 3 | PT2H |                  | 2023-06-01T08:00
