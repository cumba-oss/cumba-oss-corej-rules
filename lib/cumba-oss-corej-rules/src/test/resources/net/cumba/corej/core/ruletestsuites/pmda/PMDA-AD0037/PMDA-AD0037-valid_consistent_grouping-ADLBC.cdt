#!RuleTest
#test PMDA-AD0037 expect=noViolation domain=ADLBC
#note "Every key single-valued in both directions -> the rule EXECUTES and stays silent. Same table used for all four rules of the AD0037/AD0037B/AD0038/AD0038B quartet."
#library standard=adamig version=1-0
dataset ADLBC
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AGEGR1   type=Char
col AGEGR1N  type=Num
---
