#!RuleTest
#test PMDA-AD1026 expect=noViolation domain=ADSL
#note "EX is present alongside ADSL -> the second conjunct is false -> no violation."
#library standard=adamig version=1-3
dataset ADSL class=ADSL label="Subject Level Analysis Dataset"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col SAFFL   type=Char label="Safety Population Flag"
---
CDISCPILOT01 | 01-701-1015 | 701-1015 | Y
---

dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
---
CDISCPILOT01 | EX | 01-701-1015 | 1 | Drug A
---
