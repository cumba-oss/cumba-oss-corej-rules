#!RuleTest
#test FDA-SE1074 expect=violation domain=DM
#note "The SEND DM carries two SDTM-human-only variables (COUNTRY, DTHFL); neither exists in any SENDIG 3.1.1 dataset, so both are reported. This is a variable-metadata rule, so the locations are pinned by variable_name, not by row."
#library standard=sendig version=3-1-1
#expectViolationCount 2
#expectViolationAt variable_name=COUNTRY
#expectViolationAt variable_name=DTHFL
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SUBJID   type=Char label="Subject Identifier for the Study"
col SEX      type=Char label="Sex"
col SPECIES  type=Char label="Species"
col COUNTRY  type=Char label="Country"
col DTHFL    type=Char label="Subject Death Flag"
col SETCD    type=Char label="Set Code"
---
STUDY01 | DM | STUDY01-001 | 001 | M | RAT | USA | Y | 1
