#!RuleTest
#test FDA-SD1278 expect=noViolation domain=TS
#note "TSVAL<->TSVALCD is 1:1 for all populated pairs (duplicate identical pair fine); the row with TSVALCD empty is guarded by the non_empty leaves and is a non-participant -> no violation."
#library standard=sdtmig version=3-4
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
col TSVALCD  type=Char label="Parameter Value Code"
---
S1 | TS | 1 | SEXPOP  | Sex of Participants  | BOTH           | C49636
S1 | TS | 1 | INTTYPE | Intervention Type    | DRUG           | C1909
S1 | TS | 2 | SEXPOP  | Sex of Participants  | BOTH           | C49636
S1 | TS | 1 | TITLE   | Trial Title          | Example Study  |
