#!RuleTest
#test CDISC-AD0584 expect=noViolation domain=ADLBC
# Rule:Description: Within a parameter, there is more than one value of BCHGCATy for a given value of BCHGCAyN, considering only those rows on which both variables are populated
#note "each BCHGCA1N value maps to a single BCHGCAT1 value -> noViolation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col BCHGCAT1 type=Char
col BCHGCA1N type=Char
---
CDISCPILOT01 | 01-701-1015 | ALB | A1 | K1
CDISCPILOT01 | 01-701-1023 | ALB | A2 | K2
CDISCPILOT01 | 01-701-1028 | ALB | A1 | K1
---
