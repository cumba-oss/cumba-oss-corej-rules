#!RuleTest
#test CDISC-CG0278 expect=noViolation domain=TS
# Rule:Description: Raise an error when a record exists with TSPARMCD equal to 'STYPE' and TSVAL equal to 'INTERVENTIONAL', but TSVAL is empty for the record where TSPARMCD equals 'INTTYPE'.
#note "STYPE=INTERVENTIONAL and the INTTYPE record is present with a populated TSVAL -> no violation."
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | STYPE | INTERVENTIONAL
S01 | TS | 2 | INTTYPE | SOME VALUE
---
