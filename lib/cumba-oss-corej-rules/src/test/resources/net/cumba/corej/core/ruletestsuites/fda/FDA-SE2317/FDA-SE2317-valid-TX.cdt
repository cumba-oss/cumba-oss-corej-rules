#!RuleTest
#test FDA-SE2317 expect=noViolation domain=TX
#note "SPECIES appears once per trial set (SET01 and SET02) -> unique within each SETCD, clean. Rows 5/6: two records with empty TXPARMCD in the same set would share a key tuple, but the 'TXPARMCD non_empty' leaf keeps them from firing (an empty Req TXPARMCD is another rule's finding)."
#library standard=sendig version=3-1-1
dataset TX
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col SETCD    type=Char label="Set Code"
col SET      type=Char label="Set Description"
col TXSEQ    type=Num  label="Sequence Number"
col TXPARMCD type=Char label="Trial Set Parameter Short Name"
col TXPARM   type=Char label="Trial Set Parameter"
col TXVAL    type=Char label="Trial Set Parameter Value"
---
S1 | TX | SET01 | Control   | 1 | SPECIES | Species | RAT
S1 | TX | SET01 | Control   | 2 | STRAIN  | Strain  | WISTAR
S1 | TX | SET02 | High Dose | 3 | SPECIES | Species | RAT
S1 | TX | SET02 | High Dose | 4 | STRAIN  | Strain  | WISTAR
S1 | TX | SET02 | High Dose | 5 |         | Unknown | A
S1 | TX | SET02 | High Dose | 6 |         | Unknown | B
