#!RuleTest
#test CDISC-CG0303 expect=violation domain=DM
#note "AGE carries the sponsor label 'Age in Years' instead of the SDTMIG label 'Age' -> fires on AGE. AGEU/SEX match, and STUDYID/USUBJID have no Library entry so the library variable-name equality guard excludes them. Authored at wave TA-4 alongside the CL-B Output_Variables trim (the redundant library_variable_name entry - always equal to variable_name for this rule shape - was dropped per the minimal-OV direction)."
#library standard=sdtmig version=3-2
#library variable-metadata DM AGE  name=AGE  label="Age"
#library variable-metadata DM AGEU name=AGEU label="Age Units"
#library variable-metadata DM SEX  name=SEX  label="Sex"
#expectViolationCount 1
#expectViolationAt variable_name=AGE
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col AGE     type=Num  label="Age in Years"
col AGEU    type=Char label="Age Units"
col SEX     type=Char label="Sex"
---
S1 | 001 | 56 | YEARS | M
