#expectViolationAt row=3 PARAMCD=SYSBP CRIT1=SYSBPGT140
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col PARAM type=Char
col CRIT1 type=Char
