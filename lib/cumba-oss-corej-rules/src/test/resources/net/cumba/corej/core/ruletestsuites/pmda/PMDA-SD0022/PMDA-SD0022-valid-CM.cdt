#!RuleTest
#test PMDA-SD0022 expect=noViolation domain=CM
#note "Each record either has one Start Time-Point variable populated (CMSTDTC, CMSTRF or CMSTRTPT) or is excepted via CMOCCUR='N' or a populated CMSTAT -> no violation."
#library standard=sdtmig version=3-4
dataset CM class=INTERVENTIONS label="Concomitant Medications"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col CMSEQ    type=Num  label="Sequence Number"
col CMTRT    type=Char label="Reported Name of Drug, Med, or Therapy"
col CMOCCUR  type=Char label="CM Occurrence"
col CMSTAT   type=Char label="Completion Status"
col CMSTDTC  type=Char label="Start Date/Time of Medication"
col CMSTRF   type=Char label="Start Relative to Reference Period"
col CMSTRTPT type=Char label="Start Relative to Reference Time Point"
---
S1 | CM | 001 | 1 | ASPIRIN     | Y |          | 2023-04-01 |        |
S1 | CM | 001 | 2 | PARACETAMOL |   |          |            | BEFORE |
S1 | CM | 001 | 3 | VITAMIN C   |   |          |            |        | BEFORE
S1 | CM | 001 | 4 | OMEPRAZOLE  | N |          |            |        |
S1 | CM | 001 | 5 | IBUPROFEN   |   | NOT DONE |            |        |
