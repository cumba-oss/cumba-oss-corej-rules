#!RuleTest
#test FDA-SD1396 expect=violation domain=FA
#note "FINDINGS ABOUT arm of the class scope. Row 1: FADTC and DM.RFCSTDTC are both complete dates but FACHDY is missing -> fires. Row 2: FACHDY populated -> clean."
#library standard=sendig version=ar-1-0
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset FA class="FINDINGS ABOUT" label="Findings About Events or Interventions"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col FASEQ    type=Num  label="Sequence Number"
col FATESTCD type=Char label="Findings About Test Short Name"
col FADTC    type=Char label="Date/Time of Collection"
col FACHDY   type=Num  label="Day of Obs Rel to Challenge Agent"
---
S1 | FA | 001 | 1 | SEV | 2020-01-10 | .
S1 | FA | 001 | 2 | SEV | 2020-01-10 | 6
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFCSTDTC type=Char label="Date/Time of First Challenge Agent Admin"
---
S1 | DM | 001 | 2020-01-05
---
