#!RuleTest
#test PMDA-AD0473 expect=skipped domain=ADSL
#note "STRAT1RN is not declared. The expansion is seeded from STRATwR (w=1) and STRATwRN is synthesised as the absent STRAT1RN; Requirements.Variables.All ['STRATwRN'] rewrites to ['STRAT1RN'], absent, so the rule is reported not executed. Together with AD0472's skip fixture this pins both seeding directions of the w expansion."
#library standard=adamig version=1-3
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col STRAT1R type=Char
---
S1 | 001 | REGIONA
S1 | 002 | REGIONB
