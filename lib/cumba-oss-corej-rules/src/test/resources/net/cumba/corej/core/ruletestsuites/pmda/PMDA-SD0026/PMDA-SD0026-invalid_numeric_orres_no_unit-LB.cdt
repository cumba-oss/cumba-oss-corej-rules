#!RuleTest
#test PMDA-SD0026 expect=violation domain=LB
#note "Row 1: numeric result, no unit -> fires. Row 2: unit populated -> clean. Row 3: regex ^-?[0-9]+(\\.[0-9]+)?$ rejects a text result -> clean. Row 4: ORRES empty -> clean."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 LBORRES=120 LBORRESU=
dataset LB class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
col LBORRES  type=Char
col LBORRESU type=Char
---
S1 | LB | 001 | 1 | GLUC  | 120      |
S1 | LB | 001 | 2 | ALB   | 5.5      | g/dL
S1 | LB | 001 | 3 | HBSAG | POSITIVE |
S1 | LB | 001 | 4 | CHOL  |          |
