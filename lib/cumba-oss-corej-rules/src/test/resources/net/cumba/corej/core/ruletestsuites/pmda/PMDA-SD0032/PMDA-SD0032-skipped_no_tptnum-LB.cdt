#!RuleTest
#test PMDA-SD0032 expect=skipped domain=LB
#note "No LBTPTNUM column at all; Requirements.Variables.All [--TPTNUM] rejects -> auditable skip, even though LBTPT is empty. Mechanism pinned once on behalf of the identical per-rule driver gates of SD0033/SD0034/SD0049/SD0050."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
col LBTPT    type=Char
---
S1 | LB | 001 | 1 | GLUC |
