#!RuleTest
#test FDA-SD1450 expect=noViolation domain=PP
#note "Boundary: PPENINT present but PPSTINT absent -> the guard leaf (--STINT exists) is false -> no violation (that direction is FDA-SD1451's job)."
#library standard=sdtmig version=3-4
dataset PP class=FINDINGS label="Pharmacokinetic Parameters"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PPSEQ    type=Num  label="Sequence Number"
col PPTESTCD type=Char label="Parameter Short Name"
col PPENINT  type=Char label="Planned End of Assessment Interval"
---
CDISCPILOT01 | PP | 01-701-1015 | 1 | AUCALL | PT24H
---
