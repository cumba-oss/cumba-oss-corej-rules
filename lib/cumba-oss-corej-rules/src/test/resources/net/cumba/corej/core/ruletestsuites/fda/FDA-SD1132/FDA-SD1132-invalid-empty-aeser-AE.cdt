#!RuleTest
#test FDA-SD1132 expect=violation domain=AE
#note "AESLIFE=Y but AESER is empty (empty is not 'Y') -> fires; only AESLIFE of the criteria columns is present, exists guards skip the absent ones."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 AESLIFE=Y
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESER   type=Char label="Serious Event"
col AESLIFE type=Char label="Is Life Threatening"
---
S1 | AE | 001 | 1 | ANAPHYLAXIS | | Y
S1 | AE | 001 | 2 | HEADACHE    | | N
