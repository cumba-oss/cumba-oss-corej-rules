#!RuleTest
#test CDISC-CG0407 expect=noViolation domain=TA
#note "EX is present alongside TA -> the second conjunct is false -> no violation."
#library standard=sdtmig version=3-4
dataset TA class="TRIAL DESIGN" label="Trial Arms"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
col TAETORD type=Num  label="Planned Order of Element within Arm"
col ETCD    type=Char label="Element Code"
---
CDISCPILOT01 | TA | A | Drug A | 1 | SCRN
---

dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
---
CDISCPILOT01 | EX | 01-701-1015 | 1 | Drug A
---
