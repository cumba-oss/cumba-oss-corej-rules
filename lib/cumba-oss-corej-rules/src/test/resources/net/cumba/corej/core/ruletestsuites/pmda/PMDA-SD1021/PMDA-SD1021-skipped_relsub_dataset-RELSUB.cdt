#!RuleTest
#test PMDA-SD1021 expect=skipped domain=RELSUB
#note "The one fixture in the batch that pins a PMDA divergence from the FDA twin's Scope (FDA-SD1021 is 'ALL' and would report this row). Scope.Domains.Exclude: [RELSPEC, RELSUB] -> SKIPPED: domain RELSUB matches Scope.Domains.Exclude entry RELSUB, grounded in the PMDA sheet's own DOMAINS cell."
#library standard=sdtmig version=3-4
dataset RELSUB label="Related Subjects"
col STUDYID type=Char
col USUBJID type=Char
col RSUBJID type=Char
col SREL    type=Char
---
