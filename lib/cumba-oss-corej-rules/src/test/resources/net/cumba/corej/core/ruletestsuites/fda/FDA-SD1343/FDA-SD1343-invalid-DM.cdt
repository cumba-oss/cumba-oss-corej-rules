#!RuleTest
#test FDA-SD1343 expect=violation domain=DM
#note "Row 1 is a treated subject (ACTARMCD='A') with an empty RFXSTDTC -> fires. Row 2 (NOTTRT) is untreated per the FDA rule text, so its empty RFXSTDTC must not fire."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 RFXSTDTC= ACTARMCD=A
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFXSTDTC type=Char label="Date/Time of First Study Treatment"
col ACTARMCD type=Char label="Actual Arm Code"
col ACTARM   type=Char label="Description of Actual Arm"
---
CDISCPILOT01 | DM | 01-701-1015 |            | A      | Arm A
CDISCPILOT01 | DM | 01-701-1023 |            | NOTTRT | Not Treated
