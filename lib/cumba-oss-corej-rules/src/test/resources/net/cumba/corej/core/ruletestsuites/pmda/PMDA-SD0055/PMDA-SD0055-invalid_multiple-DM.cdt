#!RuleTest
#test PMDA-SD0055 expect=violation domain=DM
#note "Two independently non-conformant variables: AGE is submitted as Char although the Library defines Num, and SEX as Num although the Library defines Char. Each variable is its own defect, so both must be reported."
#library standard=sdtmig version=3-4
#library variable-metadata DM AGE  name=AGE  simpleDatatype=Num  label="Age"
#library variable-metadata DM AGEU name=AGEU simpleDatatype=Char label="Age Units"
#library variable-metadata DM SEX  name=SEX  simpleDatatype=Char label="Sex"
#expectViolationCount 2
#expectViolationAt variable_name=AGE
#expectViolationAt variable_name=SEX
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col AGE     type=Char label="Age"
col AGEU    type=Char label="Age Units"
col SEX     type=Num  label="Sex"
---
S1 | 001 | 56 | YEARS | 1
