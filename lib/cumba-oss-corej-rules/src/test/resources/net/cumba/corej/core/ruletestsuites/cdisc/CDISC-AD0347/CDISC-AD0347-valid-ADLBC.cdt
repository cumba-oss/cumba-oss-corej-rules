#!RuleTest
#test CDISC-AD0347 expect=noViolation domain=ADLBC
# Rule:Description: Within a parameter, there is more than one value of AyLO for a given value of AyLOC
#note "each A1LOC value maps to a single A1LO value -> noViolation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col A1LO type=Char
col A1LOC type=Char
---
CDISCPILOT01 | 01-701-1015 | GLUC | A1 | G
CDISCPILOT01 | 01-701-1015 | GLUC | A2 | H
---
