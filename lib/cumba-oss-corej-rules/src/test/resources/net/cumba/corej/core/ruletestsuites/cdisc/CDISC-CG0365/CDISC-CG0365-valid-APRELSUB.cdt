#!RuleTest
#test CDISC-CG0365 expect=noViolation domain=APRELSUB
#note "row 1 relates the associated person to a subject only, row 2 to a device only -> never both -> no violation."
#library standard=sdtmig version=3-4
dataset APRELSUB label="Associated Persons Related Subjects"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col APID    type=Char label="Associated Persons Identifier"
col RSUBJID type=Char label="Related Subject or Pool Identifier"
col RDEVID  type=Char label="Related Device Identifier"
col SREL    type=Char label="Subject Relationship"
---
S1 | APRELSUB | AP-001 | 001 |  | FRIEND
S1 | APRELSUB | AP-002 |  | DEV-01 | OPERATOR
