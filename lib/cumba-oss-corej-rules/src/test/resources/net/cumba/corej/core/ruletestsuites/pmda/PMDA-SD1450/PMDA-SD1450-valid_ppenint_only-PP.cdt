#!RuleTest
#test PMDA-SD1450 expect=noViolation domain=PP
#note "BOUNDARY / direction test: the END bound is declared and the START bound is not, so the FIRST conjunct var_exists(PPSTINT) is FALSE and the rule is silent. This is the scenario that fails if the two operands are ever swapped."
#library standard=sdtmig version=3-4
dataset PP class=FINDINGS label="Pharmacokinetic Parameters"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col PPSEQ    type=Num
col PPTESTCD type=Char
col PPENINT  type=Char
---
CDISCPILOT01 | PP | 01-701-1015 | 1 | AUCALL | PT24H
