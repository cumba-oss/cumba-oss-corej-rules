#!RuleTest
#test CDISC-AD0761 expect=violation domain=ADSL
# Rule:Description: There is more than one value of TRxxAGyN for a given value of TRxxAGy, where xx is an integer [01-99, zero-padded] and y is a single-digit integer [1-9], considering only those rows on which both variables are populated
#note "TR01AG1=GROUP A maps to two distinct TR01AG1N -> violation"
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015
#expectViolationAt row=2 USUBJID=01-701-1023
dataset ADSL class=ADSL
col STUDYID type=Char
col USUBJID type=Char
col TR01AG1 type=Char
col TR01AG1N type=Num
---
CDISCPILOT01 | 01-701-1015 | GROUP A | 1
CDISCPILOT01 | 01-701-1023 | GROUP A | 2
---
