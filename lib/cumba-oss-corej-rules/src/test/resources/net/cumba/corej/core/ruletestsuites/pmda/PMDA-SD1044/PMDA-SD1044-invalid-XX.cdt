#!RuleTest
#test PMDA-SD1044 expect=violation domain=XX
#note "XX is declared a custom domain and carries no XXBLFL (--BLFL) variable -> one dataset-level violation"
#library standard=sdtmig version=3-2
#library custom-domain XX
#expectViolationCount 1
dataset XX class=FINDINGS label="Custom Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col XXSEQ    type=Num  label="Sequence Number"
col XXTESTCD type=Char label="Test Short Name"
col XXORRES  type=Char label="Result or Finding in Original Units"
---
S1 | XX | 001 | 1 | TEST1 | 5
