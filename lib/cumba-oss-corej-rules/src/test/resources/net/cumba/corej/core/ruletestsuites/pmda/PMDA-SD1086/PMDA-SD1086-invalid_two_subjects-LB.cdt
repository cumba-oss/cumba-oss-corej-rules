#!RuleTest
#test PMDA-SD1086 expect=violation domain=LB
#note "FRESH, DISCRIMINATING - pins dy's per-(USUBJID, --DTC) group landing: the SAME LBDTC value yields DIFFERENT study days per subject. Row 1 (subject 001, RFSTDTC 2020-01-01): computed 15, LBDY=15 agrees -> clean. Row 2 (subject 002, RFSTDTC 2020-01-10): computed 6 from 002's own RFSTDTC, LBDY=15 disagrees -> FIRES. If BOTH rows fire, escalate (dy would not be per-subject)."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=002
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test Short Name"
col LBDTC    type=Char label="Date/Time of Specimen Collection"
col LBDY     type=Num  label="Study Day of Specimen Collection"
---
S1 | LB | 001 | 1 | ALB | 2020-01-15 | 15
S1 | LB | 002 | 1 | ALB | 2020-01-15 | 15
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
---
S1 | DM | 001 | 2020-01-01
S1 | DM | 002 | 2020-01-10
---
