#!RuleTest
#test PMDA-SD1230 expect=violation domain=LB
#note "Track B: adapted from FDA-SD1230-invalid-LB.cdt. Row 2 matches the GLUC value-level condition, whose Define-XML DataType is 'float', but stores the text 'ABNORMAL' -> fires. Row 1 conforms and rows 3/4 are the text condition and the unmatched record."
#library standard=sdtmig version=3-4
#define-xml PMDA-SD1230-define.xml
#expectViolationCount 1
#expectViolationAt row=2 LBSTRESC=ABNORMAL
dataset LB class=FINDINGS label="Laboratory Test Results"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBSPEC   type=Char label="Specimen Type"
col LBSTRESC type=Char label="Character Result/Finding in Std Format"
---
001 | GLUC | SERUM | 5.5
001 | GLUC | SERUM | ABNORMAL
001 | PH   | URINE | ACIDIC
001 | HGB  | BLOOD | 13.1
