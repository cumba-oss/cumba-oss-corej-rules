#!RuleTest
#test CDISC-AD0691 expect=violation domain=ADLBC
# Rule:Description: Within a given value of PARAMCD for a combination of device and subject, BASE is populated and there is not at least one record with ABLFL equal to Y
#note "BASE populated but no ABLFL=Y record in the USUBJID+PARAMCD+SPDEVID group -> violation"
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015
dataset ADLBC class=MD-BDS
col STUDYID type=Char
col USUBJID type=Char
col SPDEVID type=Char
col PARAMCD type=Char
col BASE type=Num
col ABLFL type=Char
---
CDISCPILOT01 | 01-701-1015 | DEV01 | GLUC | 100 | N
---
