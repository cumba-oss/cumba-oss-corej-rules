#!RuleTest
#test PMDA-SD1340 expect=violation domain=EX
#note "Row 1: subject 001 has an EX record in the TREATMENT epoch but DM.ACTARMCD is NOTTRT -> fires. Row 2: subject 002 has an EX record and an EMPTY ACTARMCD -> fires. Row 3: subject 003 is also NOTTRT but its record is a RUN-IN one, which the rule exempts. Row 4: subject 004 is treated (TRTA) -> no fire. First scenario coverage for this rule (authored with the D-TA-2 Join_Type removal); FDA-SD1340 is now byte-identical to it."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=001
#expectViolationAt row=2 USUBJID=002
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EPOCH   type=Char label="Epoch"
---
S1 | EX | 001 | 1 | DRUG A | TREATMENT
S1 | EX | 002 | 1 | DRUG A | TREATMENT
S1 | EX | 003 | 1 | DRUG A | RUN-IN
S1 | EX | 004 | 1 | DRUG A | TREATMENT
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ACTARMCD type=Char label="Actual Arm Code"
---
S1 | DM | 001 | NOTTRT
S1 | DM | 002 |
S1 | DM | 003 | NOTTRT
S1 | DM | 004 | TRTA
