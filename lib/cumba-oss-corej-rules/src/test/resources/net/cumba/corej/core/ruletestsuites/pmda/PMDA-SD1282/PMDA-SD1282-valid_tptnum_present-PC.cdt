#!RuleTest
#test PMDA-SD1282 expect=noViolation domain=PC
#note "The second arm's defeat face (--TPTNUM present); together with valid_eltm_present it covers two of the three symmetric arms - the third (--TPT) is the same mechanism."
#library standard=sdtmig version=3-4
dataset PC class=FINDINGS label="Pharmacokinetic Concentrations"
col STUDYID   type=Char
col DOMAIN    type=Char
col USUBJID   type=Char
col PCSEQ     type=Num
col PCTESTCD  type=Char
col PCTPTREF  type=Char
col PCTPTNUM  type=Num
---
S1 | PC | 001 | 1 | DRUGA | MOST RECENT DOSE | 1
---
