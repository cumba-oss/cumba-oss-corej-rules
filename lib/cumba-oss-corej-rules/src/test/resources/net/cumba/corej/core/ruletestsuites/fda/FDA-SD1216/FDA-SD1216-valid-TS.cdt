#!RuleTest
#test FDA-SD1216 expect=noViolation domain=TS
#note "TS carries exactly one AGEMAX record ($agemax_count = 1, not greater than 1) -> no violation. The two duplicated TITLE records prove the count is confined to the TSPARMCD=AGEMAX filter."
#library standard=sdtmig version=3-4
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S1 | TS | 1 | AGEMAX | Planned Maximum Age of Subjects | P80Y
S1 | TS | 1 | TITLE | Trial Title | A Randomized Study
S1 | TS | 2 | TITLE | Trial Title | A Randomized Study
