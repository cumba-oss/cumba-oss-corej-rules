#!RuleTest
#test FDA-SD1032 expect=noViolation domain=DM
#note "Both screen-failure subjects (001, 002) have at least one IE record, so no violation. 003 is a normal subject with no IE record, which the rule must not flag."
#library standard=sdtmig version=3-2
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARMCD    type=Char label="Planned Arm Code"
col ARM      type=Char label="Description of Planned Arm"
---
S1 | DM | 001 | SCRNFAIL | Screen Failure
S1 | DM | 002 | SCRNFAIL | Screen Failure
S1 | DM | 003 | A        | Drug A
---

dataset IE label="Inclusion/Exclusion Criteria Not Met"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IESEQ    type=Num  label="Sequence Number"
col IETESTCD type=Char label="Inclusion/Exclusion Criterion Short Name"
col IEORRES  type=Char label="I/E Criterion Original Result"
---
S1 | IE | 001 | 1 | INCL01 | N
S1 | IE | 002 | 1 | INCL01 | Y
S1 | IE | 002 | 2 | EXCL03 | Y
