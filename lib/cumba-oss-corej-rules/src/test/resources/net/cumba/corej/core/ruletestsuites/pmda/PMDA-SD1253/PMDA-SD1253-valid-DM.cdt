#!RuleTest
#test PMDA-SD1253 expect=noViolation domain=DM
#note "ADAPTED-FROM fda/FDA-SD1253/FDA-SD1253-valid-DM.cdt (verbatim)."
#library standard=sdtmig version=3-4
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col SITEID  type=Char label="Study Site Identifier"
col SEX     type=Char label="Sex"
col DTHDTC  type=Char label="Date/Time of Death"
col DTHFL   type=Char label="Subject Death Flag"
---
CDISCPILOT01 | DM | 001 | 001 | 70 | M | 2020-03-01 | Y
CDISCPILOT01 | DM | 002 | 002 | 70 | F |  |
---

dataset DD label="Death Details"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col DDSEQ    type=Num  label="Sequence Number"
col DDTESTCD type=Char label="Death Diagnosis Short Name"
col DDTEST   type=Char label="Death Diagnosis"
col DDORRES  type=Char label="Result or Finding in Original Units"
---
CDISCPILOT01 | DD | 001 | 1 | PRCDTH | Primary Cause of Death | MYOCARDIAL INFARCTION
---
