#!RuleTest
#test CDISC-SEND-0100 expect=noViolation domain=DM
#note "As invalid plus a define declaration for RFSTDTC -> RFSTDTC is defined -> no violation."
#library standard=sendig version=3-1-1
#define variable-metadata DM STUDYID name=STUDYID label="Study Identifier"
#define variable-metadata DM USUBJID name=USUBJID label="Unique Subject Identifier"
#define variable-metadata DM RFSTDTC name=RFSTDTC label="Subject Reference Start Date/Time"
dataset DM
col STUDYID type=Char
col USUBJID type=Char
col RFSTDTC type=Char
---
S1 | S1-001 | 2020-01-01
