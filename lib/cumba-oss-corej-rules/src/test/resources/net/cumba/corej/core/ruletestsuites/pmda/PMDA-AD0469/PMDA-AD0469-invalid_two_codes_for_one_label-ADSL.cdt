#!RuleTest
#test PMDA-AD0469 expect=violation domain=ADSL
#note "Mirror of AD0468: target is the numeric STRATARN, key is the label STRATAR. Group STRATAR=MALE holds STRATARN {1 x2, 2 x1} -> row 3 is the lone minority. Group FEMALE holds one value and is silent."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 STRATAR=MALE STRATARN=2
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col STRATAR type=Char
col STRATARN type=Num
---
S1 | 001 | MALE   | 1
S1 | 002 | MALE   | 1
S1 | 003 | MALE   | 2
S1 | 004 | FEMALE | 3
