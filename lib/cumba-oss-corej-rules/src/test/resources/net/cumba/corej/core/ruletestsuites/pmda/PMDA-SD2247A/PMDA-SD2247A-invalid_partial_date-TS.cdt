#!RuleTest
#test PMDA-SD2247A expect=violation domain=TS
#note "Row 1 is the negative control (complete date). Row 2 is a valid ISO 8601 PARTIAL date - which is exactly why the base rule PMDA-SD2247 (invalid_date(TSVAL)) stays silent on it and this completeness sibling is the only rule that reports it. Row 3 repeats the same partial value under a different TSPARMCD to prove the parameter gate still selects."
#expectViolationCount 1
#expectViolationAt row=2 TSPARMCD=SSTDTC TSVAL=2020-06
#library standard=sdtmig version=3-4
dataset TS label="Trial Summary"
col STUDYID  type=Char
col DOMAIN   type=Char
col TSSEQ    type=Num
col TSPARMCD type=Char
col TSPARM   type=Char
col TSVAL    type=Char
---
CDISCPILOT01 | TS | 1 | SSTDTC  | Study Start Date | 2020-01-15
CDISCPILOT01 | TS | 2 | SSTDTC  | Study Start Date | 2020-06
CDISCPILOT01 | TS | 3 | DCUTDTC | Data Cutoff Date | 2020-06
