#!RuleTest
#test PMDA-SD1287 expect=noViolation domain=AE
#note "A blank AEDECOD is excluded from the distinct-value count (D.2 emptiness exception), so the remaining two Headache records within PTCD 10019211 are consistent."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col AESEQ   type=Num
col AETERM  type=Char
col AEDECOD type=Char
col AEPTCD  type=Num
---
S1 | AE | 001 | 1 | HEADACHE | Headache | 10019211
S1 | AE | 002 | 1 | HEADACHE |          | 10019211
S1 | AE | 003 | 1 | HEADACHE | Headache | 10019211
