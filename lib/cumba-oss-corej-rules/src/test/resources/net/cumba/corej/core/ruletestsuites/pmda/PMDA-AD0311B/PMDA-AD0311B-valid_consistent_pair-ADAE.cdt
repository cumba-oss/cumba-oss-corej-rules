#!RuleTest
#test PMDA-AD0311B expect=noViolation domain=ADAE
#note "Every key single-valued in both directions -> the rule EXECUTES and stays silent. Same table shape used for both converse rules of the pair."
#library standard=adamig version=1-3
dataset ADAE structure=OCCDS subclass=AE
col STUDYID  type=Char
col USUBJID  type=Char
col AESEQ    type=Num
col AEDECOD  type=Char
col SMQ01SC  type=Char
col SMQ01SCN type=Num
---
