#!RuleTest
#test PMDA-AD0258 expect=noViolation domain=ADAE
#note "AE carries a row for every ADAE (STUDYID, USUBJID, AESEQ) combination. No fire."
#library standard=adamig version=1-1
dataset ADAE
col STUDYID type=Char
col USUBJID type=Char
col AESEQ   type=Num
col AEDECOD type=Char
---
S1 | 001 | 1 | HEADACHE
S1 | 001 | 2 | NAUSEA
S2 | 001 | 1 | RASH
---

dataset AE label="Adverse Events"
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col AESEQ   type=Num
---
S1 | AE | 001 | 1
S1 | AE | 001 | 2
S2 | AE | 001 | 1
