#!RuleTest
#test FDA-SD1017 expect=violation domain=SV
#note "SVUPDES is not present in SV at all, so the bare empty(SVUPDES) leaf is TRUE on every row (absent = all-missing, EC-43) and every visit counts as planned. Plan B phase 4d' deleted the redundant not var_exists(SVUPDES) disjunct that used to make this the second branch of an any-guard; the verdict is unchanged. VISITNUM 99 on row 2 is not declared in TV -> fires."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=001 VISITNUM=99
dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col SVSTDTC  type=Char label="Start Date/Time of Visit"
---
CDISCPILOT01 | SV | 001 | 1 | SCREENING | 2020-01-01
CDISCPILOT01 | SV | 001 | 99 | UNSCHEDULED | 2020-01-15
---

dataset TV label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | TV | 1 | SCREENING
CDISCPILOT01 | TV | 2 | BASELINE
---
