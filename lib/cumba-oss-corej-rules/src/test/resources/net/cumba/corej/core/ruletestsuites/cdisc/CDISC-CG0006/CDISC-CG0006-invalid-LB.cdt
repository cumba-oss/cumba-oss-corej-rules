#!RuleTest
#test CDISC-CG0006 expect=violation domain=LB
#note "Row 1: LBDTC 2020-01-15 vs RFSTDTC 2020-01-01 -> dy computes 15 but LBDY=14 -> fires. Row 2 is correct -> no fire. OPERATION: dy lands per (USUBJID, LBDTC) on the primary rows, reference map read from the resolved DM."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test Short Name"
col LBDTC    type=Char label="Date/Time of Specimen Collection"
col LBDY     type=Num  label="Study Day of Specimen Collection"
---
S1 | LB | 001 | 1 | ALB | 2020-01-15 | 14
S1 | LB | 001 | 2 | ALB | 2020-01-10 | 10
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
---
S1 | DM | 001 | 2020-01-01
---
