#!RuleTest
#test PMDA-SD0032 expect=violation domain=LB
#note "Row 1: LBTPTNUM=1 populated with LBTPT empty -> fires. Row 2: both populated -> clean. Row 3: LBTPTNUM missing -> driver empty -> clean."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 LBTPTNUM=1
dataset LB class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
col LBTPTNUM type=Num
col LBTPT    type=Char
---
S1 | LB | 001 | 1 | GLUC | 1 |
S1 | LB | 001 | 2 | GLUC | 2 | 2 HR POST
S1 | LB | 001 | 3 | GLUC | . |
