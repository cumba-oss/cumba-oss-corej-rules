#!RuleTest
#test PMDA-AD0652 expect=skipped domain=ADAE
#note "WILDCARD-NoMatch skip: ONTRTFL does not match ^ONTRT(\d)FL$ (no digit between ONTRT and FL)."
#library standard=adamig version=1-3
dataset ADAE class=OCCDS
col STUDYID  type=Char
col USUBJID  type=Char
col ASEQ     type=Num
col AEDECOD  type=Char
col ONTRTFL  type=Char
---
CDISCPILOT01 | 01-701-1015 | 1 | HEADACHE | Y
