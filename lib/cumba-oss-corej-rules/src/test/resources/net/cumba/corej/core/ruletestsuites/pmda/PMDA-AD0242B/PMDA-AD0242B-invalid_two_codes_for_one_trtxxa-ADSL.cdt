#!RuleTest
#test PMDA-AD0242B expect=violation domain=ADSL
#note "The literal dataset name ADSL detects SUBJECT LEVEL ANALYSIS DATASET before the column heuristic runs. Group TRT01A=DRUGX holds TRT01AN {1 x2, 2 x1}: row 3 is the lone minority. Group PLACEBO holds one distinct value and is silent. One expansion only (xx=01)."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 TRT01A=DRUGX TRT01AN=2
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRT01A  type=Char
col TRT01AN type=Num
---
S1 | 001 | DRUGX   | 1
S1 | 002 | DRUGX   | 1
S1 | 003 | DRUGX   | 2
S1 | 004 | PLACEBO | 3
