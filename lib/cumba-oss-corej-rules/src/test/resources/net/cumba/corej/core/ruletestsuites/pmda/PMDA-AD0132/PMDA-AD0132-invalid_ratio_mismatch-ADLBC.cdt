#!RuleTest
#test PMDA-AD0132 expect=violation domain=ADLBC
#note "Expected 10/5=2, holds 3 -> fires. Values divide exactly so the 1e-10 tolerance is never in play."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015 AVAL=10 BASE=5 R2BASE=3
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col BASE    type=Num
col R2BASE  type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | 10 | 5 | 3
CDISCPILOT01 | 01-701-1023 | ALB | 10 | 5 | 2
---
