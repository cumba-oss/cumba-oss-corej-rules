#!RuleTest
#test PMDA-SD1079 expect=violation domain=VS
#note "VSTEST is declared before VSTESTCD, contradicting the SDTM Model variable order for VS (VSTESTCD before VSTEST) -> the dataset column order is not an ordered subset of the Model order and the rule fires once for the dataset."
#library standard=sdtmig version=3-4
#library model-column-order VS STUDYID DOMAIN USUBJID VSSEQ VSGRPID VSTESTCD VSTEST VSCAT VSPOS VSORRES VSORRESU
#expectViolationCount 1
dataset VS label="Vital Signs"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VSSEQ    type=Num  label="Sequence Number"
col VSTEST   type=Char label="Vital Signs Test Name"
col VSTESTCD type=Char label="Vital Signs Test Short Name"
col VSORRES  type=Char label="Result or Finding in Original Units"
---
CDISCPILOT01 | VS | 01-701-1015 | 1 | Systolic Blood Pressure | SYSBP | 120
