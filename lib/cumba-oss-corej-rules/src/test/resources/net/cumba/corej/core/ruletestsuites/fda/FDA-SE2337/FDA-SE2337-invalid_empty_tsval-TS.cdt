#!RuleTest
#test FDA-SE2337 expect=violation domain=TS
#note "Regression pin for the T4 fix: the non_empty exemption was removed from the Check, so an empty TSVAL for this parameter fires."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 TSPARMCD=DOSSTDTC TSVAL=
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
SEND001 | TS | 1 | DOSSTDTC | Start Date Time Of Dose Interval |
SEND001 | TS | 1 | DOSENDTC | End Date Time Of Dose Interval | 2020-01-01
