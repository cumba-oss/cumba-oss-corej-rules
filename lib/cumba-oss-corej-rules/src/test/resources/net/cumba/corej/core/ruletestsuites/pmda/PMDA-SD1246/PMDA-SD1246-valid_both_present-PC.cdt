#!RuleTest
#test PMDA-SD1246 expect=noViolation domain=PC
#note "Both columns present -> second conjunct false -> silent (with execution)."
#library standard=sdtmig version=3-4
dataset PC class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col PCSEQ    type=Num
col PCELTM   type=Char
col PCTPTREF type=Char
