#!RuleTest
#test PMDA-AD0331 expect=noViolation domain=ADLBC
#note "Each (PARAMCD, CHGCAT1N) group holds one distinct CHGCAT1."
#library standard=adamig version=1-3
dataset ADLBC class=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col CHGCAT1  type=Char
col CHGCAT1N type=Num
---
S1 | 001 | ALB | INCREASE | 1
S1 | 002 | ALB | INCREASE | 1
S1 | 003 | ALB | DECREASE | 2
