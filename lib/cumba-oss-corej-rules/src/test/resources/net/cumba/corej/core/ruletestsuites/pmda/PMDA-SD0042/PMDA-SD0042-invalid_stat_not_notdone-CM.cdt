#!RuleTest
#test PMDA-SD0042 expect=violation domain=CM
#note "Row 1: PRESP='Y', OCCUR empty, STAT empty: '' != 'NOT DONE' is TRUE (operator-examples B.1) -> FIRES. Row 2: STAT populated with the wrong value -> FIRES. Row 3: conformant -> clean. Row 4: OCCUR populated (a response WAS provided) -> clean. Row 5: not pre-specified -> clean. Row 1 is the sheet's own core case ('should be SET to NOT DONE' - an unset STAT violates)."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 CMSEQ=1
#expectViolationAt row=2 CMSEQ=2
dataset CM class=INTERVENTIONS label="Concomitant Medications"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col CMSEQ    type=Num
col CMTRT    type=Char
col CMPRESP  type=Char
col CMOCCUR  type=Char
col CMSTAT   type=Char
---
S1 | CM | 001 | 1 | ASPIRIN   | Y |   |
S1 | CM | 001 | 2 | IBUPROFEN | Y |   | COMPLETED
S1 | CM | 001 | 3 | NAPROXEN  | Y |   | NOT DONE
S1 | CM | 001 | 4 | CODEINE   | Y | N |
S1 | CM | 001 | 5 | DIAZEPAM  | N |   |
---
