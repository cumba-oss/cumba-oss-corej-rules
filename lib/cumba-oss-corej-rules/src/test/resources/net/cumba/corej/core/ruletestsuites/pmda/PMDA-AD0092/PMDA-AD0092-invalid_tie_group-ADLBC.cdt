#!RuleTest
#test PMDA-AD0092 expect=violation domain=ADLBC
#note "Batch's single pin on the is_inconsistent_across_dataset TIE contract (shared by the other four C-a62789e7 rules and PMDA-AD0221 - not duplicated there). Group DRUGA holds two distinct non-blank values with NO strict majority -> EVERY non-blank row in the group is flagged -> TWO violations."
#library standard=adamig version=1-0
#expectViolationCount 2
#expectViolationAt row=1 TRTP=DRUGA TRTPN=1
#expectViolationAt row=2 TRTP=DRUGA TRTPN=2
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col TRTP    type=Char
col TRTPN   type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | DRUGA | 1
CDISCPILOT01 | 01-701-1023 | ALB | DRUGA | 2
