#!RuleTest
#test CDISC-CG0175 expect=violation domain=IE
#note "Row 1: IECAT='EXCLUSION' but IEORRES='N' instead of the required 'Y' -> fires. Row 2 is a conformant exclusion; row 3 is an inclusion record."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 IECAT=EXCLUSION IEORRES=N
dataset IE class=FINDINGS label="Inclusion/Exclusion Criteria Not Met"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IESEQ    type=Num  label="Sequence Number"
col IETESTCD type=Char label="Inclusion/Exclusion Criterion Short Name"
col IECAT    type=Char label="Inclusion/Exclusion Category"
col IEORRES  type=Char label="I/E Criterion Original Result"
---
S1 | IE | 001 | 1 | EXCL01 | EXCLUSION | N
S1 | IE | 002 | 1 | EXCL02 | EXCLUSION | Y
S1 | IE | 003 | 1 | INCL01 | INCLUSION | N
