#!RuleTest
#test FDA-SE2224 expect=violation domain=TS
#note "No TSPARMCD=TSTFNAM record anywhere in TS -> the 'Test Facility Name' parameter is missing, one dataset-level finding. Note the sibling test-facility parameters TSTFLOC (same TSTF prefix) and TFCNTRY are present but neither is TSTFNAM."
#library standard=sendig version=3-1-1
#expectViolationCount 1
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | TSTFLOC | Test Facility Location | Boston, MA
S01 | TS | 2 | TFCNTRY | Test Facility Country | USA
S01 | TS | 3 | STITLE | Study Title | 28-Day Repeat Dose Toxicity Study
