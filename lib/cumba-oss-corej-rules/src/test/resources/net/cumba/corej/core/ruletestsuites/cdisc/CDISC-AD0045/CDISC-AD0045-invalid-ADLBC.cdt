#!RuleTest
#test CDISC-AD0045 expect=violation domain=ADLBC
# Rule:Description: A variable with a suffix of DT and a variable with a suffix of DTM with the same root name have different date values
#note "ADT and ADTM both populated; ADTM date-part (2020-01-02) differs from ADT (2020-01-01) -> violation"
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col ADT type=Char
col ADTM type=Char
---
CDISCPILOT01 | 01-701-1015 | 2020-01-01 | 2020-01-02T00:00:00
---
