#!RuleTest
#test FDA-SD1212 expect=noViolation domain=LB
#note "LBSTRESN matches its numeric LBSTRESC on rows 1-3 (integer, decimal, negative); row 4 has a non-numeric LBSTRESC so the rule does not apply; row 5 leaves LBSTRESN missing."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBSTRESC type=Char label="Character Result/Finding in Std Format"
col LBSTRESN type=Num  label="Numeric Result/Finding in Standard Units"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB  | 40       | 40
CDISCPILOT01 | LB | 01-701-1015 | 2 | GLUC | 5.5      | 5.5
CDISCPILOT01 | LB | 01-701-1015 | 3 | BASE | -2       | -2
CDISCPILOT01 | LB | 01-701-1015 | 4 | HIV  | POSITIVE | 1
CDISCPILOT01 | LB | 01-701-1015 | 5 | ALT  | 12       |
