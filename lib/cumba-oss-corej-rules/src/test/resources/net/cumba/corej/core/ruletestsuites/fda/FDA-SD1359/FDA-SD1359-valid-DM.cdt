#!RuleTest
#test FDA-SD1359 expect=noViolation domain=DM
#note "Row 1 has ARMCD/ARM populated (ARMNRS legitimately empty); row 2 has both planned-arm variables empty but ARMNRS carries the reason -> no violation."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
col ARMNRS  type=Char label="Reason Arm and/or Actual Arm is Null"
---
S1 | DM | 001 | A | Treatment A |
S1 | DM | 002 |   |             | SCREEN FAILURE
