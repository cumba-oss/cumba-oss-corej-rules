#!RuleTest
#test PMDA-SD2207 expect=violation domain=TS
#note "FRESH - the cluster's 0-row broadcast fire pin (SD2287/SD2221/SD2224 precedents; record_count EmptyResult is COUNT and the fold sits above the synthetic-row branch). A DECLARED 0-row TS -> $sexpop_count=0 -> fires once: count 1 AND row=1, NO value pin. Escalate if anything else."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
col TSVALNF  type=Char label="Parameter Null Flavor"
---
