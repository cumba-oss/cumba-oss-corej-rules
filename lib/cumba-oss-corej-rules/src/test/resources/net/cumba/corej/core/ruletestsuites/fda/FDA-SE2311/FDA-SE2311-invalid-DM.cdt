#!RuleTest
#test FDA-SE2311 expect=violation domain=DM
#note "Row 2 assigns subject 002 to SETCD=SET9, which the Trial Sets (TX) dataset does not declare -> fires. Row 1 (SET1) matches TX, row 3 has an empty SETCD."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=002 SETCD=SET9
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
col SEX     type=Char label="Sex"
col SETCD   type=Char label="Set Code"
---
S1 | DM | 001 | 001 | 2020-01-01 | M | SET1
S1 | DM | 002 | 002 | 2020-01-01 | F | SET9
S1 | DM | 003 | 003 | 2020-01-01 | F |
---

dataset TX class="TRIAL DESIGN" label="Trial Sets"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col SETCD    type=Char label="Set Code"
col SET      type=Char label="Set Description"
col TXSEQ    type=Num  label="Sequence Number"
col TXPARMCD type=Char label="Trial Set Parameter Short Name"
col TXPARM   type=Char label="Trial Set Parameter"
col TXVAL    type=Char label="Trial Set Parameter Value"
---
S1 | TX | SET1 | Control   | 1 | ARMCD | Planned Arm Code | CTRL
S1 | TX | SET2 | High dose | 1 | ARMCD | Planned Arm Code | HIGH
---
