#!RuleTest
#test PMDA-AD0147B expect=skipped domain=ADLBC
#note "PARAMN is not declared. PARAMCD keeps the dataset detecting as BASIC DATA STRUCTURE so the structure gate passes, and the SKIP is unambiguously the Requirements.Variables.All [PARAM, PARAMN] gate reporting the rule skipped for the absent variable."
#library standard=adamig version=1-3
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col PARAM   type=Char
---
S1 | 001 | ALB | Albumin
S1 | 002 | ALB | Albumin
