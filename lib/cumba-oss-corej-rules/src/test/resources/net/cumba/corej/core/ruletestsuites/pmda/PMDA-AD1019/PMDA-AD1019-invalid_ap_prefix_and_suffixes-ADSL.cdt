#!RuleTest
#test PMDA-AD1019 expect=violation domain=ADSL
#note "Pins the AP alternative of the prefix group, two different suffix alternatives, and the per-column granularity at 2. AP01SDTM is the conformant control in the same file."
#library standard=adamig version=1-3
#expectViolationCount 2
#expectViolationAt variable_name=AP00SDTM
#expectViolationAt variable_name=AP00ETMF
dataset ADSL
col STUDYID  type=Char
col USUBJID  type=Char
col AP00SDTM type=Num
col AP00ETMF type=Char
col AP01SDTM type=Num
---
CDISCPILOT01 | 01-701-1015 | 1 | N | 1
