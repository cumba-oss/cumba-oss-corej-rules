#!RuleTest
#test PMDA-SD1336 expect=violation domain=TR
#note "DISCRIMINATING: TU is declared with zero data rows -> every subject's grouped distinct(TULNKID) set is EMPTY. Rows 1 and 2 carry populated TRLNKID values and both fire against the empty set; row 3 leaves TRLNKID empty and stays guarded. If this reports 0, escalate — a missing-$ saturation there would be a real detection."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=001 TRLNKID=T01
#expectViolationAt row=2 USUBJID=002 TRLNKID=T02
dataset TR label="Tumor Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col TRSEQ    type=Num  label="Sequence Number"
col TRLNKID  type=Char label="Link ID"
col TRTESTCD type=Char label="Tumor Assessment Short Name"
col TRORRES  type=Char label="Result or Finding in Original Units"
---
CDISCPILOT01 | TR | 001 | 1 | T01 | LDIAM | 20
CDISCPILOT01 | TR | 002 | 1 | T02 | LDIAM | 15
CDISCPILOT01 | TR | 002 | 2 |  | SUMDIAM | 12
---

dataset TU label="Tumor Identification"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col TUSEQ    type=Num  label="Sequence Number"
col TULNKID  type=Char label="Link ID"
col TUTESTCD type=Char label="Tumor Identification Short Name"
col TUORRES  type=Char label="Result or Finding in Original Units"
---
