#!RuleTest
#test FDA-SD0050 expect=violation domain=AE
#note "Row 1 says the event was ONGOING relative to a reference time point but leaves AEENTPT empty -> 'End Reference Time Point (--ENTPT) must not be NULL, when End Relative to Reference Time Point (--ENRTPT) is provided'."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 AEENRTPT=ONGOING AEENTPT=
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEENRTPT type=Char label="End Relative to Reference Time Point"
col AEENTPT  type=Char label="End Reference Time Point"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE | ONGOING |
CDISCPILOT01 | AE | 01-701-1015 | 2 | NAUSEA   | BEFORE  | 2020-03-01
