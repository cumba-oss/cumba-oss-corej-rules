#!RuleTest
#test FDA-SE2260 expect=noViolation domain=TP
#note "Both repro phase start reference days are one of the two permitted values (0 and 1) -> nothing is flagged."
#library standard=sendig version=dart-1-1
dataset TP label="Trial Repro Paths"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col RPATHCD  type=Char label="Planned Repro Path Code"
col RPATH    type=Char label="Description of Planned Repro Path"
col TPSTGORD type=Num  label="Order of Repro Stage within Repro Path"
col RSTGCD   type=Char label="Repro Stage Code"
col RPHASE   type=Char label="Repro Phase"
col RPRFDY   type=Num  label="Repro Phase Start Reference Day"
---
S1 | TP | PATH1 | Repro Path 1 | 1 | GEST | GESTATION | 0
S1 | TP | PATH1 | Repro Path 1 | 2 | LACT | LACTATION | 1
