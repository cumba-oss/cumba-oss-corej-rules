#!RuleTest
#test PMDA-AD0313 expect=noViolation domain=ADAE
#note "The value 3 is out of range, but the column name has a ONE-digit index and ^SMQ\\d{2}SCN\$ demands exactly two, so the varname() guard is false and the rule stays silent. Pins the zero-padded reading of the sheet."
#library standard=adamig version=1-1
dataset ADAE structure=OCCDS subclass=AE
col STUDYID  type=Char
col USUBJID  type=Char
col ASEQ     type=Num
col AEDECOD  type=Char
col SMQ1SCN  type=Num
---
CDISCPILOT01 | 01-701-1015 | 1 | HEADACHE | 3
