#!RuleTest
#test FDA-SD0032 expect=violation domain=LB
#note "LBTPT is not present in the dataset while LBTPTNUM is populated on row 1 -> the time point name is missing. Encodes the column-absent case: the Check carries a bare empty(--TPT) leaf, which under absent = all-missing (EC-43) is TRUE on every row of a column that is not there. Plan B phase 4d' deleted the redundant not var_exists(--TPT) disjunct that used to spell this out; the verdict is unchanged."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 LBTPTNUM=1
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBTPTNUM type=Num  label="Planned Time Point Number"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | GLUC | 1
CDISCPILOT01 | LB | 01-701-1015 | 2 | GLUC |
