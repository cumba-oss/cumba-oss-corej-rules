#!RuleTest
#test PMDA-AD0615 expect=violation domain=ADLBC
#note "Row 1: driver APHASEN=1 -> ADSL.PH1EDTM=1987090000, PHEDTM 1987093600 != 1987090000 -> fires. Row 2: equal -> silent. Join ADSL on Keys=[USUBJID], loader-default inner, 1:1."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 APHASEN=1 PHEDTM=1987093600
dataset ADLBC structure=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVAL     type=Num
col APHASEN  type=Num
col PHEDTM   type=Num
