#!RuleTest
#test CDISC-SEND-0006 expect=noViolation domain=DM
#note "AGEU carries label 'Units of Age' that matches nothing, but AGEU is NOT declared in the define; only SEX is declared (label agrees). A label mismatch can only be asserted against a declared variable, so the rule is silent (mirrors fda/FDA-SD1324-valid_not_in_define-DM.cdt)."
#library standard=sendig version=3-1-1
#define variable-metadata DM SEX name=SEX label="Sex"
dataset DM
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col AGEU    type=Char label="Units of Age"
col SEX     type=Char label="Sex"
---
S1 | S1-001 | WEEKS | M
