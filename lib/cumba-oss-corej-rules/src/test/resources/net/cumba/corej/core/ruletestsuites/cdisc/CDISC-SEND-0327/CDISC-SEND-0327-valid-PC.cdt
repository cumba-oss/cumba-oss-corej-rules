#!RuleTest
#test CDISC-SEND-0327 expect=noViolation domain=PC
#note "Row 1 is a pre-dose specimen correctly anchored at PT0H; row 2's dates carry no time component (the T-digit regex legs fail, the comparison is not meaningful); row 3 was collected after the reference point -> no violation."
#library standard=sendig version=3-1-1
dataset PC label="Pharmacokinetic Concentrations"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col PCSEQ type=Num label="Sequence Number"
col PCTESTCD type=Char label="Test Short Name"
col PCDTC type=Char label="Date/Time of Specimen Collection"
col PCRFTDTC type=Char label="Date/Time of Reference Point"
col PCELTM type=Char label="Planned Elapsed Time from Time Point Ref"
---
STUDY01 | PC | SUBJ-001 | 1 | DRUGX | 2026-03-01T08:00 | 2026-03-01T09:00 | PT0H
STUDY01 | PC | SUBJ-001 | 2 | DRUGX | 2026-03-01 | 2026-03-01 | PT1H
STUDY01 | PC | SUBJ-001 | 3 | DRUGX | 2026-03-01T10:00 | 2026-03-01T09:00 | PT1H
