#!RuleTest
#test PMDA-AD0110B expect=violation domain=ADLBC
#note "No scope key - PARAMCD makes it BDS. Key is the pair [PARAMCD, AVISITN]; group (SYSBP, 2) holds targets {WEEK2, WEEK2, WEEK02} so the minority row 3 fires; group (SYSBP, 4) is a singleton. WEEK2/WEEK02 are the deliberate space-free labelling-slip look-alikes the rule exists to catch."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 AVISIT=WEEK02 AVISITN=2 PARAMCD=SYSBP
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVISIT  type=Char
col AVISITN type=Num
---
CDISCPILOT01 | 01-701-1015 | SYSBP | WEEK2  | 2
CDISCPILOT01 | 01-701-1023 | SYSBP | WEEK2  | 2
CDISCPILOT01 | 01-701-1034 | SYSBP | WEEK02 | 2
CDISCPILOT01 | 01-701-1047 | SYSBP | WEEK4  | 4
