#!RuleTest
#test FDA-SD1015 expect=violation domain=SE
#note "SE row 2 carries EPOCH 'RUN-IN', which is not one of the EPOCH values declared in TA (SCREENING / TREATMENT / FOLLOW-UP) -> fires once."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=001 EPOCH=RUN-IN
dataset SE label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ   type=Num  label="Sequence Number"
col ETCD    type=Char label="Element Code"
col EPOCH   type=Char label="Epoch"
---
CDISCPILOT01 | SE | 001 | 1 | SCRN | SCREENING
CDISCPILOT01 | SE | 001 | 2 | RUNIN | RUN-IN
CDISCPILOT01 | SE | 002 | 1 | TRT | TREATMENT
---

dataset TA label="Trial Arms"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
col TAETORD  type=Num  label="Planned Order of Element within Arm"
col ETCD    type=Char label="Element Code"
col EPOCH   type=Char label="Epoch"
---
CDISCPILOT01 | TA | A | Drug A | 1 | SCRN | SCREENING
CDISCPILOT01 | TA | A | Drug A | 2 | TRT | TREATMENT
CDISCPILOT01 | TA | A | Drug A | 3 | FUP | FOLLOW-UP
---
