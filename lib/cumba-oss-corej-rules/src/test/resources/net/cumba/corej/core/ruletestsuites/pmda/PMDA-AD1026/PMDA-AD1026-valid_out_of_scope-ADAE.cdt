#!RuleTest
#test PMDA-AD1026 expect=skipped domain=ADAE
#note "Scope contract: the rule is scoped to its anchor ADSL, so on an unrelated dataset it is not evaluated at all. Before the re-scope ([ALL]) it ran here and reported a no-violation execution row for every dataset in the study."
#library standard=adamig version=1-3
dataset ADAE class=OCCDS label="Adverse Events Analysis Dataset"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col AETERM  type=Char label="Reported Term for the Adverse Event"
---
CDISCPILOT01 | 01-701-1015 | HEADACHE
