#!RuleTest
#test FDA-SD1040 expect=violation domain=AE
#note "Redundant AESCAT values: row 1 duplicates AETERM, row 2 duplicates DOMAIN (case-insensitively, 'ae' vs 'AE'), row 3 duplicates AEBODSYS with different casing. Row 4 carries a distinct subcategory and row 5 leaves AESCAT empty -> neither fires."
#library standard=sdtmig version=3-4
#expectViolationCount 3
#expectViolationAt row=1 AESCAT=Headache
#expectViolationAt row=2 AESCAT=ae
#expectViolationAt row=3 AESCAT="NERVOUS SYSTEM DISORDERS"
dataset AE class=EVENTS label="Adverse Events"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col AESEQ    type=Num  label="Sequence Number"
col AETERM   type=Char label="Reported Term for the Adverse Event"
col AEBODSYS type=Char label="Body System or Organ Class"
col AECAT    type=Char label="Category for Adverse Event"
col AESCAT   type=Char label="Subcategory for Adverse Event"
---
S1 | AE | 001 | 1 | Headache  | Nervous system disorders | NEUROLOGIC | Headache
S1 | AE | 001 | 2 | Nausea    | Gastrointestinal disorders | GI       | ae
S1 | AE | 001 | 3 | Dizziness | Nervous system disorders | NEUROLOGIC | NERVOUS SYSTEM DISORDERS
S1 | AE | 001 | 4 | Migraine  | Nervous system disorders | NEUROLOGIC | VASCULAR
S1 | AE | 001 | 5 | Fatigue   | General disorders        | GENERAL    |
