#!RuleTest
#test PMDA-AD0250 expect=violation domain=ADTTE
#note "Isolates the CNSDTDSC arm: a censoring description is present while EVNTDESC and CNSR are not declared. Presence-only check, folded to one dataset-level violation reported at row 1. The data shape deliberately mirrors PMDA-AD0251's invalid fixture - that near-identity is the evidence for the sheet-level subsumption (AD0250 strictly subsumes AD0251, a duplication IN THE SHEET, not in the corpus), not an oversight."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 CNSDTDSC=LASTCONTACT
dataset ADTTE structure=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVAL     type=Num
col STARTDT  type=Num
col CNSDTDSC type=Char
---
CDISCPILOT01 | 01-701-1015 | TTDEATH | 120 | 21915 | LASTCONTACT
CDISCPILOT01 | 01-701-1023 | TTDEATH | 300 | 21915 | WITHDRAWAL
