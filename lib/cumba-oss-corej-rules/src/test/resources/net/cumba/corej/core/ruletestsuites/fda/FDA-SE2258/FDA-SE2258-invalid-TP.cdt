#!RuleTest
#test FDA-SE2258 expect=violation domain=TP
#note "The second scoped domain: TP row 2 references RSTGCD=ST7 which TT does not declare -> fires. Row 1 (ST1) matches TT."
#library standard=sendig version=dart-1-1
#expectViolationCount 1
#expectViolationAt row=2 RSTGCD=ST7
dataset TP class="TRIAL DESIGN" label="Trial Repro Paths"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col RPATHCD  type=Char label="Repro Path Code"
col RPATH    type=Char label="Repro Path"
col TPSTGORD type=Num  label="Repro Stage Order Number"
col RSTGCD   type=Char label="Repro Stage Code"
col RSTAGE   type=Char label="Description of Repro Stage"
---
S1 | TP | P1 | F0 Female | 1 | ST1 | Premating
S1 | TP | P1 | F0 Female | 2 | ST7 | Unknown stage
---

dataset TT class="TRIAL DESIGN" label="Trial Repro Stages"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col RSTGCD  type=Char label="Repro Stage Code"
col RSTAGE  type=Char label="Description of Repro Stage"
col TTSTRL  type=Char label="Repro Stage Start Rule"
---
S1 | TT | ST1 | Premating | FIRST DOSE
S1 | TT | ST2 | Gestation | GD 0
---
