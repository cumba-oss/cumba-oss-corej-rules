#!RuleTest
#test FDA-SD1266 expect=violation domain=SE
#note "Row 2 codes the element as UNPLAN but gives no description of the unplanned element -> fires."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 ETCD=UNPLAN
dataset SE label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ   type=Num  label="Sequence Number"
col ETCD    type=Char label="Element Code"
col ELEMENT type=Char label="Description of Element"
col SEUPDES type=Char label="Description of Unplanned Element"
---
CDISCPILOT01 | SE | 01-701-1015 | 1 | SCRN   | Screening |
CDISCPILOT01 | SE | 01-701-1015 | 2 | UNPLAN |           |
