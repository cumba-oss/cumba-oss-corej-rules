#!RuleTest
#test PMDA-AD0225 expect=violation domain=ADLBC
#note "Row 1: (12-10)/10*100 = 20 but PCHG = 25 -> fires. Row 2: correct -> silent. Record granularity -> 1 violation."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015 AVAL=12 BASE=10 PCHG=25
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col BASE    type=Num
col PCHG    type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | 12 | 10 | 25
CDISCPILOT01 | 01-701-1023 | ALB | 12 | 10 | 20
