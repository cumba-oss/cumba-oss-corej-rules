#!RuleTest
#test CDISC-CG0462 expect=noViolation domain=EC
#note "Row 1 captures the dose as text in ECDOSTXT (the ECDOSTXT-empty conjunct fails); row 2 has ECOCCUR=N (administration did not occur); row 3 has ECDOSE populated -> no branch holds on any row."
#library standard=sdtmig version=3-4
dataset EC label="Exposure as Collected"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col ECSEQ type=Num label="Sequence Number"
col ECOCCUR type=Char label="Occurrence"
col ECSTAT type=Char label="Completion Status"
col ECDOSTXT type=Char label="Dose Description"
col ECDOSE type=Num label="Dose per Administration"
---
CDISCPILOT01 | EC | 01-701-1015 | 1 | Y |  | 2 TABLETS |
CDISCPILOT01 | EC | 01-701-1015 | 2 | N |  |  |
CDISCPILOT01 | EC | 01-701-1023 | 3 | Y |  |  | 100
