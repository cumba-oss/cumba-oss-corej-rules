<?xml version="1.0" encoding="UTF-8"?>
<!-- PMDA batch P5b violations 2.1 fixture: one dedicated violator per rule.
       DD0049 - IG.DM is alone in Domain DM but SASDatasetName is DM1
       DD0050 - split part IG.QSMD has SASDatasetName QXMD (prefix QX != QS)
       DD0063 - split part IG.QSCG has no Alias
       DD0075 - IT.QSCAT's Collected/Subject origin references LF.SUPPDOC,
                not the AnnotatedCRF leaf LF.ACRF
       DD0084 - the folder-gated test creates every referenced file EXCEPT
                dm.xpt in its @TempDir submission folder (exactly one missing)
       DD0102 - the AnnotatedCRF leaf LF.ACRF's href basename is
                annotated-crf.pdf, not acrf.pdf
       DD0114 - split pair XX: IG.XX2 carries class RELATIONSHIP (IG.XX1 is
                EVENTS, so exactly one offender)
       DD0115 - Domain AE lists the unsplit IG.AE (Name=AE=Domain) alongside
                the split part IG.AE1 (fires once, on IG.AE) -->
