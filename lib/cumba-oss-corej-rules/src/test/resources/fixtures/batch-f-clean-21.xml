<?xml version="1.0" encoding="UTF-8"?>
<!-- Batch F (methods / comments / alias / misc leaves) clean fixture: every batch-F
     rule executes and produces no findings. Contains at least one instance of every
     scoped element: Description (with TranslatedText), Decode, ItemGroupDef (incl. a
     SUPP dataset with Alias under def:Context="Submission"), Alias (Context+Name),
     MethodDef (OID/Name/Type, one Description, FormalExpression with Context),
     def:CommentDef (unique OIDs, one Description each), def:leaf (unique valid IDs,
     xlink:href, exactly one def:title). -->
<ODM xmlns="http://www.cdisc.org/ns/odm/v1.3"
     xmlns:def="http://www.cdisc.org/ns/def/v2.1"
     xmlns:xlink="http://www.w3.org/1999/xlink"
     FileOID="www.example.org/define/batch-f-clean"
     FileType="Snapshot"
     ODMVersion="1.3.2"
     CreationDateTime="2026-07-03T10:15:30"
     def:Context="Submission">
  <Study OID="ST.BATCHF.CLEAN">
    <GlobalVariables>
      <StudyName>BATCHF-CLEAN</StudyName>
      <StudyDescription>Batch F clean fixture study</StudyDescription>
      <ProtocolName>BATCHF-01</ProtocolName>
    </GlobalVariables>
    <MetaDataVersion OID="MDV.1" Name="Batch F clean MDV" def:DefineVersion="2.1.0">
      <def:Standards>
        <def:Standard OID="STD.1" Name="SDTMIG" Type="IG" Version="3.4" Status="Final"/>
      </def:Standards>
      <ItemGroupDef OID="IG.AE" Name="AE" Domain="AE" def:StructureName="One record per adverse event per subject">
        <Description>
          <TranslatedText xml:lang="en">Adverse Events</TranslatedText>
        </Description>
      </ItemGroupDef>
      <ItemGroupDef OID="IG.SUPPAE" Name="SUPPAE" Domain="AE" def:StructureName="One record per IDVAR, IDVARVAL, and QNAM value per subject">
        <Description>
          <TranslatedText xml:lang="en">Supplemental Qualifiers for AE</TranslatedText>
        </Description>
        <Alias Context="DomainDescription" Name="Supplemental Qualifiers for AE"/>
        <def:leaf ID="LF.SUPPAE" xlink:href="suppae.xpt">
          <def:title>suppae.xpt</def:title>
        </def:leaf>
      </ItemGroupDef>
      <ItemDef OID="IT.AE.AETERM" Name="AETERM" DataType="text">
        <Description>
          <TranslatedText xml:lang="en">Reported Term for the Adverse Event</TranslatedText>
        </Description>
        <Alias Context="CDASH" Name="AETERM"/>
      </ItemDef>
      <CodeList OID="CL.NY" Name="No Yes Response" DataType="text">
        <Description>
          <TranslatedText xml:lang="en">No Yes Response</TranslatedText>
        </Description>
        <CodeListItem CodedValue="N">
          <Decode>
            <TranslatedText xml:lang="en">No</TranslatedText>
          </Decode>
          <Alias Context="nci:ExtCodeID" Name="C49487"/>
        </CodeListItem>
        <EnumeratedItem CodedValue="Y">
          <Alias Context="nci:ExtCodeID" Name="C49488"/>
        </EnumeratedItem>
        <Alias Context="nci:ExtCodeID" Name="C66742"/>
      </CodeList>
      <MethodDef OID="MT.AGE" Name="Algorithm to derive AGE" Type="Computation">
        <Description>
          <TranslatedText xml:lang="en">AGE = floor((RFSTDTC - BRTHDTC) / 365.25)</TranslatedText>
        </Description>
        <FormalExpression Context="SAS 9.4">floor((input(RFSTDTC,yymmdd10.) - input(BRTHDTC,yymmdd10.)) / 365.25)</FormalExpression>
      </MethodDef>
      <MethodDef OID="MT.AESTDTC" Name="Algorithm to impute AESTDTC" Type="Imputation">
        <Description>
          <TranslatedText xml:lang="en">Missing day imputed as the first day of the month.</TranslatedText>
        </Description>
      </MethodDef>
      <def:CommentDef OID="COM.MDV">
        <Description>
          <TranslatedText xml:lang="en">Metadata version comment.</TranslatedText>
        </Description>
      </def:CommentDef>
      <def:CommentDef OID="COM.AE">
        <Description>
          <TranslatedText xml:lang="en">AE dataset comment.</TranslatedText>
        </Description>
      </def:CommentDef>
      <def:leaf ID="LF.DEFINE" xlink:href="define.xml">
        <def:title>define.xml</def:title>
      </def:leaf>
      <def:leaf ID="LF.ACRF" xlink:href="acrf.pdf">
        <def:title>Annotated CRF</def:title>
      </def:leaf>
    </MetaDataVersion>
  </Study>
</ODM>
