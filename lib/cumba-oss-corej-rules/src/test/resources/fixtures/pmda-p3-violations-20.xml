<?xml version="1.0" encoding="UTF-8"?>
<!-- PMDA batch P3 violations 2.0 fixture: exercises the Define-XML 2.0 legs of the
     dual-version guards (no P3 rule is 2.0-only, but several dispatch on 2.0
     vocabulary organically):
       DD0035 - Origin Type='CRF' whose DocumentRef has no def:PDFPageRef (IT.A35)
       DD0045 - MetaDataVersion @def:StandardName='SDTM-IG', dataset without Domain (IG.A45)
       DD0046 - MetaDataVersion @def:StandardName='ADaM-IG', dataset WITH Domain (IG.B46)
       DD0054 - dataset with neither a def:Class ATTRIBUTE (2.0 carrier) nor child (IG.A54)
       DD0087 - SDTM-IG document carrying an arm:AnalysisResultDisplays block (MDV.A)
       DD0111 - pages on a non-CRF origin (IT.A111)
     Expected on a "2.0" run: exactly one finding for each of the six ids above, zero
     for every other 2.0-applicable P3 rule, NOT_APPLICABLE_VERSION for the 2.1-only ones.
     Compliant 2.0 shapes prove the clean sides: IG.A1 uses the def:Class attribute and
     a Type='CRF' origin WITH pages. -->
<ODM xmlns="http://www.cdisc.org/ns/odm/v1.3"
     xmlns:def="http://www.cdisc.org/ns/def/v2.0"
     xmlns:arm="http://www.cdisc.org/ns/arm/v1.0"
     xmlns:xlink="http://www.w3.org/1999/xlink"
     FileOID="www.example.org/define/pmda-p3-violations-20"
     FileType="Snapshot"
     ODMVersion="1.3.2"
     CreationDateTime="2026-07-03T10:15:30">
  <Study OID="ST.PMDAP3V20">
    <GlobalVariables>
      <StudyName>PMDAP3V20-STUDY</StudyName>
      <StudyDescription>PMDA batch P3 violations 2.0 fixture study</StudyDescription>
      <ProtocolName>PMDAP3V20-01</ProtocolName>
    </GlobalVariables>
    <MetaDataVersion OID="MDV.A" Name="SDTM MDV" def:DefineVersion="2.0.0"
                     def:StandardName="SDTM-IG" def:StandardVersion="3.1.2">
      <def:AnnotatedCRF>
        <def:DocumentRef leafID="LF.ACRF"/>
      </def:AnnotatedCRF>
      <ItemGroupDef OID="IG.A1" Name="DM" Domain="DM" Repeating="No"
                    SASDatasetName="DM" Purpose="Tabulation"
                    def:Structure="One record per subject"
                    def:Class="SPECIAL PURPOSE"
                    def:ArchiveLocationID="LF.DM">
        <Description>
          <TranslatedText xml:lang="en">Demographics</TranslatedText>
        </Description>
        <ItemRef ItemOID="IT.A.USUBJID" OrderNumber="1" Mandatory="Yes" KeySequence="1"/>
        <def:leaf ID="LF.DM" xlink:href="dm.xpt">
          <def:title>dm.xpt</def:title>
        </def:leaf>
      </ItemGroupDef>
      <!-- DD0045 (2.0 leg): SDTM-IG document, dataset without Domain -->
      <ItemGroupDef OID="IG.A45" Name="AE" Repeating="Yes"
                    SASDatasetName="AE" Purpose="Tabulation"
                    def:Structure="One record per event"
                    def:Class="EVENTS"
                    def:ArchiveLocationID="LF.AE">
        <Description>
          <TranslatedText xml:lang="en">Adverse Events</TranslatedText>
        </Description>
        <ItemRef ItemOID="IT.A.USUBJID" OrderNumber="1" Mandatory="Yes" KeySequence="1"/>
        <def:leaf ID="LF.AE" xlink:href="ae.xpt">
          <def:title>ae.xpt</def:title>
        </def:leaf>
      </ItemGroupDef>
      <!-- DD0054 (2.0 leg): neither a def:Class attribute nor a def:Class child -->
      <ItemGroupDef OID="IG.A54" Name="VS" Domain="VS" Repeating="Yes"
                    SASDatasetName="VS" Purpose="Tabulation"
                    def:Structure="One record per measurement"
                    def:ArchiveLocationID="LF.VS">
        <Description>
          <TranslatedText xml:lang="en">Vital Signs</TranslatedText>
        </Description>
        <ItemRef ItemOID="IT.A.USUBJID" OrderNumber="1" Mandatory="Yes" KeySequence="1"/>
        <def:leaf ID="LF.VS" xlink:href="vs.xpt">
          <def:title>vs.xpt</def:title>
        </def:leaf>
      </ItemGroupDef>
      <ItemDef OID="IT.A.USUBJID" Name="USUBJID" DataType="text" Length="20"
               SASFieldName="USUBJID">
        <Description>
          <TranslatedText xml:lang="en">Unique Subject Identifier</TranslatedText>
        </Description>
        <def:Origin Type="CRF">
          <def:DocumentRef leafID="LF.ACRF">
            <def:PDFPageRef Type="PhysicalRef" PageRefs="10"/>
          </def:DocumentRef>
        </def:Origin>
      </ItemDef>
      <!-- DD0035 (2.0 leg): Origin Type='CRF' whose DocumentRef has no def:PDFPageRef -->
      <ItemDef OID="IT.A35" Name="AETERM" DataType="text" Length="200"
               SASFieldName="AETERM">
        <Description>
          <TranslatedText xml:lang="en">Reported Term for the Adverse Event</TranslatedText>
        </Description>
        <def:Origin Type="CRF">
          <def:DocumentRef leafID="LF.ACRF"/>
        </def:Origin>
      </ItemDef>
      <!-- DD0111 (2.0 leg): pages provided although the origin is not 'CRF' -->
      <ItemDef OID="IT.A111" Name="AGE" DataType="integer" Length="3" SASFieldName="AGE">
        <Description>
          <TranslatedText xml:lang="en">Age</TranslatedText>
        </Description>
        <def:Origin Type="Derived">
          <def:DocumentRef leafID="LF.ACRF">
            <def:PDFPageRef Type="PhysicalRef" PageRefs="4"/>
          </def:DocumentRef>
        </def:Origin>
      </ItemDef>
      <!-- DD0087 (2.0 leg): ARM block in an SDTM-IG define.xml -->
      <arm:AnalysisResultDisplays>
        <arm:ResultDisplay OID="RD.A" Name="Table 14-1.01">
          <Description>
            <TranslatedText xml:lang="en">Misplaced analysis display</TranslatedText>
          </Description>
          <arm:AnalysisResult OID="AR.A" AnalysisReason="SPECIFIED IN SAP"
                              AnalysisPurpose="SUPPORTIVE">
            <Description>
              <TranslatedText xml:lang="en">Misplaced analysis</TranslatedText>
            </Description>
            <arm:AnalysisDatasets>
              <arm:AnalysisDataset ItemGroupOID="IG.A1">
                <arm:AnalysisVariable ItemOID="IT.A.USUBJID"/>
              </arm:AnalysisDataset>
            </arm:AnalysisDatasets>
          </arm:AnalysisResult>
        </arm:ResultDisplay>
      </arm:AnalysisResultDisplays>
      <def:leaf ID="LF.ACRF" xlink:href="acrf.pdf">
        <def:title>Annotated CRF</def:title>
      </def:leaf>
    </MetaDataVersion>
    <MetaDataVersion OID="MDV.B" Name="ADaM MDV" def:DefineVersion="2.0.0"
                     def:StandardName="ADaM-IG" def:StandardVersion="1.0">
      <!-- DD0046 (2.0 leg): ADaM-IG document, dataset WITH Domain -->
      <ItemGroupDef OID="IG.B46" Name="ADSL" Domain="AD" Repeating="No"
                    SASDatasetName="ADSL" Purpose="Analysis"
                    def:Structure="One record per subject"
                    def:Class="SUBJECT LEVEL ANALYSIS DATASET"
                    def:ArchiveLocationID="LF.ADSL">
        <Description>
          <TranslatedText xml:lang="en">Subject Level Analysis Dataset</TranslatedText>
        </Description>
        <ItemRef ItemOID="IT.B.TRTP" OrderNumber="1" Mandatory="Yes" KeySequence="1"/>
        <def:leaf ID="LF.ADSL" xlink:href="adsl.xpt">
          <def:title>adsl.xpt</def:title>
        </def:leaf>
      </ItemGroupDef>
      <ItemDef OID="IT.B.TRTP" Name="TRTP" DataType="text" Length="20"
               SASFieldName="TRTP">
        <Description>
          <TranslatedText xml:lang="en">Planned Treatment</TranslatedText>
        </Description>
        <def:Origin Type="Assigned"/>
      </ItemDef>
    </MetaDataVersion>
  </Study>
</ODM>
