<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.cumba</groupId>
        <artifactId>cumba-oss-cdisc-rules-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>cumba-oss-cdisc-rules</artifactId>
    <packaging>jar</packaging>

    <inceptionYear>2026</inceptionYear>

    <properties>
        <!--
            Where the build generates the two shipped corpora. ONE definition, read by three
            places: the exec bindings that write them, the surefire properties that tell the
            tests where to look (CorpusPaths), and dist/*-dist's assembly fileSets.
            Under target/, so `mvn clean` wipes them and nothing generated is ever committed
            (PLAN-rules-corpus-build-integration D1).
        -->
        <corej.corpus.dir>${project.build.directory}/rules</corej.corpus.dir>
        <corej.define.corpus.dir>${project.build.directory}/rules-define</corej.define.corpus.dir>

        <!--
            DO NOT DEPLOY THIS MODULE'S JAR (PLAN-rules-corpus-build-integration §5).

            The module is test-only: no src/main, so the jar is ~1 KB of nothing. The
            deliverable is the corpus, and it ships through dist/corej-cdisc-rules-dist.
            Nothing declares a Maven dependency on this artifact except coverage/main (the
            reactor aggregator) and, for the reactor edge alone, the two dist modules — all
            of them inside the reactor, none of them from a repository.

            ⛔⛔ SUPPRESS PUBLICATION, NOT THE JAR ITSELF. Keep packaging=jar and let the
            empty jar be built. Binding default-jar to <phase>none</phase>, or setting
            maven-jar-plugin's skipIfEmpty, makes `mvn install` fail outright —
            "The packaging plugin for project ... did not assign a file to the build
            artifact" — and it fails LATE: a scoped `verify` still passes, so it would
            surface at release time. Switching to packaging=pom is worse still: pom packaging
            binds no compile and no test, so this module's ENTIRE test tree (11 500+ tests)
            would silently stop running and the build would go green having executed nothing.
        -->
        <maven.deploy.skip>true</maven.deploy.skip>

        <mockito.agent>-javaagent:${org.mockito:mockito-core:jar}</mockito.agent>
        <!--
            Inherited from corej-cdisc-core-rulespec when it was folded into this module.
            MUST stay on ONE physical line: Plexus' ArrayList converter splits on commas
            without trimming, and pitest's Glob matches literally, so XML indentation before
            patterns 2..N silently neutralises them (see the parent pom's note).
        -->
        <pitest.excludedTestClasses>net.cumba.cdisc.core.rulespec.RuleExecutionSpecTest,net.cumba.cdisc.core.rulespec.DefineItemMetadataSpecTest</pitest.excludedTestClasses>
    </properties>
    <description>
        The CDISC rule corpus and everything keyed to a rule's Core.Id:
        the rules-src/ authoring source, the generated native rules/
        packages, the offline generation pipeline (RuleExprGenerator,
        RulePackageConverter and friends), the .cdt scenario suites
        (net.cumba.cdisc.core.ruletestsuites) and the spec-driven
        execution suite (rulespec/ + net.cumba.cdisc.core.rulespec).

        TEST-ONLY: this module has no src/main and its jar is empty. The
        deliverable is the corpus, shipped by dist/corej-cdisc-rules-dist.
        The engine (corej-cdisc-core) never depends on this module.

        Absorbed corej-cdisc-core-ruletest-suites and
        corej-cdisc-core-rulespec on 2026-09-01
        (PLAN-rules-module-consolidation); both were test-only modules that
        reached this one's corpus by filesystem path.
    </description>

    <dependencies>

        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-cdisc-core</artifactId>
        </dependency>

        <!--
            Datatable test helpers (MockTable, TestMetadataFixtures) for the corpus tests.

            This REPLACES the corej-cdisc-core test-jar dependency, deleted on
            2026-09-01 (plans/done/PLAN-corej-restructure.md section 4). That dependency reached FOUR
            cdisc-core test classes across the module boundary, not the two its own comment
            named: MockTable and TestMetadataFixtures by import, StubMetadataProvider
            fully-qualified, and the package-private SyntheticStringTable through a split
            package. The first two became this published testkit; the other two are copied into
            this module's own test tree (see the COPY headers on each).

            ⚠⚠ A test-jar packages target/test-CLASSES, which carries RESOURCES too — so an
            inventory of classes is not an inventory of what the dependency supplied. This one
            also carried junit-platform.properties and
            META-INF/services/org.junit.jupiter.api.extension.Extension, which together register
            CompiledProgramCacheIsolationExtension. Losing them was SILENT (both went at once, so
            no ServiceConfigurationError) and cost mutation attribution, not correctness. All
            three are now copied into this module; see the header on the extension.
        -->
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable-testkit</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable</artifactId>
        </dependency>

        <!-- FindingsSnapshot (documentation/findings-snapshot.tsv): the study-level run over
             testdata/study reads Dataset-JSON through the local manager, exactly as the CLI and
             REST runs do. Test scope: the snapshot is a documentation tool, not shipped code. -->
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable-manager-local</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable-provider-dsj</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Folded in from corej-cdisc-core-ruletest-suites and corej-cdisc-core-rulespec.
             All test scope: this module has no src/main. -->
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-datatable-impl</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The .cdt rule-test harness the ruletestsuites factories drive. -->
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-cdisc-core-ruletest</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Define-XML metadata for the .cdt fixtures. -->
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-cdisc-define</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- The Define-XML conformance model (ConformanceRule, CheckDefinition,
             DefineRulePackage). The offline generator under rules-define-src/ parses the
             authored YAML into these types and serialises them into rules-define/, so the
             packaged form is produced by the same annotations the engine reads it with.

             ONE DIRECTION ONLY: corej-define-conformance must never depend on this module.
             It would be a reactor cycle, and it is why the corpus-driven Define-XML tests
             live here rather than there (PLAN-rules-module-consolidation D12/D13). -->
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-cdisc-define-conformance</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JSpecify nullability annotations (NullAway). -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <!-- Lombok (@CustomLog in the tooling classes). -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Apache POI, TEST scope only: the rule-corpus workbook readers
             (ShippedSourceBlockMatchesWorkbookTest,
             ShippedSendSourceBlockMatchesWorkbookTest, OriginalTextBackfill,
             StandardsLinkageBackfill, StandardsMembershipOracle and their tests) parse
             the shipped .xlsx rule sources. No main source in this module touches POI.

             ⚠ Declared explicitly since Fix #224. It used to arrive transitively
             through corej-cdisc-core, which carried poi-ooxml for the XLSX report
             writer; that writer moved to corej-cdisc-report-xlsx and the engine's
             POI dependency was deleted, so this module's test compile broke. A
             module that names a package must declare the dependency that provides
             it - inheriting it from an unrelated consumer's transitive is what made
             this an invisible coupling in the first place. -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- JSON-Schema validation of the shipped rule packages against
             documentation/rule-format.schema.json (RuleFormatSchemaTest). -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                GENERATE BOTH SHIPPED CORPORA, EVERY BUILD.

                Until PLAN-rules-corpus-build-integration these two generators ran only from
                scripts/regen-*.sh and their 80 MB of output was committed. Now the build
                produces them into target/, they are gitignored, and a packaging change that
                alters a rule shows up as a failing test instead of a silent diff.

                WHY process-test-classes. Both generators are main() classes in src/test/java
                (jackson-dataformat-yaml and the Define-XML model are test-scoped, so neither
                may leak into a shipped jar). The binding therefore has to sit after
                test-compile and before test — process-test-classes is the only phase between
                them. Generation is a few seconds, so it is unconditional: no skip flag.

                WHY exec:exec AND NOT exec:java. exec:java runs inside the Maven JVM, whose
                working directory is wherever `mvn` was launched — the repo root for any normal
                invocation. Both generators resolve their SOURCE relative to the CWD
                (PackageStandardsMap.load(Path.of("")), DefineRuleCorpusGenerator.SOURCE), so
                exec:java would read rules-src/ from the repo root and find nothing. exec:exec
                honours <workingDirectory>, and forking also keeps the generators off Maven's
                own classloader.

                ⚠ This is a pom binding, not a script, so CorpusGenScriptGuardTest does not see
                it — that test walks scripts/ only (SCRIPTS = Path.of("scripts")). The
                stale-engine hazard it guards against does not arise here either: the reactor
                has just compiled this tree's classes and <classpath/> is that reactor
                classpath, never ~/.m2.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${plugin.exec-maven-plugin.version}</version>
                <configuration>
                    <executable>${java.home}/bin/java</executable>
                    <workingDirectory>${project.basedir}</workingDirectory>
                    <classpathScope>test</classpathScope>
                </configuration>
                <executions>
                    <execution>
                        <id>generate-rule-corpus</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath />
                                <argument>net.cumba.cdisc.core.expr.convert.RuleCorpusGenerator</argument>
                                <argument>${corej.corpus.dir}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-define-rule-corpus</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath />
                                <argument>net.cumba.cdisc.define.conformance.gen.DefineRuleCorpusGenerator</argument>
                                <argument>${corej.define.corpus.dir}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        Override the project-wide target/test-cwd setting back to the module
                        basedir: the corpus tests and generator tools resolve rules-src/,
                        rulespec/ and documentation/ via module-relative paths.

                        ⚠ It no longer covers the GENERATED corpus. rules/ and rules-define/
                        used to be module-relative too, which is why this override's original
                        comment named them; they now live under target/ and every consumer
                        resolves them through CorpusPaths, off the two properties below. The
                        override is still load-bearing for the SOURCE trees — do not remove it.
                    -->
                    <workingDirectory>${project.basedir}</workingDirectory>
                    <systemPropertyVariables>
                        <corpusDir>${corej.corpus.dir}</corpusDir>
                        <defineCorpusDir>${corej.define.corpus.dir}</defineCorpusDir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
