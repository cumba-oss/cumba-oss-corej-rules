#!RuleTest
#test PMDA-AD0682 expect=violation domain=ADDL
#note "Mirror of PMDA-AD0681: key MODELG1, target MODELG1N. Group M100 holds {1 x2, 2 x1} -> the minority row fires."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=003 MODELG1=M100 MODELG1N=2
dataset ADDL
col STUDYID   type=Char
col USUBJID   type=Char
col SPDEVID   type=Char
col MODELG1   type=Char
col MODELG1N  type=Num
---
S1 | 001 | DEV01 | M100 | 1
S1 | 002 | DEV01 | M100 | 1
S1 | 003 | DEV02 | M100 | 2
---
