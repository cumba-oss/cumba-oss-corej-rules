#!RuleTest
#test PMDA-AD0611 expect=violation domain=ADAE
#note "OCCDS arm of the Include, pinned here once for the family. Row 1: driver APHASEN=1 -> ADSL.PH1EDT=23100, PHEDT 23110 != 23100 -> fires. Row 2: equal -> silent. Join ADSL on Keys=[USUBJID], loader-default inner, 1:1."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 APHASEN=1 PHEDT=23110
dataset ADAE structure=OCCDS
col STUDYID  type=Char
col USUBJID  type=Char
col AEDECOD  type=Char
col APHASEN  type=Num
col PHEDT    type=Num
---
S1 | 01-701-1015 | HEADACHE | 1 | 23110
S1 | 01-701-1023 | NAUSEA   | 1 | 23100
---

dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col PH1EDT  type=Num
---
S1 | 01-701-1015 | 23100
S1 | 01-701-1023 | 23100
