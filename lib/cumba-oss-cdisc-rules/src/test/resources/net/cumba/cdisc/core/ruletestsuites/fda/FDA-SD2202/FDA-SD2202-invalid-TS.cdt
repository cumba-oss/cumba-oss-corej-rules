#!RuleTest
#test FDA-SD2202 expect=violation domain=TS
#note "TS carries other Trial Summary parameters but no record with TSPARMCD='AGEMAX'. FDA: \"'Planned Maximum Age of Subjects' (AGEMAX) record must be populated in Trial Summary (TS) domain.\" -> the AGEMAX parameter is missing, so the rule must fire exactly once for the dataset."
#library standard=sdtmig version=3-4
#expectViolationCount 1
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
col TSVALNF  type=Char label="Parameter Null Flavor"
---
CDISCPILOT01 | TS | 1 | TITLE  | Trial Title                | A Randomized Study of Drug X |
CDISCPILOT01 | TS | 2 | TPHASE | Trial Phase Classification | PHASE III TRIAL              |
