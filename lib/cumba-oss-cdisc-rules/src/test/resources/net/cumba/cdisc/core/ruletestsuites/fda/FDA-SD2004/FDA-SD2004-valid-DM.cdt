#!RuleTest
#test FDA-SD2004 expect=noViolation domain=DM
#note "The subject with a date of death is flagged DTHFL 'Y'; the surviving subject has neither."
#library standard=sdtmig version=3-4
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col DTHDTC  type=Char label="Date/Time of Death"
col DTHFL   type=Char label="Subject Death Flag"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015 | 2020-05-01 | Y
CDISCPILOT01 | DM | 01-701-1023 | 1023 |            | 
