#!RuleTest
#test CDISC-CG0006 expect=violation domain=LB
#note "FRESH - pins this rule's own sheet Rule ('a non-zero integer value'): the algorithm never yields 0. Row 1: LBDTC 2020-01-01 = RFSTDTC -> computed 1, LBDY=0 disagrees -> FIRES. Row 2: LBDTC 2019-12-31 -> computed -1, LBDY=-1 agrees -> clean (the boundary pair around the missing day 0)."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 LBDY=0
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test Short Name"
col LBDTC    type=Char label="Date/Time of Specimen Collection"
col LBDY     type=Num  label="Study Day of Specimen Collection"
---
S1 | LB | 001 | 1 | ALB | 2020-01-01 | 0
S1 | LB | 001 | 2 | ALB | 2019-12-31 | -1
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
---
S1 | DM | 001 | 2020-01-01
---
