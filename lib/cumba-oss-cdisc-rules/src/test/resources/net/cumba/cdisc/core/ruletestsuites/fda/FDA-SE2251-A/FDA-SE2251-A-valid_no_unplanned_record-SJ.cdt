#!RuleTest
#test FDA-SE2251-A expect=noViolation domain=SJ
#note "SJUPDES is absent but NO record has RSTGCD = UNPLAN, so the row's Condition never holds and the column is not required. Pins that the rule is conditioned on the data, not merely on the column being missing."
#library standard=sendig version=dart-1-1
dataset SJ label="Subject Stages" class="SPECIAL PURPOSE"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SJSEQ   type=Num  label="Sequence Number"
col RSTGCD  type=Char label="Repro Stage Code"
---
S1 | SJ | 001 | 1 | PLANNED
