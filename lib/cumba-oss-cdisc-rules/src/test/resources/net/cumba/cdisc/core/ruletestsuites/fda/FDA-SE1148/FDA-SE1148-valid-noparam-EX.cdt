#!RuleTest
#test FDA-SE1148 expect=noViolation domain=EX
#note "TS is present but carries no EXPSTDTC parameter, so the ts_parameter_value operand resolves to null and the date comparison cannot fire even though EXSTDTC 2019-01-01 would be earlier than any plausible experimental start. Documents the dependency-skip contract (no reference date -> no finding); the presence of EXPSTDTC in TS is a different rule's concern."
#library standard=sendig version=3-1-1
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
---
S1 | EX | 001 | 1 | DRUG A | 2019-01-01
---

dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL    type=Char label="Parameter Value"
---
S1 | TS | 1 | SSPONSOR | ACME LABS
