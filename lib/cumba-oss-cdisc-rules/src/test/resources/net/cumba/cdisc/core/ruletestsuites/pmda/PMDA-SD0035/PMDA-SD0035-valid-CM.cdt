#!RuleTest
#test PMDA-SD0035 expect=noViolation domain=CM
#note "ADAPTED-FROM fda/FDA-SD0035/FDA-SD0035-valid-CM.cdt. Every record that provides a dose (CMDOSE, CMDOSTXT or CMDOSTOT) also carries CMDOSU; the last record has no dose information, so its empty CMDOSU is conformant -> no violation."
#library standard=sdtmig version=3-4
dataset CM class=INTERVENTIONS label="Concomitant Medications"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col CMSEQ    type=Num  label="Sequence Number"
col CMTRT    type=Char label="Reported Name of Drug, Med, or Therapy"
col CMDOSE   type=Num  label="Dose per Administration"
col CMDOSTXT type=Char label="Dose Description"
col CMDOSU   type=Char label="Dose Units"
col CMDOSTOT type=Num  label="Total Daily Dose"
---
S1 | CM | 001 | 1 | ASPIRIN     | 100 |          | mg     |
S1 | CM | 001 | 2 | PARACETAMOL |     | 1 TABLET | TABLET |
S1 | CM | 001 | 3 | IBUPROFEN   |     |          | mg     | 600
S1 | CM | 001 | 4 | VITAMIN C   |     |          |        |
