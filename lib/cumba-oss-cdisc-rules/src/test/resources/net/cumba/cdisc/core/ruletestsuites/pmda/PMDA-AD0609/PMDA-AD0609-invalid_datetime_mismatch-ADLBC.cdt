#!RuleTest
#test PMDA-AD0609 expect=violation domain=ADLBC
#note "Row 1: driver APHASEN=1 -> ADSL.PH1SDTM=1987000000, PHSDTM 1987003600 != 1987000000 -> fires. Row 2: equal -> silent. Join ADSL on Keys=[USUBJID], loader-default inner, 1:1."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 APHASEN=1 PHSDTM=1987003600
dataset ADLBC structure=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVAL     type=Num
col APHASEN  type=Num
col PHSDTM   type=Num
---
S1 | 01-701-1015 | ALB | 30 | 1 | 1987003600
S1 | 01-701-1023 | ALB | 31 | 1 | 1987000000
---

dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col PH1SDTM type=Num
---
S1 | 01-701-1015 | 1987000000
S1 | 01-701-1023 | 1987000000
