#!RuleTest
#test PMDA-AD0658 expect=violation domain=ADNCA
#note "NCAXFN=2 populated and not 1 -> fires. NCAXFN=1 (only permitted populated value) -> silent. NCAXFN is Num/Perm in the ADaM NCA add-on, so type=Num on BOTH this and the valid fixture."
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015 NCAXFN=2
#library standard=adamig version=1-3
dataset ADNCA structure=BDS subclass=NCA
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col NCAXFN   type=Num
---
CDISCPILOT01 | 01-701-1015 | CONC | 2
CDISCPILOT01 | 01-701-1023 | CONC | 1
---
