#!RuleTest
#test CDISC-CG0423 expect=violation domain=EX
#note "Row 1 gives a treatment vehicle amount of 5 with an empty EXTRTV -> 'Treatment Vehicle (--TRTV) should be provided, when Treatment Vehicle Amount (--VAMT) is specified'."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 EXVAMT=5 EXTRTV=
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXTRTV  type=Char label="Treatment Vehicle"
col EXVAMT  type=Num  label="Treatment Vehicle Amount"
---
CDISCPILOT01 | EX | 01-701-1015 | 1 | DRUG A |        | 5
CDISCPILOT01 | EX | 01-701-1015 | 2 | DRUG A | SALINE | 10
