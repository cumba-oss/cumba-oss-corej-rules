#!RuleTest
#test FDA-SD2283 expect=violation domain=TS
#note "Row 1 spells the null flavor out ('Not Applicable') instead of using the ISO 21090 term 'NA' -> fires; row 2 is the conformant twin."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 TSVALNF="Not Applicable"
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL    type=Char label="Parameter Value"
col TSVALNF  type=Char label="Parameter Null Flavor"
---
CDISCPILOT01 | TS | 1 | PCLAS |  | Not Applicable
CDISCPILOT01 | TS | 2 | ADAPT |  | NA
