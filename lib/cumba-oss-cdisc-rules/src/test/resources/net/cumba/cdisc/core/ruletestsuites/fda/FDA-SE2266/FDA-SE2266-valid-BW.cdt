#!RuleTest
#test FDA-SE2266 expect=noViolation domain=BW
#note "Positive BWSTRESN, negative-but-excluded (BWEXCLFL=Y) and missing BWSTRESN rows -> no violation."
#library standard=sendig version=3-1-1
dataset BW class=FINDINGS label="Body Weight"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col BWSEQ    type=Num  label="Sequence Number"
col BWSTRESN type=Num  label="Numeric Result/Finding in Standard Units"
col BWEXCLFL type=Char label="Exclude from Statistics"
---
S1 | BW | 001 | 1 | 250.5 |
S1 | BW | 001 | 2 | -5    | Y
S1 | BW | 001 | 3 | .     |
