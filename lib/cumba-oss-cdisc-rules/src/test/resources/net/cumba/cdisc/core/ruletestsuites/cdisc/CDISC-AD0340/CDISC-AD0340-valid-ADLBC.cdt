#!RuleTest
#test CDISC-AD0340 expect=noViolation domain=ADLBC
# Rule:Description: Within a parameter, there is more than one value of MCRITyML for a given value of MCRITyMN, considering only those rows on which both variables are populated
#note "each MCRIT1MN value maps to a single MCRIT1ML value -> noViolation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col MCRIT1ML type=Char
col MCRIT1MN type=Char
---
CDISCPILOT01 | 01-701-1015 | GLUC | A1 | G
CDISCPILOT01 | 01-701-1015 | GLUC | A2 | H
---
