#!RuleTest
#test FDA-SD1126 expect=violation domain=VS
#note "The same --TPTNUM/--TPTREF/VISITNUM combination is named both '1H POST' and 'ONE HOUR POST', so --TPT is not constant for a given time-point key. Both records of the conflicting pair are reported."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 VSTPTNUM=1 VSTPT="1H POST"
#expectViolationAt row=2 VSTPTNUM=1 VSTPT="ONE HOUR POST"
dataset VS class=FINDINGS label="Vital Signs"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VSSEQ    type=Num  label="Sequence Number"
col VSTESTCD type=Char label="Vital Signs Test Short Name"
col VISITNUM type=Num  label="Visit Number"
col VSTPTREF type=Char label="Time Point Reference"
col VSTPTNUM type=Num  label="Planned Time Point Number"
col VSTPT    type=Char label="Planned Time Point Name"
col VSELTM   type=Char label="Planned Elapsed Time from Time Point Ref"
---
S1 | VS | 001 | 1 | SYSBP | 1 | DOSE | 1 | 1H POST       | PT1H
S1 | VS | 002 | 1 | SYSBP | 1 | DOSE | 1 | ONE HOUR POST | PT1H
S1 | VS | 001 | 2 | SYSBP | 1 | DOSE | 2 | 2H POST       | PT2H
