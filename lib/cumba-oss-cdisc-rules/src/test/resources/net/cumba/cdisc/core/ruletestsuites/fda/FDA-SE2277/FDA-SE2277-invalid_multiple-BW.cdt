#!RuleTest
#test FDA-SE2277 expect=violation domain=BW
#note "Two independently over-long variables (BWCOMMENT 250, BWNARR 201). Each variable's declared length is its own defect, so both must be reported."
#library standard=sendig version=3-1-1
#expectViolationCount 2
#expectViolationAt variable_name=BWCOMMENT
#expectViolationAt variable_name=BWNARR
dataset BW label="Body Weight"
col STUDYID   type=Char length=20  label="Study Identifier"
col USUBJID   type=Char length=40  label="Unique Subject Identifier"
col BWTESTCD  type=Char length=8   label="Test Short Name"
col BWCOMMENT type=Char length=250 label="Comment"
col BWNARR    type=Char length=201 label="Narrative"
---
S1 | 001 | BW | free text | narrative
