#!RuleTest
#test CDISC-CG0152 expect=violation domain=SE
#note "Row 2 is an unplanned element (ETCD='UNPLAN') yet ELEMENT is populated -> fires. Row 1 is a planned element; row 3 is a correctly blank unplanned element."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 ETCD=UNPLAN ELEMENT="Unscheduled Run-in"
dataset SE label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ   type=Num  label="Sequence Number"
col ETCD    type=Char label="Element Code"
col ELEMENT type=Char label="Description of Element"
col SESTDTC type=Char label="Start Date/Time of Element"
---
S1 | SE | 001 | 1 | SCRN   | Screening          | 2020-01-01
S1 | SE | 001 | 2 | UNPLAN | Unscheduled Run-in | 2020-01-10
S1 | SE | 001 | 3 | UNPLAN |                    | 2020-01-20
