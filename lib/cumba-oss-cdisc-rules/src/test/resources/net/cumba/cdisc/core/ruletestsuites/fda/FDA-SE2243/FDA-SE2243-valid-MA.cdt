#!RuleTest
#test FDA-SE2243 expect=noViolation domain=MA
#note "The CLSFUP (clinical signs follow-up) record carries no specimen material type, as required; the GROSPATH record does carry one but is outside this rule's condition."
#library standard=sendig version=3-1-1
dataset MA label="Macroscopic Findings"
col STUDYID  type=Char label="Study Identifier"
col USUBJID  type=Char label="Unique Subject Identifier"
col MASEQ    type=Num  label="Sequence Number"
col MATESTCD type=Char label="Macroscopic Examination Short Name"
col MATEST   type=Char label="Macroscopic Examination Name"
col MASTRESC type=Char label="Standardized Result in Character Format"
col MASPEC   type=Char label="Specimen Material Type"
---
S1 | 001 | 1 | CLSFUP   | Clinical Signs Follow-up       | NORMAL   |
S1 | 001 | 2 | GROSPATH | Gross Pathological Observation | ENLARGED | LIVER
