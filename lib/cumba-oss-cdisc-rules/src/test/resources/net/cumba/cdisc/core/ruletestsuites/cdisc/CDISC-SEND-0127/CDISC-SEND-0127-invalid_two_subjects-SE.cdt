#!RuleTest
#test CDISC-SEND-0127 expect=violation domain=SE
#note "DS JOIN-KEY DISCRIMINATOR. Two subjects, each 1:1 on the DS key. Each subject's last Element is compared against ITS OWN disposition date, not a study-wide one: row 2 has 2020-01-20 against 2020-01-15 and row 4 has 2020-02-25 against 2020-02-20, so the rule fires twice. Keep the DS side 1:1 -- a second DS record for either subject would row-expand the join and double that subject's findings."
#library standard=sendig version=3-0
#expectViolationCount 2
#expectViolationAt row=2 USUBJID=001 SESEQ=2
#expectViolationAt row=4 USUBJID=002 SESEQ=2
dataset SE label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ   type=Num  label="Sequence Number"
col ETCD    type=Char label="Element Code"
col SESTDTC type=Char label="Start Date/Time of Element"
col SEENDTC type=Char label="End Date/Time of Element"
---
S1 | SE | 001 | 1 | SCRN | 2020-01-01 | 2020-01-10
S1 | SE | 001 | 2 | TRT | 2020-01-10 | 2020-01-20
S1 | SE | 002 | 1 | SCRN | 2020-02-01 | 2020-02-10
S1 | SE | 002 | 2 | TRT | 2020-02-10 | 2020-02-25
---

dataset DS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSDECOD type=Char label="Standardized Disposition Term"
col DSSTDTC type=Char label="Start Date/Time of Disposition Event"
---
S1 | DS | 001 | 1 | TERMINAL SACRIFICE | 2020-01-15
S1 | DS | 002 | 1 | MORIBUND SACRIFICE | 2020-02-20
---
