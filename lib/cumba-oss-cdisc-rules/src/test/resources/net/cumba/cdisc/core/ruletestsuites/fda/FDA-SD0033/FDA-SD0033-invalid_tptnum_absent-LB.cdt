#!RuleTest
#test FDA-SD0033 expect=violation domain=LB
#note "LBTPTNUM is not present in the dataset while LBTPT is populated on row 1 -> the time point number is missing. Encodes the column-absent case: the Check carries a bare empty(--TPTNUM) leaf, which under absent = all-missing (EC-43) is TRUE on every row of a column that is not there. Plan B phase 4d' deleted the redundant not var_exists(--TPTNUM) disjunct that used to spell this out; the verdict is unchanged."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 LBTPT="1 HR POST"
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBTPT    type=Char label="Planned Time Point Name"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | GLUC | 1 HR POST
CDISCPILOT01 | LB | 01-701-1015 | 2 | GLUC |
