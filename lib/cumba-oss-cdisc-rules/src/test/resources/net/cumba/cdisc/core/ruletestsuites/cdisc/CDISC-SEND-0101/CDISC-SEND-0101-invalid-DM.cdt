#!RuleTest
#test CDISC-SEND-0101 expect=violation domain=DM
#note "Mirror of CDISC-SEND-0100-invalid-DM with RFENDTC instead of RFSTDTC: define declares STUDYID/USUBJID only."
#library standard=sendig version=3-1-1
#define variable-metadata DM STUDYID name=STUDYID label="Study Identifier"
#define variable-metadata DM USUBJID name=USUBJID label="Unique Subject Identifier"
#expectViolationCount 1
#expectViolationAt variable_name=RFENDTC
dataset DM
col STUDYID type=Char
col USUBJID type=Char
col RFENDTC type=Char
---
S1 | S1-001 | 2020-06-30
