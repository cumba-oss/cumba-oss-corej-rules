#!RuleTest
#test PMDA-SD1243 expect=violation domain=AE
#note "The body system 'Nervous system disorders' is coded once as 10029205 and once as 10029206, so --BDSYCD is not constant for a given --BODSYS. Both records of the conflicting pair are reported."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 AEBODSYS="Nervous system disorders" AEBDSYCD=10029205
#expectViolationAt row=2 AEBODSYS="Nervous system disorders" AEBDSYCD=10029206
dataset AE class=EVENTS label="Adverse Events"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col AESEQ    type=Num  label="Sequence Number"
col AETERM   type=Char label="Reported Term for the Adverse Event"
col AEBODSYS type=Char label="Body System or Organ Class"
col AEBDSYCD type=Num  label="Body System or Organ Class Code"
---
S1 | AE | 001 | 1 | HEADACHE | Nervous system disorders | 10029205
S1 | AE | 002 | 1 | DIZZINESS | Nervous system disorders | 10029206
S1 | AE | 001 | 2 | NAUSEA | Gastrointestinal disorders | 10017947
