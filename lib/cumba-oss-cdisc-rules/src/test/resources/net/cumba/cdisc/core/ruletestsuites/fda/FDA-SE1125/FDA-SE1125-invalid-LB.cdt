#!RuleTest
#test FDA-SE1125 expect=violation domain=LB
#note "The time point '1H POST' of reference 'DOSE 1' in category CHEMISTRY carries two different planned elapsed times (PT1H and PT60M), so --ELTM is not constant for a given --TPT/--TPTREF/--CAT combination. Both records of the conflicting pair are reported. --SCAT is not collected in this dataset, so the key drops it ('if present')."
#library standard=sendig version=3-1-1
#expectViolationCount 2
#expectViolationAt row=1 LBTPT="1H POST" LBELTM=PT1H
#expectViolationAt row=2 LBTPT="1H POST" LBELTM=PT60M
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBCAT    type=Char label="Category for Lab Test"
col LBTPTREF type=Char label="Time Point Reference"
col LBTPT    type=Char label="Planned Time Point Name"
col LBELTM   type=Char label="Planned Elapsed Time from Time Point Ref"
---
S1 | LB | 001 | 1 | ALB | CHEMISTRY | DOSE 1 | 1H POST | PT1H
S1 | LB | 002 | 1 | ALB | CHEMISTRY | DOSE 1 | 1H POST | PT60M
S1 | LB | 003 | 1 | ALB | CHEMISTRY | DOSE 1 | 2H POST | PT2H
