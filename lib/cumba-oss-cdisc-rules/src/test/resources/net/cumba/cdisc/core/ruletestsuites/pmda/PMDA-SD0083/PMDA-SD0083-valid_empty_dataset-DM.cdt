#!RuleTest
#test PMDA-SD0083 expect=noViolation domain=DM
#note "EMPTY-DATASET PIN. Full column block declared and ZERO data rows. PREDICTED SILENT: rowBased is TRUE so the row loop runs zero times, and uniqueSetViolations early-returns on rowCount <= 0 in any case."
#library standard=sdtmig version=3-4
#expectViolationCount 0
dataset DM class="SPECIAL PURPOSE"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
---
