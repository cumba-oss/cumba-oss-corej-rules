#!RuleTest
#test PMDA-AD0324 expect=noViolation domain=ADLBC
#note "APHASEN absent. Data would fire under the degraded key (whole table becomes one group, EC-44/Fix #134), but the rule is silent because `not empty(APHASEN)` is broadcast FALSE over an absent column - not because the leading var_exists(APHASEN) is inert here (finding AD0324-F2)."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col APHASE  type=Char
