#!RuleTest
#test PMDA-SD1135 expect=noViolation domain=EX
#note "Boundary: study day 1 is the smallest valid value and 0 is not negative, so neither branch fires; row 3 leaves both study days missing."
#library standard=sdtmig version=3-4
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDY  type=Num  label="Study Day of Start of Treatment"
col EXENDY  type=Num  label="Study Day of End of Treatment"
---
S1 | EX | 001 | 1 | DRUG A | 1 | 7
S1 | EX | 001 | 2 | DRUG A | 0 | 0
S1 | EX | 001 | 3 | DRUG A | . | .
