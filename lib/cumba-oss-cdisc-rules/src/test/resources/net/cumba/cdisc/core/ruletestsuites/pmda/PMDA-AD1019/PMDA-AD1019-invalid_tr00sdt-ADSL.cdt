#!RuleTest
#test PMDA-AD1019 expect=violation domain=ADSL
#note "TR00SDT matches ^(TR|AP)..(SDT|...)$ and fails ^(TR|AP)(0[1-9]|[1-9][0-9])(SDT|...)$ -> fires; TR01SDT satisfies both. Values are arbitrary - the rule reads names only."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt variable_name=TR00SDT
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col TR00SDT type=Num
col TR01SDT type=Num
