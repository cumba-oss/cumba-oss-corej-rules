#!RuleTest
#test PMDA-SD0020 expect=violation domain=TS
#note "TSPARMCD on row 2 is 9 characters, one past the 8-character limit -> fires; the 8-character row 1 is the passing boundary."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 TSPARMCD=PLANSUBJS
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
---
S1 | TS | 1 | PLANSUBJ | Planned Number of Subjects
S1 | TS | 2 | PLANSUBJS | Planned Number of Subjects Screened
