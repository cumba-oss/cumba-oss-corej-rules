#!RuleTest
#test FDA-SE2267 expect=violation domain=TS
#note "No TSPARMCD=STRPSTAT record anywhere in TS -> the 'Study Report Status' parameter is missing, one dataset-level finding. STCAT / STDIR are present as near-miss ST* parameters so a partial match on the filter would wrongly silence the rule."
#library standard=sendig version=3-1-1
#expectViolationCount 1
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | STCAT | Study Category | TOXICOLOGY
S01 | TS | 2 | STDIR | Study Director | Jane Doe
S01 | TS | 3 | STITLE | Study Title | 28-Day Repeat Dose Toxicity Study
