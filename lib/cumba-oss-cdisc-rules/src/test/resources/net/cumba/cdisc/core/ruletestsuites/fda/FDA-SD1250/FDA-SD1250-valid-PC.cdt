#!RuleTest
#test FDA-SD1250 expect=noViolation domain=PC
#note "PCTPT present and PCTPTNUM also present -> conformant."
#library standard=sdtmig version=3-4
dataset PC class=FINDINGS label="Pharmacokinetic Concentrations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PCSEQ    type=Num  label="Sequence Number"
col PCTESTCD type=Char label="Pharmacokinetic Test Short Name"
col PCTPT    type=Char label="Planned Time Point Name"
col PCTPTNUM type=Num  label="Planned Time Point Number"
---
CDISCPILOT01 | PC | 01-701-1015 | 1 | DRUGA | 1H POST-DOSE | 1
---
