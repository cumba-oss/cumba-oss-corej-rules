#!RuleTest
#test FDA-SD1029 expect=violation domain=LB
#note "Row 2 LBTEST carries a micro sign (U+00B5), outside the printable ASCII range 32-126. LBORRES on row 3 also carries it but is NOT one of the name/label-convertible variables, so only LBTEST is reported."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 variable_name=LBTEST
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBTEST   type=Char label="Lab Test or Examination Name"
col LBORRES  type=Char label="Result or Finding in Original Units"
---
CDISCPILOT01 | LB | 01-701-1015 | ALB  | Albumin              | 40
CDISCPILOT01 | LB | 01-701-1015 | GLUC | Glucose µmol        | 5.5
CDISCPILOT01 | LB | 01-701-1015 | CREA | Creatinine           | 60 µmol/L
