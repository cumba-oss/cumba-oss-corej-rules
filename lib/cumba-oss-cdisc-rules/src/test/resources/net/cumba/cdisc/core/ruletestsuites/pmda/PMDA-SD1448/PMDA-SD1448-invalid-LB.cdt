#!RuleTest
#test PMDA-SD1448 expect=violation domain=LB
#note "CL-A A.12 (wave TA-4): the hand-authored numeric regex became the native is_numeric predicate FDA/CORE already use. Row 1: LBSTRESC 'BLQ' is not numeric yet LBSTRESN is populated -> fires. Row 2: scientific notation '1.23E-4' was numeric under the replaced regex but is REJECTED by is_numeric, so a populated LBSTRESN now fires here too (probe delta of record, resolution toward is_numeric by ruling). Row 3 is a conformant numeric pair."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 LBSTRESC=BLQ
#expectViolationAt row=2 LBSTRESC=1.23E-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBSTRESC type=Char label="Character Result/Finding in Std Format"
col LBSTRESN type=Num  label="Numeric Result/Finding in Standard Units"
---
S1 | LB | 001 | 1 | HCG  | BLQ     | 0.1
S1 | LB | 001 | 2 | TSH  | 1.23E-4 | 0.000123
S1 | LB | 001 | 3 | GLUC | 5.5     | 5.5
