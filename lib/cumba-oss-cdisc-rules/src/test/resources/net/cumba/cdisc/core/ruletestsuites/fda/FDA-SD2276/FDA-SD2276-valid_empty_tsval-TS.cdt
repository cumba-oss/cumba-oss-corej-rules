#!RuleTest
#test FDA-SD2276 expect=noViolation domain=TS
#note "The TSPARMCD=PDPSTIND record is present but its TSVAL is empty. The rule counts parameter RECORDS, not populated values (the sheet's 'must be populated' means the parameter row must exist; an empty TSVAL is TSVALNF/other rules' business) -> no violation."
#library standard=sdtmig version=3-4
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | PDPSTIND | Pediatric Postmarket Study Indicator | 
S01 | TS | 2 | TITLE | Trial Title | A Study of Drug X in Condition Y
S01 | TS | 3 | TPHASE | Trial Phase Classification | PHASE III TRIAL
