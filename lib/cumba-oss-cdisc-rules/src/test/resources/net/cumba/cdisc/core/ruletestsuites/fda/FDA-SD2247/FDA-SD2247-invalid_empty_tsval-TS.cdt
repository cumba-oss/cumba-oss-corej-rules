#!RuleTest
#test FDA-SD2247 expect=violation domain=TS
#note "Boundary: empty TSVAL on an SSTDTC record. The sheet text grants no null exemption ('TSVAL variable value must be in ISO 8601 format, when TSPARMCD=SSTDTC') and SSTDTC is a required trial-summary parameter, so an unpopulated study start date is flagged. This scenario pins that intent; it would go green if a non_empty leaf were added to the Check."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 TSPARMCD=SSTDTC TSVAL=
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
CDISCPILOT01 | TS | 1 | SSTDTC  | Study Start Date |
CDISCPILOT01 | TS | 1 | DCUTDTC | Data Cutoff Date | 2020-06-30
