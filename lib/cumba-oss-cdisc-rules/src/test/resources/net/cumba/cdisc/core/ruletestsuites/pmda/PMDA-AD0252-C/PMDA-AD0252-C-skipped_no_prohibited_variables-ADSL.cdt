#!RuleTest
#test PMDA-AD0252-C expect=skipped domain=ADSL
#note "A conformant ADSL carrying neither prohibited variable: nothing matches AVALCA<y>N or BASECA<y>N, so WildcardExpander returns NoMatch and the rule does not execute. Negative control - this rule has no noViolation state, because any expansion that exists was seeded by a match, and that match already makes the disjunction true."
#library standard=adamig version=1-3
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col AGE     type=Num
col SEX     type=Char
col SAFFL   type=Char
---
CDISCPILOT01 | 01-701-1015 | 56 | F | Y
CDISCPILOT01 | 01-701-1023 | 64 | M | Y
