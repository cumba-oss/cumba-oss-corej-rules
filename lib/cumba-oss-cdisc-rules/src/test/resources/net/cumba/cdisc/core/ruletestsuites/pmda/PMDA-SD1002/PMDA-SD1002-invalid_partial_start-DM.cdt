#!RuleTest
#test PMDA-SD1002 expect=violation domain=DM
#note "FRESH. Row 1: the whole of May is before 30 June, so this row is SILENT. Row 2: every candidate day in July is after 30 June, so the universally-quantified test lower(A) > upper(B) holds and this row FIRES. Pins the Q16 hull rule (IsoDateComparison: 'A op B means A op EVERY candidate of B', with both hulls clipped to a common precision of at least DAY_PRECISION). No twin of this rule carries a partial date at all."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 RFSTDTC=2020-07 RFENDTC=2020-06-30
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SUBJID   type=Char label="Subject Identifier for the Study"
col RFSTDTC  type=Char label="Subject Reference Start Date/Time"
col RFENDTC  type=Char label="Subject Reference End Date/Time"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015 | 2020-05 | 2020-06-30
CDISCPILOT01 | DM | 01-701-1023 | 1023 | 2020-07 | 2020-06-30
