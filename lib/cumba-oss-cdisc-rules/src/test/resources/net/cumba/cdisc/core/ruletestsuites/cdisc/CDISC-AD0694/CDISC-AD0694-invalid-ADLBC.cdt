#!RuleTest
#test CDISC-AD0694 expect=violation domain=ADLBC
# Rule:Description: Within a given value of PARAMCD for a combination of device and subject, there is more than one value of BASEC for a given value of BASE, considering only those rows on which both variables are populated
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015
#expectViolationAt row=2 USUBJID=01-701-1015
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col SPDEVID type=Char
col PARAMCD type=Char
col BASEC type=Char
col BASE type=Char
