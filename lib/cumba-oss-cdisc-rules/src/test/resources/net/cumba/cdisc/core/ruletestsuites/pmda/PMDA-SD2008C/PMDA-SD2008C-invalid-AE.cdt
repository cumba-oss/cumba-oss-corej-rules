#!RuleTest
#test PMDA-SD2008C expect=violation domain=AE
#note "AELLT 'DIARRHOEA' is a valid Lowest Level Term but not in MedDRA's preferred case ('Diarrhoea') -> the case-sensitive check fires on row 2; row 1 matches exactly."
#library standard=sdtmig version=3-4
#dictionaries dummy
#expectViolationCount 1
#expectViolationAt row=2 AELLT=DIARRHOEA
dataset AE
col USUBJID type=Char
col AELLT   type=Char
---
001 | Diarrhoea
001 | DIARRHOEA
