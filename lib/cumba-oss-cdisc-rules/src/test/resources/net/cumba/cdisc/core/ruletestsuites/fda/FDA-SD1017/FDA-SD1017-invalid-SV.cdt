#!RuleTest
#test FDA-SD1017 expect=violation domain=SV
#note "Row 3 is a planned visit (SVUPDES empty) whose VISITNUM 3 is not declared in TV -> fires. Row 1 matches TV; row 2 is an unplanned visit (SVUPDES populated) so its unknown VISITNUM 99 is exempt."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=002 VISITNUM=3
dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col SVSTDTC  type=Char label="Start Date/Time of Visit"
col SVUPDES  type=Char label="Description of Unplanned Visit"
---
CDISCPILOT01 | SV | 001 | 1 | SCREENING | 2020-01-01 |
CDISCPILOT01 | SV | 001 | 99 | UNSCHEDULED | 2020-01-15 | Unplanned safety follow-up
CDISCPILOT01 | SV | 002 | 3 | WEEK 4 | 2020-02-01 |
---

dataset TV label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | TV | 1 | SCREENING
CDISCPILOT01 | TV | 2 | BASELINE
---
