#!RuleTest
#test CDISC-AD0583 expect=violation domain=ADLBC
# Rule:Description: Within a given value of PARAMCD, there is more than one value of BCHGCATy for a given value of BCHG and y, where y is an integer [1-99, not zero-padded]
#note "BCHG=K1 maps to two distinct BCHGCAT1 values -> violation"
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015
#expectViolationAt row=2 USUBJID=01-701-1023
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col BCHGCAT1 type=Char
col BCHG type=Char
---
CDISCPILOT01 | 01-701-1015 | ALB | A1 | K1
CDISCPILOT01 | 01-701-1023 | ALB | A2 | K1
---
