#!RuleTest
#test PMDA-SD0004-A expect=skipped domain=LB
#note "Pins that this rule owns ONLY Associated Persons datasets: name LB is not four characters starting AP, and its base (DOMAIN='LB') is not either, so the rule does not execute -> SKIPPED: domain LB not in Scope.Domains.Include [AP--]."
#library standard=sdtmig version=3-4
dataset LB
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB
