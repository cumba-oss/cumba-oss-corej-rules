#!RuleTest
#test CDISC-AD0154 expect=violation domain=ADLBC
# Rule:Description: Within a given PARAMCD and BASETYPE for a subject, more than one record has ABLFL equal to Y
#note "two ABLFL=Y records in the group -> count > 1 -> violation"
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col BASETYPE type=Char
col ABLFL type=Char
---
CDISCPILOT01 | 01-701-1015 | GLUC | LAST | Y
CDISCPILOT01 | 01-701-1015 | GLUC | LAST | Y
---
