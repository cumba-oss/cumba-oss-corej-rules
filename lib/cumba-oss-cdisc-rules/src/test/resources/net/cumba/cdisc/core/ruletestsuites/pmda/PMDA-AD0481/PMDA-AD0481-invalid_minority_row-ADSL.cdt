#!RuleTest
#test PMDA-AD0481 expect=violation domain=ADSL
#note "Mirror of PMDA-AD0480: key STRAT1V, target STRAT1VN. One expansion (w=1); group G1 holds {1 x2, 2 x1} -> the minority row fires."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=003 STRAT1V=G1 STRAT1VN=2
dataset ADSL
col STUDYID  type=Char
col USUBJID  type=Char
col STRAT1V  type=Char
col STRAT1VN type=Num
---
S1 | 001 | G1 | 1
S1 | 002 | G1 | 1
S1 | 003 | G1 | 2
---
