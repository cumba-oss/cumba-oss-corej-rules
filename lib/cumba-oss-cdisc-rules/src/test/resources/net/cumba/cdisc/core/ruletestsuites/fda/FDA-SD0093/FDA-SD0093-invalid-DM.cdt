#!RuleTest
#test FDA-SD0093 expect=violation domain=DM
#note "Row 1 gives AGE=56 with an empty AGEU -> 'Age Units (AGEU) should be provided, when Age (AGE) is populated'."
#library standard=sdtmig version=3-1-2
#expectViolationCount 1
#expectViolationAt row=1 AGE=56 AGEU=
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col AGE     type=Num  label="Age"
col AGEU    type=Char label="Age Units"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015 | 56 |
CDISCPILOT01 | DM | 01-701-1023 | 1023 | 63 | YEARS
