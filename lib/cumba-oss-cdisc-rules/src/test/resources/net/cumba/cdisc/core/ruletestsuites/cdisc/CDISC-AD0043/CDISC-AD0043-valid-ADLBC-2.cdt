#!RuleTest
#test CDISC-AD0043 expect=noViolation domain=ADLBC
# Rule:Description: A numeric variable with a suffix of DTM does not have a datetime format
#note "ADTM is Char (data_type != Num) -> noViolation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ADTM type=Char
---
CDISCPILOT01 | 01-701-1015 | ALB | x
---
