#!RuleTest
#test CDISC-AD0208 expect=noViolation domain=ADSL
# Rule:Description: The value of ADSL.USUBJID is equal to the value of DM.USUBJID and ADSL.SUBJID is not equal to DM.SUBJID
#note "same USUBJID, ADSL.SUBJID == DM.SUBJID -> noViolation"
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col SUBJID type=Char
---
CDISCPILOT01 | 01-701-1015 | 1015
---

dataset DM label=Demographics
col STUDYID type=Char
col DOMAIN type=Char
col USUBJID type=Char
col SUBJID type=Char
---
CDISCPILOT01 | DM | 01-701-1015 | 1015
---
