#!RuleTest
#test PMDA-AD0112 expect=skipped domain=ADLBC
#note "ARELTMU is not declared, so Requirements.Variables.All [ARELTM, ARELTMU] gates the rule to SKIPPED naming the absent variable - the deliberate absent-optional-variable contract. The companion presence checks PMDA-AD0111 (var_exists(ARELTM) and not var_exists(ARELTMU)) and PMDA-AD0113 (the converse) are the rules that DO report this dataset, which is why AD0112 is allowed to skip."
#library standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col ARELTM  type=Num
---
CDISCPILOT01 | 01-701-1015 | ALT | 2.5 | 4
CDISCPILOT01 | 01-701-1023 | ALT | 7.0 | 8
