#!RuleTest
#test FDA-SE2353 expect=violation domain=EX
#note "Column-absent case: the EX dataset does not carry an EXLOT column at all, so the bare empty(EXLOT) leaf is TRUE on every row (absent = all-missing, EC-43) and no lot number was provided for the administered doses -> fires. Plan B phase 4d' deleted the not var_exists(EXLOT) disjunct that used to make this a second branch; the verdict is unchanged."
#library standard=sendig version=3-1-1
#expectViolationCount 2
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Actual Treatment"
col EXDOSE  type=Num  label="Dose per Administration"
---
S1 | EX | 001 | 1 | TEST ARTICLE | 10
S1 | EX | 001 | 2 | TEST ARTICLE | 20
