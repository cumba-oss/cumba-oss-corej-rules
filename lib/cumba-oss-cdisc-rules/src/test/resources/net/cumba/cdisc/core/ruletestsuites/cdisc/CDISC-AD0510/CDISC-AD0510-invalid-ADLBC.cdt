#!RuleTest
#test CDISC-AD0510 expect=violation domain=ADLBC
# Rule:Description: A variable ending in STM must contain "Start Time" in the label
#note "ASTM label "Analysis Time" lacks "Start Time" -> violation"
#expectViolationCount 1
#expectViolationAt variable_label="Analysis Time" variable_name=ASTM
#library standard=adamig version=1-3
#library column-order ADLBC STUDYID USUBJID PARAMCD
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ASTM type=Char label="Analysis Time"
---
CDISCPILOT01 | 01-701-1015 | ALB | x
---
