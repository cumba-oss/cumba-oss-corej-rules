#!RuleTest
#test PMDA-AD0150 expect=skipped domain=ADLBC
#note "PARAMCD is NOT declared. AVAL still detects BASIC DATA STRUCTURE, so the dataset is in scope structurally, but Requirements.Variables.All names PARAMCD -> skipped. Completes the batch's coverage of the three All entries across AD0149 (AVALC) / AD0149B (AVAL) / AD0150 (PARAMCD)."
#library standard=adamig version=1-3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col AVAL    type=Num
col AVALC   type=Char
---
CDISCPILOT01 | 01-701-1015 | 1 | LOW
CDISCPILOT01 | 01-701-1023 | 2 | LOW
