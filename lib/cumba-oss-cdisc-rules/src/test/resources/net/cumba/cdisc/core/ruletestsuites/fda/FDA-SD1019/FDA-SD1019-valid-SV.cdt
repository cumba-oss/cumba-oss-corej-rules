#!RuleTest
#test FDA-SD1019 expect=noViolation domain=SV
#note "Row 1 is a planned visit with VISITDY populated and no SVUPDES; row 2 is an unplanned visit (SVUPDES populated) and correctly leaves VISITDY missing."
#library standard=sdtmig version=3-4
dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col VISITDY  type=Num  label="Planned Study Day of Visit"
col SVUPDES  type=Char label="Description of Unplanned Visit"
---
CDISCPILOT01 | SV | 01-701-1015 | 1   | SCREENING |  1 |
CDISCPILOT01 | SV | 01-701-1015 | 1.1 | UNSCHEDULED |  | Subject felt unwell
