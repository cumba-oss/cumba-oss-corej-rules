#!RuleTest
#test FDA-SD1205 expect=noViolation domain=EX
#note "Row 1: EXSTDTC equal to RFXSTDTC -> boundary, strict less-than does not fire. Row 2: EXSTDTC after RFXSTDTC -> ok. Row 3: EXSTDTC empty -> ok. Row 4: subject with empty RFXSTDTC -> no comparand, no fire."
#library standard=sdtmig version=3-4
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
---
S1 | EX | 001 | 1 | DRUG A | 2020-01-01
S1 | EX | 001 | 2 | DRUG A | 2020-01-15
S1 | EX | 001 | 3 | DRUG A |
S1 | EX | 002 | 1 | DRUG A | 2019-01-01
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFXSTDTC type=Char label="Date/Time of First Study Treatment"
---
S1 | DM | 001 | 2020-01-01
S1 | DM | 002 |
---
