#!RuleTest
#test CDISC-CG0118 expect=noViolation domain=DM
#note "All four reserved ACTARM values ('Screen Failure', 'Not Assigned', 'Not Treated', 'Unplanned Treatment') kill this rule's FIRST conjunct -> silent, pinning the reserved-list arm in its authored leading position. SDTMIG 3.2 predates ARMNRS, so this domain does not carry that column."
#library standard=sdtmig version=3-2
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARM      type=Char label="Description of Planned Arm"
col ACTARM   type=Char label="Description of Actual Arm"
---
CDISCPILOT01 | DM | 01-001 | Screen Failure | Screen Failure
CDISCPILOT01 | DM | 01-002 | Not Assigned   | Not Assigned
CDISCPILOT01 | DM | 01-003 | Placebo        | Not Treated
CDISCPILOT01 | DM | 01-004 | Placebo        | Unplanned Treatment
---

dataset TA label="Trial Arms"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
col TAETORD type=Num  label="Planned Order of Element within Arm"
col ETCD    type=Char label="Element Code"
---
CDISCPILOT01 | TA | PBO   | Placebo | 1 | TRT
CDISCPILOT01 | TA | XANHI | XanHigh | 1 | TRT
---
