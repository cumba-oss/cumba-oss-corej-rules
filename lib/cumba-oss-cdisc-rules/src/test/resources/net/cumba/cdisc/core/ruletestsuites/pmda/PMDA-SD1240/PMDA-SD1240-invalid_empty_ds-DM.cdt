#!RuleTest
#test PMDA-SD1240 expect=violation domain=DM
#note "FRESH, DISCRIMINATING: the operation-dataset PRESENT-BUT-EMPTY near-miss (DS-entirely-absent is the standing harness carve-out and gets no fixture). distinct's EmptyResult is SET: the empty DS yields an EMPTY set and EVERY DM subject is 'not in' it -> both rows fire."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=001
#expectViolationAt row=2 USUBJID=002
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col SITEID  type=Char label="Study Site Identifier"
col SEX     type=Char label="Sex"
col COUNTRY type=Char label="Country"
---
CDISCPILOT01 | DM | 001 | 001 | 70 | M | USA
CDISCPILOT01 | DM | 002 | 002 | 70 | F | USA
---

dataset DS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSTERM  type=Char label="Reported Term for the Disposition Event"
col DSDECOD type=Char label="Standardized Disposition Term"
col DSCAT   type=Char label="Category for Disposition Event"
col DSSTDTC type=Char label="Start Date/Time of Disposition Event"
---
