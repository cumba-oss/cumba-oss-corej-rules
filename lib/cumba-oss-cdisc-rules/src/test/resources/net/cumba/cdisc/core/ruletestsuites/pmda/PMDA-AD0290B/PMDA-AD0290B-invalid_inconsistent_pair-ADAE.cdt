#!RuleTest
#test PMDA-AD0290B expect=violation domain=ADAE
#note "KEY=AREL (2nd arg), DEPENDENT=ARELN (1st arg): key RELATED carries {1,2} -> rows 1,3 fire; key UNLIKELY is single-valued. Record granularity -> 2 violations."
#library standard=adamig version=1-3
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015 AREL=RELATED ARELN=1
#expectViolationAt row=3 USUBJID=01-701-1034 AREL=RELATED ARELN=2
dataset ADAE structure=OCCDS
col STUDYID type=Char
col USUBJID type=Char
col AESEQ   type=Num
col AEDECOD type=Char
col AREL    type=Char
col ARELN   type=Num
---
CDISCPILOT01 | 01-701-1015 | 1 | HEADACHE | RELATED  | 1
CDISCPILOT01 | 01-701-1023 | 1 | NAUSEA   | UNLIKELY | 1
CDISCPILOT01 | 01-701-1034 | 2 | RASH     | RELATED  | 2
