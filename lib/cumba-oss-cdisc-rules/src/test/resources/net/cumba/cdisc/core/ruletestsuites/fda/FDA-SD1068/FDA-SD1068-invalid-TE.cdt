#!RuleTest
#test FDA-SD1068 expect=violation domain=TE
#note "ELEMENT 'Treatment' appears on two TE records (distinct ETCDs, so only SD1068 fires here, not SD1064) -> both duplicate records fire."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=2 ELEMENT=Treatment
#expectViolationAt row=3 ELEMENT=Treatment
dataset TE class="TRIAL DESIGN"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ETCD    type=Char label="Element Code"
col ELEMENT type=Char label="Description of Element"
---
S1 | TE | SCRN | Screening
S1 | TE | TRT1 | Treatment
S1 | TE | TRT2 | Treatment
