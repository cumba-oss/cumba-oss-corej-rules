#!RuleTest
#test FDA-SE2322 expect=noViolation domain=TS
#note "Row 2 gives the Planned Number of Subjects parameter 'SPLANSUB' a numeric TSVAL ('20'); row 3 is a different parameter whose non-numeric value is none of this rule's business; row 4 leaves TSVAL empty."
#library standard=sendig version=3-1-1
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
STUDY01 | TS | 1 | TITLE | Trial Title | A 28-day study
STUDY01 | TS | 2 | SPLANSUB | Planned Number of Subjects | 20
STUDY01 | TS | 3 | SPECIES | Species | RAT
STUDY01 | TS | 4 | SPLANSUB | Planned Number of Subjects |
