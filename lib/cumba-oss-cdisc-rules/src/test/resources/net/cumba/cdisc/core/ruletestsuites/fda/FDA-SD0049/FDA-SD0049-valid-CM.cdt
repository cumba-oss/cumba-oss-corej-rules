#!RuleTest
#test FDA-SD0049 expect=noViolation domain=CM
#note "Every record with a start-relative-to-reference value (CMSTRTPT) also names the start reference time point (CMSTTPT); row 3 has neither."
#library standard=sdtmig version=3-4
dataset CM class=INTERVENTIONS label="Concomitant Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ   type=Num  label="Sequence Number"
col CMTRT   type=Char label="Reported Name of Drug, Med, or Therapy"
col CMSTRTPT type=Char label="Start Relative to Reference Time Point"
col CMSTTPT  type=Char label="Start Reference Time Point"
---
CDISCPILOT01 | CM | 01-701-1015 | 1 | ASPIRIN | BEFORE | 2020-01-01
CDISCPILOT01 | CM | 01-701-1015 | 2 | IBUPROFEN | ONGOING | 2020-01-05
CDISCPILOT01 | CM | 01-701-1023 | 1 | ASPIRIN |        |
