#!RuleTest
#test FDA-SD1279 expect=violation domain=EC
#note "Regression pin for the W5 fix: the bare empty(ECDOSTXT) leaf fires when the column is absent (absent = all-missing, EC-43; Plan B phase 4d' deleted the not_exists half of the any:[not_exists, empty] pair the W5 fix introduced, leaving the verdict unchanged) and an occurred record with missing ECDOSE carries no dose information at all."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 ECSEQ=1
dataset EC class=INTERVENTIONS label="Exposure as Collected"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col ECSEQ   type=Num  label="Sequence Number"
col ECTRT   type=Char label="Name of Treatment"
col ECOCCUR type=Char label="Occurrence"
col ECDOSE  type=Num  label="Dose"
col ECSTAT  type=Char label="Completion Status"
---
S1 | EC | 001 | 1 | DRUG A | Y | . |
S1 | EC | 001 | 2 | DRUG A | Y | 5 |
