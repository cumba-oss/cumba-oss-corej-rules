#!RuleTest
#test FDA-SE2331 expect=noViolation domain=TS
#note "TS carries a TSPARMCD=GLPFL record ('Good Laboratory Practice Indicator Flag'), so the required Trial Summary parameter is present -> no violation."
#library standard=sendig version=3-1-1
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | GLPTYP   | Good Laboratory Practice Type              | FULL GLP
S01 | TS | 2 | GLPFL    | Good Laboratory Practice Indicator Flag    | Y
S01 | TS | 3 | STITLE   | Nonclinical Study Title                    | 13-Week Repeat Dose Toxicity Study
