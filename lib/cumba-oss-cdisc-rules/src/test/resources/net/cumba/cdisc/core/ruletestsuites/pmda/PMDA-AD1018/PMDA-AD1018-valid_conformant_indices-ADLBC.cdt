#note "Boundary indices 01, 10 and 99 across both suffixes -> executes, silent. Deliberately carries NO column with a non-digit index (finding AD1018-F1): such a column would fire today and be silent under the proposed \d\d form, and this fixture must stay ruling-neutral."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col ANL01FL type=Char
col ANL10FN type=Num
col ANL99FL type=Char
