#!RuleTest
#test PMDA-SD1112 expect=noViolation domain=DM
#note "The Trial Arms (TA) dataset is present in the study inventory -> no violation."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SEX     type=Char label="Sex"
---
S1 | DM | 001 | M
---

dataset TA class="TRIAL DESIGN" label="Trial Arms"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ARMCD   type=Char label="Planned Arm Code"
col TAETORD type=Num  label="Planned Order of Element within Arm"
col ETCD    type=Char label="Element Code"
---
S1 | TA | A | 1 | SCRN
---
