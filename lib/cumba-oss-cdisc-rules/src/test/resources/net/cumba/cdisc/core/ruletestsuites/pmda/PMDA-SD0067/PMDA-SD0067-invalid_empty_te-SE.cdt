#!RuleTest
#test PMDA-SD0067 expect=violation domain=SE
#note "DISCRIMINATING empty-foreign near-miss: TE is PRESENT but holds ZERO rows, so $te_etcd is the EMPTY SET, not a missing value - row 1 SCRN fires ('SCRN not in {}'); row 2 UNPLAN stays exempt through the authored != conjunct. Pins EmptyResult.SET and the UNPLAN carve in one."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 ETCD=SCRN
dataset SE class="SPECIAL PURPOSE" label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ   type=Num  label="Sequence Number"
col ETCD    type=Char label="Element Code"
col ELEMENT type=Char label="Description of Element"
---
S1 | SE | 001 | 1 | SCRN   | Screening
S1 | SE | 001 | 2 | UNPLAN | Unplanned Element
---

dataset TE class="TRIAL DESIGN" label="Trial Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ETCD    type=Char label="Element Code"
col ELEMENT type=Char label="Description of Element"
---
---
