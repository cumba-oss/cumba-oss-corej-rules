#!RuleTest
#test PMDA-AD0360 expect=noViolation domain=ADSL
#note "Mirror of AD0359-valid_blank_key: not empty(DTHCAUS) is true on all three rows so the rule genuinely reaches the operator, but the blank DTHCAUSN on row 3 is excluded by the D.2 emptiness exception, so the group holds the single distinct value {1} and nothing fires."
#library standard=adamig version=1-3
dataset ADSL
col STUDYID  type=Char
col USUBJID  type=Char
col DTHCAUS  type=Char
col DTHCAUSN type=Num
---
CDISCPILOT01 | 01-701-1015 | MYOCARDIALINFARCTION | 1
CDISCPILOT01 | 01-701-1023 | MYOCARDIALINFARCTION | 1
CDISCPILOT01 | 01-701-1034 | MYOCARDIALINFARCTION |
