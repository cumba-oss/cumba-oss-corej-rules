#!RuleTest
#test PMDA-AD0476 expect=skipped domain=ADSL
#note "STRATAV is absent, so Requirements.Variables.All rejects the dataset and the engine reports SKIPPED naming the variable. Pins the Requirements.Variables gate, which sits on the TARGET column for this rule and on the KEY column for its mirror PMDA-AD0477."
#library standard=adamig version=1-3
dataset ADSL
col STUDYID  type=Char
col USUBJID  type=Char
col STRATAVN type=Num
---
S1 | 001 | 1
S1 | 002 | 2
---
