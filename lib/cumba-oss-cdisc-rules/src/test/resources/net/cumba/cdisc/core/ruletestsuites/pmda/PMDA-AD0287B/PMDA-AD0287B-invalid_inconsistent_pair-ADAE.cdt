#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015 AEREL=RELATED AERELN=1
#expectViolationAt row=2 USUBJID=01-701-1023 AEREL=UNLIKELY AERELN=1
dataset ADAE structure=OCCDS subclass=AE
col STUDYID type=Char
col USUBJID type=Char
col AESEQ   type=Num
col AEDECOD type=Char
col AEREL   type=Char
col AERELN  type=Num
---
