#!RuleTest
#test PMDA-AD0041 expect=noViolation domain=ADLBC
#note "ADTM ends with M, ADY ends with Y - neither ends with DT, so the rule stays silent despite an invalid-for-dates format. Pins the suffix boundary against PMDA-AD0043."
#library standard=adamig version=1-3
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ADTM    type=Num format=8.
col ADY     type=Num format=8.
---
CDISCPILOT01 | 01-701-1015 | ALB | 1 | 1
---
