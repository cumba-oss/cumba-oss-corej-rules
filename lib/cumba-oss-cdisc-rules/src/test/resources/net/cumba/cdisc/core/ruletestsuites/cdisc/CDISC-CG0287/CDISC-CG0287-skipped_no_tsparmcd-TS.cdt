#!RuleTest
#test CDISC-CG0287 expect=skipped domain=TS
#note "TSPARMCD is absent from TS, so Requirements.Variables.All gates the rule to SKIPPED. The missing Required column is one structural defect, reported once by its own presence rule rather than as a not_contains_all finding per required parameter."
#library standard=sdtmig version=3-3
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
CDISCPILOT01 | TS | 1 | Trial Title | A Phase 3 Study
---
