#!RuleTest
#test PMDA-AD0132B expect=noViolation domain=ADLBC
#note "Both rows carry populated CHG with AVAL and BASE present and populated -> second conjunct false everywhere. Row 2 additionally pins that a ZERO derived value (CHG=0) counts as populated. Rule does NOT check the arithmetic (that is AD0223)."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col BASE    type=Num
col CHG     type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | 10 | 4 | 6
CDISCPILOT01 | 01-701-1023 | ALB | 8  | 8 | 0
