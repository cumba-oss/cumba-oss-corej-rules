#!RuleTest
#test PMDA-AD0468 expect=violation domain=ADSL
#note "The literal name ADSL alone yields SUBJECT LEVEL ANALYSIS DATASET. No wildcards -- STRATAR / STRATARN are concrete ADaMIG names. Target is the LABEL STRATAR, key is the CODE STRATARN. Group STRATARN=1 holds STRATAR {MALE x2, M x1} -> row 3 is the lone minority. Group STRATARN=2 holds one value and is silent."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 STRATAR=M STRATARN=1
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col STRATAR type=Char
col STRATARN type=Num
---
S1 | 001 | MALE   | 1
S1 | 002 | MALE   | 1
S1 | 003 | M      | 1
S1 | 004 | FEMALE | 2
