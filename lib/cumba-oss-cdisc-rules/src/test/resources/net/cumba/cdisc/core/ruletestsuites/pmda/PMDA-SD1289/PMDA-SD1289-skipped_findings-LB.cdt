#!RuleTest
#test PMDA-SD1289 expect=skipped domain=LB
#note "FRESH - the batch's Classes.Include reject pin. Violating-shaped data (LBPTCD populated, LBDECOD empty) with both Requirements.Variables columns present, but FINDINGS is not in Classes.Include [EVENTS] -> the rule must not execute."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col LBSEQ   type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBDECOD type=Char label="Dictionary-Derived Term"
col LBPTCD  type=Num  label="Preferred Term Code"
---
S1 | LB | 001 | 1 | GLUC |  | 10018424
