#!RuleTest
#test CDISC-CG0259 expect=violation domain=TS
#note "Row 2 leaves both TSVAL and TSVALNF empty -> fires; rows 1 and 3 populate one of the pair."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 TSSEQ=2 TSVAL= TSVALNF=
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
col TSVALNF  type=Char label="Parameter Value Null Flavor"
---
S1 | TS | 1 | TITLE  | Trial Title     | A Study of X |
S1 | TS | 2 | AGEMAX | Planned Max Age |              |
S1 | TS | 3 | AGEMIN | Planned Min Age |              | NA
