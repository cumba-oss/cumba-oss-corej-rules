#!RuleTest
#test FDA-SD1325 expect=violation domain=DM
#note "The dataset label 'Demography' does not match the Define-XML description 'Demographics' -> fires."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#define dataset-metadata DM name=DM label="Demographics"
dataset DM label="Demography"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col AGE     type=Num  label="Age"
---
