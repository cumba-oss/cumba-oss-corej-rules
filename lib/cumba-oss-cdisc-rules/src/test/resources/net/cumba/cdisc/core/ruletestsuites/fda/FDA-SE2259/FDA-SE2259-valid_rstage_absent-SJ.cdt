#!RuleTest
#test FDA-SE2259 expect=noViolation domain=SJ
#note "Boundary: RSTAGE is Permissible in SJ (SENDIG-DART 1.1) and this study did not collect it, so the column is absent. There is no (RSTGCD, RSTAGE) combination to compare and the code-only check is FDA-SE2258's job -> the rule must not fire. Per CORE-RULES-GUARD-MATRIX class V an absent target column is 0 findings in both engines; this scenario pins that the composite tuple(RSTGCD, RSTAGE) membership does not over-fire on the absent column."
#library standard=sendig version=dart-1-1
dataset SJ class="SPECIAL PURPOSE" label="Subject Repro Stages"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SJSEQ   type=Num  label="Sequence Number"
col RSTGCD  type=Char label="Repro Stage Code"
col SJSTDTC type=Char label="Start Date/Time of Repro Stage"
---
S1 | SJ | 001 | 1 | ST1 | 2020-01-01
S1 | SJ | 002 | 1 | ST2 | 2020-02-01
---

dataset TT class="TRIAL DESIGN" label="Trial Repro Stages"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col RSTGCD  type=Char label="Repro Stage Code"
col RSTAGE  type=Char label="Description of Repro Stage"
col TTSTRL  type=Char label="Repro Stage Start Rule"
---
S1 | TT | ST1 | Premating | FIRST DOSE
S1 | TT | ST2 | Gestation | GD 0
---
