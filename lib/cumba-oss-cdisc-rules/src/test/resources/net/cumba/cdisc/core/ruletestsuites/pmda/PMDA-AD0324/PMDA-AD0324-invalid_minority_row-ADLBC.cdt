#expectViolationAt row=3 USUBJID=01-701-1034 APHASE=TREATMENT APHASEN=1
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col APHASE  type=Char
col APHASEN type=Num
