#!RuleTest
#test FDA-SD1373 expect=violation domain=DM
#note "Row 2 states the subject never reached an arm (ARMNRS 'SCREEN FAILURE') yet carries a reference start date -> fires."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 ARMNRS="SCREEN FAILURE"
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SUBJID   type=Char label="Subject Identifier for the Study"
col RFSTDTC  type=Char label="Subject Reference Start Date/Time"
col ARM      type=Char label="Description of Planned Arm"
col ARMNRS   type=Char label="Reason Arm and/or Actual Arm is Null"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015 | 2020-01-05 | Placebo |
CDISCPILOT01 | DM | 01-701-1023 | 1023 | 2020-01-08 |         | SCREEN FAILURE
