#!RuleTest
#test CDISC-CG0033 expect=violation domain=LB
#note "Positive control for the Fix #246 guard family: TV is present, so the top-level TV.VISITNUM exists guard passes and the rule still fires on the real defect. Row 2's VISITNUM=99 is marked planned in SV (SVPRESP=Y) but 99 is not a VISITNUM value in TV. Row 1's VISITNUM=2 is in TV and must not fire."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1015 VISITNUM=99
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB | 2  | BASELINE
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALB | 99 | WEEK 99
---

dataset SV label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col SVPRESP  type=Char label="Pre-Specified"
---
CDISCPILOT01 | SV | 01-701-1015 | 2  | BASELINE | Y
CDISCPILOT01 | SV | 01-701-1015 | 99 | WEEK 99  | Y
---

dataset TV label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | TV | 1 | SCREENING
CDISCPILOT01 | TV | 2 | BASELINE
---
