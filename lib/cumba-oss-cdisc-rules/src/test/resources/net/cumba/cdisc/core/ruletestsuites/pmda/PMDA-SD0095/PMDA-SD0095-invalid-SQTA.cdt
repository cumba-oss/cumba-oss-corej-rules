#!RuleTest
#test PMDA-SD0095 expect=violation domain=SQTA
#note "Scope.Domains.Include is [SUPP--, SQ--] - the SQ-- prefix pin, never exercised by the FDA twin. RDOMAIN=TA references a Trial Design domain - not a general-observation class, not DM, not SV -> fires, exactly as the SUPPTA body."
#library standard=sdtmig version=3-3
#library dataset-class TA "TRIAL DESIGN"
#expectViolationCount 1
#expectViolationAt row=1 RDOMAIN=TA
dataset SQTA class=RELATIONSHIP label="Supplemental Qualifiers for TA"
col STUDYID type=Char label="Study Identifier"
col RDOMAIN type=Char label="Related Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col QNAM    type=Char label="Qualifier Variable Name"
col QVAL    type=Char label="Data Value"
---
S1 | TA | | ARMNOTE | Extra arm info
