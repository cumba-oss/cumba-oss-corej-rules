#!RuleTest
#test PMDA-AD0691 expect=noViolation domain=ADLBC
#note "Every (SPDEVID, USUBJID, PARAMCD) group with a populated BASE has an ABLFL=Y record -> no fire."
#library standard=adamig version=1-3
dataset ADLBC class=MD-BDS
col STUDYID type=Char
col USUBJID type=Char
col SPDEVID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col BASE    type=Num
col BASEC   type=Char
col ABLFL   type=Char
---
S1 | 001 | DEV01 | GLUC | 5.2 | 5.1 | | Y
S1 | 001 | DEV02 | GLUC | 5.4 | 5.1 | | Y
