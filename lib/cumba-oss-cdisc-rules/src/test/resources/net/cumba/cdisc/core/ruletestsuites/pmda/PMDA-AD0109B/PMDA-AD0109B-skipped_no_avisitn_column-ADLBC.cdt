#!RuleTest
#test PMDA-AD0109B expect=skipped domain=ADLBC
#note "AVISITN is NOT declared. Requirements.Variables.All: [AVISITN] makes the absent column a SKIP, reported with the engine's own reason naming AVISITN - the deliberate absent-optional-variable contract, and the reason this rule can be skipped at all despite Domains:[ALL]."
#library standard=adamig version=1-3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVISIT  type=Char
---
