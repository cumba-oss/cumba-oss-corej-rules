#!RuleTest
#test PMDA-SD1282 expect=noViolation domain=PC
#note "ANY one of the timing trio present defeats the conjunction - here --ELTM (first conjunct false)."
#library standard=sdtmig version=3-4
dataset PC class=FINDINGS label="Pharmacokinetic Concentrations"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col PCSEQ    type=Num
col PCTESTCD type=Char
col PCTPTREF type=Char
col PCELTM   type=Char
---
S1 | PC | 001 | 1 | DRUGA | MOST RECENT DOSE | PT1H
---
