#!RuleTest
#test FDA-SE2241 expect=noViolation domain=CL
#note "Boundary: subject 002 has no DS record at all, so there is no latest disposition date to compare against and the rule cannot judge the observation -> no violation. Subject 001 is disposed on 2020-01-20 and observed before it -> also clean."
#library standard=sendig version=3-1-1
#library dataset-class CL FINDINGS
dataset CL class=FINDINGS label="Clinical Observations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col CLSEQ    type=Num  label="Sequence Number"
col CLTESTCD type=Char label="Clinical Observation Short Name"
col CLDTC    type=Char label="Date/Time of Observation"
---
S1 | CL | 001 | 1 | CLSIGN | 2020-01-12
S1 | CL | 002 | 1 | CLSIGN | 2020-02-28
---

dataset DS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSTERM  type=Char label="Reported Term for the Disposition Event"
col DSDECOD type=Char label="Standardized Disposition Term"
col DSSTDTC type=Char label="Start Date/Time of Disposition Event"
---
S1 | DS | 001 | 1 | TERMINAL SACRIFICE | TERMINAL SACRIFICE | 2020-01-20
