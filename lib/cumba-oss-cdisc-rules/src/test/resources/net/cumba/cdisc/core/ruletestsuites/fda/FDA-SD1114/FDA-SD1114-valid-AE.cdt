#!RuleTest
#test FDA-SD1114 expect=noViolation domain=AE
#note "Every AEBODSYS value is a System Organ Class of the (dummy) MedDRA dictionary; the check is case-insensitive, so mixed casing passes too."
#library standard=sdtmig version=3-4
#dictionaries dummy
dataset AE
col USUBJID  type=Char
col AEDECOD  type=Char
col AEBODSYS type=Char
---
001 | Headache | Nervous system disorders
001 | Nausea   | GASTROINTESTINAL DISORDERS
002 | Headache | nervous system disorders
