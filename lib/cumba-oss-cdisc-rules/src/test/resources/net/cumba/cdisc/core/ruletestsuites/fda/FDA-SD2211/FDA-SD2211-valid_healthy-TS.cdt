#!RuleTest
#test FDA-SD2211 expect=noViolation domain=TS
#note "Condition branch: the study population is healthy subjects (HLTSUBJI=Y), so TDIGRP is not required even though no TDIGRP record exists -> no violation."
#library standard=sdtmig version=3-4
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | TITLE    | Trial Title | A Phase 1 Study of Drug X in Healthy Volunteers
S01 | TS | 2 | HLTSUBJI | Healthy Subject Indicator | Y
S01 | TS | 3 | TPHASE   | Trial Phase Classification | PHASE I TRIAL
