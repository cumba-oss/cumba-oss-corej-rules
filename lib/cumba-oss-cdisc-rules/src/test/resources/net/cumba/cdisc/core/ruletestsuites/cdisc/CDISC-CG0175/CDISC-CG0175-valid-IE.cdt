#!RuleTest
#test CDISC-CG0175 expect=noViolation domain=IE
#note "Every EXCLUSION record carries IEORRES='Y' (the subject met the exclusion criterion); INCLUSION records are outside the condition -> no violation."
#library standard=sdtmig version=3-4
dataset IE class=FINDINGS label="Inclusion/Exclusion Criteria Not Met"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IESEQ    type=Num  label="Sequence Number"
col IETESTCD type=Char label="Inclusion/Exclusion Criterion Short Name"
col IECAT    type=Char label="Inclusion/Exclusion Category"
col IEORRES  type=Char label="I/E Criterion Original Result"
---
S1 | IE | 001 | 1 | EXCL01 | EXCLUSION | Y
S1 | IE | 002 | 1 | INCL01 | INCLUSION | N
