#!RuleTest
#test PMDA-SD0040 expect=violation domain=LB
#note "FRESH, DISCRIMINATING. The cluster's one uncovered flagging mode: GLUC counts {Glucose:2, Glucose Level:1} -> a unique maximum -> ONLY the strict-minority row (row 3) is flagged, not the whole group. ESCALATE if count is 3 (all-rows would refute the strict-minority reading)."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=3 LBTESTCD=GLUC LBTEST="Glucose Level"
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBTEST   type=Char label="Lab Test or Examination Name"
---
S1 | LB | 001 | 1 | GLUC | Glucose
S1 | LB | 002 | 1 | GLUC | Glucose
S1 | LB | 003 | 1 | GLUC | Glucose Level
S1 | LB | 001 | 2 | ALB  | Albumin
