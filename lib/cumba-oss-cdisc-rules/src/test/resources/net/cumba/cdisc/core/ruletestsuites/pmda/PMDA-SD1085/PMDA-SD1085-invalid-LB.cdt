#!RuleTest
#test PMDA-SD1085 expect=violation domain=LB
#note "LBDY is populated on every row. Row 1: LBDTC is only partially specified (2023-06) while DM.RFSTDTC is complete -> the day value must have been imputed -> fires. Row 2: LBDTC is complete but DM.RFSTDTC is partial -> fires. Row 3: both dates complete -> no fire. First scenario coverage for this rule (authored with the D-TA-2 Join_Type removal)."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=001
#expectViolationAt row=2 USUBJID=002
dataset LB class=FINDINGS
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col LBSEQ type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBDTC type=Char label="Date/Time of Specimen Collection"
col LBDY  type=Num  label="Study Day of Specimen Collection"
---
S1 | LB | 001 | 1 | ALB | 2023-06     | 5
S1 | LB | 002 | 1 | ALB | 2023-06-25 | 5
S1 | LB | 003 | 1 | ALB | 2023-06-25 | 5
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
---
S1 | DM | 001 | 2023-06-01
S1 | DM | 002 | 2023-06
S1 | DM | 003 | 2023-06-01
