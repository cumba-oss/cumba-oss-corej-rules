#!RuleTest
#test CDISC-SEND-0153 expect=noViolation domain=BG
#note "Two BGTEST groups, each internally consistent but with DIFFERENT units across groups. Pins that consistency is keyed per BGTEST, not across the whole dataset."
dataset BG label="Body Weight Gain"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col BGSEQ    type=Num  label="Sequence Number"
col BGTEST   type=Char label="Body Weight Gain Test Name"
col BGSTRESU type=Char label="Standard Units"
---
CDISCPILOT01 | BG | 001 | 1 | BODY WEIGHT GAIN | g
CDISCPILOT01 | BG | 002 | 2 | BODY WEIGHT GAIN | g
CDISCPILOT01 | BG | 003 | 3 | BODY WEIGHT GAIN RATE | kg
CDISCPILOT01 | BG | 004 | 4 | BODY WEIGHT GAIN RATE | kg
---
