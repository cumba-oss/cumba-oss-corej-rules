#!RuleTest
#test FDA-SD1250 expect=noViolation domain=PC
#note "Boundary: PCTPTNUM present but PCTPT absent -> the guard leaf (--TPT exists) is false -> no violation (the rule is one-directional)."
#library standard=sdtmig version=3-4
dataset PC class=FINDINGS label="Pharmacokinetic Concentrations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PCSEQ    type=Num  label="Sequence Number"
col PCTESTCD type=Char label="Pharmacokinetic Test Short Name"
col PCTPTNUM type=Num  label="Planned Time Point Number"
---
CDISCPILOT01 | PC | 01-701-1015 | 1 | DRUGA | 1
---
