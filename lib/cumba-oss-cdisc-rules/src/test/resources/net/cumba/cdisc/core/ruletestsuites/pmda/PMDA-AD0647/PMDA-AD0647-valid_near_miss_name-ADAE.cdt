#!RuleTest
#test PMDA-AD0647 expect=noViolation domain=ADAE
#note "TREM1FL is a ONE-digit index, where the regex demands exactly two, so varname() =~ ^TREM\\d{2}FL\$ is false for every column and nothing fires. This is the fixture that keeps the four flag rules apart: a swap between any two of them is invisible to the violation fixtures alone."
#library standard=adamig version=1-3
dataset ADAE structure=OCCDS subclass=AE
col STUDYID type=Char
col USUBJID type=Char
col ASEQ    type=Num
col AEDECOD type=Char
col TREM1FL type=Char
col TRTEMFL type=Char
---
CDISCPILOT01 | 01-701-1015 | 1 | HEADACHE | Y | N
