#!RuleTest
#test CDISC-SEND-0106.1 expect=violation domain=DM
#note "Present-but-blank STRAIN with no trial-level fallback: neither TS nor TX carries a STRAIN parameter, so both ts_parameter_value operations return null and both empty() leaves are true. Row 1's STRAIN cell is blank -> the group fires; row 2 carries WISTAR so it cannot contribute. Grouping.Variables [STUDYID] (M3-D6 granularity ruling) makes the report ONE finding per study, anchored at the group's first flagged row."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SPECIES type=Char label="Species"
col STRAIN  type=Char label="Strain/Substrain"
---
S1 | DM | 001 | RAT |
S1 | DM | 002 | RAT | WISTAR
---

dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL    type=Char label="Parameter Value"
---
S1 | TS | 1 | SPECIES  | RAT
S1 | TS | 2 | SNDIGVER | SENDIG 3.1.1
---

dataset TX class="TRIAL DESIGN" label="Trial Sets"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col SETCD    type=Char label="Set Code"
col TXSEQ    type=Num  label="Sequence Number"
col TXPARMCD type=Char label="Trial Set Parameter Short Name"
col TXVAL    type=Char label="Parameter Value"
---
S1 | TX | G1 | 1 | TRTDOS  | 100
S1 | TX | G1 | 2 | SPGRPCD | A
---
