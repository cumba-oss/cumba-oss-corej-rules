#!RuleTest
#test PMDA-SD1113 expect=noViolation domain=DM
#note "The Trial Elements (TE) dataset is present in the study inventory -> no violation."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SEX     type=Char label="Sex"
---
S1 | DM | 001 | M
---

dataset TE class="TRIAL DESIGN" label="Trial Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ETCD    type=Char label="Element Code"
col ELEMENT type=Char label="Description of Element"
---
S1 | TE | SCRN | Screening
---
