#!RuleTest
#test PMDA-SD1053 expect=violation domain=TA
#note "Rows 1/2 carry ARMCD='SCRNFAIL' / 'NOTASSGN' in Trial Arms, which must not describe a planned arm -> both fire. Rows 3/4 are real planned arms."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 ARMCD=SCRNFAIL
#expectViolationAt row=2 ARMCD=NOTASSGN
dataset TA label="Trial Arms"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
col TAETORD type=Num  label="Planned Order of Element within Arm"
---
S1 | TA | SCRNFAIL | Screen Failure  | 1
S1 | TA | NOTASSGN | Not Assigned    | 1
S1 | TA | A        | Drug X 10 mg    | 1
S1 | TA | B        | Placebo         | 1
