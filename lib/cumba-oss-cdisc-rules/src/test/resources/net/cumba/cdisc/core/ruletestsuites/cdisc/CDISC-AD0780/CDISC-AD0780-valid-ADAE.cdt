#!RuleTest
#test CDISC-AD0780 expect=noViolation domain=ADAE
# Rule:Description: There is more than one value of RELGRyN for a given value of RELGRy, considering only those rows on which both variables are populated
#note "each RELGR1 maps to a single RELGR1N -> noViolation"
# Declared-tier scope: the class= declaration disagrees with the columns, so #define must
# carry it to RuleRunner (ScenarioDeclaredScopeProvider.install).
#define standard=adamig version=1-3
dataset ADAE class=OCCDS
col STUDYID type=Char
col USUBJID type=Char
col ASEQ type=Num
col RELGR1 type=Char
col RELGR1N type=Num
---
CDISCPILOT01 | 01-701-1015 | 1 | RELATED | 1
CDISCPILOT01 | 01-701-1015 | 2 | NOT RELATED | 2
---
