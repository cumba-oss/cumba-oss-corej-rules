#!RuleTest
#test FDA-SD1398 expect=violation domain=PR
#note "Row 1: PRENDTC and DM.RFCSTDTC are both complete dates but PRCHENDY is missing -> fires. Row 2: PRCHENDY populated -> clean."
#library standard=sendig version=ar-1-0
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset PR class=INTERVENTIONS label="Procedures"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PRSEQ    type=Num  label="Sequence Number"
col PRTRT    type=Char label="Name of Procedure"
col PRENDTC  type=Char label="End Date/Time of Procedure"
col PRCHENDY type=Num  label="End Day of Obs Rel to Challenge Agent"
---
S1 | PR | 001 | 1 | BIOPSY | 2020-01-12 | .
S1 | PR | 001 | 2 | BIOPSY | 2020-01-12 | 8
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFCSTDTC type=Char label="Date/Time of First Challenge Agent Admin"
---
S1 | DM | 001 | 2020-01-05
---
