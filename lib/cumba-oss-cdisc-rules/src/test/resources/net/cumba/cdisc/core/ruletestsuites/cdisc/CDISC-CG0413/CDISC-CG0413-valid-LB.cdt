#!RuleTest
#test CDISC-CG0413 expect=noViolation domain=LB
#note "Negative control: the dataset is named LB and every record carries DOMAIN=LB, so the first 2 characters of the dataset name equal DOMAIN and prefix(dataset_name, 2) != DOMAIN is false. Paired with the -invalid- twin so neither can pass vacuously; first fixture for this id (PLAN-zero-row-routing-rekey.md phase 2)."
#library standard=sdtmig version=3-4
dataset LB label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB
---
