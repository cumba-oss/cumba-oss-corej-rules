#!RuleTest
#test CDISC-AD0326 expect=violation domain=ADLBC
# Rule:Description: Within a value of APERIOD, there is more than one value of ASPERC for a given value of ASPER, considering only those rows on which both variables are populated
#expectViolationCount 2
#expectViolationAt row=1
#expectViolationAt row=2
# Declared-tier scope: structure= states the ADaM data structure this minimal table stands for;
# #define is its mandatory carrier (ScenarioDeclaredScopeProvider.install).
#define standard=adamig version=1-3
dataset ADLBC structure=BDS
col APERIOD type=Char
col ASPERC type=Char
col ASPER type=Char
---
1 | Label A | A
1 | Different Label | A
1 | Label B | B
---
