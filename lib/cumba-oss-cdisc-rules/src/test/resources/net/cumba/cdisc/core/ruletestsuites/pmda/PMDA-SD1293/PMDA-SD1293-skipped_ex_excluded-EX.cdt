#!RuleTest
#test PMDA-SD1293 expect=skipped domain=EX
#note "EX is INTERVENTIONS (in Classes.Include), so ONLY the Domains.Exclude [DS, DV, DX, EX] rejects. Pinned ONCE on behalf of PMDA-SD1294 (identical exclude set, batch scope-pin economy)."
#library standard=sdtmig version=3-4
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col EXSEQ    type=Num
col EXTRT    type=Char
col EXREASND type=Char
---
S1 | EX | 001 | 1 | DRUGA | DOSING HELD
---
