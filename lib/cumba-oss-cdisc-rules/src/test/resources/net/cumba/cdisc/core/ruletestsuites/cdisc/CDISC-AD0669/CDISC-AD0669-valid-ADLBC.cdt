#!RuleTest
#test CDISC-AD0669 expect=noViolation domain=ADLBC
# Rule:Description: On a given record, ACYCLEC is populated and ACYCLE is present and not populated
#note "ACYCLEC and ACYCLE are both populated, so the rule executes and does not fire"
# Declared-tier scope: the class= declaration disagrees with the columns, so #define must
# carry it to RuleRunner (ScenarioDeclaredScopeProvider.install).
#define standard=adamig version=1-3
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col ACYCLE type=Num
col ACYCLEC type=Char
---
CDISCPILOT01 | 01-701-1015 | 1 | CYCLE 1
---
