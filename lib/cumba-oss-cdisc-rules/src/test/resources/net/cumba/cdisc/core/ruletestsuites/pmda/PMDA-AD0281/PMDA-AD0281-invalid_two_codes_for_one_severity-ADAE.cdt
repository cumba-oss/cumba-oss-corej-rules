#!RuleTest
#test PMDA-AD0281 expect=violation domain=ADAE
#note "KEY=AESEV (2nd arg), DEPENDENT=AESEVN (1st arg): key MILD carries {1,2} -> rows 1,2 fire; key SEVERE is single-valued. Record granularity -> 2 violations. Declared structure/subclass beat the columns."
#library standard=adamig version=1-0
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015 AESEV=MILD AESEVN=1
#expectViolationAt row=2 USUBJID=01-701-1023 AESEV=MILD AESEVN=2
dataset ADAE structure=OCCDS subclass=AE
col STUDYID type=Char
col USUBJID type=Char
col AESEQ   type=Num
col AEDECOD type=Char
col AESEV   type=Char
col AESEVN  type=Num
---
CDISCPILOT01 | 01-701-1015 | 1 | HEADACHE | MILD | 1
CDISCPILOT01 | 01-701-1023 | 1 | NAUSEA | MILD | 2
CDISCPILOT01 | 01-701-1034 | 2 | RASH | SEVERE | 3
