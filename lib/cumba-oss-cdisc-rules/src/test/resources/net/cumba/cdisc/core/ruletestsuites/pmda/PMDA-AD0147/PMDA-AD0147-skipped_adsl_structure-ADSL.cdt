#!RuleTest
#test PMDA-AD0147 expect=skipped domain=ADSL
#note "DISCRIMINATING fixture for finding AD0147-F1 (the Data_Structures gate really is exclusive to BASIC DATA STRUCTURE). A dataset literally named ADSL is SUBJECT LEVEL ANALYSIS DATASET whatever its columns, so it is outside [BASIC DATA STRUCTURE] and the rule never executes, even though the group WOULD fire."
#library standard=adamig version=1-0
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col PARAM   type=Char
col PARAMN  type=Num
---
CDISCPILOT01 | 01-701-1015 | Albumin | 1
CDISCPILOT01 | 01-701-1023 | Albumin | 2
