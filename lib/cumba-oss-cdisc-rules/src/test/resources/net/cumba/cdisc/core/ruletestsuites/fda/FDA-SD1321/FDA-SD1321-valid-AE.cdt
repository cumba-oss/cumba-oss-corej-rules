#!RuleTest
#test FDA-SD1321 expect=noViolation domain=AE
#note "Every subject with AE records has a SUPPAE record carrying the AETRTEM treatment-emergent flag -> no violation."
#library standard=sdtmig version=3-4
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEDECOD type=Char label="Dictionary-Derived Term"
---
S1 | AE | 001 | 1 | Headache | HEADACHE
S1 | AE | 002 | 1 | Nausea   | NAUSEA
---

dataset SUPPAE label="Supplemental Qualifiers for AE"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM     type=Char label="Qualifier Variable Name"
col QLABEL   type=Char label="Qualifier Variable Label"
col QVAL     type=Char label="Data Value"
---
S1 | AE | 001 | AESEQ | 1 | AETRTEM | Treatment Emergent Flag | Y
S1 | AE | 002 | AESEQ | 1 | AETRTEM | Treatment Emergent Flag | N
---
