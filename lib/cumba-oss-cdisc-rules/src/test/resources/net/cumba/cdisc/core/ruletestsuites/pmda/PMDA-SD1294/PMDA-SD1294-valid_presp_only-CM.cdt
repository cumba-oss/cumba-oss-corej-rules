#!RuleTest
#test PMDA-SD1294 expect=noViolation domain=CM
#note "Direction discriminator (second conjunct false). The scope skip for this rule's [DX, EX, DS, DV] block is pinned by PMDA-SD1293-skipped_ex_excluded-EX (identical set)."
#library standard=sdtmig version=3-4
dataset CM class=INTERVENTIONS label="Concomitant Medications"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col CMSEQ    type=Num
col CMTRT    type=Char
col CMPRESP  type=Char
---
S1 | CM | 001 | 1 | ASPIRIN | Y
---
