#!RuleTest
#test FDA-SD1008 expect=noViolation domain=CO
#note "Row 1 relates to the AE domain as a whole (RDOMAIN populated) but not to a specific parent record or group of records - IDVAR and IDVARVAL are empty. The sheet condition names records 'related to a specific parent record or group of parent records ... (RDOMAIN, IDVAR and IDVARVAL are populated)', so this record is outside it and CODTC may be populated."
#library standard=sdtmig version=3-4
dataset CO label="Comments"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col COSEQ    type=Num  label="Sequence Number"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col COVAL    type=Char label="Comment"
col CODTC    type=Char label="Date/Time of Comment"
---
CDISCPILOT01 | CO | AE | 01-701-1015 | 1 |  |  | Applies to all AEs | 2020-01-15
