#!RuleTest
#test CDISC-CG0150 expect=violation domain=DM
#note "SUBJID 001 appears on two DM records within STUDYID S1 (even though USUBJID differs) -> both duplicate records fire."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 SUBJID=001
#expectViolationAt row=2 SUBJID=001
dataset DM class="SPECIAL PURPOSE"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
---
S1 | DM | S1-001 | 001
S1 | DM | S1-001B | 001
S1 | DM | S1-002 | 002
