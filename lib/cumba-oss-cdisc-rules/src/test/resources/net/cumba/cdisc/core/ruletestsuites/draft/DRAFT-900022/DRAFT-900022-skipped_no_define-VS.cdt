#!RuleTest
#test DRAFT-900022 expect=skipped domain=VS
#note "Library lines as in invalid; NO #define channel at all. The Check reads the DEFINE level, so the engine's machine-emitted availability gate skips the rule ('no Define-XML metadata available', RuleRunner.evaluateMetadataNative). Pins the availability-gate mechanism for the whole DRAFT define family; the gate is machine-emitted -- no authored Precondition anywhere."
#library standard=sdtmig version=3-4
#library variable-metadata VS VSPOS codelist=C71148 ccode=C71148
#library variable-metadata VS VSLAT codelist=C99074 ccode=C99074
dataset VS class=FINDINGS
col USUBJID  type=Char
col VSTESTCD type=Char
col VSPOS    type=Char
col VSLAT    type=Char
---
001 | SYSBP | SUPINE | LEFT
---
