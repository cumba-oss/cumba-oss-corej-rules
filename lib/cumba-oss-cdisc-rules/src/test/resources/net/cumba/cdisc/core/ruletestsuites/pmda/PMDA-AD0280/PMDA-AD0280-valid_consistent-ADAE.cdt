#!RuleTest
#test PMDA-AD0280 expect=noViolation domain=ADAE
#note "Each AESEVN maps to exactly one AESEV -> the rule EXECUTES and stays silent. M2-D17 / Fix #313: the PMDA sheet marks AD0280 for ADaMIG 1.0 only (1.1-1.3 belong to AD0280B), so the rule left rules-pmda-adamig-1-1.json; this fixture moved from version=1-1 to version=1-0 (same rule, same data, same expectation)."
#library standard=adamig version=1-0
#expectViolationCount 0
dataset ADAE structure=OCCDS subclass=AE
col STUDYID type=Char
col USUBJID type=Char
col AESEQ   type=Num
col AEDECOD type=Char
col AESEV   type=Char
col AESEVN  type=Num
---
CDISCPILOT01 | 01-701-1015 | 1 | HEADACHE | MILD   | 1
CDISCPILOT01 | 01-701-1023 | 1 | NAUSEA   | MILD   | 1
CDISCPILOT01 | 01-701-1034 | 2 | RASH     | SEVERE | 3
