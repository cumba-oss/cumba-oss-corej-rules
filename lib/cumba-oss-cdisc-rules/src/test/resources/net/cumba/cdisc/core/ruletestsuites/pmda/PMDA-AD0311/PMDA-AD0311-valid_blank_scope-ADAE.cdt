#!RuleTest
#test PMDA-AD0311 expect=noViolation domain=ADAE
#note "Row 2's SMQ01SC (the KEY) is blank while SMQ01SCN stays 2: key BROAD left with single dependent {1} -> silent. The column STAYS declared -- only the cell is blank; wildcard expansion is column-name driven."
#library standard=adamig version=1-0
#expectViolationCount 0
dataset ADAE structure=OCCDS subclass=AE
col STUDYID  type=Char
col USUBJID  type=Char
col AESEQ    type=Num
col AEDECOD  type=Char
col SMQ01SC  type=Char
col SMQ01SCN type=Num
---
CDISCPILOT01 | 01-701-1015 | 1 | HEADACHE | BROAD | 1
CDISCPILOT01 | 01-701-1023 | 1 | NAUSEA |  | 2
