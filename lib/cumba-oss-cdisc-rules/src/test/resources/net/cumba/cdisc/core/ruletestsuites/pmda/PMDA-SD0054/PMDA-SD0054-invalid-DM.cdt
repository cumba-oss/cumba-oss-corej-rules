#!RuleTest
#test PMDA-SD0054 expect=violation domain=DM
#note "Adapted from the tested 0-identical twin fda/FDA-SD0054 (TG-0219). Define column-order declares STUDYID DOMAIN USUBJID AGE; AGE is missing from the dataset -> one dataset-level violation, $missing_define_variables = [AGE]."
#library standard=sdtmig version=3-4
#define column-order DM STUDYID DOMAIN USUBJID AGE
#expectViolationCount 1
#expectViolationAt "$missing_define_variables"="[AGE]"
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
S1 | DM | S1-001
