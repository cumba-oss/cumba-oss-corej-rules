#!RuleTest
#test FDA-SD0075 expect=violation domain=SUPPAE
#note "SUPP-- branch of the scope: row 2 names IDVAR=AENUM which is not a column of AE -> fires. Row 1 (AESEQ) is valid."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 IDVAR=AENUM
dataset SUPPAE class=RELATIONSHIP label="Supplemental Qualifiers for AE"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM     type=Char label="Qualifier Variable Name"
col QLABEL   type=Char label="Qualifier Variable Label"
col QVAL     type=Char label="Data Value"
col QORIG    type=Char label="Origin"
---
S1 | AE | 001 | AESEQ | 1 | AESOSP | Other Serious Event | Y | CRF
S1 | AE | 001 | AENUM | 1 | AESOSP | Other Serious Event | Y | CRF
---

dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE
