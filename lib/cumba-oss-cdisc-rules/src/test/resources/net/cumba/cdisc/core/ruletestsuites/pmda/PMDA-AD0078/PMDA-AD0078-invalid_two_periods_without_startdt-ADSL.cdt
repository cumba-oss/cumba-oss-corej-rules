#!RuleTest
#test PMDA-AD0078 expect=violation domain=ADSL
#note "Expansion-arithmetic pin. TRT01P is filtered out by min=2; TRT02P and TRT03P each seed an expansion and each fires -> the aggregated total is 2 violations, both at reported row 1. Two #expectViolationAt lines are required because the match is an exact multiset."
#library standard=adamig version=1-3
#expectViolationCount 2
#expectViolationAt row=1 TRT02P=DRUGA
#expectViolationAt row=1 TRT03P=DRUGB
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRT01P  type=Char
col TRT02P  type=Char
col TRT03P  type=Char
---
CDISCPILOT01 | 01-701-1015 | PLACEBO | DRUGA | DRUGB
