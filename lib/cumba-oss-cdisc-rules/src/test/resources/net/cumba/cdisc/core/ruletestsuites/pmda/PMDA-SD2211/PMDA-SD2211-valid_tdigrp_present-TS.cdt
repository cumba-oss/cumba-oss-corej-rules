#!RuleTest
#test PMDA-SD2211 expect=noViolation domain=TS
#note "$tdigrp_count = 1 -> second conjunct false -> silent."
#library standard=sdtmig version=3-4
dataset TS label="Trial Summary"
col STUDYID  type=Char
col DOMAIN   type=Char
col TSSEQ    type=Num
col TSPARMCD type=Char
col TSPARM   type=Char
col TSVAL    type=Char
---
S01 | TS | 1 | TITLE    | Trial Title              | A Phase 3 Study of Drug X in Subjects With Asthma
S01 | TS | 2 | HLTSUBJI | Healthy Subject Indicator | N
S01 | TS | 3 | TDIGRP   | Diagnosis Group           | ASTHMA
