#!RuleTest
#test FDA-SD1282 expect=noViolation domain=PC
#note "Branch 3: PCTPT is present alongside PCTPTREF -> the --TPT not_exists leaf is false -> no violation."
#library standard=sdtmig version=3-4
dataset PC class=FINDINGS label="Pharmacokinetic Concentrations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PCSEQ    type=Num  label="Sequence Number"
col PCTESTCD type=Char label="Pharmacokinetic Test Short Name"
col PCTPTREF type=Char label="Time Point Reference"
col PCTPT    type=Char label="Planned Time Point Name"
---
CDISCPILOT01 | PC | 01-701-1015 | 1 | DRUGA | DOSE ADMINISTRATION | 1H POST-DOSE
---
