#!RuleTest
#test FDA-CT2006 expect=violation domain=QS
#note "Row 2 carries QSTESTCD='WALK' under the value-level condition QSCAT='FUNC' but decodes it as 'Grip Strength', which belongs to the GRIP term -> fires. Row 1 is the correct pairing; row 3 does not match the value-level condition; row 4's code is not a term of the value-level codelist."
#library standard=sdtmig version=3-4
#define-xml FDA-CT2006-define.xml
#expectViolationCount 1
#expectViolationAt row=2 QSTESTCD=WALK
dataset QS class=FINDINGS label="Questionnaires"
col USUBJID  type=Char label="Unique Subject Identifier"
col QSCAT    type=Char label="Category of Question"
col QSTESTCD type=Char label="Question Short Name"
col QSTEST   type=Char label="Question Name"
---
001 | FUNC  | WALK | Walk Test
001 | FUNC  | WALK | Grip Strength
001 | OTHER | WALK | Grip Strength
001 | FUNC  | XYZZ | Unknown Test
