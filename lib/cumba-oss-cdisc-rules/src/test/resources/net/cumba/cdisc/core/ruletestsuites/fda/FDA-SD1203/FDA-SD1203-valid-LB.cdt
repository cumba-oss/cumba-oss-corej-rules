#!RuleTest
#test FDA-SD1203 expect=noViolation domain=LB
#note "Row 1: LBDTC equal to RFPENDTC -> boundary, strict greater-than does not fire. Row 2: LBDTC before RFPENDTC -> ok. Row 3: LBDTC empty -> ok. Row 4: subject with empty RFPENDTC -> guard DM.RFPENDTC non_empty blocks."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBDTC    type=Char label="Date/Time of Specimen Collection"
---
S1 | LB | 001 | 1 | ALB  | 2020-06-30
S1 | LB | 001 | 2 | ALT  | 2020-03-15
S1 | LB | 001 | 3 | AST  |
S1 | LB | 002 | 1 | ALB  | 2021-01-01
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFPENDTC type=Char label="Date/Time of End of Participation"
---
S1 | DM | 001 | 2020-06-30
S1 | DM | 002 |
---
