#!RuleTest
#test PMDA-AD0342 expect=violation domain=ADLBC
#note "PARAMCD + AVAL detect BASIC DATA STRUCTURE. No wildcards -- ANRLO and ANRLOC are concrete ADaMIG names. Key is the pair [PARAMCD, ANRLOC]. Group (GLUC, LOWNORM) holds ANRLO {3 x2, 4 x1} -> row 3 is the lone minority. Row 4 shares ANRLOC but has a different PARAMCD and forms its own single-valued group."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 PARAMCD=GLUC ANRLO=4 ANRLOC=LOWNORM
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col ANRLO   type=Num
col ANRLOC  type=Char
---
S1 | 001 | GLUC | 5.0 | 3 | LOWNORM
S1 | 002 | GLUC | 5.1 | 3 | LOWNORM
S1 | 003 | GLUC | 5.2 | 4 | LOWNORM
S1 | 004 | ALB  | 4.0 | 1 | LOWNORM
