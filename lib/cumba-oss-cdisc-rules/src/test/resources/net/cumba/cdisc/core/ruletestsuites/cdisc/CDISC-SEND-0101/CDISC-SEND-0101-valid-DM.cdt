#!RuleTest
#test CDISC-SEND-0101 expect=noViolation domain=DM
#note "As invalid plus a define declaration for RFENDTC."
#library standard=sendig version=3-1-1
#define variable-metadata DM STUDYID name=STUDYID label="Study Identifier"
#define variable-metadata DM USUBJID name=USUBJID label="Unique Subject Identifier"
#define variable-metadata DM RFENDTC name=RFENDTC label="Subject Reference End Date/Time"
dataset DM
col STUDYID type=Char
col USUBJID type=Char
col RFENDTC type=Char
---
S1 | S1-001 | 2020-06-30
