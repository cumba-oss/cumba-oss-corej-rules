#!RuleTest
#test FDA-SD1328 expect=noViolation domain=RELSUB
#note "RSUBJID always names a different subject than USUBJID."
#library standard=sdtmig version=3-4
dataset RELSUB label="Related Subjects"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col POOLID  type=Char label="Pool Identifier"
col RSUBJID type=Char label="Related Subject or Pool Identifier"
col SREL    type=Char label="Subject Relationship"
---
CDISCPILOT01 | 01-701-1015 |  | 01-701-1016 | MOTHER, BIOLOGICAL
CDISCPILOT01 | 01-701-1023 |  | 01-701-1024 | SIBLING, BIOLOGICAL
