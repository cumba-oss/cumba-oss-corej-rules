#!RuleTest
#test PMDA-AD0381 expect=violation domain=ADLBC
#note "Group (BTOXGRN=3, GLUC) holds BTOXGR {GRADE3, GRADE3, GRADE4} -> minority row 3 fires through the FIRST arm. No other pair is declared: every extra populated pair would be another live arm and another possible violation."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=01-701-1034 PARAMCD=GLUC BTOXGR=GRADE4 BTOXGRN=3
dataset ADLBC
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col BTOXGR   type=Char
col BTOXGRN  type=Num
---
CDISCPILOT01 | 01-701-1015 | GLUC | GRADE3 | 3
CDISCPILOT01 | 01-701-1023 | GLUC | GRADE3 | 3
CDISCPILOT01 | 01-701-1034 | GLUC | GRADE4 | 3
