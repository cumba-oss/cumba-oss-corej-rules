#!RuleTest
#test FDA-SE1156 expect=noViolation domain=DM
#note "The Challenge Agent Characterization (AC) dataset is present in the study inventory alongside DM -> no violation."
#library standard=sendig-ar version=1-0
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col SETCD   type=Char label="Set Code"
---
STUDY01 | DM | STUDY01-001 | 001 | SET1
---

dataset AC class="TRIAL DESIGN" label="Challenge Agent Characterization"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col ACSEQ    type=Num  label="Sequence Number"
col ACPARMCD type=Char label="Challenge Agent Parameter Short Name"
col ACPARM   type=Char label="Challenge Agent Parameter"
col ACVAL    type=Char label="Challenge Agent Parameter Value"
---
STUDY01 | AC | 1 | AGENT | Challenge Agent | BACILLUS ANTHRACIS
---
