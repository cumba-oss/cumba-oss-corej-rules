#!RuleTest
#test PMDA-AD0001 expect=noViolation domain=ADAE
#note "Proves ds_exists reads the STUDY INVENTORY, not the dataset under evaluation. ADAE is primary; ADSL is a secondary block registered under its own name -> ADSL exists in the study even though the rule executes against ADAE -> no violation. Same construction as pmda/PMDA-AD1024/PMDA-AD1024-valid-ADSL.cdt."
#expectViolationCount 0
#library standard=adamig version=1-3
dataset ADAE label="Adverse Events Analysis Dataset"
col STUDYID type=Char
col USUBJID type=Char
col AEDECOD type=Char
