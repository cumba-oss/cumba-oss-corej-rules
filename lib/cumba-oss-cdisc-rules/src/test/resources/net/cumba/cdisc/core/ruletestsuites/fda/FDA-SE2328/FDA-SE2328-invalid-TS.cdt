#!RuleTest
#test FDA-SE2328 expect=violation domain=TS
#note "No TSPARMCD=STENDTC record anywhere in TS -> the 'Nonclinical Study End Date' parameter is missing, one dataset-level finding. the near-miss parameters STSTDTC / DOSENDTC / EXPENDTC all end in DTC, so a loose match on the filter would wrongly silence the rule."
#library standard=sendig version=3-1-1
#expectViolationCount 1
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | STSTDTC  | Nonclinical Study Start Date               | 2020-12-14
S01 | TS | 2 | DOSENDTC | End Date Time Of Dose Interval             | 2021-03-08
S01 | TS | 3 | EXPENDTC | Experiment End Date                        | 2021-03-10
