#!RuleTest
#test CDISC-CG0197 expect=noViolation domain=PE
#note "Row 1's PESTRESC 'Headache' is a MedDRA Preferred Term of the (dummy) dictionary; row 2's upper-case 'HEADACHE' passes too under the explicit case_sensitive: false (CL-G.4, the pre-TA-3 insensitive behaviour restored)."
#library standard=sdtmig version=3-4
#dictionaries dummy
dataset PE class=FINDINGS label="Physical Examination"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PESEQ    type=Num  label="Sequence Number"
col PETESTCD type=Char label="Body System Examined Short Name"
col PEORRES  type=Char label="Verbatim Examination Finding"
col PESTRESC type=Char label="Examination Result in Std Format"
---
S1 | PE | 001 | 1 | HEAD | pain in head | Headache
S1 | PE | 001 | 2 | HEAD | pain in head | HEADACHE
