#!RuleTest
#test FDA-SD1149 expect=noViolation domain=AE
#note "AESER (Expected, core=Exp per the IG metadata) is populated on at least one record -> not empty for all records -> no violation."
#library standard=sdtmig version=3-4
#library-include FDA-SD1149-library.yaml
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESER   type=Char label="Serious Event"
---
S1 | AE | 001 | 1 | HEADACHE | N
S1 | AE | 001 | 2 | NAUSEA   |
S1 | AE | 002 | 1 | FATIGUE  | Y
