#!RuleTest
#test FDA-SE0056 expect=violation domain=BW
#note "The SEND IG declares BWTESTCD Required for BW but the submitted dataset does not carry the column -> one dataset-level finding naming the missing Required variable."
#library standard=sendig version=3-1-1
#library required-variables BW STUDYID DOMAIN USUBJID BWSEQ BWTESTCD
#expectViolationCount 1
dataset BW label="Body Weight"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col BWSEQ   type=Num  label="Sequence Number"
---
S1 | BW | 001 | 1
