#!RuleTest
#test PMDA-AD0147B expect=violation domain=ADLBC
#note "Group PARAM=Albumin holds PARAMN {1 x2, 2 x1} -> row 3 is the minority. The pin value 2 is compared numerically against the stored 2.0."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 PARAMN=2 PARAM=Albumin
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col PARAM   type=Char
col PARAMN  type=Num
---
S1 | 001 | ALB  | Albumin   | 1
S1 | 002 | ALB  | Albumin   | 1
S1 | 003 | ALB  | Albumin   | 2
S1 | 001 | BILI | Bilirubin | 3
S1 | 002 | BILI | Bilirubin | 3
