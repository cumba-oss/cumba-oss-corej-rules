#!RuleTest
#test FDA-SD0053 expect=violation domain=DM
#note "Row 1: ARMCD='NOTASSGN' but ARM='Not assigned to arm' (not the required 'Not Assigned') -> fires."
#library standard=sdtmig version=3-2
#expectViolationCount 1
#expectViolationAt row=1 ARMCD=NOTASSGN ARM="Not assigned to arm"
dataset DM
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
---
S1 | DM | 001 | NOTASSGN | Not assigned to arm
S1 | DM | 002 | NOTASSGN | Not Assigned
S1 | DM | 003 | A        | Placebo
