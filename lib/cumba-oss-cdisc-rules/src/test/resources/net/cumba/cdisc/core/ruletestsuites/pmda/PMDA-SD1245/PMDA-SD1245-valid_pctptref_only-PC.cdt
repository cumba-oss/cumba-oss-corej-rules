#!RuleTest
#test PMDA-SD1245 expect=noViolation domain=PC
#note "The DIRECTION discriminator: the rule conditions on PCRFTDTC being present, so PCTPTREF-without-PCRFTDTC must NOT fire (first conjunct false)."
#library standard=sdtmig version=3-4
dataset PC class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col PCSEQ    type=Num
col PCTPTREF type=Char
---
S1 | PC | 001 | 1 | DOSING
