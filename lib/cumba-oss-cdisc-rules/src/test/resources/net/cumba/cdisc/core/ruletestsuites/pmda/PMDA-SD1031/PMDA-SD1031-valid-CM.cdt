#!RuleTest
#test PMDA-SD1031 expect=noViolation domain=CM
#note "Both subjects have DM.RFENDTC populated, so a populated CMENRF is legitimate. Row 2 additionally leaves CMENRF empty, which the not-empty conjunct skips."
#library standard=sdtmig version=3-4
dataset CM class=INTERVENTIONS label="Concomitant/Prior Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ   type=Num  label="Sequence Number"
col CMTRT   type=Char label="Reported Name of Drug, Med, or Therapy"
col CMENRF  type=Char label="End Relative to Reference Period"
---
S1 | CM | 001 | 1 | ASPIRIN | AFTER
S1 | CM | 002 | 1 | ASPIRIN |
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFENDTC type=Char label="Subject Reference End Date/Time"
---
S1 | DM | 001 | 2020-06-30
S1 | DM | 002 | 2020-06-30
