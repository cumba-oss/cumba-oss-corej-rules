#!RuleTest
#test PMDA-SD1017 expect=violation domain=SV
#note "Row 2 is a planned visit (SVUPDES empty) whose VISITNUM=9 appears nowhere in TV -> fires. Row 1 matches TV; row 3 is unplanned (SVUPDES populated) and exempt."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 VISITNUM=9
dataset SV class="SPECIAL PURPOSE" label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col SVUPDES  type=Char label="Description of Unplanned Visit"
---
S1 | SV | 001 | 1 | SCREENING   |
S1 | SV | 001 | 9 | EXTRA VISIT |
S1 | SV | 001 | 8 | UNPLANNED   | Early discontinuation visit
---

dataset TV class="TRIAL DESIGN" label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
S1 | TV | 1 | SCREENING
S1 | TV | 2 | WEEK 2
