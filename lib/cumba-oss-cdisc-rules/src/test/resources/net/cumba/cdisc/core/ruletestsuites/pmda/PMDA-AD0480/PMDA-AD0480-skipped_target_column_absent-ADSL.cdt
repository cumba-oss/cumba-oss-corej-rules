#!RuleTest
#test PMDA-AD0480 expect=skipped domain=ADSL
#note "STRAT1V is not declared. The expansion IS seeded (by STRAT1VN, w=1) and STRAT1V is synthesised absent; the expanded Requirements.Variables.All is then the concrete STRAT1V, which the dataset does not carry, so RuleRunner skips. Different skip mechanism from the NoMatch case - here the template matched, the variable scope rejected."
#library standard=adamig version=1-3
dataset ADSL
col STUDYID  type=Char
col USUBJID  type=Char
col STRAT1VN type=Num
---
S1 | 001 | 1
S1 | 002 | 2
---
