#!RuleTest
#test CDISC-AD0891 expect=violation domain=ADNCA
# Rule:Description: Raise an error when, within the study, an ADNCA v1.0 dataset has more than one value of COHORTN for a given value of COHORT (considering only rows on which both variables are populated).
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015
#expectViolationAt row=2 USUBJID=01-701-1023
dataset ADNCA
col STUDYID type=Char
col USUBJID type=Char
col COHORTN type=Char
col COHORT type=Char
col PARAMCD type=Char
col NFRLT type=Num
col AFRLT type=Num
---
CDISCPILOT01 | 01-701-1015 | 1 | 1 | CONC | 0 | 0.5
CDISCPILOT01 | 01-701-1023 | 2 | 1 | CONC | 0 | 0.5
CDISCPILOT01 | 01-701-1028 | 3 | 2 | CONC | 0 | 0.5
---
