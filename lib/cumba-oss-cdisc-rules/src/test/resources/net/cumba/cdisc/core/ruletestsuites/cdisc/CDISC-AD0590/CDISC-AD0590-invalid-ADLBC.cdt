#!RuleTest
#test CDISC-AD0590 expect=violation domain=ADLBC
# Rule:Description: A variable is present with the same name as a variable present in ADSL but the variables do not have identical data types
#note "AGE is Num in ADLBC but Char in ADSL -> different data types -> violation"
#expectViolationCount 1
#expectViolationAt variable_data_type=Num variable_name=AGE
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col AGE type=Num label="Age"
