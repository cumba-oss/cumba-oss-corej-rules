#!RuleTest
#test CDISC-SEND-0012-A expect=noViolation domain=BW
#note "Every SENDIG-Required variable for BW is populated on every record; BWSTRESU is empty on row 2 but is not Required -> no violation."
#library standard=sendig version=3-1-1
#library required-variables BW STUDYID DOMAIN USUBJID BWSEQ BWTESTCD
dataset BW label="Body Weight"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col BWSEQ    type=Num  label="Sequence Number"
col BWTESTCD type=Char label="Body Weight Test Short Name"
col BWSTRESU type=Char label="Unit of the Standardized Result"
---
S1 | BW | 001 | 1 | BW | g
S1 | BW | 001 | 2 | BW |
