#!RuleTest
#test PMDA-SD1088 expect=violation domain=AE
#note "ADAPTED-FROM fda/FDA-SD1088/FDA-SD1088-invalid-AE.cdt verbatim (AE class=EVENTS + DM class=\"SPECIAL PURPOSE\", both fenced). Row 1: complete AESTDTC 2020-01-10, complete RFSTDTC 2020-01-01, AESTDY '.' -> fires; row 2 AESTDY populated -> clean."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESTDTC type=Char label="Start Date/Time of Adverse Event"
col AESTDY  type=Num  label="Study Day of Start of Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE | 2020-01-10 | .
S1 | AE | 001 | 2 | NAUSEA   | 2020-01-12 | 12
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
---
S1 | DM | 001 | 2020-01-01
---
