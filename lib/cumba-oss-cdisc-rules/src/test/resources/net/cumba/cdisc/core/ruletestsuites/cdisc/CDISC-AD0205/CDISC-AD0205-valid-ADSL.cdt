#!RuleTest
#test CDISC-AD0205 expect=noViolation domain=ADSL
# Rule:Description: The value of ADSL.USUBJID is equal to the value of DM.USUBJID and ADSL.AGEU is not equal to DM.AGEU
#note "same USUBJID, ADSL.AGEU == DM.AGEU -> noViolation"
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col AGEU type=Char
---
CDISCPILOT01 | 01-701-1015 | YEARS
---

dataset DM label=Demographics
col STUDYID type=Char
col DOMAIN type=Char
col USUBJID type=Char
col AGEU type=Char
---
CDISCPILOT01 | DM | 01-701-1015 | YEARS
---
