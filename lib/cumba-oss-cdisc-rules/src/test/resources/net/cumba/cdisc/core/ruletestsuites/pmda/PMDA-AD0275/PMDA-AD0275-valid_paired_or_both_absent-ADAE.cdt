#!RuleTest
#test PMDA-AD0275 expect=noViolation domain=ADAE
#note "Negative control. Both columns are declared, so the rule executes; two rows carry DOSECUM and DOSECUMU together and one carries neither. Neither arm of the paired-population disjunction holds, so the rule stays silent."
#library standard=adamig version=1-0
dataset ADAE
col STUDYID  type=Char
col USUBJID  type=Char
col AEDECOD  type=Char
col DOSECUM  type=Num
col DOSECUMU type=Char
