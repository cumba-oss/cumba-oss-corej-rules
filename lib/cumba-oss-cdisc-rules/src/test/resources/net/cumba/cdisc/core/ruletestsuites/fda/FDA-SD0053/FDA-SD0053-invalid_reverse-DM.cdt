#!RuleTest
#test FDA-SD0053 expect=violation domain=DM
#note "Second branch ('vice versa'): row 1 carries ARM='Not Assigned' while ARMCD='NOTASGN' is not 'NOTASSGN' -> fires."
#library standard=sdtmig version=3-2
#expectViolationCount 1
#expectViolationAt row=1 ARMCD=NOTASGN ARM="Not Assigned"
dataset DM
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
---
S1 | DM | 001 | NOTASGN  | Not Assigned
S1 | DM | 002 | NOTASSGN | Not Assigned
S1 | DM | 003 | A        | Placebo
