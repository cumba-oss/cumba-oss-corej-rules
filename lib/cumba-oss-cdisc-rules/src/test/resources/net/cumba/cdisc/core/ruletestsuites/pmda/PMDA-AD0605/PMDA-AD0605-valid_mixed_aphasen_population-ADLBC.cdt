#!RuleTest
#test PMDA-AD0605 expect=noViolation domain=ADLBC
#note "MECHANISM PIN (Fix #269 / EC-84) - the under-reach half. Row 1 carries a populated APHASEN whose PHSDT MATCHES ADSL.PH1SDT, so it survives conjuncts 1-2 and keeps the candidate mask non-empty: the substituted comparison IS evaluated (this is what makes the assertion non-vacuous - an all-blank fixture would short-circuit before the leaf and pass with the fix removed). Row 2's blank APHASEN resolves to `no value` instead of throwing, and is excluded by the rule's own guard, so despite a populated PHSDT of 23500 it does not fire. 0 violations."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADLBC structure=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVAL     type=Num
col APHASEN  type=Num
col PHSDT    type=Num
---
S1 | 01-701-1015 | ALB | 30 | 1 | 23000
S1 | 01-701-1023 | ALB | 31 | . | 23500
---

dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col PH1SDT  type=Num
---
S1 | 01-701-1015 | 23000
S1 | 01-701-1023 | 23000
