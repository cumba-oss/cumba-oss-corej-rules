#!RuleTest
#test PMDA-SD0067 expect=violation domain=SE
#note "Row 2 ETCD=FOLLOWUP is not in TE and is not 'UNPLAN' -> fires. Row 3 ADDS the blank-ETCD mechanism probe: no emptiness guard exists on this rule, so '' passes != \"UNPLAN\" and is probed literally against $te_etcd = {SCRN, TRT} (blank-free) -> fires."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=2 ETCD=FOLLOWUP
#expectViolationAt row=3 ETCD=
dataset SE class="SPECIAL PURPOSE" label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ   type=Num  label="Sequence Number"
col ETCD    type=Char label="Element Code"
col ELEMENT type=Char label="Description of Element"
---
S1 | SE | 001 | 1 | SCRN     | Screening
S1 | SE | 001 | 2 | FOLLOWUP | Follow-up
S1 | SE | 001 | 3 |          | Unknown Element
---

dataset TE class="TRIAL DESIGN" label="Trial Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ETCD    type=Char label="Element Code"
col ELEMENT type=Char label="Description of Element"
---
S1 | TE | SCRN | Screening
S1 | TE | TRT  | Treatment
---
