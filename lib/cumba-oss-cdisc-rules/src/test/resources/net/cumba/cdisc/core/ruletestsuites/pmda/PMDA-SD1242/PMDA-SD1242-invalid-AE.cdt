#!RuleTest
#test PMDA-SD1242 expect=violation domain=AE
#note "Sheet direction: AEBDSYCD 10029205 maps to two AEBODSYS spellings ('Nervous system disorders' vs 'NERVOUS SYSTEM DISORDERS') -> fires on both rows carrying that code."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 AEBDSYCD=10029205
#expectViolationAt row=3 AEBDSYCD=10029205
dataset AE class=EVENTS label="Adverse Events"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col AESEQ    type=Num  label="Sequence Number"
col AETERM   type=Char label="Reported Term for the Adverse Event"
col AEBODSYS type=Char label="Body System or Organ Class"
col AEBDSYCD type=Num  label="Body System or Organ Class Code"
---
S1 | AE | 001 | 1 | Headache | Nervous system disorders   | 10029205
S1 | AE | 001 | 2 | Nausea   | Gastrointestinal disorders | 10017947
S1 | AE | 002 | 1 | Migraine | NERVOUS SYSTEM DISORDERS   | 10029205
