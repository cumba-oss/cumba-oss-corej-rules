#!RuleTest
#test CDISC-AD0472 expect=violation domain=ADSL
# Rule:Description: There is more than one value of STRATwR for a given value of STRATwRN, considering only those rows on which both variables are populated
#note "same STRAT1RN=G1 maps to two distinct STRAT1R values -> violation"
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015
#expectViolationAt row=2 USUBJID=01-701-1023
dataset ADSL class=ADSL
col STUDYID type=Char
col USUBJID type=Char
col STRAT1R type=Char
col STRAT1RN type=Char
---
CDISCPILOT01 | 01-701-1015 | a1 | G1
CDISCPILOT01 | 01-701-1023 | a2 | G1
---
