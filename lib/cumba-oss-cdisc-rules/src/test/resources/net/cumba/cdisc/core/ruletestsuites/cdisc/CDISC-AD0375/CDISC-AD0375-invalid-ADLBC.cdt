#!RuleTest
#test CDISC-AD0375 expect=violation domain=ADLBC
# Rule:Description: On a given record, a variable which has a suffix of GRyN is populated and a variable with the same root name and suffix of GRy is not populated
#note "AETOXGR1N populated, AETOXGR1 empty -> violation"
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col AETOXGR1N type=Char
col AETOXGR1 type=Char
---
CDISCPILOT01 | 01-701-1015 | VAL | 
