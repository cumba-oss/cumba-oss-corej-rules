#!RuleTest
#test DRAFT-900021 expect=violation domain=VS
#note "define.xml enumerates BOGUS/BOGUS2 for VSPOS/VSLAT, neither a published term of the non-extensible library codelist -> two ItemDef findings (Record sensitivity, one per offending ItemDef). VSTESTCD has no library codelist, so the extensibility guard excludes it even though the define enumerates it too."
#library standard=sdtmig version=3-4
#library variable-metadata VS VSPOS codelist=C71148 codelist_extensible=false codelist_coded_values="[\"SUPINE\",\"STANDING\"]"
#library variable-metadata VS VSLAT codelist=C99074 codelist_extensible=false codelist_coded_values="[\"LEFT\",\"RIGHT\"]"
#define domain-variables VS VSTESTCD:Topic VSPOS:Qualifier VSLAT:Qualifier
#define variable-metadata VS VSPOS name=VSPOS codelist_coded_values="[\"SUPINE\",\"BOGUS\"]"
#define variable-metadata VS VSLAT name=VSLAT codelist_coded_values="[\"LEFT\",\"BOGUS2\"]"
#define variable-metadata VS VSTESTCD name=VSTESTCD codelist_coded_values="[\"SYSBP\"]"
#expectViolationCount 2
#expectViolationAt variable_name=VSPOS define_variable_name=VSPOS
#expectViolationAt variable_name=VSLAT define_variable_name=VSLAT
dataset VS class=FINDINGS
col USUBJID  type=Char
col VSTESTCD type=Char
col VSPOS    type=Char
col VSLAT    type=Char
---
001 | SYSBP | SUPINE | LEFT
---
