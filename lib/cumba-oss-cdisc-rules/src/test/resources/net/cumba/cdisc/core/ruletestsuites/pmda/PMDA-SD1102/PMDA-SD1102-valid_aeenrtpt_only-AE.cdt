#!RuleTest
#test PMDA-SD1102 expect=noViolation domain=AE
#note "The DIRECTION discriminator: the rule conditions on AEENTPT being present, so AEENRTPT-without-AEENTPT must NOT fire (first conjunct false)."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col AESEQ    type=Num
col AEENRTPT type=Char
---
S1 | AE | 001 | 1 | ONGOING
