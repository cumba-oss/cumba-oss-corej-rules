#!RuleTest
#test FDA-SD0038 expect=violation domain=DM
#note "Second domain shape: the DY$ variable-name pattern must also pick up DMDY in DM (the sheet lists CO, DM, SE, SM, SV alongside the observation classes). DMDY=0 on row 1 fires."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DMDY    type=Num  label="Study Day of Collection"
---
CDISCPILOT01 | DM | 01-701-1015 | 0
CDISCPILOT01 | DM | 01-701-1023 | 1
