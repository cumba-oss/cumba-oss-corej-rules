#!RuleTest
#test FDA-SD1089 expect=violation domain=AE
#note "Row 1: AESTDY populated with partial AESTDTC (2020-06) -> fires. Row 2: 002 has AESTDY populated, complete AESTDTC but partial RFSTDTC (2020) -> fires. Row 3: all complete -> no fire."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=001
#expectViolationAt row=2 USUBJID=002
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESTDTC type=Char label="Start Date/Time of Adverse Event"
col AESTDY  type=Num  label="Study Day of Start of Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE | 2020-06    | 5
S1 | AE | 002 | 1 | NAUSEA   | 2020-01-10 | 10
S1 | AE | 001 | 2 | FATIGUE  | 2020-01-12 | 12
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
---
S1 | DM | 001 | 2020-01-01
S1 | DM | 002 | 2020
---
