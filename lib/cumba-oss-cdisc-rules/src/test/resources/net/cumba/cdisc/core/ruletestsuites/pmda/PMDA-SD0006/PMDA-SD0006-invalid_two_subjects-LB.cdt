#!RuleTest
#test PMDA-SD0006 expect=violation domain=LB
#note "FRESH - the per-GROUP counting pin (no twin covers 2 violating subjects). Subject 001 (blank, N) and subject 002 (blank, blank) are both violating groups; subject 003 has a baseline record and is clean. No exemptions apply. TWO findings, one per violating subject, not four (count-only pin; if 4 comes back, escalate - would refute the group fold)."
#library standard=sdtmig version=3-4
#expectViolationCount 2
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test Short Name"
col LBBLFL   type=Char label="Baseline Flag"
---
S1 | LB | 001 | 1 | ALB |
S1 | LB | 001 | 2 | ALB | N
S1 | LB | 002 | 1 | ALB |
S1 | LB | 002 | 2 | ALB |
S1 | LB | 003 | 1 | ALB | Y
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARMCD    type=Char label="Planned Arm Code"
col ARM      type=Char label="Description of Planned Arm"
col ACTARMCD type=Char label="Actual Arm Code"
---
S1 | DM | 001 | ARM1 | Arm 1 | ARM1
S1 | DM | 002 | ARM1 | Arm 1 | ARM1
S1 | DM | 003 | ARM1 | Arm 1 | ARM1
---
