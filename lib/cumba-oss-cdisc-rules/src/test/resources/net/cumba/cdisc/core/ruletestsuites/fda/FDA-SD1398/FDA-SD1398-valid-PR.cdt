#!RuleTest
#test FDA-SD1398 expect=noViolation domain=PR
#note "Guard boundaries, all clean: row 1 fully conformant; row 2 PRENDTC incomplete (year-month) so a missing PRCHENDY is tolerated; row 3 subject 002 whose DM.RFCSTDTC is empty; row 4 PRENDTC empty."
#library standard=sendig version=ar-1-0
dataset PR class=INTERVENTIONS label="Procedures"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PRSEQ    type=Num  label="Sequence Number"
col PRTRT    type=Char label="Name of Procedure"
col PRENDTC  type=Char label="End Date/Time of Procedure"
col PRCHENDY type=Num  label="End Day of Obs Rel to Challenge Agent"
---
S1 | PR | 001 | 1 | BIOPSY | 2020-01-12 | 8
S1 | PR | 001 | 2 | BIOPSY | 2020-01    | .
S1 | PR | 002 | 1 | BIOPSY | 2020-01-12 | .
S1 | PR | 001 | 3 | BIOPSY |            | .
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFCSTDTC type=Char label="Date/Time of First Challenge Agent Admin"
---
S1 | DM | 001 | 2020-01-05
S1 | DM | 002 |
---
