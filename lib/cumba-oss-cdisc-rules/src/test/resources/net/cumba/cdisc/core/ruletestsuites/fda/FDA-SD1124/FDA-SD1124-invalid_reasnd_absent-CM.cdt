#!RuleTest
#test FDA-SD1124 expect=violation domain=CM
#note "column-absent case on the INTERVENTIONS arm: CMSTAT='NOT DONE' and the dataset carries no CMREASND column at all, so the bare empty(--REASND) leaf is TRUE on every row (absent = all-missing, EC-43) -> fires. (Plan B phase 4d' deleted the `or not var_exists(--REASND)` disjunct this note used to name; the verdict is unchanged.)"
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 CMSTAT="NOT DONE"
dataset CM class=INTERVENTIONS label="Concomitant Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ   type=Num  label="Sequence Number"
col CMTRT   type=Char label="Reported Name of Drug, Med, or Therapy"
col CMSTAT  type=Char label="Completion Status"
---
CDISCPILOT01 | CM | 01-701-1015 | 1 |         | NOT DONE
CDISCPILOT01 | CM | 01-701-1015 | 2 | ASPIRIN |
