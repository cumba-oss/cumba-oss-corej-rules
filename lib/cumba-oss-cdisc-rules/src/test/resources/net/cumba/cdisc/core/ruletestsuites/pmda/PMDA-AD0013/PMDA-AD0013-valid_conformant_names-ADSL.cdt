#!RuleTest
#test PMDA-AD0013 expect=noViolation domain=ADSL
#note "Every name is 1-8 characters, starts with an upper-case letter and uses only letters/digits/underscore -> the rule EXECUTES and stays silent."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col AGE     type=Num
col SEX     type=Char
col TRT01P  type=Char
col SAFFL   type=Char
---
CDISCPILOT01 | 01-701-1015 | 56 | F | PLACEBO | Y
