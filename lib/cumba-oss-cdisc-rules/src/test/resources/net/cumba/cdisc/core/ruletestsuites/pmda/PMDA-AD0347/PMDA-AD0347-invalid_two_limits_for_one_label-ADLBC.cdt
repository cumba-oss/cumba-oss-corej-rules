#!RuleTest
#test PMDA-AD0347 expect=violation domain=ADLBC
#note "AyLO/AyLOC expand against A1LO/A1LOC (y=1, inside the rule's _wildcards range 1..99). Group (PARAMCD=ALB, A1LOC=LOWNORMAL) holds A1LO {10 x2, 12 x1} -> row 3 is the minority. Naming trap: A(digits)LO$ does NOT match A1LOC (anchored), and neither pattern matches AVAL or ANRLO."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 A1LO=12 A1LOC=LOWNORMAL PARAMCD=ALB
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col A1LO    type=Num
col A1LOC   type=Char
---
S1 | 001 | ALB | 10 | LOWNORMAL
S1 | 002 | ALB | 10 | LOWNORMAL
S1 | 003 | ALB | 12 | LOWNORMAL
S1 | 004 | ALB | 8  | BELOWNORMAL
S1 | 005 | ALB | 8  | BELOWNORMAL
