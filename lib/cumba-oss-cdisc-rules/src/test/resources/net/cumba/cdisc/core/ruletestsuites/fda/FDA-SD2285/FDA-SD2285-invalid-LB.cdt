#!RuleTest
#test FDA-SD2285 expect=violation domain=LB
#note "Row 2: LBLOINC=9999-9 is not a LOINC code in the dummy dictionary -> fires. Row 1 is a valid LOINC code; row 3 is blank (no fire)."
#library standard=sdtmig version=3-4
#dictionaries dummy
#expectViolationCount 1
#expectViolationAt row=2 LBSEQ=2 LBLOINC=9999-9
dataset LB class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
col LBLOINC  type=Char
---
S01 | LB | 001 | 1 | GLUCF | 1558-6
S01 | LB | 001 | 2 | GLUC  | 9999-9
S01 | LB | 002 | 1 | ALB   |
