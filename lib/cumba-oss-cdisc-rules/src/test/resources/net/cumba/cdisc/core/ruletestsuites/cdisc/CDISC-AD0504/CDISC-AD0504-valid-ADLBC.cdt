#!RuleTest
#test CDISC-AD0504 expect=noViolation domain=ADLBC
# Rule:Description: A variable ending in TM must contain "Time" in the label
#note "ATM label contains "Time" -> noViolation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ATM type=Char label="Analysis Time"
