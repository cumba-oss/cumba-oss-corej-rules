#!RuleTest
#test PMDA-SD1094 expect=noViolation domain=AE
#note "Row 1: AEENDTC 2020-01-20 vs RFSTDTC 2020-01-01 -> study day 20 = AEENDY. Row 2: AEENDTC 2019-12-30 precedes RFSTDTC -> -2 = AEENDY (no day zero). -> no violation."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEENDTC type=Char label="End Date/Time of Adverse Event"
col AEENDY  type=Num  label="Study Day of End of Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE | 2020-01-20 | 20
S1 | AE | 001 | 2 | NAUSEA   | 2019-12-30 | -2
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
---
S1 | DM | 001 | 2020-01-01
---
