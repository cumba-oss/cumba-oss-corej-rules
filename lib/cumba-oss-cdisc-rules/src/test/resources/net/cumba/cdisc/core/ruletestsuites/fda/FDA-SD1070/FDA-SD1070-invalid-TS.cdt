#!RuleTest
#test FDA-SD1070 expect=violation domain=TS
#note "The parameter name 'Trial Title' is coded both TITLE and TTITLE, so --PARMCD is not constant for a given --PARM. Both records of the conflicting pair are reported."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 TSPARM="Trial Title" TSPARMCD=TITLE
#expectViolationAt row=2 TSPARM="Trial Title" TSPARMCD=TTITLE
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S1 | TS | 1 | TITLE  | Trial Title                | A Study
S1 | TS | 2 | TTITLE | Trial Title                | A Study
S1 | TS | 3 | TPHASE | Trial Phase Classification | PHASE III
