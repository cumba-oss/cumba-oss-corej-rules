#!RuleTest
#test FDA-SD1318 expect=violation domain=DS
#note "Second any-branch: subject 001 has DSDECOD='PROTOCOL DEVIATION' (not VIOLATION) and no DV record -> must fire as well."
#library standard=sdtmig version=3-4
#expectViolationCount 1
dataset DS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSTERM  type=Char label="Reported Term for the Disposition Event"
col DSDECOD type=Char label="Standardized Disposition Term"
---
S1 | DS | 001 | 1 | Protocol deviation | PROTOCOL DEVIATION
S1 | DS | 002 | 1 | Completed          | COMPLETED
---

dataset DV label="Protocol Deviations"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DVSEQ   type=Num  label="Sequence Number"
col DVTERM  type=Char label="Protocol Deviation Term"
---
S1 | DV | 002 | 1 | Visit outside window
---
