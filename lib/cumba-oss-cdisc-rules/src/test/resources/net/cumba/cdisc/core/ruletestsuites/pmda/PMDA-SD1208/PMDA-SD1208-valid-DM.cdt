#!RuleTest
#test PMDA-SD1208 expect=noViolation domain=DM
#note "Sheet: RFXSTDTC must be less than or equal to RFXENDTC. Subject 1 first treatment < last treatment, subject 2 was treated once (equal), subject 3 has no last-treatment date."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SUBJID   type=Char label="Subject Identifier for the Study"
col RFXSTDTC type=Char label="Date/Time of First Study Treatment"
col RFXENDTC type=Char label="Date/Time of Last Study Treatment"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015 | 2020-01-05 | 2020-06-20
CDISCPILOT01 | DM | 01-701-1023 | 1023 | 2020-02-10 | 2020-02-10
CDISCPILOT01 | DM | 01-701-1028 | 1028 | 2020-03-11 |
