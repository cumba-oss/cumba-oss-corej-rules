#!RuleTest
#test PMDA-AD0124 expect=noViolation domain=ADLBC
#note "Row 3 now carries PARCAT1=LABS, so every PARAMCD maps to exactly one PARCAT1 -> nothing flagged."
#library standard=adamig version=1-3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col PARCAT1 type=Char
---
S1 | 001 | GLUC | LABS
S1 | 002 | GLUC | LABS
S1 | 003 | GLUC | LABS
S1 | 004 | ALB  | CHEMISTRY
S1 | 005 | ALB  | CHEMISTRY
