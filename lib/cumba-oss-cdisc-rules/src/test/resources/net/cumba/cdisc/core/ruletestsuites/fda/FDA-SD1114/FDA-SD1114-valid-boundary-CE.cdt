#!RuleTest
#test FDA-SD1114 expect=noViolation domain=CE
#note "Boundary twin on CE (the sheet also scopes CE): CEBODSYS resolves the --BODSYS wildcard outside AE; a valid SOC in mixed case passes (case-insensitive) and the empty CEBODSYS on row 2 does not fire."
#library standard=sdtmig version=3-4
#dictionaries dummy
dataset CE
col USUBJID  type=Char
col CETERM   type=Char
col CEBODSYS type=Char
---
001 | Some event    | gastrointestinal DISORDERS
002 | Another event |
