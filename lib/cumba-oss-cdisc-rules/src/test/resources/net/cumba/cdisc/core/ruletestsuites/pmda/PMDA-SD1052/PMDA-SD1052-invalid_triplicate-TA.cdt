#!RuleTest
#test PMDA-SD1052 expect=violation domain=TA
#note "FRESH. THREE records share the duplicated tuple, so the count is 3 - the operator flags EVERY member of a duplicate class, not 'the extras'. No twin goes beyond a 2-row duplicate, so the 'n, not n-1' property is unpinned anywhere in the group."
#library standard=sdtmig version=3-4
#expectViolationCount 3
#expectViolationAt row=1 ARMCD=A TAETORD=1
#expectViolationAt row=2 ARMCD=A TAETORD=1
#expectViolationAt row=3 ARMCD=A TAETORD=1
dataset TA class="TRIAL DESIGN"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
col TAETORD type=Num  label="Planned Order of Element within Arm"
col ETCD    type=Char label="Element Code"
---
S1 | TA | A | Arm A | 1 | SCRN
S1 | TA | A | Arm A | 1 | TRT
S1 | TA | A | Arm A | 1 | FU
S1 | TA | A | Arm A | 2 | EOT
