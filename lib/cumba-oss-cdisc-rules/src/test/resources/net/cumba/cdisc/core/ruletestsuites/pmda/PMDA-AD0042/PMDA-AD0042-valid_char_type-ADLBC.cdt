#!RuleTest
#test PMDA-AD0042 expect=noViolation domain=ADLBC
#note "Name and format would both fire, but var_type(DATA)==Num is false for a Char variable. Pins the numeric-type conjunct PMDA-AD0041/0043 do NOT carry."
#library standard=adamig version=1-3
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ASTTM   type=Char format=$8.
