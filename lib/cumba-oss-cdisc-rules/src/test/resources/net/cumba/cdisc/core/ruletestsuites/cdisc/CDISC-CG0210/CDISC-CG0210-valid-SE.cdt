#!RuleTest
#test CDISC-CG0210 expect=noViolation domain=SE
#note "Row 1 is a planned element, so an empty SEUPDES is expected. Row 2 is the unplanned element and describes it. Adapted from FDA-SD1266."
#library standard=sdtmig version=3-4
dataset SE label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ   type=Num  label="Sequence Number"
col ETCD    type=Char label="Element Code"
col ELEMENT type=Char label="Description of Element"
col SEUPDES type=Char label="Description of Unplanned Element"
---
CDISCPILOT01 | SE | 01-701-1015 | 1 | SCRN   | Screening |
CDISCPILOT01 | SE | 01-701-1015 | 2 | UNPLAN |           | Unscheduled washout period
