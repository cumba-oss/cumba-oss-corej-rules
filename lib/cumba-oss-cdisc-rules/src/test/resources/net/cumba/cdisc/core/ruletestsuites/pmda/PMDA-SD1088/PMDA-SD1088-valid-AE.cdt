#!RuleTest
#test PMDA-SD1088 expect=noViolation domain=AE
#note "ADAPTED-FROM fda/FDA-SD1088/FDA-SD1088-valid-AE.cdt PLUS one fresh row: keeps the twin's rows (complete date + populated AESTDY; month-partial AESTDTC '2020-02' with empty AESTDY), and ADDS AE row 3 for subject 002 (complete AESTDTC 2020-01-15, AESTDY empty) with NO DM row for 002 - the INNER join drops the subject pre-evaluation -> still noViolation. A subject missing from DM is PMDA-SD0064's finding, not this rule's; behaviorally identical under a null-fill since is_complete_date(blank RFSTDTC) is false."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESTDTC type=Char label="Start Date/Time of Adverse Event"
col AESTDY  type=Num  label="Study Day of Start of Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE | 2020-01-10 | 10
S1 | AE | 001 | 2 | NAUSEA   | 2020-02    |
S1 | AE | 002 | 1 | DIZZINESS | 2020-01-15 |
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
---
S1 | DM | 001 | 2020-01-01
---
