#!RuleTest
#test CDISC-AD0774 expect=noViolation domain=ADAE
# Rule:Description: There is more than one value of SEVGRyN for a given value of SEVGRy, considering only those rows on which both variables are populated
#note "each SEVGR1 maps to a single SEVGR1N -> noViolation"
# Declared-tier scope: the class= declaration disagrees with the columns, so #define must
# carry it to RuleRunner (ScenarioDeclaredScopeProvider.install).
#define standard=adamig version=1-3
dataset ADAE class=OCCDS
col STUDYID type=Char
col USUBJID type=Char
col ASEQ type=Num
col SEVGR1 type=Char
col SEVGR1N type=Num
---
CDISCPILOT01 | 01-701-1015 | 1 | MILD | 1
CDISCPILOT01 | 01-701-1015 | 2 | SEVERE | 2
---
