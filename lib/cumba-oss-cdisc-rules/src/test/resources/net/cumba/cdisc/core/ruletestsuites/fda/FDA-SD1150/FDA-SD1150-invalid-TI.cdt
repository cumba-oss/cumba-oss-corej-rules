#!RuleTest
#test FDA-SD1150 expect=violation domain=TI
#note "IETESTCD=INCL01 carries two different criterion texts, so IETEST is not constant for a given IETESTCD. Both records of the conflicting pair are reported."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 IETESTCD=INCL01 IETEST="Age 18 years or older"
#expectViolationAt row=2 IETESTCD=INCL01 IETEST="Age at least 18 years"
dataset TI label="Trial Inclusion/Exclusion Criteria"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col IETESTCD type=Char label="Incl/Excl Criterion Short Name"
col IETEST   type=Char label="Inclusion/Exclusion Criterion"
col IECAT    type=Char label="Inclusion/Exclusion Category"
---
S1 | TI | INCL01 | Age 18 years or older | INCLUSION
S1 | TI | INCL01 | Age at least 18 years | INCLUSION
S1 | TI | EXCL01 | Pregnant or nursing   | EXCLUSION
