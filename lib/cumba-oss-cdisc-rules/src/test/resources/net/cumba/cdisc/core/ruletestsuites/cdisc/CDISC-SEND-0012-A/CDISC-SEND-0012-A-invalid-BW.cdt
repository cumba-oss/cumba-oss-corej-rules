#!RuleTest
#test CDISC-SEND-0012-A expect=violation domain=BW
#note "BWTESTCD is Required for BW in the SENDIG and is present as a column but empty on row 2 -> the population half fires once. BWSTRESU is empty on the same row and is not Required, so it stays silent."
#library standard=sendig version=3-1-1
#library required-variables BW STUDYID DOMAIN USUBJID BWSEQ BWTESTCD
#expectViolationCount 1
#expectViolationAt row=2 variable_name=BWTESTCD
dataset BW label="Body Weight"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col BWSEQ    type=Num  label="Sequence Number"
col BWTESTCD type=Char label="Body Weight Test Short Name"
col BWSTRESU type=Char label="Unit of the Standardized Result"
---
S1 | BW | 001 | 1 | BW | g
S1 | BW | 001 | 2 |    |
