#!RuleTest
#test PMDA-SD0005 expect=noViolation domain=LB
#note "First shape (no POOLID): LBSEQ unique per subject; the same LBSEQ value on different subjects stays clean."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
---
S1 | LB | 001 | 1 | ALB
S1 | LB | 001 | 2 | GLUC
S1 | LB | 002 | 1 | ALB
