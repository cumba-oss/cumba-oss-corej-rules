#!RuleTest
#test PMDA-SD1065 expect=skipped domain=CO
#note "FRESH. Neither IDVAR nor RDOMAIN column (a study whose comments are all subject-level). Requirements.Variables.All is [IDVAR] and the column is absent, so the engine returns SKIPPED naming the variable, before any evaluation."
#library standard=sdtmig version=3-4
dataset CO class="SPECIAL PURPOSE" label="Comments"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col COSEQ   type=Num  label="Sequence Number"
col COVAL   type=Char label="Comment"
---
S1 | 001 | 1 | General subject comment
