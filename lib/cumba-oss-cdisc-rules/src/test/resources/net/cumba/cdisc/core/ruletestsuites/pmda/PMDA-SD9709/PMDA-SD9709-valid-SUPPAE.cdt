#!RuleTest
#test PMDA-SD9709 expect=noViolation domain=SUPPAE
# Rule:Description: PMDA-SD9709 — the Required key QLABEL is not populated.
#note "QLABEL populated -> noViolation; the twin scenario differs only in the value of QLABEL."
#library standard=sdtmig version=3-4
dataset SUPPAE
col STUDYID type=Char
col RDOMAIN type=Char
col USUBJID type=Char
col IDVAR type=Char
col IDVARVAL type=Char
col QNAM type=Char
col QLABEL type=Char
col QVAL type=Char
---
S1      | AE      | S1-001  | AESEQ | 1        | AESOSP | Other Medically Important SAE | Y
---
