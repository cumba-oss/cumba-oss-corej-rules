#!RuleTest
#test PMDA-AD0221 expect=violation domain=ADLBC
#note "Isolates the third disjunct (BASE:BASECATy). BASECAT1 seeds {y=1}; AVAL/AVALC absent so disjuncts 1-2 are false. Group (ALB,20) holds NORMAL,NORMAL,ABNORMAL -> minority row 3 fires."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 PARAMCD=ALB BASE=20 BASECAT1=ABNORMAL
dataset ADLBC structure=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col BASE     type=Num
col BASECAT1 type=Char
---
CDISCPILOT01 | 01-701-1015 | ALB | 20 | NORMAL
CDISCPILOT01 | 01-701-1023 | ALB | 20 | NORMAL
CDISCPILOT01 | 01-701-1034 | ALB | 20 | ABNORMAL
