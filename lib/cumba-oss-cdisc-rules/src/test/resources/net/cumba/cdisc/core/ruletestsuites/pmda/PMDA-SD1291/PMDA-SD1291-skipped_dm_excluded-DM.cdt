#!RuleTest
#test PMDA-SD1291 expect=skipped domain=DM
#note "Synthetic sponsor columns DMENRTPT (empty) / DMENTPT (populated) satisfy both Requirements.Variables gates and would fire; ONLY the Domains.Exclude [DM, SE, SV, DO] rejects. Pinned on behalf of SD1292's identical block."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE"
col STUDYID   type=Char
col DOMAIN    type=Char
col USUBJID   type=Char
col DMENRTPT  type=Char
col DMENTPT   type=Char
