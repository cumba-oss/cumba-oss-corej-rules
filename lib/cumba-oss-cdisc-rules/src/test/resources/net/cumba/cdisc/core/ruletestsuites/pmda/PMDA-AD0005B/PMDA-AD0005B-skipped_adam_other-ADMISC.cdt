#!RuleTest
#test PMDA-AD0005B expect=skipped domain=ADMISC
#note "AD0005B's SIX-token Data_Structures block ([SLAD,BDS,OCCDS,DEVICE LEVEL ANALYSIS DATASET,MEDICAL DEVICE BDS,MEDICAL DEVICE OCCDS]) is a DIFFERENT block from AD0005's -- pinned separately, not a duplicate. ADAM OTHER is in none of the six -> never executes. Do NOT add SPDEVID (would change what the fixture means even though the declaration still wins)."
#library standard=adamig version=1-3
dataset ADMISC structure=OTHER
col STUDYID type=Char
col USUBJID type=Char
col SAFFL   type=Char
---
CDISCPILOT01 | 01-701-1015 | X
