#!RuleTest
#test PMDA-SD1354 expect=noViolation domain=TA
#note "Every TA.ARMCD (PBO, XANHI) is assigned to at least one DM subject via DM.ARMCD -> no violation."
#library standard=sdtmig version=3-4
dataset TA label="Trial Arms"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col ARMCD    type=Char label="Planned Arm Code"
col ARM      type=Char label="Description of Planned Arm"
col TAETORD  type=Num  label="Planned Order of Element within Arm"
col ETCD     type=Char label="Element Code"
col EPOCH    type=Char label="Epoch"
---
CDISCPILOT01 | TA | PBO   | Placebo         | 1 | SCRN | SCREENING
CDISCPILOT01 | TA | PBO   | Placebo         | 2 | TRT  | TREATMENT
CDISCPILOT01 | TA | XANHI | Xanomeline High | 1 | SCRN | SCREENING
---

dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARMCD    type=Char label="Planned Arm Code"
col ARM      type=Char label="Description of Planned Arm"
---
CDISCPILOT01 | DM | 01-001 | PBO   | Placebo
CDISCPILOT01 | DM | 01-002 | XANHI | Xanomeline High
---
