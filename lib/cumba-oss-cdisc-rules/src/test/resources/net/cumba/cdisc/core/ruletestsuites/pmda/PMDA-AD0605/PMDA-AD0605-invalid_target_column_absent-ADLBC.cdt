#!RuleTest
#test PMDA-AD0605 expect=violation domain=ADLBC
#note "MECHANISM PIN (STAGE-G CRITICAL 3). Substitution resolves PH2SDT (APHASEN=2), the bound ADSL row has no such column -> lookup null -> `!=` takes the string arm against '' -> FIRES. One row, one violation. Defensible against the sheet: a record claims phase 2 but ADSL defines no PH2SDT - the traceability the rule demands is broken."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 APHASEN=2 PHSDT=23100
dataset ADLBC structure=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVAL     type=Num
col APHASEN  type=Num
col PHSDT    type=Num
---
S1 | 01-701-1015 | ALB | 30 | 2 | 23100
---

dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col PH1SDT  type=Num
---
S1 | 01-701-1015 | 23000
