#!RuleTest
#test PMDA-SD1321 expect=violation domain=AE
#note "FRESH, DISCRIMINATING (the declared-but-0-row boundary of dataset_names; 0-row block syntax precedent: pmda/PMDA-SD1049/PMDA-SD1049-valid_empty_dataset-SUPPAE.cdt). SUPPAE is DECLARED with the full column block and ZERO data rows -> the inventory lists SUPPAE -> first disjunct FALSE; the grouped count over the empty SUPPAE resolves 0 for subject 001 -> fires via '\$aetrtem_count < 1'. ESCALATE if count is 0 (would mean the inventory drops declared 0-row datasets)."
#library standard=sdtmig version=3-4
#expectViolationCount 1
dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEDECOD type=Char label="Dictionary-Derived Term"
---
S1 | AE | 001 | 1 | Headache | HEADACHE
---

dataset SUPPAE label="Supplemental Qualifiers for AE"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM     type=Char label="Qualifier Variable Name"
col QLABEL   type=Char label="Qualifier Variable Label"
col QVAL     type=Char label="Data Value"
---
