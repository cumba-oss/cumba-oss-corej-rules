#!RuleTest
#test CDISC-AD0473 expect=noViolation domain=ADSL
# Rule:Description: There is more than one value of STRATwRN for a given value of STRATwR, considering only those rows on which both variables are populated
#note "each STRAT1R value maps to a single STRAT1RN -> no violation"
dataset ADSL class=ADSL
col STUDYID type=Char
col USUBJID type=Char
col STRAT1RN type=Char
col STRAT1R type=Char
---
CDISCPILOT01 | 01-701-1015 | a1 | G1
CDISCPILOT01 | 01-701-1023 | a2 | G2
---
