#!RuleTest
#test FDA-SD1393 expect=skipped domain=MB
#note "Absent-vs-empty boundary: the MBXDY column is absent from the dataset altogether (the study did not include it), so Requirements.Variables.All gates the rule to a SKIP -> no violation, matching the Python engine's KeyError-skip on the top-level all-leaf."
#library standard=sendig version=ar-1-0
dataset MB class=FINDINGS label="Microbiology Specimen"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col MBSEQ    type=Num  label="Sequence Number"
col MBTESTCD type=Char label="Microbiology Test or Finding Short Name"
col MBDTC    type=Char label="Date/Time of Collection"
---
S1 | MB | 001 | 1 | AEROBIC | 2020-01-10
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFXSTDTC type=Char label="Date/Time of First Study Treatment"
---
S1 | DM | 001 | 2020-01-05
---
