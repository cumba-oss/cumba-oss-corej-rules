#!RuleTest
#test FDA-SD1263 expect=violation domain=MB
#note "Row 2 identifies an organism by culture, is neither a NO GROWTH result nor a GRAM STAIN, yet leaves MBRESCAT empty -> fires."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 MBSTRESC="STAPHYLOCOCCUS AUREUS"
dataset MB class=FINDINGS label="Microbiology Specimen"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col MBSEQ    type=Num  label="Sequence Number"
col MBTESTCD type=Char label="Microbiology Test Short Name"
col MBSTRESC type=Char label="Character Result/Finding in Std Format"
col MBRESCAT type=Char label="Result Category"
col MBMETHOD type=Char label="Method of Test or Examination"
---
CDISCPILOT01 | MB | 01-701-1015 | 1 | ORGANISM | ESCHERICHIA COLI      | PATHOGEN | CULTURE
CDISCPILOT01 | MB | 01-701-1015 | 2 | ORGANISM | STAPHYLOCOCCUS AUREUS |          | CULTURE
