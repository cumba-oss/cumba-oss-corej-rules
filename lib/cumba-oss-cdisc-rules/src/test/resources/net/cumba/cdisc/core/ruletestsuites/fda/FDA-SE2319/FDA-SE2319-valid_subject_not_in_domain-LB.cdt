#!RuleTest
#test FDA-SE2319 expect=noViolation domain=LB
#note "Documented limit (review INFO): subject 003 is enrolled in DM but has no LB record at all, so it has no baseline observation either. The rule groups only over the rows present in the checked domain, so it does not fire for such a subject. Subjects 001/002 both carry LBBLFL='Y'."
#library standard=sendig version=3-1-1
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBTEST   type=Char label="Lab Test or Examination Name"
col LBORRES  type=Char label="Result or Finding in Original Units"
col LBBLFL   type=Char label="Baseline Flag"
---
S1 | LB | 001 | 1 | ALB | Albumin | 4.1 | Y
S1 | LB | 002 | 1 | ALB | Albumin | 3.8 | Y
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
col SEX     type=Char label="Sex"
col SETCD   type=Char label="Set Code"
---
S1 | DM | 001 | 001 | 2020-01-01 | M | SET1
S1 | DM | 002 | 002 | 2020-01-01 | F | SET1
S1 | DM | 003 | 003 | 2020-01-01 | F | SET1
---
