#!RuleTest
#test FDA-SD1354 expect=violation domain=TA
#note "TA.ARMCD=XANLO is defined in TA but no DM subject is assigned to it -> fires on row 3. Rows 1-2 (PBO) are assigned; row 4 has an empty ARMCD and is guarded out by the non_empty leaf."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=3 ARMCD=XANLO
dataset TA label="Trial Arms"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col ARMCD    type=Char label="Planned Arm Code"
col ARM      type=Char label="Description of Planned Arm"
col TAETORD  type=Num  label="Planned Order of Element within Arm"
col ETCD     type=Char label="Element Code"
col EPOCH    type=Char label="Epoch"
---
CDISCPILOT01 | TA | PBO   | Placebo         | 1 | SCRN | SCREENING
CDISCPILOT01 | TA | PBO   | Placebo         | 2 | TRT  | TREATMENT
CDISCPILOT01 | TA | XANLO | Xanomeline Low  | 1 | TRT  | TREATMENT
CDISCPILOT01 | TA |       |                 | 1 | FUP  | FOLLOW-UP
---

dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARMCD    type=Char label="Planned Arm Code"
col ARM      type=Char label="Description of Planned Arm"
---
CDISCPILOT01 | DM | 01-001 | PBO | Placebo
CDISCPILOT01 | DM | 01-002 | PBO | Placebo
---
