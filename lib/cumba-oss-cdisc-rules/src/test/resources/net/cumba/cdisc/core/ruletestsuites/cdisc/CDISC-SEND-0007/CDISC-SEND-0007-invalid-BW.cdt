#!RuleTest
#test CDISC-SEND-0007 expect=violation domain=BW
#note "USUBJID has no library codelist -> second conjunct false -> silent regardless of its own define codelist. BWTESTCD's SENDIG codelist is C90001 but the define ItemDef carries NO CodeListRef -> var_codelist(DEFINE) empty -> fires."
#library standard=sendig version=3-1-1
#library variable-metadata BW BWTESTCD name=BWTESTCD codelist=C90001
#library variable-metadata BW USUBJID name=USUBJID
#define-xml CDISC-SEND-0007-define.xml
#expectViolationCount 1
#expectViolationAt define_variable_name=BWTESTCD library_variable_codelist=C90001
dataset BW
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col BWSEQ    type=Num
col BWTESTCD type=Char
---
S1 | BW | 001 | 1 | BW
