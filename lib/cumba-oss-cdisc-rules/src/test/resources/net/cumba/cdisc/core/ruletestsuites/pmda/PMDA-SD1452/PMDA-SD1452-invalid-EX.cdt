#!RuleTest
#test PMDA-SD1452 expect=violation domain=EX
#note "Row 2 records a negative treatment vehicle amount (EXVAMT=-2) -> fires. Row 1 is positive and row 3 is zero, which the rule allows."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 EXVAMT=-2
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Actual Treatment"
col EXVAMT  type=Num  label="Amount Administered"
col EXVAMTU type=Char label="Amount Administered Units"
---
S1 | EX | 001 | 1 | DRUG A | 5  | mL
S1 | EX | 001 | 2 | DRUG A | -2 | mL
S1 | EX | 001 | 3 | DRUG A | 0  | mL
