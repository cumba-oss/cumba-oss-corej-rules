#!RuleTest
#test PMDA-AD0501 expect=violation domain=ADLBC
#note "ASPER populated but APERIOD missing on row 1 -> fires. Row 2 both populated -> silent. Both APERIOD and ASPER are Num in ADaMIG 1.3. No wildcards."
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015 ASPER=1
#library standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col APERIOD  type=Num
col ASPER    type=Num
---
CDISCPILOT01 | 01-701-1015 | GLUC | | 1
CDISCPILOT01 | 01-701-1023 | GLUC | 1 | 2
---
