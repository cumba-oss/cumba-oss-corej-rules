#!RuleTest
#test PMDA-AD0694 expect=violation domain=ADMD
#note "PARAMCD + SPDEVID -> MEDICAL DEVICE BASIC DATA STRUCTURE. Group (DEV01, 01-701-1015, GLUC, 1) holds BASEC {LOW, LOW, HIGH} -> minority row 3 fires. Exactly the AD0693 fixture with the roles of BASE and BASEC swapped."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=01-701-1015 SPDEVID=DEV01 PARAMCD=GLUC BASE=1 BASEC=HIGH
dataset ADMD
col STUDYID type=Char
col USUBJID type=Char
col SPDEVID type=Char
col PARAMCD type=Char
col BASE    type=Num
col BASEC   type=Char
---
CDISCPILOT01 | 01-701-1015 | DEV01 | GLUC | 1 | LOW
CDISCPILOT01 | 01-701-1015 | DEV01 | GLUC | 1 | LOW
CDISCPILOT01 | 01-701-1015 | DEV01 | GLUC | 1 | HIGH
