#!RuleTest
#test PMDA-SD1327 expect=noViolation domain=RELSUB
#note "RSUBJID names the related subject, never the pool it is related to; the second row leaves POOLID empty."
#library standard=sdtmig version=3-4
dataset RELSUB label="Related Subjects"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col POOLID  type=Char label="Pool Identifier"
col RSUBJID type=Char label="Related Subject or Pool Identifier"
col SREL    type=Char label="Subject Relationship"
---
CDISCPILOT01 |             | POOL01 | 01-701-1015 | LITTERMATE
CDISCPILOT01 | 01-701-1023 |        | 01-701-1024 | MOTHER, BIOLOGICAL
