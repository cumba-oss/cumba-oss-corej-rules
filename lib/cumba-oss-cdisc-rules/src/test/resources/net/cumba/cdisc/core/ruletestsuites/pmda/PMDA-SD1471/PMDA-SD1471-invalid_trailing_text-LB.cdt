#!RuleTest
#test PMDA-SD1471 expect=violation domain=LB
#note "The value starts numeric but carries a unit suffix; the pattern is anchored with $, so the match fails and the row fires. Pins the END anchor - an unanchored search would accept this value. No space, so it can be pinned."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001 LBORRES=12.5mg LBORNRHI=6.1
dataset LB
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
col LBORRES  type=Char
col LBORNRHI type=Char
---
S1 | LB | 001 | 1 | GLUC | 12.5mg | 6.1
---
