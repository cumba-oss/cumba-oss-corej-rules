#!RuleTest
#test FDA-SD2002 expect=noViolation domain=DM
#note "Regression pin for the W4 exclusion fix: the four SDTMIG null-arm codes (SCRNFAIL, NOTASSGN, NOTTRT, UNPLAN) are excluded, so these conformant subjects do not fire."
#library standard=sdtmig version=3-4
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARMCD    type=Char label="Planned Arm Code"
col ACTARMCD type=Char label="Actual Arm Code"
col ARMNRS   type=Char label="Reason Arm and/or Actual Arm is Null"
---
CDISCPILOT01 | DM | 01-001 | SCRNFAIL | SCRNFAIL | SCREEN FAILURE
CDISCPILOT01 | DM | 01-002 | NOTASSGN | NOTASSGN | NOT ASSIGNED
CDISCPILOT01 | DM | 01-003 | PBO      | NOTTRT   | ASSIGNED, NOT TREATED
CDISCPILOT01 | DM | 01-004 | PBO      | UNPLAN   | UNPLANNED TREATMENT
---

dataset TA label="Trial Arms"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
col TAETORD type=Num  label="Planned Order of Element within Arm"
col ETCD    type=Char label="Element Code"
---
CDISCPILOT01 | TA | PBO   | Placebo         | 1 | TRT
CDISCPILOT01 | TA | XANHI | Xanomeline High | 1 | TRT
---
