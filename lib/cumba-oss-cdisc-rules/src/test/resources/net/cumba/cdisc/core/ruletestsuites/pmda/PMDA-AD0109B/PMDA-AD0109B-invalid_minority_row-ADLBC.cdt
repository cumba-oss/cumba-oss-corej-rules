#!RuleTest
#test PMDA-AD0109B expect=violation domain=ADLBC
#note "One group (GLUC, WEEK2) holding AVISITN {2, 2, 3} - a strict 2-vs-1 majority, so only the minority row 3 fires. RECORD granularity, addressed by row=."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=01-701-1034 PARAMCD=GLUC AVISIT=WEEK2 AVISITN=3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVISIT  type=Char
col AVISITN type=Num
---
CDISCPILOT01 | 01-701-1015 | GLUC | WEEK2 | 2
CDISCPILOT01 | 01-701-1023 | GLUC | WEEK2 | 2
CDISCPILOT01 | 01-701-1034 | GLUC | WEEK2 | 3
