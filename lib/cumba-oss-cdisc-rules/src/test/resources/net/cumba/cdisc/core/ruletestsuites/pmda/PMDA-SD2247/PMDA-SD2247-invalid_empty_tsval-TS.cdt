#!RuleTest
#test PMDA-SD2247 expect=violation domain=TS
#note "Boundary: empty TSVAL on an SSTDTC record. The sheet Rule text grants no null exemption and the Check deliberately carries no non-empty leaf, so a blank TSVAL is flagged. The landed sibling pmda/PMDA-SD2247A/PMDA-SD2247A-invalid_empty_tsval-TS.cdt is the SAME data on the completeness rule and also fires - keep both; they pin two different operators agreeing on the blank."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 TSPARMCD=SSTDTC TSVAL=
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
CDISCPILOT01 | TS | 1 | SSTDTC  | Study Start Date |
CDISCPILOT01 | TS | 1 | DCUTDTC | Data Cutoff Date | 2020-06-30
