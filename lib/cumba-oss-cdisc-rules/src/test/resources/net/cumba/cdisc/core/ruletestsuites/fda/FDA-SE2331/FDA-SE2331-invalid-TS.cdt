#!RuleTest
#test FDA-SE2331 expect=violation domain=TS
#note "No TSPARMCD=GLPFL record anywhere in TS -> the 'Good Laboratory Practice Indicator Flag' parameter is missing, one dataset-level finding. the near-miss parameter GLPTYP shares the GLP prefix, so a prefix match on the filter would wrongly silence the rule."
#library standard=sendig version=3-1-1
#expectViolationCount 1
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | GLPTYP   | Good Laboratory Practice Type              | FULL GLP
S01 | TS | 2 | STITLE   | Nonclinical Study Title                    | 13-Week Repeat Dose Toxicity Study
S01 | TS | 3 | SDESIGN  | Nonclinical Study Design                   | PARALLEL
