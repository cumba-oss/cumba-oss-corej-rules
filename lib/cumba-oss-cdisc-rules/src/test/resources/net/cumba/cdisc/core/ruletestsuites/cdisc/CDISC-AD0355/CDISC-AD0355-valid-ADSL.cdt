#!RuleTest
#test CDISC-AD0355 expect=noViolation domain=ADSL
# Rule:Description: There is more than one value of REGIONy for a given value of REGIONyN, considering only those rows on which both variables are populated
#note "each REGION1N value maps to a single REGION1 value -> noViolation"
dataset ADSL class=ADSL
col STUDYID type=Char
col USUBJID type=Char
col REGION1 type=Char
col REGION1N type=Char
---
CDISCPILOT01 | 01-701-1015 | A1 | G
CDISCPILOT01 | 01-701-1023 | A2 | H
---
