#!RuleTest
#test CDISC-AD0677 expect=noViolation domain=ADDV
# Rule:Description: There is more than one value of DEVTYGy for a given value of DEVTYGyN, considering only those rows on which both variables are populated
#note "each DEVTYG1N value maps to a single DEVTYG1 value -> noViolation"
dataset ADDV class="DEVICE LEVEL ANALYSIS DATASET"
col STUDYID type=Char
col USUBJID type=Char
col SPDEVID type=Char
col DEVTYG1 type=Char
col DEVTYG1N type=Char
---
CDISCPILOT01 | 01-701-1015 | DEV01 | A1 | K1
CDISCPILOT01 | 01-701-1023 | DEV01 | A2 | K2
CDISCPILOT01 | 01-701-1028 | DEV01 | A1 | K1
---
