#!RuleTest
#test CDISC-AD0682 expect=violation domain=ADDV
# Rule:Description: There is more than one value of MODELGyN for a given value of MODELGy, considering only those rows on which both variables are populated
#note "MODELG1=K1 maps to two distinct MODELG1N values -> violation"
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015
#expectViolationAt row=2 USUBJID=01-701-1023
dataset ADDV class="DEVICE LEVEL ANALYSIS DATASET"
col STUDYID type=Char
col USUBJID type=Char
col SPDEVID type=Char
col MODELG1N type=Char
col MODELG1 type=Char
---
CDISCPILOT01 | 01-701-1015 | DEV01 | A1 | K1
CDISCPILOT01 | 01-701-1023 | DEV01 | A2 | K1
---
