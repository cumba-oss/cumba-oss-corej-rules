#!RuleTest
#test PMDA-SD2008 expect=noViolation domain=AE
#note "Every populated AELLT is a Lowest Level Term of the (dummy) MedDRA dictionary; the sheet says Case-insensitive, so the lower-case 'diarrhoea' passes too; the empty AELLT on row 3 does not fire."
#library standard=sdtmig version=3-4
#dictionaries dummy
dataset AE
col USUBJID type=Char
col AELLT   type=Char
---
001 | Headache
001 | diarrhoea
002 |
