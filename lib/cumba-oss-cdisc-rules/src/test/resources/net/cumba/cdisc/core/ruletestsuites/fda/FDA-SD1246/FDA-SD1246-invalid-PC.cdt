#!RuleTest
#test FDA-SD1246 expect=violation domain=PC
#note "PCELTM is present but PCTPTREF is not -> the Time Point Reference variable must be included -> one dataset-level finding."
#library standard=sdtmig version=3-4
#expectViolationCount 1
dataset PC class=FINDINGS label="Pharmacokinetic Concentrations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PCSEQ    type=Num  label="Sequence Number"
col PCTESTCD type=Char label="Pharmacokinetic Test Short Name"
col PCELTM   type=Char label="Planned Elapsed Time from Time Point Ref"
---
CDISCPILOT01 | PC | 01-701-1015 | 1 | DRUGA | PT1H
---
