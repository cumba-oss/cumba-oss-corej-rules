#!RuleTest
#test FDA-SE2264 expect=noViolation domain=LB
#note "RPHASE is populated on every record that carries a Repro Phase timing value; row 3 has neither RPHASE nor timing values -> no violation."
#library standard=sendig-dart version=1-1
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col RPHASE   type=Char label="Repro Phase"
col RPPLDY   type=Num  label="Planned Repro Phase Day of Observation"
col LBRPDY   type=Num  label="Actual Repro Phase Day of Observation"
---
S1 | LB | 001 | 1 | ALB  | GESTATION |   | 5
S1 | LB | 001 | 2 | GLUC | LACTATION | 3 |
S1 | LB | 001 | 3 | CHOL |           |   |
