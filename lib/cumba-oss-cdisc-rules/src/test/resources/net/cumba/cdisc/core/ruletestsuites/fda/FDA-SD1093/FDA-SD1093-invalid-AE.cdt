#!RuleTest
#test FDA-SD1093 expect=violation domain=AE
#note "Row 1: AEENDY populated with partial AEENDTC (2020-06) -> fires. Row 2: 002 has AEENDY populated, complete AEENDTC but partial RFSTDTC (2020) -> fires. Row 3: all complete -> no fire."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=001
#expectViolationAt row=2 USUBJID=002
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEENDTC type=Char label="End Date/Time of Adverse Event"
col AEENDY  type=Num  label="Study Day of End of Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE | 2020-06    | 5
S1 | AE | 002 | 1 | NAUSEA   | 2020-01-20 | 20
S1 | AE | 001 | 2 | FATIGUE  | 2020-01-22 | 22
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
---
S1 | DM | 001 | 2020-01-01
S1 | DM | 002 | 2020
---
