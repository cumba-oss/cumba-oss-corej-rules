#!RuleTest
#test CDISC-SEND-9434 expect=noViolation domain=DM
# Rule:Description: CDISC-SEND-9434 — the Required key SETCD is not populated.
#note "SETCD populated -> noViolation; the twin scenario differs only in the value of SETCD."
#library standard=sendig version=3-1-1
dataset DM
col STUDYID type=Char
col DOMAIN type=Char
col USUBJID type=Char
col SETCD type=Char
col SEX type=Char
---
S1      | DM     | S1-001  | GRP1  | M
---
