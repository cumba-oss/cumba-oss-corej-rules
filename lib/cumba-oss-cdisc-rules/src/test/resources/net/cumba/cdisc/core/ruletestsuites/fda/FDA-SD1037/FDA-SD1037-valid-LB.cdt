#!RuleTest
#test FDA-SD1037 expect=noViolation domain=LB
#note "Every LBTOXGR>0 row has LBTOX populated; TOXGR 0/empty rows are guarded out -> no violation."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col LBSEQ   type=Num  label="Sequence Number"
col LBTOXGR type=Char label="Standard Toxicity Grade"
col LBTOX   type=Char label="Toxicity"
---
S1 | LB | 001 | 1 | 2 | Grade 2
S1 | LB | 001 | 2 | 0 |
S1 | LB | 001 | 3 |   |
---
