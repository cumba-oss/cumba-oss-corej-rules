#!RuleTest
#test CDISC-AD0043 expect=noViolation domain=ADLBC
# Rule:Description: A numeric variable with a suffix of DTM does not have a datetime format
#note "ADTM has a date/datetime format (DATETIME20.) -> noViolation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ADTM type=Num format=DATETIME20.
---
CDISCPILOT01 | 01-701-1015 | ALB | 1
---
