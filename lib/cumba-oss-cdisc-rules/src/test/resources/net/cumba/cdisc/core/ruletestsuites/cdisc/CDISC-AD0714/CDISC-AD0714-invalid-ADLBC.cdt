#!RuleTest
#test CDISC-AD0714 expect=violation domain=ADLBC
# Rule:Description: There is more than one value of a variable which has a suffix of GRyN for a given value of a variable with the same root name and suffix of GRy, considering only those rows on which both variables are populated
#note "AETOXGR1=GRADE 1 maps to two distinct AETOXGR1N (1 and 2) -> violation"
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015
#expectViolationAt row=2 USUBJID=01-701-1023
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AETOXGR1 type=Char
col AETOXGR1N type=Num
---
CDISCPILOT01 | 01-701-1015 | GLUC | GRADE 1 | 1
CDISCPILOT01 | 01-701-1023 | GLUC | GRADE 1 | 2
---
