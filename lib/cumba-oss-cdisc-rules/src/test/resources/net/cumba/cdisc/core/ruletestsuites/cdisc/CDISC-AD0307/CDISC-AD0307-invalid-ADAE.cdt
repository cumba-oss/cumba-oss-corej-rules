#!RuleTest
#test CDISC-AD0307 expect=violation domain=ADAE
# Rule:Description: SMQzzCD is populated and SMQzzSC is not populated
#note "SMQ01CD populated, SMQ01SC empty -> violation"
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015
# Declared-tier scope: the class= declaration disagrees with the columns, so #define must
# carry it to RuleRunner (ScenarioDeclaredScopeProvider.install).
#define standard=adamig version=1-3
dataset ADAE class=OCCDS
col STUDYID type=Char
col USUBJID type=Char
col ASEQ type=Num
col SMQ01CD type=Char
col SMQ01SC type=Char
---
CDISCPILOT01 | 01-701-1015 | 1 | A | 
---
