#!RuleTest
#test FDA-SE2334 expect=violation domain=TS
#note "No TSPARMCD=SEXPOP record anywhere in TS -> the 'Sex of Study Group' parameter is missing, one dataset-level finding. SPECIES / SPGRPCD / STITLE describe the study population and groups but none of them is SEXPOP."
#library standard=sendig version=3-1-1
#expectViolationCount 1
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | SPECIES  | SEND Test System Common Name               | RAT
S01 | TS | 2 | SPGRPCD  | Sponsor Defined Group Code                 | G1
S01 | TS | 3 | STITLE   | Nonclinical Study Title                    | 13-Week Repeat Dose Toxicity Study
