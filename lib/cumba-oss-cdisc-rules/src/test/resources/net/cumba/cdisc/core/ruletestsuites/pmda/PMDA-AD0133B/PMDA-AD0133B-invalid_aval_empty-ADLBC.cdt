#!RuleTest
#test PMDA-AD0133B expect=violation domain=ADLBC
#note "THE HALF AD0133B ADDS OVER THE SHIPPED SIBLING AD0133A. AVAL IS declared but present-but-BLANK on row 1, so empty(AVAL) is true -> fires; row 2 is fully populated. AD0133A would be SILENT on this file (its only question is presence). AVAL not pinned: it is blank on the firing row."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 R2A1LO=1.25 A1LO=0.5
dataset ADLBC structure=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVAL     type=Num
col A1LO     type=Num
col R2A1LO   type=Num
---
CDISCPILOT01 | 01-701-1015 | ALT |  | 0.5 | 1.25
CDISCPILOT01 | 01-701-1023 | ALT | 2.5 | 0.5 | 5
