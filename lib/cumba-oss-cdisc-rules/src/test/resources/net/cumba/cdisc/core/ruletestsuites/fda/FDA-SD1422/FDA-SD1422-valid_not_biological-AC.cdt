#!RuleTest
#test FDA-SD1422 expect=noViolation domain=AC
#note "Guard branch: the CAGTCAT record's ACVAL is 'CHEMICAL', not 'BIOLOGICAL', so the BASTRNN parameter is not expected even though no ACPARMCD='BASTRNN' record exists -> no violation."
#library standard=sendig version=ar-1-0
dataset AC label="Challenge Agent Characterization"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col ACSEQ    type=Num  label="Sequence Number"
col ACPARMCD type=Char label="Challenge Agent Parameter Short Name"
col ACPARM   type=Char label="Challenge Agent Parameter"
col ACVAL    type=Char label="Parameter Value"
---
S1 | AC | 1 | CAGTCAT | Challenge Agent Category | CHEMICAL
S1 | AC | 2 | MCSCTIND | Multiple Challenge Agent Same Cat Ind | N
