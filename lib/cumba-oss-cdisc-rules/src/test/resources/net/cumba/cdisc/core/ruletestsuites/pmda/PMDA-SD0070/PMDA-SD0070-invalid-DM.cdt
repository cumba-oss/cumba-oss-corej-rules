#!RuleTest
#test PMDA-SD0070 expect=violation domain=DM
#note "Subject 001 is neither a screen failure (ARMCD SCRNFAIL), nor unassigned (ARMCD NOTASSGN), nor untreated (ACTARMCD NOTTRT), yet has no EX record ($ex_record_count = 0) -> exactly one group-level violation. 002/003/004 carry the three excluded codes and are silent even without EX records; 005 is treated and has an EX record."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARMCD    type=Char label="Planned Arm Code"
col ARM      type=Char label="Description of Planned Arm"
col ACTARMCD type=Char label="Actual Arm Code"
col ACTARM   type=Char label="Description of Actual Arm"
---
S1 | DM | 001 | A        | Drug A         | A        | Drug A
S1 | DM | 002 | SCRNFAIL | Screen Failure | SCRNFAIL | Screen Failure
S1 | DM | 003 | NOTASSGN | Not Assigned   | NOTASSGN | Not Assigned
S1 | DM | 004 | A        | Drug A         | NOTTRT   | Not Treated
S1 | DM | 005 | A        | Drug A         | A        | Drug A
---

dataset EX label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Actual Treatment"
---
S1 | EX | 005 | 1 | DRUG A
---
