#!RuleTest
#test FDA-SD0013 expect=violation domain=SE
#note "SPECIAL PURPOSE branch of Scope.Classes (the sheet's 'DM, SE, SM, SV'): SE element 2 starts 2020-03-01 and ends 2020-02-01, so SESTDTC is after SEENDTC."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 SESTDTC=2020-03-01 SEENDTC=2020-02-01
dataset SE class="SPECIAL PURPOSE" label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ   type=Num  label="Sequence Number"
col ETCD    type=Char label="Element Code"
col SESTDTC type=Char label="Start Date/Time of Element"
col SEENDTC type=Char label="End Date/Time of Element"
---
CDISCPILOT01 | SE | 01-701-1015 | 1 | SCRN | 2020-01-01 | 2020-01-10
CDISCPILOT01 | SE | 01-701-1015 | 2 | TRT  | 2020-03-01 | 2020-02-01
