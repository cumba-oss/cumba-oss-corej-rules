#!RuleTest
#test PMDA-AD0585 expect=violation domain=ADLBC
#note "INDEX 1 ONLY. Here the TARGET is numeric BCHGCA1N and the key tuple is (PARAMCD, BCHGCAT1)=(GLUC, INCREASE); target holds {1, 1, 2} -> minority row 3 fires. These same rows do NOT fire under PMDA-AD0584."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=01-701-1034 PARAMCD=GLUC BCHGCAT1=INCREASE BCHGCA1N=2
dataset ADLBC
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col BCHGCAT1 type=Char
col BCHGCA1N type=Num
---
CDISCPILOT01 | 01-701-1015 | GLUC | INCREASE | 1
CDISCPILOT01 | 01-701-1023 | GLUC | INCREASE | 1
CDISCPILOT01 | 01-701-1034 | GLUC | INCREASE | 2
