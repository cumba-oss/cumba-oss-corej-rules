#!RuleTest
#test FDA-SE2352 expect=violation domain=EX
#note "Second branch: row 2 gives no dose at all (EXDOSE missing) but still names a lot number -> fires."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=2 EXLOT=LOT999
dataset EX label="Exposure"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Actual Treatment"
col EXDOSE  type=Num  label="Dose per Administration"
col EXDOSU  type=Char label="Dose Units"
col EXLOT   type=Char label="Lot Number"
---
S1 | 001 | 1 | COMPOUND A | 10 | mg/kg | LOT123
S1 | 001 | 2 | VEHICLE    | .  | mg/kg | LOT999
