#!RuleTest
#test CDISC-AD0815-A expect=noViolation domain=ADPPK
#note "Both SUBJID and SUBJIDN are DECLARED; row 2 leaves SUBJIDN blank on purpose -- a present-but-empty companion is the VALUE rule CDISC-AD0815's finding, not this presence sister's. Discriminates presence from population."
#expectViolationCount 0
# Declared-tier scope: structure=/subclass= state the ADaM data structure and the popPK subclass this
# minimal table stands for; #define is their mandatory carrier (ScenarioDeclaredScopeProvider.install).
#define standard=adamig version=1-3
dataset ADPPK structure=BDS subclass=POPPK
col STUDYID type=Char
col USUBJID type=Char
col SUBJID type=Char
col SUBJIDN type=Num
---
CDISCPILOT01 | 01-701-1015 | 1015 | 1
CDISCPILOT01 | 01-701-1023 | 1023 |
---
