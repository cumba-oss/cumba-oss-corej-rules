#!RuleTest
#test PMDA-SD2239 expect=skipped domain=MI
#note "MITPT is populated, satisfying the Requirements.Variables [--TPT] gate; MI is a member of the included FINDINGS class, so ONLY the Domains.Exclude entry rejects. (DO/DU excludes are inert in 3.4 - no such IG domains.)"
#library standard=sdtmig version=3-4
dataset MI class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col MISEQ    type=Num
col VISITNUM type=Num
col MIDTC    type=Char
col MITPT    type=Char
---
S1 | MI | 001 | 1 | 1 | 2020-06-01 | PRE
