#!RuleTest
#test PMDA-AD0124 expect=skipped domain=ADLBC
#note "Declared OCCDS beats the PARAMCD-driven BDS detection (Fix #154) -> the detected structure set is [OCCURRENCE DATA STRUCTURE], neither of the rule's two Include tokens, so the scenario pre-gate refuses execution. Data would fire if it ran."
#library standard=adamig version=1-3
dataset ADLBC structure=OCCDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col PARCAT1 type=Char
---
S1 | 001 | GLUC | LABS
S1 | 002 | GLUC | LABS
S1 | 003 | GLUC | CHEMISTRY
S1 | 004 | ALB  | CHEMISTRY
S1 | 005 | ALB  | CHEMISTRY
