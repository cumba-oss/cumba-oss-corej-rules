#!RuleTest
#test FDA-SD0051 expect=violation domain=VS
#note "VISITNUM=1 is labelled both 'SCREENING' and 'BASELINE', so VISIT is not constant for a given VISITNUM. Both records of the conflicting pair are reported."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 VISITNUM=1 VISIT=SCREENING
#expectViolationAt row=2 VISITNUM=1 VISIT=BASELINE
dataset VS class=FINDINGS label="Vital Signs"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VSSEQ    type=Num  label="Sequence Number"
col VSTESTCD type=Char label="Vital Signs Test Short Name"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
S1 | VS | 001 | 1 | SYSBP | 1 | SCREENING
S1 | VS | 002 | 1 | SYSBP | 1 | BASELINE
S1 | VS | 001 | 2 | SYSBP | 2 | WEEK 2
