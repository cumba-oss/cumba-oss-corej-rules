#!RuleTest
#test FDA-SD1287 expect=violation domain=AE
#note "Preferred Term Code 10019211 carries two different dictionary-derived terms ('Headache' and 'Cephalalgia'), so --DECOD is not constant within --PTCD. Both records of the conflicting pair are reported (Sensitivity Record)."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 AEPTCD=10019211 AEDECOD=Headache
#expectViolationAt row=2 AEPTCD=10019211 AEDECOD=Cephalalgia
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEDECOD type=Char label="Dictionary-Derived Term"
col AEPTCD  type=Num  label="Preferred Term Code"
---
S1 | AE | 001 | 1 | HEADACHE  | Headache    | 10019211
S1 | AE | 002 | 1 | HEAD ACHE | Cephalalgia | 10019211
S1 | AE | 003 | 1 | NAUSEA    | Nausea      | 10028813
