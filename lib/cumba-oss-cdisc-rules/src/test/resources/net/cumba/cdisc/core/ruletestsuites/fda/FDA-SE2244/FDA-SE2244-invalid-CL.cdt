#!RuleTest
#test FDA-SE2244 expect=violation domain=CL
#note "Qualifier branch (--SEV): row 1 copies the modified original result verbatim into CLSTRESC (CLSTRESC = CLORRES, not NORMAL/UNREMARKABLE) although CLSEV carries the severity -> fires. Row 2 parsed the base observation into CLSTRESC and stays clean. No SUPP datasets are in the study: the --SEV branch must fire on its own."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 CLSTRESC="ERYTHEMA SEVERE"
dataset CL label="Clinical Observations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col CLSEQ    type=Num  label="Sequence Number"
col CLTESTCD type=Char label="Clinical Observation Short Name"
col CLORRES  type=Char label="Result or Finding in Original Units"
col CLSTRESC type=Char label="Result or Finding in Standard Format"
col CLSEV    type=Char label="Severity"
---
S1 | CL | 001 | 1 | CLSIGN | ERYTHEMA SEVERE | ERYTHEMA SEVERE | SEVERE
S1 | CL | 001 | 2 | CLSIGN | ERYTHEMA SEVERE | ERYTHEMA        | SEVERE
