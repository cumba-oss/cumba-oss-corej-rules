#!RuleTest
#test FDA-SD2024 expect=skipped domain=POOLDEF
#note "Regression pin for the T1 Scope fix (ERROR lane): POOLDEF is excluded, so SEND pool definitions (POOLID and USUBJID both Required there) are not judged by this rule."
#library standard=sendig version=3-1-1
dataset POOLDEF class=RELATIONSHIP label="Pool Definition"
col STUDYID type=Char label="Study Identifier"
col POOLID  type=Char label="Pool Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
---
S1 | P01 | 001
S1 | P01 | 002
