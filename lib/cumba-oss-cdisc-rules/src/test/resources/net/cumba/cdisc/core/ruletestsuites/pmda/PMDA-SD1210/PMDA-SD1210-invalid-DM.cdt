#!RuleTest
#test PMDA-SD1210 expect=violation domain=DM
#note "row 2 has an empty RFICDTC -> fires once, on that subject only."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 SUBJID=002
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SUBJID   type=Char label="Subject Identifier for the Study"
col RFSTDTC  type=Char label="Subject Reference Start Date/Time"
col RFXSTDTC type=Char label="Date/Time of First Study Treatment"
col RFXENDTC type=Char label="Date/Time of Last Study Treatment"
col RFICDTC  type=Char label="Date/Time of Informed Consent"
---
S1 | DM | 001 | 001 | 2020-01-01 | 2020-01-02 | 2020-03-15 | 2019-12-20
S1 | DM | 002 | 002 | 2020-01-05 | 2020-01-06 | 2020-03-01 |
