#!RuleTest
#test PMDA-SD1209 expect=skipped domain=DM
#note "FRESH. Neither RFXSTDTC nor RFXENDTC is declared (an observational study with no study treatment at all). Requirements.Variables.All is [RFXSTDTC] and the column is absent, so the engine returns SKIPPED naming the variable, before any evaluation."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
col RFICDTC type=Char label="Date/Time of Informed Consent"
---
S1 | DM | 001 | 001 | 2020-01-01 | 2019-12-20
