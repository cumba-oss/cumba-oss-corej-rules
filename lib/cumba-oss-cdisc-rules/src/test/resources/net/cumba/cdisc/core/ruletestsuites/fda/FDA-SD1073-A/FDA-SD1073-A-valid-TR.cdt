#!RuleTest
#test FDA-SD1073-A expect=noViolation domain=TR
#note "None of the prohibited qualifiers (TRLOC, TRLAT, TRDIR, TRPORTOT) is present -> no violation."
#library standard=sdtmig version=3-4
dataset TR label="Tumor Results"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col TRSEQ    type=Num
col TRTESTCD type=Char
---
S1 | TR | 001 | 1 | LDIAM
---
