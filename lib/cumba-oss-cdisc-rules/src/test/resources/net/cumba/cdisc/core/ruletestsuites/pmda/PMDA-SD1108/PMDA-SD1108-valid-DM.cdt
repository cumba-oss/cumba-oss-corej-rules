#!RuleTest
#test PMDA-SD1108 expect=noViolation domain=DM
#note "The Vital Signs (VS) dataset is present in the study inventory -> no violation."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SEX     type=Char label="Sex"
---
S1 | DM | 001 | M
---

dataset VS class=FINDINGS label="Vital Signs"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col VSSEQ   type=Num  label="Sequence Number"
col VSTESTCD type=Char label="Vital Signs Test Short Name"
---
S1 | VS | 001 | 1 | SYSBP
---
