#!RuleTest
#test PMDA-SD1337 expect=violation domain=RS
#note "FRESH, DISCRIMINATING - TR present with ZERO rows: every per-subject group resolves to the EMPTY set. Row 1's populated RSLNKID is 'not in' the empty set -> fires. Row 2's empty RSLNKID is guarded by the authored non_empty. If this reports 0, escalate."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001 RSLNKID=T01
dataset RS label="Disease Response"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RSSEQ    type=Num  label="Sequence Number"
col RSLNKID  type=Char label="Link ID"
col RSTESTCD type=Char label="Response Assessment Short Name"
col RSORRES  type=Char label="Result or Finding in Original Units"
---
CDISCPILOT01 | RS | 001 | 1 | T01 | LSTASS | PR
CDISCPILOT01 | RS | 002 | 1 |  | OVRLRESP | PD
---

dataset TR label="Tumor Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col TRSEQ    type=Num  label="Sequence Number"
col TRLNKID  type=Char label="Link ID"
col TRTESTCD type=Char label="Tumor Assessment Short Name"
col TRORRES  type=Char label="Result or Finding in Original Units"
---
---
