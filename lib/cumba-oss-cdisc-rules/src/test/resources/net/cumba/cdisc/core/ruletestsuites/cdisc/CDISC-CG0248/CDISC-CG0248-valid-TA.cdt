#!RuleTest
#test CDISC-CG0248 expect=noViolation domain=TA
#note "All populated TAETORD values are integers, and the blank TAETORD on row 3 is exempt under the populated-value guard -> no violation."
#library standard=sdtmig version=3-4
dataset TA label="Trial Arms"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col ARMCD type=Char label="Planned Arm Code"
col ARM type=Char label="Description of Planned Arm"
col TAETORD type=Num label="Order of Element within Arm"
col ETCD type=Char label="Element Code"
---
CDISCPILOT01 | TA | Pbo | Placebo | 1 | SCRN
CDISCPILOT01 | TA | Pbo | Placebo | 2 | PBO
CDISCPILOT01 | TA | Pbo | Placebo |  | FU
