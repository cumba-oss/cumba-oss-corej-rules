#!RuleTest
#test PMDA-SD1287 expect=violation domain=AE
#note "Group 10019211 disagrees 1:1 (Headache vs Cephalalgia) -> BOTH rows fire (minority = both in a tie); group 10028813 is a singleton -> clean."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 AEPTCD=10019211 AEDECOD=Headache
#expectViolationAt row=2 AEPTCD=10019211 AEDECOD=Cephalalgia
dataset AE class=EVENTS
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col AESEQ   type=Num
col AETERM  type=Char
col AEDECOD type=Char
col AEPTCD  type=Num
---
S1 | AE | 001 | 1 | HEADACHE  | Headache    | 10019211
S1 | AE | 002 | 1 | HEAD ACHE | Cephalalgia | 10019211
S1 | AE | 003 | 1 | NAUSEA    | Nausea      | 10028813
