#!RuleTest
#test PMDA-SD1233 expect=skipped domain=LB
#note "Boundary for the Requirements.Variables.All SPDEVID gate: a non-device dataset carries no SPDEVID column, so the rule is skipped instead of flagging every record."
#library standard=sdtmig version=3-4
dataset LB label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBORRES  type=Char label="Result or Finding in Original Units"
---
CDISCPILOT01 | LB | 001 | 1 | ALB | 40
---

dataset DI label="Device Identifiers"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col SPDEVID  type=Char label="Sponsor Device Identifier"
col DISEQ    type=Num  label="Sequence Number"
col DIPARMCD type=Char label="Device Parameter Short Name"
col DIPARM   type=Char label="Device Parameter"
col DIVAL    type=Char label="Device Parameter Value"
---
CDISCPILOT01 | DI | DEV-001 | 1 | DEVTYPE | Device Type | Infusion Pump
---
