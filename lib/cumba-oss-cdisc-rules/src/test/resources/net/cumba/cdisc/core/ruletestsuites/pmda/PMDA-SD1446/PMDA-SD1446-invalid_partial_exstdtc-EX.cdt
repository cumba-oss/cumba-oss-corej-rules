#!RuleTest
#test PMDA-SD1446 expect=violation domain=EX
#note "FRESH - DISCRIMINATING '>' hull pair (IsoDateComparison FOR-ALL: A > B iff lower(A) > upper(B)). Row 1: partial '2020-07' -> lower hull 2020-07-01 is after max 2020-05-30's upper -> FIRES. Row 2: partial '2020-05' -> lower hull 2020-05-01 does not clear 2020-05-30 (straddle) -> silent. If either row flips, escalate."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 EXSTDTC=2020-07
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
---
S1 | EX | 001 | 1 | DRUG A | 2020-07
S1 | EX | 002 | 1 | DRUG A | 2020-05
---

dataset DS class=EVENTS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSTERM  type=Char label="Reported Term for the Disposition Event"
col DSDECOD type=Char label="Standardized Disposition Term"
col DSSTDTC type=Char label="Start Date/Time of Disposition"
---
S1 | DS | 001 | 1 | COMPLETED | COMPLETED | 2020-05-30
S1 | DS | 002 | 1 | COMPLETED | COMPLETED | 2020-05-30
