#!RuleTest
#test FDA-SD1249 expect=violation domain=EX
#note "Boundary: a missing EXDOSE on a placebo administration is also not equal to 0 (populated-vs-missing truth table) -> fires."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 EXTRT=PLACEBO
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXDOSE  type=Num  label="Dose per Administration"
---
CDISCPILOT01 | EX | 01-701-1015 | 1 | PLACEBO | .
CDISCPILOT01 | EX | 01-701-1023 | 1 | XANOMELINE | 54
