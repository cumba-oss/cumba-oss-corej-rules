#!RuleTest
#test PMDA-AD0247 expect=violation domain=ADTTE
#note "STARTDT blank on row 1 while CNSR is populated -> the second inner disjunct fires. Row 2 fully populated -> silent. Isolates the STARTDT arm."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015 AVAL=30 CNSR=1
dataset ADTTE structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col STARTDT type=Num
col ADT     type=Num
col ADTM    type=Num
col CNSR    type=Num
---
CDISCPILOT01 | 01-701-1015 | TTDEATH | 30 |       | 22100 | 22100 | 1
CDISCPILOT01 | 01-701-1023 | TTDEATH | 30 | 22000 | 22100 | 22100 | 0
