#!RuleTest
#test CDISC-AD0873 expect=violation domain=ADLBC
# Rule:Description: Within a dataset, there is more than one value of SEX for a given value of SEXN, considering only those rows on which both variables are populated
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015
#expectViolationAt row=2 USUBJID=01-701-1023
# Declared-tier scope: structure= states the ADaM data structure this minimal table stands for;
# #define is its mandatory carrier (ScenarioDeclaredScopeProvider.install).
#define standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col SEX type=Char
col SEXN type=Char
---
CDISCPILOT01 | 01-701-1015 | M | 1
CDISCPILOT01 | 01-701-1023 | F | 1
CDISCPILOT01 | 01-701-1028 | U | 2
---
