#!RuleTest
#test CDISC-SEND-0290 expect=violation domain=LB
#note "First disjunct: the KEY is --TPT and the DEPENDENT is --TPTNUM, and within the ALB partition the key '1 HOUR' has two distinct dependents, 1 and 2 -> rows 1 and 2 fire. Row 3's key '2 HOUR' has one dependent. Every row of the offending group fires -- there is no per-group collapse, because the rule carries no Grouping block. The M3-D21 widening added --DY, --CAT and --SCAT to the partition; none of those columns is declared here, and the grouped operator drops absent key columns and regroups, so the verdict is unchanged."
#library standard=sendig version=3-1-1
#expectViolationCount 2
#expectViolationAt row=1 LBTPT="1 HOUR" LBTPTNUM=1
#expectViolationAt row=2 LBTPT="1 HOUR" LBTPTNUM=2
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBTEST   type=Char label="Lab Test or Examination Name"
col LBORRES  type=Char label="Result or Finding in Original Units"
col LBTPT    type=Char label="Planned Time Point Name"
col LBTPTNUM type=Num  label="Planned Time Point Number"
---
S1 | LB | 001 | 1 | ALB | Albumin | 41 | 1 HOUR | 1
S1 | LB | 002 | 1 | ALB | Albumin | 39 | 1 HOUR | 2
S1 | LB | 003 | 1 | ALB | Albumin | 40 | 2 HOUR | 3
---
