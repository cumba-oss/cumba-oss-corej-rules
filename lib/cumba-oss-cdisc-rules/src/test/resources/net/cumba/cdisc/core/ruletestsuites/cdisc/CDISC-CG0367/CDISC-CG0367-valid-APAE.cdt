#!RuleTest
#test CDISC-CG0367 expect=noViolation domain=APAE
#note "Row 1's RSUBJID matches a DM.USUBJID; row 2's RSUBJID is empty -> no violation."
dataset APAE label="Associated Persons Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col APID    type=Char label="Associated Persons Identifier"
col RSUBJID type=Char label="Related Subject or Pool Identifier"
col POOLID  type=Char label="Pool Identifier"
---
CDISCPILOT01 | APAE | AP-701-1015 | 01-701-1015 |
CDISCPILOT01 | APAE | AP-701-1016 |             |
---

dataset DM label=Demographics
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | DM | 01-701-1015
