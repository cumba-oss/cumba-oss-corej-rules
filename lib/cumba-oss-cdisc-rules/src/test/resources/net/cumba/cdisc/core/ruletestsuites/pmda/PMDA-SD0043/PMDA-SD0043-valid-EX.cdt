#!RuleTest
#test PMDA-SD0043 expect=noViolation domain=EX
#note "Every record with a treatment vehicle amount (EXVAMT) also names the vehicle (EXTRTV); row 3 has neither."
#library standard=sdtmig version=3-4
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXTRTV  type=Char label="Treatment Vehicle"
col EXVAMT  type=Num  label="Treatment Vehicle Amount"
---
CDISCPILOT01 | EX | 01-701-1015 | 1 | DRUG A | SALINE | 5
CDISCPILOT01 | EX | 01-701-1015 | 2 | DRUG A | SALINE | 10
CDISCPILOT01 | EX | 01-701-1023 | 1 | DRUG A |        |
