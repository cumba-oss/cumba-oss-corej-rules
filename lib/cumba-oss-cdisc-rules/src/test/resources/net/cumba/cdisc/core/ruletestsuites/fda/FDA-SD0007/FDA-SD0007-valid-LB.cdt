#!RuleTest
#test FDA-SD0007 expect=noViolation domain=LB
#note "Every assessment group (--TESTCD/--CAT/--SCAT/--SPEC/--METHOD; --OBJ and --TSTDTL are absent from LB and drop out of the key) carries one standard unit. A second group with a different unit is not a conflict."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBCAT    type=Char label="Category for Lab Test"
col LBSCAT   type=Char label="Subcategory for Lab Test"
col LBSPEC   type=Char label="Specimen Type"
col LBMETHOD type=Char label="Method of Test or Examination"
col LBSTRESU type=Char label="Standard Units"
---
S1 | LB | 001 | 1 | GLUC | CHEMISTRY | GLUCOSE | SERUM | ENZYMATIC | mmol/L
S1 | LB | 002 | 1 | GLUC | CHEMISTRY | GLUCOSE | SERUM | ENZYMATIC | mmol/L
S1 | LB | 001 | 2 | ALB  | CHEMISTRY | PROTEIN | SERUM | ENZYMATIC | g/L
