#!RuleTest
#test FDA-SD0079 expect=noViolation domain=EX
#note "Subject 005 has an EX record but no DM record at all. The DM merge is deliberately an inner join: a subject missing from DM is flagged by FDA-SD0064 (all subjects must be present in DM), so this rule stays silent here rather than double-reporting (user decision 2026-07-28)."
#library standard=sdtmig version=3-4
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EPOCH   type=Char label="Epoch"
---
S1 | EX | 005 | 1 | DRUG A | TREATMENT
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
---
S1 | DM | 001 | ARM1 | Arm 1
---
