#!RuleTest
#test PMDA-AD0290 expect=noViolation domain=ADAE
#note "Row 2's AREL (the KEY) is blank while ARELN stays 2: key RELATED left with single dependent {1} -> silent. Pin on the blank-KEY side of D.13."
#library standard=adamig version=1-0
#expectViolationCount 0
dataset ADAE structure=OCCDS
col STUDYID type=Char
col USUBJID type=Char
col AESEQ   type=Num
col AEDECOD type=Char
col AREL    type=Char
col ARELN   type=Num
---
CDISCPILOT01 | 01-701-1015 | 1 | HEADACHE | RELATED | 1
CDISCPILOT01 | 01-701-1023 | 1 | NAUSEA |  | 2
CDISCPILOT01 | 01-701-1034 | 2 | RASH | NOTRELATED | 3
