#!RuleTest
#test PMDA-AD0205 expect=violation domain=ADSL
#note "JOIN: Match_Datasets DM on Keys=[USUBJID], Join_Type inner (default -- correct: the rule fires on a POPULATED merged value; the unmatched-subject defect belongs to AD0053); DM one row per subject -> 1:1. ADSL.AGEU populated and != DM.AGEU -> fires."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 AGEU=YEARS
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col AGEU    type=Char
---
CDISCPILOT01 | 01-701-1015 | YEARS
---

dataset DM label=Demographics
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col AGEU    type=Char
---
CDISCPILOT01 | DM | 01-701-1015 | MONTHS
