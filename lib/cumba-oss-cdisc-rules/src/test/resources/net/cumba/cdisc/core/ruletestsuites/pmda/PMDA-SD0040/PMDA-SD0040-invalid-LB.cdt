#!RuleTest
#test PMDA-SD0040 expect=violation domain=LB
#note "LBTESTCD=GLUC carries two different test names ('Glucose' and 'Glucose Level'), so the --TEST/--TESTCD pairing is not 1-1. Both records of the conflicting pair are reported (Sensitivity Record)."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 LBTESTCD=GLUC LBTEST=Glucose
#expectViolationAt row=2 LBTESTCD=GLUC LBTEST="Glucose Level"
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBTEST   type=Char label="Lab Test or Examination Name"
---
S1 | LB | 001 | 1 | GLUC | Glucose
S1 | LB | 002 | 1 | GLUC | Glucose Level
S1 | LB | 001 | 2 | ALB  | Albumin
