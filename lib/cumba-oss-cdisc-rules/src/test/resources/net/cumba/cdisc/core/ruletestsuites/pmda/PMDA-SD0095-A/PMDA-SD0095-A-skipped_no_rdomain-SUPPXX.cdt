#!RuleTest
#test PMDA-SD0095-A expect=skipped domain=SUPPXX
#note "CORPUS-WIDE PIN of the REFERENCED_DOMAIN_CLASS absent-column skip: evalReferencedDomainClass returns LIBRARY_NOT_AVAILABLE when the RDOMAIN column is absent -> the rule is reported SKIPPED, a different verdict channel than the machine var_exists guard's execute-and-silent (the op-level skip wins because the operation is probed eagerly)."
#library standard=sdtmig version=3-4
dataset SUPPXX class=RELATIONSHIP label="Supplemental Qualifiers for XX"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col QNAM    type=Char label="Qualifier Variable Name"
col QVAL    type=Char label="Data Value"
---
S1 | 001 | XXNOTE | Extra info
