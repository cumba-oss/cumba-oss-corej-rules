#!RuleTest
#test CDISC-CG0284 expect=noViolation domain=TS
#note "Positive control added by PLAN-absent-guard-test-hardening P3: this rule previously had ONLY an expect=skipped fixture, which asserts non-execution and so proved nothing about the rule ever running at this standard/version. TSVAL is an integer greater than zero, so the rule is satisfied."
#library standard=sdtmig version=3-3
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL    type=Char label="Parameter Value"
---
CDISCPILOT01 | TS | 1 | NARMS | 2
---
