#!RuleTest
#test PMDA-SD0024 expect=violation domain=LB
#note "LBDTC is not present in the dataset at all while LBENDTC is populated on row 1 -> the collection date/time is missing, which the sheet condition flags. Encodes the column-absent case: the Check carries a bare empty(--DTC) leaf, which under absent = all-missing (EC-43) is TRUE on every row of a column that is not there. Plan B phase 4d' deleted the redundant not var_exists(--DTC) disjunct that used to spell this out; the verdict is unchanged."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 LBENDTC=2020-01-01T09:00
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBENDTC  type=Char label="End Date/Time of Specimen Collection"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | GLUC | 2020-01-01T09:00
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALB  |
