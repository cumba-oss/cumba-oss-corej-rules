#!RuleTest
#test PMDA-AD0482 expect=noViolation domain=ADLBC
#note "COMPLEMENTARITY pin - the record state that PMDA-AD0483 flags and PMDA-AD0482 must NOT. BCHGCA1N=0 is a value, not empty (operator-examples E.2); BCHGCAT1 is empty; the AD0482 direction (not empty(BCHGCATy) and empty(BCHGCAyN)) is false."
#expectViolationCount 0
#library standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID    type=Char
col USUBJID    type=Char
col PARAMCD    type=Char
col BCHGCAT1   type=Char
col BCHGCA1N   type=Num
---
CDISCPILOT01 | 01-701-1015 | GLUC | | 0
---
