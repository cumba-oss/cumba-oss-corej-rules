#!RuleTest
#test FDA-SD1404 expect=violation domain=DM
#note "column-absent case (the bare empty() leaf is TRUE on every row of an absent column, absent = all-missing, EC-43; Plan B phase 4d' deleted the redundant not var_exists disjunct): RFCSTDTC is populated but the RFCENDTC column is absent from the dataset altogether -> fires."
#library standard=sendig version=ar-1-0
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFCSTDTC type=Char label="Date/Time of First Challenge Agent Admin"
---
S1 | DM | 001 | 2020-01-05
