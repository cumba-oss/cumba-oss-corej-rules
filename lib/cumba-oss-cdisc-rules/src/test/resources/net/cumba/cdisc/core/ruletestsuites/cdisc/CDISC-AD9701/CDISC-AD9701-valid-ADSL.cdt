#!RuleTest
#test CDISC-AD9701 expect=noViolation domain=ADSL
#note "ADSL carries two records ($records_in_dataset = 2, not equal to 0) -> no violation. Negative control for the -invalid_empty_dataset- twin."
#library standard=adamig version=1-3
dataset ADSL label="Subject-Level Analysis Dataset"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col TRT01P  type=Char label="Planned Treatment for Period 01"
---
CDISCPILOT01 | 01-701-1015 | 1015 | Placebo
CDISCPILOT01 | 01-701-1023 | 1023 | Xanomeline High Dose
---
