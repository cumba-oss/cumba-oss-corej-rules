#!RuleTest
#test PMDA-SD1251 expect=noViolation domain=EX
#note "row 1 has a vehicle and its amount units; row 2 has neither -> no violation."
#library standard=sdtmig version=3-4
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Actual Treatment"
col EXTRTV  type=Char label="Treatment Vehicle"
col EXVAMT  type=Num  label="Treatment Vehicle Amount"
col EXVAMTU type=Char label="Treatment Vehicle Amount Units"
---
S1 | EX | 001 | 1 | DRUG A | SALINE | 10 | mL
S1 | EX | 002 | 1 | DRUG A |  |  |
