#!RuleTest
#test PMDA-SD1111 expect=noViolation domain=DM
#note "The Subject Elements (SE) dataset is present in the study inventory -> no violation."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SEX     type=Char label="Sex"
---
S1 | DM | 001 | M
---

dataset SE class="SPECIAL PURPOSE" label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ   type=Num  label="Sequence Number"
col ETCD    type=Char label="Element Code"
---
S1 | SE | 001 | 1 | SCRN
---
