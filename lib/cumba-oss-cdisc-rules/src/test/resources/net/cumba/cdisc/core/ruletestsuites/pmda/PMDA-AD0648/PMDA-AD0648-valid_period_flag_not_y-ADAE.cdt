#!RuleTest
#test PMDA-AD0648 expect=noViolation domain=ADAE
#note "Pins the value() == 'Y' conjunct: the requirement is one-directional - a period flag that is N or blank says nothing about the overall flag, so an overall N is conformant."
#library standard=adamig version=1-3
dataset ADAE structure=OCCDS subclass=AE
col STUDYID  type=Char
col USUBJID  type=Char
col ASEQ     type=Num
col AEDECOD  type=Char
col TRTEM1FL type=Char
col TRTEMFL  type=Char
---
CDISCPILOT01 | 01-701-1015 | 1 | HEADACHE | N | N
CDISCPILOT01 | 01-701-1015 | 2 | NAUSEA   |   | N
