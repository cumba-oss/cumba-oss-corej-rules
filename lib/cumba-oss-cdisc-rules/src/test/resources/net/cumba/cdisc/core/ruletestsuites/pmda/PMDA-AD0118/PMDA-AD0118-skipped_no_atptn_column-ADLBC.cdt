#!RuleTest
#test PMDA-AD0118 expect=skipped domain=ADLBC
#note "ATPTN absent. Requirements.Variables.All [ATPTN] -> skipped, naming ATPTN. Instructive contrast with PMDA-AD0117-valid_no_atptn_column-ADLBC.cdt, which drops the SAME column and reports noViolation instead: on AD0117 ATPTN is a key (guarded by var_exists), on AD0118 it is the target (guarded by Requirements.Variables)."
#library standard=adamig version=1-0
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ATPT    type=Char
