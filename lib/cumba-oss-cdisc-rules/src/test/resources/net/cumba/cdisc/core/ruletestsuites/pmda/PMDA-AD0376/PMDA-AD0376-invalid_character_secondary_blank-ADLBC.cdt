#!RuleTest
#test PMDA-AD0376 expect=violation domain=ADLBC
#note "Columns EXACTLY STUDYID/USUBJID/PARAMCD/APERIOD/APERIODC. APERIODC is the only *C match (APERIOD ends in D, PARAMCD ends in D), and APERIOD/APERIODC is a real ADaMIG 1-3 Timing pair. One expansion, root APERIOD, with APERIODN synthesised absent so the FIRST disjunct is dead and the *C arm is what fires. Row 1: primary populated, APERIODC present-and-blank -> FIRES. Row 2: silent. Isolates the *C arm from the *N arm."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015 APERIOD=1
dataset ADLBC
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col APERIOD  type=Num
col APERIODC type=Char
---
CDISCPILOT01 | 01-701-1015 | ALB | 1 |
CDISCPILOT01 | 01-701-1023 | ALB | 2 | PERIOD2
