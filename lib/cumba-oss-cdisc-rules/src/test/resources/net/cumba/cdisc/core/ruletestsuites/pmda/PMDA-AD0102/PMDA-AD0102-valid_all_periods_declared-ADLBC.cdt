#!RuleTest
#test PMDA-AD0102 expect=noViolation domain=ADLBC
#note "Every populated APERIOD resolves to a declared TRTxxP (zero-padding pinned: APERIOD=1 -> TRT01P) -> no fire."
#library standard=adamig version=1-3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col APERIOD type=Num
---
S1 | 001 | GLUC | 5.1 | 1
S1 | 001 | GLUC | 5.4 | 2
S1 | 001 | GLUC | 5.2 |
---

dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRT01P  type=Char
col TRT02P  type=Char
---
S1 | 001 | Placebo | Xanomeline
