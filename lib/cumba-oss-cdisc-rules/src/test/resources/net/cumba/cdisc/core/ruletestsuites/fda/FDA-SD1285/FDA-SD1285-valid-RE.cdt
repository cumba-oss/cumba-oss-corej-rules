#!RuleTest
#test FDA-SD1285 expect=noViolation domain=RE
#note "REDIR present together with RELOC -> conformant."
#library standard=sdtmig version=3-4
dataset RE class=FINDINGS label="Respiratory System Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RESEQ    type=Num  label="Sequence Number"
col RETESTCD type=Char label="Respiratory Test or Examination Short Name"
col RELOC    type=Char label="Location Used for the Measurement"
col REDIR    type=Char label="Directionality"
---
CDISCPILOT01 | RE | 01-701-1015 | 1 | FEV1 | LUNG | UPPER
---
