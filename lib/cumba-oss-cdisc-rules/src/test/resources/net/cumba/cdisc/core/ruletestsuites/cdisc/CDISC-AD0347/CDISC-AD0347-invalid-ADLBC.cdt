#!RuleTest
#test CDISC-AD0347 expect=violation domain=ADLBC
# Rule:Description: Within a parameter, there is more than one value of AyLO for a given value of AyLOC
#note "within PARAMCD GLUC, A1LOC=G maps to two distinct A1LO values -> violation"
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015
#expectViolationAt row=2 USUBJID=01-701-1015
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col A1LO type=Char
col A1LOC type=Char
---
CDISCPILOT01 | 01-701-1015 | GLUC | A1 | G
CDISCPILOT01 | 01-701-1015 | GLUC | A2 | G
---
