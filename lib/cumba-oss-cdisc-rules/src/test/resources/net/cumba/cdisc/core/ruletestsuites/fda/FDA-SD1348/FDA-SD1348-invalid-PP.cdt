#!RuleTest
#test FDA-SD1348 expect=violation domain=PP
#note "Row 1: interval test with PPSTINT empty -> fires. Row 2: interval test with PPENINT empty -> fires. Row 3: interval test fully populated -> no fire. Row 4: non-interval test, both empty -> no fire."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 PPSEQ=1
#expectViolationAt row=2 PPSEQ=2
dataset PP class=FINDINGS label="Pharmacokinetics Parameters"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PPSEQ    type=Num  label="Sequence Number"
col PPTESTCD type=Char label="Parameter Short Name"
col PPTEST   type=Char label="Parameter Name"
col PPSTINT  type=Char label="Planned Start of Assessment Interval"
col PPENINT  type=Char label="Planned End of Assessment Interval"
---
S1 | PP | 001 | 1 | AUCINT | AUC from T1 to T2     |      | PT12H
S1 | PP | 001 | 2 | AUCINT | AUC from T1 to T2     | PT0H |
S1 | PP | 001 | 3 | AUCINT | AUC from T1 to T2     | PT0H | PT12H
S1 | PP | 001 | 4 | CMAX   | Maximum Concentration |      |
