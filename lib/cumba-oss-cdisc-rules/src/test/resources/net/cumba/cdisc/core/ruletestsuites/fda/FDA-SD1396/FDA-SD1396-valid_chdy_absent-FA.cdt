#!RuleTest
#test FDA-SD1396 expect=skipped domain=FA
#note "Absent-vs-empty boundary: the FACHDY column is absent from the dataset altogether, so Requirements.Variables.All gates the rule to a SKIP -> no violation (parity with the Python KeyError-skip)."
#library standard=sendig version=ar-1-0
dataset FA class="FINDINGS ABOUT" label="Findings About Events or Interventions"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col FASEQ    type=Num  label="Sequence Number"
col FATESTCD type=Char label="Findings About Test Short Name"
col FADTC    type=Char label="Date/Time of Collection"
---
S1 | FA | 001 | 1 | SEV | 2020-01-10
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFCSTDTC type=Char label="Date/Time of First Challenge Agent Admin"
---
S1 | DM | 001 | 2020-01-05
---
