#!RuleTest
#test PMDA-SD0034 expect=noViolation domain=LB
#note "Row 1: LBELTM populated with LBTPTREF populated -> clean. Row 2: both empty -> clean."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS
col STUDYID   type=Char
col DOMAIN    type=Char
col USUBJID   type=Char
col LBSEQ     type=Num
col LBTESTCD  type=Char
col LBELTM    type=Char
col LBTPTREF  type=Char
---
S1 | LB | 001 | 1 | GLUC | PT1H | DOSE ADMINISTRATION
S1 | LB | 001 | 2 | GLUC |      |
