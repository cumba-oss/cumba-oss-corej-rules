#!RuleTest
#test FDA-SD1247-A expect=noViolation domain=EC
#note "ECOCCUR alone is present: the sister fires only when ALL FOUR dose columns are absent, so a dataset that records occurrence (but no dose columns) is not the sister's case - the residual middle configurations are deliberately left to the coverage sweeps (H3 ruling scope)."
#library standard=sdtmig version=3-4
dataset EC class=INTERVENTIONS label="Exposure as Collected"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col ECSEQ type=Num label="Sequence Number"
col ECTRT type=Char label="Name of Treatment"
col ECOCCUR type=Char label="Occurrence"
---
S1 | EC | 001 | 1 | DRUG A | Y
S1 | EC | 001 | 2 | DRUG A | N
