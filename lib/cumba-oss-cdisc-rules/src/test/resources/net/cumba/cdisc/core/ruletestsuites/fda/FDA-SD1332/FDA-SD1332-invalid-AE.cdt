#!RuleTest
#test FDA-SD1332 expect=violation domain=AE
#note "Row 2 claims the event is NOT RECOVERED/NOT RESOLVED yet supplies an end date -> fires."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 AEENDTC=2020-01-09
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEOUT   type=Char label="Outcome of Adverse Event"
col AESTDTC type=Char label="Start Date/Time of Adverse Event"
col AEENDTC type=Char label="End Date/Time of Adverse Event"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE | NOT RECOVERED/NOT RESOLVED | 2020-01-05 | 
CDISCPILOT01 | AE | 01-701-1015 | 2 | NAUSEA   | NOT RECOVERED/NOT RESOLVED | 2020-01-06 | 2020-01-09
