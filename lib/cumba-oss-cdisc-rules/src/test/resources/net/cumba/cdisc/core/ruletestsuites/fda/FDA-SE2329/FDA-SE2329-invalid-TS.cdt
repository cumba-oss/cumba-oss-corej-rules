#!RuleTest
#test FDA-SE2329 expect=violation domain=TS
#note "No TSPARMCD=DOSENDTC record anywhere in TS -> the 'End Date Time Of Dose Interval' parameter is missing, one dataset-level finding. the near-miss parameters DOSSTDTC (same DOS prefix) and STENDTC / EXPENDTC (same ENDTC suffix) would wrongly silence the rule under a loose match."
#library standard=sendig version=3-1-1
#expectViolationCount 1
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | DOSSTDTC | Start Date Time Of Dose Interval           | 2021-01-12
S01 | TS | 2 | STENDTC  | Nonclinical Study End Date                 | 2021-03-15
S01 | TS | 3 | EXPENDTC | Experiment End Date                        | 2021-03-10
