#!RuleTest
#test FDA-SD2262 expect=noViolation domain=TS
#note "All TRT rows pair TSVALCD and TSVAL from the same dummy-UNII SRS record (R16CO5Y76E=ASPIRIN, WK2XYI10QM=IBUPROFEN); blank-code and blank-term rows do not fire (completeness is another rule's concern) and the mismatched pair on the AGEMAX row is outside the TRT condition."
#library standard=sdtmig version=3-4
#dictionaries dummy
dataset TS
col STUDYID  type=Char
col DOMAIN   type=Char
col TSSEQ    type=Num
col TSPARMCD type=Char
col TSVAL    type=Char
col TSVALCD  type=Char
---
S01 | TS | 1 | TRT    | ASPIRIN   | R16CO5Y76E
S01 | TS | 2 | TRT    | IBUPROFEN | WK2XYI10QM
S01 | TS | 3 | TRT    | ASPIRIN   |
S01 | TS | 4 | TRT    |           | WK2XYI10QM
S01 | TS | 5 | AGEMAX | ASPIRIN   | WK2XYI10QM
