#!RuleTest
#test PMDA-SD1135 expect=skipped domain=AE
#note "FRESH: the batch's Domains.Include reject pin (Include [EC, EX]). AE is out of scope. AESTDY=-5 is negative and WOULD fire were AE in scope, so this skip is discriminating."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESTDY  type=Num  label="Study Day of Start of Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE | -5
