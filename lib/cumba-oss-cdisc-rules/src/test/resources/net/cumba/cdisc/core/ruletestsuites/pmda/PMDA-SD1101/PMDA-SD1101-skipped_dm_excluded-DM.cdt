#!RuleTest
#test PMDA-SD1101 expect=skipped domain=DM
#note "DM's class IS in Classes.Include (SPECIAL PURPOSE) but DM sits in Domains.Exclude [CO, DM] -> pre-gate skip; proves the exclude dimension ANDs against the class include. Pinned here ON BEHALF OF SD1102/SD1103/SD1104 (identical [CO, DM] block)."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE"
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col ARMCD   type=Char
---
S1 | DM | 001 | A
