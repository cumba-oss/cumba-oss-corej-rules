#!RuleTest
#test PMDA-SD2283 expect=noViolation domain=TS
#note "Row 1 uses the null-flavor code 'NI', row 2 the same codelist in lower case ('na' - the membership test is case-insensitive), row 3 leaves TSVALNF empty because TSVAL is populated."
#library standard=sdtmig version=3-4
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL    type=Char label="Parameter Value"
col TSVALNF  type=Char label="Parameter Null Flavor"
---
CDISCPILOT01 | TS | 1 | PCLAS  |                   | NI
CDISCPILOT01 | TS | 2 | ADAPT  |                   | na
CDISCPILOT01 | TS | 3 | TITLE  | A Study of Drug X |
