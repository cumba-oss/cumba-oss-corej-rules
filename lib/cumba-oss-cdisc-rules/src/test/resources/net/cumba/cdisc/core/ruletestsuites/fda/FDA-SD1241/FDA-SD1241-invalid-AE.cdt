#!RuleTest
#test FDA-SD1241 expect=violation domain=AE
#note "row 1: AEBDSYCD populated but AEBODSYS present-and-empty -> fires."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 AEBDSYCD=10029205
dataset AE class=EVENTS label="Adverse Events"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col AESEQ    type=Num  label="Sequence Number"
col AETERM   type=Char label="Reported Term for the Adverse Event"
col AEDECOD  type=Char label="Dictionary-Derived Term"
col AEBODSYS type=Char label="Body System or Organ Class"
col AEBDSYCD type=Num  label="Body System or Organ Class Code"
---
S1 | AE | 001 | 1 | HEADACHE | HEADACHE |  | 10029205
S1 | AE | 002 | 1 | NAUSEA | NAUSEA | GASTROINTESTINAL DISORDERS | 10017947
