#!RuleTest
#test CDISC-CG0226 expect=noViolation domain=CM
#note "Both subjects have DM.RFSTDTC populated, so a populated CMSTRF is legitimate. Row 2 additionally leaves CMSTRF empty, which the not-empty conjunct skips."
#library standard=sdtmig version=3-4
dataset CM class=INTERVENTIONS label="Concomitant/Prior Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ   type=Num  label="Sequence Number"
col CMTRT   type=Char label="Reported Name of Drug, Med, or Therapy"
col CMSTRF  type=Char label="Start Relative to Reference Period"
---
S1 | CM | 001 | 1 | ASPIRIN | BEFORE
S1 | CM | 002 | 1 | ASPIRIN |
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
---
S1 | DM | 001 | 2020-01-01
S1 | DM | 002 | 2020-01-01
