#!RuleTest
#test FDA-SD1339 expect=violation domain=LB
#note "EPOCH is not present in the dataset at all while the collection date LBDTC (--DTC) is populated on row 1 -> fires (absent EPOCH counts as not populated). Row 2 has no date and must not fire."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 LBTESTCD=ALB
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBDTC    type=Char label="Date/Time of Specimen Collection"
---
S1 | LB | 001 | 1 | ALB  | 2023-06-01
S1 | LB | 001 | 2 | GLUC |
