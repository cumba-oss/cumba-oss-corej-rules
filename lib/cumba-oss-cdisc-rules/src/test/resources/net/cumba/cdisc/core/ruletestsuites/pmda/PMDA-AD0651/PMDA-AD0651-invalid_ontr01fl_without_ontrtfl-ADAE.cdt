#!RuleTest
#test PMDA-AD0651 expect=violation domain=ADAE
#note "ONTR01FL declared, ONTRTFL absent. ^ONTR(\d{2})FL$ matches ONTR01FL (xx=01) and matches nothing else - ONTRTFL would not match even if present, because 'TF' is not two digits. ONE expansion, ONE violation at row 1."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 ONTR01FL=Y
dataset ADAE class=OCCDS
col STUDYID  type=Char
col USUBJID  type=Char
col ASEQ     type=Num
col AEDECOD  type=Char
col ONTR01FL type=Char
---
CDISCPILOT01 | 01-701-1015 | 1 | HEADACHE | Y
