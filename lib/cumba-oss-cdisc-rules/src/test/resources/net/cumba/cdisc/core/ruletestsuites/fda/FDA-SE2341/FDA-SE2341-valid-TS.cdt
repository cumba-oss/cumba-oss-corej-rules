#!RuleTest
#test FDA-SE2341 expect=noViolation domain=TS
#note "Sheet: 'TSVAL/TXVAL variable value must be in ISO 8601 format, when TSPARMCD/TXPARMCD=EXPENDTC'. Row 1 is a complete ISO date, row 2 a partial (year-month) ISO date -- both valid ISO 8601. Row 3 carries a non-ISO value under a different parameter, which is outside this rule's condition."
#library standard=sendig version=3-1-1
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
SEND001 | TS | 1 | EXPENDTC | Experiment End Date | 2020-01-15
SEND001 | TS | 2 | EXPENDTC | Experiment End Date | 2020-06
SEND001 | TS | 1 | EXPSTDTC | Experiment Start Date | 15JAN2020
