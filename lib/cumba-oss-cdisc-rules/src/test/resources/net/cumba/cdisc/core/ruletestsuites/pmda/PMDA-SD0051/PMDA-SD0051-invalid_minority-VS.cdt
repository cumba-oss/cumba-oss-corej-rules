#!RuleTest
#test PMDA-SD0051 expect=violation domain=VS
#note "BOUNDARY the twin cannot reach -- the MINORITY rule. The VISITNUM=1 group now has a STRICT MAJORITY (2 SCREENING vs 1 BASELINE), so flagInconsistentGroupMinority flags ONLY row 3 -- the count is 1, not 3. NEUTER CHECK: delete row 2 and the group becomes a tie and the count becomes 2."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=3 VISITNUM=1 VISIT=BASELINE
dataset VS class=FINDINGS label="Vital Signs"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VSSEQ    type=Num  label="Sequence Number"
col VSTESTCD type=Char label="Vital Signs Test Short Name"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
S1 | VS | 001 | 1 | SYSBP | 1 | SCREENING
S1 | VS | 002 | 1 | SYSBP | 1 | SCREENING
S1 | VS | 003 | 1 | SYSBP | 1 | BASELINE
S1 | VS | 001 | 2 | SYSBP | 2 | WEEK 2
