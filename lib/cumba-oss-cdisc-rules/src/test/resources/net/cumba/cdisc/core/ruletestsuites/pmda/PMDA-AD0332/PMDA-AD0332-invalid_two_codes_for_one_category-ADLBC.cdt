#!RuleTest
#test PMDA-AD0332 expect=violation domain=ADLBC
#note "PARAMCD and AVAL detect BASIC DATA STRUCTURE. Key is the pair [PARAMCD, CHGCAT1]. Group (GLUC, IMPROVED) holds CHGCAT1N {1 x2, 2 x1} -> row 3 is the lone minority. Row 4 shares CHGCAT1 but has a different PARAMCD, so it forms its own single-valued group and stays silent -- proving the PARAMCD half of the composite key is live. One expansion only (y=1)."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 PARAMCD=GLUC CHGCAT1=IMPROVED CHGCAT1N=2
dataset ADLBC
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVAL     type=Num
col CHGCAT1  type=Char
col CHGCAT1N type=Num
---
S1 | 001 | GLUC | 5.0 | IMPROVED | 1
S1 | 002 | GLUC | 5.1 | IMPROVED | 1
S1 | 003 | GLUC | 5.2 | IMPROVED | 2
S1 | 004 | ALB  | 4.0 | IMPROVED | 9
