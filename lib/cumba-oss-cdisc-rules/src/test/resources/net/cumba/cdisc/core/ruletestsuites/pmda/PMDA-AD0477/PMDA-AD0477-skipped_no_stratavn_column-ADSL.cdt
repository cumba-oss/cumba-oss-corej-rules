#!RuleTest
#test PMDA-AD0477 expect=skipped domain=ADSL
#note "STRATAVN is absent, so Requirements.Variables.All rejects the dataset. Mirror of AD0476's skipped_no_stratav_column, and the pair together prove the two rules gate on OPPOSITE columns."
#library standard=adamig version=1-3
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col STRATAV type=Char
---
S1 | 001 | G1
S1 | 002 | G1
---
