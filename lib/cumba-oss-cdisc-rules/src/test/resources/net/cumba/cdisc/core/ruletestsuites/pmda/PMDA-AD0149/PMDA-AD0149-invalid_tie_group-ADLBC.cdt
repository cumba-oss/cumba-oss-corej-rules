#!RuleTest
#test PMDA-AD0149 expect=violation domain=ADLBC
#note "No strict majority in group (GLUC, 1) -> every non-blank row fires. The batch's second and last tie pin."
#library standard=adamig version=1-0
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015 PARAMCD=GLUC AVAL=1 AVALC=LOW
#expectViolationAt row=2 USUBJID=01-701-1023 PARAMCD=GLUC AVAL=1 AVALC=HIGH
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col AVALC   type=Char
---
CDISCPILOT01 | 01-701-1015 | GLUC | 1 | LOW
CDISCPILOT01 | 01-701-1023 | GLUC | 1 | HIGH
