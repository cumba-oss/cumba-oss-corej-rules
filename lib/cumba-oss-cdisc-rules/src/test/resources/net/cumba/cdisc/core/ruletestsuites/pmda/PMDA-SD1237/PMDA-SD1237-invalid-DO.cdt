#!RuleTest
#test PMDA-SD1237 expect=violation domain=DO
#note "DEV1 carries two DEVTYPE records -> both duplicate rows fire; DEV2's single DEVTYPE record stays clean. ADAPTED-FROM fda/FDA-SD1237/FDA-SD1237-invalid-DO.cdt (verbatim, pins included)."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 SPDEVID=DEV1
#expectViolationAt row=2 SPDEVID=DEV1
dataset DO class=FINDINGS label="Device Properties"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col SPDEVID  type=Char label="Sponsor Device Identifier"
col DOSEQ    type=Num  label="Sequence Number"
col DOTESTCD type=Char label="Device Property Short Name"
col DOORRES  type=Char label="Device Property Result"
---
S1 | DO | DEV1 | 1 | DEVTYPE | Pump
S1 | DO | DEV1 | 2 | DEVTYPE | Stent
S1 | DO | DEV2 | 1 | DEVTYPE | Pump
