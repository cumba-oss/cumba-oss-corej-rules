#!RuleTest
#test PMDA-SD1450 expect=noViolation domain=PP
#note "Both interval bounds declared -> not var_exists(PPENINT) FALSE."
#library standard=sdtmig version=3-4
dataset PP class=FINDINGS label="Pharmacokinetic Parameters"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col PPSEQ    type=Num
col PPTESTCD type=Char
col PPSTINT  type=Char
col PPENINT  type=Char
---
