#!RuleTest
#test FDA-SE2306 expect=violation domain=BW
#note "Wildcard resolution on a second scoped domain: BWDY/BWNOMDY variables not present and VISITDY missing on row 1 -> fires; row 2 VISITDY populated -> ok."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 BWSEQ=1
dataset BW class=FINDINGS label="Body Weight"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col BWSEQ   type=Num  label="Sequence Number"
col VISITDY type=Num  label="Planned Study Day of Visit"
---
S1 | BW | 001 | 1 | .
S1 | BW | 001 | 2 | 1
