#!RuleTest
#test FDA-SD1288 expect=noViolation domain=AE
#note "Boundary: one 'Headache' record leaves --PTCD missing while the others agree. A missing --PTCD is not a competing value, so no inconsistency is reported."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEDECOD type=Char label="Dictionary-Derived Term"
col AEPTCD  type=Num  label="Preferred Term Code"
---
S1 | AE | 001 | 1 | HEADACHE  | Headache | 10019211
S1 | AE | 002 | 1 | HEAD ACHE | Headache |
S1 | AE | 003 | 1 | HEADACHE  | Headache | 10019211
