#!RuleTest
#test PMDA-SD1313 expect=skipped domain=DS
#note "EPOCH (Permissible) is not in the dataset at all: absent is not the same as present-but-empty, so the Requirements.Variables gate skips the rule rather than flagging every DISPOSITION EVENT record. Adapted from FDA-SD1313-valid_no_epoch-DS (renamed valid_no_epoch -> skipped_no_epoch to match current naming practice; expect=skipped unchanged)."
#library standard=sdtmig version=3-4
dataset DS class=EVENTS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSTERM  type=Char label="Reported Term for the Disposition Event"
col DSDECOD type=Char label="Standardized Disposition Term"
col DSCAT   type=Char label="Category for Disposition Event"
---
CDISCPILOT01 | DS | 01-701-1015 | 1 | COMPLETED | COMPLETED | DISPOSITION EVENT
