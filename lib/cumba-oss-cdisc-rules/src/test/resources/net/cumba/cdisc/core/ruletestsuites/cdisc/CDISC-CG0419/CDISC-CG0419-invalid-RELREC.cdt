#!RuleTest
#test CDISC-CG0419 expect=violation domain=RELREC
#note "ADAPTED-FROM fda/FDA-SD1026/FDA-SD1026-invalid-RELREC.cdt (data and pins verbatim). Row 1 relates individual records via IDVAR='AESEQ' yet still carries RELTYPE='ONE' -> fires. Rows 2/3 are the two legitimate shapes: a --SEQ link with an empty RELTYPE, and a dataset-level link on a non---SEQ IDVAR."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 IDVAR=AESEQ RELTYPE=ONE
dataset RELREC label="Related Records"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col RELTYPE  type=Char label="Relationship Type"
col RELID    type=Char label="Relationship Identifier"
---
S1 | AE | 001 | AESEQ    | 1 | ONE | R01
S1 | CM | 001 | CMSEQ    | 2 |     | R01
S1 | AE |     | AEGRPID  |   | ONE | R02
