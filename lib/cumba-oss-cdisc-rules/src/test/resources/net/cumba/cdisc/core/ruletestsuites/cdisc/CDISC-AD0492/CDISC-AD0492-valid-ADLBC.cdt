#note "SHIFT1 present but AVAL also present, so the not-present condition fails -> no violation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col SHIFT1 type=Char
col AVAL type=Num
