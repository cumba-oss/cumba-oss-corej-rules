#!RuleTest
#test PMDA-AD0340 expect=skipped domain=ADEFF
#note "No column matches either wildcard pattern (^MCRIT(\\d+)ML$ / ^MCRIT(\\d+)MN$) -> NoMatch -> SKIPPED. This rule's Scope is Domains:[ALL], so the NoMatch skip is the only skip route it has -- there is no structure gate to test."
#library standard=adamig version=1-3
dataset ADEFF
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
---
S1 | 001 | RESP | 1
S1 | 002 | RESP | 2
