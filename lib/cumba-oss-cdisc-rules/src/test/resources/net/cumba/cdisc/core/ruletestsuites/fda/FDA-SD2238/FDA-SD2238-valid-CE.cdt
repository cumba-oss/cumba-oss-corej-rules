#!RuleTest
#test FDA-SD2238 expect=noViolation domain=CE
#note "Records sharing USUBJID and --STDTC agree on --STTPT; a different date legitimately carries a different reference time point."
#library standard=sdtmig version=3-4
dataset CE class=EVENTS label="Clinical Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CESEQ   type=Num  label="Sequence Number"
col CETERM  type=Char label="Reported Term for the Clinical Event"
col CESTDTC type=Char label="Start Date/Time of Clinical Event"
col CESTTPT type=Char label="Start Reference Time Point"
---
S1 | CE | 001 | 1 | RASH    | 2020-01-15 | SCREENING
S1 | CE | 001 | 2 | ITCHING | 2020-01-15 | SCREENING
S1 | CE | 001 | 3 | FEVER   | 2020-02-01 | RANDOMIZATION
