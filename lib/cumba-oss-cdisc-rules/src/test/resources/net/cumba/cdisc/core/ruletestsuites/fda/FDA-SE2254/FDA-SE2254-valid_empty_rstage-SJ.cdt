#!RuleTest
#test FDA-SE2254 expect=noViolation domain=SJ
#note "Boundary: one GD0-6 record leaves RSTAGE empty while the others agree. An empty RSTAGE is not a competing description and the non_empty guard excludes that record, so no inconsistency is reported."
#library standard=sendig version=dart-1-1
dataset SJ class="SPECIAL PURPOSE" label="Subject Repro Stages"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SJSEQ   type=Num  label="Sequence Number"
col RSTGCD  type=Char label="Repro Stage Code"
col RSTAGE  type=Char label="Description of Repro Stage"
col SJSTDTC type=Char label="Start Date/Time of Repro Stage"
col RPHASE  type=Char label="Repro Phase"
---
S1 | SJ | 001 | 1 | GD0-6 | Gestation Day 0 to 6 | 2020-01-01 | GESTATION
S1 | SJ | 002 | 1 | GD0-6 |                      | 2020-01-01 | GESTATION
S1 | SJ | 003 | 1 | GD0-6 | Gestation Day 0 to 6 | 2020-01-01 | GESTATION
