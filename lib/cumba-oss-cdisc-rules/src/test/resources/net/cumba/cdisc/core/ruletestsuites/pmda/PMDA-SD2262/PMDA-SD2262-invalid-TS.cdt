#!RuleTest
#test PMDA-SD2262 expect=violation domain=TS
#note "Row 2: TSPARMCD=TRT with TSVALCD=R16CO5Y76E (ASPIRIN's UNII in the dummy dictionary) but TSVAL=IBUPROFEN -> code and decode come from different SRS records -> fires. Row 1 is a correctly paired record; row 3 has the same mismatch under another parameter (out of the TRT condition); rows 4/5 have a blank code or blank term (completeness is another rule's concern -> no fire)."
#library standard=sdtmig version=3-4
#dictionaries dummy
#expectViolationCount 1
#expectViolationAt row=2 TSSEQ=2 TSVAL=IBUPROFEN TSVALCD=R16CO5Y76E
dataset TS
col STUDYID  type=Char
col DOMAIN   type=Char
col TSSEQ    type=Num
col TSPARMCD type=Char
col TSVAL    type=Char
col TSVALCD  type=Char
---
S01 | TS | 1 | TRT    | ASPIRIN   | R16CO5Y76E
S01 | TS | 2 | TRT    | IBUPROFEN | R16CO5Y76E
S01 | TS | 3 | AGEMAX | IBUPROFEN | R16CO5Y76E
S01 | TS | 4 | TRT    | ASPIRIN   |
S01 | TS | 5 | TRT    |           | R16CO5Y76E
