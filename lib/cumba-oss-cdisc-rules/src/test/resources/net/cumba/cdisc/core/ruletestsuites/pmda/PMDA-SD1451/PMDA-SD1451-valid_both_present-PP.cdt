#!RuleTest
#test PMDA-SD1451 expect=noViolation domain=PP
#note "PPSTINT also present -> second conjunct false -> silent with execution."
#library standard=sdtmig version=3-4
dataset PP class=FINDINGS label="Pharmacokinetic Parameters"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col PPSEQ    type=Num
col PPTESTCD type=Char
col PPENINT  type=Char
col PPSTINT  type=Char
---
S1 | PP | 001 | 1 | AUCALL | P24H | P0H
---
