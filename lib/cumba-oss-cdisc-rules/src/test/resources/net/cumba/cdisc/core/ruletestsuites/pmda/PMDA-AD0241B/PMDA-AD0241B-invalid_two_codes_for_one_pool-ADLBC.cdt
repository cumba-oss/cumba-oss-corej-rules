#!RuleTest
#test PMDA-AD0241B expect=violation domain=ADLBC
#note "Group TRTAG1=POOLA holds TRTAG1N {1 x2, 2 x1} -- 1 is the strict majority, so row 3 is the lone minority. Group POOLB holds a single distinct value and is silent, proving the consistency is keyed per TRTAG1 rather than over the whole dataset. One wildcard expansion only (y=1)."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 TRTAG1=POOLA TRTAG1N=2
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col TRTAG1  type=Char
col TRTAG1N type=Num
---
S1 | 001 | GLUC | 5.0 | POOLA | 1
S1 | 002 | GLUC | 5.1 | POOLA | 1
S1 | 003 | GLUC | 5.2 | POOLA | 2
S1 | 004 | GLUC | 5.3 | POOLB | 3
