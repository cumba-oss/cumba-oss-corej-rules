#!RuleTest
#test CDISC-AD0331 expect=noViolation domain=ADLBC
# Rule:Description: Within a parameter, there is more than one value of CHGCATy for a given value of CHGCATyN, considering only those rows on which both variables are populated
#note "within PARAMCD=ALB, each CHGCAT1N value maps to a single CHGCAT1 value -> noViolation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col CHGCAT1 type=Char
col CHGCAT1N type=Char
---
CDISCPILOT01 | 01-701-1015 | ALB | low | 1
CDISCPILOT01 | 01-701-1023 | ALB | low | 1
---
