#!RuleTest
#test PMDA-SD0003 expect=noViolation domain=LB
#note "Every populated LBDTC is valid ISO 8601 (full date, date-time, partial date); row 4 leaves LBDTC empty, which the not empty(value()) conjunct gates out — this row matters because invalid_date FIRES on a blank on its own. ADAPTED-FROM fda/FDA-SD0003/FDA-SD0003-valid-LB.cdt (verbatim)."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBDTC    type=Char label="Date/Time of Specimen Collection"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB  | 2020-01-15
CDISCPILOT01 | LB | 01-701-1015 | 2 | GLUC | 2020-01-15T09:30:00
CDISCPILOT01 | LB | 01-701-1015 | 3 | CREAT| 2020-01
CDISCPILOT01 | LB | 01-701-1015 | 4 | ALT  |
