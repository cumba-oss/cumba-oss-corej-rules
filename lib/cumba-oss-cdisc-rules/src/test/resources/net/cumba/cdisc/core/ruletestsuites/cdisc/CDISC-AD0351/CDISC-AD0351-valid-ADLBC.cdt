#!RuleTest
#test CDISC-AD0351 expect=noViolation domain=ADLBC
# Rule:Description: Within a parameter, there is more than one value of AyHIC for a given value of AyHI
#note "each A1HI value maps to a single A1HIC value -> noViolation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col A1HIC type=Char
col A1HI type=Char
---
CDISCPILOT01 | 01-701-1015 | GLUC | A1 | G
CDISCPILOT01 | 01-701-1015 | GLUC | A2 | H
---
