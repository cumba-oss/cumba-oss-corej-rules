#!RuleTest
#test PMDA-AD0225 expect=noViolation domain=ADLBC
#note "Row 1: a grossly wrong percent change, but BASE = 0 so the authored BASE != 0 gate is false and the rule is silent. Row 2: conformant. This is the exact boundary with PMDA-AD0225A, which owns the BASE = 0 case. Note the gate is belt-and-braces: even without it, percentChange(5, 0) returns NaN and differs never reports NaN."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col BASE    type=Num
col PCHG    type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | 5  | 0  | 999
CDISCPILOT01 | 01-701-1023 | ALB | 12 | 10 | 20
