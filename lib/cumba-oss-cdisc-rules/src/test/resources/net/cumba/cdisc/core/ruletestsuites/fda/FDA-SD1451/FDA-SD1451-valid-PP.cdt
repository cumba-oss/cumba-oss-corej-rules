#!RuleTest
#test FDA-SD1451 expect=noViolation domain=PP
#note "PPENINT present together with PPSTINT -> conformant."
#library standard=sdtmig version=3-4
dataset PP class=FINDINGS label="Pharmacokinetic Parameters"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PPSEQ    type=Num  label="Sequence Number"
col PPTESTCD type=Char label="Parameter Short Name"
col PPSTINT  type=Char label="Planned Start of Assessment Interval"
col PPENINT  type=Char label="Planned End of Assessment Interval"
---
CDISCPILOT01 | PP | 01-701-1015 | 1 | AUCALL | PT0H | PT24H
---
