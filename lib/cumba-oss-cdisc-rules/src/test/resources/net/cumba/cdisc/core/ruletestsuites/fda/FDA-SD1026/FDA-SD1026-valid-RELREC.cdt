#!RuleTest
#test FDA-SD1026 expect=noViolation domain=RELREC
#note "Record-level relationships (IDVAR ending in SEQ) leave RELTYPE empty; the dataset-level relationship on row 3 uses a non---SEQ IDVAR, so its populated RELTYPE is allowed."
#library standard=sdtmig version=3-4
dataset RELREC label="Related Records"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col RELTYPE  type=Char label="Relationship Type"
col RELID    type=Char label="Relationship Identifier"
---
S1 | AE | 001 | AESEQ   | 1 |      | R01
S1 | CM | 001 | CMSEQ   | 2 |      | R01
S1 | AE |     | AEGRPID |   | ONE  | R02
S1 | FA |     | FALNKID |   | MANY | R02
