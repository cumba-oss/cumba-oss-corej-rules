#!RuleTest
#test FDA-SD0072 expect=noViolation domain=SUPPAE
#note "RDOMAIN=AE names a domain present in the study (AE dataset registered); empty RDOMAIN row is excluded by the non_empty guard -> no violation"
#library standard=sdtmig version=3-4
dataset SUPPAE class=RELATIONSHIP label="Supplemental Qualifiers for AE"
col STUDYID type=Char label="Study Identifier"
col RDOMAIN type=Char label="Related Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col QNAM    type=Char label="Qualifier Variable Name"
col QVAL    type=Char label="Data Value"
---
S1 | AE | 001 | AESOSP | Y
S1 | AE | 002 | AESOSP | N
S1 |    | 003 | AESOSP | Y
---

dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
---
S1 | AE | 001 | 1
