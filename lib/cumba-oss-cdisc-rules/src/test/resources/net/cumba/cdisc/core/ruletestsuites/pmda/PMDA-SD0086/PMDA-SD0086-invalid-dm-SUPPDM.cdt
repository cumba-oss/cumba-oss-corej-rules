#!RuleTest
#test PMDA-SD0086 expect=violation domain=SUPPDM
#note "DM branch: QNAM RACEOTH occurs twice for subject 001 (parent record = subject for DM, because RDOMAIN=='DM' is what makes the branch apply, not the blank IDVAR/IDVARVAL) -> both duplicate rows fire; row 3 is a different subject, silent. No DOMAIN column declared. ADAPTED-FROM fda/FDA-SD0086/FDA-SD0086-invalid-dm-SUPPDM.cdt (verbatim)."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 QNAM=RACEOTH
#expectViolationAt row=2 QNAM=RACEOTH
dataset SUPPDM class=RELATIONSHIP label="Supplemental Qualifiers for DM"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM     type=Char label="Qualifier Variable Name"
col QVAL     type=Char label="Data Value"
---
S1 | DM | 001 |  |  | RACEOTH | Other race A
S1 | DM | 001 |  |  | RACEOTH | Other race B
S1 | DM | 002 |  |  | RACEOTH | Other race
