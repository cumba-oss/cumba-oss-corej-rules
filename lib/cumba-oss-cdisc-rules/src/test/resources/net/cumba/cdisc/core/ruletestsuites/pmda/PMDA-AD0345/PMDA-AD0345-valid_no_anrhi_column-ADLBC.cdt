#!RuleTest
#test PMDA-AD0345 expect=noViolation domain=ADLBC
#note "ANRHI is not declared. The guard not empty(ANRHI) is false on every row -> EXECUTED and silent, the degraded key suppressed."
#library standard=adamig version=1-3
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ANRHIC  type=Char
---
S1 | 001 | ALB | HIGH
S1 | 002 | ALB | HIGH
S1 | 003 | ALB | ELEVATED
