#!RuleTest
#test FDA-SD1391 expect=noViolation domain=CM
#note "row1 CMCHSTDY populated with CMSTDTC and DM.RFCSTDTC both complete dates -> no fire even though 999 is not the algorithm value (value correctness is not this rule's check) — DM.RFXSTDTC of 001 is EMPTY, so a rule wrongly reading RFXSTDTC would fire on row1; row2 CMCHSTDY missing with CMSTDTC empty; row3 subject 002 has bad DM.RFCSTDTC but CMCHSTDY missing."
#library standard=sendig version=ar-1-0
dataset CM class=INTERVENTIONS
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ   type=Num  label="Sequence Number"
col CMTRT   type=Char label="Reported Name of Treatment"
col CMSTDTC type=Char label="Start Date/Time of Observation"
col CMCHSTDY  type=Num  label="Start Day of Obs Rel to Challenge Agent"
---
S1 | CM | 001 | 1 | DRUG A | 2023-06-25 | 999
S1 | CM | 001 | 2 | DRUG A |  | 
S1 | CM | 002 | 1 | DRUG A | 2023-06-25 | 
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFSTDTC  type=Char label="Subject Reference Start Date/Time"
col RFXSTDTC type=Char label="Date/Time of First Study Treatment"
col RFCSTDTC type=Char label="Date/Time of First Challenge Agent Admin"
---
S1 | DM | 001 | 2023-06-01 |            | 2023-06-20
S1 | DM | 002 | 2023-06-01 | 2023-06-10 |           
S1 | DM | 003 | 2023-06-01 | 2023-06-10 | 2023-06   
