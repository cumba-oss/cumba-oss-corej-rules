#!RuleTest
#test PMDA-AD0231 expect=violation domain=ADDL
#note "Device-level in-scope pin, the positive counterpart of AD0229/AD0232's skips. AD-prefixed name, no BDS indicator, no column ending TERM/TRT/DECOD -> base ADAM OTHER; SPDEVID refines it to DEVICE LEVEL ANALYSIS DATASET, the rule's second Include token."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=003 TRT01P=DRUGA TR01PG1=POOLY
dataset ADDL
col STUDYID type=Char
col USUBJID type=Char
col SPDEVID type=Char
col TRT01P  type=Char
col TR01PG1 type=Char
---
S1 | 001 | DEV01 | DRUGA | POOLX
S1 | 002 | DEV01 | DRUGA | POOLX
S1 | 003 | DEV02 | DRUGA | POOLY
