#!RuleTest
#test PMDA-SD2020 expect=violation domain=DM
#note "Row 1 populates both AGE and AGETXT for the same subject -> fires; rows 2 and 3 populate only one."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001 AGETXT=18-65
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AGE     type=Num  label="Age"
col AGETXT  type=Char label="Age Range"
col AGEU    type=Char label="Age Units"
---
S1 | DM | 001 | 45 | 18-65 | YEARS
S1 | DM | 002 | 52 |       | YEARS
S1 | DM | 003 | .  | 18-65 | YEARS
