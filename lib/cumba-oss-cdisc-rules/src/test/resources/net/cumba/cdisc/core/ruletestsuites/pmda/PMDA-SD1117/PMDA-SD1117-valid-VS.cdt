#!RuleTest
#test PMDA-SD1117 expect=noViolation domain=VS
#note "Natural key = USUBJID + VSTESTCD + library qualifier/timing variables present (VSPOS, VSDTC, VSORRES). Rows differ in VSDTC (timing) or in VSORRES (result qualifier) -> no duplicates."
#library standard=sdtmig version=3-4
#library dataset-class VS FINDINGS
#library domain-variables VS VSTESTCD:Topic "VSPOS:Record Qualifier" "VSORRES:Result Qualifier" VSDTC:Timing
dataset VS class=FINDINGS label="Vital Signs"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col VSSEQ   type=Num  label="Sequence Number"
col VSTESTCD type=Char label="Vital Signs Test Short Name"
col VSPOS   type=Char label="Vital Signs Position of Subject"
col VSORRES type=Char label="Result or Finding in Original Units"
col VSDTC   type=Char label="Date/Time of Measurements"
---
S1 | VS | 001 | 1 | SYSBP | SITTING | 120 | 2020-01-01
S1 | VS | 001 | 2 | SYSBP | SITTING | 118 | 2020-01-08
S1 | VS | 001 | 3 | SYSBP | SITTING | 121 | 2020-01-01T08:00
S1 | VS | 002 | 1 | SYSBP | SITTING | 120 | 2020-01-01
