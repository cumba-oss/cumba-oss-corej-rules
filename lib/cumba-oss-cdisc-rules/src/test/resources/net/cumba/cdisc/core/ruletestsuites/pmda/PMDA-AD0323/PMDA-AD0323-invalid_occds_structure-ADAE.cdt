#!RuleTest
#test PMDA-AD0323 expect=violation domain=ADAE
#note "OCCDS arm of the batch's only four-token Data_Structures block. No BDS indicator (no PARAMCD/PARAM/AVAL/AVALC) and AEDECOD ends with DECOD, so the detected structure is OCCURRENCE DATA STRUCTURE, the block's second Include token."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=003 APHASE=TREATMENT APHASEN=3
dataset ADAE
col STUDYID type=Char
col USUBJID type=Char
col AEDECOD type=Char
col APHASE  type=Char
col APHASEN type=Num
---
S1 | 001 | HEADACHE | TREATMENT | 2
S1 | 002 | HEADACHE | TREATMENT | 2
S1 | 003 | HEADACHE | TREATMENT | 3
