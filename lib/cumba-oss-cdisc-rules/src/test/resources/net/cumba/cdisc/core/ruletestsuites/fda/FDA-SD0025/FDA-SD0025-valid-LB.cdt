#!RuleTest
#test FDA-SD0025 expect=noViolation domain=LB
#note "Sheet: '--DTC must be less or equal to --ENDTC'. Row 1 collection < end, row 2 collection = end (less-OR-EQUAL is conformant), row 3 has no end date, row 4 no collection date -- the last two are outside the condition."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBDTC    type=Char label="Date/Time of Specimen Collection"
col LBENDTC  type=Char label="End Date/Time of Specimen Collection"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | GLUC | 2020-01-01T08:00 | 2020-01-01T09:00
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALB  | 2020-02-01T08:00 | 2020-02-01T08:00
CDISCPILOT01 | LB | 01-701-1023 | 1 | GLUC | 2020-03-01T08:00 |
CDISCPILOT01 | LB | 01-701-1023 | 2 | ALB  |                  | 2020-04-01T09:00
