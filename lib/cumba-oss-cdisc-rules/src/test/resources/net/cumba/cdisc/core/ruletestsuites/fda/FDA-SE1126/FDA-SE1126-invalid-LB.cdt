#!RuleTest
#test FDA-SE1126 expect=violation domain=LB
#note "Time point number 1 on study day 1 in category CHEMISTRY is named both '1H POST' and 'ONE HOUR POST', so --TPT is not constant for a given --TPTNUM/--DY/--CAT combination. Both records of the conflicting pair are reported."
#library standard=sendig version=3-1-1
#expectViolationCount 2
#expectViolationAt row=1 LBTPTNUM=1 LBTPT="1H POST"
#expectViolationAt row=2 LBTPTNUM=1 LBTPT="ONE HOUR POST"
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBCAT    type=Char label="Category for Lab Test"
col LBDY     type=Num  label="Study Day of Specimen Collection"
col LBTPTNUM type=Num  label="Planned Time Point Number"
col LBTPT    type=Char label="Planned Time Point Name"
---
S1 | LB | 001 | 1 | ALB | CHEMISTRY | 1 | 1 | 1H POST
S1 | LB | 002 | 1 | ALB | CHEMISTRY | 1 | 1 | ONE HOUR POST
S1 | LB | 003 | 1 | ALB | CHEMISTRY | 1 | 2 | 2H POST
