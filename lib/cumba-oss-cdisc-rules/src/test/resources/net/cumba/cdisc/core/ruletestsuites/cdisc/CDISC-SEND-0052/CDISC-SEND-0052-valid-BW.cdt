#!RuleTest
#test CDISC-SEND-0052 expect=noViolation domain=BW
#note "BOUNDARY vs SEND-0050: the define's BWTESTCD carries a CodeListRef to a sponsor codelist WITHOUT an nci:ExtCodeID alias (the same shape as SEND-0050's invalid sidecar). var_codelist(DEFINE) non-empty -> this rule is silent (SEND-0050 would fire on the same sidecar) -- pins the two rules' division of labour."
#library standard=sendig version=3-1-1
#library variable-metadata BW BWTESTCD name=BWTESTCD codelist=C90001
#library variable-metadata BW USUBJID name=USUBJID
#define-xml CDISC-SEND-0052-valid-define.xml
dataset BW
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col BWSEQ    type=Num
col BWTESTCD type=Char
---
S1 | BW | 001 | 1 | BW
