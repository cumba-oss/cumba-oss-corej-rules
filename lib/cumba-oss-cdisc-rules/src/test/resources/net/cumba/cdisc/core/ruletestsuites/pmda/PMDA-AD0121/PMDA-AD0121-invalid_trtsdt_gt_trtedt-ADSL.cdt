#!RuleTest
#test PMDA-AD0121 expect=violation domain=ADSL
#note "SAS date numbers; ADaM date variables are numeric, so type=Num is the faithful declaration. Expansion: ^(.+)SDT$ -> TRTSDT root 'TRT'; ^(.+)EDT$ -> TRTEDT root 'TRT'; ONE tuple. This is the sheet's own first example ('ADSL - TRTSDT'). ONE violation on row 1; both pins are Output_Variables and compare numerically."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 TRTSDT=22006 TRTEDT=21950
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRTSDT  type=Num
col TRTEDT  type=Num
---
CDISCPILOT01 | 01-701-1015 | 22006 | 21950
