#!RuleTest
#test PMDA-SD1379 expect=noViolation domain=TE
#note "Every TE.ETCD (SCRN, TRT) is assigned to at least one subject in SE -> no violation."
#library standard=sdtmig version=3-4
dataset TE label="Trial Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ETCD    type=Char label="Element Code"
col ELEMENT type=Char label="Description of Element"
col TESTRL  type=Char label="Rule for Start of Element"
---
CDISCPILOT01 | TE | SCRN | Screening | Informed consent
CDISCPILOT01 | TE | TRT  | Treatment | First dose
---

dataset SE label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ   type=Num  label="Sequence Number"
col ETCD    type=Char label="Element Code"
col SESTDTC type=Char label="Start Date/Time of Element"
---
CDISCPILOT01 | SE | 01-001 | 1 | SCRN | 2020-01-01
CDISCPILOT01 | SE | 01-001 | 2 | TRT  | 2020-01-08
---
