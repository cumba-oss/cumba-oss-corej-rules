#!RuleTest
#test CDISC-SEND-0114 expect=violation domain=CO
#note "CODTC is type=Char, NEVER type=Date. The DOMAIN column carries CO so unsplitNameFromData reads the scope name from it. Rows 1 and 2 share the whole key tuple and differ ONLY in COSEQ, which is deliberately OUTSIDE the key list -- including it would make every CO record unique and the rule inert. `not is_unique_set` flags the first-seen row AND the repeat, so the count is 2. Row 3 differs in IDVARVAL, COVAL and CODTC -> silent. M3-D15(iii) extended the key list with COVAL1/COVAL2; neither column is declared here, so both are dropped at runtime and the verdict is bit-for-bit what it was before."
#library standard=sendig version=3-1-1
#expectViolationCount 2
#expectViolationAt row=1 COSEQ=1
#expectViolationAt row=2 COSEQ=2
dataset CO
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col POOLID   type=Char label="Pool Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col COSEQ    type=Num  label="Sequence Number"
col COVAL    type=Char label="Comment"
col CODTC    type=Char label="Date/Time of Comment"
---
STUDY01 | CO | BW | 001 |  | BWSEQ | 1 | 1 | SEECOMMENT | 2023-01-15
STUDY01 | CO | BW | 001 |  | BWSEQ | 1 | 2 | SEECOMMENT | 2023-01-15
STUDY01 | CO | BW | 001 |  | BWSEQ | 2 | 3 | OTHERCMT   | 2023-01-16
---
