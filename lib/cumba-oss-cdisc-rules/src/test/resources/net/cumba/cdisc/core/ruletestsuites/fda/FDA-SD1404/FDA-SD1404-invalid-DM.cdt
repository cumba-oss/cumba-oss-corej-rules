#!RuleTest
#test FDA-SD1404 expect=violation domain=DM
#note "Row 2 has RFCSTDTC populated but RFCENDTC empty -> fires; rows 1 and 3 are conformant."
#library standard=sendig version=ar-1-0
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=002 RFCENDTC=
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFCSTDTC type=Char label="Date/Time of First Challenge Agent Admin"
col RFCENDTC type=Char label="Date/Time of Last Challenge Agent Admin"
---
S1 | DM | 001 | 2020-01-05 | 2020-01-19
S1 | DM | 002 | 2020-01-06 |
S1 | DM | 003 |            |
