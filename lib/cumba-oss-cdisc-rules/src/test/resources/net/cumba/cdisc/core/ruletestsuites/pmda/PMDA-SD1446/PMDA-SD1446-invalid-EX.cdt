#!RuleTest
#test PMDA-SD1446 expect=violation domain=EX
#note "ADAPTED-FROM fda/FDA-SD1446/FDA-SD1446-invalid-EX.cdt. Subject 001: EXSTDTC 2020-06-15 is after the subject's latest DS disposition start date (max DSSTDTC = 2020-05-30) -> fires. Subject 002: EXSTDTC 2020-02-01 is before its max DSSTDTC 2020-03-01 -> silent."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
---
S1 | EX | 001 | 1 | DRUG A | 2020-06-15
S1 | EX | 002 | 1 | DRUG A | 2020-02-01
---

dataset DS class=EVENTS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSTERM  type=Char label="Reported Term for the Disposition Event"
col DSDECOD type=Char label="Standardized Disposition Term"
col DSSTDTC type=Char label="Start Date/Time of Disposition"
---
S1 | DS | 001 | 1 | RANDOMIZED | RANDOMIZED | 2020-04-01
S1 | DS | 001 | 2 | COMPLETED  | COMPLETED  | 2020-05-30
S1 | DS | 002 | 1 | COMPLETED  | COMPLETED  | 2020-03-01
