#!RuleTest
#test FDA-SE2244 expect=violation domain=MI
#note "Second any-branch (--CHRON): row 1 copies MIORRES verbatim into MISTRESC while MICHRON carries the chronicity modifier -> fires. Row 2 parses the base finding out of MIORRES -> clean."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 MISTRESC="CHRONIC INFLAMMATION"
dataset MI label="Microscopic Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col MISEQ    type=Char label="Sequence Number"
col MITESTCD type=Char label="Microscopic Finding Short Name"
col MIORRES  type=Char label="Result or Finding in Original Units"
col MISTRESC type=Char label="Standardized Result in Character Format"
col MICHRON  type=Char label="Chronicity"
col MIDISTR  type=Char label="Distribution"
col MISEV    type=Char label="Severity"
---
S1 | MI | 001 | 1 | MIEXAM | CHRONIC INFLAMMATION | CHRONIC INFLAMMATION | CHRONIC | |
S1 | MI | 001 | 2 | MIEXAM | CHRONIC INFLAMMATION | INFLAMMATION         | CHRONIC | |
