#!RuleTest
#test PMDA-AD0236B expect=violation domain=ADSL
#note "Label POOLA carries both 1 and 3; 1 is the strict majority so row 3 alone fires."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 TR01AG1=POOLA TR01AG1N=3
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col TR01AG1 type=Char
col TR01AG1N type=Num
---
S1 | 001 | POOLA | 1
S1 | 002 | POOLA | 1
S1 | 003 | POOLA | 3
S1 | 004 | POOLB | 2
S1 | 005 | POOLB | 2
