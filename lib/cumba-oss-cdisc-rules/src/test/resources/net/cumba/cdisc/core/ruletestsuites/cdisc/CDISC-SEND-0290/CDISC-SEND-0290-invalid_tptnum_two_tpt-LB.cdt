#!RuleTest
#test CDISC-SEND-0290 expect=violation domain=LB
#note "The SECOND disjunct: there the KEY is --TPTNUM and the DEPENDENT is --TPT, and LBTPTNUM=1 carries two distinct names, '1 HOUR' and 'ONE HOUR' -> rows 1 and 2 fire. Pins that the OR's second arm is reachable: under the first arm alone this dataset is clean, since each --TPT here has exactly one --TPTNUM."
#library standard=sendig version=3-1-1
#expectViolationCount 2
#expectViolationAt row=1 LBTPT="1 HOUR" LBTPTNUM=1
#expectViolationAt row=2 LBTPT="ONE HOUR" LBTPTNUM=1
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBTEST   type=Char label="Lab Test or Examination Name"
col LBORRES  type=Char label="Result or Finding in Original Units"
col LBTPT    type=Char label="Planned Time Point Name"
col LBTPTNUM type=Num  label="Planned Time Point Number"
---
S1 | LB | 001 | 1 | ALB | Albumin | 41 | 1 HOUR   | 1
S1 | LB | 002 | 1 | ALB | Albumin | 39 | ONE HOUR | 1
S1 | LB | 003 | 1 | ALB | Albumin | 40 | 2 HOUR   | 2
---
