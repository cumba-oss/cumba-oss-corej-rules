#!RuleTest
#test PMDA-AD0041 expect=violation domain=ADLBC
#note "ADT ends with DT; declared format 8. matches none of the 76 SAS date formats -> one finding for the variable. No row= pin - variable-metadata rule."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt variable_name=ADT variable_format=8.
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ADT     type=Num format=8.
---
CDISCPILOT01 | 01-701-1015 | ALB | 1
