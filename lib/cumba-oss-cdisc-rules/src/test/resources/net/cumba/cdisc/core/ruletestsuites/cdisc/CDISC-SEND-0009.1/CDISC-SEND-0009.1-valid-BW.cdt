#!RuleTest
#test CDISC-SEND-0009.1 expect=noViolation domain=BW
#note "USUBJID Role=Identifier matches. BWTESTCD's ItemRef carries NO Role attribute -> var_role(DEFINE) empty -> the `not empty(var_role(DEFINE))` guard (sheet Condition 'Define-XML contains the Role attribute') keeps it silent even though the library role (Topic) is present."
#library standard=sendig version=3-1-1
#library variable-metadata BW BWTESTCD name=BWTESTCD role=Topic
#library variable-metadata BW USUBJID name=USUBJID role=Identifier
#define-xml CDISC-SEND-0009.1-valid-define.xml
dataset BW
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col BWSEQ    type=Num
col BWTESTCD type=Char
---
S1 | BW | 001 | 1 | BW
