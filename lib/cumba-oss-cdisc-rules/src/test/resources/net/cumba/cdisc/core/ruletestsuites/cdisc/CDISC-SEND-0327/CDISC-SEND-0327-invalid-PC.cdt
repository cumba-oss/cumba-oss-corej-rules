#!RuleTest
#test CDISC-SEND-0327 expect=violation domain=PC
#note "D-TA-1d (twin of FDA-SE2280, r2 W10(c) anchored regex): both PCDTC and PCRFTDTC carry a time component mid-string, the specimen was collected before its reference point, and PCELTM is PT1H instead of PT0H -> fires. Under the unanchored /T[0-9]/ the Python reference engine could never match an ISO timestamp; /.*T[0-9]/ fires on both engines."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=SUBJ-001
dataset PC label="Pharmacokinetic Concentrations"
col STUDYID type=Char label="Study Identifier"
col DOMAIN type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col PCSEQ type=Num label="Sequence Number"
col PCTESTCD type=Char label="Test Short Name"
col PCDTC type=Char label="Date/Time of Specimen Collection"
col PCRFTDTC type=Char label="Date/Time of Reference Point"
col PCELTM type=Char label="Planned Elapsed Time from Time Point Ref"
---
STUDY01 | PC | SUBJ-001 | 1 | DRUGX | 2026-03-01T08:00 | 2026-03-01T09:00 | PT1H
STUDY01 | PC | SUBJ-001 | 2 | DRUGX | 2026-03-01T10:00 | 2026-03-01T09:00 | PT1H
