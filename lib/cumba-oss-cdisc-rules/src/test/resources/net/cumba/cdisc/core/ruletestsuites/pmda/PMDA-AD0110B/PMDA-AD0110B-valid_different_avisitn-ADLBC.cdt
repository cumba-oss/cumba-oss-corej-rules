#!RuleTest
#test PMDA-AD0110B expect=noViolation domain=ADLBC
#note "The two AVISIT spellings disagree, but they carry different AVISITN values so they sit in different [PARAMCD, AVISITN] groups and neither fires. Pins that the key is the PAIR, not PARAMCD alone."
#library standard=adamig version=1-3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVISIT  type=Char
col AVISITN type=Num
---
CDISCPILOT01 | 01-701-1015 | SYSBP | WEEK2  | 2
CDISCPILOT01 | 01-701-1023 | SYSBP | WEEK02 | 3
