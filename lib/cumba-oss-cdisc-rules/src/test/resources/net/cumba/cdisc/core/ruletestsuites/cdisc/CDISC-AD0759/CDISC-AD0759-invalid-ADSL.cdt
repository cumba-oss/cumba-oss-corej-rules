#!RuleTest
#test CDISC-AD0759 expect=violation domain=ADSL
# Rule:Description: Within a given value of TRTxxA, there is more than one value of TRxxAGy, where xx is an integer [01-99, zero-padded] and y is an integer [1-99, not zero-padded]
#note "within TRT01A=Placebo, TR01AG1 takes two distinct values -> violation"
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015
#expectViolationAt row=2 USUBJID=01-701-1023
dataset ADSL class=ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRT01A type=Char
col TR01AG1 type=Char
---
CDISCPILOT01 | 01-701-1015 | Placebo | GROUP A
CDISCPILOT01 | 01-701-1023 | Placebo | GROUP B
---
