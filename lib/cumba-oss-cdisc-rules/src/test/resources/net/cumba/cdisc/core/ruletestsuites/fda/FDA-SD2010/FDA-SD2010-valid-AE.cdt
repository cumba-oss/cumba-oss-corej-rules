#!RuleTest
#test FDA-SD2010 expect=noViolation domain=AE
#note "Every populated AEHLT is a High Level Term of the (dummy) MedDRA dictionary; the sheet says Case-insensitive, so the lower-case variant passes too; the empty AEHLT on row 3 does not fire."
#library standard=sdtmig version=3-4
#dictionaries dummy
dataset AE
col USUBJID type=Char
col AEHLT   type=Char
---
001 | Headaches NEC
001 | nausea and vomiting symptoms
002 |
