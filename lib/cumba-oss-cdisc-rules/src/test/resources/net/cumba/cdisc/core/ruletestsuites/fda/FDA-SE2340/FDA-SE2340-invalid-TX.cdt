#!RuleTest
#test FDA-SE2340 expect=violation domain=TX
#note "TX branch of the rule (TXPARMCD/TXVAL): row 2 records EXPSTDTC as '15JAN2020' (SAS date9 style), which is not ISO 8601."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=2 TXPARMCD=EXPSTDTC TXVAL=15JAN2020
dataset TX label="Trial Sets"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col SETCD    type=Char label="Set Code"
col SET      type=Char label="Set Description"
col TXSEQ    type=Num  label="Sequence Number"
col TXPARMCD type=Char label="Trial Set Parameter Short Name"
col TXPARM   type=Char label="Trial Set Parameter"
col TXVAL    type=Char label="Trial Set Parameter Value"
---
SEND001 | TX | 1 | Control | 1 | EXPSTDTC | Experiment Start Date | 2020-01-15
SEND001 | TX | 2 | High    | 1 | EXPSTDTC | Experiment Start Date | 15JAN2020
