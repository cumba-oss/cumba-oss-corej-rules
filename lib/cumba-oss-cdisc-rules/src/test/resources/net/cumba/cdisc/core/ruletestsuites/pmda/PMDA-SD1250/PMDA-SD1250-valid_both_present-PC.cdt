#!RuleTest
#test PMDA-SD1250 expect=noViolation domain=PC
#note "PCTPTNUM also present -> second conjunct false -> silent with execution."
#library standard=sdtmig version=3-4
dataset PC class=FINDINGS label="Pharmacokinetic Concentrations"
col STUDYID   type=Char
col DOMAIN    type=Char
col USUBJID   type=Char
col PCSEQ     type=Num
col PCTESTCD  type=Char
col PCTPT     type=Char
col PCTPTNUM  type=Num
---
S1 | PC | 001 | 1 | DRUGA | 1H POST-DOSE | 1
---
