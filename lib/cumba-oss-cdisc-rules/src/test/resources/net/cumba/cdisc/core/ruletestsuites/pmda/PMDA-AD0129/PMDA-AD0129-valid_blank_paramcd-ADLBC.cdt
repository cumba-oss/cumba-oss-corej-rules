#!RuleTest
#test PMDA-AD0129 expect=noViolation domain=ADLBC
#note "Genuine BASE/BASEC disagreement but with a blank within-component (PARAMCD). DROP_MISSING_KEYS drops each row's group entirely, so the NORMAL -> {120,130} disagreement never forms. The authored not empty(PARAMCD) is independently false on both rows."
#library standard=adamig version=1-3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col BASE    type=Num
col BASEC   type=Char
---
CDISCPILOT01 | 01-701-1015 | | 120 | NORMAL
CDISCPILOT01 | 01-701-1015 | | 130 | NORMAL
