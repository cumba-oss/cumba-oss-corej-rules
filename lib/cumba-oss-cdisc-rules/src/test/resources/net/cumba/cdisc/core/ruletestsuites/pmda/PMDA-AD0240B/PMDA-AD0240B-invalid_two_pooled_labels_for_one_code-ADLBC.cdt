#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 TRTAG1=POOLAA TRTAG1N=1
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col TRTAG1 type=Char
col TRTAG1N type=Num
---
S1 | 001 | SYSBP | POOLA | 1
S1 | 002 | SYSBP | POOLA | 1
S1 | 003 | SYSBP | POOLAA | 1
S1 | 004 | SYSBP | POOLB | 2
