#!RuleTest
#test PMDA-SD1036 expect=skipped domain=FT
#note "FTTOX and FTTOXGR are both present (FTTOX populated, FTTOXGR empty) -> the row would fire; ONLY the Domains.Include list (no FT) rejects. FT is in FDA's sheet Domains list only (discriminator)."
#library standard=sdtmig version=3-4
dataset FT class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col FTSEQ    type=Num
col FTTESTCD type=Char
col FTTOX    type=Char
col FTTOXGR  type=Char
---
S1 | FT | 001 | 1 | ORIENT | Neurotoxicity |
