#!RuleTest
#test FDA-SD0050 expect=violation domain=AE
#note "AEENTPT is not present in the dataset while AEENRTPT is populated on row 1 -> the reference the relative end refers to is missing. Encodes the column-absent case: the Check carries a bare empty(--ENTPT) leaf, which under absent = all-missing (EC-43) is TRUE on every row of a column that is not there. Plan B phase 4d' deleted the redundant not var_exists(--ENTPT) disjunct that used to spell this out; the verdict is unchanged."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 AEENRTPT=ONGOING
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEENRTPT type=Char label="End Relative to Reference Time Point"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE | ONGOING
CDISCPILOT01 | AE | 01-701-1015 | 2 | NAUSEA   |
