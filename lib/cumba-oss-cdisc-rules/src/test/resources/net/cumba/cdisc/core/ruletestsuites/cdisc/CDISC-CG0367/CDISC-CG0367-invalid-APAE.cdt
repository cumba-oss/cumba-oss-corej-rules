#!RuleTest
#test CDISC-CG0367 expect=violation domain=APAE
#note "RSUBJID is populated, is not a POOLDEF POOLID, and matches no DM.USUBJID -> fires."
#expectViolationCount 1
#expectViolationAt row=1
dataset APAE label="Associated Persons Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col APID    type=Char label="Associated Persons Identifier"
col RSUBJID type=Char label="Related Subject or Pool Identifier"
col POOLID  type=Char label="Pool Identifier"
---
CDISCPILOT01 | APAE | AP-701-1015 | 01-701-9999 |
---

dataset DM label=Demographics
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | DM | 01-701-1015
CDISCPILOT01 | DM | 01-701-1023
