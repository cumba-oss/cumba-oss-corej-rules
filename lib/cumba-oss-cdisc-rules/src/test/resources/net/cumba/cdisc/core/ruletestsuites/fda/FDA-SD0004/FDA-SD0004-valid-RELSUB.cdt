#!RuleTest
#test FDA-SD0004 expect=skipped domain=RELSUB
#note "RELSUB (SDTMIG 3.4 Relationship class) defines no DOMAIN variable at all, so there is no DOMAIN value that could be inconsistent with the dataset name. The rule already excludes the identically shaped RELREC, so RELSUB (and RELSPEC) must not be reported either."
#library standard=sdtmig version=3-4
dataset RELSUB label="Related Subjects"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col POOLID  type=Char label="Pool Identifier"
col RSUBJID type=Char label="Related Subject or Pool Identifier"
col SREL    type=Char label="Subject Relationship"
---
S1 | 001 |  | 002 | MOTHER, BIOLOGICAL
