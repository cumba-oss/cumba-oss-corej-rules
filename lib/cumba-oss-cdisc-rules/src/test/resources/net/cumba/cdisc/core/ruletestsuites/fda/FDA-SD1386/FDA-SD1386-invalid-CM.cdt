#!RuleTest
#test FDA-SD1386 expect=violation domain=CM
#note "row1 CMCHENDY=25 is the value a wrong reference (RFSTDTC) would give, expected 6 vs RFCSTDTC; row2 CMCHENDY=0 on the reference day, expected 1 (no day 0); row3 off-by-one on the precedes branch, expected -2."
#library standard=sendig version=ar-1-0
#expectViolationCount 3
#expectViolationAt row=1 USUBJID=001 CMCHENDY=25
#expectViolationAt row=2 USUBJID=001 CMCHENDY=0
#expectViolationAt row=3 USUBJID=001 CMCHENDY=-1
dataset CM class=INTERVENTIONS
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ   type=Num  label="Sequence Number"
col CMTRT   type=Char label="Reported Name of Treatment"
col CMENDTC type=Char label="End Date/Time of Observation"
col CMCHENDY  type=Num  label="End Day of Obs Rel to Challenge Agent"
---
S1 | CM | 001 | 1 | DRUG A | 2023-06-25 | 25
S1 | CM | 001 | 2 | DRUG A | 2023-06-20 | 0
S1 | CM | 001 | 3 | DRUG A | 2023-06-18 | -1
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFSTDTC  type=Char label="Subject Reference Start Date/Time"
col RFXSTDTC type=Char label="Date/Time of First Study Treatment"
col RFCSTDTC type=Char label="Date/Time of First Challenge Agent Admin"
---
S1 | DM | 001 | 2023-06-01 | 2023-06-10 | 2023-06-20
S1 | DM | 002 | 2023-06-01 | 2023-06-10 | 2023-06   
