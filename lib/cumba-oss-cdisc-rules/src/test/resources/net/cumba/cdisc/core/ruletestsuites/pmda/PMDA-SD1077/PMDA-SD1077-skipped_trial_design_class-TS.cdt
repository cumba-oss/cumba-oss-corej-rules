#!RuleTest
#test PMDA-SD1077 expect=skipped domain=TS
#note "FRESH. No EPOCH column, so the skip is the only thing that can produce silence. TRIAL DESIGN is not in Scope.Classes.Include [INTERVENTIONS, FINDINGS, EVENTS]. class=\"TRIAL DESIGN\" is mandatory on the dataset line for the class axis to be judged at all."
#library standard=sdtmig version=3-4
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL    type=Char label="Parameter Value"
---
S1 | TS | 1 | TITLE | A Study Of Drug X
