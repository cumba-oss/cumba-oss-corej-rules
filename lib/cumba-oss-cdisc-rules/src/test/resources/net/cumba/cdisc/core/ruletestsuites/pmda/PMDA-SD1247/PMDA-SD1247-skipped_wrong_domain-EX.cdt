#!RuleTest
#test PMDA-SD1247 expect=skipped domain=EX
#note "FRESH. ONE row carries values the rule would report, on a domain it must not reach: Scope.Domains.Include is [EC] and EX is a different domain even though it is the same class."
#library standard=sdtmig version=3-4
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col ECOCCUR type=Char label="Occurrence"
col ECDOSE  type=Num  label="Dose"
---
S1 | EX | 001 | 1 | DRUG A | Y | 0
