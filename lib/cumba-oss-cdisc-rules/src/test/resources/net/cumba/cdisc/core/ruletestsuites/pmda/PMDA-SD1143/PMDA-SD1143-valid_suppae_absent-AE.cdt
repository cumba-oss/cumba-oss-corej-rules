#!RuleTest
#test PMDA-SD1143 expect=skipped domain=AE
#note "H2 (ruled 2026-08-19): the qualified Requirements.Variables entry SUPPAE.QNAM gates the rule on the supplemental dataset its anti-join reads. SUPPAE is absent from the study, so the empty key set would have reported every AESMIE='Y' record as undescribed; the gate records one auditable skip naming SUPPAE instead."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESMIE  type=Char label="Other Medically Important Serious Event"
---
S1 | AE | 001 | 1 | CHEST PAIN | Y
