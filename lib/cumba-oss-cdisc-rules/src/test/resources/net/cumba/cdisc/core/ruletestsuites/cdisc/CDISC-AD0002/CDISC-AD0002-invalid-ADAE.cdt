#!RuleTest
#test CDISC-AD0002 expect=violation domain=ADAE
# Rule:Description: A variable is present in ADaM with the same name as a variable present in SDTM but the variables do not have identical labels
#note "AESEQ present in ADAE and SDTM AE with different labels -> violation"
#expectViolationCount 1
#expectViolationAt variable_label="Sequence Number MODIFIED" variable_name=AESEQ
dataset ADAE
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number MODIFIED"
---
CDISCPILOT01 | 01-701-1015 | 1
---

dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ type=Num label="Sequence Number"
---
CDISCPILOT01 | 01-701-1015 | 1
---
