#!RuleTest
#test PMDA-SD1283 expect=skipped domain=QS
#note "QS is FINDINGS (in Classes.Include), so ONLY the Domains.Exclude [DA, DU, IE, PC, PP, QS, SC, BE, CE, DE, DS] rejects. Pins the PMDA sheet-cell exclusions the FDA twin does not have (twin discriminator: FDA-SD1283 would RUN here)."
#library standard=sdtmig version=3-4
dataset QS class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col QSSEQ    type=Num
col QSTESTCD type=Char
col QSLAT    type=Char
---
S1 | QS | 001 | 1 | QS01 | LEFT
---
