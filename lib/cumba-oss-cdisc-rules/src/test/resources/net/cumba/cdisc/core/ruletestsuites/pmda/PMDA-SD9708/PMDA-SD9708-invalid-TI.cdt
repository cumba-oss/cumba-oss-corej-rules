#!RuleTest
#test PMDA-SD9708 expect=violation domain=TI
# Rule:Description: PMDA-SD9708 — the Required key IETESTCD is not populated.
#note "IETESTCD blank -> violation; the twin scenario differs only in the value of IETESTCD."
#library standard=sdtmig version=3-4
#expectViolationCount 1
dataset TI
col STUDYID type=Char
col DOMAIN type=Char
col IETESTCD type=Char
col IETEST type=Char
col IECAT type=Char
---
S1      | TI     |          | Age 18 years or older | INCLUSION
---
