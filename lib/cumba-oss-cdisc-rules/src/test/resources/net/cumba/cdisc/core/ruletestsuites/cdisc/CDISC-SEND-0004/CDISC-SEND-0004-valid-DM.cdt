#!RuleTest
#test CDISC-SEND-0004 expect=noViolation domain=DM
#note "As invalid but AGE declared type=Num in the dataset - every define-declared variable's type agrees (integer->Num, text->Char)."
#library standard=sendig version=3-1-1
#define variable-metadata DM AGE  name=AGE  simpleDatatype=integer label="Age"
#define variable-metadata DM AGEU name=AGEU simpleDatatype=text    label="Age Unit"
#define variable-metadata DM SEX  name=SEX  simpleDatatype=text    label="Sex"
dataset DM
col STUDYID type=Char
col USUBJID type=Char
col AGE     type=Num  label="Age"
col AGEU    type=Char
col SEX     type=Char
---
S1 | S1-001 | 56 | WEEKS | M
