#!RuleTest
#test PMDA-AD0403 expect=noViolation domain=ADLBC
#note "Both subjects carry a different ATOXDSCL for the SAME parameter, which is legal: each (USUBJID, PARAMCD) group holds one distinct value. Discriminating fixture for the USUBJID half of the key -- drop USUBJID from the key and the four rows become one group with a 2-vs-2 tie and all four would fire."
#library standard=adamig version=1-3
dataset ADLBC
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVISITN  type=Num
col AVAL     type=Num
col ATOXDSCL type=Char
---
S1 | 001 | GLUC | 1 | 5.0 | GRADE1
S1 | 001 | GLUC | 2 | 5.1 | GRADE1
S1 | 002 | GLUC | 1 | 4.9 | GRADE2
S1 | 002 | GLUC | 2 | 4.8 | GRADE2
