#!RuleTest
#test PMDA-AD0234 expect=skipped domain=ADEFF
#note "ADaM-other out-of-scope pin. AD-prefixed name passes the Fix #140 gate; no BDS indicator (no PARAMCD/PARAM/AVAL/AVALC), no column ending TERM/TRT/DECOD (TRT01A ends with 'A', not 'TRT'), and no SPDEVID -> detected structure is ADAM OTHER, neither Include token and no supertype path to either. Data would fire if it ran."
#library standard=adamig version=1-3
dataset ADEFF
col STUDYID type=Char
col USUBJID type=Char
col TRT01A  type=Char
col TR01AG1 type=Char
---
S1 | 001 | DRUGA | POOLX
S1 | 002 | DRUGA | POOLX
S1 | 003 | DRUGA | POOLY
