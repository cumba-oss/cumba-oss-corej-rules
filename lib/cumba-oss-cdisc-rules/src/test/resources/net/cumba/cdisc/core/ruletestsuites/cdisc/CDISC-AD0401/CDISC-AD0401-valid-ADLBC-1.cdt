#note "ATOXDSCL populated, both AVAL and ATOXGRL populated -> noViolation"
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL type=Num
col ATOXGRL type=Char
col ATOXDSCL type=Char
---
