#!RuleTest
#test PMDA-AD0617 expect=noViolation domain=ADSL
#note "Each TRCMPG1 value maps to a single TRCMPG1N value."
#library standard=adamig version=1-3
dataset ADSL
col STUDYID   type=Char
col USUBJID   type=Char
col TRCMPG1   type=Char
col TRCMPG1N  type=Num
---
S1 | 001 | GOOD | 1
S1 | 002 | GOOD | 1
S1 | 003 | POOR | 2
---
