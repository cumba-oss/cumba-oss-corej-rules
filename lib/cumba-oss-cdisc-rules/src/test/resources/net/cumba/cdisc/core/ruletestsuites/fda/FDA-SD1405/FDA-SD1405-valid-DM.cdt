#!RuleTest
#test FDA-SD1405 expect=noViolation domain=DM
#note "Row 1 has both challenge-agent dates; row 2 has neither, so the rule does not apply -> no violation."
#library standard=sendig version=ar-1-0
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFCSTDTC type=Char label="Date/Time of First Challenge Agent Admin"
col RFCENDTC type=Char label="Date/Time of Last Challenge Agent Admin"
---
S1 | DM | 001 | 2020-01-05 | 2020-01-19
S1 | DM | 002 |            |
