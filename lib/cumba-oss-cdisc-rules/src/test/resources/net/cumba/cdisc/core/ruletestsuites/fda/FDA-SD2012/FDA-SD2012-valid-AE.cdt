#!RuleTest
#test FDA-SD2012 expect=noViolation domain=AE
#note "Every populated AEHLGT is a High Level Group Term of the (dummy) MedDRA dictionary; the sheet says Case-insensitive, so the upper-case variant passes too; the empty AEHLGT on row 3 does not fire."
#library standard=sdtmig version=3-4
#dictionaries dummy
dataset AE
col USUBJID type=Char
col AEHLGT  type=Char
---
001 | Headaches
001 | GASTROINTESTINAL SIGNS AND SYMPTOMS
002 |
