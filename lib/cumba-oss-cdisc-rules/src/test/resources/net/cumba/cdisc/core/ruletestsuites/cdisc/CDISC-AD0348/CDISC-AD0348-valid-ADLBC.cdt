#!RuleTest
#test CDISC-AD0348 expect=noViolation domain=ADLBC
# Rule:Description: Within a parameter, there is more than one value of AyLOC for a given value of AyLO
#note "each A1LO value maps to a single A1LOC value -> noViolation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col A1LOC type=Char
col A1LO type=Char
---
CDISCPILOT01 | 01-701-1015 | GLUC | A1 | G
CDISCPILOT01 | 01-701-1015 | GLUC | A2 | H
---
