#!RuleTest
#test PMDA-SD2244 expect=noViolation domain=TS
#note "Row 1: first != conjunct false -> silent. Row 2: outside the TSPARMCD gate -> silent."
#library standard=sdtmig version=3-4
dataset TS label="Trial Summary"
col STUDYID  type=Char
col DOMAIN   type=Char
col TSSEQ    type=Num
col TSPARMCD type=Char
col TSPARM   type=Char
col TSVAL    type=Char
col TSVALCD  type=Char
col TSVCDREF type=Char
---
S1 | TS | 1 | FCNTRY   | Planned Country of Investigational Sites | USA | USA | GENC
S1 | TS | 2 | SPLNCTRY | Planned Country of Investigational Sites | USA | USA | ISO 639
