#!RuleTest
#test PMDA-AD0228B expect=noViolation domain=ADSL
#note "Row 3's TRTSEQP (the grouping key) is blank, so DROP_MISSING_KEYS removes it before the consistency pass; the A-B group holds one distinct TRTSEQPN. The row's own not empty(TRTSEQP) conjunct is false too."
#library standard=adamig version=1-3
dataset ADSL class=ADSL
col STUDYID  type=Char
col USUBJID  type=Char
col TRTSEQP  type=Char
col TRTSEQPN type=Num
---
S1 | 001 | A-B | 1
S1 | 002 | A-B | 1
S1 | 003 |     | 2
