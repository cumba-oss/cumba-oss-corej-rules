#!RuleTest
#test CDISC-CG0001 expect=skipped domain=LB
#note "Full #library block present, but no Define-XML channel at all -> the Check's DEFINE-level accessors make the rule SKIP."
#library standard=sdtmig version=3-4
#library codelist-terms DOMAIN C11111 C22222
dataset LB class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
---
S1 | LB | 001 | 1 | GLUC
