#!RuleTest
#test PMDA-SD1085 expect=noViolation domain=LB
#note "Row 1: LBDY populated with both LBDTC and DM.RFSTDTC complete -> the day value is derivable, no finding. Row 2 leaves LBDY empty, which the not-empty conjunct skips even though its LBDTC is partial."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col LBSEQ type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBDTC type=Char label="Date/Time of Specimen Collection"
col LBDY  type=Num  label="Study Day of Specimen Collection"
---
S1 | LB | 001 | 1 | ALB | 2023-06-25 | 5
S1 | LB | 002 | 1 | ALB | 2023-06     | .
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
---
S1 | DM | 001 | 2023-06-01
S1 | DM | 002 | 2023-06-01
