#!RuleTest
#test FDA-SD1036 expect=noViolation domain=LB
#note "Every record with a toxicity description (LBTOX) also carries the toxicity grade (LBTOXGR); row 3 has neither."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBTOX    type=Char label="Toxicity"
col LBTOXGR  type=Char label="Standard Toxicity Grade"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALT  | Hepatotoxicity | 2
CDISCPILOT01 | LB | 01-701-1015 | 2 | CREAT| Nephrotoxicity | 1
CDISCPILOT01 | LB | 01-701-1023 | 1 | ALT  |                |
