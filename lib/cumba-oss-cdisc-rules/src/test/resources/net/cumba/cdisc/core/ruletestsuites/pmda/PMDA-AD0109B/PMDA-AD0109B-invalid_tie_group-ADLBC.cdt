#!RuleTest
#test PMDA-AD0109B expect=violation domain=ADLBC
#note "Group (GLUC, WEEK2) holds AVISITN {2, 3} with NO strict majority, so EVERY non-blank row of the group fires - one of only two tie fixtures in this batch (the other is PMDA-AD0149-invalid_tie_group)."
#library standard=adamig version=1-3
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015 PARAMCD=GLUC AVISIT=WEEK2 AVISITN=2
#expectViolationAt row=2 USUBJID=01-701-1023 PARAMCD=GLUC AVISIT=WEEK2 AVISITN=3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVISIT  type=Char
col AVISITN type=Num
---
CDISCPILOT01 | 01-701-1015 | GLUC | WEEK2 | 2
CDISCPILOT01 | 01-701-1023 | GLUC | WEEK2 | 3
