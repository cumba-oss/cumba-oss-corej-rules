#!RuleTest
#test CDISC-CG0265 expect=violation domain=TS
#note "Reverse direction: TSVALCD 'C49636' carries two TSVAL spellings ('BOTH' vs 'Both'). The sheet demands a one-to-one relationship, which is bidirectional, so this direction must fire too; fires on both C49636 rows."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 TSVALCD=C49636
#expectViolationAt row=3 TSVALCD=C49636
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
col TSVALCD  type=Char label="Parameter Value Code"
---
S1 | TS | 1 | SEXPOP  | Sex of Participants | BOTH | C49636
S1 | TS | 1 | INTTYPE | Intervention Type   | DRUG | C1909
S1 | TS | 2 | SEXPOP  | Sex of Participants | Both | C49636
