#!RuleTest
#test PMDA-AD0129 expect=noViolation domain=ADLBC
#note "D.13 blank-KEY exclusion: the row whose key (BASEC) is blank is excluded from both the collect fold and the fire pass, so NORMAL carries the single dependent {120} and nothing fires. The authored not empty(BASEC) reaches the same verdict independently."
#library standard=adamig version=1-3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col BASE    type=Num
col BASEC   type=Char
---
CDISCPILOT01 | 01-701-1015 | SYSBP | 120 | NORMAL
CDISCPILOT01 | 01-701-1015 | SYSBP | 130 |
