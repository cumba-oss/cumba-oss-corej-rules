#!RuleTest
#test PMDA-SD1091 expect=noViolation domain=AE
#note "The DIRECTION discriminator: the rule conditions on AEENDTC being present, so AEENDY-without-AEENDTC must NOT fire (first conjunct false)."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col AESEQ   type=Num
col AEENDY  type=Num
---
S1 | AE | 001 | 1 | 20
