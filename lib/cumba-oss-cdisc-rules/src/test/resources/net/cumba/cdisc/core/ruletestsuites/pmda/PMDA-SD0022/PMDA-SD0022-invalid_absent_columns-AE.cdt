#!RuleTest
#test PMDA-SD0022 expect=violation domain=AE
#note "An absent Start Time-Point variable counts as not populated: the AE dataset carries only AESTDTC (no AESTRF/AESTRTPT/AEOCCUR/AESTAT columns). Row 1 leaves AESTDTC empty -> fires; row 2 carries a start date -> conformant."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 AETERM=Headache
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESTDTC type=Char label="Start Date/Time of Adverse Event"
---
S1 | AE | 001 | 1 | Headache |
S1 | AE | 001 | 2 | Nausea   | 2023-06-01
