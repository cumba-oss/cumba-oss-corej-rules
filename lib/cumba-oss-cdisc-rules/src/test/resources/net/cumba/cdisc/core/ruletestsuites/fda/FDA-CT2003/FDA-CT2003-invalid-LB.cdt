#!RuleTest
#test FDA-CT2003 expect=violation domain=LB
#note "LBTESTCD and LBTEST are a code/decode pair: paired CDISC-CT terms share a Codelist Code (concept id). Row 1 submits ALB/Albumin - the same concept id, so no finding. Row 2 submits ALB (C64431) against the decode Bilirubin (C64433) - different concepts, so the pair is broken and the rule fires. It fires TWICE on that row because the accessor is evaluated per variable and the pairing resolves in both directions: from LBTESTCD by stripping the CD suffix, and from LBTEST by the unique-matching-codelist fallback (ExprCompiler.resolvePartner)."
#library standard=sdtmig version=3-4
#library codelist-codes LB LBTESTCD ALB=C64431 BILI=C64433
#library codelist-codes LB LBTEST Albumin=C64431 Bilirubin=C64433
#expectViolationCount 2
#expectViolationAt row=2 variable_name=LBTEST variable_value=Bilirubin
#expectViolationAt row=2 variable_name=LBTESTCD variable_value=ALB
dataset LB label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBTEST   type=Char label="Lab Test or Examination Name"
---
S1 | LB | 001 | ALB | Albumin
S1 | LB | 002 | ALB | Bilirubin
