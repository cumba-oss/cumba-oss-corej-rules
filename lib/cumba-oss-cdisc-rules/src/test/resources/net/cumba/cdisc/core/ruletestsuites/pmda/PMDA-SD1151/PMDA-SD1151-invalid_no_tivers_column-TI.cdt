#!RuleTest
#test PMDA-SD1151 expect=violation domain=TI
#note "The absent key is dropped and the check regroups on IETEST alone, so the rule fires exactly as the FDA twin does. TIVERS is absent, so it is not pinned."
#expectViolationCount 2
#expectViolationAt row=1 IETESTCD=INCL01 IETEST="Age 18 years or older"
#expectViolationAt row=2 IETESTCD=INCL02 IETEST="Age 18 years or older"
#library standard=sdtmig version=3-4
dataset TI
col STUDYID  type=Char
col DOMAIN   type=Char
col IETESTCD type=Char
col IETEST   type=Char
---
S1 | TI | INCL01 | Age 18 years or older
S1 | TI | INCL02 | Age 18 years or older
