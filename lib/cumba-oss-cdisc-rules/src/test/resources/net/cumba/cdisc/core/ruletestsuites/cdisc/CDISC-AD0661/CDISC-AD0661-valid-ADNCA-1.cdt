#!RuleTest
#test CDISC-AD0661 expect=noViolation domain=ADNCA
# Rule:Description: Raise an error when ADOSEDUR is present but NDOSEDUR or DOSEDURU is not present in an ADNCA v1.0 dataset.
#note "ADOSEDUR present and both NDOSEDUR and DOSEDURU present -> noViolation"
dataset ADNCA
col STUDYID type=Char
col USUBJID type=Char
col ADOSEDUR type=Num
col NDOSEDUR type=Num
col DOSEDURU type=Char
col PARAMCD type=Char
col NFRLT type=Num
col AFRLT type=Num
---
CDISCPILOT01 | 01-701-1015 | 24 | 24 | HOURS | CONC | 0 | 0.5
---
