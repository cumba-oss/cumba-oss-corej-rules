#!RuleTest
#test PMDA-AD0584 expect=violation domain=ADLBC
#note "INDEX 1 ONLY: BCHGCAT1 matches ^BCHGCAT(\d+)$ and BCHGCA1N matches ^BCHGCA(\d+)N$, both capturing y=1 -> one expansion. Key tuple (PARAMCD, BCHGCA1N)=(GLUC, 1); target BCHGCAT1 holds {INCREASE, INCREASE, DECREASE} -> minority row 3 fires."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=01-701-1034 PARAMCD=GLUC BCHGCAT1=DECREASE BCHGCA1N=1
dataset ADLBC
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col BCHGCAT1 type=Char
col BCHGCA1N type=Num
---
CDISCPILOT01 | 01-701-1015 | GLUC | INCREASE | 1
CDISCPILOT01 | 01-701-1023 | GLUC | INCREASE | 1
CDISCPILOT01 | 01-701-1034 | GLUC | DECREASE | 1
