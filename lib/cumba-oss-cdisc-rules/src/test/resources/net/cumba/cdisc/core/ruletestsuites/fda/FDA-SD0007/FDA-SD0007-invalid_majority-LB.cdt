#!RuleTest
#test FDA-SD0007 expect=violation domain=LB
#note "The GLUC group holds two standard units (mmol/L twice, mg/dL once), so it is NOT unit-consistent and the rule must report the group once. Unlike the 2-row tie case the deviating record is not the group's first row. (Sensitivity Record since 2026-07-28: every minority row reports; formerly red under Group representative-row collection.)"
#library standard=sdtmig version=3-4
#expectViolationCount 1
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBCAT    type=Char label="Category for Lab Test"
col LBSCAT   type=Char label="Subcategory for Lab Test"
col LBSPEC   type=Char label="Specimen Type"
col LBMETHOD type=Char label="Method of Test or Examination"
col LBSTRESU type=Char label="Standard Units"
---
S1 | LB | 001 | 1 | GLUC | CHEMISTRY | GLUCOSE | SERUM | ENZYMATIC | mmol/L
S1 | LB | 002 | 1 | GLUC | CHEMISTRY | GLUCOSE | SERUM | ENZYMATIC | mmol/L
S1 | LB | 003 | 1 | GLUC | CHEMISTRY | GLUCOSE | SERUM | ENZYMATIC | mg/dL
