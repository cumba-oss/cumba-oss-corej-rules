#!RuleTest
#test PMDA-SD0049 expect=skipped domain=DM
#note "Synthetic sponsor columns DMSTRTPT (populated BEFORE) / DMSTTPT (empty) satisfy the Requirements.Variables [--STRTPT] gate and would fire; ONLY the Domains.Exclude [CO, DM] rejects (DM is a member of the included SPECIAL PURPOSE class). Pinned on behalf of SD0050's identical block. Discriminator: FDA-SD0049 (Domains [ALL]) would execute here."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE"
col STUDYID   type=Char
col DOMAIN    type=Char
col USUBJID   type=Char
col DMSTRTPT  type=Char
col DMSTTPT   type=Char
---
S1 | DM | 001 | BEFORE |
