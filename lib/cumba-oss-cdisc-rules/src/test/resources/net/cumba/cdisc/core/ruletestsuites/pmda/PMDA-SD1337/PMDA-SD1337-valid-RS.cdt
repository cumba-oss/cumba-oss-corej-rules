#!RuleTest
#test PMDA-SD1337 expect=noViolation domain=RS
#note "Every populated RSLNKID is present as a TRLNKID in TR for the same subject; the boundary row 3 leaves RSLNKID empty and must not fire."
#library standard=sdtmig version=3-4
dataset RS label="Disease Response"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RSSEQ    type=Num  label="Sequence Number"
col RSLNKID  type=Char label="Link ID"
col RSTESTCD type=Char label="Response Assessment Short Name"
col RSORRES  type=Char label="Result or Finding in Original Units"
---
CDISCPILOT01 | RS | 001 | 1 | T01 | LSTASS | PR
CDISCPILOT01 | RS | 002 | 1 | T05 | LSTASS | CR
CDISCPILOT01 | RS | 002 | 2 |  | OVRLRESP | PD
---

dataset TR label="Tumor Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col TRSEQ    type=Num  label="Sequence Number"
col TRLNKID  type=Char label="Link ID"
col TRTESTCD type=Char label="Tumor Assessment Short Name"
col TRORRES  type=Char label="Result or Finding in Original Units"
---
CDISCPILOT01 | TR | 001 | 1 | T01 | LDIAM | 20
CDISCPILOT01 | TR | 002 | 1 | T05 | LDIAM | 12
---
