#!RuleTest
#test CDISC-CG0379 expect=violation domain=AE
#note "CL-G.4 (wave TA-4): explicit case_sensitive: false, restoring the pre-TA-3 insensitive behaviour family-wide. Row 2's AEDECOD 'Cranial pain' is not a MedDRA Preferred Term of the (dummy) dictionary -> fires. Row 3's empty AEDECOD is excluded by the not empty guard."
#library standard=sdtmig version=3-4
#dictionaries dummy
#expectViolationCount 1
#expectViolationAt row=2 AEDECOD="Cranial pain"
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEDECOD type=Char label="Dictionary-Derived Term"
---
S1 | AE | 001 | 1 | headache | Headache
S1 | AE | 001 | 2 | head hurts | Cranial pain
S1 | AE | 001 | 3 | uncoded |
