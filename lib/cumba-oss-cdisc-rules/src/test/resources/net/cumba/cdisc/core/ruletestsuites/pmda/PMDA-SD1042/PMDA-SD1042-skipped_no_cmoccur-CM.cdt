#!RuleTest
#test PMDA-SD1042 expect=skipped domain=CM
#note "FRESH. CM without the CMOCCUR column. Requirements.Variables.All [--OCCUR] names the absent variable -> SKIPPED. The shipped machine guard var_exists(\"--OCCUR\") would silence execution anyway - the pin is the auditable skip (R-4.11), not a behavior change."
#library standard=sdtmig version=3-4
dataset CM class=INTERVENTIONS label="Concomitant Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ   type=Num  label="Sequence Number"
col CMTRT   type=Char label="Reported Name of Drug, Med, or Therapy"
col CMSTRF  type=Char label="Start Relative to Reference Period"
col CMENRF  type=Char label="End Relative to Reference Period"
---
S1 | CM | 001 | 1 | ASPIRIN | BEFORE |
