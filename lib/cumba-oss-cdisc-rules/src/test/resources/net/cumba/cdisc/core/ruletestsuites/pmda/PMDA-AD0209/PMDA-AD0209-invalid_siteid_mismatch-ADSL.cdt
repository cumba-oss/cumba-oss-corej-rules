#!RuleTest
#test PMDA-AD0209 expect=violation domain=ADSL
#note "Row 1: SITEID 999 != DM.SITEID 701 -> fires. Row 2: equal -> silent. Join DM on Keys=[USUBJID], loader-default inner, 1:1."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 SITEID=999 DM.SITEID=701
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col SITEID  type=Char
---
S1 | 01-701-1015 | 999
S1 | 01-701-1023 | 701
---

dataset DM label=Demographics
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col SITEID  type=Char
---
S1 | DM | 01-701-1015 | 701
S1 | DM | 01-701-1023 | 701
