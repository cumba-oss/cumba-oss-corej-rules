#!RuleTest
#test PMDA-SD1356 expect=noViolation domain=CE
#note "Boundary: the study has no TM dataset, but RELMIDS is not used in CE either -> the RELMIDS presence gate is false -> no violation."
#library standard=sdtmig version=3-4
dataset CE class=EVENTS label="Clinical Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CESEQ   type=Num  label="Sequence Number"
col CETERM  type=Char label="Reported Term for the Clinical Event"
---
S1 | CE | 001 | 1 | HYPOGLYCEMIC EVENT
