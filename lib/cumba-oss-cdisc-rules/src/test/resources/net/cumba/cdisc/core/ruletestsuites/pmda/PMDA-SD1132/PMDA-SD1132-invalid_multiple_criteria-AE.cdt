#!RuleTest
#test PMDA-SD1132 expect=violation domain=AE
#note "FRESH. Row 1: FOUR criteria equal 'Y' (AESDISAB, AESDTH, AESHOSP, AESLIFE) on ONE record with AESER=N. Row 2: ONE criterion (AESMIE) with AESER=N. Row 3: silent. Predicted count 2, NOT 5: the seven criterion tests are an OR-folded disjunction evaluated once per record, so a record with four criteria set yields ONE finding, not four. No twin covers a multi-criterion record, and the count is the whole point of the fixture."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 AESER=N
#expectViolationAt row=2 AESER=N
dataset AE class=EVENTS label="Adverse Events"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col AESEQ    type=Num  label="Sequence Number"
col AETERM   type=Char label="Reported Term for the Adverse Event"
col AESER    type=Char label="Serious Event"
col AESCAN   type=Char label="Involves Cancer"
col AESCONG  type=Char label="Congenital Anomaly or Birth Defect"
col AESDISAB type=Char label="Persist or Signif Disability/Incapacity"
col AESDTH   type=Char label="Results in Death"
col AESHOSP  type=Char label="Requires or Prolongs Hospitalization"
col AESLIFE  type=Char label="Is Life Threatening"
col AESMIE   type=Char label="Other Medically Important Serious Event"
---
S1 | AE | 001 | 1 | SEPSIS | N | N | N | Y | Y | Y | Y | N
S1 | AE | 001 | 2 | RASH   | N | N | N | N | N | N | N | Y
S1 | AE | 001 | 3 | NAUSEA | N | N | N | N | N | N | N | N
