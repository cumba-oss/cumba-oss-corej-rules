#!RuleTest
#test FDA-SD0023 expect=skipped domain=SM
#note "CL-A A.1 (wave TA-4): the Domains.Exclude list became the sheet's four-class Classes.Include block. A sponsor-defined Special-Purpose dataset carrying the two gated columns sat outside every excluded domain and was checked under the old shape; under the sheet's class scope it is skipped."
#library standard=sdtmig version=3-4
dataset SM class="SPECIAL PURPOSE" label="Subject Milestones"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SMSTAT   type=Char label="Completion Status"
col SMREASND type=Char label="Reason Not Done"
---
S1 | SM | 001 |  | SUBJECT UNAVAILABLE
