#!RuleTest
#test CDISC-SEND-0100 expect=violation domain=DM
#note "Define declares STUDYID and USUBJID but NOT RFSTDTC -> RFSTDTC has no definition in the Define-XML -> 1 violation."
#library standard=sendig version=3-1-1
#define variable-metadata DM STUDYID name=STUDYID label="Study Identifier"
#define variable-metadata DM USUBJID name=USUBJID label="Unique Subject Identifier"
#expectViolationCount 1
#expectViolationAt variable_name=RFSTDTC
dataset DM
col STUDYID type=Char
col USUBJID type=Char
col RFSTDTC type=Char
---
S1 | S1-001 | 2020-01-01
