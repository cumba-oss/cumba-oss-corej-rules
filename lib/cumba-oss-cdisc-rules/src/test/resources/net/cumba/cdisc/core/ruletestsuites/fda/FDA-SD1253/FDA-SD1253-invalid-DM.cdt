#!RuleTest
#test FDA-SD1253 expect=violation domain=DM
#note "Subjects 001 (DTHFL empty) and 002 (DTHFL 'N') both have a DD record, so both fire. Subject 003 has a DD record and DTHFL 'Y' (conformant); subject 004 has no DD record so its empty DTHFL is irrelevant."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=001
#expectViolationAt row=2 USUBJID=002 DTHFL=N
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col SITEID  type=Char label="Study Site Identifier"
col SEX     type=Char label="Sex"
col DTHDTC  type=Char label="Date/Time of Death"
col DTHFL   type=Char label="Subject Death Flag"
---
CDISCPILOT01 | DM | 001 | 001 | 70 | M | 2020-03-01 |
CDISCPILOT01 | DM | 002 | 002 | 70 | F | 2020-04-01 | N
CDISCPILOT01 | DM | 003 | 003 | 71 | M | 2020-05-01 | Y
CDISCPILOT01 | DM | 004 | 004 | 71 | F |  |
---

dataset DD label="Death Details"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col DDSEQ    type=Num  label="Sequence Number"
col DDTESTCD type=Char label="Death Diagnosis Short Name"
col DDTEST   type=Char label="Death Diagnosis"
col DDORRES  type=Char label="Result or Finding in Original Units"
---
CDISCPILOT01 | DD | 001 | 1 | PRCDTH | Primary Cause of Death | MYOCARDIAL INFARCTION
CDISCPILOT01 | DD | 002 | 1 | PRCDTH | Primary Cause of Death | SEPSIS
CDISCPILOT01 | DD | 003 | 1 | PRCDTH | Primary Cause of Death | STROKE
---
