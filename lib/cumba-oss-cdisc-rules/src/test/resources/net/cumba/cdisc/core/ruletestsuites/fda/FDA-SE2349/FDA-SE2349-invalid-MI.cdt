#!RuleTest
#test FDA-SE2349 expect=violation domain=MI
#note "Row 1 spells the relationship out ('YES') instead of the allowed 'Y' -> fires; row 2 is the conformant twin. The membership test is case-sensitive on the CT submission values."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 MIDTHREL=YES
dataset MI label="Microscopic Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col MISEQ    type=Num  label="Sequence Number"
col MITESTCD type=Char label="Microscopic Examination Short Name"
col MISTRESC type=Char label="Standardized Result in Standard Format"
col MIDTHREL type=Char label="Relationship to Death"
col MISPEC   type=Char label="Specimen Material Type"
---
STUDY01 | MI | STUDY01-001 | 1 | MIEXAM | NECROSIS | YES | LIVER
STUDY01 | MI | STUDY01-001 | 2 | MIEXAM | NECROSIS | Y   | KIDNEY
