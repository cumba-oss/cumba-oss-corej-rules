#!RuleTest
#test PMDA-SD2242 expect=violation domain=TS
#note "Row 2 is the TRT record and carries TSVCDREF='CAS' instead of the required 'UNII' -> fires. Row 1 carries the same wrong reference but under a different TSPARMCD, so this rule must leave it alone (pins the TSPARMCD gate). Adapted verbatim from FDA-SD2242 (byte-identical Check/Scope)."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 TSPARMCD=TRT TSVCDREF=CAS
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
col TSVALCD  type=Char label="Parameter Value Code"
col TSVCDREF type=Char label="Parameter Value Code Reference"
---
S1 | TS | 1 | CURTRT | Current Treatment | ASPIRIN | R16CO5Y76E | CAS
S1 | TS | 2 | TRT | Investigational Therapy or Treatment | ASPIRIN | R16CO5Y76E | CAS
