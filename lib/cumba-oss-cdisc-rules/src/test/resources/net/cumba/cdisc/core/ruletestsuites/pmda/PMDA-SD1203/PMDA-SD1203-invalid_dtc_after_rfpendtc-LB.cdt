#!RuleTest
#test PMDA-SD1203 expect=violation domain=LB
#note "Row 1: LBDTC 2020-07-02 after RFPENDTC 2020-06-30 -> fires. Row 2: LBDTC before -> clean."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 LBSEQ=1
dataset LB class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
col LBDTC    type=Char
---
S1 | LB | 001 | 1 | GLUC | 2020-07-02
S1 | LB | 001 | 2 | ALB  | 2020-05-01
---

dataset DM class="SPECIAL PURPOSE"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col RFPENDTC type=Char
---
S1 | DM | 001 | 2020-06-30
