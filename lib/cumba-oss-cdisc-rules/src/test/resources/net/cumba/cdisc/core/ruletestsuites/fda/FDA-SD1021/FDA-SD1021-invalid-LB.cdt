#!RuleTest
#test FDA-SD1021 expect=violation domain=LB
#note "Row 1 LBTESTCD has a leading space; row 2 LBORRES is a single '.' — both are the unexpected character values the rule targets. (Both cells are quoted: the .cdt loader reads a bare leading space as trimmed and a bare '.' as the SAS missing sentinel.)"
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 variable_name=LBTESTCD
#expectViolationAt row=2 variable_name=LBORRES
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBORRES  type=Char label="Result or Finding in Original Units"
---
CDISCPILOT01 | LB | 01-701-1015 | " ALB" | 40
CDISCPILOT01 | LB | 01-701-1015 | GLUC   | "."
