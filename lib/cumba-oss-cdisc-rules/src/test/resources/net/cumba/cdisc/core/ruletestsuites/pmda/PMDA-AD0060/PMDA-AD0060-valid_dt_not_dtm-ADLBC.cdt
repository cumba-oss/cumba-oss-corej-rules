#!RuleTest
#test PMDA-AD0060 expect=noViolation domain=ADLBC
#note "The mirror half of the AD0058/AD0060 discriminator: a CHARACTER *DT variable is PMDA-AD0058's finding, and 'ADT' does not end in 'DTM', so AD0060 must stay silent."
#library standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ADT     type=Char
---
CDISCPILOT01 | 01-701-1015 | ALB | x
