#!RuleTest
#test PMDA-SD1307 expect=noViolation domain=TS
#note "Boundary (documents the record-level reading): HLTSUBJI=N but the TDIGRP parameter record is absent altogether. The rule is anchored on TDIGRP records, so an entirely missing parameter is left to the TS-parameter-presence rules and this rule does not fire."
#library standard=sdtmig version=3-4
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S1 | TS | 1 | HLTSUBJI | Healthy Subject Indicator | N
