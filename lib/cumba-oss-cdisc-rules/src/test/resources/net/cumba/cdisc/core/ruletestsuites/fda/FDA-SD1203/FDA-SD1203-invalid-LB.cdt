#!RuleTest
#test FDA-SD1203 expect=violation domain=LB
#note "Row 1: LBDTC after RFPENDTC -> fires. Row 2: LBDTC equal to RFPENDTC -> clean (rule is strictly after)."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 LBSEQ=1
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBDTC    type=Char label="Date/Time of Specimen Collection"
---
S1 | LB | 001 | 1 | ALB | 2020-07-01
S1 | LB | 001 | 2 | ALT | 2020-06-30
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFPENDTC type=Char label="Date/Time of End of Participation"
---
S1 | DM | 001 | 2020-06-30
---
