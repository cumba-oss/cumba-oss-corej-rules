#!RuleTest
#test PMDA-SD1004 expect=violation domain=TV
#note "FRESH. Covers the THIRD in-scope domain: Scope.Domains.Include is [DM, TA, TV] and the twin reaches only DM and TA. Row 1 is the 20-character boundary, silent; row 2 is 21 characters and fires."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 ARMCD=PLACEBO-RUN-IN-ARM-AB
dataset TV label="Trial Visits"
col STUDYID type=Char
col DOMAIN  type=Char
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col ARMCD    type=Char label="Planned Arm Code"
col ARM      type=Char label="Description of Planned Arm"
col TVSTRL   type=Char label="Visit Start Rule"
---
S1 | TV | 1 | Screening | PLACEBO-RUN-IN-ARM-A | Placebo run-in arm A | Start of screening
S1 | TV | 2 | Week 1    | PLACEBO-RUN-IN-ARM-AB | Placebo run-in arm AB | Start of week 1
