#!RuleTest
#test FDA-SE1158 expect=violation domain=CM
#note "Row 2 flags restraint (CMRSTIND='Y') but leaves the restraint mode empty -> fires. Row 1 is the conformant counterpart."
#library standard=sendig version=ar-1-0
#expectViolationCount 1
#expectViolationAt row=2 CMRSTIND=Y
dataset CM class=INTERVENTIONS label="Concomitant/Prior Medications"
col STUDYID  type=Char label="Study Identifier"
col USUBJID  type=Char label="Unique Subject Identifier"
col CMSEQ    type=Num  label="Sequence Number"
col CMTRT    type=Char label="Reported Name of Drug, Med, or Therapy"
col CMRSTIND type=Char label="Restraint Indicator"
col CMRSTMOD type=Char label="Restraint Mode"
---
S1 | 001 | 1 | KETAMINE | Y | SLING
S1 | 001 | 2 | SALINE   | Y |
