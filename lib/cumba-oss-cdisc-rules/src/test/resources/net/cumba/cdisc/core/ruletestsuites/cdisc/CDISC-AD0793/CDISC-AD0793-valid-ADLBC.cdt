#!RuleTest
#test CDISC-AD0793 expect=noViolation domain=ADLBC
# Rule:Description: On a given record, a variable with a suffix of STM has a value greater than a value of a variable with the same root and a suffix of ETM, and both variables are populated
#note "ASTM=50 not greater than AETM=100 -> noViolation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ASTM type=Num
col AETM type=Num
---
CDISCPILOT01 | 01-701-1015 | GLUC | 50 | 100
---
