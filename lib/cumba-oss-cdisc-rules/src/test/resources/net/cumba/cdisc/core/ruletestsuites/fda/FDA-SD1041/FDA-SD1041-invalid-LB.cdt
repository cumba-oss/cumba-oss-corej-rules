#!RuleTest
#test FDA-SD1041 expect=violation domain=LB
#note "Row 1 repeats the category value in the subcategory (LBCAT=LBSCAT='CHEMISTRY') -> fires. Row 2 has a genuine subdivision; row 3 has an empty LBSCAT."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 LBCAT=CHEMISTRY LBSCAT=CHEMISTRY
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBCAT    type=Char label="Category for Lab Test"
col LBSCAT   type=Char label="Subcategory for Lab Test"
---
S1 | LB | 001 | 1 | ALB  | CHEMISTRY  | CHEMISTRY
S1 | LB | 001 | 2 | GLUC | CHEMISTRY  | METABOLIC
S1 | LB | 001 | 3 | HGB  | HEMATOLOGY |
