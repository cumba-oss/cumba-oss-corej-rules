#!RuleTest
#test PMDA-SD0079 expect=violation domain=EX
#note "EX has no EPOCH column at all; the AUTHORED 'not var_exists(\"EPOCH\")' or-arm makes the run-in exemption inapplicable -> subject 002 (NOTASSGN) fires. Do not add an EPOCH column and do not simplify."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=002
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
---
S1 | EX | 002 | 1 | DRUG A
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
---
S1 | DM | 002 | NOTASSGN | Not Assigned
---
