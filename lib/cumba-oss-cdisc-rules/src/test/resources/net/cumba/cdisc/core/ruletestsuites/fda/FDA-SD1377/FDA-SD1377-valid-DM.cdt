#!RuleTest
#test FDA-SD1377 expect=noViolation domain=DM
#note "The SCREEN FAILURE subject 01-001 has an IE record; 01-002 (ARMNRS='NOT ASSIGNED') and 01-003 (ARMNRS empty) are outside the rule's condition even though they have no IE record -> no violation."
#library standard=sdtmig version=3-4
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARMCD    type=Char label="Planned Arm Code"
col ARMNRS   type=Char label="Reason Arm and/or Actual Arm is Null"
---
CDISCPILOT01 | DM | 01-001 |       | SCREEN FAILURE
CDISCPILOT01 | DM | 01-002 |       | NOT ASSIGNED
CDISCPILOT01 | DM | 01-003 | PBO   |
---

dataset IE label="Inclusion/Exclusion Criteria Not Met"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IESEQ    type=Num  label="Sequence Number"
col IETESTCD type=Char label="Inclusion/Exclusion Criterion Short Name"
col IECAT    type=Char label="Inclusion/Exclusion Category"
---
CDISCPILOT01 | IE | 01-001 | 1 | INCL01 | INCLUSION
---
