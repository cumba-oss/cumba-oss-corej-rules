#!RuleTest
#test PMDA-SD0050 expect=violation domain=AE
#note "No AEENTPT column at all; the bare empty(--ENTPT) leaf decides, TRUE on every row of the absent column (absent = all-missing, EC-43). Row 1: AEENRTPT=ONGOING -> fires. Row 2: AEENRTPT empty -> clean."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 AEENRTPT=ONGOING
dataset AE class=EVENTS
col STUDYID   type=Char
col DOMAIN    type=Char
col USUBJID   type=Char
col AESEQ     type=Num
col AETERM    type=Char
col AEENRTPT  type=Char
---
S1 | AE | 001 | 1 | HEADACHE | ONGOING
S1 | AE | 001 | 2 | NAUSEA   |
