#!RuleTest
#test CDISC-SEND-0049 expect=violation domain=DM
#note "O-8 (Fix #339): demographics are not on the semicolon allow-list. SEX = F;M joins two lawful SEX terms and reports; SPECIES = RAT is a single lawful term and is silent. Before the allow-list (Fix #329) the F;M cell was silent on all six SEND packages. Sheet issue #152."
#library standard=sendig version=3-1-1
#library variable-metadata DM SEX codelist=SEX codelist_extensible=false codelist_coded_values="[\"M\",\"F\",\"U\"]"
#library variable-metadata DM SPECIES codelist=SPECIES codelist_extensible=true codelist_coded_values="[\"RAT\",\"MOUSE\"]"
#expectViolationCount 1
#expectViolationAt variable_name=SEX variable_value=F;M
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SEX     type=Char label="Sex"
col SPECIES type=Char label="Species"
---
S1 | DM | 001 | F;M | RAT
