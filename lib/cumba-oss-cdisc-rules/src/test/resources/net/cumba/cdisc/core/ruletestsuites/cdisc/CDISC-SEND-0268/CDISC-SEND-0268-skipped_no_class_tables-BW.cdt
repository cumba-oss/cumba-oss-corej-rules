#!RuleTest
#test CDISC-SEND-0268 expect=skipped domain=BW
#note "model-column-order and column-order are declared but NO model-class-variables, so the four class-selecting operations resolve nothing and D-6 makes the rule SKIP. BWCUSTOM is present and would fire if the rule ran, so a silent noViolation here would be the vacuous shape, not a pass."
#library standard=sendig version=3-0
#library model-column-order      BW STUDYID DOMAIN USUBJID POOLID BWSEQ BWGRPID BWTESTCD BWTEST BWORRES BWORRESU BWSTRESC BWSTRESN BWSTRESU BWSTAT BWREASND BWLAT BWDIR BWDTC BWDY
#library column-order            BW STUDYID DOMAIN USUBJID BWSEQ BWTESTCD BWTEST BWORRES BWORRESU BWSTRESC BWSTRESN BWSTRESU BWSTAT BWREASND BWBLFL BWFAST BWDTC BWDY BWNOMDY
dataset BW class=FINDINGS label="Body Weight"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col BWSEQ    type=Num  label="Sequence Number"
col BWTESTCD type=Char label="Body Weight Test Short Name"
col BWCUSTOM type=Char label="Sponsor Defined Variable"
---
S1 | BW | 001 | 1 | BW | X
