#!RuleTest
#test PMDA-AD0681 expect=skipped domain=ADDL
#note "DEVTYG1 matches neither ^MODELG(\\d+)$ nor ^MODELG(\\d+)N$, so nothing seeds an expansion -> NoMatch -> SKIPPED. The dataset is genuinely in scope (DLAD), so the wildcard NoMatch is the only reason."
#library standard=adamig version=1-3
dataset ADDL
col STUDYID  type=Char
col USUBJID  type=Char
col SPDEVID  type=Char
col DEVTYG1  type=Char
---
S1 | 001 | DEV01 | PUMP
S1 | 002 | DEV02 | VALVE
---
