#!RuleTest
#test PMDA-SD0023 expect=skipped domain=SM
#note "Mechanism: the sheet's DOMAINS cell encodes four classes as Classes.Include [INTERVENTIONS, FINDINGS, EVENTS, FINDINGS ABOUT]. A sponsor-defined Special-Purpose dataset carrying the two gated columns (violating-shaped) sits outside every included class -> skipped."
#library standard=sdtmig version=3-4
dataset SM class="SPECIAL PURPOSE" label="Subject Milestones"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SMSTAT   type=Char label="Completion Status"
col SMREASND type=Char label="Reason Not Done"
---
S1 | SM | 001 |  | SUBJECT UNAVAILABLE
