#!RuleTest
#test FDA-SD1151 expect=violation domain=TI
#note "The criterion text 'Age 18 years or older' is coded both INCL01 and INCL1, so IETESTCD is not constant for a given IETEST. Both records of the conflicting pair are reported."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 IETEST="Age 18 years or older" IETESTCD=INCL01
#expectViolationAt row=2 IETEST="Age 18 years or older" IETESTCD=INCL1
dataset TI label="Trial Inclusion/Exclusion Criteria"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col IETESTCD type=Char label="Incl/Excl Criterion Short Name"
col IETEST   type=Char label="Inclusion/Exclusion Criterion"
col IECAT    type=Char label="Inclusion/Exclusion Category"
---
S1 | TI | INCL01 | Age 18 years or older | INCLUSION
S1 | TI | INCL1  | Age 18 years or older | INCLUSION
S1 | TI | EXCL01 | Pregnant or nursing   | EXCLUSION
