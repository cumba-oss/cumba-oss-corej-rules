#!RuleTest
#test PMDA-SD1083 expect=noViolation domain=LB
#note "The DIRECTION discriminator: the rule conditions on LBDTC being present, so LBDY-without-LBDTC must NOT fire (first conjunct false)."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col LBSEQ   type=Num
col LBDY    type=Num
---
S1 | LB | 001 | 1 | 5
