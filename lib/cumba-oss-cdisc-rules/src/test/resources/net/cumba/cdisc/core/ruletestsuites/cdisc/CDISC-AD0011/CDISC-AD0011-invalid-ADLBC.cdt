#!RuleTest
#test CDISC-AD0011 expect=violation domain=ADLBC
# Rule:Description: A variable with a suffix of FL is equal to N and a variable with the same root and a suffix of FN is not equal to 0
#note "SAFFL=N but SAFFN=1 (!=0) -> violation"
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col SAFFL type=Char
col SAFFN type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | N | 1
---
