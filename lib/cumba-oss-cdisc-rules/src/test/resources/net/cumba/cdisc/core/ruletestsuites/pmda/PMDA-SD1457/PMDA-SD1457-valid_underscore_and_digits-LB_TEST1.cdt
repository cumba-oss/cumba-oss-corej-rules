#!RuleTest
#test PMDA-SD1457 expect=noViolation domain=LB_TEST1
#note "LB_TEST1 - exactly 8 characters combining upper-case letters, an underscore and a digit, i.e. the full permitted charset at the maximum permitted length. Pins the inclusive 8-character boundary and the underscore/digit members of the class; also pins that - unlike the VARIABLE-name rule SD1474 - a dataset name is allowed to contain digits anywhere the sheet permits, the sheet stating no leading-digit restriction for datasets."
#library standard=sdtmig version=3-4
#expectViolationCount 0
dataset LB_TEST1
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col LBSEQ   type=Num
---
CDISCPILOT01 | LB | 01-701-1015 | 1
