#!RuleTest
#test PMDA-SD2015C expect=violation domain=AE
#note "AESOC 'Nervous System Disorders' is a valid System Organ Class but not in MedDRA's preferred case ('Nervous system disorders') -> the case-sensitive check fires on row 2; row 1 matches exactly."
#library standard=sdtmig version=3-4
#dictionaries dummy
#expectViolationCount 1
#expectViolationAt row=2 AESOC="Nervous System Disorders"
dataset AE
col USUBJID type=Char
col AESOC   type=Char
---
001 | Nervous system disorders
001 | Nervous System Disorders
