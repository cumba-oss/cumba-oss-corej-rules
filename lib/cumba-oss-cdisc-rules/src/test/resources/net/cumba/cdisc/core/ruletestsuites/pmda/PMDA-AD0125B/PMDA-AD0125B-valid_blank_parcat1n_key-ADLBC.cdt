#!RuleTest
#test PMDA-AD0125B expect=noViolation domain=ADLBC
#note "Blank PARCAT1N is the KEY -> group dropped; contrast PMDA-AD0126B-valid_blank_parcat1n_target, where the same column is the TARGET."
#library standard=adamig version=1-3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col PARCAT1 type=Char
col PARCAT1N type=Num
---
S1 | 001 | SYSBP | VITALS | 1
S1 | 002 | SYSBP | VITALS | 1
S1 | 003 | SYSBP | VITALSIGNS | 
