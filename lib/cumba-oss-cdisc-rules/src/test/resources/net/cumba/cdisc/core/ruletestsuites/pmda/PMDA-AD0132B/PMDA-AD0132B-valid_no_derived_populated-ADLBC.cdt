#!RuleTest
#test PMDA-AD0132B expect=noViolation domain=ADLBC
#note "Proves the gate ORDER: the absent BASE column alone is not enough. CHG missing on BOTH rows -> first conjunct false everywhere despite the second being broadcast TRUE (BASE absent). Rule is about a POPULATED derived value with incomplete inputs, never about a merely incomplete dataset."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col CHG     type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | 10 | .
CDISCPILOT01 | 01-701-1023 | ALB | 11 | .
