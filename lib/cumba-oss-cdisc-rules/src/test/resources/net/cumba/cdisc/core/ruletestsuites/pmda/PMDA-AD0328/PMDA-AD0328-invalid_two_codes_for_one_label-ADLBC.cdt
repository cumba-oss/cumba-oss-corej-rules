#!RuleTest
#test PMDA-AD0328 expect=violation domain=ADLBC
#note "Mirror of AD0327: the target is the NUMERIC AVALCA1N and the key is (PARAMCD, AVALCAT1). Group (ALB, LOW) holds {1 x2, 2 x1} -> row 3 is the minority."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 AVALCA1N=2 AVALCAT1=LOW PARAMCD=ALB
dataset ADLBC class=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVALCAT1 type=Char
col AVALCA1N type=Num
---
S1 | 001 | ALB | LOW  | 1
S1 | 002 | ALB | LOW  | 1
S1 | 003 | ALB | LOW  | 2
S1 | 004 | ALB | HIGH | 3
S1 | 005 | ALB | HIGH | 3
