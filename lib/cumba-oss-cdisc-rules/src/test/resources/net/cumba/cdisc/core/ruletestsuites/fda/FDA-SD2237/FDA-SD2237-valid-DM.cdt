#!RuleTest
#test FDA-SD2237 expect=noViolation domain=DM
#note "Row 1 and 2 received the arm they were assigned to. Row 3 has no actual arm description at all, so there is nothing to compare."
#library standard=sdtmig version=3-4
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col ARM     type=Char label="Description of Planned Arm"
col ACTARM  type=Char label="Description of Actual Arm"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015 | Placebo | Placebo
CDISCPILOT01 | DM | 01-701-1023 | 1023 | Xanomeline High Dose | Xanomeline High Dose
CDISCPILOT01 | DM | 01-701-1028 | 1028 | Placebo | 
