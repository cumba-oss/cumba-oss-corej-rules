#!RuleTest
#test FDA-SD1023 expect=violation domain=LB
#note "The KEY AXIS of D-TA-6a, pinned: row 2 carries the TV visit NAME (BASELINE) with the wrong VISITNUM (3). The pre-alignment FDA shape matched the name alone against TV.VISIT and was SILENT here; the adopted PMDA shape matches the (VISIT, VISITNUM) pair and fires, which is what the FDA sheet asks for ('Combination of Visit Name (VISIT) and Visit Number (VISITNUM) ... should match that in the TV domain'). Row 1 is the correctly-numbered control. Renamed from FDA-SD1023-invalid_no_svpresp-LB.cdt, whose SVPRESP fallback no longer exists."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=01-701-1015 VISIT=BASELINE
dataset LB label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB | 2 | BASELINE
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALB | 3 | BASELINE
---

dataset TV label="Trial Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
CDISCPILOT01 | TV | 1 | SCREENING
CDISCPILOT01 | TV | 2 | BASELINE
