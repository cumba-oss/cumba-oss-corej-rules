#!RuleTest
#test PMDA-SD1371 expect=violation domain=LB
#note "dataset LB without the LBDRVFL column. Row 1: ORRES empty + LOBXFL=Y -> the authored `not var_exists(\"--DRVFL\")` arm carries the condition -> fires. Row 2: ORRES populated + LOBXFL=Y -> clean."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 LBLOBXFL=Y
dataset LB class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
col LBORRES  type=Char
col LBLOBXFL type=Char
---
S1 | LB | 001 | 1 | GLUC | | Y
S1 | LB | 001 | 2 | ALB  | 4.9 | Y
