#!RuleTest
#test CDISC-AD0758 expect=noViolation domain=ADSL
# Rule:Description: There is more than one value of TRxxPGyN for a given value of TRxxPGy, where xx is an integer [01-99, zero-padded] and y is a single-digit integer [1-9], considering only those rows on which both variables are populated
#note "each TR01PG1 maps to a single TR01PG1N -> noViolation"
dataset ADSL class=ADSL
col STUDYID type=Char
col USUBJID type=Char
col TR01PG1 type=Char
col TR01PG1N type=Num
---
CDISCPILOT01 | 01-701-1015 | GROUP A | 1
CDISCPILOT01 | 01-701-1023 | GROUP B | 2
---
