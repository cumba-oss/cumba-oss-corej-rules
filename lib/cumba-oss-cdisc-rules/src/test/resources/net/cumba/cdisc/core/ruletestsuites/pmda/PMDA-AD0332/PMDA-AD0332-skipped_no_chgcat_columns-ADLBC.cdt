#!RuleTest
#test PMDA-AD0332 expect=skipped domain=ADLBC
#note "No column matches ^CHGCAT(\\d+)$ or ^CHGCAT(\\d+)N$. WildcardExpander.tryExpand returns NoMatch and the factory reports 'SKIPPED: Template did not match any columns in dataset' -- the rule did not execute. The deliberate anti-vacuity contract."
#library standard=adamig version=1-3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
---
S1 | 001 | GLUC | 5.0
S1 | 002 | GLUC | 5.1
