#!RuleTest
#test PMDA-AD0210 expect=noViolation domain=ADSL
#note "Both rows equal to DM (DRUGA/DRUGA, PLACEBO/PLACEBO) - the genuine populated-equal outcome. Join 1:1."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col ARM     type=Char
---
S1 | 01-701-1015 | DRUGA
S1 | 01-701-1023 | PLACEBO
---

dataset DM label=Demographics
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col ARM     type=Char
---
S1 | DM | 01-701-1015 | DRUGA
S1 | DM | 01-701-1023 | PLACEBO
