#!RuleTest
#test PMDA-AD0348 expect=noViolation domain=ADLBC
#note "Row 3 carries A1LOC=LOWNORMAL, so each (PARAMCD, A1LO) group maps to one label."
#library standard=adamig version=1-3
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col A1LO    type=Num
col A1LOC   type=Char
---
S1 | 001 | ALB | 10 | LOWNORMAL
S1 | 002 | ALB | 10 | LOWNORMAL
S1 | 003 | ALB | 10 | LOWNORMAL
S1 | 004 | ALB | 12 | MARGINAL
S1 | 005 | ALB | 12 | MARGINAL
