#!RuleTest
#test PMDA-SD1208 expect=noViolation domain=DM
#note "FRESH. Zero data rows. Predicted SILENT per STAGE-G CRITICAL 4, and silent on the synthetic path too (zero columns => var_exists(\"RFXENDTC\") false)."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SUBJID   type=Char label="Subject Identifier for the Study"
col RFXSTDTC type=Char label="Date/Time of First Study Treatment"
col RFXENDTC type=Char label="Date/Time of Last Study Treatment"
---
