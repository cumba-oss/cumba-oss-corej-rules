#!RuleTest
#test PMDA-AD0239A expect=skipped domain=ADSL
#note "Mixed-group seeding pin: an ordinary ADSL with NO pooled-treatment column. TRTxxA matches TRT01A but its group set {xx} does not equal the union {xx, y}, so it cannot seed; the two union-covering patterns match nothing; the step-5 cross-join assembles {xx=01} and drops it for not covering y -> expansion list empty -> NoMatch -> SKIPPED."
#library standard=adamig version=1-3
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRT01A  type=Char
col TRT01P  type=Char
---
