#!RuleTest
#test PMDA-AD1012A expect=noViolation domain=ADLBC
#note "AVISITN still seeds the expansion, so the rule EXECUTES (this is not a skip), but both disjuncts are false because the primary AVISIT is present alongside it. Column list kept minimal - nothing else ends in N or C - so there is exactly one expansion."
#library standard=adamig version=1-3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col AVISIT  type=Char
col AVISITN type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | 40 | BASELINE | 1
CDISCPILOT01 | 01-701-1023 | ALB | 42 | WEEK2 | 2
