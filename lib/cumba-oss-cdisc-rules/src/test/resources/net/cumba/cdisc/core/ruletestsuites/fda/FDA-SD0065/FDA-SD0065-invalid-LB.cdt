#!RuleTest
#test FDA-SD0065 expect=violation domain=LB
#note "Row 2 has VISITNUM=9 / VISIT=UNSCHEDULED which is no SV row, and LBSTAT is empty -> fires. Row 1 matches SV, row 3 matches SV on a different visit."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=001 VISIT=UNSCHEDULED
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col LBSEQ   type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBSTAT  type=Char label="Completion Status"
col VISITNUM type=Num  label="Visit Number"
col VISIT   type=Char label="Visit Name"
---
S1 | LB | 001 | 1 | ALB |  | 1 | SCREENING
S1 | LB | 001 | 2 | ALB |  | 9 | UNSCHEDULED
S1 | LB | 001 | 3 | ALB |  | 2 | WEEK 2
---

dataset SV class="SPECIAL PURPOSE" label="Subject Visits"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
col SVSTDTC  type=Char label="Start Date/Time of Visit"
---
S1 | SV | 001 | 1 | SCREENING | 2020-01-01
S1 | SV | 001 | 2 | WEEK 2    | 2020-01-15
