#!RuleTest
#test FDA-SD1071 expect=noViolation domain=DM
#note "Dataset metadata reports dataset_size of 1 MiB, well below the 5 GB (5368709120 bytes) threshold -> no violation."
#library standard=sdtmig version=3-4
dataset DM label="Demographics" dataset_size=1048576
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
---
CDISCPILOT01 | DM | 01-701-1015
CDISCPILOT01 | DM | 01-701-1023
