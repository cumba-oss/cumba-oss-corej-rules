#!RuleTest
#test CDISC-AD0678 expect=violation domain=ADDV
# Rule:Description: There is more than one value of DEVTYGyN for a given value of DEVTYGy, considering only those rows on which both variables are populated
#note "DEVTYG1=K1 maps to two distinct DEVTYG1N values -> violation"
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015
#expectViolationAt row=2 USUBJID=01-701-1023
dataset ADDV class="DEVICE LEVEL ANALYSIS DATASET"
col STUDYID type=Char
col USUBJID type=Char
col SPDEVID type=Char
col DEVTYG1N type=Char
col DEVTYG1 type=Char
---
CDISCPILOT01 | 01-701-1015 | DEV01 | A1 | K1
CDISCPILOT01 | 01-701-1023 | DEV01 | A2 | K1
---
