#!RuleTest
#test PMDA-SD1342 expect=skipped domain=DM
#note "CL-D twin symmetry (wave TA-5, plan §14 ruling 1): the owner ruled that the PMDA leg gains the same Requirements.Variables.All [RFXSTDTC] gate wave TA-4 gave FDA-SD1342, restoring the 0-identical pair. Without the gate the Java engine read the absent RFXSTDTC column as empty and fired about a column the sponsor never submitted; with it the engine records one auditable skip. Mirrors FDA-SD1342-valid_rfxstdtc_absent-DM.cdt."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SUBJID   type=Char label="Subject Identifier for the Study"
col RFSTDTC  type=Char label="Subject Reference Start Date/Time"
col RFXENDTC type=Char label="Date/Time of Last Study Treatment"
---
S1 | DM | 001 | 001 | 2020-01-01 | 2020-03-15
