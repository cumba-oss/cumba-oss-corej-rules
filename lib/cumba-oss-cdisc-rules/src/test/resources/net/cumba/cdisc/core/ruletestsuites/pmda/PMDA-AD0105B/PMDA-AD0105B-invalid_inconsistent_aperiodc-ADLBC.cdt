#!RuleTest
#test PMDA-AD0105B expect=violation domain=ADLBC
#note "Grouped by APERIOD=1 the target APERIODC holds {PERIOD1, PERIOD1, PERIODONE} -> minority row 3 fires. Data intentionally matches PMDA-AD0105's violation fixture: same check for a different ADaMIG version; the two never co-occur in one validation run."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=01-701-1034 APERIOD=1 APERIODC=PERIODONE
dataset ADLBC
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col APERIOD  type=Num
col APERIODC type=Char
---
CDISCPILOT01 | 01-701-1015 | GLUC | 1 | PERIOD1
CDISCPILOT01 | 01-701-1023 | GLUC | 1 | PERIOD1
CDISCPILOT01 | 01-701-1034 | GLUC | 1 | PERIODONE
