#!RuleTest
#test FDA-SD1255 expect=violation domain=DM
#note "AE has AESDTH=Y but DM.DTHFL is empty (present-but-blank does not equal 'Y') -> fires."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DTHFL   type=Char label="Subject Death Flag"
---
S1 | DM | 001 |
---

dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESDTH  type=Char label="Results in Death"
---
S1 | AE | 001 | 1 | CARDIAC ARREST | Y
---
