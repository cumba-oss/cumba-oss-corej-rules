#!RuleTest
#test PMDA-SD1472 expect=noViolation domain=LB
#note "Row 2 is the sheet's own worked example '<= -1.2' -- the green pin that distinguishes SD1472 from SD1473's defect. None of these forms fires."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID   type=Char
col DOMAIN    type=Char
col USUBJID   type=Char
col LBSEQ     type=Num
col LBTESTCD  type=Char
col LBORRES   type=Char
col LBSTNRLO  type=Num
---
S1 | LB | 001 | 1 | GLUC | 12       | 3.5
S1 | LB | 001 | 2 | GLUC | <= -1.2  | 3.5
S1 | LB | 001 | 3 | GLUC | > 5      | 3.5
S1 | LB | 001 | 4 | GLUC | -0.5     | 3.5
S1 | LB | 001 | 5 | GLUC | 007      | 3.5
