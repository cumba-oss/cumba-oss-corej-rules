#!RuleTest
#test FDA-SE1155 expect=noViolation domain=DM
#note "The Procedure Agents (AG) dataset is present in the study inventory alongside DM -> no violation."
#library standard=sendig-ar version=1-0
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col SETCD   type=Char label="Set Code"
---
STUDY01 | DM | STUDY01-001 | 001 | SET1
---

dataset AG class=INTERVENTIONS label="Procedure Agents"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AGSEQ   type=Num  label="Sequence Number"
col AGTRT   type=Char label="Name of Procedure Agent"
---
STUDY01 | AG | STUDY01-001 | 1 | ISOFLURANE
---
