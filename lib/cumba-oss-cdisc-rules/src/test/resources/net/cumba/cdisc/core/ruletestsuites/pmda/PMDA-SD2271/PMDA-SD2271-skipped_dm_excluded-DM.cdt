#!RuleTest
#test PMDA-SD2271 expect=skipped domain=DM
#note "DM's class is in Classes.Include, so ONLY the Domains.Exclude [CO, DM] rejects. Pinned ONCE on behalf of PMDA-SD2272 (identical set). Twin discriminator: FDA-SD2271 reaches DM (its sheet lists DM explicitly)."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col SEX      type=Char
---
S1 | DM | 001 | M
---
