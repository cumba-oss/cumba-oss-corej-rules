#!RuleTest
#test CDISC-AD0212 expect=violation domain=ADLBC
# Rule:Description: ANLzzFN is not equal to 1 or null where zz is a zero-padded two-digit integer [01-99]
#note "ANL01FN=2 non-empty and != 1 -> violation"
#expectViolationCount 1
#expectViolationAt row=1
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ANL01FN type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | 2
---
