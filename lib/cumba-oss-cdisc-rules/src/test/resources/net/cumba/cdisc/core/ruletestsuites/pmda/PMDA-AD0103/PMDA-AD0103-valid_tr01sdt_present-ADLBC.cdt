#!RuleTest
#test PMDA-AD0103 expect=noViolation domain=ADLBC
#note "ADSL carries TR01SDT (Char '2020-01-15' -- the rule tests presence only, Char keeps it literal, AD0570 precedent). No fire."
#library standard=adamig version=1-3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col APERIOD type=Num
---
S1 | 001 | GLUC   | 5.1 | 1
S1 | 001 | WEIGHT | 70  | 1
---

dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col TR01SDT type=Char
---
S1 | 001 | 2020-01-15
