#!RuleTest
#test CDISC-CG0383 expect=noViolation domain=AE
#note "Row 1's AEHLGT 'Headaches' is a MedDRA High Level Group Term of the (dummy) dictionary; row 2's upper-case 'GASTROINTESTINAL SIGNS AND SYMPTOMS' passes too under the explicit case_sensitive: false (CL-G.4, matching FDA/PMDA-SD2012's insensitive behaviour)."
#library standard=sdtmig version=3-4
#dictionaries dummy
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEHLGT  type=Char label="High Level Group Term"
---
S1 | AE | 001 | 1 | headache | Headaches
S1 | AE | 001 | 2 | nausea   | GASTROINTESTINAL SIGNS AND SYMPTOMS
