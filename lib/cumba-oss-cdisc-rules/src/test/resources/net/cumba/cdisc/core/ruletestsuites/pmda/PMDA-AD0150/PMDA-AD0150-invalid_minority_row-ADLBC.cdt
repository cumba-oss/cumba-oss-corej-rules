#!RuleTest
#test PMDA-AD0150 expect=violation domain=ADLBC
#note "Group (GLUC, LOW) holds AVAL {1, 1, 2} -> minority row 3 fires. This is the MIRROR of the AD0149 fixture: there the key was (PARAMCD, AVAL) and the target AVALC, here it is the other way round."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=01-701-1034 PARAMCD=GLUC AVAL=2 AVALC=LOW
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col AVALC   type=Char
---
CDISCPILOT01 | 01-701-1015 | GLUC | 1 | LOW
CDISCPILOT01 | 01-701-1023 | GLUC | 1 | LOW
CDISCPILOT01 | 01-701-1034 | GLUC | 2 | LOW
