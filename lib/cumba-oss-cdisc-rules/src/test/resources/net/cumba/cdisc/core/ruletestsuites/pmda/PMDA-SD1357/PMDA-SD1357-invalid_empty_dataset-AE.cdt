#!RuleTest
#test PMDA-SD1357 expect=violation domain=AE
#note "FRESH, 0-row: AE declares MIDSDTC but not MIDS, and carries ZERO DATA ROWS. RuleRunner.executeUnified applies BroadcastFold at the top of the method, above the 0-row synthetic zero-column-table substitution, so a pure var_exists tree is decided from the declared column schema and survives at 0 rows. Predicted VIOLATION, count 1. Count-only pin, matching this rule's own twin fixtures (no #expectViolationAt)."
#library standard=sdtmig version=3-4
#expectViolationCount 1
dataset AE class=EVENTS label="Adverse Events"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col AESEQ    type=Num  label="Sequence Number"
col AETERM   type=Char label="Reported Term for the Adverse Event"
col MIDSDTC  type=Char label="Disease Milestone Instance Date/Time"
---
