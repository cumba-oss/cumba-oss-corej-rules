#!RuleTest
#test CDISC-AD0766 expect=violation domain=ADLBC
# Rule:Description: There is more than one value of TRTAGyN for a given value of TRTAGy, where y is an integer [1-99, not zero-padded], considering only those rows on which both variables are populated
#note "TRTAG1=GROUP A maps to two distinct TRTAG1N -> violation"
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015
#expectViolationAt row=2 USUBJID=01-701-1023
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col TRTAG1 type=Char
col TRTAG1N type=Num
---
CDISCPILOT01 | 01-701-1015 | GLUC | GROUP A | 1
CDISCPILOT01 | 01-701-1023 | GLUC | GROUP A | 2
---
