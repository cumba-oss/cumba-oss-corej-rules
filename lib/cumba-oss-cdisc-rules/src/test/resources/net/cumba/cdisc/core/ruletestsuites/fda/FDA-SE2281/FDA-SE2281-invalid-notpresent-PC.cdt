#!RuleTest
#test FDA-SE2281 expect=violation domain=PC
#note "PCNOMDY variable not present in the dataset -> the bare empty() leaf on the absent column is TRUE on every row (absent = all-missing, EC-43) and the rule fires (Plan B phase 4d' deleted the redundant not var_exists disjunct this note used to name) even though PCELTM/PCTPTREF are populated. Presence-branch firing is collapsed to a single finding by the engine, so only the verdict-level count is pinned."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 PCSEQ=1
dataset PC class=FINDINGS label="Pharmacokinetics Concentrations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PCSEQ    type=Num  label="Sequence Number"
col PCELTM   type=Char label="Planned Elapsed Time from Time Point Ref"
col PCTPTREF type=Char label="Time Point Reference"
---
S1 | PC | 001 | 1 | PT0H | DOSE 1
