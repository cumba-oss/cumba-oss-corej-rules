#!RuleTest
#test FDA-SD1038 expect=noViolation domain=TS
#note "TSSEQ restarts per TSPARMCD: seq 1 appears under TITLE and under SPONSOR, but within each TSPARMCD every TSSEQ is unique -> no violation."
#library standard=sdtmig version=3-4
dataset TS class="TRIAL DESIGN"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL    type=Char label="Parameter Value"
---
S1 | TS | 1 | TITLE   | Study of X
S1 | TS | 1 | SPONSOR | Acme
S1 | TS | 2 | SPONSOR | Acme Sub
