#!RuleTest
#test CDISC-CG0411 expect=noViolation domain=SUPPDM
#note "DM branch: each QNAM appears once per subject (parent record = subject for DM); same QNAM on different subjects is allowed -> no violation. No DOMAIN column declared. Keeps the DM branch's positive half pinned on the CDISC member too, because the DM branch is the part of the Check with no sheet warrant (SD0086-F1) and the lane may revisit it. ADAPTED-FROM fda/FDA-SD0086/FDA-SD0086-valid-dm-SUPPDM.cdt."
#library standard=sdtmig version=3-4
dataset SUPPDM class=RELATIONSHIP label="Supplemental Qualifiers for DM"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM     type=Char label="Qualifier Variable Name"
col QVAL     type=Char label="Data Value"
---
S1 | DM | 001 |  |  | RACEOTH | Other race
S1 | DM | 001 |  |  | RACESPEC | spec
S1 | DM | 002 |  |  | RACEOTH | Other race
