#!RuleTest
#test PMDA-AD0351 expect=violation domain=ADLBC
#note "Within (SYSBP, A1HI=160) the range code VERYHIGH on row 3 is the minority against HIGH x2."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 PARAMCD=SYSBP A1HI=160 A1HIC=VERYHIGH
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col PARAM type=Char
col A1HIC type=Char
col A1HI type=Num
---
S1 | 001 | SYSBP | SystolicBP | HIGH | 160
S1 | 002 | SYSBP | SystolicBP | HIGH | 160
S1 | 003 | SYSBP | SystolicBP | VERYHIGH | 160
S1 | 001 | DIABP | DiastolicBP | HIGH | 100
S1 | 002 | DIABP | DiastolicBP | HIGH | 100
