#!RuleTest
#test PMDA-SD1099 expect=violation domain=LB
#note "FRESH - the cluster's presence-on-empty pin (K1-01/K1-02 settled fact; AD0170 shape). LBSCAT is DECLARED, LBCAT is absent, and the dataset carries ZERO data rows. BroadcastFold decides the dataset-constant presence Check before the zero-column substitution, so the rule FIRES: count 1, row=1."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBSCAT   type=Char label="Subcategory for Lab Test"
---
