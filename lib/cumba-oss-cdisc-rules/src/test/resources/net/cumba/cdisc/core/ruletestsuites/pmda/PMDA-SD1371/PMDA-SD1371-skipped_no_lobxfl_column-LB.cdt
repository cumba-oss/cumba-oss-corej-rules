#!RuleTest
#test PMDA-SD1371 expect=skipped domain=LB
#note "dataset LB without the LBLOBXFL column. Requirements.Variables.All [--LOBXFL] gates -> auditable skip. Same encoding as the FDA twin. The Domains.Exclude [DD, IE, SC] facet is not separately pinned (mechanism covered by SD0021/SD1339/SD0029/SD1203/SD0005's exclusion pins)."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
col LBORRES  type=Char
col LBDRVFL  type=Char
---
S1 | LB | 001 | 1 | GLUC | |
