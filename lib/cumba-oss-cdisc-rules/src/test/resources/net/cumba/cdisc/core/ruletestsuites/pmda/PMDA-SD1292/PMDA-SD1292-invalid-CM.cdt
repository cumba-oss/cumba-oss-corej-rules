#!RuleTest
#test PMDA-SD1292 expect=violation domain=CM
#note "Row 1: CMSTTPT populated with CMSTRTPT empty -> fires. Row 2: both populated -> clean."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 CMSTTPT=2020-01-01
dataset CM class=INTERVENTIONS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col CMSEQ    type=Num
col CMTRT    type=Char
col CMSTRTPT type=Char
col CMSTTPT  type=Char
---
S1 | CM | 001 | 1 | ASPIRIN   |       | 2020-01-01
S1 | CM | 001 | 2 | IBUPROFEN | AFTER | 2020-02-01
