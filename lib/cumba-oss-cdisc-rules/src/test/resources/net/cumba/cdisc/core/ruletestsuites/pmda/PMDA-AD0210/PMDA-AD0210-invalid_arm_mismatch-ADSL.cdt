#!RuleTest
#test PMDA-AD0210 expect=violation domain=ADSL
#note "Row 1: ARM DRUGA != DM.ARM PLACEBO -> fires. Row 2: equal -> silent. Join DM on Keys=[USUBJID], loader-default inner, 1:1."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 ARM=DRUGA DM.ARM=PLACEBO
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col ARM     type=Char
---
S1 | 01-701-1015 | DRUGA
S1 | 01-701-1023 | PLACEBO
---

dataset DM label=Demographics
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col ARM     type=Char
---
S1 | DM | 01-701-1015 | PLACEBO
S1 | DM | 01-701-1023 | PLACEBO
