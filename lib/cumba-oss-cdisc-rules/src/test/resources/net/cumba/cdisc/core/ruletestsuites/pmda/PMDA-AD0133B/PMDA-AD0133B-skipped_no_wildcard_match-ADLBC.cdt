#!RuleTest
#test PMDA-AD0133B expect=skipped domain=ADLBC
#note "No column matches ^R2A(\d+)LO$ or ^A(\d+)LO$, so expand() returns empty, tryExpand returns NoMatch and the rule DOES NOT EXECUTE -- expect=skipped, never noViolation. AVAL does not match ^A(\d+)LO$ (the capture group needs digits)."
#library standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVAL     type=Num
