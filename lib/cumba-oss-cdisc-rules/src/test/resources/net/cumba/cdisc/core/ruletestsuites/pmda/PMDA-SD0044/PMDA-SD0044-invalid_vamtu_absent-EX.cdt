#!RuleTest
#test PMDA-SD0044 expect=violation domain=EX
#note "EXVAMTU is not present in the dataset while EXVAMT is populated on both rows -> the units are missing. Encodes the column-absent case: the Check carries a bare empty(--VAMTU) leaf, which under absent = all-missing (EC-43) is TRUE on every row of a column that is not there. Plan B phase 4d' deleted the redundant not var_exists(--VAMTU) disjunct that used to spell this out; the verdict is unchanged."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 EXVAMT=5
#expectViolationAt row=2 EXVAMT=10
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXVAMT  type=Num  label="Treatment Vehicle Amount"
---
CDISCPILOT01 | EX | 01-701-1015 | 1 | DRUG A | 5
CDISCPILOT01 | EX | 01-701-1015 | 2 | DRUG A | 10
