#!RuleTest
#test PMDA-SD1075 expect=skipped domain=AE
#note "FRESH: the batch's Classes.Include reject pin ([FINDINGS] vs EVENTS). AESTDTC IS present, so were the class axis to admit AE the rule would fire; the skip is therefore discriminating."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESTDTC type=Char label="Start Date/Time of Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE | 2020-01-10
