#!RuleTest
#test PMDA-SD1236 expect=violation domain=DX
#note "DXSEQ 1 appears twice for the same (SPDEVID D1, USUBJID S1-001) -> both duplicate records fire; device D2's seq 1 does not."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 SPDEVID=D1
#expectViolationAt row=2 SPDEVID=D1
dataset DX
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col SPDEVID type=Char label="Sponsor Device Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col DXSEQ   type=Num  label="Sequence Number"
col DXTRT   type=Char label="Name of Device Exposure"
---
S1 | DX | D1 | S1-001 | 1 | Stent
S1 | DX | D1 | S1-001 | 1 | Stent
S1 | DX | D2 | S1-001 | 1 | Pump
