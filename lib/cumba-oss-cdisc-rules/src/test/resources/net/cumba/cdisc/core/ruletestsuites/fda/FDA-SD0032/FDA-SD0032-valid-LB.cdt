#!RuleTest
#test FDA-SD0032 expect=noViolation domain=LB
#note "Every record with a planned time point number (LBTPTNUM) also carries the time point name (LBTPT); row 3 has neither."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBTPT    type=Char label="Planned Time Point Name"
col LBTPTNUM type=Num  label="Planned Time Point Number"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | GLUC | 1 HR POST | 1
CDISCPILOT01 | LB | 01-701-1015 | 2 | GLUC | 2 HR POST | 2
CDISCPILOT01 | LB | 01-701-1023 | 1 | GLUC |           |
