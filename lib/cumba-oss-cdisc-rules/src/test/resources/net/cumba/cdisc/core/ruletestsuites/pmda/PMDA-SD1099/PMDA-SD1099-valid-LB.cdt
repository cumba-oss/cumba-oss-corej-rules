#!RuleTest
#test PMDA-SD1099 expect=noViolation domain=LB
#note "ADAPTED-FROM fda/FDA-SD1099/FDA-SD1099-valid-LB.cdt. LBSCAT is accompanied by its parent category LBCAT -> no violation."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBCAT    type=Char label="Category for Lab Test"
col LBSCAT   type=Char label="Subcategory for Lab Test"
---
S1 | LB | 001 | 1 | CHEMISTRY | LIVER FUNCTION
