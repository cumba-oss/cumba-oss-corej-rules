#!RuleTest
#test FDA-SE2332 expect=violation domain=TS
#note "No TSPARMCD=PCLASS record anywhere in TS -> the 'Pharmacological Class of Investigational Therapy' parameter is missing, one dataset-level finding. the near-miss parameters TAPHSCLS (CLS) and STCAT are other classification parameters, but neither is PCLASS."
#library standard=sendig version=3-1-1
#expectViolationCount 1
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | TAPHSCLS | Test Article Physical Class                | SOLUTION
S01 | TS | 2 | STCAT    | Study Category                             | TOXICOLOGY
S01 | TS | 3 | STITLE   | Nonclinical Study Title                    | 13-Week Repeat Dose Toxicity Study
