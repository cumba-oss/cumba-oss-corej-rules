#!RuleTest
#test PMDA-AD0099 expect=violation domain=ADLBC
#note "Expansion: ^(.+)STDY$ -> ASTDY root 'A'; ^(.+)ENDY$ -> AENDY root 'A'; ONE tuple. Note ASTDY does NOT match AD0098's ^(.+)SDY$ (it ends 'TDY'), which is what keeps the two rules apart. Record-level violation on row 1."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 ASTDY=10 AENDY=5
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ASTDY   type=Num
col AENDY   type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | 10 | 5
