#!RuleTest
#test PMDA-SD1288 expect=violation domain=AE
#note "The dictionary-derived term 'Headache' is coded with two different preferred term codes (10019211 and 10019212), so --PTCD is not constant within --DECOD. Both records of the conflicting pair are reported."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 AEDECOD=Headache AEPTCD=10019211
#expectViolationAt row=2 AEDECOD=Headache AEPTCD=10019212
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEDECOD type=Char label="Dictionary-Derived Term"
col AEPTCD  type=Num  label="Preferred Term Code"
---
S1 | AE | 001 | 1 | HEADACHE  | Headache | 10019211
S1 | AE | 002 | 1 | HEAD ACHE | Headache | 10019212
S1 | AE | 003 | 1 | NAUSEA    | Nausea   | 10028813
