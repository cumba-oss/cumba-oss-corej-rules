#!RuleTest
#test FDA-SD1340 expect=noViolation domain=EX
#note "SDTMIG 3.1.2 has no ACTARMCD in DM at all, so DM carries no ACTARMCD column. Without the exists(DM.ACTARMCD) guard the empty(DM.ACTARMCD) arm is true on every row (an absent column reads as an all-missing column), and every non-RUN-IN EX record fires: rows 1, 2 and 4 here. The guard makes the untreated-subject predicate unanswerable rather than universally true, so nothing fires."
#library standard=sdtmig version=3-1-2
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EPOCH   type=Char label="Epoch"
---
S1 | EX | 001 | 1 | DRUG A  | TREATMENT
S1 | EX | 002 | 1 | DRUG A  | TREATMENT
S1 | EX | 002 | 2 | PLACEBO | RUN-IN
S1 | EX | 003 | 1 | DRUG A  | TREATMENT
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
---
S1 | DM | 001 | ARM1 | Arm 1
S1 | DM | 002 | ARM1 | Arm 1
S1 | DM | 003 | ARM1 | Arm 1
---
