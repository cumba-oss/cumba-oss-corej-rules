#!RuleTest
#test FDA-SE2355 expect=noViolation domain=TS
#note "Row 1: the ENVTEMPU record uses the allowed unit 'C'. Row 2: ENVTEMP (the temperature itself) is a different parameter and is not gated. Row 3: an empty TSVAL is excluded by the non_empty guard."
#library standard=sendig version=3-1-1
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
STUDY01 | TS | 1 | ENVTEMPU | Environmental Temperature Units | C
STUDY01 | TS | 2 | ENVTEMP  | Environmental Temperature       | 22
STUDY01 | TS | 3 | ENVTEMPU | Environmental Temperature Units |
