#!RuleTest
#test FDA-SE2233 expect=violation domain=MI
#note "any-branch 2: MIRESCAT is populated on a 'NORMAL' record -> fires on row 1; row 2 is the conformant abnormal twin."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 MISTRESC=NORMAL MIRESCAT=INFLAMMATION
dataset MI label="Microscopic Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col MISEQ    type=Num  label="Sequence Number"
col MITESTCD type=Char label="Microscopic Examination Short Name"
col MISTRESC type=Char label="Standardized Result in Standard Format"
col MIRESCAT type=Char label="Result Category"
col MISPEC   type=Char label="Specimen Material Type"
---
STUDY01 | MI | STUDY01-001 | 1 | MIEXAM | NORMAL                       | INFLAMMATION | KIDNEY
STUDY01 | MI | STUDY01-001 | 2 | MIEXAM | INFILTRATE, MONONUCLEAR CELL | INFLAMMATION | LIVER
