#!RuleTest
#test PMDA-SD1001 expect=noViolation domain=DM
#note "BOUNDARY: SUBJID 001 appears twice but under DIFFERENT STUDYIDs (S1 and S2), so the tuples (001,S1) and (001,S2) are distinct and nothing fires. Pins that keys=[STUDYID] is a real key component of the uniqueness tuple and not decoration -- the sheet says 'unique for each subject WITHIN THE STUDY' (PMDA row 102). NEUTER CHECK: change row 2's STUDYID to S1 and the count becomes 2."
#library standard=sdtmig version=3-4
#expectViolationCount 0
dataset DM class="SPECIAL PURPOSE"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
---
S1 | DM | S1-001 | 001
S2 | DM | S2-001 | 001
S1 | DM | S1-002 | 002
