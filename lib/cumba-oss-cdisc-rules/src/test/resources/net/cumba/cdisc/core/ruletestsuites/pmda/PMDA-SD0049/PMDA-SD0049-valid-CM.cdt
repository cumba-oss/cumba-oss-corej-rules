#!RuleTest
#test PMDA-SD0049 expect=noViolation domain=CM
#note "Row 1: CMSTRTPT=BEFORE with CMSTTPT populated -> clean. Row 2: both empty -> clean."
#library standard=sdtmig version=3-4
dataset CM class=INTERVENTIONS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col CMSEQ    type=Num
col CMTRT    type=Char
col CMSTRTPT type=Char
col CMSTTPT  type=Char
---
S1 | CM | 001 | 1 | ASPIRIN   | BEFORE | SCREENING
S1 | CM | 001 | 2 | IBUPROFEN |        |
