#!RuleTest
#test FDA-SD1350 expect=violation domain=PP
#note "PPENINT column absent while PPSTINT is populated -> the bare empty() leaf on the absent column is TRUE on every row (absent = all-missing, EC-43) and the rule fires (Plan B phase 4d' deleted the redundant not var_exists disjunct this note used to name)."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 PPSTINT=P0D
dataset PP class=FINDINGS label="Pharmacokinetic Parameters"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PPSEQ    type=Num  label="Sequence Number"
col PPTESTCD type=Char label="Parameter Short Name"
col PPSTRESC type=Char label="Character Result/Finding in Std Format"
col PPSTINT  type=Char label="Planned Start of Assessment Interval"
---
S1 | PP | 001 | 1 | AUCALL | 120.5 | P0D
