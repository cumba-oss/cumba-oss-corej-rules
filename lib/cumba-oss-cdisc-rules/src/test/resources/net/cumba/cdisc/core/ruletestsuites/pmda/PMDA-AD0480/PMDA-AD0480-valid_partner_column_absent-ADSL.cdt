#!RuleTest
#test PMDA-AD0480 expect=noViolation domain=ADSL
#note "STRAT1VN is not declared. The expansion is still seeded (by STRAT1V) with w=1 and STRAT1VN is SYNTHESISED as an absent column; Requirements.Variables.All expands to STRAT1V, which IS present, so the rule executes and var_exists(STRAT1VN) keeps it silent."
#library standard=adamig version=1-3
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col STRAT1V type=Char
---
S1 | 001 | HIGH
S1 | 002 | LOW
---
