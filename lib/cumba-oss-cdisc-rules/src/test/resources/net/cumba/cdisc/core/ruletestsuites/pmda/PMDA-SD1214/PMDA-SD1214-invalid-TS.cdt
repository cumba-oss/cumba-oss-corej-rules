#!RuleTest
#test PMDA-SD1214 expect=violation domain=TS
#note "TS carries two ADDON records ($addon_count = 2 > 1) -> exactly one dataset-level violation. The single TITLE record and the two-record ARMCD parameter are ignored by the TSPARMCD=ADDON filter."
#library standard=sdtmig version=3-4
#expectViolationCount 1
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S1 | TS | 1 | ADDON | Added on to Existing Treatments | Y
S1 | TS | 2 | ADDON | Added on to Existing Treatments | N
S1 | TS | 1 | TITLE | Trial Title | A Randomized Study
