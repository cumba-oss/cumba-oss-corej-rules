#!RuleTest
#test PMDA-AD0221 expect=noViolation domain=ADLBC
#note "Each (PARAMCD, AVAL) group holds exactly one distinct AVALCAT1 value - categories differ BETWEEN groups, which the sheet explicitly allows. Rule executes and stays silent."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADLBC structure=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVAL     type=Num
col AVALCAT1 type=Char
---
CDISCPILOT01 | 01-701-1015 | ALB | 30 | LOW
CDISCPILOT01 | 01-701-1023 | ALB | 30 | LOW
CDISCPILOT01 | 01-701-1034 | ALB | 50 | HIGH
