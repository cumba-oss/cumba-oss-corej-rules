#!RuleTest
#test CDISC-AD0510 expect=noViolation domain=ADLBC
# Rule:Description: A variable ending in STM must contain "Start Time" in the label
#note "ASTM label contains "Start Time" -> noViolation"
#library standard=adamig version=1-3
#library column-order ADLBC STUDYID USUBJID PARAMCD
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ASTM type=Char label="Analysis Start Time"
---
CDISCPILOT01 | 01-701-1015 | ALB | x
---
