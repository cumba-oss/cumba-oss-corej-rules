#!RuleTest
#test PMDA-AD0480 expect=noViolation domain=ADSL
#note "Each STRAT1VN value maps to a single STRAT1V value."
#library standard=adamig version=1-3
dataset ADSL
col STUDYID   type=Char
col USUBJID   type=Char
col STRAT1V   type=Char
col STRAT1VN  type=Num
---
S1 | 001 | HIGH | 1
S1 | 002 | HIGH | 1
S1 | 003 | LOW  | 2
---
