#!RuleTest
#test FDA-SD2228 expect=noViolation domain=TS
#note "No STYPE record at all, so the study is not established as INTERVENTIONAL and the 'Intervention Model' requirement does not apply -> no violation."
#library standard=sdtmig version=3-4
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | TITLE    | Trial Title                            | A Study of Drug X in Condition Y
S01 | TS | 2 | TPHASE   | Trial Phase Classification             | PHASE III TRIAL
S01 | TS | 3 | SPONSOR  | Clinical Study Sponsor                 | ACME PHARMA
