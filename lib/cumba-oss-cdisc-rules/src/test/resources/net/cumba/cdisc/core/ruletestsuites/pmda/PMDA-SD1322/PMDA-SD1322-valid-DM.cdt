#!RuleTest
#test PMDA-SD1322 expect=noViolation domain=DM
#note "COUNTRY is bound to the non-extensible COUNTRY (ISO 3166-1 alpha-3) codelist with terms USA/CAN/DEU. Rows 1-2 use terms; row 3 leaves COUNTRY empty (non_empty guard) -> no violation. Violation twin: PMDA-SD1322-invalid-DM.cdt guards against a vacuous pass."
#library standard=sdtmig version=3-4
#library variable-metadata DM COUNTRY codelist=COUNTRY codelist_extensible=false codelist_coded_values="[\"USA\",\"CAN\",\"DEU\"]"
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col COUNTRY type=Char label="Country"
---
S1 | DM | 001 | USA
S1 | DM | 002 | CAN
S1 | DM | 003 |
