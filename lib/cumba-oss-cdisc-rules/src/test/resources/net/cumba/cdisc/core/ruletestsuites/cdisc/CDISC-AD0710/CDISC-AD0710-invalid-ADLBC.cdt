#!RuleTest
#test CDISC-AD0710 expect=violation domain=ADLBC
# Rule:Description: A variable with a suffix of RFL has a value that is not Y, N, or null
#note "MYRFL value "X" is non-empty and not in the allowed set -> violation"
#expectViolationCount 1
#expectViolationAt row=1
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col MYRFL type=Char
---
CDISCPILOT01 | 01-701-1015 | ALB | X
---
