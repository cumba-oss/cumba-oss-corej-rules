#!RuleTest
#test PMDA-AD0667 expect=skipped domain=ADNCA
#note "The absent-optional-variable contract. TRTA is NOT declared. Requirements.Variables.All:[TRTA] skips the rule and the skip reason names TRTA. PMDA reports an auditable skip here, where CDISC-AD0667 (no Variables gate) would silently execute on the same data."
#library standard=adamig version=1-3
dataset ADNCA structure=BDS subclass=NCA
col STUDYID   type=Char
col USUBJID   type=Char
col PARAMCD   type=Char
col DOSPCTDF  type=Num
---
