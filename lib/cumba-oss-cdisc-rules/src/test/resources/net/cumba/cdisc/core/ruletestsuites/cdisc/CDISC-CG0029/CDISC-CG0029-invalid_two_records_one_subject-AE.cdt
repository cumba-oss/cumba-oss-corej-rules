#!RuleTest
#test CDISC-CG0029 expect=violation domain=AE
#note "FRESH - the SD1316-F3 DISCRIMINATING fixture. Subject 998 has TWO AE records and subject 999 has one, none of the three present in DM: the ruled per-subject answer is 2 (anchored at each group's first flagged row, AE rows 2 and 4), a per-record reading would say 3, and a dataset-level reading would say 1. Row 1 (001) is in DM -> clean. Row 5 has an empty USUBJID and is guarded by the non_empty leaf."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=2 USUBJID=998
#expectViolationAt row=4 USUBJID=999
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE
S1 | AE | 998 | 1 | NAUSEA
S1 | AE | 998 | 2 | DIZZINESS
S1 | AE | 999 | 1 | RASH
S1 | AE |     | 1 | PYREXIA
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SEX     type=Char label="Sex"
---
S1 | DM | 001 | M
S1 | DM | 002 | F
---
