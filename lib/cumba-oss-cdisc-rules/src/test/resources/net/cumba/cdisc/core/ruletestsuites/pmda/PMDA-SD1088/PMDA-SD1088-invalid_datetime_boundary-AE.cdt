#!RuleTest
#test PMDA-SD1088 expect=violation domain=AE
#note "FRESH, DISCRIMINATING (whole-value is_complete_date semantics, pinned once for the SD1088/SD1092 cluster). Row 1 AESTDTC '2020-01-12T09:30' (length 16 -> COMPLETE) with AESTDY '.' -> FIRES; row 2 AESTDTC '2020-01-12T09' (length 13, complete date part but truncated time -> NOT complete) with AESTDY '.' -> silent. ESCALATE if row 2 fires (the length gate moved) or row 1 does not."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESTDTC type=Char label="Start Date/Time of Adverse Event"
col AESTDY  type=Num  label="Study Day of Start of Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE | 2020-01-12T09:30 | .
S1 | AE | 001 | 2 | NAUSEA   | 2020-01-12T09    | .
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
---
S1 | DM | 001 | 2020-01-01
---
