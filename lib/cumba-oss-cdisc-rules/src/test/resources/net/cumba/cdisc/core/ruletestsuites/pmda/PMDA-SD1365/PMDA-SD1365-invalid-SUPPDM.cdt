#!RuleTest
#test PMDA-SD1365 expect=violation domain=SUPPDM
#note "Rows 2 and 3 carry ADSL population flags as SUPPDM qualifiers (SAFFL, ITT) -> two violations; row 1 is an ordinary qualifier. QNAM matching is case-sensitive on the CT submission values. Adapted verbatim from FDA-SD1365 (byte-identical Check/Scope)."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=2 QNAM=SAFFL
#expectViolationAt row=3 QNAM=ITT
dataset SUPPDM label="Supplemental Qualifiers for DM"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM     type=Char label="Qualifier Variable Name"
col QLABEL   type=Char label="Qualifier Variable Label"
col QVAL     type=Char label="Data Value"
---
CDISCPILOT01 | DM | 01-701-1015 |  |  | RACEOTH | Race, Other                | ASIAN-INDIAN
CDISCPILOT01 | DM | 01-701-1023 |  |  | SAFFL   | Safety Population Flag     | Y
CDISCPILOT01 | DM | 01-701-1028 |  |  | ITT     | Intent To Treat Population | Y
