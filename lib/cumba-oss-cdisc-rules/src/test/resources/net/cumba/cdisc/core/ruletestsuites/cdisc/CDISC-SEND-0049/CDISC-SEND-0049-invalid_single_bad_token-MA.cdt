#!RuleTest
#test CDISC-SEND-0049 expect=violation domain=MA
#note "The carve-out must not swallow the ordinary single-value case: a value carrying no semicolon is one contributing item, so a non-term still fires. Row 1 is the term LEFT and stays silent; row 2 submits SIDEWAYS, which is no LAT term, and fires."
#library standard=sendig version=3-1-1
#library variable-metadata MA MALAT codelist=LAT codelist_extensible=true codelist_coded_values="[\"LEFT\",\"RIGHT\",\"BILATERAL\"]"
#expectViolationCount 1
#expectViolationAt variable_name=MALAT variable_value=SIDEWAYS
dataset MA class=FINDINGS label="Macroscopic Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col MASEQ    type=Num  label="Sequence Number"
col MATESTCD type=Char label="Macroscopic Examination Short Name"
col MALAT    type=Char label="Laterality"
---
S1 | MA | 001 | 1 | GMACROS | LEFT
S1 | MA | 002 | 2 | GMACROS | SIDEWAYS
