#!RuleTest
#test PMDA-AD0137 expect=violation domain=ADLBC
#note "Expansion arithmetic pin - TWO expansions (y=1, y=2). Row 1: y=1 fires (CRIT1FL=Y, CRIT1 empty), y=2 does not (CRIT2FL empty). Row 2: y=2 fires (CRIT2FL=N, CRIT2 empty), y=1 does not. No _wildcards block declared, so both indices are accepted."
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015 CRIT1FL=Y
#expectViolationAt row=2 USUBJID=01-701-1023 CRIT2FL=N
#library standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col CRIT1   type=Char
col CRIT1FL type=Char
col CRIT2   type=Char
col CRIT2FL type=Char
---
CDISCPILOT01 | 01-701-1015 | ALT |  | Y |  |
CDISCPILOT01 | 01-701-1023 | ALT |  |   |  | N
---
