#!RuleTest
#test CDISC-CG0329 expect=skipped domain=DM
#note "FRESH. Scope.Domains.Include is [TE], so a DM primary is rejected by the domain axis before the rule executes. Neither TEENRL nor TEDUR is carried, so if the domain gate were ever removed the rule would fire (both columns absent -> the whole expression folds dataset-constant TRUE) -- the skip is a real assertion here rather than a vacuous one."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col AGE     type=Num  label="Age"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015 | 56
