#!RuleTest
#test PMDA-AD0066 expect=skipped domain=ADSL
#note "A perfectly ordinary ADSL that carries NO TRxxPG* column at all. Both patterns of this rule carry the group set {xx, y} and neither matches anything, so anyAnchor is false and expansion returns empty -> NoMatch -> the rule DOES NOT EXECUTE. Must be expect=skipped, never noViolation."
#library standard=adamig version=1-3
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRT01P  type=Char
col TRT01A  type=Char
---
CDISCPILOT01 | 01-701-1015 | PLACEBO | DRUGA
