#!RuleTest
#test PMDA-SD1242 expect=skipped domain=MH
#note "FRESH - two-variable Requirements.Variables reject pin (All [--BDSYCD, --BODSYS]) + the batch's MH in-scope-domain face. MH is in Domains.Include, so only the missing MHBDSYCD column rejects; the rule must not execute."
#library standard=sdtmig version=3-4
dataset MH class=EVENTS label="Medical History"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col MHSEQ   type=Num  label="Sequence Number"
col MHTERM  type=Char label="Reported Term for the Medical History"
col MHBODSYS type=Char label="Body System or Organ Class"
---
S1 | MH | 001 | 1 | ASTHMA | Respiratory disorders
