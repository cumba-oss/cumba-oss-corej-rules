#!RuleTest
#test CDISC-AD0768 expect=violation domain=ADSL
# Rule:Description: There is more than one value of TRTxxA for a given value of TRTxxAN, where xx is an integer [01-99, zero-padded], considering only those rows on which both variables are populated
#note "TRT01AN=0 maps to two distinct TRT01A -> violation"
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015
#expectViolationAt row=2 USUBJID=01-701-1023
dataset ADSL class=ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRT01A type=Char
col TRT01AN type=Num
---
CDISCPILOT01 | 01-701-1015 | Placebo | 0
CDISCPILOT01 | 01-701-1023 | Sugar Pill | 0
---
