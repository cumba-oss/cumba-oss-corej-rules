#!RuleTest
#test PMDA-SD1474 expect=noViolation domain=LB
#note "is_valid_name's first-character class is [A-Z_], so a LEADING UNDERSCORE (_LBTMP) is accepted - the Source forbids only a leading NUMBER. Pins the exact charset the engine implements rather than a paraphrase of it."
#library standard=sdtmig version=3-4
#expectViolationCount 0
dataset LB
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col _LBTMP  type=Char
---
CDISCPILOT01 | LB | 01-701-1015 | X
