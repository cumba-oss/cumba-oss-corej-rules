#!RuleTest
#test PMDA-AD0204 expect=violation domain=ADSL
#note "JOIN: Match_Datasets DM on Keys=[USUBJID], Join_Type inner (default -- correct: the rule fires on a POPULATED merged value; the unmatched-subject defect belongs to AD0053); DM one row per subject -> 1:1. ADSL.AGE populated and != DM.AGE -> fires."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 AGE=99
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col AGE     type=Num
---
CDISCPILOT01 | 01-701-1015 | 99
---

dataset DM label=Demographics
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col AGE     type=Num
