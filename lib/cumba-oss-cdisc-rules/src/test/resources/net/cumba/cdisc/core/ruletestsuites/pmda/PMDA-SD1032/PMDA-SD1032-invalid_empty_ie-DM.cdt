#!RuleTest
#test PMDA-SD1032 expect=violation domain=DM
#note "FRESH (DISCRIMINATING - grouped record_count over an EMPTY foreign domain: no groups exist, every $-read defaults 0). IE PRESENT with ZERO data rows (full column set incl. USUBJID declared); DM row 001 SCRNFAIL -> FIRES; DM row 002 (ARMCD=A) is gated off. If this reports other than 1, escalate."
#library standard=sdtmig version=3-2
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARMCD    type=Char label="Planned Arm Code"
col ARM      type=Char label="Description of Planned Arm"
---
S1 | DM | 001 | SCRNFAIL | Screen Failure
S1 | DM | 002 | A        | Drug A
---

dataset IE label="Inclusion/Exclusion Criteria Not Met"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IESEQ    type=Num  label="Sequence Number"
col IETESTCD type=Char label="Inclusion/Exclusion Criterion Short Name"
col IEORRES  type=Char label="I/E Criterion Original Result"
---
