#!RuleTest
#test CDISC-AD0041 expect=noViolation domain=ADLBC
# Rule:Description: A numeric variable with a suffix of DT does not have a date format
#note "ADT is Char (data_type != Num) -> noViolation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ADT type=Char
---
CDISCPILOT01 | 01-701-1015 | ALB | x
---
