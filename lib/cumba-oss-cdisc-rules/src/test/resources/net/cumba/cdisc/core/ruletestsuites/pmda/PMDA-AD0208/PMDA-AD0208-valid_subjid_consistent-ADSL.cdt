#!RuleTest
#test PMDA-AD0208 expect=noViolation domain=ADSL
#note "Row 1: SUBJID 1015 == DM.SUBJID 1015 -> silent. Row 2: SUBJID EMPTY while DM.SUBJID=1023 -> the authored `not empty(SUBJID)` conjunct keeps the rule silent (the CDISC-AD0208 twin, which lacks that conjunct, WOULD fire here - AD0208-F1, each rule faithful to its own sheet). Join 1:1, both matched."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col SUBJID  type=Char
---
S1 | 01-701-1015 | 1015
S1 | 01-701-1023 |
---

dataset DM label=Demographics
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col SUBJID  type=Char
---
S1 | DM | 01-701-1015 | 1015
S1 | DM | 01-701-1023 | 1023
