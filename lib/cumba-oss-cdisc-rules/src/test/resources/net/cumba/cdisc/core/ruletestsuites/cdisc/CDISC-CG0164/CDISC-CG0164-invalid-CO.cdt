#!RuleTest
#test CDISC-CG0164 expect=violation domain=CO
#note "row 1: IDVAR populated but RDOMAIN present-and-empty -> fires. Row 2 is conformant."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 IDVAR=AESEQ
dataset CO class="SPECIAL PURPOSE" label="Comments"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col COSEQ    type=Num  label="Sequence Number"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col COVAL    type=Char label="Comment"
---
S1 |    |  | 1 | AESEQ | 1 | Comment on the AE record
S1 | CM |  | 2 | CMSEQ | 3 | Comment on the CM record
