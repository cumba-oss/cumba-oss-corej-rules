#!RuleTest
#test CDISC-SEND-0112.1 expect=violation domain=DM
#note "AGE declared with def:Origin Type=Derived and NO MethodOID on its ItemRef; AGEU not declared in the define (excluded by the applicability term under both rules). Derived AGE with no derivation method -> 1 violation. Green under both the current and the proposed rule."
#library standard=sendig version=3-1-1
#define-xml CDISC-SEND-0112.1-define.xml
#expectViolationCount 1
#expectViolationAt variable_name=AGE
dataset DM
col STUDYID type=Char
col USUBJID type=Char
col AGE     type=Num
col AGEU    type=Char
---
S1 | S1-001 | 56 | WEEKS
