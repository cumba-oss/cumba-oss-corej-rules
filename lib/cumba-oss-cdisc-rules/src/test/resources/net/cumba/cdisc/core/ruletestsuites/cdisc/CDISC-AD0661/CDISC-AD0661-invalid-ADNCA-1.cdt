#!RuleTest
#test CDISC-AD0661 expect=violation domain=ADNCA
# Rule:Description: Raise an error when ADOSEDUR is present but NDOSEDUR or DOSEDURU is not present in an ADNCA v1.0 dataset.
#note "ADOSEDUR present, NDOSEDUR absent (DOSEDURU present) -> violation"
#expectViolationCount 1
#expectViolationAt ADOSEDUR=24 DOSEDURU=HOURS
dataset ADNCA
col STUDYID type=Char
col USUBJID type=Char
col ADOSEDUR type=Num
col DOSEDURU type=Char
col PARAMCD type=Char
col NFRLT type=Num
col AFRLT type=Num
---
CDISCPILOT01 | 01-701-1015 | 24 | HOURS | CONC | 0 | 0.5
---
