#!RuleTest
#test CDISC-AD0133 expect=violation domain=ADLBC
# Rule:Description: R2AyLO is not equal to AVAL divided by AyLO
#note "R2A1LO=9 but AVAL/A1LO = 10/2 = 5 -> violation"
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL type=Num
col A1LO type=Num
col R2A1LO type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | 10 | 2 | 9
---
