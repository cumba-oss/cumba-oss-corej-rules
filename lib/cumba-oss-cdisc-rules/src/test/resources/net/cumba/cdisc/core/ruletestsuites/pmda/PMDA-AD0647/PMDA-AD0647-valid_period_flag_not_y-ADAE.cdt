#!RuleTest
#test PMDA-AD0647 expect=noViolation domain=ADAE
#note "Pins the value() == 'Y' conjunct: the requirement is one-directional - a period flag that is N or blank says nothing about the overall flag, so an overall N is conformant. This is the fixture that would catch an inverted implication."
#library standard=adamig version=1-3
dataset ADAE structure=OCCDS subclass=AE
col STUDYID  type=Char
col USUBJID  type=Char
col ASEQ     type=Num
col AEDECOD  type=Char
col TREM01FL type=Char
col TRTEMFL  type=Char
---
CDISCPILOT01 | 01-701-1015 | 1 | HEADACHE | N | N
CDISCPILOT01 | 01-701-1015 | 2 | NAUSEA   |   | N
