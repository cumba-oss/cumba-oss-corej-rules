#!RuleTest
#test FDA-SD1401 expect=noViolation domain=AG
#note "All agent start dates are on or before DM.RFCENDTC -> no violation."
#library standard=sendig version=ar-1-0
dataset AG class=INTERVENTIONS label="Procedure Agents"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AGSEQ   type=Num  label="Sequence Number"
col AGTRT   type=Char label="Reported Name of Agent"
col AGSTDTC type=Char label="Start Date/Time of Agent"
---
S1 | AG | 001 | 1 | OVALBUMIN | 2020-01-05
S1 | AG | 001 | 2 | OVALBUMIN | 2020-01-20
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFCENDTC type=Char label="Date/Time of Last Challenge Agent Admin"
---
S1 | DM | 001 | 2020-01-20
---
