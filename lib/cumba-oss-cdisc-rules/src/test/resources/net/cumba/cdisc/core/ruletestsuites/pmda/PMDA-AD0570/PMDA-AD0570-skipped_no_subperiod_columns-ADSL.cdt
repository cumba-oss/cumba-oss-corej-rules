#!RuleTest
#test PMDA-AD0570 expect=skipped domain=ADSL
#note "Wildcard seed contract: TRT01P alone carries only {xx}, never {xx,w}, so no PxxSw* pattern seeds. expand() returns empty -> NoMatch -> SKIPPED, the rule never executes."
#library standard=adamig version=1-3
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRT01P  type=Char
