#!RuleTest
#test PMDA-SD1103 expect=noViolation domain=CE
#note "The DIRECTION discriminator: the rule conditions on CESTRTPT being present, so CESTTPT-without-CESTRTPT must NOT fire (first conjunct false)."
#library standard=sdtmig version=3-4
dataset CE class=EVENTS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col CESEQ    type=Num
col CESTTPT  type=Char
---
S1 | CE | 001 | 1 | SCREENING
