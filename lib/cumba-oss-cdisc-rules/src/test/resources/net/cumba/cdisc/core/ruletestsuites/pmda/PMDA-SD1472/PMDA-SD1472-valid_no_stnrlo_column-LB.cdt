#!RuleTest
#test PMDA-SD1472 expect=noViolation domain=LB
#note "LBSTNRLO column absent -- `empty(--STNRLO)` over the absent column broadcast-folds TRUE, its negation FALSE, and the AND short-circuits -> noViolation WITH execution (no Requirements.Variables block on this rule, so no skip)."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID   type=Char
col DOMAIN    type=Char
col USUBJID   type=Char
col LBSEQ     type=Num
col LBTESTCD  type=Char
col LBORRES   type=Char
---
S1 | LB | 001 | 1 | GLUC | POSITIVE
