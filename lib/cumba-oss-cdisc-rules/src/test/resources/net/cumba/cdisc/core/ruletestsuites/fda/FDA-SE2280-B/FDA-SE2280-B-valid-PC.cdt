#!RuleTest
#test FDA-SE2280-B expect=noViolation domain=PC
#note "The pre-dose sample is correctly anchored at PCELTM='PT0H'; the later samples carry positive elapsed times and row 4 leaves PCELTM empty."
#library standard=sendig version=3-1-1
dataset PC class=FINDINGS label="Pharmacokinetics Concentrations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PCSEQ    type=Num  label="Sequence Number"
col PCTESTCD type=Char label="Test Short Name"
col PCELTM   type=Char label="Planned Elapsed Time from Time Point Ref"
col PCTPTREF type=Char label="Time Point Reference"
---
STUDY01 | PC | 001 | 1 | DRUGX | PT0H  | DOSE ADMINISTRATION
STUDY01 | PC | 001 | 2 | DRUGX | PT30M | DOSE ADMINISTRATION
STUDY01 | PC | 001 | 3 | DRUGX | PT8H  | DOSE ADMINISTRATION
STUDY01 | PC | 001 | 4 | DRUGX |       | DOSE ADMINISTRATION
