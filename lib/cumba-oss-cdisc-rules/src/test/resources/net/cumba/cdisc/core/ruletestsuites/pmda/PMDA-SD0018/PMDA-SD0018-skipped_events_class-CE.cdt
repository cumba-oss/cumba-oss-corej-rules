#!RuleTest
#test PMDA-SD0018 expect=skipped domain=CE
#note "EVENTS is outside the sheet's Classes.Include [FINDINGS, FINDINGS ABOUT]. CETESTCD is violating-shaped (9 characters) so the skip is auditable: the rule never even reaches the value."
#library standard=sdtmig version=3-4
dataset CE class=EVENTS label="Clinical Events"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col CESEQ    type=Num  label="Sequence Number"
col CETERM   type=Char label="Reported Term for the Clinical Event"
col CETESTCD type=Char label="Clinical Event Short Name"
---
S1 | CE | 001 | 1 | RASH | GLUCOSE01
