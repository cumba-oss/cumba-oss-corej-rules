#!RuleTest
#test FDA-SD1047 expect=noViolation domain=EX
#note "Row 1 records a numeric dose only, row 2 a dose description only, row 3 neither -> 'Only one of Dose (--DOSE) or Dose Description (--DOSTXT) variables must be populated on the same record'."
#library standard=sdtmig version=3-4
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXDOSE  type=Num  label="Dose per Administration"
col EXDOSTXT type=Char label="Dose Description"
---
CDISCPILOT01 | EX | 01-701-1015 | 1 | DRUG A | 54 |
CDISCPILOT01 | EX | 01-701-1015 | 2 | DRUG A |    | 50-100 mg
CDISCPILOT01 | EX | 01-701-1023 | 1 | DRUG A |    |
