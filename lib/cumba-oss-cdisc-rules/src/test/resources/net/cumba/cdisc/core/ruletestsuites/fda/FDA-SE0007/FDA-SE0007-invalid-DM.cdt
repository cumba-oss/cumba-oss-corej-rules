#!RuleTest
#test FDA-SE0007 expect=violation domain=DM
#note "The study inventory holds only DM; the Trial Sets (TX) dataset is absent -> TX dataset should be included in every SEND submission -> the Domain Presence Check fires."
#library standard=sendig version=3-1-1
#expectViolationCount 1
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col SETCD   type=Char label="Set Code"
---
STUDY01 | DM | STUDY01-001 | 001 | SET1
