#!RuleTest
#test CDISC-AD0710 expect=noViolation domain=ADLBC
# Rule:Description: A variable with a suffix of RFL has a value that is not Y, N, or null
#note "MYRFL empty (null) -> non_empty false -> noViolation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col MYRFL type=Char
