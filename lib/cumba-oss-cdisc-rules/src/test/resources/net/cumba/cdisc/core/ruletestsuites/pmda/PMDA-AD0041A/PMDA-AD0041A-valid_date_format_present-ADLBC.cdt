#!RuleTest
#test PMDA-AD0041A expect=noViolation domain=ADLBC
#note "ADT is declared format=DATE9. The rule tests only that SOME format is declared - whether the format is a VALID date format is PMDA-AD0041's job - so any non-empty format silences it."
#library standard=adamig version=1-3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ADT     type=Num format=DATE9.
---
S1 | 001 | ALB | 22000
---
