#!RuleTest
#test CDISC-AD0493 expect=violation domain=ADLBC
# Rule:Description: ANLzzFL is equal to "N" where zz is a zero-padded two-digit integer [01-99]
#note "ANL01FL="N" -> equal_to N -> violation"
#expectViolationCount 1
#expectViolationAt row=1
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ANL01FL type=Char
---
CDISCPILOT01 | 01-701-1015 | ALB | N
---
