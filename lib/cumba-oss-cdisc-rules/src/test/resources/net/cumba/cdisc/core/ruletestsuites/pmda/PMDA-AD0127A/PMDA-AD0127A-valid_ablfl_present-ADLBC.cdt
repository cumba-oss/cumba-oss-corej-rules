#!RuleTest
#test PMDA-AD0127A expect=noViolation domain=ADLBC
#note "Isolates the not var_exists(\"ABLFL\") conjunct: BASE is present but so is ABLFL, so the baseline flag the rule demands is there and the rule executes without firing."
#library standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col BASE    type=Num
col ABLFL   type=Char
---
CDISCPILOT01 | 01-701-1015 | ALT | 2.5 | 1.5 | Y
CDISCPILOT01 | 01-701-1023 | ALT | 7.0 | 7.0 | N
