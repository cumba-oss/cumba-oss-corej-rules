#!RuleTest
#test CDISC-SEND-0224 expect=violation domain=DM
#note "THE CROSSED-PAIR PIN (Fix #293 / M3-D14). ARMCD='B' and ARM='Arm A' are BOTH present in TA, but on DIFFERENT TA records, so the PAIR matches nothing -- a subject assigned to the wrong arm, which is exactly what the sheet's trailing clause 'for a given TA record' exists to catch. Before M3-D14 the Check tested two SEPARATE flat `distinct` sets, `ARM not in $ta_arm or ARMCD not in $ta_armcd`, and both memberships hold here, so the rule was SILENT. The repair replaces the two column-wise operations with one composite `distinct(names=[ARMCD, ARM])` and a `tuple(ARMCD, ARM) not in ...` membership, the shape CDISC-SEND-0333 already ships."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=004 ARMCD=B
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col SEX     type=Char label="Sex"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
---
S1 | DM | 004 | 004 | F | B | Arm A
---

dataset TA label="Trial Arms"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
col TAETORD type=Num  label="Order of Element within Arm"
col ETCD    type=Char label="Element Code"
col ELEMENT type=Char label="Description of Element"
---
S1 | TA | A | Arm A | 1 | SCRN | Screening
S1 | TA | B | Arm B | 1 | SCRN | Screening
---
