#!RuleTest
#test CDISC-SEND-9430 expect=violation domain=LB
# Rule:Description: CDISC-SEND-9430 — the Required key LBTESTCD is not populated.
#note "LBTESTCD blank -> violation; the twin scenario differs only in the value of LBTESTCD."
#library standard=sendig version=3-1-1
#expectViolationCount 1
dataset LB
col STUDYID type=Char
col DOMAIN type=Char
col USUBJID type=Char
col LBSEQ type=Char
col LBTESTCD type=Char
col LBTEST type=Char
---
S1      | LB     | S1-001  | 1     |          | Albumin
---
