#!RuleTest
#test FDA-SD1452 expect=noViolation domain=EX
#note "Boundary: EXVAMT=0 is explicitly permitted ('must be greater than or equal to 0'), and a missing EXVAMT is out of the condition -> no violation."
#library standard=sdtmig version=3-4
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Actual Treatment"
col EXVAMT  type=Num  label="Amount Administered"
col EXVAMTU type=Char label="Amount Administered Units"
---
S1 | EX | 001 | 1 | DRUG A | 5 | mL
S1 | EX | 001 | 2 | DRUG A | 0 | mL
S1 | EX | 001 | 3 | DRUG A | . | mL
