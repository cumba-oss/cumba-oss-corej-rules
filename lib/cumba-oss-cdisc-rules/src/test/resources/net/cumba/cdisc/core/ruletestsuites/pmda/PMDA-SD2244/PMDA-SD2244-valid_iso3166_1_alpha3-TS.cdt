#!RuleTest
#test PMDA-SD2244 expect=noViolation domain=TS
#note "Second permitted value, authored separately so neither allow-list branch can hide behind the other. The value contains spaces; that is fine in a DATA cell (fields are split on '|', not on whitespace) - only #expectViolationAt pins need quoting, and this fixture has none."
#library standard=sdtmig version=3-4
dataset TS label="Trial Summary"
col STUDYID  type=Char
col DOMAIN   type=Char
col TSSEQ    type=Num
col TSPARMCD type=Char
col TSPARM   type=Char
col TSVAL    type=Char
col TSVALCD  type=Char
col TSVCDREF type=Char
---
S1 | TS | 1 | FCNTRY | Planned Country of Investigational Sites | USA | USA | ISO 3166-1 alpha-3
