#!RuleTest
#test PMDA-AD0586 expect=violation domain=ADLBC
#note "((BASE-AVAL)/AVAL)*100 = ((120-100)/100)*100 = 20, and PBCHG is 99, so the row fires. THE OPERAND ORDER IS THE POINT: the divisor is AVAL, not BASE."
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015 PBCHG=99 BASE=120 AVAL=100
#library standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col BASE    type=Num
col AVAL    type=Num
col PBCHG   type=Num
---
CDISCPILOT01 | 01-701-1015 | GLUC | 120 | 100 | 99
