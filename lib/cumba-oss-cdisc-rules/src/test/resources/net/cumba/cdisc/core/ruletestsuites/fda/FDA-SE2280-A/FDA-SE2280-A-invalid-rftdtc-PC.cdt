#!RuleTest
#test FDA-SE2280-A expect=violation domain=PC
#note "Row 1: PCELTM populated, PCDTC has a time component but PCRFTDTC is date-only -> fires via the PCRFTDTC branch."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 PCSEQ=1
dataset PC class=FINDINGS label="Pharmacokinetics Concentrations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PCSEQ    type=Num  label="Sequence Number"
col PCELTM   type=Char label="Planned Elapsed Time from Time Point Ref"
col PCDTC    type=Char label="Date/Time of Specimen Collection"
col PCRFTDTC type=Char label="Date/Time of Reference Point"
---
S1 | PC | 001 | 1 | PT1H | 2023-06-02T09:00 | 2023-06-02
S1 | PC | 001 | 2 | PT2H | 2023-06-02T10:00 | 2023-06-02T07:00
