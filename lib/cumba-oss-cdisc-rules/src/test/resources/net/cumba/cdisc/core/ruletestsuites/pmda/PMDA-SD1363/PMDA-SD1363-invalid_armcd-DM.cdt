#!RuleTest
#test PMDA-SD1363 expect=violation domain=DM
#note "any-branch 1: a screen-failure subject (ARMNRS='SCREEN FAILURE') has a populated ARMCD -> fires on row 1. Row 2 is the conformant twin."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 ARMCD=A
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
col ARMNRS  type=Char label="Reason Arm and/or Actual Arm is Null"
---
CDISCPILOT01 | DM | 01-701-1015 | A |  | SCREEN FAILURE
CDISCPILOT01 | DM | 01-701-1023 |   |  | SCREEN FAILURE
