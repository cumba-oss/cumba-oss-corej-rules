#!RuleTest
#test PMDA-AD0253 expect=violation domain=ADAE
#note "Fix #247 split-key arm - the accepted behaviour change of plan section 9.1, asserted so it is not a surprise: the re-authoring deliberately drops the shipped rule's three non_empty guards (keeping them would flip Sensitivity to RECORD and lose the one-finding constraint), so an AE row with a blank USUBJID contributes its tuple and appears in the missing list. Arguably correct - a malformed AE row genuinely is untraceable."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 "$untraceable_ae_keys"="[[CDISCPILOT01, , 1]]"
dataset ADAE label="Adverse Events Analysis Dataset"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESEQ   type=Num  label="Sequence Number"
---
CDISCPILOT01 | 01-701-1015 | HEADACHE | 1
---

dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESEQ   type=Num  label="Sequence Number"
---
CDISCPILOT01 | AE | 01-701-1015 | HEADACHE | 1
CDISCPILOT01 | AE |             | RASH     | 1
---
