#!RuleTest
#test PMDA-AD0133 expect=violation domain=ADLBC
#note "Expected 10/2=5, holds 9 -> fires. The y placeholder expands to 1 from the two concrete columns."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015 AVAL=10 A1LO=2 R2A1LO=9
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col A1LO    type=Num
col R2A1LO  type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | 10 | 2 | 9
CDISCPILOT01 | 01-701-1023 | ALB | 10 | 2 | 5
---
