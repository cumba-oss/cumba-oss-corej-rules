#!RuleTest
#test FDA-SD2007 expect=violation domain=AE
#note "AEPTCD 1234567 is not a Preferred Term code of the (dummy) MedDRA dictionary -> fires on row 2; row 1 is a valid PT code."
#library standard=sdtmig version=3-4
#dictionaries dummy
#expectViolationCount 1
#expectViolationAt row=2 AEPTCD=1234567
dataset AE
col USUBJID type=Char
col AEDECOD type=Char
col AEPTCD  type=Num
---
001 | Headache | 10019211
001 | Nausea   | 1234567
