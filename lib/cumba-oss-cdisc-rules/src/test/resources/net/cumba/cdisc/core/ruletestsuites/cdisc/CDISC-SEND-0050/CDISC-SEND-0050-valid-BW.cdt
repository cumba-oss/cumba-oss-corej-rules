#!RuleTest
#test CDISC-SEND-0050 expect=noViolation domain=BW
#note "Same library block; the define CodeList now carries <Alias Context=nci:ExtCodeID Name=C90001> -> var_ccode(DEFINE) non-empty -> silent."
#library standard=sendig version=3-1-1
#library variable-metadata BW BWTESTCD name=BWTESTCD codelist=C90001
#library variable-metadata BW USUBJID name=USUBJID
#define-xml CDISC-SEND-0050-valid-define.xml
dataset BW
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col BWSEQ    type=Num
col BWTESTCD type=Char
---
S1 | BW | 001 | 1 | BW
