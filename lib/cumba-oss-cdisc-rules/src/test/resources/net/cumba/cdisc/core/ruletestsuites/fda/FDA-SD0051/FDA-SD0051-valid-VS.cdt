#!RuleTest
#test FDA-SD0051 expect=noViolation domain=VS
#note "Each VISITNUM carries exactly one VISIT name; two different visit numbers legitimately carry two different names."
#library standard=sdtmig version=3-4
dataset VS class=FINDINGS label="Vital Signs"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VSSEQ    type=Num  label="Sequence Number"
col VSTESTCD type=Char label="Vital Signs Test Short Name"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
S1 | VS | 001 | 1 | SYSBP | 1 | SCREENING
S1 | VS | 002 | 1 | SYSBP | 1 | SCREENING
S1 | VS | 001 | 2 | SYSBP | 2 | WEEK 2
