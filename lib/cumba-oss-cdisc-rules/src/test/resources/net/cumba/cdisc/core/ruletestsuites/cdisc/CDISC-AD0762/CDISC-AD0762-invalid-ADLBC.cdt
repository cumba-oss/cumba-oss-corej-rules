#!RuleTest
#test CDISC-AD0762 expect=violation domain=ADLBC
# Rule:Description: There is more than one value of TRTPGy for a given value of TRTPGyN, where y is an integer [1-99, not zero-padded], considering only those rows on which both variables are populated
#note "TRTPG1N=1 maps to two distinct TRTPG1 -> violation"
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015
#expectViolationAt row=2 USUBJID=01-701-1023
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col TRTPG1 type=Char
col TRTPG1N type=Num
---
CDISCPILOT01 | 01-701-1015 | GLUC | GROUP A | 1
CDISCPILOT01 | 01-701-1023 | GLUC | GROUP B | 1
---
