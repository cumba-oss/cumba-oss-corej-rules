#!RuleTest
#test FDA-SD0029 expect=violation domain=LB
#note "LBSTRESU is not present in the dataset while numeric standardised results are reported -> standard units are missing for both rows. Encodes the column-absent case: the Check carries a bare empty(--STRESU) leaf, which under absent = all-missing (EC-43) is TRUE on every row of a column that is not there. Plan B phase 4d' deleted the redundant not var_exists(--STRESU) disjunct that used to spell this out; the verdict is unchanged."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 LBSTRESC=5.5
#expectViolationAt row=2 LBSTRESC=40
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBSTRESC type=Char label="Character Result/Finding in Std Format"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | GLUC | 5.5
CDISCPILOT01 | LB | 01-701-1015 | 2 | ALB  | 40
