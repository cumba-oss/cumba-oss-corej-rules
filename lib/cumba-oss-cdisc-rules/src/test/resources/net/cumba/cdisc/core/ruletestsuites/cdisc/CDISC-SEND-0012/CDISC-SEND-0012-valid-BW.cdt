#!RuleTest
#test CDISC-SEND-0012 expect=noViolation domain=BW
#note "Every variable the SENDIG declares Required for BW is present in the dataset -> conformant. This rule tests PRESENCE only; the empty BWTESTCD on row 2 is CDISC-SEND-0012-A's business, not this rule's."
#library standard=sendig version=3-1-1
#library required-variables BW STUDYID DOMAIN USUBJID BWSEQ BWTESTCD
dataset BW label="Body Weight"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col BWSEQ    type=Num  label="Sequence Number"
col BWTESTCD type=Char label="Body Weight Test Short Name"
---
S1 | BW | 001 | 1 | BW
S1 | BW | 001 | 2 |
