#!RuleTest
#test PMDA-AD0366 expect=skipped domain=ADLBC
#note "RANDFL present with no RANDDT would fire if in scope; the [SLAD, DEVICE LEVEL ANALYSIS DATASET] block rejects plain BDS -> skip. No SPDEVID column (its presence would refine BDS to MDBDS, still out of scope, but keep the pin single-cause)."
#library standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col RANDFL  type=Char
---
S1 | 001 | GLUC | 100 | Y
