#!RuleTest
#test PMDA-AD0135B expect=violation domain=ADLBC
#note "Wildcard y=1 (SHIFT1/SHIFT1N, single index). Dependent SHIFT1, key SHIFT1N, within=PARAMCD. All rows PARAMCD=SYSBP -> one group. Key 2 carries two distinct dependents, so both rows holding it fire; key 1 carries one."
#library standard=adamig version=1-3
#expectViolationCount 2
#expectViolationAt row=1 PARAMCD=SYSBP SHIFT1=NORMALTOHIGH SHIFT1N=2
#expectViolationAt row=2 PARAMCD=SYSBP SHIFT1=LOWTONORMAL SHIFT1N=2
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col SHIFT1  type=Char
col SHIFT1N type=Num
---
CDISCPILOT01 | 01-701-1015 | SYSBP | NORMALTOHIGH   | 2
CDISCPILOT01 | 01-701-1023 | SYSBP | LOWTONORMAL    | 2
CDISCPILOT01 | 01-701-1034 | SYSBP | NORMALTONORMAL | 1
