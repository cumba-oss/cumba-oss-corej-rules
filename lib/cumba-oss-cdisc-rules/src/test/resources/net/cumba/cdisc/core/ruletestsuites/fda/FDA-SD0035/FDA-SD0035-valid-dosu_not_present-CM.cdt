#!RuleTest
#test FDA-SD0035 expect=skipped domain=CM
#note "Boundary for the Requirements.Variables gate: CMDOSU is not in the dataset at all, so the rule is skipped (present-but-empty semantics per the guard matrix; both engines report nothing) even though CMDOSE is provided -> no violation."
#library standard=sdtmig version=3-4
dataset CM class=INTERVENTIONS label="Concomitant Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ   type=Num  label="Sequence Number"
col CMTRT   type=Char label="Reported Name of Drug, Med, or Therapy"
col CMDOSE  type=Num  label="Dose per Administration"
---
S1 | CM | 001 | 1 | ASPIRIN | 100
