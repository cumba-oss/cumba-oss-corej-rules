#!RuleTest
#test PMDA-AD0282A expect=noViolation domain=ADAE
#note "Negative control on the same header and columns: ASEV is populated on every one of the three rows, so the rule executes and finds nothing."
#library standard=adamig version=1-0
dataset ADAE structure=OCCDS
col STUDYID type=Char
col USUBJID type=Char
col AEDECOD type=Char
col ASEV    type=Char
---
CDISCPILOT01 | 01-701-1015 | HEADACHE | MILD
CDISCPILOT01 | 01-701-1023 | NAUSEA | MODERATE
CDISCPILOT01 | 01-701-1034 | RASH | SEVERE
