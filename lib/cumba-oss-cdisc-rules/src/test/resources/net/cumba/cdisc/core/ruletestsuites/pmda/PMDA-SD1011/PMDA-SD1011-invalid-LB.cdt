#!RuleTest
#test PMDA-SD1011 expect=violation domain=LB
#note "Row 2 records the planned elapsed time as '30 min' instead of the ISO 8601 duration 'PT30M'. The offending cell value contains a SPACE, so the pin stays row= only, exactly as the twin's backfilled shape. ADAPTED-FROM fda/FDA-SD1011/FDA-SD1011-invalid-LB.cdt (data verbatim)."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBELTM   type=Char label="Planned Elapsed Time from Time Point Ref"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | ALB  | PT1H
CDISCPILOT01 | LB | 01-701-1015 | 2 | GLUC | 30 min
