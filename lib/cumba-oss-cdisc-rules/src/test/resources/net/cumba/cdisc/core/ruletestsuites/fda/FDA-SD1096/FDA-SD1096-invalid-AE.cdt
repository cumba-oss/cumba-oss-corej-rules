#!RuleTest
#test FDA-SD1096 expect=violation domain=AE
#note "CL-A A.9 (wave TA-4): the sheet's assumption is that a truncated value is EXACTLY 200 characters, so >= became ==. Row 1 at exactly 200 fires. Row 2 at 250 characters is proof the transport limit did not bite and no longer fires. Row 3 at 199 is below the limit."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 AESEQ=1
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
---
