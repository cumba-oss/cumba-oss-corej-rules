#!RuleTest
#test PMDA-AD0311B expect=violation domain=ADAE
#note "KEY=SMQ01SC (2nd arg), DEPENDENT=SMQ01SCN (1st arg): key BROAD carries {1,2} -> rows 1,3 fire; key NARROW is single-valued. Record granularity -> 2 violations."
#library standard=adamig version=1-3
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015 SMQ01SC=BROAD SMQ01SCN=1
#expectViolationAt row=3 USUBJID=01-701-1034 SMQ01SC=BROAD SMQ01SCN=2
dataset ADAE structure=OCCDS subclass=AE
col STUDYID  type=Char
col USUBJID  type=Char
col AESEQ    type=Num
col AEDECOD  type=Char
col SMQ01SC  type=Char
col SMQ01SCN type=Num
---
CDISCPILOT01 | 01-701-1015 | 1 | HEADACHE | BROAD  | 1
CDISCPILOT01 | 01-701-1023 | 1 | NAUSEA   | NARROW | 1
CDISCPILOT01 | 01-701-1034 | 2 | RASH     | BROAD  | 2
