#!RuleTest
#test FDA-SD0092 expect=violation domain=SE
#note "Row 2 represents an unplanned element (ETCD='UNPLAN') but leaves SEUPDES empty -> fires. Row 1 is a planned element; row 3 is a described unplanned element."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 ETCD=UNPLAN SEUPDES=
dataset SE label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ   type=Num  label="Sequence Number"
col ETCD    type=Char label="Element Code"
col SESTDTC type=Char label="Start Date/Time of Element"
col SEUPDES type=Char label="Description of Unplanned Element"
---
S1 | SE | 001 | 1 | SCRN   | 2020-01-01 |
S1 | SE | 001 | 2 | UNPLAN | 2020-01-10 |
S1 | SE | 001 | 3 | UNPLAN | 2020-01-20 | Unplanned washout period
