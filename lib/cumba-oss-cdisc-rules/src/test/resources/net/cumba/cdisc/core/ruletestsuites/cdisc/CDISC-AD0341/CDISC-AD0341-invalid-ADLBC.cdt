#!RuleTest
#test CDISC-AD0341 expect=violation domain=ADLBC
# Rule:Description: Within a parameter, there is more than one value of MCRITyMN for a given value of MCRITyML, considering only those rows on which both variables are populated
#note "within PARAMCD GLUC, MCRIT1ML=G maps to two distinct MCRIT1MN values -> violation"
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015
#expectViolationAt row=2 USUBJID=01-701-1015
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col MCRIT1MN type=Char
col MCRIT1ML type=Char
---
CDISCPILOT01 | 01-701-1015 | GLUC | A1 | G
CDISCPILOT01 | 01-701-1015 | GLUC | A2 | G
---
