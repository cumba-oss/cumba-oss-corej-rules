#!RuleTest
#test PMDA-SD1333 expect=violation domain=AE
#note "AEDUR (Permissible) is not collected at all, so the bare empty(AEDUR) leaf is TRUE on every row (absent = all-missing, EC-43; Plan B phase 4d' deleted the AUTHORED not var_exists(AEDUR) disjunct that used to carry this): row 1 is RECOVERED/RESOLVED with an empty AEENDTC and no duration anywhere -> fires. Adapted verbatim from FDA-SD1333."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 AESEQ=1
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEOUT   type=Char label="Outcome of Adverse Event"
col AEENDTC type=Char label="End Date/Time of Adverse Event"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE | RECOVERED/RESOLVED         |
CDISCPILOT01 | AE | 01-701-1015 | 2 | RASH     | NOT RECOVERED/NOT RESOLVED |
