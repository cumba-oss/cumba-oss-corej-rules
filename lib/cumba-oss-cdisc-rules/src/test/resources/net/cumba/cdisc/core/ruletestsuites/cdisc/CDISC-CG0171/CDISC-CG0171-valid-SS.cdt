#!RuleTest
#test CDISC-CG0171 expect=noViolation domain=SS
#note "Row 1: DEAD with SSDTC equal to DTHDTC -> ok. Row 2: DEAD with SSDTC after DTHDTC -> ok. Row 3: ALIVE with SSDTC before DTHDTC -> condition SSSTRESC='DEAD' not met. Row 4: DEAD with SSDTC empty -> no target, no fire. Row 5: DEAD subject with empty DTHDTC -> no comparand, no fire."
#library standard=sdtmig version=3-4
dataset SS class=FINDINGS label="Subject Status"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SSSEQ    type=Num  label="Sequence Number"
col SSTESTCD type=Char label="Subject Status Short Name"
col SSSTRESC type=Char label="Character Result/Finding in Std Format"
col SSDTC    type=Char label="Date/Time of Assessment"
---
S1 | SS | 001 | 1 | SURVSTAT | DEAD  | 2020-05-10
S1 | SS | 001 | 2 | SURVSTAT | DEAD  | 2020-05-11
S1 | SS | 002 | 1 | SURVSTAT | ALIVE | 2020-01-01
S1 | SS | 001 | 3 | SURVSTAT | DEAD  |
S1 | SS | 003 | 1 | SURVSTAT | DEAD  | 2020-04-01
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DTHDTC  type=Char label="Date/Time of Death"
---
S1 | DM | 001 | 2020-05-10
S1 | DM | 002 | 2020-05-10
S1 | DM | 003 |
---
