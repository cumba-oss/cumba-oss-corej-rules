#!RuleTest
#test FDA-SD1418 expect=violation domain=AC
#note "CAGTCAT has ACVAL 'BIOLOGICAL' but AC carries no ACPARMCD='BAMBSSDS' record. FDA: \"'Bio Ag Master Bank/Seed Stock Dir Supp' (BAMBSSDS) record is expected in the Challenge Agent Characterization (AC) domain when the Parameter Value (ACVAL) for the 'Challenge Agent Category' (CAGTCAT) parameter is 'BIOLOGICAL'.\" -> the rule must fire exactly once for the dataset."
#library standard=sendig version=ar-1-0
#expectViolationCount 1
dataset AC label="Challenge Agent Characterization"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col ACSEQ    type=Num  label="Sequence Number"
col ACPARMCD type=Char label="Challenge Agent Parameter Short Name"
col ACPARM   type=Char label="Challenge Agent Parameter"
col ACVAL    type=Char label="Parameter Value"
---
S1 | AC | 1 | CAGTCAT | Challenge Agent Category | BIOLOGICAL
S1 | AC | 2 | MCSCTIND | Multiple Challenge Agent Same Cat Ind | N
