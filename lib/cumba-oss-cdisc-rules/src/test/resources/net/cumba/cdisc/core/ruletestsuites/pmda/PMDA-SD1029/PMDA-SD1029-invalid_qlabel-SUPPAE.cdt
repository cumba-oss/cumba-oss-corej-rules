#!RuleTest
#test PMDA-SD1029 expect=violation domain=SUPPAE
#note "FRESH. Pins two things the twin covers nowhere: the THIRD Scope.Classes token (RELATIONSHIP -- the twin only reaches FINDINGS and TRIAL DESIGN), and the QLABEL alternative of the varname() regex, which is one of the two literal names in it (QNAM / QLABEL) rather than a --TEST/--PARM pattern. Row 2 QLABEL carries U+2265 GREATER-THAN OR EQUAL TO, outside printable ASCII, so it fires; QNAM on row 2 is deliberately plain ASCII so exactly one cell fires."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 variable_name=QLABEL
dataset SUPPAE class=RELATIONSHIP label="Supplemental Qualifiers for AE"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM     type=Char label="Qualifier Variable Name"
col QLABEL   type=Char label="Qualifier Variable Label"
col QVAL     type=Char label="Data Value"
---
CDISCPILOT01 | AE | 01-701-1015 | AESEQ | 1 | AETRTEM | Treatment Emergent Flag | Y
CDISCPILOT01 | AE | 01-701-1015 | AESEQ | 2 | AESEV2  | Severity ≥ Grade 3      | Y
