#!RuleTest
#test PMDA-SD1354 expect=violation domain=TA
#note "FRESH, DISCRIMINATING - DM present with ZERO rows. distinct's EmptyResult is SET: dm_armcd is the EMPTY set, so every populated TA.ARMCD is 'not in' it and fires; the blank-ARMCD row stays guarded. If this reports 0 violations, escalate (would mean an empty distinct saturates membership)."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 ARMCD=PBO
#expectViolationAt row=2 ARMCD=XANLO
dataset TA label="Trial Arms"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col ARMCD    type=Char label="Planned Arm Code"
col ARM      type=Char label="Description of Planned Arm"
col TAETORD  type=Num  label="Planned Order of Element within Arm"
col ETCD     type=Char label="Element Code"
col EPOCH    type=Char label="Epoch"
---
CDISCPILOT01 | TA | PBO   | Placebo        | 1 | SCRN | SCREENING
CDISCPILOT01 | TA | XANLO | Xanomeline Low | 1 | TRT  | TREATMENT
CDISCPILOT01 | TA |       |                | 1 | FUP  | FOLLOW-UP
---

dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARMCD    type=Char label="Planned Arm Code"
col ARM      type=Char label="Description of Planned Arm"
---
---
