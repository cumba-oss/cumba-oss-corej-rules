#!RuleTest
#test FDA-SD1259 expect=noViolation domain=DM
#note "SETCD at the 8-character boundary (row 2) is conformant; shorter and empty values never fire."
#library standard=sdtmig version=3-4
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SETCD   type=Char label="Set Code"
---
S1 | DM | 001 | GRP1
S1 | DM | 002 | HIGHDOSE
S1 | DM | 003 |
