#!RuleTest
#test FDA-SD0052 expect=noViolation domain=VS
#note "Boundary: one 'WEEK 2' record leaves VISITNUM missing while the others agree on 2. A missing visit number is excluded from the consistency computation."
#library standard=sdtmig version=3-4
dataset VS class=FINDINGS label="Vital Signs"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VSSEQ    type=Num  label="Sequence Number"
col VSTESTCD type=Char label="Vital Signs Test Short Name"
col VISITNUM type=Num  label="Visit Number"
col VISIT    type=Char label="Visit Name"
---
S1 | VS | 001 | 1 | SYSBP | 2 | WEEK 2
S1 | VS | 002 | 1 | SYSBP | . | WEEK 2
S1 | VS | 003 | 1 | SYSBP | 2 | WEEK 2
