#!RuleTest
#test PMDA-AD0348 expect=violation domain=ADLBC
#note "Mirror of AD0347: the target is the CHARACTER A1LOC and the key is (PARAMCD, A1LO). Group (ALB, 10) holds {LOWNORMAL x2, BELOWNORMAL x1} -> row 3 is the minority."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 A1LOC=BELOWNORMAL A1LO=10 PARAMCD=ALB
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col A1LO    type=Num
col A1LOC   type=Char
---
S1 | 001 | ALB | 10 | LOWNORMAL
S1 | 002 | ALB | 10 | LOWNORMAL
S1 | 003 | ALB | 10 | BELOWNORMAL
S1 | 004 | ALB | 12 | MARGINAL
S1 | 005 | ALB | 12 | MARGINAL
