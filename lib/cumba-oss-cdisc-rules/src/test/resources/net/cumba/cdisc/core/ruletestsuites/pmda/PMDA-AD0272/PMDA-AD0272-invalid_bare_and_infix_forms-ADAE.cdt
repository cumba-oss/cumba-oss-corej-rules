#!RuleTest
#test PMDA-AD0272 expect=violation domain=ADAE
#note "Pins the breadth of .*: AOCCFL matches with a zero-width infix and AOCCPIFL with a two-letter one - both real ADaM OCCDS occurrence-flag variables. Neither would be reported by the CDISC sibling's ^AOCC\\d{2}FL$ (finding AD0272-F1, filed and not ported). Two cells fire on one row."
#library standard=adamig version=1-3
#expectViolationCount 2
#expectViolationAt row=1 variable_name=AOCCFL USUBJID=01-701-1015
#expectViolationAt row=1 variable_name=AOCCPIFL USUBJID=01-701-1015
dataset ADAE
col STUDYID  type=Char
col USUBJID  type=Char
col AEDECOD  type=Char
col AOCCFL   type=Char
col AOCCPIFL type=Char
---
CDISCPILOT01 | 01-701-1015 | HEADACHE | N | X
