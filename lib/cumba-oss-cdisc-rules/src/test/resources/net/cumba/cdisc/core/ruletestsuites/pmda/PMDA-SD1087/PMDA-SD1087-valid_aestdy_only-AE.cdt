#!RuleTest
#test PMDA-SD1087 expect=noViolation domain=AE
#note "The DIRECTION discriminator: the rule conditions on AESTDTC being present, so AESTDY-without-AESTDTC must NOT fire (first conjunct false)."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col AESEQ   type=Num
col AESTDY  type=Num
---
S1 | AE | 001 | 1 | 10
