#!RuleTest
#test FDA-SE0057 expect=noViolation domain=BW
#note "Every variable the SEND IG declares Expected for BW is present in the dataset -> conformant."
#library standard=sendig version=3-1-1
#library expected-variables BW BWORRES BWORRESU BWSTRESC
dataset BW label="Body Weight"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col BWSEQ    type=Num  label="Sequence Number"
col BWORRES  type=Char label="Result or Finding in Original Units"
col BWORRESU type=Char label="Original Units"
col BWSTRESC type=Char label="Standardized Result in Character Format"
---
S1 | BW | 001 | 1 | 250 | g | 250
