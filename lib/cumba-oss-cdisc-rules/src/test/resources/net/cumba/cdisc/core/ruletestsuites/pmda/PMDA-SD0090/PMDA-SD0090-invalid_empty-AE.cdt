#!RuleTest
#test PMDA-SD0090 expect=violation domain=AE
#note "Boundary: a fatal outcome with an empty AESDTH does not equal the required 'Y', so the rule must fire (row 1). Row 2 is the conformant fatal event."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 AEOUT=FATAL AESDTH=
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEOUT   type=Char label="Outcome of Adverse Event"
col AESDTH  type=Char label="Results in Death"
---
S1 | AE | 001 | 1 | CARDIAC ARREST | FATAL |
S1 | AE | 002 | 1 | SEPSIS         | FATAL | Y
