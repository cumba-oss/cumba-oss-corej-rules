#!RuleTest
#test PMDA-SD1334 expect=noViolation domain=DM
#note "Sheet: 'RFICDTC should not be after RFSTDTC' (PMDA sheet row 351). Subject 1 consented before the reference start, subject 2 consented on the reference start date (equal is conformant), subject 3 has no informed-consent date."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SUBJID   type=Char label="Subject Identifier for the Study"
col RFSTDTC  type=Char label="Subject Reference Start Date/Time"
col RFICDTC  type=Char label="Date/Time of Informed Consent"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015 | 2020-01-10 | 2020-01-02
CDISCPILOT01 | DM | 01-701-1023 | 1023 | 2020-02-01 | 2020-02-01
CDISCPILOT01 | DM | 01-701-1028 | 1028 | 2020-03-01 |
