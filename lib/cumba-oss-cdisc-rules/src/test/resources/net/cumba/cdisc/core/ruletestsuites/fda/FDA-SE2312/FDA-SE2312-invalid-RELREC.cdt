#!RuleTest
#test FDA-SE2312 expect=violation domain=RELREC
#note "Regression pin for the T1 Scope fix (ERROR lane): RELREC and SUPP-- are included per the sheet, so this RELREC defect fires."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 POOLID=POOL9
dataset RELREC label="Related Records"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col POOLID   type=Char label="Pool Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col RELID    type=Char label="Relationship Identifier"
---
S1 | LB |  | POOL9 | LBSEQ | 1 | REL1
S1 | PC |  | POOL1 | PCSEQ | 1 | REL1
---

dataset POOLDEF label="Pool Definition"
col STUDYID type=Char label="Study Identifier"
col POOLID  type=Char label="Pool Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
---
S1 | POOL1 | 001
S1 | POOL1 | 002
---
