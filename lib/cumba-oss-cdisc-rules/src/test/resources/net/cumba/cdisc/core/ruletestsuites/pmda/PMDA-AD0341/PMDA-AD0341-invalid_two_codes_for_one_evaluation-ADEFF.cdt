#!RuleTest
#test PMDA-AD0341 expect=violation domain=ADEFF
#note "Mirror of AD0340: target is the numeric MCRIT1MN, key is the pair [PARAMCD, MCRIT1ML], guard is not empty(MCRIT1ML). Group (RESP, CR) holds MCRIT1MN {1 x2, 2 x1} -> row 3 is the lone minority. Row 4 carries a different label and stays silent. One expansion (y=1)."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 PARAMCD=RESP MCRIT1ML=CR MCRIT1MN=2
dataset ADEFF
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVAL     type=Num
col MCRIT1ML type=Char
col MCRIT1MN type=Num
---
S1 | 001 | RESP | 1 | CR | 1
S1 | 002 | RESP | 1 | CR | 1
S1 | 003 | RESP | 2 | CR | 2
S1 | 004 | RESP | 2 | PR | 3
