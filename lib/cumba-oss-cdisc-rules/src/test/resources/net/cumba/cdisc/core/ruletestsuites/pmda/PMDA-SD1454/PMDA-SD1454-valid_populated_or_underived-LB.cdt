#!RuleTest
#test PMDA-SD1454 expect=noViolation domain=LB
#note "No row has DRVFL=Y with STREFC empty."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
col LBDRVFL  type=Char
col LBSTREFC type=Char
---
S1 | LB | 001 | 1 | GLUC | Y | NEGATIVE
S1 | LB | 001 | 2 | GLUC | N |
S1 | LB | 001 | 3 | GLUC |   |
