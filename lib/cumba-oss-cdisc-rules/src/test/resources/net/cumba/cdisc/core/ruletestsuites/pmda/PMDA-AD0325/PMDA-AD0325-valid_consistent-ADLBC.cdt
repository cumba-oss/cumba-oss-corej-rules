#!RuleTest
#test PMDA-AD0325 expect=noViolation domain=ADLBC
#note "Row 3 reuses ASPERC=A with a different ASPER but sits in a DIFFERENT PERIOD, so it is a separate group and nothing fires - which pins APERIOD as a real key component."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col APERIOD type=Num
col ASPER   type=Num
col ASPERC  type=Char
---
CDISCPILOT01 | 01-701-1015 | GLUC | 5.5 | 1 | 1 | A
CDISCPILOT01 | 01-701-1023 | GLUC | 5.6 | 1 | 1 | A
CDISCPILOT01 | 01-701-1034 | GLUC | 5.7 | 2 | 1 | A
