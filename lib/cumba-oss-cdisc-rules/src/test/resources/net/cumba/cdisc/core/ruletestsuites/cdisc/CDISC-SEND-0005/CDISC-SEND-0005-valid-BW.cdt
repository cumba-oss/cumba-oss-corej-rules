#!RuleTest
#test CDISC-SEND-0005 expect=noViolation domain=BW
#note "Same library block; define declares only USUBJID and BWTESTCD, both with matching library names -> silent."
#library standard=sendig version=3-1-1
#library variable-metadata BW USUBJID name=USUBJID
#library variable-metadata BW BWTESTCD name=BWTESTCD
#define-xml CDISC-SEND-0005-valid-define.xml
dataset BW
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col BWSEQ    type=Num
col BWTESTCD type=Char
---
S1 | BW | 001 | 1 | BW
