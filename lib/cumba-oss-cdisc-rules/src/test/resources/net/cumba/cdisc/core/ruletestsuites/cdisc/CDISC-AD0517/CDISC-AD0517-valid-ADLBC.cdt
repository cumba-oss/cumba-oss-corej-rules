#!RuleTest
#test CDISC-AD0517 expect=noViolation domain=ADLBC
# Rule:Description: A variable ending in EDTM must contain "End Datetime" in the label
#note "AEDTM label contains "End Datetime" -> noViolation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AEDTM type=Char label="Analysis End Datetime"
---
CDISCPILOT01 | 01-701-1015 | ALB | x
