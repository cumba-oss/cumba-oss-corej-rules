#!RuleTest
#test PMDA-AD0304 expect=noViolation domain=ADAE
#note "All four SMQ01 siblings are declared - NAM, CD, SC and SCN - so every disjunct is false and the rule executes silently. Silent under the rule as shipped AND under the proposed AD0304-F1 form; predicted green."
#library standard=adamig version=1-0
dataset ADAE structure=OCCDS subclass=AE
col STUDYID  type=Char
col USUBJID  type=Char
col AEDECOD  type=Char
col SMQ01NAM type=Char
col SMQ01CD  type=Num
col SMQ01SC  type=Char
col SMQ01SCN type=Num
---
CDISCPILOT01 | 01-701-1015 | HEADACHE | MIGRAINE | 20000105 | NARROW | 1
CDISCPILOT01 | 01-701-1023 | NAUSEA | MIGRAINE | 20000105 | BROAD | 2
