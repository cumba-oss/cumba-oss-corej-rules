#!RuleTest
#test PMDA-AD0227B expect=noViolation domain=ADSL
#note "Row 3 carries TRTSEQP=A-B, so each TRTSEQPN maps to one TRTSEQP."
#library standard=adamig version=1-3
dataset ADSL class=ADSL
col STUDYID  type=Char
col USUBJID  type=Char
col TRTSEQP  type=Char
col TRTSEQPN type=Num
---
S1 | 001 | A-B | 1
S1 | 002 | A-B | 1
S1 | 003 | A-B | 1
S1 | 004 | B-A | 2
S1 | 005 | B-A | 2
