#!RuleTest
#test FDA-SD1282 expect=noViolation domain=PC
#note "Branch 1: PCELTM is present alongside PCTPTREF -> the --ELTM not_exists leaf is false -> no violation."
#library standard=sdtmig version=3-4
dataset PC class=FINDINGS label="Pharmacokinetic Concentrations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PCSEQ    type=Num  label="Sequence Number"
col PCTESTCD type=Char label="Pharmacokinetic Test Short Name"
col PCTPTREF type=Char label="Time Point Reference"
col PCELTM   type=Char label="Planned Elapsed Time from Time Point Ref"
---
CDISCPILOT01 | PC | 01-701-1015 | 1 | DRUGA | DOSE ADMINISTRATION | PT1H
---
