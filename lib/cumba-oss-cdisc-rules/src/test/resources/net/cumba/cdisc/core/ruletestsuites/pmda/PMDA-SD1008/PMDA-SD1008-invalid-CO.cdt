#!RuleTest
#test PMDA-SD1008 expect=violation domain=CO
#note "Row 1 is a comment on a specific parent record (RDOMAIN/IDVAR/IDVARVAL all populated) yet carries a comment date -> fires. Row 2 is a standalone comment, silent."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 IDVAR=AESEQ CODTC=2020-01-15
dataset CO label="Comments"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col COSEQ    type=Num  label="Sequence Number"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col COVAL    type=Char label="Comment"
col CODTC    type=Char label="Date/Time of Comment"
---
CDISCPILOT01 | CO | AE | 01-701-1015 | 1 | AESEQ | 3 | Related to AE 3 | 2020-01-15
CDISCPILOT01 | CO |    | 01-701-1015 | 2 |       |   | General comment | 2020-01-16
