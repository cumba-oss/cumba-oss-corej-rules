#!RuleTest
#test PMDA-AD0476 expect=noViolation domain=ADSL
#note "Each STRATAVN value maps to a single STRATAV value, so no group is inconsistent."
#library standard=adamig version=1-3
dataset ADSL
col STUDYID  type=Char
col USUBJID  type=Char
col STRATAV  type=Char
col STRATAVN type=Num
---
S1 | 001 | HIGH | 1
S1 | 002 | HIGH | 1
S1 | 003 | LOW  | 2
---
