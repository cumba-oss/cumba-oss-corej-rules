#!RuleTest
#test FDA-SE2302 expect=violation domain=TX
#note "SET01 carries the GRPLBL record, SET02 does not -> exactly one group-level finding, for SET02. This also proves the count is grouped by SETCD: a study-wide count would see the SET01 record and never fire."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt SETCD=SET02
dataset TX class="TRIAL DESIGN" label="Trial Sets"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col SETCD    type=Char label="Set Code"
col SET      type=Char label="Set Description"
col TXSEQ    type=Num  label="Sequence Number"
col TXPARMCD type=Char label="Trial Set Parameter Short Name"
col TXPARM   type=Char label="Trial Set Parameter"
col TXVAL    type=Char label="Trial Set Parameter Value"
---
S01 | TX | SET01 | Control | 1 | GRPLBL | Group Label | Control
S01 | TX | SET01 | Control | 2 | ARMCD | Arm Code | CTRL
S01 | TX | SET02 | High Dose | 3 | ARMCD | Arm Code | HD
