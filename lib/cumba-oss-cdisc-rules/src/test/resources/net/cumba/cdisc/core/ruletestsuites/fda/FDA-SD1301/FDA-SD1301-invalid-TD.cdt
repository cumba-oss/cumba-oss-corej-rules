#!RuleTest
#test FDA-SD1301 expect=violation domain=TD
#note "Row 2 TDSTOFF='80Y' omits the ISO 8601 'P' designator; row 3 '-P1D' is negative. TDSTOFF must be 0, a positive ISO 8601 duration, or empty."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=2 TDSTOFF=80Y
#expectViolationAt row=3 TDSTOFF=-P1D
dataset TD class="TRIAL DESIGN" label="Trial Disease Assessments"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TDORDER  type=Num  label="Order of Assessment Schedule"
col TDANCVAR type=Char label="Anchor Variable Name"
col TDSTOFF  type=Char label="Offset from the Anchor"
---
CDISCPILOT01 | TD | 1 | RSSTDTC | P80Y
CDISCPILOT01 | TD | 2 | RSSTDTC | 80Y
CDISCPILOT01 | TD | 3 | RSSTDTC | -P1D
