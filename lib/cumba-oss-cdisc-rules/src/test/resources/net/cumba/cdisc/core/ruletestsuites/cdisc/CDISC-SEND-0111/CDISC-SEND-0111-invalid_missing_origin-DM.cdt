#!RuleTest
#test CDISC-SEND-0111 expect=violation domain=DM
#note "STUDYID/USUBJID carry def:Origin Type=Collected; BRTHDTC declared with NO def:Origin -> origin_type '' is not in [Collected, CRF] -> fires. Green under BOTH the current rule (empty origin) and the proposal."
#library standard=sendig version=3-1-1
#define-xml CDISC-SEND-0111-define.xml
#expectViolationCount 1
#expectViolationAt variable_name=BRTHDTC
dataset DM
col STUDYID type=Char
col USUBJID type=Char
col BRTHDTC type=Char
