#!RuleTest
#test FDA-SD1085 expect=violation domain=LB
#note "Regression pin for the T3 Check fix: the any:[empty, is_incomplete_date] branch fires on the present-but-empty LBDTC while LBDY is populated."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test Short Name"
col LBDTC    type=Char label="Date/Time of Specimen Collection"
col LBDY     type=Num  label="Study Day of Specimen Collection"
---
S1 | LB | 001 | 1 | ALB |  | 5
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
---
S1 | DM | 001 | 2020-01-01
---
