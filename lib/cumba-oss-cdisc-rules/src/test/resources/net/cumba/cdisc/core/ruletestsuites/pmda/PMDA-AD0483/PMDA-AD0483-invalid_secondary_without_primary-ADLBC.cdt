#!RuleTest
#test PMDA-AD0483 expect=violation domain=ADLBC
#note "Also the NUMERIC-ZERO pin (operator-examples E.2: empty is true only for '' and a genuine missing, so a Num cell holding 0 is NOT empty). Row 1: BCHGCA1N=0 (populated), BCHGCAT1 empty -> fires - the SAME record state as PMDA-AD0482-valid_secondary_only, where it must stay silent. Row 2 both populated -> silent. If row 1 does NOT fire, escalate - do not change the value."
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015 BCHGCA1N=0
#library standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID    type=Char
col USUBJID    type=Char
col PARAMCD    type=Char
col BCHGCA1N   type=Num
col BCHGCAT1   type=Char
---
CDISCPILOT01 | 01-701-1015 | GLUC | 0 |
CDISCPILOT01 | 01-701-1023 | GLUC | 2 | WORSENED
---
