#!RuleTest
#test PMDA-AD0481 expect=noViolation domain=ADSL
#note "STRAT1V is not declared. Seeded by STRAT1VN (w=1); Requirements.Variables.All expands to STRAT1VN (present) so the rule runs, and var_exists(STRAT1V) keeps it silent. Mirror of AD0480's valid_partner_column_absent - the scope/applicability columns are swapped."
#library standard=adamig version=1-3
dataset ADSL
col STUDYID  type=Char
col USUBJID  type=Char
col STRAT1VN type=Num
---
S1 | 001 | 1
S1 | 002 | 2
---
