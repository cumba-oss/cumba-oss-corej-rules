#!RuleTest
#test CDISC-AD0079 expect=violation domain=ADSL
# Rule:Description: At least one TRTxxP is present where xx is greater than 01 and TRxxEDT is not present
#note "TRT02P present (xx=02>01) but TR02EDT absent -> violation"
#expectViolationCount 1
#expectViolationAt TRT02P="Drug A"
dataset ADSL class=ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRT01P type=Char
col TRT02P type=Char
---
CDISCPILOT01 | 01-701-1015 | Placebo | Drug A
---
