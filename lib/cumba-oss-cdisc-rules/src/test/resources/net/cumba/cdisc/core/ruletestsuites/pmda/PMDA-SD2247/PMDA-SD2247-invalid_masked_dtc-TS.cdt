#!RuleTest
#test PMDA-SD2247 expect=violation domain=TS
#note "FRESH. Six rows pin the exact acceptance boundary since Fix #215 widened ScalarSemantics.isPartialDate: rows 1-3 are the three SDTM masked forms (2020-01--, 2020---15, ----01-15), all SILENT. Row 4 (2020-02-30) is correctly shaped but calendar-impossible, FIRES. Row 5 (2020---32) is a masked month with a present impossible day - the trap a 'stop at the first ABSENT component' walk would accept - FIRES. Row 6 (UNKNOWN) is plain junk, FIRES. NEUTER CHECK: change row 5 to 2020---31 and the count drops to 2, because some month has 31 days."
#library standard=sdtmig version=3-4
#expectViolationCount 3
#expectViolationAt row=4 TSSEQ=4
#expectViolationAt row=5 TSSEQ=5
#expectViolationAt row=6 TSSEQ=6
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
CDISCPILOT01 | TS | 1 | SSTDTC | Study Start Date | 2020-01--
CDISCPILOT01 | TS | 2 | SSTDTC | Study Start Date | 2020---15
CDISCPILOT01 | TS | 3 | SSTDTC | Study Start Date | ----01-15
CDISCPILOT01 | TS | 4 | SSTDTC | Study Start Date | 2020-02-30
CDISCPILOT01 | TS | 5 | SSTDTC | Study Start Date | 2020---32
CDISCPILOT01 | TS | 6 | SSTDTC | Study Start Date | UNKNOWN
