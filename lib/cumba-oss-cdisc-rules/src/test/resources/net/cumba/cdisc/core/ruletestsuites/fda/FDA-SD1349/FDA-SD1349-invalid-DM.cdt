#!RuleTest
#test FDA-SD1349 expect=violation domain=DM
#note "DM carries two different STUDYID values, so the domain does not describe one study. With no majority value both records are reported."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 STUDYID=STUDY-A DOMAIN=DM
#expectViolationAt row=2 STUDYID=STUDY-B DOMAIN=DM
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col SEX     type=Char label="Sex"
---
STUDY-A | DM | STUDY-A-001 | 001 | M
STUDY-B | DM | STUDY-B-002 | 002 | F
