#!RuleTest
#test FDA-SE2236 expect=noViolation domain=TS
#note "Exactly one TSPARMCD=SNDCTVER record. The dataset deliberately carries TWO SNDIGVER records: an unfiltered record count would be 4 > 1 and fire, so a no-violation here proves the count is filtered to TSPARMCD=SNDCTVER."
#library standard=sendig version=3-1-1
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | SNDCTVER | SEND Controlled Terminology Version | SEND CT 2024-09-27
S01 | TS | 2 | SNDIGVER | SEND Implementation Guide Version | 3.1.1
S01 | TS | 3 | SNDIGVER | SEND Implementation Guide Version | 3.1.1
S01 | TS | 4 | STITLE | Study Title | 28-Day Repeat Dose Toxicity Study
