#!RuleTest
#test PMDA-SD1454 expect=skipped domain=MK
#note "Class FINDINGS satisfied, both required variables present, firing data present -- ONLY the Domains.Exclude [MK] entry can reject (SD1126 discipline)."
#library standard=sdtmig version=3-4
dataset MK class=FINDINGS label="Musculoskeletal Findings"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col MKSEQ    type=Num
col MKTESTCD type=Char
col MKDRVFL  type=Char
col MKSTREFC type=Char
---
S1 | MK | 001 | 1 | EXAM | Y |
