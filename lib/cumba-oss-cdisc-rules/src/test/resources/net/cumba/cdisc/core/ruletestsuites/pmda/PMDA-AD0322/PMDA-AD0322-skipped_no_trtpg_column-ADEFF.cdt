#!RuleTest
#test PMDA-AD0322 expect=skipped domain=ADEFF
#note "No column matches ^TRTPG(\\d+)$. WildcardExpander finds a real wildcard token but no matching column, returns NoMatch, and the harness reports the rule NOT EXECUTED ('SKIPPED: Template did not match any columns in dataset')."
#library standard=adamig version=1-3
dataset ADEFF
col STUDYID type=Char
col USUBJID type=Char
col TRTP    type=Char
---
S1 | 001 | DrugA
S1 | 002 | DrugA
