#!RuleTest
#test CDISC-AD0209 expect=violation domain=ADSL
# Rule:Description: The value of ADSL.USUBJID is equal to the value of DM.USUBJID and ADSL.SITEID is not equal to DM.SITEID
#note "same USUBJID, ADSL.SITEID != DM.SITEID -> violation"
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col SITEID type=Char
---
CDISCPILOT01 | 01-701-1015 | 999
---

dataset DM label=Demographics
col STUDYID type=Char
col DOMAIN type=Char
col USUBJID type=Char
col SITEID type=Char
---
CDISCPILOT01 | DM | 01-701-1015 | 701
---
