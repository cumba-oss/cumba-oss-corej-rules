#!RuleTest
#test FDA-SE2310 expect=noViolation domain=CL
#note "Row 1 was performed and carries a standardized result with an empty completion status; row 2 was not done and therefore carries no standardized result. Both are conformant."
#library standard=sendig version=3-1-1
dataset CL class=FINDINGS label="Clinical Observations"
col STUDYID  type=Char label="Study Identifier"
col USUBJID  type=Char label="Unique Subject Identifier"
col CLSEQ    type=Num  label="Sequence Number"
col CLTESTCD type=Char label="Clinical Observation Short Name"
col CLORRES  type=Char label="Result or Finding in Original Units"
col CLSTRESC type=Char label="Standardized Result in Character Format"
col CLSTAT   type=Char label="Completion Status"
---
S1 | 001 | 1 | CLSIGN | NORMAL | NORMAL |
S1 | 001 | 2 | CLSIGN |        |        | NOT DONE
