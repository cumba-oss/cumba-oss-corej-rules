#!RuleTest
#test PMDA-AD0323 expect=violation domain=ADLBC
#note "No wildcard marker in either name, so the rule runs once unexpanded. Key APHASE=TREATMENT holds APHASEN {2 x2, 3 x1} -> row 3 is the minority; group SCREENING is consistent."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=003 APHASE=TREATMENT APHASEN=3
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col APHASE  type=Char
col APHASEN type=Num
---
S1 | 001 | GLUC | TREATMENT | 2
S1 | 002 | GLUC | TREATMENT | 2
S1 | 003 | GLUC | TREATMENT | 3
S1 | 004 | GLUC | SCREENING | 1
S1 | 005 | GLUC | SCREENING | 1
