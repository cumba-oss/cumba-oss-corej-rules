#!RuleTest
#test FDA-SE2218 expect=violation domain=TS
#note "No TSPARMCD=STSTDTC record anywhere in TS -> the 'Study Start Date' parameter is missing, one dataset-level finding. Note DOSSTDTC (which ends in the same STDTC suffix) and STENDTC are present, so a suffix/substring match on the TSPARMCD filter would wrongly silence the rule."
#library standard=sendig version=3-1-1
#expectViolationCount 1
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | DOSSTDTC | Start Date/Time of Dose Interval | 2023-06-01
S01 | TS | 2 | STENDTC | Study End Date | 2023-06-28
S01 | TS | 3 | STITLE | Study Title | 28-Day Repeat Dose Toxicity Study
