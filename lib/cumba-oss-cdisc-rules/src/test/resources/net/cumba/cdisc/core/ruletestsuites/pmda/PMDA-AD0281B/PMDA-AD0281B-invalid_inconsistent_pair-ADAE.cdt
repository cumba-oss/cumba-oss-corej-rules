#!RuleTest
#test PMDA-AD0281B expect=violation domain=ADAE
#note "KEY=AESEV (2nd arg), DEPENDENT=AESEVN (1st arg): key MILD carries {1,2} -> rows 1,3 fire; key MODERATE is single-valued. Record granularity -> 2 violations."
#library standard=adamig version=1-3
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015 AESEV=MILD AESEVN=1
#expectViolationAt row=3 USUBJID=01-701-1034 AESEV=MILD AESEVN=2
dataset ADAE structure=OCCDS subclass=AE
col STUDYID type=Char
col USUBJID type=Char
col AESEQ   type=Num
col AEDECOD type=Char
col AESEV   type=Char
col AESEVN  type=Num
---
CDISCPILOT01 | 01-701-1015 | 1 | HEADACHE | MILD     | 1
CDISCPILOT01 | 01-701-1023 | 1 | NAUSEA   | MODERATE | 1
CDISCPILOT01 | 01-701-1034 | 2 | RASH     | MILD     | 2
