#!RuleTest
#test PMDA-SD1003 expect=skipped domain=AE
#note "FRESH. Scope.Domains.Include is [DM]; an AE primary is rejected by the domain axis before execution. Chosen over another DM-shaped skip because AE is the domain a real study run puts alongside DM most often."
#library standard=sdtmig version=3-1-2
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEDECOD type=Char label="Dictionary-Derived Term"
---
CDISCPILOT01 | AE | 01-701-1015 | 1 | HEADACHE | Headache
