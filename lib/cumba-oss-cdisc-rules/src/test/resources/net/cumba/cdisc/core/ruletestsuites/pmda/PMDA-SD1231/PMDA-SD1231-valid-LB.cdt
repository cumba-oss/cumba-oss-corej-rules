#!RuleTest
#test PMDA-SD1231 expect=noViolation domain=LB
#note "Track B: adapted from FDA-SD1231-valid-LB.cdt. Boundary: every value is at most as long as the value-level length declared for its condition (GLUC Length=3, PH/URINE Length=7), and an empty value is out of the condition."
#library standard=sdtmig version=3-4
#define-xml PMDA-SD1231-define.xml
dataset LB
col USUBJID  type=Char
col LBTESTCD type=Char
col LBSPEC   type=Char
col LBSTRESC type=Char
---
001 | GLUC | SERUM | 5.5
001 | PH   | URINE | ACIDIC
001 | GLUC | SERUM |
