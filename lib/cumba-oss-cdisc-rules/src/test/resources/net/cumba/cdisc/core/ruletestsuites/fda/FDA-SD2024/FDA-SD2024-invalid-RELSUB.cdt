#!RuleTest
#test FDA-SD2024 expect=violation domain=RELSUB
#note "Row 1 populates USUBJID and POOLID on the same record -> fires; rows 2 and 3 populate only one of the pair."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 POOLID=P01
dataset RELSUB class=RELATIONSHIP label="Related Subjects"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col POOLID  type=Char label="Pool Identifier"
col RSUBJID type=Char label="Related Subject or Pool Identifier"
col SREL    type=Char label="Subject Relationship"
---
S1 | 001 | P01 | 002 | LITTERMATE
S1 | 004 |     | 005 | MOTHER, BIOLOGICAL
S1 |     | P02 | 006 | LITTERMATE
