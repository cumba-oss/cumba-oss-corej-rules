#!RuleTest
#test FDA-SD1450 expect=violation domain=PP
#note "PPSTINT is present but PPENINT is not -> the assessment interval has a start and no end -> one dataset-level finding."
#library standard=sdtmig version=3-4
#expectViolationCount 1
dataset PP class=FINDINGS label="Pharmacokinetic Parameters"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PPSEQ    type=Num  label="Sequence Number"
col PPTESTCD type=Char label="Parameter Short Name"
col PPSTINT  type=Char label="Planned Start of Assessment Interval"
---
CDISCPILOT01 | PP | 01-701-1015 | 1 | AUCALL | PT0H
---
