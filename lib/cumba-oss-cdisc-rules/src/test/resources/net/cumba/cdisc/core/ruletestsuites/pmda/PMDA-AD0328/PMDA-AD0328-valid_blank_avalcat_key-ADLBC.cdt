#!RuleTest
#test PMDA-AD0328 expect=noViolation domain=ADLBC
#note "Row 3's AVALCAT1 (the grouping key) is blank, so it is dropped from grouping; the (ALB, LOW) group holds one distinct code. The row's own not empty(AVALCAT1) conjunct is false as well."
#library standard=adamig version=1-3
dataset ADLBC class=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVALCAT1 type=Char
col AVALCA1N type=Num
---
S1 | 001 | ALB | LOW | 1
S1 | 002 | ALB | LOW | 1
S1 | 003 | ALB |     | 2
