#!RuleTest
#test PMDA-AD0232 expect=skipped domain=ADDL
#note "The second ADSL-vs-ADDL pin (wildcard half). ADAM OTHER by the columns, refined to DEVICE LEVEL ANALYSIS DATASET by SPDEVID, which has no supertype and is not this rule's single Include token. Data would fire if it ran; sibling PMDA-AD0232B would run on this fixture."
#library standard=adamig version=1-0
dataset ADDL
col STUDYID type=Char
col USUBJID type=Char
col SPDEVID type=Char
col TR01PG1  type=Char
col TR01PG1N type=Num
---
S1 | 001 | DEV01 | POOLA  | 1
S1 | 002 | DEV01 | POOLA  | 1
S1 | 003 | DEV02 | POOLAA | 1
