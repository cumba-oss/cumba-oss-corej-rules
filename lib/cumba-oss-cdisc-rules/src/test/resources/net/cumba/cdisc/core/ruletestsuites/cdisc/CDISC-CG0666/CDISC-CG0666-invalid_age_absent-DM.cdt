#!RuleTest
#test CDISC-CG0666 expect=violation domain=DM
#note "AGE is not present in the dataset while AGEU is populated on both rows -> the age itself is not provided. Encodes the column-absent case: the Check carries a bare empty(AGE) leaf, which under absent = all-missing (EC-43) is TRUE on every row of a column that is not there. Plan B phase 4d' deleted the redundant not var_exists(AGE) disjunct that used to spell this out; the verdict is unchanged, still reported per row because the AGEU half is per-row."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 AGEU=YEARS
#expectViolationAt row=2 AGEU=MONTHS
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col AGEU    type=Char label="Age Units"
---
CDISCPILOT01 | DM | 01-701-1015 | 1015 | YEARS
CDISCPILOT01 | DM | 01-701-1023 | 1023 | MONTHS
