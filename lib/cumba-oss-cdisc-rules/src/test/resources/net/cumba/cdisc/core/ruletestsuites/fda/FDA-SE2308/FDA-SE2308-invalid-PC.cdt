#!RuleTest
#test FDA-SE2308 expect=violation domain=PC
#note "Row 1 PCELTM empty -> fires; row 2 PCELTM populated but VISITDY and PCNOMDY both missing -> fires; row 3 PCELTM with PCNOMDY -> ok."
#library standard=sendig version=3-1
#expectViolationCount 2
#expectViolationAt row=1 PCSEQ=1
#expectViolationAt row=2 PCSEQ=2
dataset PC class=FINDINGS label="Pharmacokinetics Concentrations"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col PCSEQ   type=Num  label="Sequence Number"
col VISITDY type=Num  label="Planned Study Day of Visit"
col PCNOMDY type=Num  label="Nominal Study Day for Tabulations"
col PCELTM  type=Char label="Planned Elapsed Time from Time Point Ref"
---
S1 | PC | 001 | 1 | 3 | 1 |
S1 | PC | 001 | 2 | . | . | PT1H
S1 | PC | 001 | 3 | 3 | 1 | PT0H
