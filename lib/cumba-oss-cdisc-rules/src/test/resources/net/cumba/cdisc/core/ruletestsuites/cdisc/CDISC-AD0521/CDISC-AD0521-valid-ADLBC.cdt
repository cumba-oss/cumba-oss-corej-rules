#!RuleTest
#test CDISC-AD0521 expect=noViolation domain=ADLBC
# Rule:Description: A variable which has a suffix of GRyN is present and a variable with the same root name and suffix of GRy is not present
#note "both AETOXGR1N and AETOXGR1 present -> no violation"
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AETOXGR1N type=Char
col AETOXGR1 type=Char
---
CDISCPILOT01 | 01-701-1015 | GLUC | 1 | 1
---
