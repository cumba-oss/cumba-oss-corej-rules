#!RuleTest
#test CDISC-SEND-0009.1 expect=violation domain=BW
#note "USUBJID Role=Identifier matches the SENDIG -> silent. BWTESTCD Role=Identifier in the define vs library Topic -> all four conjuncts true -> fires."
#library standard=sendig version=3-1-1
#library variable-metadata BW BWTESTCD name=BWTESTCD role=Topic
#library variable-metadata BW USUBJID name=USUBJID role=Identifier
#define-xml CDISC-SEND-0009.1-define.xml
#expectViolationCount 1
#expectViolationAt define_variable_name=BWTESTCD define_variable_role=Identifier
dataset BW
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col BWSEQ    type=Num
col BWTESTCD type=Char
---
S1 | BW | 001 | 1 | BW
