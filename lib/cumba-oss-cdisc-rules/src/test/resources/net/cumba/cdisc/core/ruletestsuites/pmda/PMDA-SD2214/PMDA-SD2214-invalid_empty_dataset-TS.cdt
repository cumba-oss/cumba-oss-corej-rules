#!RuleTest
#test PMDA-SD2214 expect=violation domain=TS
#note "FRESH, DISCRIMINATING: the batch's TS 0-row fixture (meaningful here - an empty TS genuinely lacks the TPHASE parameter). record_count's EmptyResult is COUNT (0, never missing); the broadcast fold sits above the synthetic-row branch and emits one violation at internal row 0, reported row=1 (PMDA-SD2287/SD2221 precedents)."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
