#!RuleTest
#test PMDA-AD0476 expect=violation domain=ADDL
#note "Name starts with AD, no BDS indicator, no column ending TERM/TRT/DECOD -> base ADAM OTHER; SPDEVID refines it to DEVICE LEVEL ANALYSIS DATASET, which has NO supertype and is in scope only because the second Include token names it. Pins the DLAD half of the block and the sheet's Domains 'ADSL, ADDL'."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=003 STRATAV=LOW STRATAVN=1
dataset ADDL
col STUDYID  type=Char
col USUBJID  type=Char
col SPDEVID  type=Char
col STRATAV  type=Char
col STRATAVN type=Num
---
S1 | 001 | DEV01 | HIGH | 1
S1 | 002 | DEV01 | HIGH | 1
S1 | 003 | DEV02 | LOW  | 1
---
