#!RuleTest
#test FDA-SD1291 expect=violation domain=AE
#note "row 1: AEENTPT names an end reference time point but AEENRTPT is empty -> fires."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 AEENTPT=2020-03-15
dataset AE class=EVENTS label="Adverse Events"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col AESEQ    type=Num  label="Sequence Number"
col AETERM   type=Char label="Reported Term for the Adverse Event"
col AEENRTPT type=Char label="End Relative to Reference Time Point"
col AEENTPT  type=Char label="End Reference Time Point"
---
S1 | AE | 001 | 1 | HEADACHE |  | 2020-03-15
S1 | AE | 002 | 1 | NAUSEA | AFTER | 2020-04-01
