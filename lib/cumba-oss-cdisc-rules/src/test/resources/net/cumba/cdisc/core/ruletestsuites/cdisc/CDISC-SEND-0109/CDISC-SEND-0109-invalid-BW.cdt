#!RuleTest
#test CDISC-SEND-0109 expect=violation domain=BW
#note "ADAPTED-FROM fda/FDA-SD0064/FDA-SD0064-invalid-AE.cdt per M3-SEND-T2-K3-01 stage-r - re-cut AE->BW (SEND), library sdtmig 3-4 -> sendig 3-1-1, and STRENGTHENED: subject 999 gains a second offending record, the discriminator (per subject 1, per record 2). Row 1 (001) is in DM -> clean. Rows 2-3 (999) are not in DM -> the subject fires ONCE, anchored at BW row 2 (SD1316-F3, ruled per subject). Row 4 has an empty USUBJID and is guarded by the non_empty leaf."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=2 USUBJID=999
dataset BW label="Body Weight"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col BWSEQ    type=Num  label="Sequence Number"
col BWTESTCD type=Char label="Body Weight Test Short Name"
col BWORRES  type=Char label="Result or Finding in Original Units"
---
S1 | BW | 001 | 1 | BW | 250
S1 | BW | 999 | 1 | BW | 260
S1 | BW | 999 | 2 | BW | 262
S1 | BW |     | 1 | BW | 255
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SEX     type=Char label="Sex"
---
S1 | DM | 001 | M
S1 | DM | 002 | F
---
