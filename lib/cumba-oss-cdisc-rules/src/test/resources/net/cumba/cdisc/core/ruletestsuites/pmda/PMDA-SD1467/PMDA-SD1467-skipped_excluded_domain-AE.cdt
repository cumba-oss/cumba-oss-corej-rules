#!RuleTest
#test PMDA-SD1467 expect=skipped domain=AE
#note "AEOCCUR=Y, AEPRESP blank - would fire if in scope. EVENTS is in Scope.Classes.Include but AE is in Scope.Domains.Exclude -> skipped. ONE pin of the class-include + domain-exclude interplay."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col AESEQ   type=Num
col AEOCCUR type=Char
col AEPRESP type=Char
---
S1 | AE | 001 | 1 | Y |
