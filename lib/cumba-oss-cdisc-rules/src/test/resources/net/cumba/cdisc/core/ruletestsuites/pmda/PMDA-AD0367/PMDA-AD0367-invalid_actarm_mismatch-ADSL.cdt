#!RuleTest
#test PMDA-AD0367 expect=violation domain=ADSL
#note "Row 1: ACTARM DRUGA != DM.ACTARM PLACEBO -> fires. Row 2: equal -> silent. Join DM on Keys=[USUBJID], loader-default inner, 1:1. Requirements.Variables.All [ACTARM] is satisfied (ACTARM present)."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 ACTARM=DRUGA DM.ACTARM=PLACEBO
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col ACTARM  type=Char
---
S1 | 01-701-1015 | DRUGA
S1 | 01-701-1023 | PLACEBO
---

dataset DM label=Demographics
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col ACTARM  type=Char
---
S1 | DM | 01-701-1015 | PLACEBO
S1 | DM | 01-701-1023 | PLACEBO
