#!RuleTest
#test PMDA-SD1299 expect=skipped domain=IE
#note "IE is FINDINGS-class but explicitly excluded by Scope.Domains.Exclude [IE, SC] (the sheet cell's parenthesised '(-IE, -SC)' exclusion) -> skipped. Declaring model-variables IE --DTC:Timing without any timing column present makes the fixture discriminating: were the exclusion broken, this dataset would fire."
#library standard=sdtmig version=3-4
#library model-variables IE --DTC:Timing
dataset IE class=FINDINGS label="Inclusion/Exclusion Criteria Not Met"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IESEQ    type=Num  label="Sequence Number"
col IETESTCD type=Char label="Inclusion/Exclusion Criterion Short Name"
col IEORRES  type=Char label="Inclusion/Exclusion Criterion Result"
---
S1 | IE | 001 | 1 | INC01 | Y
