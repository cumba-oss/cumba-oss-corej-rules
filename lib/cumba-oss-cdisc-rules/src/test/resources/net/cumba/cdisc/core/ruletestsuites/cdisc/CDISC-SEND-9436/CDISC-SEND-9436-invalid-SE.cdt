#!RuleTest
#test CDISC-SEND-9436 expect=violation domain=SE
# Rule:Description: CDISC-SEND-9436 — the Required key USUBJID is not populated.
#note "USUBJID blank -> violation; the twin scenario differs only in the value of USUBJID."
#library standard=sendig version=3-1-1
#expectViolationCount 1
dataset SE
col STUDYID type=Char
col DOMAIN type=Char
col USUBJID type=Char
col SESEQ type=Char
col ETCD type=Char
---
S1      | SE     |         | 1     | SCRN
---
