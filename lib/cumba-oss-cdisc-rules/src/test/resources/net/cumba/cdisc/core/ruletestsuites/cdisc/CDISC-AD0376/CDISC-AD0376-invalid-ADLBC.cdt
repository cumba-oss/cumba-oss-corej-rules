#!RuleTest
#test CDISC-AD0376 expect=violation domain=ADLBC
# Rule:Description: On a given record, a variable which has a suffix of GRy is populated and a variable with the same root name and suffix of GRyN is not populated
#note "AETOXGR1 populated, AETOXGR1N empty -> violation"
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col AETOXGR1 type=Char
col AETOXGR1N type=Char
---
CDISCPILOT01 | 01-701-1015 | VAL | 
