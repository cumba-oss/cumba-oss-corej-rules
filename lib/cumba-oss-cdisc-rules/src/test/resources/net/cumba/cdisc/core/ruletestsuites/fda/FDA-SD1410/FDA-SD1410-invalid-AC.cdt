#!RuleTest
#test FDA-SD1410 expect=violation domain=AC
#note "AC carries other Challenge Agent parameters but no MCSCTIND record. FDA: \"'Multiple Challenge Agent Same Cat Ind' (MCSCTIND) record must be populated in Challenge Agent Characterization (AC) domain.\" -> the rule must fire exactly once for the dataset."
#library standard=sendig version=ar-1-0
#expectViolationCount 1
dataset AC label="Challenge Agent Characterization"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col ACSEQ    type=Num  label="Sequence Number"
col ACPARMCD type=Char label="Challenge Agent Parameter Short Name"
col ACPARM   type=Char label="Challenge Agent Parameter"
col ACVAL    type=Char label="Parameter Value"
---
S1 | AC | 1 | BACAT | Biological Agent Category | BACTERIA
S1 | AC | 2 | BASTRNN | Biological Agent Strain Name | CO92
