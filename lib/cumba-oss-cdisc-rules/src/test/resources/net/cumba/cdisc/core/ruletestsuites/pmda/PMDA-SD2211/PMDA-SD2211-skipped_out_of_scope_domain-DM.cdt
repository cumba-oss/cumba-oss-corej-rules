#!RuleTest
#test PMDA-SD2211 expect=skipped domain=DM
#note "Scope.Domains.Include [TS] -> pre-gate skip. Pins the batch's Domains.Include gate face (also on behalf of SD1018's [SV] include, whose own skip fixture pins its Variables gate instead)."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE"
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
---
S01 | DM | 001
