#!RuleTest
#test PMDA-AD0283B expect=skipped domain=ADSL
#note "SUBJECT LEVEL ANALYSIS DATASET is not among Data_Structures.Include:[BASIC DATA STRUCTURE, OCCURRENCE DATA STRUCTURE] and has no supertype that is -> the pre-gate reports out of scope and it never executes. THE BATCH'S SINGLE PIN on the [BDS,OCCDS] block shared by AD0283B/AD0284B/AD0289B/AD0295B/AD0296B. Firing shape carried by the rows so the skip is not mistaken for silence."
#library standard=adamig version=1-3
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col ASEV    type=Char
col ASEVN   type=Num
---
CDISCPILOT01 | 01-701-1015 | MILD     | 1
CDISCPILOT01 | 01-701-1023 | MODERATE | 1
