#!RuleTest
#test FDA-SD0043 expect=skipped domain=EX
#note "EXTRTV is not present in the dataset. --TRTV is an Expected variable (SENDIG EX, core=Exp) whose absence is reported by the dedicated presence rule, so this rule is gated off via Requirements.Variables.All -> no violation here."
#library standard=sdtmig version=3-4
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXVAMT  type=Num  label="Treatment Vehicle Amount"
---
CDISCPILOT01 | EX | 01-701-1015 | 1 | DRUG A | 5
CDISCPILOT01 | EX | 01-701-1015 | 2 | DRUG A | 10
