#!RuleTest
#test PMDA-AD0134 expect=violation domain=ADLBC
#note "Expected 10/2=5, holds 9 -> fires. Mirror of PMDA-AD0133 on the upper limit."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015 AVAL=10 A1HI=2 R2A1HI=9
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col A1HI    type=Num
col R2A1HI  type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | 10 | 2 | 9
CDISCPILOT01 | 01-701-1023 | ALB | 10 | 2 | 5
---
