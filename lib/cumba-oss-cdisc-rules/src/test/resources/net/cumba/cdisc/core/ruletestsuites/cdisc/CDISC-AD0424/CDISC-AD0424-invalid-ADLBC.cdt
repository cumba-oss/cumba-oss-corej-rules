#!RuleTest
#test CDISC-AD0424 expect=violation domain=ADLBC
# Rule:Description: On a given record, TRTPGy is populated and TRTPGyN is not populated
#note "TRTPG1 populated, TRTPG1N empty -> violation"
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015
# Declared-tier scope: the class= declaration disagrees with the columns, so #define must
# carry it to RuleRunner (ScenarioDeclaredScopeProvider.install).
#define standard=adamig version=1-3
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col TRTPG1 type=Char
col TRTPG1N type=Char
---
CDISCPILOT01 | 01-701-1015 | VAL | 
---
