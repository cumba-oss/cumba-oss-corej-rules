#!RuleTest
#test PMDA-AD0313 expect=violation domain=ADAE
#note "The column name matches ^SMQ\\d{2}SCN\$, the value is populated, and 3 is neither 1 (BROAD) nor 2 (NARROW) => one per-(variable,row) finding. #library standard=adamig version=1-1 - PMDA-AD0313 ships ONLY in rules-pmda-adamig-1-0.json and -1-1.json; version=1-3 is an automatic red (finding AD0313-F1)."
#expectViolationCount 1
#expectViolationAt row=1 variable_name=SMQ01SCN variable_value=3
#library standard=adamig version=1-1
dataset ADAE structure=OCCDS subclass=AE
col STUDYID  type=Char
col USUBJID  type=Char
col ASEQ     type=Num
col AEDECOD  type=Char
col SMQ01SCN type=Num
---
CDISCPILOT01 | 01-701-1015 | 1 | HEADACHE | 3
