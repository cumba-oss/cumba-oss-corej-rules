#!RuleTest
#test PMDA-SD1046 expect=violation domain=IE
#note "Row 2 is an INCLUSION criterion whose IEORRES is 'Y' rather than the required 'N' -> fires. Row 1 (INCLUSION/'N') and row 3 (EXCLUSION) are conformant."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 IETESTCD=INCL02 IEORRES=Y
dataset IE class=FINDINGS label="Inclusion/Exclusion Criteria Not Met"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IESEQ    type=Num  label="Sequence Number"
col IETESTCD type=Char label="Inclusion/Exclusion Criterion Short Name"
col IECAT    type=Char label="Inclusion/Exclusion Category"
col IEORRES  type=Char label="I/E Criterion Original Result"
---
CDISCPILOT01 | IE | 01-701-1015 | 1 | INCL01 | INCLUSION | N
CDISCPILOT01 | IE | 01-701-1015 | 2 | INCL02 | INCLUSION | Y
CDISCPILOT01 | IE | 01-701-1023 | 1 | EXCL02 | EXCLUSION | Y
