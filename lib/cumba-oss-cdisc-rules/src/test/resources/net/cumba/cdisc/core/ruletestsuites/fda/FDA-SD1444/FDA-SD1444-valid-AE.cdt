#!RuleTest
#test FDA-SD1444 expect=noViolation domain=AE
#note "Each collected term is assigned exactly one primary system organ class."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEDECOD type=Char label="Dictionary-Derived Term"
col AESOC    type=Char label="Primary System Organ Class"
---
S1 | AE | 001 | 1 | HEADACHE | Headache | Nervous system disorders
S1 | AE | 002 | 1 | HEADACHE | Headache | Nervous system disorders
S1 | AE | 003 | 1 | NAUSEA   | Nausea   | Gastrointestinal disorders
