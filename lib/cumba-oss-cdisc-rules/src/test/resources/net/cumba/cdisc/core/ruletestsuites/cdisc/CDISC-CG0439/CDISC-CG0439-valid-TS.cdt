#!RuleTest
#test CDISC-CG0439 expect=noViolation domain=TS
#note "Row 1 a COMPOUND valid period; row 2 the explicitly allowed empty TSVAL; row 3 a plainly non-period value under a different parameter (PLANSUB). No class= (the twins declare none and Scope carries no Classes axis). SIDECAR version=3-3. ADAPTED-FROM fda/FDA-SD1219/FDA-SD1219-valid-TS.cdt."
#library standard=sdtmig version=3-3
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
CDISCPILOT01 | TS | 1 | LENGTH  | Trial Length              | P2Y6M
CDISCPILOT01 | TS | 2 | LENGTH  | Trial Length              |
CDISCPILOT01 | TS | 1 | PLANSUB | Planned Number of Subjects | 300
