#!RuleTest
#test FDA-SD1343 expect=noViolation domain=DM
#note "Treated subject (row 1) has RFXSTDTC; the untreated ACTARMCD codes SCRNFAIL/NOTTRT/NOTASSGN and an empty ACTARMCD are all guarded out, so their empty RFXSTDTC is conformant."
#library standard=sdtmig version=3-4
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFXSTDTC type=Char label="Date/Time of First Study Treatment"
col ACTARMCD type=Char label="Actual Arm Code"
col ACTARM   type=Char label="Description of Actual Arm"
---
CDISCPILOT01 | DM | 01-701-1015 | 2020-01-05 | A        | Arm A
CDISCPILOT01 | DM | 01-701-1023 |            | SCRNFAIL | Screen Failure
CDISCPILOT01 | DM | 01-701-1028 |            | NOTTRT   | Not Treated
CDISCPILOT01 | DM | 01-701-1034 |            | NOTASSGN | Not Assigned
CDISCPILOT01 | DM | 01-701-1047 |            |          |
