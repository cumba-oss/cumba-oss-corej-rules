#!RuleTest
#test CDISC-AD0673 expect=violation domain=ADDV
# Rule:Description: There is more than one value of DEVGRy for a given value of DEVGRyN, considering only those rows on which both variables are populated
#note "DEVGR1N=K1 maps to two distinct DEVGR1 values -> violation"
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015
#expectViolationAt row=2 USUBJID=01-701-1023
dataset ADDV class="DEVICE LEVEL ANALYSIS DATASET"
col STUDYID type=Char
col USUBJID type=Char
col SPDEVID type=Char
col DEVGR1 type=Char
col DEVGR1N type=Char
---
CDISCPILOT01 | 01-701-1015 | DEV01 | A1 | K1
CDISCPILOT01 | 01-701-1023 | DEV01 | A2 | K1
---
