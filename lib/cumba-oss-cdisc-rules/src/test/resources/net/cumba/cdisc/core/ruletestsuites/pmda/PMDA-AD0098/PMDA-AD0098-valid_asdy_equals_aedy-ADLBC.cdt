#!RuleTest
#test PMDA-AD0098 expect=noViolation domain=ADLBC
#note "BOUNDARY. The sheet says 'must have a value LESS THAN OR EQUAL TO', so equality is conformant and the operator must be a strict >. This is the scenario that fails if > is ever loosened to >=."
#library standard=adamig version=1-3
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ASDY    type=Num
col AEDY    type=Num
---
CDISCPILOT01 | 01-701-1015 | GLUC | 50 | 50
