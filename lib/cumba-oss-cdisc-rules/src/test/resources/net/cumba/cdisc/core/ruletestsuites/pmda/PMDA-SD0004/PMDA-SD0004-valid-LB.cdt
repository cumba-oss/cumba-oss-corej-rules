#!RuleTest
#test PMDA-SD0004 expect=noViolation domain=LB
#note "The conformant case: prefix('LB',2)='LB' == DOMAIN='LB'."
#library standard=sdtmig version=3-4
dataset LB label="Laboratory Test Results"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
---
S1 | LB | 001 | 1 | ALB
S1 | LB | 001 | 2 | GLUC
