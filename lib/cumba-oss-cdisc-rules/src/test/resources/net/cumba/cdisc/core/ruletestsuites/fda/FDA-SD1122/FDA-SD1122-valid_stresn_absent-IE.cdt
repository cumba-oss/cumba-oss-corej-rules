#!RuleTest
#test FDA-SD1122 expect=skipped domain=IE
#note "Boundary: the IE domain has no --STRESN variable at all (SDTMIG 3.4 IE defines IESTRESC but no IESTRESN), so the column is legitimately absent. Absent is not 'empty' — the Requirements.Variables.All --STRESN gate skips the dataset, so no missing IESTRESN is reported (the skip IS the contract under test)."
#library standard=sdtmig version=3-4
dataset IE class=FINDINGS label="Inclusion/Exclusion Criteria Not Met"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IESEQ    type=Num  label="Sequence Number"
col IETESTCD type=Char label="Incl/Excl Criterion Short Name"
col IESTRESC type=Char label="Standardized Result in Standard Format"
---
CDISCPILOT01 | IE | 01-701-1015 | 1 | INCL01 | 120
CDISCPILOT01 | IE | 01-701-1015 | 2 | EXCL02 | 45
