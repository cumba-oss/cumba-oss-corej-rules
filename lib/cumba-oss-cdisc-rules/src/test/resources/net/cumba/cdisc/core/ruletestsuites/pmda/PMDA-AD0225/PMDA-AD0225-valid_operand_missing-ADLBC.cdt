#!RuleTest
#test PMDA-AD0225 expect=noViolation domain=ADLBC
#note "Row 1: PCHG blank. Row 2: AVAL blank. Row 3: BASE blank (BASE != 0 is TRUE for a missing BASE, but the arithmetic conjunct then skips the row, so the AND is false). All three silent."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col BASE    type=Num
col PCHG    type=Num
---
