#!RuleTest
#test PMDA-SD1322 expect=noViolation domain=DM
#note "The varname() == \"COUNTRY\" discriminator pin: another DM variable (SEX) bound to a NON-extensible library codelist with an out-of-list populated value must NOT fire this COUNTRY-only rule (it is sibling PMDA-CT2001's finding). COUNTRY has no library codelist metadata declared (null-safe guard silences it) and SEX fails the varname() conjunct."
#library standard=sdtmig version=3-4
#library variable-metadata DM SEX codelist=SEX codelist_extensible=false codelist_coded_values="[\"M\",\"F\",\"U\"]"
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col COUNTRY type=Char label="Country"
col SEX     type=Char label="Sex"
---
S1 | DM | 001 | USA | X
