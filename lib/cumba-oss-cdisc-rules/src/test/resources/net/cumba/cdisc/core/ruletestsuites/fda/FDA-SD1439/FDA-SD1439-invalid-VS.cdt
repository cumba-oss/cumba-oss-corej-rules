#!RuleTest
#test FDA-SD1439 expect=violation domain=VS
#note "Rows 1/2: two VSBLFL='Y' records for the same USUBJID + full assessment key (VSTESTCD, VSCAT, VSLOC; the other key columns are absent and dropped) -> both fire. Row 3: same key but VSBLFL blank -> tuple differs on the target, clean. Row 4: different VSTESTCD -> clean."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 VSSEQ=1
#expectViolationAt row=2 VSSEQ=2
dataset VS class=FINDINGS
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VSSEQ    type=Num  label="Sequence Number"
col VSTESTCD type=Char label="Vital Signs Test Short Name"
col VSCAT    type=Char label="Category for Vital Signs"
col VSLOC    type=Char label="Location of Vital Signs Measurement"
col VSBLFL   type=Char label="Baseline Flag"
---
S1 | VS | S1-001 | 1 | SYSBP | VITALS | ARM | Y
S1 | VS | S1-001 | 2 | SYSBP | VITALS | ARM | Y
S1 | VS | S1-001 | 3 | SYSBP | VITALS | ARM |
S1 | VS | S1-001 | 4 | TEMP  | VITALS | ARM | Y
