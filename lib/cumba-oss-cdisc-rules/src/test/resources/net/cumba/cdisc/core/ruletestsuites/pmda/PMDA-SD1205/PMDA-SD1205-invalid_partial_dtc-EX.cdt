#!RuleTest
#test PMDA-SD1205 expect=violation domain=EX
#note "FRESH (strict-'<' FOR-ALL hull pin, DISCRIMINATING). Against RFXSTDTC 2020-01-15 (complete): row 1 EXSTDTC 2019-12 -> upper hull 2019-12-31 < 2020-01-15 -> FIRES; row 2 EXSTDTC 2019 -> upper 2019-12-31 -> FIRES; row 3 EXSTDTC 2020-01 -> upper 2020-01-31 straddles -> silent; row 4 EXSTDTC ----12-31 (year-masked) -> null bounds saturate -> silent."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 EXSEQ=1
#expectViolationAt row=2 EXSEQ=2
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXSTDTC type=Char label="Start Date/Time of Treatment"
---
S1 | EX | 001 | 1 | DRUG A | 2019-12
S1 | EX | 001 | 2 | DRUG A | 2019
S1 | EX | 001 | 3 | DRUG A | 2020-01
S1 | EX | 001 | 4 | DRUG A | ----12-31
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFXSTDTC type=Char label="Date/Time of First Study Treatment"
---
S1 | DM | 001 | 2020-01-15
---
