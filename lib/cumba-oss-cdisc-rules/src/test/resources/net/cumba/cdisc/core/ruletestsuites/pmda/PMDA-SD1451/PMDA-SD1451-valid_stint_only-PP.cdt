#!RuleTest
#test PMDA-SD1451 expect=noViolation domain=PP
#note "Direction discriminator: --STINT alone is conformant (first conjunct false)."
#library standard=sdtmig version=3-4
dataset PP class=FINDINGS label="Pharmacokinetic Parameters"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col PPSEQ    type=Num
col PPTESTCD type=Char
col PPSTINT  type=Char
---
S1 | PP | 001 | 1 | AUCALL | P0H
---
