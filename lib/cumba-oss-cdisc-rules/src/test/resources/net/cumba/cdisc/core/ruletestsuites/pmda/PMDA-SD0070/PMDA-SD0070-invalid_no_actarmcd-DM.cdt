#!RuleTest
#test PMDA-SD0070 expect=violation domain=DM
#note "Boundary: SDTMIG 3.1.2 DM has no ACTARMCD column at all (LOAD-BEARING declaration), yet the rule declares sdtmig-3-1-2 membership and reads ACTARMCD unguarded except for the AUTHORED 'not var_exists(ACTARMCD)' arm. The ARMCD half of the intent still applies: subject 001 is not a screen failure / not unassigned and has no EX record, so the rule must still fire."
#library standard=sdtmig version=3-1-2
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
---
S1 | DM | 001 | A        | Drug A
S1 | DM | 002 | SCRNFAIL | Screen Failure
---

dataset EX label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Actual Treatment"
---
S1 | EX | 003 | 1 | DRUG A
---
