#!RuleTest
#test PMDA-AD0253 expect=noViolation domain=ADAE
#note "Fix #247 control arm: AE is present but has zero rows, so there are zero required keys and nothing can be untraceable. Distinguished from the ae_absent arm because absence and emptiness travel different code paths (EmptyResult vs an executed distinct over no rows)."
#library standard=adamig version=1-3
dataset ADAE label="Adverse Events Analysis Dataset"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESEQ   type=Num  label="Sequence Number"
---
CDISCPILOT01 | 01-701-1015 | HEADACHE | 1
---

dataset AE label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AESEQ   type=Num  label="Sequence Number"
