#!RuleTest
#test CDISC-CG0275 expect=noViolation domain=TS
# Rule:Description: Raise an error when a record exists with TSPARMCD equal to 'ADDON' and TSVAL equal to 'Y', but TSVAL is empty for the record where TSPARMCD equals 'CURTRT'.
#note "The gate is not satisfied (ADDON=N), so the rule cannot fire even though CURTRT has an empty TSVAL."
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | ADDON | N
S01 | TS | 2 | CURTRT | 
---
