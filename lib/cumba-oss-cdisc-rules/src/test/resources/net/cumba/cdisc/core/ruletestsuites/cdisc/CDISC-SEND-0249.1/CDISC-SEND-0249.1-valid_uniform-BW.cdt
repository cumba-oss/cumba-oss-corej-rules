#!RuleTest
#test CDISC-SEND-0249.1 expect=noViolation domain=BW
#note "3 rows with STUDYID=STUDYA on every row, DOMAIN=BW. One distinct value per group -- silent."
dataset BW label="Body Weight"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col BWSEQ   type=Num  label="Sequence Number"
---
STUDYA | BW | 001 | 1
STUDYA | BW | 002 | 2
STUDYA | BW | 003 | 3
---
