#!RuleTest
#test FDA-SE2270 expect=violation domain=DD
#note "Second in-scope domain: the generic --DY resolves to DDDY. Subject 001's only disposition is study day 20; the death-diagnosis record carries DDDY=18 -> fires."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 DDDY=18
dataset DD label="Death Diagnosis"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col DDSEQ    type=Num  label="Sequence Number"
col DDTESTCD type=Char label="Death Diagnosis Short Name"
col DDORRES  type=Char label="Result or Finding in Original Units"
col DDDTC    type=Char label="Date/Time of Collection"
col DDDY     type=Num  label="Study Day of Collection"
---
S1 | DD | 001 | 1 | DTHCAUS | HEPATIC NECROSIS | 2020-01-18 | 18
---

dataset DS label="Disposition"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DSSEQ   type=Num  label="Sequence Number"
col DSTERM  type=Char label="Reported Term for the Disposition Event"
col DSDECOD type=Char label="Standardized Disposition Term"
col DSSTDTC type=Char label="Start Date/Time of Disposition Event"
col DSSTDY  type=Num  label="Study Day of Start of Disposition Event"
---
S1 | DS | 001 | 1 | FOUND DEAD | DEAD | 2020-01-20 | 20
