#!RuleTest
#test PMDA-SD1207 expect=violation domain=EX
#note "FRESH: per-row multiplicity pin (no twin covers two fires). Row 1 and row 2 EXENDTC both after RFXENDTC -> two findings, one per flagged row. Row 3 equal boundary -> clean."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 EXSEQ=1
#expectViolationAt row=2 EXSEQ=2
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXENDTC type=Char label="End Date/Time of Treatment"
---
S1 | EX | 001 | 1 | DRUG A | 2020-04-01
S1 | EX | 001 | 2 | DRUG A | 2020-05-15
S1 | EX | 001 | 3 | DRUG A | 2020-03-31
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFXENDTC type=Char label="Date/Time of Last Study Treatment"
---
S1 | DM | 001 | 2020-03-31
---
