#!RuleTest
#test PMDA-SD0068 expect=violation domain=IE
#note "ADAPTED-FROM fda/FDA-SD0068/FDA-SD0068-invalid-IE.cdt, STRENGTHENED (+1 row). Row 1: 001|INCL01 -> in TI, silent. Row 2: 002|EXCL99 -> not in TI, FIRES. Row 3 (FRESH): 003|(IETESTCD EMPTY) -> the blank cell probes as the empty string LITERALLY (Primitives.membership blank-probe law) and '' is not among TI's values -> FIRES (SD0068-F1 pin). TI rows INCL01/EXCL01 are both populated - TI must contribute NO blank IETESTCD."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=2 IETESTCD=EXCL99
#expectViolationAt row=3
dataset IE class=FINDINGS label="Inclusion/Exclusion Criteria Not Met"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IESEQ    type=Num  label="Sequence Number"
col IETESTCD type=Char label="Incl/Excl Criterion Short Name"
col IETEST   type=Char label="Inclusion/Exclusion Criterion"
---
S1 | IE | 001 | 1 | INCL01 | Age 18 or older
S1 | IE | 002 | 1 | EXCL99 | Undefined criterion
S1 | IE | 003 | 1 |        | Blank criterion
---

dataset TI class="TRIAL DESIGN" label="Trial Inclusion/Exclusion Criteria"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col IETESTCD type=Char label="Incl/Excl Criterion Short Name"
col IETEST   type=Char label="Inclusion/Exclusion Criterion"
col IECAT    type=Char label="Inclusion/Exclusion Category"
---
S1 | TI | INCL01 | Age 18 or older | INCLUSION
S1 | TI | EXCL01 | Pregnant        | EXCLUSION
---
