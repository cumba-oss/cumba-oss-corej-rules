#!RuleTest
#test PMDA-SD2246 expect=violation domain=TS
#note "Row 2 is the NARMS record and spells its value out as 'TWO' instead of a whole number -> fires. Row 1 is a well-formed NARMS record and must stay clean. (Positive control added by PLAN-absent-guard-test-hardening P3: PMDA-SD2246 previously had ONLY an expect=skipped fixture, which asserts non-execution and so proved nothing about the rule ever running. Modelled on its twin FDA-SD2246.)"
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 TSPARMCD=NARMS TSVAL=TWO
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S1 | TS | 1 | NARMS | Planned Number of Arms | 2
S1 | TS | 2 | NARMS | Planned Number of Arms | TWO
