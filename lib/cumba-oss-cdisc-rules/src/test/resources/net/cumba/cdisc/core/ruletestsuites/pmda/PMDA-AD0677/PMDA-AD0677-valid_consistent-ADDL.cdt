#!RuleTest
#test PMDA-AD0677 expect=noViolation domain=ADDL
#note "Each DEVTYG1N value maps to a single DEVTYG1 value."
#library standard=adamig version=1-3
dataset ADDL
col STUDYID   type=Char
col USUBJID   type=Char
col SPDEVID   type=Char
col DEVTYG1   type=Char
col DEVTYG1N  type=Num
---
S1 | 001 | DEV01 | PUMP  | 1
S1 | 002 | DEV01 | PUMP  | 1
S1 | 003 | DEV02 | VALVE | 2
---
