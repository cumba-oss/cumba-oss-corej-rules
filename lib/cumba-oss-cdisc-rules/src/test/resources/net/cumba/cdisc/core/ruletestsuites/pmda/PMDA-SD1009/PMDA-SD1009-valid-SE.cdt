#!RuleTest
#test PMDA-SD1009 expect=noViolation domain=SE
#note "ADAPTED-FROM fda/FDA-SD1009/FDA-SD1009-valid-SE.cdt (verbatim). ETCD at the 8-character boundary (row 2) is conformant; shorter and empty values never fire."
#library standard=sdtmig version=3-4
dataset SE label="Subject Elements"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SESEQ   type=Num  label="Sequence Number"
col ETCD    type=Char label="Element Code"
---
S1 | SE | 001 | 1 | SCRN
S1 | SE | 001 | 2 | RUNINPBO
S1 | SE | 001 | 3 |
