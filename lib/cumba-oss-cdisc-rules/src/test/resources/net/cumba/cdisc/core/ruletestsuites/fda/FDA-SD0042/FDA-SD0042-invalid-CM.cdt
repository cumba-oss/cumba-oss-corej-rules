#!RuleTest
#test FDA-SD0042 expect=violation domain=CM
#note "Row 1 is pre-specified with no CMOCCUR response but CMSTAT is 'DONE' instead of 'NOT DONE' -> fires. Row 2 is the conformant pair; row 3 has CMOCCUR populated."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 CMPRESP=Y CMOCCUR= CMSTAT=DONE
dataset CM class=INTERVENTIONS label="Concomitant Medications"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col CMSEQ   type=Num  label="Sequence Number"
col CMTRT   type=Char label="Reported Name of Drug, Med, or Therapy"
col CMPRESP type=Char label="Pre-Specified"
col CMOCCUR type=Char label="Occurrence"
col CMSTAT  type=Char label="Completion Status"
---
S1 | CM | 001 | 1 | ASPIRIN   | Y |   | DONE
S1 | CM | 001 | 2 | IBUPROFEN | Y |   | NOT DONE
S1 | CM | 001 | 3 | PARACETAM | Y | Y |
