#!RuleTest
#test PMDA-SD0002 expect=violation domain=DM
#note "SUBJID is marked Required (Core='Req') but is empty on row 2 -> fires once; AGE empty on the same row is not Required and stays silent."
#library standard=sdtmig version=3-4
#library required-variables DM STUDYID DOMAIN USUBJID SUBJID SITEID SEX
#expectViolationCount 1
#expectViolationAt row=2 variable_name=SUBJID
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col SITEID  type=Char label="Study Site Identifier"
col SEX     type=Char label="Sex"
col AGE     type=Num  label="Age"
---
S1 | DM | S1-001 | 001 | 01 | M | 56
S1 | DM | S1-002 |     | 01 | F | .
