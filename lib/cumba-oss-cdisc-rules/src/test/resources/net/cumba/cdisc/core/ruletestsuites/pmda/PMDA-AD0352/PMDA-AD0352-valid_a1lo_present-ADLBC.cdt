#note "A1LO matches AyLO and yields the SAME tuple {y=1}; var_exists(\"A1LO\") is now true, so not var_exists(\"A1LO\") is false and the rule EXECUTES and stays silent. One supporting limit is enough - the sheet's 'at least one of' clause."
#library standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col A1IND   type=Char
col A1LO    type=Num
