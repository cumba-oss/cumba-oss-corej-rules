#!RuleTest
#test PMDA-AD0048 expect=skipped domain=ADLBC
#note "ADLBC is declared and detected as BDS (columns agree); the [SUBJECT LEVEL ANALYSIS DATASET] scope rejects -> skip. No *FL column, so the skip (not a fire) is what protects the contract."
#library standard=adamig version=1-3
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
---
S1 | 001 | GLUC | 100
