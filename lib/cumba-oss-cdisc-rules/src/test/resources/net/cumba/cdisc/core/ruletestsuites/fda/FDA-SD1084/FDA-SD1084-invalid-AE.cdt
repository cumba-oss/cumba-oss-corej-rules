#!RuleTest
#test FDA-SD1084 expect=violation domain=AE
#note "Row 1: AEDTC and DM.RFSTDTC complete but AEDY empty -> fires. Row 2: AEDY populated -> ok. Row 3: partial AEDTC -> ok. Row 4: subject 002 has partial RFSTDTC -> ok. Row 5: subject 003 has empty RFSTDTC -> ok."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEDTC   type=Char label="Date/Time of Collection"
col AEDY    type=Num  label="Study Day of Collection"
---
S1 | AE | 001 | 1 | HEADACHE | 2023-06-15 |
S1 | AE | 001 | 2 | NAUSEA   | 2023-06-15 | 15
S1 | AE | 001 | 3 | RASH     | 2023-06    |
S1 | AE | 002 | 1 | FATIGUE  | 2023-06-15 |
S1 | AE | 003 | 1 | DIZZINESS| 2023-06-15 |
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col RFSTDTC type=Char label="Subject Reference Start Date/Time"
---
S1 | DM | 001 | 2023-06-01
S1 | DM | 002 | 2023-06
S1 | DM | 003 |
---
