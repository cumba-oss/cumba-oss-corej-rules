#!RuleTest
#test PMDA-SD1083 expect=violation domain=LB
#note "Shipped Check var_exists(\"--DTC\") and not var_exists(\"--DY\") resolves per the EC-36 prefix rule to LBDTC/LBDY; both leaves are dataset constants -> BroadcastFold -> exactly ONE violation reported at row=1 regardless of row count."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 LBDTC=2020-01-15
dataset LB class=FINDINGS
col STUDYID type=Char
col DOMAIN  type=Char
col USUBJID type=Char
col LBSEQ   type=Num
col LBDTC   type=Char
---
S1 | LB | 001 | 1 | 2020-01-15
