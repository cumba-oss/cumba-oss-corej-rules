#!RuleTest
#test FDA-SD0014 expect=violation domain=EX
#note "Row 2 carries a negative EXDOSE (-5) -> fires. Row 1 is positive and row 3 has a zero dose, which the rule allows."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 EXDOSE=-5
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Treatment"
col EXDOSE  type=Num  label="Dose"
col EXDOSU  type=Char label="Dose Units"
---
S1 | EX | 001 | 1 | DRUG A | 10 | mg
S1 | EX | 001 | 2 | DRUG A | -5 | mg
S1 | EX | 001 | 3 | DRUG A | 0  | mg
