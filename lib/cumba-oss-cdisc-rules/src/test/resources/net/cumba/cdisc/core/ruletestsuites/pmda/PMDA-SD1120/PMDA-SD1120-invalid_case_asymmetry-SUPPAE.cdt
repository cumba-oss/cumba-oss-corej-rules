#!RuleTest
#test PMDA-SD1120 expect=violation domain=SUPPAE
#note "FRESH. Pins both halves of the case asymmetry between the rule's two branches in ONE fixture. Row 1 QNAM='aecomm' -- silent, because the QNAM branch is /.*COMM/, an uppercase-only literal, and =~ does not fold case. Row 2 QLABEL='investigator comment' -- fires, because the QLABEL branch spells the word as the explicit character class /.*[Cc][Oo][Mm][Mm][Ee][Nn][Tt]/ and therefore IS case-insensitive. Count is 1; if it comes back 2, the QNAM branch is folding case."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 QLABEL="investigator comment"
dataset SUPPAE class=RELATIONSHIP label="Supplemental Qualifiers for AE"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM     type=Char label="Qualifier Variable Name"
col QLABEL   type=Char label="Qualifier Variable Label"
col QVAL     type=Char label="Data Value"
---
CDISCPILOT01 | AE | 01-701-1015 | AESEQ | 1 | aecomm  | Investigator Note       | Ongoing at study end
CDISCPILOT01 | AE | 01-701-1015 | AESEQ | 2 | AENOTE  | investigator comment    | Resolved
