#!RuleTest
#test FDA-SE2353 expect=violation domain=EX
#note "Row 2 administers a positive dose (EXDOSE=10) but leaves the lot number empty -> fires. Row 1 records its lot, row 3 has a zero dose so nothing was administered."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=2 EXDOSE=10 EXLOT=
dataset EX class=INTERVENTIONS label="Exposure"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col EXSEQ   type=Num  label="Sequence Number"
col EXTRT   type=Char label="Name of Actual Treatment"
col EXDOSE  type=Num  label="Dose per Administration"
col EXLOT   type=Char label="Lot Number"
---
S1 | EX | 001 | 1 | TEST ARTICLE | 10 | LOT-001
S1 | EX | 001 | 2 | TEST ARTICLE | 10 |
S1 | EX | 001 | 3 | VEHICLE      | 0  |
