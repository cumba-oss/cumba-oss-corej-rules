#!RuleTest
#test PMDA-AD0223 expect=violation domain=ADLBC
#note "Row 1: AVAL-BASE = 6 but CHG = 5 -> fires. Row 2: correct -> silent. Record granularity -> 1 violation. All three values are exact integers so the 1e-10 tolerance is not in play."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015 AVAL=10 BASE=4 CHG=5
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col BASE    type=Num
col CHG     type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | 10 | 4 | 5
CDISCPILOT01 | 01-701-1023 | ALB | 10 | 4 | 6
