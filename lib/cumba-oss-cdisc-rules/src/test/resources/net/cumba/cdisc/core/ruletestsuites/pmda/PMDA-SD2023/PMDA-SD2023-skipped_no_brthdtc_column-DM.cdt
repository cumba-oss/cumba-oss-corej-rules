#!RuleTest
#test PMDA-SD2023 expect=skipped domain=DM
#note "FRESH. BRTHDTC column absent altogether -- normal de-identification practice in many regions. Requirements.Variables.All is [BRTHDTC] and the column is absent, so the engine returns SKIPPED naming the variable, before any evaluation. Asserts coreJ stays quiet about AGE rather than reporting anything."
#library standard=sdtmig version=3-4
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AGE     type=Num  label="Age"
---
S1 | DM | 001 | 45
