#!RuleTest
#test PMDA-AD0135 expect=violation domain=ADLBC
#note "Within PARAMCD=GLUC the key SHIFT1N=1 carries two distinct dependents -> flags EVERY populated row with that key (rows 1 and 2). SHIFT1N=2 is single-valued -> row 3 silent."
#library standard=adamig version=1-0
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015 PARAMCD=GLUC
#expectViolationAt row=2 USUBJID=01-701-1023 PARAMCD=GLUC
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col SHIFT1  type=Char
col SHIFT1N type=Num
---
CDISCPILOT01 | 01-701-1015 | GLUC | NORMALTOHIGH | 1
CDISCPILOT01 | 01-701-1023 | GLUC | LOWTONORMAL  | 1
CDISCPILOT01 | 01-701-1034 | GLUC | NORMALTOHIGH | 2
---
