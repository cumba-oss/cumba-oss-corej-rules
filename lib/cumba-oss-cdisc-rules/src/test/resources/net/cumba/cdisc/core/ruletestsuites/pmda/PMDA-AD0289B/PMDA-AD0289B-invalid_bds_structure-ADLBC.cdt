#!RuleTest
#test PMDA-AD0289B expect=violation domain=ADLBC
#note "DISCRIMINATING FIXTURE, half 1 of the AD0290B-F1 pair - dataset content is BYTE-IDENTICAL to PMDA-AD0290B-skipped_bds_structure-ADLBC.cdt; only rule id and expected verdict differ. AD0289B's Data_Structures.Include contains BASIC DATA STRUCTURE, so a BDS dataset IS in scope and fires: KEY=ARELN (2nd arg), key 1 carries {RELATED,UNLIKELY} -> rows 1,2. NEVER re-aim."
#library standard=adamig version=1-3
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015 AREL=RELATED ARELN=1
#expectViolationAt row=2 USUBJID=01-701-1023 AREL=UNLIKELY ARELN=1
dataset ADLBC structure=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AREL    type=Char
col ARELN   type=Num
---
CDISCPILOT01 | 01-701-1015 | ALB | RELATED  | 1
