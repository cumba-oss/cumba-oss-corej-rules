#!RuleTest
#test FDA-SD1137 expect=noViolation domain=LB
#note "Row 1 is a derived result and correctly has no collected LBORRES; row 2 is collected, so LBDRVFL is empty and the guard is false."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBORRES  type=Char label="Result or Finding in Original Units"
col LBSTRESC type=Char label="Character Result/Finding in Std Format"
col LBDRVFL  type=Char label="Derived Flag"
---
CDISCPILOT01 | LB | 01-701-1015 | 1 | CREATCLR |     | 88.2 | Y
CDISCPILOT01 | LB | 01-701-1015 | 2 | GLUC     | 5.5 | 5.5  |
