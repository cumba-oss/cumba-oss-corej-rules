#!RuleTest
#test PMDA-AD0124 expect=violation domain=ADLBC
#note "Group GLUC holds PARCAT1 {LABS x2, CHEMISTRY x1} -> row 3 is the minority. Group ALB holds one distinct value and is silent; CHEMISTRY is deliberately reused across PARAMCDs."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=003 PARAMCD=GLUC PARCAT1=CHEMISTRY
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col PARCAT1 type=Char
---
S1 | 001 | GLUC | LABS
S1 | 002 | GLUC | LABS
S1 | 003 | GLUC | CHEMISTRY
S1 | 004 | ALB  | CHEMISTRY
S1 | 005 | ALB  | CHEMISTRY
