#!RuleTest
#test PMDA-AD0018 expect=noViolation domain=ADSL
#note "AGE's dataset label is 'Age' and SEX's is 'Sex' - both equal to the Library labels -> silent."
#library standard=adamig version=1-3
#library variable-metadata ADSL AGE name=AGE label="Age" simpleDatatype=Num
#library variable-metadata ADSL SEX name=SEX label="Sex"
dataset ADSL structure=ADSL
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col AGE     type=Num  label="Age"
col SEX     type=Char label="Sex"
---
CDISCPILOT01 | 01-701-1015 | 56 | M
