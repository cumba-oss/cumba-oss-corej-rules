#!RuleTest
#test PMDA-AD0605 expect=noViolation domain=ADLBC
#note "Pins the per-row driver resolution across TWO phases in one dataset. Row 1: subject 1015, w=1 -> ADSL.PH1SDT=23000, equals PHSDT=23000 -> silent. Row 2: subject 1023, w=2 -> ADSL.PH2SDT=23100, equals PHSDT=23100 -> silent. Both subjects present in ADSL with PH1SDT=23000, PH2SDT=23100."
#library standard=adamig version=1-3
#expectViolationCount 0
dataset ADLBC structure=BDS
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col AVAL     type=Num
col APHASEN  type=Num
col PHSDT    type=Num
---
S1 | 01-701-1015 | ALB | 30 | 1 | 23000
S1 | 01-701-1023 | ALB | 31 | 2 | 23100
---

dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col PH1SDT  type=Num
col PH2SDT  type=Num
---
S1 | 01-701-1015 | 23000 | 23100
S1 | 01-701-1023 | 23000 | 23100
