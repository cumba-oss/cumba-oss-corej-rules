#!RuleTest
#test CDISC-CG0277 expect=noViolation domain=TS
# Rule:Description: Raise an error when a record exists with TSPARMCD equal to 'STYPE' and TSVAL equal to 'INTERVENTIONAL', but TSVAL is empty for the record where TSPARMCD equals 'INTMODEL'.
#note "The gate is not satisfied (STYPE=OBSERVATIONAL), so the rule cannot fire even though INTMODEL has an empty TSVAL."
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | STYPE | OBSERVATIONAL
S01 | TS | 2 | INTMODEL | 
---
