#!RuleTest
#test PMDA-SD1301 expect=skipped domain=TS
#note "Pins Scope.Domains.Include: [TD] -> SKIPPED: domain TS not in Scope.Domains.Include [TD]. TS is chosen rather than an arbitrary domain because it is the OTHER trial-design domain in this batch, so the fixture also documents that PMDA-SD1301 and PMDA-SD2247A do not overlap."
#library standard=sdtmig version=3-4
dataset TS label="Trial Summary"
col STUDYID  type=Char
col DOMAIN   type=Char
col TSSEQ    type=Num
col TSPARMCD type=Char
col TSVAL    type=Char
---
