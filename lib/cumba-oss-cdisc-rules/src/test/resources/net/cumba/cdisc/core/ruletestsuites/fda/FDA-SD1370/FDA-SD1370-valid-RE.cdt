#!RuleTest
#test FDA-SD1370 expect=noViolation domain=RE
#note "Row 1 has both RESTREFC and RESTREFN populated; row 2 leaves RESTREFC empty so the rule does not apply -> no violation."
#library standard=sdtmig version=3-4
dataset RE class=FINDINGS label="Respiratory System Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RESEQ    type=Num  label="Sequence Number"
col RETESTCD type=Char label="Respiratory Test Short Name"
col RESTREFC type=Char label="Reference Result in Standard Format"
col RESTREFN type=Num  label="Numeric Reference Result in Std Units"
---
S1 | RE | 001 | 1 | FEV1 | 3.5 | 3.5
S1 | RE | 001 | 2 | FVC  |     | .
