#!RuleTest
#test FDA-SD1034 expect=violation domain=TA
#note "The arm description 'Placebo' is coded both PBO and PLC, so a single ARM carries two planned-arm codes. Both records of the conflicting pair are reported."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 ARM=Placebo ARMCD=PBO
#expectViolationAt row=2 ARM=Placebo ARMCD=PLC
dataset TA label="Trial Arms"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col ARMCD   type=Char label="Planned Arm Code"
col ARM     type=Char label="Description of Planned Arm"
col TAETORD type=Num  label="Planned Order of Element within Arm"
col ETCD    type=Char label="Element Code"
---
S1 | TA | PBO | Placebo | 1 | SCRN
S1 | TA | PLC | Placebo | 2 | TRT
S1 | TA | ACT | Active  | 1 | SCRN
