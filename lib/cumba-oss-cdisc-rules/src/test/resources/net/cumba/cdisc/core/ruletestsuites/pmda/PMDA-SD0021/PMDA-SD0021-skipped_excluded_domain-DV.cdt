#!RuleTest
#test PMDA-SD0021 expect=skipped domain=DV
#note "DV is a member of the included EVENTS class, so ONLY the Domains.Exclude entry rejects (the SD1126 discipline). Pins PMDA's sheet-cell exclusion, which the FDA twin does not have."
#library standard=sdtmig version=3-4
dataset DV class=EVENTS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col DVSEQ    type=Num
col DVTERM   type=Char
---
S1 | DV | 001 | 1 | VISIT OUT OF WINDOW
