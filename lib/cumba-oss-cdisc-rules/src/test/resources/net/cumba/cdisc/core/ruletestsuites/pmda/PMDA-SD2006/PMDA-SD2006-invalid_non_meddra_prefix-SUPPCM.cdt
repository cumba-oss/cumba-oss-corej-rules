#!RuleTest
#test PMDA-SD2006 expect=violation domain=SUPPCM
#note "FRESH. Pins finding SD2006-F1: the regex tests only the two-letter prefix shape, never that the parent domain is an Events-class one, so a WHODrug-coded CMDECOD in SUPPCM is reported even though the rule's Source cites MedDRA coding info. SUPPCM is 6 characters beginning SUPP, so the SUPP-- token matches directly. INFO finding, no change proposed -- expected green."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 QNAM=CMDECOD
dataset SUPPCM class=RELATIONSHIP label="Supplemental Qualifiers for CM"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM     type=Char label="Qualifier Variable Name"
col QLABEL   type=Char label="Qualifier Variable Label"
col QVAL     type=Char label="Data Value"
---
CDISCPILOT01 | CM | 01-701-1015 | CMSEQ | 1 | CMDECOD | Standardized Medication Name | ASPIRIN
CDISCPILOT01 | CM | 01-701-1015 | CMSEQ | 1 | CMTRTEM | Treatment Emergent Flag      | N
