#!RuleTest
#test CDISC-CG0286 expect=noViolation domain=TS
#note "FRESH. Zero data rows. Predicted SILENT per STAGE-G CRITICAL 4 (RECORD-sensitivity, value-based, so no synthetic-table substitution), and silent on the other path too because the synthetic table carries zero columns and var_exists(\"TSPARMCD\") would be false."
#library standard=sdtmig version=3-3
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
