#!RuleTest
#test FDA-SD1127 expect=violation domain=VS
#note "The time point named '1H POST' under the same --TPTREF/VISITNUM is numbered both 1 and 2, so --TPTNUM is not constant for a given --TPT. Both records of the conflicting pair are reported."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 VSTPT="1H POST" VSTPTNUM=1
#expectViolationAt row=2 VSTPT="1H POST" VSTPTNUM=2
dataset VS class=FINDINGS label="Vital Signs"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col VSSEQ    type=Num  label="Sequence Number"
col VSTESTCD type=Char label="Vital Signs Test Short Name"
col VISITNUM type=Num  label="Visit Number"
col VSTPTREF type=Char label="Time Point Reference"
col VSTPTNUM type=Num  label="Planned Time Point Number"
col VSTPT    type=Char label="Planned Time Point Name"
col VSELTM   type=Char label="Planned Elapsed Time from Time Point Ref"
---
S1 | VS | 001 | 1 | SYSBP | 1 | DOSE | 1 | 1H POST | PT1H
S1 | VS | 002 | 1 | SYSBP | 1 | DOSE | 2 | 1H POST | PT1H
S1 | VS | 001 | 2 | SYSBP | 1 | DOSE | 3 | 3H POST | PT3H
