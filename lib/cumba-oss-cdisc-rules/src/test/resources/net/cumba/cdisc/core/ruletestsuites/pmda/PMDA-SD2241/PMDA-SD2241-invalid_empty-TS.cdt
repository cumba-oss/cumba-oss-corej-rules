#!RuleTest
#test PMDA-SD2241 expect=violation domain=TS
#note "Boundary: TSVCDREF is present but empty on the CURTRT record. 'must be UNII' is violated by an empty value just as it is by a wrong one, so the rule must fire (populated literal vs empty target => not_equal_to is true). Adapted verbatim from FDA-SD2241."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 TSPARMCD=CURTRT
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
col TSVALCD  type=Char label="Parameter Value Code"
col TSVCDREF type=Char label="Parameter Value Code Reference"
---
S1 | TS | 1 | CURTRT | Current Treatment | ASPIRIN | R16CO5Y76E |
