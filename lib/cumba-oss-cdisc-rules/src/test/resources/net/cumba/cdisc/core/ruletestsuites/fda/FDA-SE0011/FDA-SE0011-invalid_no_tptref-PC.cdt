#!RuleTest
#test FDA-SE0011 expect=violation domain=PC
#note "column-absent case (the bare empty() leaf is TRUE on every row of an absent column, absent = all-missing, EC-43; Plan B phase 4d' deleted the redundant not var_exists disjunct): PCRFTDTC is populated but the PCTPTREF column is absent from the dataset altogether -> fires."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 PCSEQ=1
dataset PC class=FINDINGS label="Pharmacokinetics Concentrations"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col PCSEQ    type=Num  label="Sequence Number"
col PCTESTCD type=Char label="Test Short Name"
col PCRFTDTC type=Char label="Date/Time of Reference Point"
---
S1 | PC | 001 | 1 | DRUGX | 2020-01-05T08:00
