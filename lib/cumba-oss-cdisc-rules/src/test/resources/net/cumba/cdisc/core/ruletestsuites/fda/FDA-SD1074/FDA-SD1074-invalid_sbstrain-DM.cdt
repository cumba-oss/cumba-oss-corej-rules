#!RuleTest
#test FDA-SD1074 expect=violation domain=DM
#note "Third listed SEND-only variable: SBSTRAIN present in an SDTM DM dataset -> fires."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt variable_name=SBSTRAIN
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SBSTRAIN type=Char label="Strain/Substrain Details"
---
S1 | DM | 001 | SPRAGUE-DAWLEY
