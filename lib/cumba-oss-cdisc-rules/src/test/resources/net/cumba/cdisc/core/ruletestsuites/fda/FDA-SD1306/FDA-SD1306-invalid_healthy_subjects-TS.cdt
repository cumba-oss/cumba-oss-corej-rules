#!RuleTest
#test FDA-SD1306 expect=violation domain=TS
#note "FDA-vs-CDISC divergence pinned: HLTSUBJI=Y and TDIGRP carries the literal 'HEALTHY SUBJECTS'. The FDA sheet allows only a null TSVAL here, so the FDA rule fires - while the cross-referenced CDISC CG0272 ('TSVAL = null or HEALTHY SUBJECTS') would not. Sheet text is authoritative for the FDA family, so firing is the intended behaviour."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 TSPARMCD=TDIGRP
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S1 | TS | 1 | HLTSUBJI | Healthy Subject Indicator | Y
S1 | TS | 2 | TDIGRP   | Diagnosis Group           | HEALTHY SUBJECTS
---
