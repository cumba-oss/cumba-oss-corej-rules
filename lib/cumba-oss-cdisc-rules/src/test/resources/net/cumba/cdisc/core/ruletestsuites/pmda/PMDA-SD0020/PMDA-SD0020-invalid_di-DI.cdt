#!RuleTest
#test PMDA-SD0020 expect=violation domain=DI
#note "FRESH - the second in-scope domain face ('--' prefix resolution on DI). Row 1 DIPARMCD=DEVTYPE (7 chars) is conformant; row 2 DIPARMCD=DEVTYPEXX (9 chars) fires. Proves the DI reach is real, not vestigial - the M2-Q1 pin's evidence carrier."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 DIPARMCD=DEVTYPEXX
dataset DI label="Device Identifiers"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col SPDEVID type=Char label="Sponsor Device Identifier"
col DISEQ   type=Num  label="Sequence Number"
col DIPARMCD type=Char label="Device Identifiers Parameter Short Name"
col DIPARM   type=Char label="Device Identifiers Parameter"
col DIVAL    type=Char label="Device Identifiers Value"
---
S1 | DI | DEV01 | 1 | DEVTYPE | Device Type | PUMP
S1 | DI | DEV01 | 2 | DEVTYPEXX | Device Type Extended | PUMP
