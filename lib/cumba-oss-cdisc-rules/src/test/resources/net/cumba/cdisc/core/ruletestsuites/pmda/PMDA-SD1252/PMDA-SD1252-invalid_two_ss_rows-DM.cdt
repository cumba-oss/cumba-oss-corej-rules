#!RuleTest
#test PMDA-SD1252 expect=violation domain=DM
#note "FRESH, DISCRIMINATING: the batch's 1:N join-expansion multiplicity pin. Subject 001 has TWO SS status records, both DEAD (e.g. re-assessment). The inner join expands the DM row into TWO evaluated rows; BOTH fire. Both violations map back to the SAME primary row and project IDENTICAL output values, so the pin is COUNT-ONLY BY NECESSITY - do not add #expectViolationAt lines."
#library standard=sdtmig version=3-4
#expectViolationCount 2
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DTHFL   type=Char label="Subject Death Flag"
---
S1 | DM | 001 | N
---

dataset SS class=FINDINGS label="Subject Status"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col SSSEQ    type=Num  label="Sequence Number"
col SSTESTCD type=Char label="Subject Status Short Name"
col SSSTRESC type=Char label="Subject Status Result in Std Format"
---
S1 | SS | 001 | 1 | SURVSTAT | DEAD
S1 | SS | 001 | 2 | SURVSTAT | DEAD
---
