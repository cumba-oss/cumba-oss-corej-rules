#!RuleTest
#test PMDA-SD1347 expect=skipped domain=AE
#note "CL-F (wave TA-4): the Requirements.Variables gate aligned to class-mate CORE-000841's [AEOUT] breadth (reporting-only - the Check's AEOUT == 'FATAL' cannot fire on an absent column either way; the gate turns silence into an auditable skip)."
#library standard=sdtmig version=3-4
dataset AE class=EVENTS label="Adverse Events"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AESEQ   type=Num  label="Sequence Number"
col AETERM  type=Char label="Reported Term for the Adverse Event"
col AEENDTC type=Char label="End Date/Time of Adverse Event"
---
S1 | AE | 001 | 1 | HEADACHE | 2020-03-10
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col DTHDTC  type=Char label="Date/Time of Death"
---
S1 | DM | 001 | 2020-03-15
