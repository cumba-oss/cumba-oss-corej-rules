#!RuleTest
#test PMDA-AD0381 expect=skipped domain=ADSL
#note "Name test -> SUBJECT LEVEL ANALYSIS DATASET. Firing data, but the Include is [BASIC DATA STRUCTURE, MEDICAL DEVICE BASIC DATA STRUCTURE] -> out of scope, not executed. Also pins that the ADSL name test beats a PARAMCD column."
#library standard=adamig version=1-3
dataset ADSL
col STUDYID  type=Char
col USUBJID  type=Char
col PARAMCD  type=Char
col BTOXGR   type=Char
col BTOXGRN  type=Num
---
CDISCPILOT01 | 01-701-1015 | GLUC | GRADE3 | 3
