#!RuleTest
#test PMDA-AD0132 expect=violation domain=ADDV
#note "PARAMCD/AVAL detect BDS, SPDEVID specialises to MEDICAL DEVICE BDS; detectAll returns both so the rule is in scope through the MDBDS Include token."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-701-1015 AVAL=10 BASE=5 R2BASE=3
dataset ADDV
col STUDYID type=Char
col USUBJID type=Char
col SPDEVID type=Char
col PARAMCD type=Char
col AVAL    type=Num
col BASE    type=Num
col R2BASE  type=Num
---
CDISCPILOT01 | 01-701-1015 | DEV1 | ALB | 10 | 5 | 3
---
