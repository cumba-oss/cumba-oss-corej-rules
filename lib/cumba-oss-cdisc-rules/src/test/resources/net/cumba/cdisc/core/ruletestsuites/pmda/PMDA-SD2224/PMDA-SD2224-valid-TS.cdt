#!RuleTest
#test PMDA-SD2224 expect=noViolation domain=TS
#note "ADAPTED-FROM fda/FDA-SD2224/FDA-SD2224-valid-TS.cdt, MINOR-STRENGTHENED: row 3's TSVAL is BLANK. The filter matches TSPARMCD only, so both FCNTRY rows count ($fcntry_count=2) and the rule stays silent. Pins the record-present reading (SD2224-F1)."
#library standard=sdtmig version=3-4
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | TITLE  | Trial Title | A Phase 3 Study of Drug X in Subjects With Condition Y
S01 | TS | 2 | FCNTRY | Planned Country of Investigational Sites | USA
S01 | TS | 3 | FCNTRY | Planned Country of Investigational Sites |
