#!RuleTest
#test PMDA-SD1036 expect=skipped domain=LB
#note "No LBTOXGR column at all; Requirements.Variables.All [--TOX, --TOXGR] rejects -> auditable skip, even though LBTOX is populated. The encoding that makes EC-43's absent-vs-empty question moot for this rule."
#library standard=sdtmig version=3-4
dataset LB class=FINDINGS
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col LBSEQ    type=Num
col LBTESTCD type=Char
col LBTOX    type=Char
---
S1 | LB | 001 | 1 | ALT | Hepatotoxicity
