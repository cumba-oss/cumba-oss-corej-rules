#!RuleTest
#test PMDA-SD1450 expect=skipped domain=CV
#note "SCOPE-GATE skip on the DOMAIN axis: PMDA-SD1450 declares Scope.Domains.Include [PP] because its own sheet's Domains cell reads 'PP', while the cross-family twin FDA-SD1450 covers [CV, EG, PP, RE] with the generic --STINT/--ENINT pair and would fire on this fixture. Pins the deliberate PMDA narrowing."
#library standard=sdtmig version=3-4
dataset CV class=FINDINGS label="Cardiovascular System Findings"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col CVSEQ    type=Num
col CVTESTCD type=Char
col CVSTINT  type=Char
---
CDISCPILOT01 | CV | 01-701-1015 | 1 | EJECFRAC | PT0H
