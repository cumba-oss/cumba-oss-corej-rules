#!RuleTest
#test PMDA-SD1282 expect=violation domain=PC
#note "All four presence leaves are dataset constants (not var_exists x3 on the absent trio --ELTM/--TPTNUM/--TPT, var_exists on PCTPTREF) -> broadcast fires ONCE at row=1."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 PCTPTREF="MOST RECENT DOSE"
dataset PC class=FINDINGS label="Pharmacokinetic Concentrations"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col PCSEQ    type=Num
col PCTESTCD type=Char
col PCTPTREF type=Char
---
S1 | PC | 001 | 1 | DRUGA | MOST RECENT DOSE
---
