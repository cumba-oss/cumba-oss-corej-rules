#!RuleTest
#test CDISC-SEND-0049 expect=violation domain=MA
#note "The strictness ratchet on the carve-out's token split. Row 1 (LEFT;RIGHT) is the lawful control and stays silent. The other three are malformed and all report, because every token is compared to the codelist exactly: row 2 carries an internal space so the second token is ' RIGHT', not 'RIGHT'; row 3 ends in the delimiter, which yields a trailing empty token; row 4 doubles the delimiter, which yields an empty middle token. An empty string is not a published term. THIS FIXTURE IS THE RED for a tidy-up that widens the carve-out invisibly - trimming tokens, discarding empty tokens, or dropping the split's negative limit (which is what keeps the trailing empty, for parity with the reference engine) would each silence one or more of these rows and no other scenario would notice."
#library standard=sendig version=3-1-1
#library variable-metadata MA MALAT codelist=LAT codelist_extensible=true codelist_coded_values="[\"LEFT\",\"RIGHT\",\"BILATERAL\"]"
#expectViolationCount 3
#expectViolationAt variable_name=MALAT variable_value="LEFT; RIGHT"
#expectViolationAt variable_name=MALAT variable_value=LEFT;
#expectViolationAt variable_name=MALAT variable_value=LEFT;;RIGHT
dataset MA class=FINDINGS label="Macroscopic Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col MASEQ    type=Num  label="Sequence Number"
col MATESTCD type=Char label="Macroscopic Examination Short Name"
col MALAT    type=Char label="Laterality"
---
S1 | MA | 001 | 1 | GMACROS | LEFT;RIGHT
S1 | MA | 002 | 2 | GMACROS | LEFT; RIGHT
S1 | MA | 003 | 3 | GMACROS | LEFT;
S1 | MA | 004 | 4 | GMACROS | LEFT;;RIGHT
