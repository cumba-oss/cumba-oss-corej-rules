#!RuleTest
#test CDISC-AD0647 expect=violation domain=ADAE
# Rule:Description: TREMxxFL is Y but TRTEMFL is not Y
#note "TREM01FL=Y and TRTEMFL!=Y -> violation"
#expectViolationCount 1
#expectViolationAt row=1
# Declared-tier scope: the class= declaration disagrees with the columns, so #define must
# carry it to RuleRunner (ScenarioDeclaredScopeProvider.install).
#define standard=adamig version=1-3
dataset ADAE class=OCCDS
col STUDYID type=Char
col USUBJID type=Char
col ASEQ type=Num
col TREM01FL type=Char
col TRTEMFL type=Char
---
CDISCPILOT01 | 01-701-1015 | 1 | Y | N
---
