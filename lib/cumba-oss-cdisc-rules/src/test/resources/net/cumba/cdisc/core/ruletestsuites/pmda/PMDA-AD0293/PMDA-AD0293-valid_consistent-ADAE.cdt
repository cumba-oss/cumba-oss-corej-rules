#!RuleTest
#test PMDA-AD0293 expect=noViolation domain=ADAE
#note "Row 2 AETOXGR changed to GRADE1 (matching row 1): each AETOXGRN maps to exactly one AETOXGR -> rule executes, stays silent."
#library standard=adamig version=1-0
dataset ADAE structure=OCCDS subclass=AE
col STUDYID  type=Char
col USUBJID  type=Char
col AESEQ    type=Num
col AEDECOD  type=Char
col AETOXGR  type=Char
col AETOXGRN type=Num
---
CDISCPILOT01 | 01-701-1015 | 1 | HEADACHE | GRADE1 | 1
CDISCPILOT01 | 01-701-1023 | 1 | NAUSEA | GRADE1 | 1
CDISCPILOT01 | 01-701-1034 | 2 | RASH | GRADE3 | 3
