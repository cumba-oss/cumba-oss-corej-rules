#!RuleTest
#test PMDA-SD1309 expect=violation domain=TS
#note "ADAPTED-FROM the CDISC-CG0276 sister fixture: two TRT records, both with an empty TSVAL -> TWO findings (pins the per-ROW record granularity)."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=2 TSSEQ=2
#expectViolationAt row=3 TSSEQ=3
dataset TS label="Trial Summary"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col TSSEQ    type=Num  label="Sequence Number"
col TSPARMCD type=Char label="Trial Summary Parameter Short Name"
col TSPARM   type=Char label="Trial Summary Parameter"
col TSVAL    type=Char label="Parameter Value"
---
S01 | TS | 1 | STYPE | Study Type                           | INTERVENTIONAL
S01 | TS | 2 | TRT   | Investigational Therapy or Treatment |
S01 | TS | 3 | TRT   | Investigational Therapy or Treatment |
S01 | TS | 4 | TITLE | Trial Title                          | A Study of Drug X
