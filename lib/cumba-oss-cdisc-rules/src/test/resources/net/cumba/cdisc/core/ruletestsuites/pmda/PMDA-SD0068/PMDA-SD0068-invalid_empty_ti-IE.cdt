#!RuleTest
#test PMDA-SD0068 expect=violation domain=IE
#note "FRESH (DISCRIMINATING - distinct EmptyResult.SET, negative polarity). TI PRESENT with ZERO data rows (full column set incl. IETESTCD declared); IE rows: (1) 001|1|INCL01, (2) 002|1|EXCL01, both populated. $ti_ietestcd = EMPTY SET -> every IETESTCD is 'not in' it -> BOTH rows fire. If this reports 0, escalate (would mean a missing-$ saturation, refuting EmptyResult.SET)."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=1 IETESTCD=INCL01
#expectViolationAt row=2 IETESTCD=EXCL01
dataset IE class=FINDINGS label="Inclusion/Exclusion Criteria Not Met"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IESEQ    type=Num  label="Sequence Number"
col IETESTCD type=Char label="Incl/Excl Criterion Short Name"
col IETEST   type=Char label="Inclusion/Exclusion Criterion"
---
S1 | IE | 001 | 1 | INCL01 | Age 18 or older
S1 | IE | 002 | 1 | EXCL01 | Pregnant
---

dataset TI class="TRIAL DESIGN" label="Trial Inclusion/Exclusion Criteria"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col IETESTCD type=Char label="Incl/Excl Criterion Short Name"
col IETEST   type=Char label="Inclusion/Exclusion Criterion"
col IECAT    type=Char label="Inclusion/Exclusion Category"
---
