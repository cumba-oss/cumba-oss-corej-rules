#!RuleTest
#test PMDA-AD0125 expect=violation domain=ADLBC
#note "Group PARCAT1N=1 holds PARCAT1 {VITALS x2, VITALSIGNS x1} -> row 3 is the minority. Group 2 is consistent."
#library standard=adamig version=1-0
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=003 PARCAT1=VITALSIGNS PARCAT1N=1
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col PARCAT1 type=Char
col PARCAT1N type=Num
---
S1 | 001 | SYSBP | VITALS     | 1
S1 | 002 | SYSBP | VITALS     | 1
S1 | 003 | SYSBP | VITALSIGNS | 1
S1 | 004 | ALB   | CHEMISTRY  | 2
S1 | 005 | ALB   | CHEMISTRY  | 2
