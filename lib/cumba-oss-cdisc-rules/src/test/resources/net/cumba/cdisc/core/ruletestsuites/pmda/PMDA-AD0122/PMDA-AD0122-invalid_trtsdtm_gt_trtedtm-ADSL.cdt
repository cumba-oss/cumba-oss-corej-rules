#!RuleTest
#test PMDA-AD0122 expect=violation domain=ADSL
#note "SAS datetime numbers. Expansion: ^(.+)SDTM$ -> TRTSDTM root 'TRT'; ^(.+)EDTM$ -> TRTEDTM root 'TRT'; ONE tuple. TRTSDT/TRTEDT deliberately NOT declared here - they do not match these patterns, but keeping the fixture to the pair makes the arithmetic self-evident. ONE violation on row 1."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 TRTSDTM=1900800000 TRTEDTM=1895000000
dataset ADSL structure=ADSL
col STUDYID type=Char
col USUBJID type=Char
col TRTSDTM type=Num
col TRTEDTM type=Num
---
CDISCPILOT01 | 01-701-1015 | 1900800000 | 1895000000
