#!RuleTest
#test PMDA-AD0250 expect=skipped domain=ADSL
#note "Firing data - EVNTDESC declared, CNSR absent - on an ADSL dataset. structure=ADSL is the DECLARED tier and beats the columns (Fix #154), and SUBJECT LEVEL ANALYSIS DATASET is not in Scope.Data_Structures (BDS / MEDICAL DEVICE BDS), so the rule is out of scope and never runs. The mandatory #library line is the carrier for the declaration."
#library standard=adamig version=1-3
dataset ADSL structure=ADSL
col STUDYID  type=Char
col USUBJID  type=Char
col AGE      type=Num
col EVNTDESC type=Char
---
CDISCPILOT01 | 01-701-1015 | 63 | DEATH
CDISCPILOT01 | 01-701-1023 | 47 | ALIVE
