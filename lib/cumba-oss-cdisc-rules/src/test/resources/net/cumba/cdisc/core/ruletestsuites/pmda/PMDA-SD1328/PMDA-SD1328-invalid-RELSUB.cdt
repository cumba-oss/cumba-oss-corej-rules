#!RuleTest
#test PMDA-SD1328 expect=violation domain=RELSUB
#note "Row 2 relates a subject to itself: RSUBJID repeats USUBJID '01-701-1023' -> fires."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 RSUBJID=01-701-1023
dataset RELSUB label="Related Subjects"
col STUDYID type=Char label="Study Identifier"
col USUBJID type=Char label="Unique Subject Identifier"
col POOLID  type=Char label="Pool Identifier"
col RSUBJID type=Char label="Related Subject or Pool Identifier"
col SREL    type=Char label="Subject Relationship"
---
