#!RuleTest
#test CDISC-AD0330 expect=violation domain=ADLBC
# Rule:Description: Within a parameter, there is more than one value of BASECAyN for a given value of BASECATy, considering only those rows on which both variables are populated
#note "within PARAMCD=ALB, BASECAT1=1 maps to 2 distinct BASECA1N values -> violation"
#expectViolationCount 2
#expectViolationAt row=1 USUBJID=01-701-1015
#expectViolationAt row=2 USUBJID=01-701-1023
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col BASECA1N type=Char
col BASECAT1 type=Char
---
CDISCPILOT01 | 01-701-1015 | ALB | low | 1
CDISCPILOT01 | 01-701-1023 | ALB | high | 1
---
