#!RuleTest
#test PMDA-SD1150 expect=skipped domain=TI
#note "Requirements.Variables.All: [IETEST] skips the dataset and names the absent variable. IETEST is Required in TI, so its absence is a structural defect another rule reports."
#library standard=sdtmig version=3-4
dataset TI
col STUDYID  type=Char
col DOMAIN   type=Char
col IETESTCD type=Char
col TIVERS   type=Char
---
S1 | TI | INCL01 | 1
