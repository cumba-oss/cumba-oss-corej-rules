#!RuleTest
#test FDA-SE2263 expect=noViolation domain=TP
#note "TPSTGORD is unique within each RPATHCD; order 1 recurs across paths P1/P2, which is allowed -> no violation."
#library standard=sendig-dart version=1-1
dataset TP class="TRIAL DESIGN"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col RPATHCD  type=Char label="Planned Repro Path Code"
col TPSTGORD type=Num  label="Order of Repro Stage within Repro Path"
col RSTGCD   type=Char label="Planned Repro Stage Code"
---
S1 | TP | P1 | 1 | MAT
S1 | TP | P1 | 2 | GES
S1 | TP | P2 | 1 | MAT
