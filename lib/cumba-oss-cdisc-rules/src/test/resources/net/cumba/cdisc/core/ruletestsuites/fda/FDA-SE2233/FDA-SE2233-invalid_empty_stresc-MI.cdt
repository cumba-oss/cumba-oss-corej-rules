#!RuleTest
#test FDA-SE2233 expect=violation domain=MI
#note "any-branch 1: the record was not done (MISTRESC empty, MISTAT='NOT DONE') yet carries a MIRESCAT -> fires on row 1."
#library standard=sendig version=3-1-1
#expectViolationCount 1
#expectViolationAt row=1 MISTRESC= MIRESCAT=INFLAMMATION
dataset MI label="Microscopic Findings"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col MISEQ    type=Num  label="Sequence Number"
col MITESTCD type=Char label="Microscopic Examination Short Name"
col MISTRESC type=Char label="Standardized Result in Standard Format"
col MIRESCAT type=Char label="Result Category"
col MISTAT   type=Char label="Completion Status"
col MISPEC   type=Char label="Specimen Material Type"
---
STUDY01 | MI | STUDY01-001 | 1 | MIEXAM |        | INFLAMMATION | NOT DONE | KIDNEY
STUDY01 | MI | STUDY01-001 | 2 | MIEXAM | NORMAL |              |          | LIVER
