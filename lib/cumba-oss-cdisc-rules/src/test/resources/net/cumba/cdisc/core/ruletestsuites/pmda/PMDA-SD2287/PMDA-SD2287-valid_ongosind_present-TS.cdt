#!RuleTest
#test PMDA-SD2287 expect=noViolation domain=TS
#note "$ongosind_count = 1 -> no fire. The filter matches TSPARMCD exactly; TSVAL's value is irrelevant to this rule."
#library standard=sdtmig version=3-4
dataset TS class="TRIAL DESIGN" label="Trial Summary"
col STUDYID  type=Char
col DOMAIN   type=Char
col TSSEQ    type=Num
col TSPARMCD type=Char
col TSPARM   type=Char
col TSVAL    type=Char
---
S1 | TS | 1 | ONGOSIND | Ongoing Study Indicator | Y
S1 | TS | 2 | TITLE    | Trial Title             | StudyX
