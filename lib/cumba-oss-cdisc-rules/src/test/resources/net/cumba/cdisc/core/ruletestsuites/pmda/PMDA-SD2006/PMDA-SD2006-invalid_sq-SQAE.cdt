#!RuleTest
#test PMDA-SD2006 expect=violation domain=SQAE
#note "FRESH. Pins the SECOND Domains.Include token: 'SQAE' is 4 characters beginning 'SQ', which is exactly what SQ-- means (ScopeMatcher, prefix + 2 characters, matched against the raw dataset name). No DOMAIN column, copying the in-tree SQ-- precedent pmda/PMDA-SD1365/PMDA-SD1365-invalid_sq_dataset-SQDM.cdt exactly."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=2 QNAM=AEDECOD
dataset SQAE label="Supplemental Qualifiers for AE"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM     type=Char label="Qualifier Variable Name"
col QLABEL   type=Char label="Qualifier Variable Label"
col QVAL     type=Char label="Data Value"
---
CDISCPILOT01 | AE | 01-701-1015 | AESEQ | 1 | AETRTEM | Treatment Emergent Flag | Y
CDISCPILOT01 | AE | 01-701-1015 | AESEQ | 1 | AEDECOD | Dictionary-Derived Term | Headache
