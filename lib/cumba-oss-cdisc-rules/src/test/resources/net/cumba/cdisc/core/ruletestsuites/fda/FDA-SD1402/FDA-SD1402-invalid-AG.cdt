#!RuleTest
#test FDA-SD1402 expect=violation domain=AG
#note "Row 1: AGENDTC 2020-01-21 is after DM.RFCENDTC 2020-01-20 -> fires. Row 2: equal -> clean (rule is strictly after). Row 3: before -> clean. Row 4: AGENDTC empty -> clean. Row 5: subject 002 whose RFCENDTC is empty -> clean (date comparison against a null reference does not fire)."
#library standard=sendig version=ar-1-0
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001
dataset AG class=INTERVENTIONS label="Procedure Agents"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col AGSEQ   type=Num  label="Sequence Number"
col AGTRT   type=Char label="Reported Name of Agent"
col AGENDTC type=Char label="End Date/Time of Agent"
---
S1 | AG | 001 | 1 | OVALBUMIN | 2020-01-21
S1 | AG | 001 | 2 | OVALBUMIN | 2020-01-20
S1 | AG | 001 | 3 | OVALBUMIN | 2020-01-10
S1 | AG | 001 | 4 | OVALBUMIN |
S1 | AG | 002 | 1 | OVALBUMIN | 2020-05-01
---

dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col RFCENDTC type=Char label="Date/Time of Last Challenge Agent Admin"
---
S1 | DM | 001 | 2020-01-20
S1 | DM | 002 |
---
