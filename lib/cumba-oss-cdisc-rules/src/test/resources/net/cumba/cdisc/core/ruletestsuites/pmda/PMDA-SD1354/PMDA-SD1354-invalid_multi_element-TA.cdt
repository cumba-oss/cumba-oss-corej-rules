#!RuleTest
#test PMDA-SD1354 expect=violation domain=TA
#note "Documents the Record-sensitivity granularity: TA is one record per planned Element per Arm, so the single unassigned arm XANLO (two elements) yields two findings, one per TA record."
#library standard=sdtmig version=3-4
#expectViolationCount 2
#expectViolationAt row=2 ARMCD=XANLO
#expectViolationAt row=3 ARMCD=XANLO
dataset TA label="Trial Arms"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col ARMCD    type=Char label="Planned Arm Code"
col ARM      type=Char label="Description of Planned Arm"
col TAETORD  type=Num  label="Planned Order of Element within Arm"
col ETCD     type=Char label="Element Code"
col EPOCH    type=Char label="Epoch"
---
CDISCPILOT01 | TA | PBO   | Placebo        | 1 | SCRN | SCREENING
CDISCPILOT01 | TA | XANLO | Xanomeline Low | 1 | SCRN | SCREENING
CDISCPILOT01 | TA | XANLO | Xanomeline Low | 2 | TRT  | TREATMENT
---

dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARMCD    type=Char label="Planned Arm Code"
col ARM      type=Char label="Description of Planned Arm"
---
CDISCPILOT01 | DM | 01-001 | PBO | Placebo
---
