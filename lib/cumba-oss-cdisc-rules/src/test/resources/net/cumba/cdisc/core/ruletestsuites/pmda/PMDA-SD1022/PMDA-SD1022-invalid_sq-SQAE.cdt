#!RuleTest
#test PMDA-SD1022 expect=violation domain=SQAE
#note "FRESH. Exercises the second Scope.Domains token. The dataset name MUST be exactly four characters (STAGE-G CRITICAL 2). If it comes back SKIPPED that is a stage-R classification - escalate, do not rewrite."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 QNAM=1AESER
dataset SQAE class=RELATIONSHIP label="Supplemental Qualifiers for AE (split)"
col STUDYID  type=Char label="Study Identifier"
col RDOMAIN  type=Char label="Related Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IDVAR    type=Char label="Identifying Variable"
col IDVARVAL type=Char label="Identifying Variable Value"
col QNAM     type=Char label="Qualifier Variable Name"
col QLABEL   type=Char label="Qualifier Variable Label"
col QVAL     type=Char label="Data Value"
---
CDISCPILOT01 | AE | 01-701-1015 | AESEQ | 1 | 1AESER  | Serious Event           | N
CDISCPILOT01 | AE | 01-701-1015 | AESEQ | 2 | AETRTEM | Treatment Emergent Flag | Y
