#!RuleTest
#test PMDA-AD0098 expect=violation domain=ADLBC
#note "Expansion: ^(.+)SDY$ -> ASDY root 'A'; ^(.+)EDY$ -> AEDY root 'A'; ONE tuple, ONE expansion not empty(ASDY) and not empty(AEDY) and ASDY > AEDY. Both populated and start > end -> record-level violation on row 1. Both pinned columns are Output_Variables and compare numerically."
#library standard=adamig version=1-3
#expectViolationCount 1
#expectViolationAt row=1 ASDY=100 AEDY=50
dataset ADLBC class=BDS
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col ASDY    type=Num
col AEDY    type=Num
---
CDISCPILOT01 | 01-701-1015 | GLUC | 100 | 50
