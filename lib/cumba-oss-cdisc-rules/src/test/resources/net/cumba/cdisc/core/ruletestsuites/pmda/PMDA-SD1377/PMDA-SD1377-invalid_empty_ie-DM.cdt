#!RuleTest
#test PMDA-SD1377 expect=violation domain=DM
#note "FRESH - distinct-EmptyResult-SET pin: IE is DECLARED with the full twin column set and ZERO data rows, so $ie_usubjid is an EMPTY set. Subject 01-001 (SCREEN FAILURE) is not in it -> fires. DISCRIMINATING: a 0-report here would mean distinct's EmptyResult saturates to missing instead of an empty set - escalate."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=01-001
dataset DM label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ARMCD    type=Char label="Planned Arm Code"
col ARMNRS   type=Char label="Reason Arm and/or Actual Arm is Null"
---
CDISCPILOT01 | DM | 01-001 |     | SCREEN FAILURE
---

dataset IE label="Inclusion/Exclusion Criteria Not Met"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IESEQ    type=Num  label="Sequence Number"
col IETESTCD type=Char label="Inclusion/Exclusion Criterion Short Name"
col IECAT    type=Char label="Inclusion/Exclusion Category"
---
---
