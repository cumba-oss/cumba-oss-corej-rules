#!RuleTest
#test PMDA-SD2238 expect=noViolation domain=CM
#note "No CMSTDTC column. The authored var_exists(\"--STDTC\") guard is FALSE -> the rule EXECUTES and reports nothing (silent noViolation WITH execution) even though STTPT values disagree - the authored-guard face of the silence trichotomy, vs the [--STTPT] gate's auditable skip below. (Requirements.Variables gates only --STTPT, which is present.)"
#library standard=sdtmig version=3-4
dataset CM class=INTERVENTIONS label="Concomitant Medications"
col STUDYID  type=Char
col DOMAIN   type=Char
col USUBJID  type=Char
col CMSEQ    type=Num
col CMTRT    type=Char
col CMSTTPT  type=Char
---
S1 | CM | 001 | 1 | ASPIRIN   | SCREENING
S1 | CM | 001 | 2 | IBUPROFEN | RANDOMIZATION
---
