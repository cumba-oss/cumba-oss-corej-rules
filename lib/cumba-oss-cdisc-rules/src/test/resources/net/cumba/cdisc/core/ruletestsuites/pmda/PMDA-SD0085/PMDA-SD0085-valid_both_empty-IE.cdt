#!RuleTest
#test PMDA-SD0085 expect=noViolation domain=IE
#note "FRESH: row 1 has BOTH IEORRES and IESTRESC blank; row 2 agrees. Predicted noViolation on both rows: the character comparison is literal and both-empty matches, so '!=' is false. This is a contract pin, not a conformance claim -- both variables are Req, so a blank pair is itself a defect, and the point of the fixture is that SD0085 deliberately does not report it a second time."
#library standard=sdtmig version=3-4
dataset IE class=FINDINGS label="Inclusion/Exclusion Criteria Not Met"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col IESEQ    type=Num  label="Sequence Number"
col IETESTCD type=Char label="Inclusion/Exclusion Criterion Short Name"
col IECAT    type=Char label="Inclusion/Exclusion Category"
col IEORRES  type=Char label="I/E Criterion Original Result"
col IESTRESC type=Char label="I/E Criterion Result in Std Format"
---
S1 | IE | 001 | 1 | EXCL01 | EXCLUSION |  |
S1 | IE | 002 | 1 | INCL01 | INCLUSION | N | N
