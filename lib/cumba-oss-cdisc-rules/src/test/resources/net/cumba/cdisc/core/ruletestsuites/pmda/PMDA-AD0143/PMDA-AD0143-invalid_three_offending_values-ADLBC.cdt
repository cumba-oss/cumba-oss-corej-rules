#!RuleTest
#test PMDA-AD0143 expect=violation domain=ADLBC
#note "Row 1 'gluc' - lower-case FIRST character, fails [A-Z_]; row 2 'TOOLONGCD' - NINE characters, one more than the {0,7} tail allows; row 3 'GLU-C' - the hyphen is outside [A-Za-z0-9_]; row 4 'GLUC' - conformant. Three of four rows fire, which pins RECORD granularity."
#library standard=adamig version=1-3
#expectViolationCount 3
#expectViolationAt row=1 PARAMCD=gluc
#expectViolationAt row=2 PARAMCD=TOOLONGCD
#expectViolationAt row=3 PARAMCD=GLU-C
dataset ADLBC
col STUDYID type=Char
col USUBJID type=Char
col PARAMCD type=Char
col AVAL    type=Num
---
CDISCPILOT01 | 01-701-1015 | gluc | 5.5
CDISCPILOT01 | 01-701-1023 | TOOLONGCD | 5.6
CDISCPILOT01 | 01-701-1034 | GLU-C | 5.7
CDISCPILOT01 | 01-701-1040 | GLUC | 5.8
