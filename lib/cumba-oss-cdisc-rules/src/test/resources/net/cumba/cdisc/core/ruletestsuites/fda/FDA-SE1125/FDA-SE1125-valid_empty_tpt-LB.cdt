#!RuleTest
#test FDA-SE1125 expect=noViolation domain=LB
#note "Guard boundary: the two records with differing --ELTM leave --TPT empty. --TPT is both the non_empty guard and part of the consistency key, so an unpopulated time point takes the record out of the check entirely and nothing is reported."
#library standard=sendig version=3-1-1
dataset LB class=FINDINGS label="Laboratory Test Results"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col LBSEQ    type=Num  label="Sequence Number"
col LBTESTCD type=Char label="Lab Test or Examination Short Name"
col LBCAT    type=Char label="Category for Lab Test"
col LBTPTREF type=Char label="Time Point Reference"
col LBTPT    type=Char label="Planned Time Point Name"
col LBELTM   type=Char label="Planned Elapsed Time from Time Point Ref"
---
S1 | LB | 001 | 1 | ALB | CHEMISTRY | DOSE 1 |  | PT1H
S1 | LB | 002 | 1 | ALB | CHEMISTRY | DOSE 1 |  | PT60M
S1 | LB | 003 | 1 | ALB | CHEMISTRY | DOSE 1 | 2H POST | PT2H
