#!RuleTest
#test FDA-SD0055 expect=noViolation domain=QS1
#note "Fix #373 control — the same split member with a CONFORMANT type. Proves the new tier-2 resolution does not over-fire: it must resolve the Library type and then agree with it, not fire merely because the member name is unknown."
#library standard=sdtmig version=3-4
#library variable-metadata QS QSORRES  name=QSORRES  simpleDatatype=Char label="Finding in Original Units"
#library variable-metadata QS QSTESTCD name=QSTESTCD simpleDatatype=Char label="Question Short Name"
dataset QS1 class=FINDINGS label="Questionnaires - Part 1"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col QSTESTCD type=Char label="Question Short Name"
col QSORRES  type=Char label="Finding in Original Units"
---
S1 | QS | 001 | ADAS01 | LOW
