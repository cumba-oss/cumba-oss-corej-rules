#!RuleTest
#test FDA-SE2269 expect=noViolation domain=DS
#note "Rows 1-2: scheduled dispositions (TERMINAL SACRIFICE, REMOVED FROM STUDY ALIVE) leave DSUSCHFL empty. Row 3: MORIBUND SACRIFICE is an unscheduled disposition, so its DSUSCHFL='Y' is correct."
#library standard=sendig version=3-1-1
dataset DS label="Disposition"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col DSSEQ    type=Num  label="Sequence Number"
col DSTERM   type=Char label="Reported Term for the Disposition Event"
col DSDECOD  type=Char label="Standardized Disposition Term"
col DSUSCHFL type=Char label="Unscheduled Flag"
col DSSTDTC  type=Char label="Start Date/Time of Disposition Event"
---
STUDY01 | DS | STUDY01-001 | 1 | Terminal sacrifice        | TERMINAL SACRIFICE       |   | 2020-03-01
STUDY01 | DS | STUDY01-002 | 1 | Removed from study alive  | REMOVED FROM STUDY ALIVE |   | 2020-03-01
STUDY01 | DS | STUDY01-003 | 1 | Moribund sacrifice        | MORIBUND SACRIFICE       | Y | 2020-02-11
