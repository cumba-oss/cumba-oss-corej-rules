#!RuleTest
#test FDA-SE0070 expect=noViolation domain=DM
#note "Both subjects with ARMCD populated have an EX record; subject 00A3 has no EX record but ARMCD is empty, which the sheet names as the permitted exception -> no violation."
#library standard=sendig version=3-1-1
dataset DM label="Demographics"
col STUDYID type=Char label="Study Identifier"
col DOMAIN  type=Char label="Domain Abbreviation"
col USUBJID type=Char label="Unique Subject Identifier"
col SUBJID  type=Char label="Subject Identifier for the Study"
col SEX     type=Char label="Sex"
col ARMCD   type=Char label="Planned Arm Code"
col SETCD   type=Char label="Set Code"
---
STUDY01 | DM | 00A1 | A1 | M | 1 | S1
STUDY01 | DM | 00A2 | A2 | F | 2 | S2
STUDY01 | DM | 00A3 | A3 | M |   | S3
---

dataset EX label="Exposure"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col EXSEQ    type=Num  label="Sequence Number"
col EXTRT    type=Char label="Name of Actual Treatment"
col EXDOSFRQ type=Char label="Dosing Frequency Per Interval"
col EXROUTE  type=Char label="Route of Administration"
---
STUDY01 | EX | 00A1 | 1 | VEHICLE | QD | ORAL
STUDY01 | EX | 00A2 | 1 | TESTART | QD | ORAL
---
