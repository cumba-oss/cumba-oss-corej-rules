#!RuleTest
#test PMDA-SD1358 expect=violation domain=DM
#note "Row 1 leaves ACTARMCD and ACTARM empty without populating ARMNRS -> fires. Row 2 is fully populated; row 3 supplies the ARMNRS reason. Adapted verbatim from FDA-SD1358 (byte-identical Check/Scope)."
#library standard=sdtmig version=3-4
#expectViolationCount 1
#expectViolationAt row=1 USUBJID=001 ARMNRS=
dataset DM class="SPECIAL PURPOSE" label="Demographics"
col STUDYID  type=Char label="Study Identifier"
col DOMAIN   type=Char label="Domain Abbreviation"
col USUBJID  type=Char label="Unique Subject Identifier"
col ACTARMCD type=Char label="Actual Arm Code"
col ACTARM   type=Char label="Description of Actual Arm"
col ARMNRS   type=Char label="Reason Arm and/or Actual Arm is Null"
---
S1 | DM | 001 |   |             |
S1 | DM | 002 | A | Treatment A |
S1 | DM | 003 |   |             | NOT ASSIGNED
