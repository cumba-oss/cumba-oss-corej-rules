#!RuleTest
#test PMDA-AD0236 expect=violation domain=ADSL
#note "Mirror roles of AD0235: key TR01AG1, target TR01AG1N. Group POOLA holds {1 x2, 3 x1} -> row 3 is the minority."
#library standard=adamig version=1-0
#expectViolationCount 1
#expectViolationAt row=3 USUBJID=003 TR01AG1=POOLA TR01AG1N=3
dataset ADSL
col STUDYID type=Char
col USUBJID type=Char
col TR01AG1  type=Char
col TR01AG1N type=Num
---
S1 | 001 | POOLA | 1
S1 | 002 | POOLA | 1
S1 | 003 | POOLA | 3
S1 | 004 | POOLB | 2
S1 | 005 | POOLB | 2
