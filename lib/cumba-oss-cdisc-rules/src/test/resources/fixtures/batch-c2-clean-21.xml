<?xml version="1.0" encoding="UTF-8"?>
<!-- Batch C2 (deref-guarded ItemGroupDef rules 105, 106, 251, 252) clean 2.1 fixture:
     every batch-C2 rule executes with zero findings. Proves guard selectivity in the
     non-firing direction from compliant shapes:
       IG.DM   - SDTMIG-bound, Domain + Purpose="Tabulation" (105/251 guards pass, checks pass)
       IG.EX   - SENDIG-bound, Domain + Purpose="Tabulation" (proves the SEND branch)
       IG.ADSL - ADaMIG-bound, no Domain, Purpose="Analysis" (106/252 guards pass, checks pass;
                 105/251 guards reject an ADaM dataset even though it has no Domain and a
                 non-"Tabulation" Purpose)
       IG.XX   - no def:StandardOID, no Domain, Purpose="Analysis" (every guard rejects it;
                 would violate 105 and 251 if the deref guard leaked) -->
<ODM xmlns="http://www.cdisc.org/ns/odm/v1.3"
     xmlns:def="http://www.cdisc.org/ns/def/v2.1"
     xmlns:xlink="http://www.w3.org/1999/xlink"
     FileOID="www.example.org/define/batch-c2"
     FileType="Snapshot"
     ODMVersion="1.3.2"
     CreationDateTime="2026-07-03T10:15:30"
     def:Context="Submission">
  <Study OID="ST.BATCHC2">
    <GlobalVariables>
      <StudyName>BATCHC2-STUDY</StudyName>
      <StudyDescription>Batch C2 clean fixture study</StudyDescription>
      <ProtocolName>BATCHC2-01</ProtocolName>
    </GlobalVariables>
    <MetaDataVersion OID="MDV.1" Name="Batch C2 MDV" def:DefineVersion="2.1.0">
      <def:Standards>
        <def:Standard OID="STD.SDTM" Name="SDTMIG" Type="IG" Version="3.4" Status="Final"/>
        <def:Standard OID="STD.SEND" Name="SENDIG" Type="IG" Version="3.1.1" Status="Final"/>
        <def:Standard OID="STD.ADAM" Name="ADaMIG" Type="IG" Version="1.3" Status="Final"/>
      </def:Standards>
      <ItemGroupDef OID="IG.DM" Name="DM" Domain="DM" Repeating="No"
                    SASDatasetName="DM" Purpose="Tabulation"
                    def:Structure="One record per subject"
                    def:ArchiveLocationID="LF.DM" def:StandardOID="STD.SDTM">
        <Description>
          <TranslatedText xml:lang="en">Demographics</TranslatedText>
        </Description>
        <ItemRef ItemOID="IT.STUDYID" OrderNumber="1" Mandatory="Yes"/>
        <def:Class Name="SPECIAL PURPOSE"/>
        <def:leaf ID="LF.DM" xlink:href="dm.xpt">
          <def:title>dm.xpt</def:title>
        </def:leaf>
      </ItemGroupDef>
      <ItemGroupDef OID="IG.EX" Name="EX" Domain="EX" Repeating="Yes"
                    SASDatasetName="EX" Purpose="Tabulation"
                    def:Structure="One record per dosing interval per subject"
                    def:ArchiveLocationID="LF.EX" def:StandardOID="STD.SEND">
        <Description>
          <TranslatedText xml:lang="en">Exposure</TranslatedText>
        </Description>
        <ItemRef ItemOID="IT.STUDYID" OrderNumber="1" Mandatory="Yes"/>
        <def:Class Name="INTERVENTIONS"/>
        <def:leaf ID="LF.EX" xlink:href="ex.xpt">
          <def:title>ex.xpt</def:title>
        </def:leaf>
      </ItemGroupDef>
      <ItemGroupDef OID="IG.ADSL" Name="ADSL" Repeating="No"
                    SASDatasetName="ADSL" Purpose="Analysis"
                    def:Structure="One record per subject"
                    def:ArchiveLocationID="LF.ADSL" def:StandardOID="STD.ADAM">
        <Description>
          <TranslatedText xml:lang="en">Subject-Level Analysis Dataset</TranslatedText>
        </Description>
        <ItemRef ItemOID="IT.STUDYID" OrderNumber="1" Mandatory="Yes"/>
        <def:Class Name="SUBJECT LEVEL ANALYSIS DATASET"/>
        <def:leaf ID="LF.ADSL" xlink:href="adsl.xpt">
          <def:title>adsl.xpt</def:title>
        </def:leaf>
      </ItemGroupDef>
      <ItemGroupDef OID="IG.XX" Name="XX" Repeating="No"
                    SASDatasetName="XX" Purpose="Analysis"
                    def:Structure="One record per finding per subject"
                    def:ArchiveLocationID="LF.XX" def:IsNonStandard="Yes">
        <Description>
          <TranslatedText xml:lang="en">Sponsor-defined analysis findings</TranslatedText>
        </Description>
        <ItemRef ItemOID="IT.STUDYID" OrderNumber="1" Mandatory="Yes"/>
        <def:leaf ID="LF.XX" xlink:href="xx.xpt">
          <def:title>xx.xpt</def:title>
        </def:leaf>
      </ItemGroupDef>
    </MetaDataVersion>
  </Study>
</ODM>
