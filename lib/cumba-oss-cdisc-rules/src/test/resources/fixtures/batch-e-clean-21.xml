<?xml version="1.0" encoding="UTF-8"?>
<!-- Batch E (codelists) clean fixture: every batch-E rule executes and produces no
     findings. Coverage: ItemDefs with single resolving CodeListRefs (135/151); a
     CT-backed CodeListItem codelist (Description, exactly one nci:ExtCodeID Alias,
     def:StandardOID to a Type="CT" standard, def:CommentOID to a CommentDef, $-prefixed
     SASFormatName, integer Rank/OrderNumber on every item, one Decode each); a CT-backed
     EnumeratedItem codelist (incl. def:ExtendedValue="Yes"); a sponsor-defined float
     codelist (def:IsNonStandard="Yes", un-prefixed SASFormatName, no Rank/OrderNumber
     anywhere so the 183/185 guards stay off); and an ExternalCodeList codelist with
     Dictionary+Version. All CodeList Names unique; every guard direction exercised. -->
<ODM xmlns="http://www.cdisc.org/ns/odm/v1.3"
     xmlns:def="http://www.cdisc.org/ns/def/v2.1"
     xmlns:xlink="http://www.w3.org/1999/xlink"
     FileOID="www.example.org/define/batch-e-clean"
     FileType="Snapshot"
     ODMVersion="1.3.2"
     CreationDateTime="2026-07-03T10:15:30"
     def:Context="Submission">
  <Study OID="ST.BATCHE.CLEAN">
    <GlobalVariables>
      <StudyName>BATCHE-CLEAN</StudyName>
      <StudyDescription>Batch E clean fixture study</StudyDescription>
      <ProtocolName>BATCHE-01</ProtocolName>
    </GlobalVariables>
    <MetaDataVersion OID="MDV.1" Name="Batch E clean MDV" def:DefineVersion="2.1.0">
      <def:Standards>
        <def:Standard OID="STD.IG" Name="SDTMIG" Type="IG" Version="3.4" Status="Final"/>
        <def:Standard OID="STD.CT" Name="CDISC/NCI" Type="CT" PublishingSet="SDTM" Version="2024-03-29" Status="Final"/>
      </def:Standards>
      <ItemDef OID="IT.AE.AESEV" Name="AESEV" DataType="text">
        <CodeListRef CodeListOID="CL.AESEV"/>
      </ItemDef>
      <ItemDef OID="IT.VS.VSPOS" Name="VSPOS" DataType="text">
        <CodeListRef CodeListOID="CL.POSITION"/>
      </ItemDef>
      <CodeList OID="CL.AESEV" Name="Severity/Intensity Scale for Adverse Events" DataType="text"
                SASFormatName="$AESEV" def:StandardOID="STD.CT" def:CommentOID="COM.CL">
        <Description>
          <TranslatedText xml:lang="en">Severity/Intensity Scale for Adverse Events</TranslatedText>
        </Description>
        <CodeListItem CodedValue="MILD" Rank="1" OrderNumber="1">
          <Decode>
            <TranslatedText xml:lang="en">Mild Adverse Event</TranslatedText>
          </Decode>
        </CodeListItem>
        <CodeListItem CodedValue="MODERATE" Rank="2" OrderNumber="2">
          <Decode>
            <TranslatedText xml:lang="en">Moderate Adverse Event</TranslatedText>
          </Decode>
        </CodeListItem>
        <Alias Context="nci:ExtCodeID" Name="C66769"/>
      </CodeList>
      <CodeList OID="CL.POSITION" Name="Position" DataType="text"
                SASFormatName="$POSIT" def:StandardOID="STD.CT">
        <EnumeratedItem CodedValue="SITTING" Rank="1" OrderNumber="1"/>
        <EnumeratedItem CodedValue="STANDING" Rank="2" OrderNumber="2" def:ExtendedValue="Yes"/>
        <Alias Context="nci:ExtCodeID" Name="C71148"/>
      </CodeList>
      <CodeList OID="CL.VISITNUM" Name="Visit Number" DataType="float"
                SASFormatName="VISITF" def:IsNonStandard="Yes">
        <EnumeratedItem CodedValue="1"/>
        <EnumeratedItem CodedValue="2"/>
      </CodeList>
      <CodeList OID="CL.AEDICT" Name="Adverse Event Dictionary" DataType="text">
        <ExternalCodeList Dictionary="MEDDRA" Version="27.0"/>
      </CodeList>
      <def:CommentDef OID="COM.CL">
        <Description>
          <TranslatedText xml:lang="en">Codelist comment.</TranslatedText>
        </Description>
      </def:CommentDef>
    </MetaDataVersion>
  </Study>
</ODM>
