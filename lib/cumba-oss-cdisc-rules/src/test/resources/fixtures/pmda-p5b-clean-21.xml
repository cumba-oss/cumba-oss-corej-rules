<?xml version="1.0" encoding="UTF-8"?>
<!-- PMDA batch P5b (submission-folder + split-dataset cluster) clean 2.1 fixture:
     every P5b rule executes with zero findings, with guard-positive material
     proving the checks really ran:
       STD.SDTM     - SDTMIG 3.4, so the DD0049 2.1 standard-family guard passes
       IG.DM        - non-split SDTM dataset, Name=Domain=SASDatasetName=DM (DD0049)
       IG.QSCG/QSMD - split pair sharing Domain QS: SAS prefixes QS (DD0050),
                      DomainDescription Aliases (DD0063), class FINDINGS (DD0114),
                      no unsplit QS twin (DD0115)
       AnnotatedCRF - DocumentRef to LF.ACRF whose href basename is acrf.pdf (DD0102)
       IT.QSCAT     - Collected/Investigator origin referencing LF.ACRF (DD0075)
       leafs        - dm.xpt / qscg.xpt / qsmd.xpt / acrf.pdf, all created by the
                      folder-gated DD0084 test in its @TempDir submission folder -->
<ODM xmlns="http://www.cdisc.org/ns/odm/v1.3"
     xmlns:def="http://www.cdisc.org/ns/def/v2.1"
     xmlns:xlink="http://www.w3.org/1999/xlink"
     FileOID="www.example.org/define/pmda-p5b-clean"
     FileType="Snapshot"
     ODMVersion="1.3.2"
     CreationDateTime="2026-07-03T10:15:30"
     def:Context="Submission">
  <Study OID="ST.PMDAP5B">
    <GlobalVariables>
      <StudyName>PMDAP5B-STUDY</StudyName>
      <StudyDescription>PMDA batch P5b clean fixture study</StudyDescription>
      <ProtocolName>PMDAP5B-01</ProtocolName>
    </GlobalVariables>
    <MetaDataVersion OID="MDV.1" Name="PMDA P5b MDV" def:DefineVersion="2.1.0">
      <def:Standards>
        <def:Standard OID="STD.SDTM" Name="SDTMIG" Type="IG" Version="3.4" Status="Final"/>
      </def:Standards>
      <def:AnnotatedCRF>
        <def:DocumentRef leafID="LF.ACRF"/>
      </def:AnnotatedCRF>
      <ItemGroupDef OID="IG.DM" Name="DM" Domain="DM" Repeating="No" IsReferenceData="No"
                    SASDatasetName="DM" Purpose="Tabulation"
                    def:Structure="One record per subject"
                    def:ArchiveLocationID="LF.DM" def:StandardOID="STD.SDTM">
        <Description>
          <TranslatedText xml:lang="en">Demographics</TranslatedText>
        </Description>
        <ItemRef ItemOID="IT.STUDYID" OrderNumber="1" Mandatory="Yes" KeySequence="1"/>
        <def:Class Name="SPECIAL PURPOSE"/>
        <def:leaf ID="LF.DM" xlink:href="dm.xpt">
          <def:title>dm.xpt</def:title>
        </def:leaf>
      </ItemGroupDef>
      <ItemGroupDef OID="IG.QSCG" Name="QSCG" Domain="QS" Repeating="Yes" IsReferenceData="No"
                    SASDatasetName="QSCG" Purpose="Tabulation"
                    def:Structure="One record per question per subject"
                    def:ArchiveLocationID="LF.QSCG" def:StandardOID="STD.SDTM">
        <Description>
          <TranslatedText xml:lang="en">Questionnaires (CG)</TranslatedText>
        </Description>
        <ItemRef ItemOID="IT.QSCAT" OrderNumber="1" Mandatory="Yes"/>
        <Alias Context="DomainDescription" Name="Questionnaires"/>
        <def:Class Name="FINDINGS"/>
        <def:leaf ID="LF.QSCG" xlink:href="qscg.xpt">
          <def:title>qscg.xpt</def:title>
        </def:leaf>
      </ItemGroupDef>
      <ItemGroupDef OID="IG.QSMD" Name="QSMD" Domain="QS" Repeating="Yes" IsReferenceData="No"
                    SASDatasetName="QSMD" Purpose="Tabulation"
                    def:Structure="One record per question per subject"
                    def:ArchiveLocationID="LF.QSMD" def:StandardOID="STD.SDTM">
        <Description>
          <TranslatedText xml:lang="en">Questionnaires (MD)</TranslatedText>
        </Description>
        <ItemRef ItemOID="IT.QSCAT" OrderNumber="1" Mandatory="Yes"/>
        <Alias Context="DomainDescription" Name="Questionnaires"/>
        <def:Class Name="FINDINGS"/>
        <def:leaf ID="LF.QSMD" xlink:href="qsmd.xpt">
          <def:title>qsmd.xpt</def:title>
        </def:leaf>
      </ItemGroupDef>
      <ItemDef OID="IT.STUDYID" Name="STUDYID" DataType="text" Length="12"
               SASFieldName="STUDYID">
        <Description>
          <TranslatedText xml:lang="en">Study Identifier</TranslatedText>
        </Description>
        <def:Origin Type="Protocol"/>
      </ItemDef>
      <ItemDef OID="IT.QSCAT" Name="QSCAT" DataType="text" Length="40" SASFieldName="QSCAT">
        <Description>
          <TranslatedText xml:lang="en">Category of Question</TranslatedText>
        </Description>
        <def:Origin Type="Collected" Source="Investigator">
          <def:DocumentRef leafID="LF.ACRF">
            <def:PDFPageRef PageRefs="12" Type="PhysicalRef"/>
          </def:DocumentRef>
        </def:Origin>
      </ItemDef>
      <def:leaf ID="LF.ACRF" xlink:href="acrf.pdf">
        <def:title>Annotated CRF</def:title>
      </def:leaf>
    </MetaDataVersion>
  </Study>
</ODM>
