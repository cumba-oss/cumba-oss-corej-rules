<?xml version="1.0" encoding="UTF-8"?>
<!-- CT batch (P5 CT-gated rules) clean fixture: with the StubCtProvider every CT rule
     executes and produces no findings. Coverage: def:Standards whose Names are STDNAM
     members (DD0021-B); a def:Class Name from GNRLOBSC (132 / DD0055-C); a non-extensible
     CT codelist (Sex, C66731) whose EnumeratedItems are members carrying matching
     item-level nci:ExtCodeID aliases (DD0024/DD0028/DD0032/DD0033/DD0034, 179); an
     extensible CT codelist (Unit, C71620) with a member CodeListItem and a legally
     marked def:ExtendedValue="Yes" extension (186/187/201/202, 192, DD0024-B); and a
     sponsor codelist with def:IsNonStandard and no alias (153; unknown to CT by name, so
     DD0031 stays quiet on a 2.0 evaluation of this document too). -->
<ODM xmlns="http://www.cdisc.org/ns/odm/v1.3"
     xmlns:def="http://www.cdisc.org/ns/def/v2.1"
     xmlns:xlink="http://www.w3.org/1999/xlink"
     FileOID="www.example.org/define/ct-clean"
     FileType="Snapshot"
     ODMVersion="1.3.2"
     CreationDateTime="2026-07-03T10:15:30"
     def:Context="Submission">
  <Study OID="ST.CT.CLEAN">
    <GlobalVariables>
      <StudyName>CT-CLEAN</StudyName>
      <StudyDescription>CT batch clean fixture study</StudyDescription>
      <ProtocolName>CT-01</ProtocolName>
    </GlobalVariables>
    <MetaDataVersion OID="MDV.1" Name="CT clean MDV" def:DefineVersion="2.1.0">
      <def:Standards>
