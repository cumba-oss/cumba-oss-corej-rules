      <CodeList OID="CL.CUSTOM" Name="Sponsor Yes/No" DataType="text" def:IsNonStandard="Yes">
        <EnumeratedItem CodedValue="YEP"/>
      </CodeList>
    </MetaDataVersion>
  </Study>
</ODM>
