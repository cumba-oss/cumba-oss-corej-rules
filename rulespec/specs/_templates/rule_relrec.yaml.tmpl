name: "{{name}}"
kind: rule
description: "{{description}}"
rule:
  id: "{{rule_uuid}}"
  Core: {Id: "{{rule_core_id}}"}
  Description: "{{rule_description}}"
  Rule_Type: Record Data
  Sensitivity: Record
  Executability: Fully Executable
  Scope:
    Domains: {Include: [{{primary_domain}}]}
  Match_Datasets:
    - Name: RELREC
  Check:
    # A boolean check expression over the RELREC-related row, e.g.:
    #   AETERM != RELREC.**OBJ
    expression: "{{expression}}"
  Outcome:
    Message: "{{message}}"
    Output_Variables: [STUDYID, USUBJID, "{{primary_column}}"]
datasets:
  {{primary_domain}}:
    row_key: [STUDYID, USUBJID, "{{primary_seq_column}}"]
    rows:
      - {STUDYID: "S1", USUBJID: "001", {{primary_seq_column}}: 1, {{primary_column}}: "X"}
  {{related_domain}}:
    row_key: [STUDYID, USUBJID, "{{related_seq_column}}"]
    rows:
      - {STUDYID: "S1", USUBJID: "001", {{related_seq_column}}: 1, {{related_domain}}{{joined_column_suffix}}: "X"}
  RELREC:
    row_key: [__row_number__]
    rows:
      - {STUDYID: "S1", RDOMAIN: "{{primary_domain}}", USUBJID: "001", IDVAR: "{{primary_seq_column}}", IDVARVAL: "1", RELID: "R1"}
      - {STUDYID: "S1", RDOMAIN: "{{related_domain}}", USUBJID: "001", IDVAR: "{{related_seq_column}}", IDVARVAL: "1", RELID: "R1"}
config:
  standard: sdtmig
  standard_version: "3.4"
expected_violations: []
expected_errors: []
