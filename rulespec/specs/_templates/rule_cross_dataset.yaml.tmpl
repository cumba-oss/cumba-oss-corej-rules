name: "{{name}}"
kind: rule
description: "{{description}}"
rule:
  id: "{{rule_uuid}}"
  Core: {Id: "{{rule_core_id}}"}
  Description: "{{rule_description}}"
  Rule_Type: Record Data
  Sensitivity: Record
  Executability: Fully Executable
  Scope:
    Domains: {Include: [{{primary_domain}}]}
  Match_Datasets:
    - Name: {{joined_domain}}
      Keys: [STUDYID, USUBJID]
  Check:
    # A boolean check expression over the joined row, e.g.: AETERM != FA.FAOBJ
    expression: "{{expression}}"
  Outcome:
    Message: "{{message}}"
    Output_Variables: [STUDYID, USUBJID, "{{primary_column}}"]
datasets:
  {{primary_domain}}:
    row_key: [STUDYID, USUBJID]
    rows:
      - {STUDYID: "S1", USUBJID: "001", {{primary_column}}: "X"}
  {{joined_domain}}:
    row_key: [STUDYID, USUBJID]
    rows:
      - {STUDYID: "S1", USUBJID: "001", {{joined_column}}: "X"}
config:
  standard: sdtmig
  standard_version: "3.4"
expected_violations: []
expected_errors: []
