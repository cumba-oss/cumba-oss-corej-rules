name: "{{name}}"
kind: operation
description: "{{description}}"
operation:
  name: "$auto_result"
  expression: "{{operator}}({{column}})"
check:
  # A boolean check expression over the operation result, e.g.: $auto_result > 5
  expression: "{{check_expression}}"
datasets:
  {{domain}}:
    row_key: [STUDYID, USUBJID]
    rows:
      - {STUDYID: "S1", USUBJID: "001", {{column}}: "example"}
config:
  standard: sdtmig
  standard_version: "3.4"
expected_violations: []
expected_errors: []
