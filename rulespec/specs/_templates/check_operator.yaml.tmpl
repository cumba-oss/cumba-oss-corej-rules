name: "{{name}}"
kind: check_operator
description: "{{description}}"
check:
  # A boolean check expression, e.g.: AESER not in ["Y", "N"]   (quote a string literal,
  # leave a column reference bare; see rules-src/checks for the authored corpus idiom)
  expression: "{{expression}}"
datasets:
  {{domain}}:
    row_key: [STUDYID, USUBJID]
    rows:
      - {STUDYID: "S1", USUBJID: "001", {{column}}: "example"}
config:
  standard: sdtmig
  standard_version: "3.4"
expected_violations: []
expected_errors: []
