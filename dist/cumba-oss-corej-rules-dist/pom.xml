<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.cumba</groupId>
        <artifactId>cumba-oss-corej-rules-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>cumba-oss-corej-rules-dist</artifactId>
    <packaging>pom</packaging>

    <name>Cumba OSS CDISC Rules :: Distribution</name>
    <url>https://github.com/cumba-oss/cumba-oss-corej-rules</url>
    <inceptionYear>2026</inceptionYear>
    <description>
        Shippable distribution of the CDISC rule corpora, as TWO release archives:

          cumba-oss-corej-rules-&lt;version&gt;.zip         the data rule packages
          cumba-oss-corej-rules-define-&lt;version&gt;.zip  the Define-XML packages

        Both are generated into lib/cumba-oss-corej-rules/target/ by that module's build.
        They ship separately because they are on different axes and a consumer may want
        either alone. Each archive carries its own packages.json (the constituent
        standards and versions) and a README saying why that manifest, not the archive's
        tag, answers "which rules am I running".

        WHY A dist/ MODULE AND NOT A CLASSIFIER ON THE RULES MODULE.
        The release job's glob is `dist/*-dist/target/*.zip`. A zip attached as a
        classifier artifact to the lib/ module would build correctly and then never be
        picked up, which is a silent failure. This module exists so the corpus reaches a
        release through the same machinery every other bundle uses.

        ⛔ NOTHING HERE GOES TO MAVEN CENTRAL. This repository publishes no Maven
        artifacts at all; the corpus travels as signed GitHub release assets.
    </description>

    <properties>
        <!-- The zips ship via the GitHub release, not as Maven artifacts. -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!--
            ⚑ REACTOR EDGE, not a real dependency.

            This module's assembly reads lib/cumba-oss-corej-rules/target/rules{,-define}
            by relative path. Those directories are GENERATED during that module's build
            and are not committed, so this module must not package before it. Maven orders
            the reactor by the dependency graph; without an edge two independent modules
            may build in any order — including concurrently under -T.

            `provided` so the (empty, test-only) jar stays out of the bundle: both
            fileSets in the assemblies are plain directory copies, but a compile-scoped
            dependency would still pull the empty jar into any dependencySet added later.
        -->
        <dependency>
            <groupId>net.cumba</groupId>
            <artifactId>cumba-oss-corej-rules</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Both corpora must exist before the assembly copies them.

                ⚠ An assembly <fileSet> whose <directory> does not exist is SILENTLY
                skipped — the bundle builds green and ships EMPTY. Fail here instead,
                before the assembly runs, naming the cause.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>require-generated-rule-corpus</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireFilesExist>
                                    <files>
                                        <file>${maven.multiModuleProjectDirectory}/lib/cumba-oss-corej-rules/target/rules/packages.json</file>
                                        <file>${maven.multiModuleProjectDirectory}/lib/cumba-oss-corej-rules/target/rules-define/packages.json</file>
                                    </files>
                                    <message>The generated rule corpus is missing. It is produced by cumba-oss-corej-rules' build into its target/ and is not committed — build that module first, e.g. add -am to this invocation.</message>
                                </requireFilesExist>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                TWO archives, not one. The data corpus and the Define-XML corpus are on
                different axes and a consumer may want either alone.

                ⚠ finalName is set PER EXECUTION, not once for the module. With
                appendAssemblyId=false (which the release glob's readable names depend on)
                two executions sharing one finalName would write the same file twice, and
                the second would silently win.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>${plugin.maven-assembly-plugin.version}</version>
                <configuration>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>make-rules-dist</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                        <configuration>
                            <finalName>cumba-oss-corej-rules-${project.version}</finalName>
                            <descriptors>
                                <descriptor>src/assembly/dist.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                    <execution>
                        <id>make-rules-define-dist</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                        <configuration>
                            <finalName>cumba-oss-corej-rules-define-${project.version}</finalName>
                            <descriptors>
                                <descriptor>src/assembly/rules-define.xml</descriptor>
                            </descriptors>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
